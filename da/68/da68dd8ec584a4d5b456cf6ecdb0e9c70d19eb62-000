import { cleanup, render, screen } from '@testing-library/react'
import { afterEach, describe, expect, it, vi } from 'vitest'
import BuildBoard from './BuildBoard.jsx'

// 9 October 2026 08:54 CEST: Verify persisted and fresh OS roadmap cards stay visible.
const theme = {
  textPrimary: '#222',
  textSecondary: '#666',
  cardBg: '#fff',
  border: '#ddd',
  surface: '#fff',
}

afterEach(() => {
  cleanup()
  vi.unstubAllGlobals()
})

describe('BuildBoard OS roadmap visibility', () => {
  it('renders persisted tasks in the OS section', async () => {
    const items = [{ id: 'spec_C210c', title: 'C210c extraction', status: 'todo', section: 'OS' }]
    vi.stubGlobal('fetch', vi.fn().mockResolvedValue({
      json: async () => ({ sha: 'test-sha', markdown: JSON.stringify({ items }) }),
    }))

    render(<BuildBoard t={theme} />)

    expect(await screen.findByText('C210c extraction')).toBeTruthy()
    expect(screen.getByText((_, element) => element?.tagName === 'DIV' && element.textContent?.replace(/\s/g, '') === 'OS0/1')).toBeTruthy()
  })

  it('includes the current C210 states when the board has no saved file', async () => {
    let callCount = 0
    vi.stubGlobal('fetch', vi.fn().mockImplementation(async () => {
      callCount += 1
      return { json: async () => callCount === 1 ? { missing: true } : { ok: true, sha: 'seed-sha' } }
    }))

    render(<BuildBoard t={theme} />)

    expect(await screen.findByText((content) => content.startsWith('C210c'))).toBeTruthy()
    expect(screen.getByText((_, element) => element?.tagName === 'DIV' && element.textContent?.replace(/\s/g, '') === 'OS3/6')).toBeTruthy()
  })
})
