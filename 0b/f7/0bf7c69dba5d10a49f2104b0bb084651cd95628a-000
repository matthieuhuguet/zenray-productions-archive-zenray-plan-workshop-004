// 10 October 2026, 23:02 CEST: a page whose body stalls must end as a fetch error, and HTML entities in titles must decode.
import { vi, test, expect, afterEach } from 'vitest'
import handler from './unfurl.js'

const responder = () => ({
  statusCode: 200,
  body: null,
  status(code) { this.statusCode = code; return this },
  setHeader() {},
  json(payload) { this.body = payload; return this },
})

afterEach(() => { vi.useRealTimers(); vi.restoreAllMocks() })

test('a page whose body stalls ends as a fetch error instead of hanging the link card', async () => {
  vi.useFakeTimers()
  vi.spyOn(globalThis, 'fetch').mockResolvedValue({ ok: true, status: 200, headers: { get: () => null }, text: () => new Promise(() => {}) })
  const res = responder()

  const pending = handler({ query: { url: 'https://stalled.example/' } }, res)
  await vi.advanceTimersByTimeAsync(20000)
  await pending

  expect(res.statusCode).toBe(200)
  expect(res.body.error).toBe('fetch')
})

test('HTML entities in a page title are decoded before the link card shows them', async () => {
  vi.spyOn(globalThis, 'fetch').mockResolvedValue({
    ok: true,
    status: 200,
    headers: { get: () => null },
    text: async () => '<html><head><meta property="og:title" content="Studio &amp; Team&#39;s launch"></head></html>',
  })
  const res = responder()

  await handler({ query: { url: 'https://entities.example/' } }, res)

  expect(res.body.title).toBe("Studio & Team's launch")
})
