// 14 October 2026: one refused piece does not kill a download. FR : une piece refusee ne tue pas un telechargement.
import { describe, it, expect, vi } from 'vitest'
import { fetchResilient } from './fetchAsset.js'

const CDN = 'https://cdn.jsdelivr.net/gh/o/r@0123456789abcdef0123456789abcdef01234567/f/chunk.m4s'
const RAW = 'https://raw.githubusercontent.com/o/r/0123456789abcdef0123456789abcdef01234567/f/chunk.m4s'
describe('fetchResilient', () => {
  it('GREEN: the CDN refuses (403), GitHub raw serves the same piece', async () => {
    const calls = []
    const fetchImpl = vi.fn(async (u) => { calls.push(u); return u === RAW ? { ok: true, status: 200 } : { ok: false, status: 403 } })
    const r = await fetchResilient(CDN, { delayMs: 1, fetchImpl })
    expect(r.ok).toBe(true); expect(calls).toEqual([CDN, RAW])
  })
  it('GREEN: no refusal, one request only', async () => {
    const fetchImpl = vi.fn(async () => ({ ok: true, status: 200 }))
    await fetchResilient(CDN, { delayMs: 1, fetchImpl }); expect(fetchImpl).toHaveBeenCalledTimes(1)
  })
  it('RED: both refuse for every attempt, the error names the status', async () => {
    const fetchImpl = vi.fn(async () => ({ ok: false, status: 404 }))
    await expect(fetchResilient(CDN, { attempts: 4, delayMs: 1, fetchImpl })).rejects.toThrow(/HTTP 404/)
    expect(fetchImpl).toHaveBeenCalledTimes(4)
  })
})
