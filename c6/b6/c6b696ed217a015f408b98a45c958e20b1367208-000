// Éditeur du bloc de détail (titre + note) -- bug réel corrigé le 2026-07-20 ("à mesure que j'écris,
// l'écriture se désagrège") : les champs étaient contrôlés par le board GLOBAL avec sauvegarde débouncée ;
// quand le round-trip GitHub (1-2 s) revenait, son setBoard(res.data) écrasait les frappes tapées ENTRE
// TEMPS -- caractères perdus, curseur qui saute. Solution (le pattern Notion/Apple Notes) : la frappe vit
// dans un BUFFER LOCAL, rien ne part au réseau pendant qu'on tape ; le commit se fait au blur du champ et
// à la fermeture du bloc (unmount -- y compris fermeture auto/Escape/changement de tâche). key={task.id}
// posé par l'appelant garantit un buffer neuf par tâche ouverte.
// Sélecteur d'images DU SITE : uniquement l'index auto-généré (getIndexPaths + getNodeThumb) --
// ZÉRO appel REST/raw par résultat (règle dure post-incident quota du 2026-07-20). thumb.u est une
// URL CDN directe, utilisée telle quelle comme vignette ET comme image stockée dans la tâche.
// Sélecteur de date maison (retour Matthieu 2026-07-20 : "je ne veux pas taper la date, je veux un
// tableau/widget avec le bon liseré" -- le calendrier natif du navigateur ("truc Windows moche") est
// remplacé partout par ce mini-calendrier, même recette glass/rim que le reste du Plan (--zrp-rim,
// pas l'opaque .zrp-popover). Réutilise buildMonthGrid/MONTHS déjà définis plus haut dans ce fichier.
function MiniCalendar({ value, min, onSelect }) {
  const base = parseIso(value || todayIso())
  const [view, setView] = useState({ year: base.getFullYear(), month: base.getMonth() })
  const cells = useMemo(() => buildMonthGrid(view.year, view.month), [view])
  const shiftMonth = (delta) => setView((v) => { const d = new Date(v.year, v.month + delta, 1); return { year: d.getFullYear(), month: d.getMonth() } })
  const today = todayIso()
  return (
    <div className="zrp-mini-cal" onClick={(e) => e.stopPropagation()}>
      <div className="zrp-mini-cal-head">
        <button type="button" aria-label="Previous month" onClick={() => shiftMonth(-1)}><Icon name="chevron.left" size={12} /></button>
        <span>{MONTHS[view.month]} {view.year}</span>
        <button type="button" aria-label="Next month" onClick={() => shiftMonth(1)}><Icon name="chevron.right" size={12} /></button>
      </div>
      <div className="zrp-mini-cal-weekdays">{WEEKDAYS.map((w) => <span key={w}>{w[0]}</span>)}</div>
      <div className="zrp-mini-cal-grid">
        {cells.map((cell) => {
          const disabled = !!min && cell.iso < min
          return (
            <button key={cell.iso} type="button" disabled={disabled}
              className={`zrp-mini-cal-day${cell.outside ? ' zrp-outside' : ''}${cell.iso === value ? ' zrp-selected' : ''}${cell.iso === today ? ' zrp-today' : ''}`}
              onClick={() => onSelect(cell.iso)}>{cell.day}</button>
          )
        })}
      </div>
      <button type="button" className="zrp-mini-cal-today" onClick={() => onSelect(today)}>Today</button>
    </div>
  )
}

// HEURE EN 12 H À L'AFFICHAGE, EN 24 H DANS LE FICHIER.
//
// Le stockage reste `"HH:MM"` sur vingt-quatre heures et la conversion ne vit qu'à l'affichage.
// Stocker « 7:07 PM » aurait deux coûts immédiats : les tâches déjà créées deviendraient illisibles,
// et le tri par heure de la grille comparerait des chaînes qui ne s'ordonnent plus (« 7:07 PM » passe
// avant « 9:00 AM » en ordre alphabétique). Un format d'affichage ne doit jamais remonter jusqu'au
// format de données.
const TIME_H12 = Array.from({ length: 12 }, (_, i) => i + 1)
const TIME_M60 = Array.from({ length: 60 }, (_, i) => i)
// POINT D'ANCRAGE DE LA BARRE COLLANTE — miroir exact du `top` calculé dans PlanBoard.css
// (`calc(6px - var(--zrp-app-pad-top))`, soit 6 - 70). La valeur vit à deux endroits parce que l'un
// positionne et l'autre mesure ; ce commentaire est le lien entre les deux, et changer l'un sans
// l'autre décalerait le moment où la barre prend son verre par rapport au moment où elle se colle.
const ANCRAGE_BARRE = 6 - 70

const to12 = (hhmm) => {
  const [H, M] = String(hhmm || '09:00').split(':').map(Number)
  return { h12: (H % 12) === 0 ? 12 : (H % 12), m: M || 0, period: H >= 12 ? 'PM' : 'AM' }
}
const to24 = (h12, m, period) => {
  const H = period === 'PM' ? (h12 === 12 ? 12 : h12 + 12) : (h12 === 12 ? 0 : h12)
  return `${pad2(H)}:${pad2(m)}`
}
// Lisible par un humain : « 7:07 PM ». Tiret simple quand il n'y a pas d'heure, jamais « 00:00 ».
const fmt12 = (hhmm) => { if (!hhmm) return '-'; const { h12, m, period } = to12(hhmm); return `${h12}:${pad2(m)} ${period}` }
// Même principe pour l'heure : deux colonnes de capsules (heures / minutes par quart d'heure) au lieu
// du widget natif à molette. `onSelect` reçoit la nouvelle valeur "HH:MM" à chaque clic (les deux
// colonnes restent ouvertes -- ajuster l'heure puis les minutes sans réouvrir le widget).
function MiniTimePicker({ value, onSelect }) {
  // LE PICKER TIENT SA PROPRE COMPOSITION, et c'est un correctif de perte de saisie.
  //
  // Dériver les trois colonnes de `value` à chaque rendu paraît plus simple, mais chaque
  // gestionnaire de clic capture alors la valeur du rendu COURANT. Deux clics rapprochés dans la
  // même image partent donc tous les deux de l'ancienne heure, et le second écrase le premier.
  // Mesuré au banc : cliquer 7, puis 07, puis PM donnait « 9:00 PM » — seul le dernier clic
  // survivait, les deux autres étaient perdus. C'est exactement le symptôme « l'horaire n'est pas
  // sauvegardé à l'heure exacte » : il l'était, mais partiellement, et de façon imprévisible
  // puisque tout dépendait du rythme des clics.
  const [t, setT] = useState(() => to12(value))
  const lastValueRef = useRef(value)
  if (value !== lastValueRef.current) {
    // Le parent a changé l'heure par un autre chemin (bouton « Now », ouverture d'une autre
    // tâche) : on se réaligne PENDANT le rendu, pas dans un effet, sinon une image s'affiche avec
    // l'ancienne composition avant de se corriger.
    lastValueRef.current = value
    const next = to12(value)
    if (next.h12 !== t.h12 || next.m !== t.m || next.period !== t.period) setT(next)
  }
  const emit = (patch) => {
    const n = { ...t, ...patch }
    setT(n)
    // On note la valeur qu'on émet : le parent va la renvoyer par `value`, et sans cette note on
    // se croirait modifié de l'extérieur à chaque clic.
    lastValueRef.current = to24(n.h12, n.m, n.period)
    onSelect(lastValueRef.current)
  }
  // Chaque colonne amène sa sélection dans le champ de vision à l'ouverture. Sur douze heures et
  // soixante minutes, la valeur choisie est presque toujours hors écran, et un sélecteur qui
  // s'ouvre sur une valeur invisible se lit exactement comme un sélecteur vide.
  const colsRef = useRef(null)
  useEffect(() => {
    for (const col of colsRef.current?.querySelectorAll('.zrp-mini-time-col') || []) {
      const cell = col.querySelector('.zrp-selected')
      if (cell) col.scrollTop = cell.offsetTop - (col.clientHeight / 2) + (cell.clientHeight / 2)
    }
  }, [])
  return (
    <div className="zrp-mini-time" ref={colsRef} onClick={(e) => e.stopPropagation()}>
      <div className="zrp-mini-time-col" role="listbox" aria-label="Hour">
        {TIME_H12.map((hh) => (
          <button key={hh} type="button" className={`zrp-mini-time-cell${hh === t.h12 ? ' zrp-selected' : ''}`}
            onClick={() => emit({ h12: hh })}>{hh}</button>
        ))}
      </div>
      <div className="zrp-mini-time-col zrp-mini-time-minutes" role="listbox" aria-label="Minute">
        {/* Les multiples de cinq portent un relief : sur une colonne de soixante, l'oeil a besoin
            de repères pour viser, sinon il compte les cellules une à une. */}
        {TIME_M60.map((mm) => (
          <button key={mm} type="button"
            className={`zrp-mini-time-cell${mm === t.m ? ' zrp-selected' : ''}${mm % 5 === 0 ? ' zrp-tick' : ''}`}
            onClick={() => emit({ m: mm })}>{pad2(mm)}</button>
        ))}
      </div>
      <div className="zrp-mini-time-col zrp-mini-time-period" role="listbox" aria-label="AM or PM">
        {['AM', 'PM'].map((pp) => (
          <button key={pp} type="button" className={`zrp-mini-time-cell${pp === t.period ? ' zrp-selected' : ''}`}
            onClick={() => emit({ period: pp })}>{pp}</button>
        ))}
      </div>
    </div>
  )
}

function PlanTimePicker({ value, onSelect, onClose, tasks = [], dateIso, durationMin = DUREE_DEFAUT }) {
  const [currentTime, setCurrentTime] = useState(value || '09:00')
  const debounceRef = useRef(null)

  useEffect(() => {
    setCurrentTime(value || '09:00')
  }, [value])

  const handlePick = (time) => {
    setCurrentTime(time)
    if (debounceRef.current) clearTimeout(debounceRef.current)
    debounceRef.current = setTimeout(() => {
      onSelect(time)
    }, 350)
  }

  const handleImmediate = (time) => {
    if (debounceRef.current) clearTimeout(debounceRef.current)
    setCurrentTime(time)
    onSelect(time)
  }

  const handleConfirm = () => {
    if (debounceRef.current) clearTimeout(debounceRef.current)
    onSelect(currentTime)
    if (onClose) onClose()
  }

  const slotPresets = getSlotPresets(tasks, dateIso, durationMin)
  const nextSlot = nextAvailableSlot(tasks, dateIso, durationMin)

  return (
    <div className="zrp-time-picker-popover" onClick={(e) => e.stopPropagation()}>
      <div className="zrp-meta-time-actions">
        <button type="button" className="zrp-meta-now" title="Use current time"
          onClick={() => { const n = new Date(); handleImmediate(`${pad2(n.getHours())}:${pad2(n.getMinutes())}`); if (onClose) onClose() }}>
          <Icon name="clock.arrow.2.circlepath" size={13} />Now
        </button>
        <button type="button" className="zrp-meta-now" title="Next free 90m slot"
          onClick={() => { handleImmediate(nextSlot); if (onClose) onClose() }}>
          <Icon name="arrow.right" size={13} />Next slot ({fmt12(nextSlot)})
        </button>
        {onClose && (
          <button type="button" className="zrp-meta-now zrp-meta-save" title="Save chosen time"
            onClick={handleConfirm}>
            <Icon name="checkmark" size={13} />Done
          </button>
        )}
      </div>

      <div className="zrp-slot-presets" role="group" aria-label="90m slots">
        {slotPresets.map(({ time, occupied, taskTitle }) => (
          <button
            key={time}
            type="button"
            className={`zrp-slot-chip${currentTime === time ? ' zrp-selected' : ''}${occupied ? ' zrp-occupied' : ''}`}
            title={occupied ? `Occupied by "${taskTitle || 'another task'}"` : `Slot ${fmt12(time)}`}
            onClick={() => handleImmediate(time)}
          >
            {fmt12(time)}
          </button>
        ))}
      </div>

      <MiniTimePicker value={currentTime} onSelect={handlePick} />
    </div>
  )
}

// La MÊME limite que la fenêtre glissante du visionneur d'images (96, voir QuickLookOverlay et
// App.jsx) — demande explicite de Matthieu : « utilise la même limite ». Vingt-quatre était une
// valeur locale inventée ici, sans rapport avec le reste du produit.
const PICKER_MAX = 96

function ImagePicker({ onPick, onClose }) {
  const [query, setQuery] = useState('')
  const [ready, setReady] = useState(false)
  // ÉCHEC D'INDEX : bug réel corrigé le 2026-08-07. Le `.catch(() => {})` avalait l'erreur SANS
  // jamais lever `ready`, si bien que le panneau affichait « Loading index… » indéfiniment — c'est
  // le « ça charge à l'infini sans jamais m'afficher mes images » de Matthieu. On distingue
  // désormais « en cours » de « échoué », et l'échec le DIT, avec le collage toujours possible.
  const [failed, setFailed] = useState(false)
  useEffect(() => {
    let live = true
    loadSearchIndex()
      .then(() => { if (live) setReady(true) })
      .catch(() => { if (live) { setFailed(true); setReady(true) } })
    return () => { live = false }
  }, [])
  const results = useMemo(() => {
    if (!ready) return []
    const needle = query.trim().toLowerCase()
    const out = []
    for (const path of getIndexPaths()) {
      if (!path.endsWith('.img.json')) continue
      const name = path.split('/').pop().replace(/\.img\.json$/, '')
      if (needle && !name.toLowerCase().includes(needle)) continue
      const thumb = getNodeThumb(path)
      if (!thumb?.u) continue
      out.push({ path, name, url: thumb.u })
      if (out.length >= PICKER_MAX) break
    }
    return out
  }, [ready, query])
  return (
    <div className="zrp-image-picker" onClick={(e) => e.stopPropagation()}>
      <div className="zrp-image-picker-head">
        <input autoFocus value={query} placeholder="Search site images… or paste (⌘V)" aria-label="Search images"
          onChange={(e) => setQuery(e.target.value)}
          onPaste={async (e) => {
            const file = [...(e.clipboardData?.items || [])].map((it) => it.kind === 'file' ? it.getAsFile() : null).find((f) => f && f.type.startsWith('image/'))
            if (!file) return
            e.preventDefault()
            const dataUrl = await shrinkImageFile(file)
            if (dataUrl) onPick(dataUrl)
          }}
          onKeyDown={(e) => { if (e.key === 'Escape') onClose() }} />
        <button type="button" className="zrp-detail-icon" title="Close picker" aria-label="Close picker" onClick={onClose}><Icon name="xmark" size={12} /></button>
      </div>
      <div className="zrp-image-picker-grid">
        {!ready && <div className="zrp-image-picker-note">Chargement de l’index des images…</div>}
        {ready && failed && <div className="zrp-image-picker-note">Index des images indisponible. Colle une image (⌘V) en attendant.</div>}
        {ready && !failed && !results.length && <div className="zrp-image-picker-note">Aucune image trouvée. Colle-en une (⌘V).</div>}
        {results.map((r) => (
          <button key={r.path} type="button" title={r.name} onClick={() => onPick(r.url)}
            style={{ backgroundImage: `url(${r.url})` }} aria-label={`Add ${r.name}`} />
        ))}
      </div>
    </div>
  )
}

// Ajuste la hauteur d'un champ multiligne a son contenu. Remise a `auto` AVANT de lire
// `scrollHeight` : sans ce retour a zero, la hauteur ne fait que croitre et ne redescend jamais
// quand on raccourcit le titre.
function autoHauteur(el) {
  if (!el) return
  el.style.height = 'auto'
  el.style.height = `${el.scrollHeight}px`
}

function DetailEditor({ task, today, allTasks = [], titleInputRef, onCommit, onPatch, onDelete, onToggleDropped, onClose }) {
  const [title, setTitle] = useState(task.title)
  const [note, setNote] = useState(task.note || '')
  // Chips méta éditables (retour Matthieu 2026-07-20) : cliquer Date / Start / Block ouvre un petit
  // widget animé (0.35s, .zrp-meta-editor) sous la rangée ; un seul ouvert à la fois.
  const [editingMeta, setEditingMeta] = useState(null) // 'date' | 'start' | 'block' | null
  const [pickerOpen, setPickerOpen] = useState(false)
  // Refs lues par le cleanup d'unmount : toujours la DERNIÈRE frappe, jamais une closure figée.
  const draftRef = useRef(null)
  draftRef.current = { title, note, changed: title !== task.title || note !== (task.note || '') }
  const onCommitRef = useRef(onCommit)
  onCommitRef.current = onCommit
  useEffect(() => () => {
    const draft = draftRef.current
    if (draft.changed) onCommitRef.current({ title: draft.title.trim() || 'Untitled', note: draft.note })
  }, [])
  const commitNow = () => {
    const draft = draftRef.current
    if (draft.changed) onCommit({ title: draft.title.trim() || 'Untitled', note: draft.note })
  }
  // ── SAUVEGARDE PENDANT LA FRAPPE, ET NON SEULEMENT À LA SORTIE (2026-08-16) ──────────────────────
  // Le bug de Matthieu : « quand j'écris trop de texte, il disparaît de la carte dans les notes, pas le
  // titre ». La cause n'est pas la longueur, c'est le MOMENT : jusqu'ici la note ne partait qu'au `blur`
  // de la zone de texte ou au démontage du panneau. Tout ce qui contourne ces deux instants — recharger
  // la page, fermer l'onglet, une navigation, un plantage, un rafraîchissement pendant qu'on écrit —
  // emportait le texte avec lui. Plus le texte est long, plus la fenêtre pour se faire prendre est
  // grande : d'où l'impression que c'est la longueur qui pose problème.
  //
  // POURQUOI CE N'EST PAS UN RETOUR AU BUG DE JUILLET. La sauvegarde débouncée avait été retirée le
  // 2026-07-20 parce que les champs étaient alors CONTRÔLÉS PAR LE BOARD GLOBAL : chaque retour du drive
  // réécrivait la zone de texte en pleine frappe, d'où les caractères perdus et le curseur qui saute.
  // Ici la frappe reste dans l'état LOCAL du composant, et rien de ce qui revient du drive ne touche à
  // `note` ni à `title`. On peut donc écrire souvent sans jamais déranger celui qui tape.
  //
  // Huit cents millisecondes : assez long pour ne pas écrire à chaque lettre, assez court pour qu'aucun
  // geste humain ne s'intercale — on ne ferme pas un onglet en moins d'une seconde après sa dernière
  // frappe. Le `blur` et le démontage restent en place : ce sont désormais des filets, plus le mécanisme.
  useEffect(() => {
    if (!draftRef.current.changed) return
    const t = setTimeout(commitNow, 800)
    return () => clearTimeout(t)
  }, [title, note])
  // LE DERNIER TROU : recharger la page ou fermer l'onglet MOINS d'une seconde après la dernière frappe.
  // La temporisation ne s'est pas encore déclenchée, le `blur` n'a pas eu lieu, le démontage non plus.
  // `visibilitychange` couvre le changement d'onglet, la mise en arrière-plan et le verrouillage de
  // l'écran ; `pagehide` couvre la fermeture et le rechargement, et c'est le seul des deux sur lequel
  // Safari soit fiable. On écrit dans les deux cas : une écriture de trop ne coûte rien, une écriture
  // manquée coûte le texte.
  useEffect(() => {
    const filet = () => { if (document.visibilityState === 'hidden') commitNow() }
    document.addEventListener('visibilitychange', filet)
    window.addEventListener('pagehide', commitNow)
    return () => {
      document.removeEventListener('visibilitychange', filet)
      window.removeEventListener('pagehide', commitNow)
    }
  })
  // La hauteur se cale a l'ouverture ET a chaque changement de tache : sans cet effet, un titre
  // long s'afficherait sur une seule ligne tant qu'on n'y a pas tape.
  useEffect(() => { autoHauteur(titleInputRef.current) }, [task.id, title, titleInputRef])
  const status = statusOf(task, today)
  const images = imagesOf(task)
  const deletable = canDeleteTask(task)
  const dropped = task.status === 'dropped'
  // Le titre suit EXACTEMENT le verrou d'engagement de la corbeille, pas une règle à lui : si une tâche
  // de plus de quatre heures ne peut plus être supprimée, la renommer serait la même échappatoire par
  // un autre chemin. En deçà, l'erreur de frappe se corrige librement.
  const refuseTitle = () => {
    const el = titleInputRef.current
    if (!el || reducedMotion()) return
    // ANIMATION PILOTÉE, PAS UNE CLASSE CSS. Rejouer une animation par ajout et retrait de classe
    // demande de laisser passer une image entre les deux, donc un `requestAnimationFrame`, donc un
    // état React et un minuteur à nettoyer : quatre pièces mobiles pour un clignotement. L'API
    // d'animation le fait en un appel, et surtout elle se MESURE (`el.getAnimations()`), alors
    // qu'une classe posée pendant une frame ne se vérifie pas.
    // `cancel()` avant de rejouer : sans lui, un second refus pendant le clignotement ne produit
    // rien du tout, et l'interface paraît morte au moment précis où elle doit répondre.
    for (const a of el.getAnimations()) a.cancel()
    el.animate(
      [
        { transform: 'translateX(0)', filter: 'none' },
        { transform: 'translateX(-6px)', filter: 'brightness(1.22) saturate(1.2)', offset: .2 },
        { transform: 'translateX(5px)', filter: 'brightness(.92)', offset: .4 },
        { transform: 'translateX(-4px)', filter: 'brightness(1.16)', offset: .6 },
        { transform: 'translateX(2px)', filter: 'none', offset: .8 },
        { transform: 'translateX(0)', filter: 'none' },
      ],
      { duration: PLAN_UI.motion.refuse, easing: 'cubic-bezier(.16,1,.3,1)' },
    )
  }
  return (
    <>
      <header className="zrp-detail-head">
        {/* TITRE SUR PLUSIEURS LIGNES (2026-08-07). C'était un `<input>`, donc une ligne unique par
            nature : un titre long se coupait en « Exposer quelque cho… » à l'ouverture même de la
            tâche, précisément là où on veut le lire en entier. Un `<textarea>` enveloppe, et sa
            hauteur suit le contenu (`autoHauteur`). Entrée VALIDE toujours au lieu d'insérer un
            saut de ligne : un titre reste une seule phrase, il se contente d'être affiché sur
            plusieurs lignes. Les tuiles du calendrier, elles, gardent leur troncature — Matthieu
            l'a dit explicitement, « la vue est bonne, mais pas lorsque je déploie la capsule ». */}
        <textarea ref={titleInputRef} className={`zrp-detail-title${deletable ? '' : ' zrp-locked-title'}`}
          rows={1} value={title} aria-label="Task title" readOnly={!deletable}
          title={deletable ? undefined : 'Locked — a goal older than 4h can’t be renamed'}
          onMouseDown={deletable ? undefined : refuseTitle}
          onChange={(e) => { if (deletable) { setTitle(e.target.value); autoHauteur(e.target) } }}
          onBlur={deletable ? commitNow : undefined}
          onKeyDown={(e) => { if (!deletable) { refuseTitle(); return } if (e.key === 'Enter') { e.preventDefault(); e.currentTarget.blur() } }} />
        {/* QUATRE OUTILS SUR UNE SEULE RANGÉE (2026-08-07). L'abandon s'ajoute entre les images et la
            corbeille : c'est le geste qui manquait entre « c'est fait » et « ça n'a jamais existé ».
            Il n'est PAS soumis au verrou de quatre heures, et c'est le point : renoncer à une tâche
            mal posée doit rester possible quand on s'en aperçoit, c'est-à-dire tard. */}
        <div className="zrp-detail-tools">
          <button type="button" className={`zrp-detail-icon${images.length ? ' zrp-active' : ''}`} title="Images" aria-label="Add images"
            onClick={() => setPickerOpen((v) => !v)}><Icon name="photo" size={13} /></button>
          <button type="button" className={`zrp-detail-icon${dropped ? ' zrp-active' : ''}`}
            title={dropped ? 'Reprendre cette tâche' : 'Abandonner : la tâche reste, elle ne compte plus'}
            aria-label={dropped ? 'Reprendre la tâche' : 'Abandonner la tâche'} aria-pressed={dropped}
            onClick={onToggleDropped}><DroppedMark /></button>
          {/* Verrou d'engagement : au-delà de 4h après création, la corbeille est grisée et inerte. */}
          <button type="button" className={`zrp-detail-icon${deletable ? '' : ' zrp-locked'}`} disabled={!deletable}
            title={deletable ? 'Delete task' : 'Locked — a goal older than 4h can’t be deleted'}
            aria-label="Delete task" onClick={deletable ? onDelete : undefined}><Icon name="trash" size={13} /></button>
          <button type="button" className="zrp-detail-icon" title="Close" aria-label="Close task detail" onClick={onClose}><Icon name="xmark" size={13} /></button>
        </div>
      </header>
      <div className="zrp-detail-status">
        <i className={`zrp-status-dot zrp-${status.tone}`} />
        <span className="zrp-status-copy">{status.label}{task.overdueSince && status.key !== 'planned' ? ` · Missed ${fmtShortDate(task.overdueSince)}` : ''}{task.streakId ? ' · Streak' : ''}{task.publish ? ' · Publication' : ''}{task.firstMovement ? ' · First movement' : ''}</span>
      </div>
      {pickerOpen && <ImagePicker onPick={(url) => { onPatch({ images: [...images, url], image: null }) }} onClose={() => setPickerOpen(false)} />}
      <textarea className="zrp-detail-note" placeholder="Write a short note…" aria-label="Task note" value={note}
        onChange={(e) => setNote(e.target.value)} onBlur={commitNow} />
      <PlanAttachments task={task} onPatch={onPatch} />
      {images.length > 0 && (
        <div className="zrp-images" role="list" aria-label="Task images">
          {images.map((src, index) => (
            <div key={`${index}:${src.slice(0, 32)}`} className="zrp-image" role="listitem" style={{ backgroundImage: `url(${src})` }}>
              <button type="button" className="zrp-image-remove" title="Remove image" aria-label="Remove image"
                onClick={() => onPatch({ images: images.filter((_, i) => i !== index), image: null })}><Icon name="xmark" size={10} /></button>
            </div>
          ))}
        </div>
      )}
      <footer className="zrp-detail-meta">
        <button type="button" className={`zrp-meta-chip${editingMeta === 'date' ? ' zrp-active' : ''}`}
          onClick={() => setEditingMeta((v) => v === 'date' ? null : 'date')}><strong>Date</strong>{fmtFullDate(task.date)}</button>
        <button type="button" className={`zrp-meta-chip${editingMeta === 'start' ? ' zrp-active' : ''}`}
          onClick={() => setEditingMeta((v) => v === 'start' ? null : 'start')}><strong>Start</strong>{fmt12(task.startTime)}</button>
        <button type="button" className={`zrp-meta-chip${editingMeta === 'block' ? ' zrp-active' : ''}`}
          onClick={() => setEditingMeta((v) => v === 'block' ? null : 'block')}><strong>Block</strong>{fmtDuration(task.durationMin || 0)}</button>
      </footer>
      {editingMeta === 'date' && (
        <div className="zrp-meta-editor zrp-meta-editor-cal">
          <MiniCalendar value={task.date} onSelect={(iso) => {
            const nextSlot = nextAvailableSlot(allTasks, iso, task.durationMin || DUREE_DEFAUT)
            onPatch({ date: iso, startTime: (!task.startTime || task.startTime === '09:00') ? nextSlot : task.startTime })
            setEditingMeta(null)
          }} />
        </div>
      )}
      {editingMeta === 'start' && (
        <div className="zrp-meta-editor zrp-meta-editor-cal">
          <PlanTimePicker
            value={task.startTime}
            tasks={allTasks}
            dateIso={task.date}
            durationMin={task.durationMin || DUREE_DEFAUT}
            onSelect={(time) => onPatch({ startTime: time })}
            onClose={() => setEditingMeta(null)}
          />
        </div>
      )}
      {editingMeta === 'block' && (
        <div className="zrp-meta-editor zrp-meta-editor-block">
          {DURATION_PRESETS.map(({ minutes, label }) => (
            <button key={minutes} type="button" className={`zrp-duration zrp-duration-sm${(task.durationMin || 0) === minutes ? ' zrp-active' : ''}`}
              onClick={() => onPatch({ durationMin: minutes })}>{label}</button>
          ))}
          <input type="number" min={5} max={DUREE_MAX} step={5} value={task.durationMin || 0} aria-label="Custom minutes"
            onChange={(e) => { const v = Math.max(5, Math.min(DUREE_MAX, Number(e.target.value) || 5)); onPatch({ durationMin: v }) }} />
        </div>
      )}
    </>
  )
}

function TaskTile({ task, today, onOpen, onToggleDone }) {
  const status = statusOf(task, today)
  const completed = status.key === 'done' || status.key === 'late-complete'
  const tileRef = useRef(null)
  const toggleDone = () => {
    if (!completed && !reducedMotion()) {
      for (const animation of tileRef.current?.getAnimations() || []) animation.cancel()
      tileRef.current?.animate(
        [
          { transform: 'scale(1)', filter: 'brightness(1.06)' },
          { transform: `scale(${PLAN_UI.motion.pressScale})`, filter: 'brightness(.96)', offset: .34 },
          { transform: `scale(${PLAN_UI.motion.releaseScale})`, filter: 'brightness(1.16)', offset: .7 },
          { transform: 'scale(1)', filter: 'brightness(1)' },
        ],
        { duration: PLAN_UI.motion.confirm, easing: 'cubic-bezier(.16,1,.3,1)' },
      )
    }
    onToggleDone(task)
  }
  return (
    // stopPropagation : bug réel corrigé le 2026-07-20 ("les tâches disparaissent immédiatement au
    // clic") -- sans lui, le clic REMONTAIT jusqu'à la cellule du jour, dont le onClick appelle
    // closePanel() : l'ouverture (requête posée par CE clic) était aussitôt écrasée par une demande de
    // fermeture posée par LE MÊME clic, et la boucle d'animation ouvrait puis refermait le bloc dans la
    // foulée. La référence évite ça avec un unique listener sur la grille (closest('.goal') -> return).
    // LA TUILE N'EST PLUS UN <button> (bug réel corrigé le 2026-08-07 : « je dois m'y reprendre au
    // moins 4 fois pour valider la tâche »). Elle en était un, et portait une case à cocher DEDANS —
    // or le HTML interdit un élément interactif à l'intérieur d'un bouton. Les navigateurs réparent
    // ce balisage chacun à leur façon, et le plus courant est d'attribuer le clic au BOUTON plutôt
    // qu'à la case : on ouvrait la tâche au lieu de la cocher, d'où l'impression d'un clic ignoré
    // qu'il fallait retenter. Un `div` avec le rôle et le clavier explicites rend la case légale, et
    // le clic atterrit enfin là où on vise. La seconde moitié du défaut, une cible de seize pixels,
    // se corrige dans PlanBoard.css (zone de clic élargie sans changer la taille dessinée).
    <div ref={tileRef} role="button" tabIndex={0} className={`zrp-task${status.key === 'dropped' ? ' zrp-dropped' : ''}${status.key === 'done' ? ' zrp-done' : ''}${status.key === 'late-complete' ? ' zrp-late-complete' : ''}${status.key === 'late' && !task.publish ? ' zrp-late' : ''}${task.publish && status.key === 'planned' ? ' zrp-publish' : ''}${task.publish && status.key === 'late' ? ' zrp-publish-late' : ''}${task.publish && (status.key === 'done' || status.key === 'late-complete') ? ' zrp-publish-done' : ''}${imagesOf(task).length ? ' zrp-has-image' : ''}`}
      onClick={(e) => { e.stopPropagation(); onOpen(task) }}
      onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); e.stopPropagation(); onOpen(task) } }}
      title={task.title}>
      <input type="checkbox" checked={completed}
        onClick={(e) => e.stopPropagation()} onChange={toggleDone} aria-label={`${task.title} done`} />
      {/* L'HEURE NE S'AFFICHE PLUS SUR LA TUILE (2026-08-22, demande Matthieu). Elle reste STOCKÉE et
          reste modifiable dans le panneau de détail : seul l'affichage disparaît de la grille, qui
          gagne en calme quand une semaine chargée empile les tâches. La tuile redevient donc une
          grille à deux enfants — case à cocher, titre — c'est-à-dire exactement ce que
          `grid-template-columns: 15px minmax(0,1fr)` décrit, avec la pastille de validation centrée
          verticalement et le titre sur la même ligne. La règle `:has(.zrp-task-time)` qui rendait le
          titre pleine largeur devient sans objet et part avec, plutôt que de rester en dette. */}
      <span className="zrp-task-body">{planTileTime(task) && <span className="zrp-task-time">{planTileTime(task)}</span>}<span className="zrp-task-title">{planTileBareTitle(task)}</span></span>
      {imagesOf(task).length > 0 && <span className="zrp-task-image-badge"><Icon name="photo" size={10} /></span>}
      {/* ABANDONNÉE : la marque se pose EN SURCOUCHE, semi-opaque, par-dessus toute la tuile — le
          texte reste lisible dessous, ce qui est le but (on doit pouvoir relire ce qu'on a renoncé
          à faire). `pointer-events: none` en CSS : elle ne doit jamais voler un clic. */}
      {status.key === 'dropped' && <span className="zrp-dropped-overlay" aria-hidden="true"><DroppedMark /></span>}
    </div>
  )
}

