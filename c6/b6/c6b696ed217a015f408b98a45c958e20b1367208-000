// ── L'ANNEAU DE DURÉE (2026-08-27, demande de Matthieu, deux images à l'appui) ─────────────────────
//
// Ce qu'il a décrit : « un cercle anneau rond où tu cliques sur la zone découpée en 15 30 90, plus un
// anneau complété similaire à celui de Claude Code, l'anneau visuel qui se remplit à l'extérieur, en
// plus du camembert ». Deux objets superposés, donc, et ils ne disent pas la même chose :
//
//   — LE CAMEMBERT, au centre, est le CHOIX : trois parts égales, une par palier, on clique dedans.
//     Des parts égales et non proportionnelles à la durée, sinon 15 minutes offrirait une cible six
//     fois plus petite que 90 et deviendrait pénible à viser, exactement à l'inverse de ce qu'on veut
//     puisque c'est le palier par défaut.
//   — L'ANNEAU EXTÉRIEUR est la MESURE : il se remplit à proportion de la durée retenue sur le
//     plafond. Lui est proportionnel, puisqu'il ne se clique pas et n'a qu'à donner l'échelle d'un
//     coup d'œil.
//
// Tout est en SVG et en `currentColor` : aucune image, aucune police, le composant suit le thème clair
// ou sombre sans une ligne de plus.
const ANNEAU = { taille: 132, rExt: 58, rInt: 44, largeurAnneau: 7 }
// Un point du cercle, l'angle compté depuis le HAUT et dans le sens horaire — le sens de lecture d'une
// horloge, celui qu'on attend d'un cadran. Le repère SVG ayant ses ordonnées vers le bas, le sinus et le
// cosinus s'échangent par rapport à la formule scolaire ; c'est la seule subtilité du calcul.
const pointCercle = (cx, cy, r, deg) => {
  const a = ((deg - 90) * Math.PI) / 180
  return [cx + r * Math.cos(a), cy + r * Math.sin(a)]
}
// Une part de camembert : centre, arc, retour au centre.
const partCamembert = (cx, cy, r, debut, fin) => {
  const [x1, y1] = pointCercle(cx, cy, r, debut)
  const [x2, y2] = pointCercle(cx, cy, r, fin)
  const grand = fin - debut > 180 ? 1 : 0
  return `M ${cx} ${cy} L ${x1} ${y1} A ${r} ${r} 0 ${grand} 1 ${x2} ${y2} Z`
}

function AnneauDuree({ minutes, onChoisir }) {
  const { taille, rExt, rInt, largeurAnneau } = ANNEAU
  const c = taille / 2
  const circonference = 2 * Math.PI * rExt
  const part = Math.max(0, Math.min(1, (minutes || 0) / DUREE_MAX))
  const parts = DURATION_PRESETS.length
  return (
    <svg className="zrp-anneau" viewBox={`0 0 ${taille} ${taille}`} width={taille} height={taille}
      role="group" aria-label="Durée du bloc">
      {/* Anneau extérieur : la piste, puis la portion remplie. `rotate(-90)` fait partir le remplissage
          du haut ; sans lui il commencerait à trois heures, ce qui se lit mal sur un cadran. */}
      <circle cx={c} cy={c} r={rExt} className="zrp-anneau-piste" strokeWidth={largeurAnneau} fill="none" />
      <circle cx={c} cy={c} r={rExt} className="zrp-anneau-plein" strokeWidth={largeurAnneau} fill="none"
        strokeLinecap="round" transform={`rotate(-90 ${c} ${c})`}
        strokeDasharray={`${circonference * part} ${circonference}`} />
      {DURATION_PRESETS.map(({ minutes: m, label }, i) => {
        const debut = (360 / parts) * i
        const fin = debut + 360 / parts
        const actif = minutes === m
        const [tx, ty] = pointCercle(c, c, rInt * 0.58, debut + 180 / parts)
        return (
          <g key={m} className={`zrp-anneau-part${actif ? ' zrp-actif' : ''}`} role="button" tabIndex={0}
            aria-label={`${label} minutes`} aria-pressed={actif}
            onClick={() => onChoisir(m)}
            onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); onChoisir(m) } }}>
            <path d={partCamembert(c, c, rInt, debut, fin)} />
            <text x={tx} y={ty} textAnchor="middle" dominantBaseline="central">{label}</text>
          </g>
        )
      })}
      {/* PAS DE CHIFFRE AU CENTRE : trois parts égales s'y rejoignent, un texte posé là tomberait sur
          leur jonction. La valeur retenue est annoncée dans l'en-tête du bloc, où elle a de la place —
          c'est aussi le seul endroit qui sait dire une durée personnalisée, laquelle n'allume aucune part. */}
    </svg>
  )
}

