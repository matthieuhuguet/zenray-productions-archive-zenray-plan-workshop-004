const parseIso = (s) => { const [y, m, d] = String(s || '').split('-').map(Number); return new Date(y || 2026, (m || 1) - 1, d || 1) }
const addDays = (iso, delta) => { const d = parseIso(iso); d.setDate(d.getDate() + delta); return isoOf(d) }
