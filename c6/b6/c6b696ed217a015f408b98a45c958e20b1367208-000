// Grille mensuelle : autant de rangées de 7 que nécessaire pour couvrir le mois (4/5/6 selon les mois),
// jamais un padding fixe à 6 -- chaque cellule porte sa vraie date, `outside` = mois adjacent.
function buildMonthGrid(year, month) {
  const firstWeekday = (new Date(year, month, 1).getDay() + 6) % 7 // lundi = 0
  const daysInMonth = new Date(year, month + 1, 0).getDate()
  const total = Math.ceil((firstWeekday + daysInMonth) / 7) * 7
  const cells = []
  for (let i = 0; i < total; i++) {
    const d = new Date(year, month, i - firstWeekday + 1)
    cells.push({ iso: isoOf(d), day: d.getDate(), outside: d.getMonth() !== month })
  }
  return cells
}

// Algorithme de placement EXACT du fichier de référence (performOpen, script v14) : préférence colonnes
// de droite, bascule à gauche près du bord, bascule vers le haut sur la dernière rangée. L'ancre (la
// cellule de la tâche cliquée) n'est JAMAIS absorbée : le bloc occupe les 2x2 cellules voisines.
function computePlacement(cellIndex, totalCells) {
  const row = Math.floor(cellIndex / 7) + 1
  const col = (cellIndex % 7) + 1
  const side = col <= 5 ? 'right' : 'left'
  const maxRows = Math.ceil(totalCells / 7)
  const vertical = row < maxRows ? 'down' : 'up'
  const startCol = side === 'right' ? col + 1 : col - 2
  const startRow = vertical === 'down' ? row : Math.max(1, row - 1)
  return { side, vertical, startCol, startRow }
}
function absorbedIsosFor(cells, { startCol, startRow }) {
  const out = []
  cells.forEach((cell, index) => {
    const r = Math.floor(index / 7) + 1
    const c = (index % 7) + 1
    if (r >= startRow && r < startRow + 2 && c >= startCol && c < startCol + 2) out.push(cell.iso)
  })
  return out
}

// Statut affiché = DÉRIVÉ à la lecture (jamais stocké "late" tel quel) : en retard = date passée et pas
// terminé. `overdueSince` se fixe une seule fois et ne bouge plus -- badge "Missed ..." conservé même
// après un rescue "Today" (règle explicite : jamais traité comme une tâche neuve). Libellés = ceux du
// statusFor de la référence.
function statusOf(task, today) {
  // ABANDONNÉE (2026-08-07) : testée AVANT tout le reste, parce qu'elle prime sur la date. Une tâche
  // qu'on renonce à faire n'est ni en retard ni à faire — elle sort du décompte sans disparaître de
  // l'historique, ce que Matthieu résume par « ça arrête d'update dans ma to-do list ».
  if (task.status === 'dropped') return { key: 'dropped', tone: 'muted', label: 'Abandonnée' }
  if (task.status === 'late-complete') return { key: 'late-complete', tone: 'violet', label: 'Finished later' }
  if (task.status === 'done') return { key: 'done', tone: 'green', label: 'Done on time' }
  if (task.date < today) return { key: 'late', tone: 'orange', label: 'Past deadline' }
  return { key: 'planned', tone: '', label: 'Planned' }
}

