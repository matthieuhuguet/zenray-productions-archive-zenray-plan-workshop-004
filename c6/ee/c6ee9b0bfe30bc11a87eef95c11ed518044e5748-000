import React, { useEffect, useState } from 'react'
import { createPortal } from 'react-dom'
import { PALETTE, RADII, QUICKLOOK_ANIM_MS } from '../theme.js'
import Icon from './Icon.jsx'
import SpinnerApple from './SpinnerApple.jsx'
import { notifyProgress } from './Notifications.jsx'
import { readImgManifestCached, shardImgUrl, isEncrypted, resolveFullUrl, resolveThumbUrl, prefetchThumbImages, downloadMedia, useResolvedDirectThumb } from './ImageNodeViewer.jsx'
import { getNodeThumb } from '../search/searchIndexClient.js'
import { resolveDisplayUrl } from '../media/imageCacheIDB.js'
import { downloadUrls } from '../lib/archiveChunks.js'
import { assembleBlobUrl } from '../lib/fetchAsset.js'
import { mimeForName, isNativePreview, kindForName } from '../lib/fileKinds.js'
import { lazyRetry } from '../lib/lazyRetry.js'
import { readPageCached } from '../lib/manifestReadCache.js'
import { resolveEaglePath, eaglePathConnu } from '../lib/eagleLink.js'
import { mediaSourceSegments } from '../lib/mediaProvenance.js'
import { estTriable } from '../lib/dossiersDeTri.js'
