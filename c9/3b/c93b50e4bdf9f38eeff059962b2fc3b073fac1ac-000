// Provenance d'un média = QUI sert réellement les octets à la lecture. Trois familles, trois
// couleurs canoniques (spec Matthieu 2026-07-20, appliquée à 100% des types de médias) :
//   VERT  #34c759 : CDN jsDelivr (public, hors quota API, la voie normale de TOUT nouvel upload)
//   BLEU  #0a84ff : raw.githubusercontent / API REST GitHub (parts 95 Mo blob-raw, archives, legacy)
//   ORANGE #cc7c5e : la requête traverse NOTRE fonction (/api/shard, /api/stream) au lieu d'un CDN.
//                   Le cas normal est un dépôt PRIVÉ : aucun CDN public ne le sert, donc la fonction
//                   va chercher les octets avec le jeton et les déchiffre au passage. Proxy à
//                   DÉPRÉCIER, ne doit rester que pour les manifestes vis:'private' et les replis.
//
// LA COULEUR DÉSIGNE UN CHEMIN, JAMAIS UN HÉBERGEUR (renommée le 2026-07-31).
// Elle s'appelait `vercel` et valait un jaune #f5b21a, ce qui était déjà un abus de langage et est
// devenu faux le jour où le site a migré sur Cloudflare : ces octets traversent désormais une
// fonction Cloudflare, sans qu'aucune ligne de ce fichier ait à changer de sens. Nommer une
// constante d'après son hébergeur du moment, c'est se condamner à la renommer au prochain
// déménagement ; `fonction` reste vrai partout.
// Un média peut afficher PLUSIEURS segments (ex. vignette jsDelivr + original raw.github legacy).
import { UI } from '../config/colors.js'

// Les trois familles empruntent la palette des sept, au lieu de porter leurs propres teintes : une
// interface qui invente une couleur par usage finit avec quatre verts legerement differents.
export const PROVENANCE = {
  cdn: UI.green,
  raw: UI.blue,
  fonction: UI.orange,
}

// mediaSourceSegments(manifest, nodeType) -> [{label, color}] ; [] si indéterminable (manifeste pas
// encore chargé). nodeType affine quand le manifeste seul est ambigu ('file' = archive .file.json).
export function mediaSourceSegments(m, nodeType = '') {
  if (!m) return []
  // ═══ UN LIEN EAGLE NE DIT RIEN DE LA PROVENANCE, ET SE TAIT PLUTÔT QUE DE MENTIR ═══════════════
  //
  // Signalé par Matthieu le 2026-08-31 : « je vois liens pastille jaune donc régression ? pourquoi
  // ne pas passer par jsDelivr ? ».
  //
  // IL N'Y A AUCUNE RÉGRESSION DE TRANSPORT, et c'est ce qu'il faut retenir. Les octets de l'image
  // passent exactement par où ils passaient : jsDelivr, comme le dit le manifeste CANONIQUE. Le
  // lien, lui, ne porte que `{ resourceId, title }` — c'est tout son intérêt, cent cinquante octets
  // au lieu d'une photo. Il n'a donc ni `vis`, ni `cdnRepo`, ni `iv`.
  //
  // Le bloc image plus bas entrait quand même, puisque le chemin finit par `.img.json`, n'y trouvait
  // pas `vis: 'public'`, et concluait « proxy privé (fonction) » en orange. Une pastille qui décrit
  // un chemin d'octets que personne n'emprunte est pire qu'une pastille absente : elle donne à
  // croire à une régression qui n'existe pas.
  //
  // On rend donc le même vide que pour un manifeste pas encore chargé. Là où le lien EST résolu
  // (Quick Look, visionneuse), c'est le manifeste canonique qui arrive ici, avec sa vraie couleur.
  if (m.type === 'zenray-eagle-link/v1') return []
  // Sources externes : ni GitHub ni Vercel, couleur de la marque.
  if (m.type === 'youtube') return [{ label: m.audioOnly ? 'YouTube (audio)' : 'YouTube (vidéo)', color: '#ff0000' }]
  if (m.type === 'spotify') return [{ label: 'Spotify', color: '#1ed760' }]
  if (m.type === 'gmaps') return [{ label: 'Google Maps', color: '#34a853' }]
  // ZenRayShards blob-raw : parts 95 Mo avec URL directe par part -- jsDelivr si l'URL le dit, sinon raw.github.
  if (m.type === 'blob-raw' && Array.isArray(m.parts) && m.parts.length && m.parts[0]?.url) {
    const viaCdn = String(m.parts[0].url).includes('cdn.jsdelivr.net')
    return [{ label: `${m.parts.length} part${m.parts.length > 1 ? 's' : ''} ${viaCdn ? 'jsDelivr' : 'raw.github'}`, color: viaCdn ? PROVENANCE.cdn : PROVENANCE.raw }]
  }
  // Archives .file.json (chunks 19 Mo hashés) : servies par raw.githubusercontent (jamais jsDelivr).
  if (nodeType === 'file' || m.mode === 'chunked' || m.mode === 'raw') {
    return [{ label: 'chunks raw.github', color: PROVENANCE.raw }]
  }
  // Vidéo DASH/HLS (segments fMP4 <= 20 Mo sur repos publics) : servie par jsDelivr.
  if (m.type === 'dash' || m.type === 'hls' || Array.isArray(m.ladder)) {
    return [{ label: 'segments jsDelivr', color: PROVENANCE.cdn }]
  }
  // Image .img.json.
  if (m.type === 'image' || nodeType === 'image') {
    if (m.vis !== 'public') return [{ label: 'proxy privé (fonction)', color: PROVENANCE.fonction }]
    if (!m.iv) return [{ label: 'jsDelivr (clair)', color: PROVENANCE.cdn }]
    if (Array.isArray(m.cdnChunks) && m.cdnChunks.length) {
      return [{ label: `jsDelivr chiffré · ${m.cdnChunks.length} morceau${m.cdnChunks.length > 1 ? 'x' : ''}`, color: PROVENANCE.cdn }]
    }
    return [
      { label: 'vignette jsDelivr', color: PROVENANCE.cdn },
      { label: 'original raw.github (legacy, non migré)', color: PROVENANCE.raw },
    ]
  }
  // chunked-media (.media.json audio/pdf/binaire) : public chiffré = jsDelivr (SW range-shim côté
  // lecteur depuis le 2026-07-20) ; privé = proxy Vercel.
  if (m.cdnRepo && Array.isArray(m.parts)) {
    if (m.vis === 'public') return [{ label: `jsDelivr chiffré · ${m.parts.length} morceau${m.parts.length > 1 ? 'x' : ''}`, color: PROVENANCE.cdn }]
    return [{ label: 'proxy privé (fonction)', color: PROVENANCE.fonction }]
  }
  // Manifeste privé/legacy sans référence CDN : proxy Vercel.
  if (m.repo || m.vis === 'private') return [{ label: 'proxy privé (fonction)', color: PROVENANCE.fonction }]
  return []
}
