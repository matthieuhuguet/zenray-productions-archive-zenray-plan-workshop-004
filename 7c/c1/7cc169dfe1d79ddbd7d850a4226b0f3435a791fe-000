// ZenRayMedia — L8 : PUBLIER.
//
// Publier n'est pas enregistrer (cf. `document.js`) :
//   enregistrer -> `.zmedia.json`, la SOURCE, pour rouvrir et continuer ;
//   publier     -> une PAGE `.md` dans Create, figée, lisible, cherchable, adressable par URL.
//
// Le format de sortie est du Markdown, pas du HTML compilé. Raison : une page `.md` est un
// citoyen de première classe de Create — elle s'ouvre dans l'éditeur, se cherche, se déplace,
// se partage, se modifie. Une page HTML serait un corps étranger qu'aucun outil du projet ne
// saurait relire. Le rendu stylé, lui, reste l'export (`exporters.js`).

import { saveText } from '../ref/content.js'
import { ROLE_LABELS } from './contracts.js'
import { visibleBeats } from './compile.js'
import { slugify } from './document.js'

/** Markdown d'un article. Déterministe : mêmes entrées, même texte, à l'octet près. */
export function toMarkdown({ brief, cut, theme, format }) {
  const lines = []
  lines.push(`# ${brief.title}`)
  lines.push('')
  if (brief.message) { lines.push(`> ${brief.message}`); lines.push('') }
  if (brief.audience) { lines.push(`*Pour ${brief.audience}.*`); lines.push('') }

  for (const beat of visibleBeats(cut, format)) {
    // Le rôle devient un intertitre seulement quand il porte du sens à la lecture. Une accroche
    // et une chute n'ont pas besoin d'être annoncées : elles se reconnaissent à leur place.
    if (!['hook', 'payoff'].includes(beat.role)) {
      lines.push(`### ${ROLE_LABELS[beat.role] || beat.role}`)
      lines.push('')
    }
    lines.push(String(beat.text).trim())
    lines.push('')
    for (const slot of beat.slots || []) {
      const src = slot.dataUrl || slot.url
      if (src) { lines.push(`![${(slot.label || '').replace(/[[\]]/g, '')}](${src})`); lines.push('') }
    }
  }

  lines.push('---')
  lines.push('')
  lines.push(`*Composé avec ZenRayMedia · thème « ${theme.name} » · format ${format.label}.*`)
  lines.push('')
  return lines.join('\n')
}

export function publishPathFor(dir, title) {
  return `${String(dir).replace(/\/+$/, '')}/${slugify(title)}.md`
}

/** URL de l'application qui ouvre directement cette page. */
export function pageUrlFor(path, origin) {
  const base = origin || (typeof window !== 'undefined' ? window.location.origin : '')
  return `${base}/?page=${encodeURIComponent(path)}`
}

/**
 * Publie l'article et rend son adresse.
 *
 * Trois étapes, dans cet ordre, parce que l'ordre compte :
 *   1. écrire la page (si ça échoue, rien d'autre ne doit se produire) ;
 *   2. l'ajouter à l'index de recherche (sinon elle existe mais reste introuvable) ;
 *   3. rendre l'URL — ET SEULEMENT SI les deux premières ont réussi.
 *
 * L'indexation est volontairement NON bloquante : une page écrite mais pas encore indexée est
 * un défaut mineur et réparable (elle sera reprise au prochain build d'index), alors qu'une
 * publication annulée parce que l'index a hoqueté serait une perte pour rien.
 */
export async function publishArticle({ dir, brief, cut, theme, format, sha, origin }) {
  const path = publishPathFor(dir, brief.title)
  const markdown = toMarkdown({ brief, cut, theme, format })

  const written = await saveText(path, markdown, sha)
  if (written.conflict) return { ok: false, conflict: true, path, error: 'Une page porte déjà ce nom et a changé depuis. Renomme l’article ou recharge.' }
  if (!written.ok) return { ok: false, path, error: written.error === 'network' ? 'Publication impossible (réseau).' : `Publication refusée (${written.error || 'inconnu'}).` }

  let indexed = true
  try {
    const res = await fetch('/api/page', {
      method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ action: 'index-add', paths: [path] }),
    }).then((r) => r.json()).catch(() => null)
    indexed = !!(res && !res.error)
  } catch { indexed = false }

  return { ok: true, path, sha: written.sha, indexed, url: pageUrlFor(path, origin), bytes: new Blob([markdown]).size }
}
