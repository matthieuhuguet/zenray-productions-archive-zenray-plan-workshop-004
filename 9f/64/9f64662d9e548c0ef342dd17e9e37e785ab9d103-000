import * as afjv from './Afjv.mjs'
import * as keywords from './Keywords.mjs'
import * as gamesindustry from './GamesIndustry.mjs'
import { boamp, ted } from './Tenders.mjs'
import { indexes } from './Indexes.mjs'
import { remotive, jobicy, remoteok, arbeitnow } from './Aggregators.mjs'
import { smartrecruiters, lever, greenhouse, ashby, recruitee, breezy, teamtailor } from './Ats.mjs'

export const REGISTRY = { afjv: afjv.collect, gamesindustry: gamesindustry.collect, keywords: keywords.collect, smartrecruiters, lever, greenhouse, ashby, recruitee, breezy, teamtailor, remotive, jobicy, remoteok, arbeitnow, boamp, ted, indexes }

/** Runs every enabled source; one source failing yields an incomplete board with its error and never stops the others. */
export async function collectAll({ http, config, registry = REGISTRY, only = null, onSource = () => {}, context = {} }) {
  const names = Object.keys(registry).filter((name) => config.sources[name]?.enabled && (!only || only.includes(name)))
  const settled = await Promise.all(names.map(async (name) => {
    try {
      const boards = await registry[name]({ http, config, ...context })
      onSource(name, { ok: true, boards: boards.length })
      return boards
    } catch (error) {
      onSource(name, { ok: false, error: error.message })
      return [{ key: name, label: config.sources[name].label || name, listings: [], seenIds: [], listed: 0, matched: 0, errors: [{ source: name, error: error.message }], complete: false }]
    }
  }))
  return settled.flat()
}
