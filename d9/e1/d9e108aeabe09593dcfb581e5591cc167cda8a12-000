import { describe, expect, it } from 'vitest'
import { PLAN_CSS_VARIABLES, PLAN_UI, planDateDirection, planDayLabel } from './planUiConfig.js'

describe('ZenRay Plan UI config', () => {
  it('keeps editable values connected to the CSS variables', () => {
    expect(PLAN_CSS_VARIABLES['--zrp-font-task']).toBe(`${PLAN_UI.type.task}px`)
    expect(PLAN_CSS_VARIABLES['--zrp-motion-panel']).toBe(`${PLAN_UI.motion.panel}ms`)
  })

  it('labels the current day as Today and other dates with full weekday names', () => {
    expect(planDayLabel('2026-08-06', '2026-08-06')).toBe('Today')
    expect(planDayLabel('2026-08-03', '2026-08-06')).toBe('Monday')
    expect(planDayLabel('2026-08-09', '2026-08-06')).toBe('Sunday')
  })

  it('derives the animation direction from ISO dates', () => {
    expect(planDateDirection('2026-08-07', '2026-08-06')).toBe('forward')
    expect(planDateDirection('2026-07-31', '2026-08-01')).toBe('backward')
    expect(planDateDirection('2026-08-06', '2026-08-06')).toBe('still')
  })
})

// planTileTitle (23 October 2026): computed range, no duplicate, no time when none is set.
import { planTileTitle as tileTitle, planTileTime, planTileBareTitle } from './planUiConfig.js'
describe('planTileTitle', () => {
  it('adds the range from startTime and durationMin', () => { expect(tileTitle({ title: 'sport', startTime: '12:00', durationMin: 90 })).toBe('12:00-13:30 · sport') })
  it('never shows a stored range twice', () => { expect(tileTitle({ title: '09:00-10:30 · Nibir Khan RDV', startTime: '09:00', durationMin: 90 })).toBe('09:00-10:30 · Nibir Khan RDV') })
  it('recomputes a stale stored range after a move', () => { expect(tileTitle({ title: '09:00-10:30 · rdv', startTime: '14:00', durationMin: 60 })).toBe('14:00-15:00 · rdv') })
  it('leaves a task without start time alone', () => { expect(tileTitle({ title: 'sport', startTime: null, durationMin: 60 })).toBe('sport') })
  it('hides the range when show is false', () => { expect(tileTitle({ title: '09:00-10:30 · rdv', startTime: '09:00', durationMin: 90 }, { show: false })).toBe('rdv') })
})

describe('planTileTime and planTileBareTitle (23 October 2026)', () => {
  it('splits time and bare title', () => {
    const t = { title: '09:00-10:30 · rdv', startTime: '14:00', durationMin: 60 }
    expect(planTileTime(t)).toBe('14:00-15:00'); expect(planTileBareTitle(t)).toBe('rdv')
  })
  it('no time without a start', () => { expect(planTileTime({ title: 'x' })).toBe('') })
})
