// 9 October 2026, 01:22 CEST: Build read-only gallery entries from paths already present in the cloud index.
import { typeOfPath, stripLeafExt, legacyFlags } from '../create/node.js'
import { kindForName } from './fileKinds.js'

const IMAGE_MANIFEST = /\.(?:file|img)\.json$/i

export function linkedProjectImageFiles(project, paths, getMime = () => null) {
  if (!project?.id || !Array.isArray(paths)) return []
  const folder = project.folder || `pages/ZenRayAssets/${project.id}`
  const prefix = folder.endsWith('/') ? folder : `${folder}/`
  const seen = new Set()
  const files = []

  for (const contentPath of paths) {
    if (typeof contentPath !== 'string' || !contentPath.startsWith(prefix) || !IMAGE_MANIFEST.test(contentPath) || seen.has(contentPath)) continue
    seen.add(contentPath)
    const name = stripLeafExt(contentPath).split('/').pop() || ''
    const mime = getMime(contentPath) || ''
    const kind = kindForName(name)
    const type = typeOfPath(contentPath)
    if (type !== 'image' && !kind.startsWith('image') && !String(mime).startsWith('image/')) continue
    const relativePath = contentPath.slice(prefix.length)
    const segments = relativePath.split('/')
    const directory = segments.slice(0, -1).join('/')
    const source = segments[0] === 'sources' ? (segments[1] || 'sources') : 'legacy'
    files.push({
      id: contentPath,
      name,
      contentPath,
      relativePath,
      directory,
      source,
      type,
      kind,
      mime,
      hasKids: false,
      dir: stripLeafExt(contentPath),
      ...legacyFlags(type),
    })
  }

  return files.sort((a, b) => a.name.localeCompare(b.name, 'fr') || a.contentPath.localeCompare(b.contentPath))
}

export function filterLinkedProjectImages(files, { source = '', directory = '', search = '' } = {}) {
  const query = String(search).trim().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()
  return (Array.isArray(files) ? files : []).filter((file) => {
    if (source && file.source !== source) return false
    if (directory && file.directory !== directory) return false
    if (!query) return true
    const haystack = `${file.name} ${file.relativePath}`.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()
    return haystack.includes(query)
  })
}

// 9 October 2026, 01:51 CEST: Keep cloud folder navigation separate from curated Gallery groups.
export function linkedProjectImageFolderSegments(file) {
  const directorySegments = String(file?.directory || '').split('/').filter(Boolean)
  if (directorySegments[0] === 'sources') directorySegments.shift()
  if (directorySegments[0] === file?.source) directorySegments.shift()
  return [file?.source || 'legacy', ...directorySegments]
}

export function browseLinkedProjectImages(files, { path = [], source = '', search = '' } = {}) {
  const folderPath = Array.isArray(path) ? path.filter(Boolean) : []
  const candidates = filterLinkedProjectImages(files, { source, search })
  const folderCounts = new Map()
  const currentFiles = []

  for (const file of candidates) {
    const segments = linkedProjectImageFolderSegments(file)
    if (folderPath.some((segment, index) => segments[index] !== segment)) continue
    if (segments.length === folderPath.length) {
      currentFiles.push(file)
      continue
    }
    const name = segments[folderPath.length]
    if (name) folderCounts.set(name, (folderCounts.get(name) || 0) + 1)
  }

  const folders = [...folderCounts.entries()]
    .map(([name, count]) => ({ name, count }))
    .sort((left, right) => left.name.localeCompare(right.name, 'fr'))

  return { folders, files: currentFiles }
}
