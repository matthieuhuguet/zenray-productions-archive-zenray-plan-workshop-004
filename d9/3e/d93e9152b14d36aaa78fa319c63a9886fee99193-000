import { describe, it } from 'node:test'
import assert from 'node:assert/strict'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { readUploadTiming } from './activity-source.mjs'

const NOW = Date.parse('2026-10-14T10:00:00.000Z')
const write = (root, rel, body) => { const file = path.join(root, rel); fs.mkdirSync(path.dirname(file), { recursive: true }); fs.writeFileSync(file, JSON.stringify(body)) }

describe('readUploadTiming', () => {
  it('returns the newest fresh report two levels deep, and null for stale, broken or missing ones (red controls)', () => {
    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'zr-timing-'))
    assert.equal(readUploadTiming(root, NOW), null)
    write(root, 'a/b/UploadTiming.json', { message: 'old', generatedAt: '2026-10-14T09:00:00.000Z' })
    write(root, 'c/UploadTiming.json', { message: 'new', generatedAt: '2026-10-14T09:30:00.000Z' })
    write(root, 'd/UploadTiming.json', { message: 'stale', generatedAt: '2026-10-10T09:30:00.000Z' })
    fs.mkdirSync(path.join(root, 'e')); fs.writeFileSync(path.join(root, 'e/UploadTiming.json'), '{broken')
    assert.equal(readUploadTiming(root, NOW).message, 'new')
    assert.equal(readUploadTiming(root, NOW + 25 * 3600 * 1000), null)
  })
})

import { readUploadQueue } from './activity-source.mjs'

describe('readUploadQueue', () => {
  it('keeps a running queue for hours, a finished one for 30 minutes, and ignores broken files (red controls)', () => {
    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'zr-queue-'))
    assert.equal(readUploadQueue(root, NOW), null)
    const queue = (updatedAt, running) => ({ updatedAt, running, total: 2, finished: running ? 1 : 2, counts: {}, items: [{ name: 'a.mkv', stage: 'done' }] })
    write(root, 'a/UploadQueueStatus.json', queue('2026-10-14T07:30:00.000Z', true))
    assert.equal(readUploadQueue(root, NOW).running, true)
    assert.equal(readUploadQueue(root, NOW + 4 * 3600 * 1000), null)
    write(root, 'a/UploadQueueStatus.json', queue('2026-10-14T09:50:00.000Z', false))
    assert.equal(readUploadQueue(root, NOW).running, false)
    assert.equal(readUploadQueue(root, NOW + 31 * 60 * 1000), null)
    fs.writeFileSync(path.join(root, 'a/UploadQueueStatus.json'), '{broken')
    assert.equal(readUploadQueue(root, NOW), null)
  })
})

describe('readUploadQueue pid check (14 October 2026)', () => {
  it('treats a queue whose worker pid is dead as not running (red control: a live pid stays running)', () => {
    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'zr-queue-pid-'))
    const queue = (pid) => ({ updatedAt: '2026-10-14T09:50:00.000Z', running: true, pid, total: 2, finished: 1, counts: {}, items: [{ name: 'a.mkv', stage: 'archive' }] })
    write(root, 'a/UploadQueueStatus.json', queue(4194301))
    assert.equal(readUploadQueue(root, NOW).running, false)
    write(root, 'a/UploadQueueStatus.json', queue(process.pid))
    assert.equal(readUploadQueue(root, NOW).running, true)
  })
})
