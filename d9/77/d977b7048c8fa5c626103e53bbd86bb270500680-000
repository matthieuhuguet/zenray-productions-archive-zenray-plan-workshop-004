// 3 October 2026, 15:16 CEST: the reader preserves authored line breaks and dates while distinguishing actual transcript provenance.
import { expect, it } from 'vitest'
import { feedbackEvents } from './AssetsHistory.mjs'
it('restores original transcript text from dated feedback quotes without duplicate source events', () => {
  const stamp = '3 October 2026, 15:00:00 +0200'
  const marker = 'a'.repeat(64)
  const md = `## ${stamp} : Prompt\n<!-- feedback-event:${marker} (${stamp}) -->\n- Project: demo; kind: prompt. (${stamp})\n- Source: /Users/me/.codex/sessions/session.jsonl. (${stamp})\n\n> Keep this date (3 October 2026). (${stamp})\n>\n> Second line. (${stamp})\n`
  const event = feedbackEvents(md, { projectId: 'demo', sourcePath: '/memory/FEEDBACK.md' })[0]
  expect(event.body).toBe('Keep this date (3 October 2026).\n\nSecond line.')
  expect(event.provenance).toEqual({ provider: 'Codex', mode: 'transcript', transcriptFile: 'session.jsonl' })
  expect(event.id).toBe(marker)
  expect(feedbackEvents(md, { projectId: 'demo', sourcePath: '/other/FEEDBACK.md' })[0].id).toBe(marker)
})
it('keeps unquoted legacy content and avoids fabricating a transcript provider', () => {
  const event = feedbackEvents('## Old feedback\nDo not lose the source.', { projectId: 'demo' })[0]
  expect(event.body).toBe('Do not lose the source.')
  expect(event.provenance.mode).toBe('feedback')
  expect(event.provenance.provider).toBeNull()
})

// 3 October 2026, 22:25 CEST: an agent's delegated task is not labeled as a human prompt.
it('preserves the native sidechain identity and delegated order in the timeline', () => {
  const event = feedbackEvents('## 3 October 2026 : Order\n- Project: demo; kind: order. (3 October 2026)\n- Source: /Users/me/.claude/projects/project/parent/subagents/agent-real-worker.jsonl. (3 October 2026)\n\n> Check dependencies. (3 October 2026)\n', { projectId: 'demo' })[0]
  expect(event.type).toBe('order')
  expect(event.provenance).toMatchObject({ actor: 'subagent', agentId: 'real-worker', provider: 'Claude Code', mode: 'transcript' })
  expect(event.body).toBe('Check dependencies.')
})
