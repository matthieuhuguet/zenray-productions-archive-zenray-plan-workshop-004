const noop = () => {}
createRoot(document.getElementById('root')).render(
  <div className={dark ? 'zr-dark' : ''} style={{ display: 'flex', minHeight: '100vh', padding: 12 }}>
    <Sidebar t={THEMES[dark ? 'dark' : 'light']} view="plan" setView={noop} floating={false} theme={dark ? 'dark' : 'light'} setTheme={noop}
