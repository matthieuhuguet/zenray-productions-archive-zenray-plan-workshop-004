// La version du core servie par le CDN doit suivre celle du paquet installé.
//
// Sans ce test, une montée de version de `@ffmpeg/core` dans package.json laisserait le CDN pinné
// sur l'ancienne : le worker ESM installé chargerait un core d'une autre version, et l'échec
// remonterait sous la forme d'un `ffmpeg-load-failed` opaque qui ne dit rien de la cause réelle.
import { describe, it, expect } from 'vitest'
import { readFileSync } from 'node:fs'
import { FFMPEG_CORE_VERSION } from './ffmpegCore.js'

describe('ffmpeg core servi par CDN', () => {
  it('est pinné sur la version de @ffmpeg/core installée', () => {
    const pkg = JSON.parse(readFileSync('package.json', 'utf8'))
    const declaree = String(pkg.dependencies['@ffmpeg/core']).replace(/^[\^~]/, '')
    expect(FFMPEG_CORE_VERSION).toBe(declaree)
  })
})
