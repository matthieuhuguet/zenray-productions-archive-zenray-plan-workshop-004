// Reecriture des playlists media_*.m3u8 avec les URLs immuables jsDelivr@commit (10 October 2026)
export function rewriteMediaPlaylist(text, urlMap) {
  return text.split('\n').map((line) => {
    const trimmed = line.trim()
    const mapMatch = /^#EXT-X-MAP:URI="([^"]+)"(.*)$/.exec(trimmed)
    if (mapMatch) {
      const mapped = urlMap[mapMatch[1].trim()]
      return mapped ? `#EXT-X-MAP:URI="${mapped}"${mapMatch[2]}` : line
    }
    if (trimmed && !trimmed.startsWith('#')) {
      return urlMap[trimmed] || line
    }
    return line
  }).join('\n')
}

// Reecriture du master.m3u8 pour pointer vers /api/hls?path=pages/... et completer CODECS si ffmpeg copy l'omet (10 October 2026)
export function rewriteMasterPlaylist(text, streamRelDir, vCodec) {
  const defaultVideoCodec = vCodec === 'av1' ? 'av01.0.08M.10' : (vCodec === 'hevc' ? 'hvc1.2.4.L120.90' : 'avc1.640028')
  return text.split('\n').map((line) => {
    let out = line
    const trimmed = out.trim()
    if (trimmed.startsWith('#EXT-X-STREAM-INF:')) {
      out = out.replace(/CODECS=",/g, `CODECS="${defaultVideoCodec},`)
      out = out.replace(/CODECS=""/g, `CODECS="${defaultVideoCodec}"`)
      if (!/CODECS="/.test(out)) {
        out += `,CODECS="${defaultVideoCodec},mp4a.40.2"`
      }
    }
    if (trimmed.startsWith('#EXT-X-MEDIA:')) {
      out = out.replace(/URI="([^"]+)"/, (_, uri) => {
        const clean = uri.trim()
        return `URI="/api/hls?path=${encodeURIComponent(`${streamRelDir}/${clean}`)}"`
      })
    }
    if (trimmed && !trimmed.startsWith('#') && /\.m3u8$/i.test(trimmed)) {
      return `/api/hls?path=${encodeURIComponent(`${streamRelDir}/${trimmed}`)}`
    }
    return out
  }).join('\n')
}

// Injection du BaseURL jsDelivr@commit dans manifest.mpd (10 October 2026)
export function rewriteDashMpd(mpdXml, cdnBaseUrl) {
  if (mpdXml.includes('<BaseURL>')) return mpdXml
  return mpdXml.replace(/(<Period[^>]*>)/, `$1\n\t\t<BaseURL>${cdnBaseUrl}</BaseURL>`)
}

// Verification HEAD sur jsDelivr d'au moins un segment .m4s (10 October 2026)
export async function verifyJsDelivrSegment(url, { fetchImpl = fetch, sleep = (ms) => new Promise((r) => setTimeout(r, ms)) } = {}) {
  // 14 October 2026: jsDelivr refuses or blocks the segments of a fresh commit of a large public shard (404 "Failed to fetch the
  // requested commit", 503, silence) while GitHub raw serves the same bytes: the proof that the segment is published is that ONE of the
  // two answers; the player falls back to raw by itself. FR : la preuve de publication est qu'une des deux origines repond.
  const raw = rawFallbackUrl(url)
  for (let attempt = 0; attempt < 5; attempt += 1) {
    for (const candidate of raw ? [url, raw] : [url]) {
      try {
        const res = await fetchImpl(candidate, { method: 'HEAD' })
        if (res.ok) return { ok: true, status: res.status, url, via: candidate === url ? 'jsdelivr' : 'raw' }
      } catch {}
    }
    await sleep(1200 * (attempt + 1))
  }
  return { ok: false, url }
}
