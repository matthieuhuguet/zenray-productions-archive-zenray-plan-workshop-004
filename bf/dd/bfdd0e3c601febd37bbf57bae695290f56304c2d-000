#!/bin/zsh
# SWAP.sh — Phase D of the 2026-07-11 ZenRayShards refactor (see docs/REFACTOR-SHARDS-2026-07-11.md).
#
# PRECONDITION (HARD GATE): the line "DJI UPLOAD 10-07 ET 07-07 COMPLET" must be present in
# ~/.zr-runs/dji-upload-10-07-et-07-07.log — i.e. no running/pending process will re-read the
# frozen originals. This script refuses to run otherwise.
#
# What it does: copies the staged rewrites over the real paths, syntax-checks everything, then
# grep-asserts every paid-for invariant. It does NOT commit — review `git diff` then commit.
set -e
cd "$(dirname "$0")/../.."   # repo root

LOG=~/.zr-runs/dji-upload-10-07-et-07-07.log
if ! grep -q "DJI UPLOAD 10-07 ET 07-07 COMPLET" "$LOG" 2>/dev/null; then
  echo "✗ REFUS : le sentinel de fin de run est absent de $LOG — le run relirait du code non testé."
  exit 1
fi
if pgrep -f "upload-img-list.mjs|upload-vidraw-list.mjs" > /dev/null; then
  echo "✗ REFUS : un process d'upload tourne encore."
  exit 1
fi

echo "== swap staging -> chemins réels =="
cp scripts/_staging/scripts/lib/shard-repo.mjs   scripts/lib/shard-repo.mjs
cp scripts/_staging/scripts/lib/img-pipeline.mjs scripts/lib/img-pipeline.mjs
cp scripts/_staging/scripts/img-ingest.mjs       scripts/img-ingest.mjs
cp scripts/_staging/scripts/video-raw-lib.mjs    scripts/video-raw-lib.mjs
cp scripts/_staging/scripts/video-mse-lib.mjs    scripts/video-mse-lib.mjs
cp scripts/_staging/scripts/upload-img-list.mjs  scripts/upload-img-list.mjs
cp scripts/_staging/scripts/upload-vidraw-list.mjs scripts/upload-vidraw-list.mjs
cp scripts/_staging/src/lib/fileKinds.js         src/lib/fileKinds.js

echo "== node --check =="
for f in scripts/lib/shard-repo.mjs scripts/lib/img-pipeline.mjs scripts/img-ingest.mjs \
         scripts/video-raw-lib.mjs scripts/video-mse-lib.mjs scripts/upload-img-list.mjs \
         scripts/upload-vidraw-list.mjs src/lib/fileKinds.js; do
  node --check "$f" || { echo "✗ SYNTAXE $f"; exit 1; }
done

echo "== assertions d'invariants (bugs payés) =="
grep -q "tag:v', 'hvc1'" scripts/video-raw-lib.mjs            || { echo "✗ hvc1 absent"; exit 1; }
grep -q "4.0 \* 1024 \* 1024 \* 1024" scripts/video-raw-lib.mjs || { echo "✗ cap vid 4.0 GiB absent"; exit 1; }
grep -q "400 \* 1024 \* 1024" scripts/video-raw-lib.mjs        || { echo "✗ push vid 400 Mo absent"; exit 1; }
grep -q "800 \* 1024 \* 1024" scripts/img-ingest.mjs           || { echo "✗ push img 800 Mo absent"; exit 1; }
grep -q "19 \* 1024 \* 1024" scripts/lib/img-pipeline.mjs      || { echo "✗ chunk img 19 Mo absent"; exit 1; }
grep -q "4.3 \* 1073741824" scripts/lib/img-pipeline.mjs       || { echo "✗ cap img 4,3 Go absent"; exit 1; }
grep -q "zenrayshards" scripts/lib/shard-repo.mjs              || { echo "✗ préfixe zenrayshards absent"; exit 1; }
grep -q "ivFromHash" scripts/lib/img-pipeline.mjs              || { echo "✗ IV déterministe absent"; exit 1; }
grep -q "writePart = ctx.writeBinary" scripts/video-raw-lib.mjs || { echo "✗ alias writePart absent"; exit 1; }

echo "== build du site (fileKinds est importé par le viewer) =="
npm run build > /dev/null 2>&1 && echo "build OK" || { echo "✗ BUILD"; exit 1; }

echo ""
echo "✓✓ SWAP OK. Reste à faire À LA MAIN :"
echo "  1. smoke test réel : 1 petite image + 1 mini vidéo -> pages/System/RefactorTest"
echo "     GITHUB_TOKEN=\$(gh auth token) node scripts/upload-img-list.mjs 'pages/System/RefactorTest' <img>"
echo "     GITHUB_TOKEN=\$(gh auth token) node scripts/upload-vidraw-list.mjs 'pages/System/RefactorTest' <mp4>"
echo "  2. vérifier : tuiles visibles, image jsDelivr 200, vidéo lisible, ffprobe hvc1 si HEVC"
echo "  3. git add -A && git commit && git push, puis supprimer scripts/_staging/"
