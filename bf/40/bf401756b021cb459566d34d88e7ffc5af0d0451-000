import { describe, it, expect, vi, beforeEach } from 'vitest'
import { readPageCached, clearPageReadCache } from './manifestReadCache.js'

describe('readPageCached', () => {
  beforeEach(() => { clearPageReadCache(); vi.restoreAllMocks() })

  it('ne fetch qu\'une fois pour la même URL (cache + dédup des appels concurrents)', async () => {
    const fetchSpy = vi.spyOn(global, 'fetch').mockResolvedValue({ ok: true, json: async () => ({ markdown: '# hello' }) })
    const [a, b] = await Promise.all([readPageCached('/u1'), readPageCached('/u1')])
    expect(a).toEqual({ markdown: '# hello' })
    expect(b).toEqual({ markdown: '# hello' })
    expect(fetchSpy).toHaveBeenCalledTimes(1)
    const c = await readPageCached('/u1')
    expect(c).toEqual({ markdown: '# hello' })
    expect(fetchSpy).toHaveBeenCalledTimes(1)
  })

  it('ne met pas en cache un échec HTTP (retry autorisé)', async () => {
    const fetchSpy = vi.spyOn(global, 'fetch').mockResolvedValueOnce({ ok: false }).mockResolvedValueOnce({ ok: true, json: async () => ({ markdown: 'y' }) })
    const first = await readPageCached('/u2')
    expect(first).toBeNull()
    const second = await readPageCached('/u2')
    expect(second).toEqual({ markdown: 'y' })
    expect(fetchSpy).toHaveBeenCalledTimes(2)
  })

  it('retourne markdown BRUT (texte ou JSON string), ne parse jamais lui-même', async () => {
    vi.spyOn(global, 'fetch').mockResolvedValue({ ok: true, json: async () => ({ markdown: JSON.stringify({ mime: 'audio/wav' }) }) })
    const j = await readPageCached('/u3')
    expect(typeof j.markdown).toBe('string')
    expect(JSON.parse(j.markdown)).toEqual({ mime: 'audio/wav' })
  })

  it('URLs différentes = entrées distinctes', async () => {
    vi.spyOn(global, 'fetch').mockImplementation((url) => Promise.resolve({ ok: true, json: async () => ({ markdown: url }) }))
    const a = await readPageCached('/a')
    const b = await readPageCached('/b')
    expect(a.markdown).toBe('/a')
    expect(b.markdown).toBe('/b')
  })
})
