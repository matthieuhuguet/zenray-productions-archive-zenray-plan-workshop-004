/* Archive originale V9 (06 October 2026) */
.zr-video-glass,
.zr-video-seek-pill,
.zr-video-volume-pill,
.zr-video-options-pill,
.zr-video-settings-menu {
  color: var(--g9-fg);
  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-a),
    var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%);
  -webkit-backdrop-filter: blur(27px) saturate(169%);
}
.zr-video-glass {
  display: inline-grid;
  place-items: center;
  flex: 0 0 auto;
  padding: 0;
  border: 0;
  border-radius: 999px;
  cursor: pointer;
  transition: transform var(--g9-timing) var(--g9-ease), filter var(--g9-timing) var(--g9-ease);
}
.zr-video-glass:hover { filter: brightness(1.06); transform: scale(1.03); }
.zr-video-glass:active { transform: scale(.96); }
.zr-video-glass:disabled { cursor: default; opacity: .42; transform: none; }
.zr-video-controls {
  position: absolute; inset: 0;
  z-index: 3;
  padding: 22px;
  pointer-events: none;
  background: none;
  transition: opacity .2s ease;
}
.zr-video-controls > * { pointer-events: auto; }
.zr-video-top-left { position:absolute; top:22px; left:22px; display:flex; gap:12px; }
.zr-video-top-right { position:absolute; top:22px; right:22px; }
.zr-video-transport { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; gap:clamp(70px,12vw,150px); pointer-events:none; }
.zr-video-transport > * { pointer-events:auto; }
.zr-video-bottom-right { position:absolute; right:22px; bottom:92px; display:flex; align-items:center; gap:8px; }
.zr-video-bottom { position:absolute; right:18px; bottom:16px; left:18px; }
.zr-video-play-center { position:static; width:92px; height:92px; }
.zr-video-seek-pill {
  display: grid;
  grid-template-columns: 78px minmax(0, 1fr) 88px;
  align-items: center;
  gap: 18px;
  height: 64px;
  padding: 0 24px;
  border-radius: 999px;
}
.zr-video-bottom.zr-video-seek-pill {
  width: auto;
  margin: 0;
}
.zr-video-seek,
.zr-video-volume {
  width: 100%;
  margin: 0;
  padding: 0;
  outline: none;
  background: transparent;
  appearance: none;
  -webkit-appearance: none;
  cursor: pointer;
}
.zr-video-seek::-webkit-slider-runnable-track,
.zr-video-volume::-webkit-slider-runnable-track {
  height: 8px;
  border-radius: 999px;
  background:
    linear-gradient(to right, var(--g9-fill) 0 var(--zr-video-played, var(--zr-video-volume, 0%)), transparent var(--zr-video-played, var(--zr-video-volume, 0%)) 100%),
    linear-gradient(to right, color-mix(in srgb, var(--g9-fill) 45%, transparent) 0 var(--zr-video-buffered, var(--zr-video-volume, 0%)), var(--g9-rail) var(--zr-video-buffered, var(--zr-video-volume, 0%)) 100%);
}
.zr-video-volume::-webkit-slider-runnable-track { height: 3px; }
.zr-video-seek::-webkit-slider-thumb,
.zr-video-volume::-webkit-slider-thumb {
  box-sizing: border-box;
  width: 12px;
  height: 12px;
  margin-top: -2px;
  border: 0;
  border-radius: 999px;
  opacity: 0;
  background: var(--g9-fill);
  box-shadow: 0 1px 5px rgba(0,0,0,.34);
  appearance: none;
  -webkit-appearance: none;
  transition: opacity var(--g9-timing) var(--g9-ease);
}
.zr-video-volume::-webkit-slider-thumb { margin-top: -4.5px; }
.zr-video-seek:hover::-webkit-slider-thumb,
.zr-video-seek:focus-visible::-webkit-slider-thumb,
.zr-video-volume:hover::-webkit-slider-thumb,
.zr-video-volume:focus-visible::-webkit-slider-thumb { opacity: 1; }
.zr-video-seek::-moz-range-track,
.zr-video-volume::-moz-range-track { height: 8px; border-radius: 999px; background: var(--g9-rail); }
.zr-video-volume::-moz-range-track { height: 3px; }
.zr-video-seek::-moz-range-progress,
.zr-video-volume::-moz-range-progress { height: 8px; border-radius: 999px; background: var(--g9-fill); }
.zr-video-volume::-moz-range-progress { height: 3px; }
.zr-video-seek::-moz-range-thumb,
.zr-video-volume::-moz-range-thumb { width: 12px; height: 12px; border: 0; border-radius: 999px; opacity: 0; background: var(--g9-fill); box-shadow: 0 1px 5px rgba(0,0,0,.34); }
.zr-video-seek:hover::-moz-range-thumb,
.zr-video-seek:focus-visible::-moz-range-thumb,
.zr-video-volume:hover::-moz-range-thumb,
.zr-video-volume:focus-visible::-moz-range-thumb { opacity: 1; }
.zr-video-control-row { display: flex; min-width: 0; align-items: center; gap: 8px; color: var(--g9-fg); }
.zr-video-control-sm { width: 48px; height: 48px; }
.zr-video-control-md { width: 64px; height: 64px; }
.zr-video-volume-pill { display: flex; align-items: center; gap: 12px; width: 280px; height: 48px; padding: 0 16px 0 18px; border-radius: 999px; }
.zr-video-volume-pill .zr-video-volume { flex: 1; min-width: 0; }
.zr-video-volume-toggle { display: inline-grid; width: 32px; height: 32px; flex: 0 0 auto; place-items: center; padding: 0; color: var(--g9-fg); border: 0; background: transparent; cursor: pointer; }
.zr-video-time { min-width: 0; color: var(--g9-fg) !important; font-family: var(--zr-police-mono); font-size: var(--zr-ui-lg); font-weight: 400; font-variant-numeric: tabular-nums; letter-spacing: .01em; }
.zr-video-time:last-child { text-align: right; }
.zr-video-actions { position: relative; display: flex; align-items: center; gap: 8px; margin-left: auto; }
.zr-video-options-pill { display: inline-flex; box-sizing: border-box; align-items: center; gap: 4px; height: 48px; padding: 2px; border-radius: 999px; overflow: hidden; }
.zr-video-option-button { display: inline-grid; width: 44px; height: 44px; place-items: center; flex: 0 0 auto; padding: 0; color: var(--g9-fg); border: 0; border-radius: 999px; background: transparent; cursor: pointer; transition: background-color var(--g9-timing) var(--g9-ease); }
.zr-video-option-button:hover, .zr-video-option-button:focus-visible { background: color-mix(in srgb, var(--g9-fg) 14%, transparent); outline: none; }
.zr-video-settings-menu { position: absolute; right: 0; bottom: 56px; min-width: 152px; max-height: 300px; overflow: auto; padding: 6px; color: var(--g9-fg); border-radius: 18px; }
