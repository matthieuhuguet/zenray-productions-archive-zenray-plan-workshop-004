// 9 October 2026, 01:41 CEST: Verify temporary archive previews and the memory-size cutoff.
import { beforeEach, describe, expect, it, vi } from 'vitest'

vi.mock('../capture/thumbnailer.js', () => ({ makeThumbWebp: vi.fn() }))
vi.mock('./archiveChunks.js', () => ({ downloadUrls: vi.fn(() => ['https://assets.example/image.png']), effectiveManifest: (manifest) => manifest }))
vi.mock('./fetchAsset.js', () => ({ assembleBlobUrl: vi.fn(async () => 'https://assets.example/image.png') }))
vi.mock('./manifestReadCache.js', () => ({ readPageCached: vi.fn() }))

import { makeThumbWebp } from '../capture/thumbnailer.js'
import { assembleBlobUrl } from './fetchAsset.js'
import { readPageCached } from './manifestReadCache.js'
import { LINKED_GALLERY_THUMB_MAX_BYTES, loadLinkedGalleryImagePreview } from './linkedGalleryImagePreview.js'

describe('loadLinkedGalleryImagePreview', () => {
  beforeEach(() => {
    vi.clearAllMocks()
  })

  it('creates a temporary thumbnail from a small image archive', async () => {
    const thumbnail = new Blob(['webp'], { type: 'image/webp' })
    readPageCached.mockResolvedValue({ markdown: JSON.stringify({ mime: 'image/png', size: 1024, mode: 'raw' }) })
    vi.spyOn(global, 'fetch').mockResolvedValue({ ok: true, blob: async () => new Blob(['png'], { type: 'image/png' }) })
    makeThumbWebp.mockResolvedValue(thumbnail)

    const result = await loadLinkedGalleryImagePreview({ name: 'concept.png', contentPath: 'pages/Assets/concept.png.file.json' })

    expect(result).toEqual({ status: 'generated', blob: thumbnail })
    expect(assembleBlobUrl).toHaveBeenCalledOnce()
    expect(makeThumbWebp).toHaveBeenCalledOnce()
  })

  it('skips originals above the thumbnail memory limit', async () => {
    readPageCached.mockResolvedValue({ markdown: JSON.stringify({ mime: 'image/png', size: LINKED_GALLERY_THUMB_MAX_BYTES + 1, mode: 'raw' }) })

    const result = await loadLinkedGalleryImagePreview({ name: 'large.png', contentPath: 'pages/Assets/large.png.file.json' })

    expect(result).toEqual({ status: 'too-large' })
    expect(assembleBlobUrl).not.toHaveBeenCalled()
    expect(makeThumbWebp).not.toHaveBeenCalled()
  })
})
