      const text = String(reader.result || '').replace(/^\uFEFF/, '')
      const lines = text.split(/\r?\n/).filter((l) => l.trim().length > 0)
      if (lines.length <= 1) return
      const imported = []
      for (let i = 1; i < lines.length; i++) {
        const cols = lines[i].split(/[;,]/).map((c) => c.replace(/^"|"$/g, '').trim())
