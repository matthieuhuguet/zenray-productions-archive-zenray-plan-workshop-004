function normalizeState(raw) {
  if (!raw || typeof raw !== 'object') return INITIAL_MONEY_STATE
  return {
    ...INITIAL_MONEY_STATE,
    ...raw,
    settings: { ...INITIAL_MONEY_STATE.settings, ...(raw.settings || {}) },
    weeklySlots: Array.isArray(raw.weeklySlots) && raw.weeklySlots.length === 4
      ? raw.weeklySlots
      : INITIAL_MONEY_STATE.weeklySlots,
    storeItems: Array.isArray(raw.storeItems) && raw.storeItems.length > 0
      ? raw.storeItems
      : INITIAL_MONEY_STATE.storeItems,
    ledger: Array.isArray(raw.ledger) ? raw.ledger : [],
  }
}

function loadLocalMoneyState() {
  try {
    const raw = localStorage.getItem(MONEY_STORAGE_KEY)
    if (!raw) return INITIAL_MONEY_STATE
    return normalizeState(JSON.parse(raw))
  } catch {
    return INITIAL_MONEY_STATE
  }
}

function formatEur(val) {
  const num = Number(val) || 0
  return new Intl.NumberFormat('fr-FR', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(num) + ' €'
}

function isDateInCurrentIsoWeek(dateStr) {
  if (!dateStr) return false
  const d = new Date(dateStr + 'T12:00:00')
  if (Number.isNaN(d.getTime())) return false
  const now = new Date()
  const day = (now.getDay() + 6) % 7 // Lundi = 0
  const monday = new Date(now.getFullYear(), now.getMonth(), now.getDate() - day)
  monday.setHours(0, 0, 0, 0)
  const sunday = new Date(monday)
  sunday.setDate(monday.getDate() + 7)
  return d >= monday && d < sunday
}

function isDateInCurrentMonth(dateStr) {
  if (!dateStr) return false
  const ym = new Date().toISOString().slice(0, 7)
  return String(dateStr).startsWith(ym)
}

