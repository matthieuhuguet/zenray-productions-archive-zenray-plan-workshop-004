    const capMax = Number(state.settings.capJaponMaxEur) || 20000

    // Somme des slots de contrats actifs de la semaine
    const slotsSumHt = state.weeklySlots.reduce(
      (acc, s) => (s.status !== 'empty' ? acc + (Number(s.amountHt) || 0) : acc),
      0
