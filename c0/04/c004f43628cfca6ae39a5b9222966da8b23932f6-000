    const storeSumHt = state.storeItems.reduce((acc, it) => acc + (Number(it.revenueHt) || 0), 0)

    // Somme du Grand-Livre Comptable
    const ledgerPaidHt = state.ledger
      .filter((r) => r.status === 'PAYÉ')
      .reduce((acc, r) => acc + (Number(r.amountHt) || 0), 0)
    const ledgerPendingHt = state.ledger
      .filter((r) => r.status !== 'PAYÉ')
      .reduce((acc, r) => acc + (Number(r.amountHt) || 0), 0)

