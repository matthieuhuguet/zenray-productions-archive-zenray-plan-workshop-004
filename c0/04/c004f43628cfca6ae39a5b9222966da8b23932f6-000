                      commitState(
                        (p) => ({ ...p, settings: { ...p.settings, monthlyTargetEur: Number(e.target.value) || 0 } }),
                        'Cible mensuelle modifiée'
                      )
                    }
                  />
                </div>
                <div className="zrm-field">
                  <label>Taux URSSAF (%)</label>
                  <input
                    className="zrm-input zrm-num"
                    type="number"
                    step="0.1"
                    value={state.settings.urssafRatePct}
                    onChange={(e) =>
                      commitState(
                        (p) => ({ ...p, settings: { ...p.settings, urssafRatePct: Number(e.target.value) || 0 } }),
                        'Taux URSSAF modifié'
                      )
                    }
                  />
                </div>
                <div className="zrm-field">
                  <label>Cap Japon 2027 Cible Haute (€)</label>
                  <input
                    className="zrm-input zrm-num"
                    type="number"
                    value={state.settings.capJaponMaxEur}
                    onChange={(e) =>
                      commitState(
                        (p) => ({ ...p, settings: { ...p.settings, capJaponMaxEur: Number(e.target.value) || 0 } }),
                        'Cap Japon modifié'
                      )
                    }
                  />
                </div>
                <div className="zrm-field full">
                  <label>Nom de l'entreprise sur les factures</label>
                  <input
                    className="zrm-input"
                    type="text"
                    value={state.settings.companyName}
                    onChange={(e) =>
                      commitState(
                        (p) => ({ ...p, settings: { ...p.settings, companyName: e.target.value } }),
                        'Nom entreprise modifié'
                      )
                    }
                  />
                </div>
                <div className="zrm-field full">
                  <label>Mentions légales / SIRET</label>
                  <input
                    className="zrm-input"
                    type="text"
                    value={state.settings.companySiret}
                    onChange={(e) =>
                      commitState(
                        (p) => ({ ...p, settings: { ...p.settings, companySiret: e.target.value } }),
                        'Mentions modifiées'
                      )
                    }
                  />
                </div>
                <div className="zrm-field full">
                  <label>IBAN / Coordonnées de règlement</label>
                  <input
                    className="zrm-input"
                    type="text"
                    value={state.settings.companyIban}
                    onChange={(e) =>
                      commitState(
                        (p) => ({ ...p, settings: { ...p.settings, companyIban: e.target.value } }),
                        'IBAN modifié'
                      )
                    }
                  />
                </div>
              </div>

              <div className="zrm-btn-row" style={{ marginTop: 14 }}>
                <button
                  type="button"
                  className="zrm-btn"
                  onClick={() => {
                    if (window.confirm('Réinitialiser tous les compteurs et le Grand-Livre à 0,00 € ?')) {
                      commitState(INITIAL_MONEY_STATE, 'Remise à 0,00 € effectuée')
                    }
                  }}
                >
                  Tout remettre à 0,00 €
                </button>
              </div>
            </div>
          )}
        </div>

        {/* 3. DOCK DROIT HEXTECH : ZENRAY PLAN & GOOGLE CALENDAR */}
        <aside className="zrm-dock" aria-label="Dock ZenRay Plan & Google Calendar">
          <div>
            <div className="zrm-dock-head">
              <div className="zrm-dock-title">
                <span>PLAN & GOOGLE CAL</span>
                <span className="zrm-dock-sync">● SYNC</span>
              </div>
              <div style={{ fontSize: 10, color: 'var(--lol-text-muted)', marginTop: 3 }}>
                 Connecté à {planPath.split('/').pop()}
              </div>
            </div>

            <div className="zrm-dock-group">PILIERS QUOTIDIENS</div>
            <div className="zrm-dock-item">
              <span className="zrm-dock-dot cyan" />
              <div>
                <div className="zrm-dock-name">09:00 · Production & Contrats</div>
                <div className="zrm-dock-sub">Freelance Tech Art + Boutique</div>
              </div>
            </div>
            <div className="zrm-dock-item">
              <span className="zrm-dock-dot gold" />
              <div>
                <div className="zrm-dock-name">14:00 · Japonais Intensif</div>
                <div className="zrm-dock-sub">Priorité 0 · Oral & Lecture</div>
              </div>
            </div>
            <div className="zrm-dock-item">
              <span className="zrm-dock-dot green" />
              <div>
                <div className="zrm-dock-name">17:00 · Sport (45 min max)</div>
                <div className="zrm-dock-sub">Régularité 5x / semaine</div>
              </div>
            </div>

            <div className="zrm-dock-group">AUJOURD'HUI DANS PLAN ({todaysPlanTasks.length})</div>
            {todaysPlanTasks.length === 0 ? (
              <div style={{ padding: '6px 13px', fontSize: 11, color: 'var(--lol-text-muted)' }}>
                Aucune tâche planifiée aujourd'hui.
              </div>
            ) : (
              todaysPlanTasks.slice(0, 5).map((task) => (
                <div key={task.id} className="zrm-dock-item">
                  <span className={`zrm-dock-dot ${task.status === 'done' ? 'green' : 'gold'}`} />
                  <div>
                    <div className="zrm-dock-name">
                      {task.startTime ? `${task.startTime} · ` : ''}{task.title}
                    </div>
                    <div className="zrm-dock-sub">
                      {task.status === 'done' ? 'Terminé' : 'En cours · Sync GCal'}
                    </div>
                  </div>
                </div>
              ))
            )}

            {upcomingPlanTasks.length > 0 && (
              <>
                <div className="zrm-dock-group">À VENIR</div>
                {upcomingPlanTasks.map((task) => (
                  <div key={task.id} className="zrm-dock-item">
                    <span className="zrm-dock-dot cyan" />
                    <div>
                      <div className="zrm-dock-name">{task.title}</div>
                      <div className="zrm-dock-sub zrm-num">
                        {task.date} {task.startTime || ''}
                      </div>
                    </div>
                  </div>
                ))}
              </>
            )}

            <form onSubmit={handleAddPlanTask} style={{ padding: '10px 13px', borderTop: '1px solid rgba(200,170,110,0.2)' }}>
              <div style={{ fontSize: 9.5, fontFamily: 'var(--lol-font-display)', letterSpacing: '0.1em', color: 'var(--lol-text-muted)', textTransform: 'uppercase', marginBottom: 5 }}>
                + Ajouter au Plan & Google Calendar
              </div>
              <div style={{ display: 'flex', gap: 5, marginBottom: 6 }}>
                <input
                  type="time"
                  className="zrm-input zrm-num"
                  style={{ width: 78, padding: '4px 6px', fontSize: 11 }}
                  value={newPlanTaskTime}
                  onChange={(e) => setNewPlanTaskTime(e.target.value)}
                />
                <input
                  type="text"
                  className="zrm-input"
                  style={{ flex: 1, padding: '4px 7px', fontSize: 11 }}
                  placeholder="Ex. Facturer client..."
                  value={newPlanTaskTitle}
                  onChange={(e) => setNewPlanTaskTitle(e.target.value)}
                />
              </div>
              <div style={{ display: 'flex', gap: 6 }}>
                <button type="submit" className="zrm-btn" style={{ flex: 1, padding: '5px 8px', fontSize: 10 }}>
                  + Planifier
                </button>
                {onNavigateView && (
                  <button
                    type="button"
                    className="zrm-btn cyan"
                    style={{ padding: '5px 8px', fontSize: 10 }}
                    onClick={() => onNavigateView('plan')}
                  >
                    Ouvrir Plan
                  </button>
                )}
              </div>
            </form>
          </div>

          <div className="zrm-dock-foot">
            <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 4 }}>
              <span style={{ color: 'var(--lol-text-muted)' }}>Cap Japon 2027</span>
              <span className="zrm-num" style={{ color: 'var(--lol-gold-bright)' }}>
                {formatEur(metrics.totalNetPocket)} / {formatEur(metrics.capMin)}
              </span>
            </div>
            <div style={{ height: 5, background: '#091726', border: '1px solid var(--lol-gold-dark)' }}>
              <div
                style={{
                  height: '100%',
                  width: `${Math.min(100, Math.round((metrics.totalNetPocket / Math.max(1, metrics.capMin)) * 100))}%`,
                  background: 'linear-gradient(90deg, #C8AA6E, #0AC8B9)',
                }}
              />
            </div>
          </div>
        </aside>
      </div>

      {/* MODALE : ÉDITION D'UN SLOT DE CONTRAT HEBDOMADAIRE */}
      {editingSlot && (
        <div className="zrm-modal-backdrop" onClick={() => setEditingSlot(null)}>
          <div className="zrm-modal" onClick={(e) => e.stopPropagation()}>
            <div className="zrm-sec-head">
              <span className="zrm-sec-title">Slot Contrat #{editingSlot.slot} (Semaine)</span>
              <span className="zrm-sec-badge">Objectif 4 / semaine</span>
            </div>
            <div className="zrm-inv-form-grid">
              <div className="zrm-field full">
                <label>Intitulé de la mission / livrable</label>
                <input
                  className="zrm-input"
                  type="text"
                  value={editingSlot.title}
                  onChange={(e) => setEditingSlot((p) => ({ ...p, title: e.target.value }))}
                  placeholder="Ex. HDA Bâtiment Procédural / Lookdev UE5"
                />
              </div>
              <div className="zrm-field">
                <label>Client / Studio</label>
                <input
                  className="zrm-input"
                  type="text"
                  value={editingSlot.client}
                  onChange={(e) => setEditingSlot((p) => ({ ...p, client: e.target.value }))}
                  placeholder="Ex. Studio Partenaire"
                />
              </div>
              <div className="zrm-field">
                <label>Montant HT (€)</label>
                <input
                  className="zrm-input zrm-num"
                  type="number"
                  min="0"
                  step="10"
                  value={editingSlot.amountHt}
                  onChange={(e) => setEditingSlot((p) => ({ ...p, amountHt: Number(e.target.value) || 0 }))}
                />
              </div>
              <div className="zrm-field">
                <label>Statut</label>
                <select
                  className="zrm-select"
                  value={editingSlot.status === 'empty' ? 'SIGNÉ' : editingSlot.status}
                  onChange={(e) => setEditingSlot((p) => ({ ...p, status: e.target.value }))}
                >
                  <option value="SIGNÉ">SIGNÉ</option>
                  <option value="EN COURS">EN COURS</option>
                  <option value="LIVRÉ">LIVRÉ</option>
                  <option value="PAYÉ">PAYÉ</option>
                </select>
              </div>
              <div className="zrm-field">
                <label>Date</label>
                <input
                  className="zrm-input"
                  type="date"
                  value={editingSlot.date || todayIso()}
                  onChange={(e) => setEditingSlot((p) => ({ ...p, date: e.target.value }))}
                />
              </div>
            </div>
            <div className="zrm-btn-row" style={{ justifyContent: 'flex-end', marginTop: 12 }}>
              <button type="button" className="zrm-btn" onClick={() => setEditingSlot(null)}>
                Annuler
              </button>
              <button
                type="button"
                className="zrm-btn gold-solid"
                onClick={() => {
                  commitState(
                    (prev) => ({
                      ...prev,
                      weeklySlots: prev.weeklySlots.map((s) =>
                        s.slot === editingSlot.slot
                          ? {
                              ...editingSlot,
                              status: editingSlot.status === 'empty' ? 'SIGNÉ' : editingSlot.status,
                            }
                          : s
                      ),
                    }),
                    `Slot #${editingSlot.slot} enregistré`
                  )
                  setEditingSlot(null)
                }}
              >
                Enregistrer le contrat
              </button>
            </div>
          </div>
        </div>
      )}

      {/* MODALE : ÉDITION D'UN PRODUIT DE LA BOUTIQUE ZENRAY.STUDIO */}
      {editingStoreItem && (
        <div className="zrm-modal-backdrop" onClick={() => setEditingStoreItem(null)}>
          <div className="zrm-modal" onClick={(e) => e.stopPropagation()}>
            <div className="zrm-sec-head">
              <span className="zrm-sec-title">Produit Boutique ZenRay.Studio</span>
              <span className="zrm-sec-badge">{editingStoreItem.type}</span>
            </div>
            <div className="zrm-inv-form-grid">
              <div className="zrm-field">
                <label>Catégorie / Type</label>
                <input
                  className="zrm-input"
                  type="text"
                  value={editingStoreItem.type}
                  onChange={(e) => setEditingStoreItem((p) => ({ ...p, type: e.target.value }))}
                />
              </div>
              <div className="zrm-field">
                <label>Nom du produit</label>
                <input
                  className="zrm-input"
                  type="text"
                  value={editingStoreItem.name}
                  onChange={(e) => setEditingStoreItem((p) => ({ ...p, name: e.target.value }))}
                />
              </div>
              <div className="zrm-field">
                <label>Prix unitaire HT (€)</label>
                <input
                  className="zrm-input zrm-num"
                  type="number"
                  min="0"
                  value={editingStoreItem.unitPrice}
                  onChange={(e) => {
                    const unitPrice = Number(e.target.value) || 0
                    setEditingStoreItem((p) => ({
                      ...p,
                      unitPrice,
                      revenueHt: unitPrice * (Number(p.salesCount) || 0),
                    }))
                  }}
                />
              </div>
              <div className="zrm-field">
                <label>Nombre de ventes</label>
                <input
                  className="zrm-input zrm-num"
                  type="number"
                  min="0"
                  value={editingStoreItem.salesCount}
                  onChange={(e) => {
                    const salesCount = Math.max(0, Number(e.target.value) || 0)
                    setEditingStoreItem((p) => ({
                      ...p,
                      salesCount,
                      revenueHt: (Number(p.unitPrice) || 0) * salesCount,
                    }))
                  }}
                />
              </div>
              <div className="zrm-field full">
                <label>Chiffre d'affaires généré HT (€)</label>
                <input
                  className="zrm-input zrm-num"
                  type="number"
                  min="0"
                  value={editingStoreItem.revenueHt}
                  onChange={(e) =>
                    setEditingStoreItem((p) => ({ ...p, revenueHt: Math.max(0, Number(e.target.value) || 0) }))
                  }
                />
              </div>
            </div>
            <div className="zrm-btn-row" style={{ justifyContent: 'space-between', marginTop: 12 }}>
              <button
                type="button"
                className="zrm-btn cyan"
                onClick={() =>
                  setEditingStoreItem((p) => {
                    const nextSales = (Number(p.salesCount) || 0) + 1
                    const nextRev = (Number(p.revenueHt) || 0) + (Number(p.unitPrice) || 0)
                    return { ...p, salesCount: nextSales, revenueHt: nextRev }
                  })
                }
              >
                +1 Vente ({formatEur(editingStoreItem.unitPrice)})
              </button>
              <div style={{ display: 'flex', gap: 8 }}>
                <button type="button" className="zrm-btn" onClick={() => setEditingStoreItem(null)}>
                  Annuler
                </button>
                <button
                  type="button"
                  className="zrm-btn gold-solid"
                  onClick={() => {
                    commitState((prev) => {
                      const exists = prev.storeItems.some((i) => i.id === editingStoreItem.id)
                      const clean = { ...editingStoreItem }
                      delete clean.isNew
                      return {
                        ...prev,
                        storeItems: exists
                          ? prev.storeItems.map((i) => (i.id === clean.id ? clean : i))
                          : [...prev.storeItems, clean],
                      }
                    }, `Boutique ${editingStoreItem.name} mis à jour`)
                    setEditingStoreItem(null)
                  }}
                >
                  Enregistrer
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* MODALE : AJOUTER UNE LIGNE AU GRAND-LIVRE COMPTABLE */}
      {addingLedgerModal && (
        <div className="zrm-modal-backdrop" onClick={() => setAddingLedgerModal(false)}>
          <div className="zrm-modal" onClick={(e) => e.stopPropagation()}>
            <div className="zrm-sec-head">
              <span className="zrm-sec-title">Nouvelle Écriture Comptable</span>
              <span className="zrm-sec-badge">{ledgerDraft.ref || nextInvoiceNumber}</span>
            </div>
            <div className="zrm-inv-form-grid">
              <div className="zrm-field">
                <label>Date</label>
                <input
                  className="zrm-input"
                  type="date"
                  value={ledgerDraft.date}
                  onChange={(e) => setLedgerDraft((p) => ({ ...p, date: e.target.value }))}
                />
              </div>
              <div className="zrm-field">
                <label>Réf Facture</label>
                <input
                  className="zrm-input"
                  type="text"
                  placeholder={nextInvoiceNumber}
                  value={ledgerDraft.ref}
                  onChange={(e) => setLedgerDraft((p) => ({ ...p, ref: e.target.value }))}
                />
              </div>
              <div className="zrm-field">
                <label>Client / Source</label>
                <input
                  className="zrm-input"
                  type="text"
                  placeholder="Nom du client ou plateforme"
                  value={ledgerDraft.client}
                  onChange={(e) => setLedgerDraft((p) => ({ ...p, client: e.target.value }))}
                />
              </div>
              <div className="zrm-field">
                <label>Catégorie</label>
                <select
                  className="zrm-select"
                  value={ledgerDraft.category}
                  onChange={(e) => setLedgerDraft((p) => ({ ...p, category: e.target.value }))}
                >
                  <option value="Freelance Tech Art">Freelance Tech Art</option>
                  <option value="HDA Houdini / Copernicus">HDA Houdini / Copernicus</option>
                  <option value="Unreal Engine / Shards">Unreal Engine / Shards</option>
                  <option value="Boutique ZenRay.Studio">Boutique ZenRay.Studio</option>
                </select>
              </div>
              <div className="zrm-field full">
                <label>Désignation</label>
                <input
                  className="zrm-input"
                  type="text"
                  placeholder="Description de la mission ou de la vente"
                  value={ledgerDraft.description}
                  onChange={(e) => setLedgerDraft((p) => ({ ...p, description: e.target.value }))}
                />
              </div>
              <div className="zrm-field">
                <label>Montant HT (€)</label>
                <input
                  className="zrm-input zrm-num"
                  type="number"
                  min="0"
                  step="10"
                  placeholder="0"
                  value={ledgerDraft.amountHt}
                  onChange={(e) => setLedgerDraft((p) => ({ ...p, amountHt: e.target.value }))}
                />
              </div>
              <div className="zrm-field">
                <label>Statut</label>
                <select
                  className="zrm-select"
                  value={ledgerDraft.status}
                  onChange={(e) => setLedgerDraft((p) => ({ ...p, status: e.target.value }))}
                >
                  <option value="PAYÉ">PAYÉ</option>
                  <option value="EN ATTENTE">EN ATTENTE</option>
                </select>
              </div>
            </div>
            <div className="zrm-btn-row" style={{ justifyContent: 'flex-end', marginTop: 12 }}>
              <button type="button" className="zrm-btn" onClick={() => setAddingLedgerModal(false)}>
                Annuler
              </button>
              <button
                type="button"
                className="zrm-btn gold-solid"
                onClick={() => {
                  const ref = (ledgerDraft.ref || nextInvoiceNumber).trim()
                  const entry = {
                    id: `led-${Date.now()}`,
                    date: ledgerDraft.date || todayIso(),
                    ref,
                    client: (ledgerDraft.client || 'Client Direct').trim(),
                    description: (ledgerDraft.description || '').trim(),
                    category: ledgerDraft.category,
                    amountHt: Number(ledgerDraft.amountHt) || 0,
                    status: ledgerDraft.status,
                  }
                  commitState((prev) => ({ ...prev, ledger: [entry, ...prev.ledger] }), `Écriture ${ref} ajoutée`)
                  setLedgerDraft({
                    date: todayIso(),
                    ref: '',
                    client: '',
                    description: '',
                    category: 'Freelance Tech Art',
                    amountHt: '',
                    status: 'PAYÉ',
                  })
                  setAddingLedgerModal(false)
                }}
              >
                Ajouter au Grand-Livre
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}
