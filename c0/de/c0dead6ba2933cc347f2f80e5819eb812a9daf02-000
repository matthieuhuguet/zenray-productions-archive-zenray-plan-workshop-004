// 9 October 2026, 10:06 CEST: Keep the project catalogue small and preserve counts when summaries are republished.
import { assertWorkspaceId } from './projectWorkspace.js'
import { lastFileActivity } from './assetsProjectCover.js'
import { articleThumbnail } from './assetsProjectArticle.js'
export const WORKSPACE_CATALOGUE_PATH = 'pages/.zr-assets-workspaces-index.json'
export const LEGACY_WORKSPACE_REGISTRY_PATH = 'pages/.zr-assets-workspaces.json'

const copyDefined = (source, fields) => Object.fromEntries(fields
  .filter((field) => source?.[field] !== undefined)
  .map((field) => [field, source[field]]))

function coverSummary(project) {
  const files = project.files || []
  const cover = project.coverFile || files.find((file) => file.id === project.coverFileId)
    || files.find((file) => file.kind === 'image' && file.contentPath)
  return cover ? copyDefined(cover, ['id', 'name', 'relativePath', 'sourceId', 'namespace', 'kind', 'type', 'size', 'status', 'cloudPath', 'contentPath']) : undefined
}

export function summarizeWorkspaceProject(project) {
  if (!project || typeof project.id !== 'string' || typeof project.name !== 'string' || typeof project.folder !== 'string') {
    throw new Error('A workspace summary requires a project id, name and cloud folder')
  }
  assertWorkspaceId(project.id)
  if (project.folder !== `pages/ZenRayAssets/${project.id}`) throw new Error('Workspace summary folder does not match its project id')
  const fileCount = project.files?.length || Number(project.fileCount) || Number(project.sync?.count) || Number(project.inventory?.count) || 0
  const summary = {
    ...copyDefined(project, ['id', 'name', 'category', 'folder', 'schemaVersion', 'checkedAt', 'createdAt', 'updatedAt',
      'legacyProjectIds', 'coverFileId', 'coverUrl', 'dependencies', 'dependencyNotes']),
    fileCount,
    sources: (project.sources || []).map((source) => copyDefined(source,
      ['id', 'namespace', 'cloudFolder', 'include', 'exclude', 'keep', 'sharedProjectId'])),
  }
  const inventoryCount = Number(project.inventory?.count) || fileCount
  if (project.inventory) summary.inventory = { count: inventoryCount, checkedAt: project.inventory.checkedAt, issueCount: project.inventory.issues?.length || Number(project.inventory.issueCount) || 0 }
  if (project.sync) summary.sync = copyDefined(project.sync,
    ['state', 'count', 'bytes', 'backedUpCount', 'verifiedCount', 'pendingCount', 'sourceConflictCount', 'checkedAt', 'lastVerifiedAt', 'watched', 'sceneAuditPendingCount'])
  if (project.workspace) summary.workspace = copyDefined(project.workspace, ['state', 'checkedAt', 'loadedCount'])
  const cover = coverSummary(project)
  if (cover) summary.coverFile = cover
  // 20 October 2026, 15:15 CEST: the catalogue holds a small article reference, never its HTML or source list.
  if (typeof project.article?.fileId === 'string') {
    summary.article = copyDefined(project.article, ['fileId', 'title', 'sha256'])
    const thumbnailUrl = articleThumbnail(project)
    if (thumbnailUrl) summary.article.thumbnailUrl = thumbnailUrl
  }
  // 12 October 2026: the home grid is ordered by the last real file edit, which the light index must carry.
  const activity = Math.max(lastFileActivity(project.files), Date.parse(project.lastActivityAt) || Number(project.lastActivityAt) || 0)
  if (activity > 0) summary.lastActivityAt = activity
  if (Array.isArray(project.conversations)) summary.conversations = project.conversations
  return summary
}

export function createWorkspaceCatalogue(projects, updatedAt = new Date().toISOString()) {
  const byId = new Map()
  for (const project of projects || []) {
    const summary = summarizeWorkspaceProject(project)
    byId.set(summary.id, summary)
  }
  const entries = [...byId.values()].sort((left, right) => left.id.localeCompare(right.id))
  return { schemaVersion: 1, updatedAt, projectCount: entries.length, projects: entries }
}

export function isWorkspaceCatalogue(value) {
  if (value?.schemaVersion !== 1 || !Array.isArray(value.projects) || value.projectCount !== value.projects.length) return false
  const ids = new Set()
  return value.projects.every((project) => {
    if (typeof project?.id !== 'string' || typeof project.name !== 'string' || project.folder !== `pages/ZenRayAssets/${project.id}` || ids.has(project.id) || 'files' in project) return false
    try { assertWorkspaceId(project.id) } catch { return false }
    ids.add(project.id)
    return true
  })
}

// 9 October 2026, 10:01 CEST: Only a confirmed missing index permits the one-time legacy read.
export async function loadWorkspaceCatalogue(readCloud) {
  const indexMarkdown = await readCloud(WORKSPACE_CATALOGUE_PATH, { optional: true })
  if (indexMarkdown !== null) {
    const catalogue = JSON.parse(indexMarkdown)
    if (!isWorkspaceCatalogue(catalogue)) throw new Error('Workspace index has an unsupported or malformed format')
    return { projects: catalogue.projects, lightweight: true }
  }
  const legacyMarkdown = await readCloud(LEGACY_WORKSPACE_REGISTRY_PATH, { optional: true })
  if (legacyMarkdown === null) return { projects: [], lightweight: false }
  const registry = JSON.parse(legacyMarkdown)
  if (!Array.isArray(registry.projects)) throw new Error('Legacy workspace registry has no project list')
  return { projects: registry.projects, lightweight: false }
}
