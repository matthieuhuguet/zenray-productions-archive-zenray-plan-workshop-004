// /api/raw-token — serves the CLIENT the READ token for private zenrayshards-* repos (vid/blob/pdf/doc).
//
// WHY: since 2026-07-05, every non-image media lives on PRIVATE GitHub repos (Matthieu's decision:
// only img stays public, jsDelivr requires it). The Service Worker (video playback) and downloads
// fetch parts directly from api.github.com (Accept: application/vnd.github.raw) — CORS verified OK
// with the Authorization header. This endpoint hands them the token, exactly on the /api/media-key
// model (the master key is already served to the client the same way; same trust surface, same gating).
//
// SECURITY: prefer ZENRAY_RAW_TOKEN (a READ-ONLY fine-grained PAT limited to zenrayshards-* repos,
// to create in GitHub settings) — when defined, THAT is what gets served, never the main token.
// Fallback: GITHUB_TOKEN (full token — acceptable for gated personal use, but the reduced PAT is
// recommended and documented in docs/INDEX-ERREURS-FEATURES.md). In prod the router sits behind
// Vercel protection + the optional app gate, like media-key.
export default async function handler(req, res) {
  if (req.method !== 'GET') { res.setHeader('Allow', 'GET'); return res.status(405).end() }
  const token = process.env.ZENRAY_RAW_TOKEN || process.env.GITHUB_TOKEN
  if (!token) return res.status(200).json({ error: 'raw-token indisponible' })
  res.setHeader('Cache-Control', 'no-store')
  return res.status(200).json({ token, scoped: !!process.env.ZENRAY_RAW_TOKEN })
}
