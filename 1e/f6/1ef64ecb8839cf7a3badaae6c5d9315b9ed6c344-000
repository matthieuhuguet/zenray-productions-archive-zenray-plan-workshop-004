import React, { createContext, useContext, useRef, useState, useEffect, useCallback } from 'react'

// C52 — bus de presse-papiers universel. Un seul listener paste/copy au niveau window, délégué à la cible ACTIVE.
// La cible active = l'écran courant (onglet) ou un overlay (CardPanel). Chaque écran register({onPasteImage, onCopy}).
const Ctx = createContext(null)
export function useClipboard() { return useContext(Ctx) }

// Hook pratique : enregistre une cible tant que le composant est monté + l'active au montage.
export function useClipboardTarget(id, handlers, active = true) {
  const cb = useContext(Ctx)
  const ref = useRef(handlers)
  ref.current = handlers
  useEffect(() => {
    if (!cb) return
    const unreg = cb.register(id, {
      onPasteImage: (...a) => ref.current.onPasteImage && ref.current.onPasteImage(...a),
      onPasteInternal: (...a) => ref.current.onPasteInternal && ref.current.onPasteInternal(...a),
      onCopy: (...a) => ref.current.onCopy && ref.current.onCopy(...a),
    })
    if (active) cb.setActive(id)
    return unreg
  }, [id, active])
  useEffect(() => { if (cb && active) cb.setActive(id) }, [active, id])
}

function inEditable(el) {
  if (!el) return false
  if (el.isContentEditable) return true
  const tag = el.tagName
  if (tag === 'INPUT' || tag === 'TEXTAREA') return true
  if (el.closest && el.closest('.bn-editor, [contenteditable="true"]')) return true
  return false
}

// Certains navigateurs donnent à une image copiée un File sans nom. Le binaire est inchangé : on lui
// ajoute seulement un nom/une extension pour que la pipeline image crée le bon manifeste dans le dossier courant.
function namedClipboardFile(file, index) {
  if (!file || file.name) return file
  const type = String(file.type || '').toLowerCase()
  const ext = ({ 'image/jpeg': 'jpg', 'image/png': 'png', 'image/webp': 'webp', 'image/gif': 'gif', 'image/avif': 'avif', 'image/svg+xml': 'svg' })[type]
    || type.split('/')[1]?.replace(/[^a-z0-9]/gi, '') || 'png'
  try { return new File([file], `clipboard-${Date.now().toString(36)}-${index + 1}.${ext}`, { type: file.type || `image/${ext}`, lastModified: Date.now() }) } catch { return file }
}

export function ClipboardProvider({ children }) {
  const targets = useRef(new Map())
  const activeId = useRef(null)
  const [toast, setToast] = useState(null)
  const toastTimer = useRef(null)
  const showToast = useCallback((msg) => {
    setToast(msg)
    if (toastTimer.current) clearTimeout(toastTimer.current)
    toastTimer.current = setTimeout(() => setToast(null), 2400)
  }, [])
  const register = useCallback((id, h) => { targets.current.set(id, h); return () => { targets.current.delete(id) } }, [])
  const setActive = useCallback((id) => { activeId.current = id }, [])

  useEffect(() => {
    const onPaste = async (e) => {
      // Laisser l'éditeur BlockNote / les champs gérer leur propre collage (sauf si rien d'éditable n'est focalisé).
      if (inEditable(e.target) || inEditable(document.activeElement)) return
      const items = e.clipboardData && e.clipboardData.items
      if (!items) return
      const h = targets.current.get(activeId.current)
      if (!h) return
      // Accepter image ET tout autre fichier collé (vidéo, audio, pdf, texte) — la cible route via captureFiles.
      const fileItems = [...items].filter((it) => it.kind === 'file')
      if (fileItems.length && h.onPasteImage) {
        e.preventDefault()
        const files = fileItems.map((it, index) => namedClipboardFile(it.getAsFile(), index)).filter(Boolean)
        if (!files.length) return
        showToast('Collage…')
        try { await h.onPasteImage(files); showToast(`${files.length} fichier${files.length > 1 ? 's' : ''} collé${files.length > 1 ? 's' : ''} ✓`) }
        catch { showToast('échec du collage') }
        return
      }
      // Copier/couper Finder reste disponible, mais seulement quand le vrai presse-papiers ne porte aucun fichier.
      if (h.onPasteInternal) { e.preventDefault(); await h.onPasteInternal() }
    }
    const onCopy = (e) => {
      if (inEditable(e.target) || inEditable(document.activeElement)) return
      const h = targets.current.get(activeId.current)
      if (h && h.onCopy) h.onCopy(e, showToast)
    }
    window.addEventListener('paste', onPaste)
    window.addEventListener('copy', onCopy)
    return () => { window.removeEventListener('paste', onPaste); window.removeEventListener('copy', onCopy) }
  }, [showToast])

  return (
    <Ctx.Provider value={{ register, setActive, showToast }}>
      {children}
      {toast && (
        <div style={{ position: 'fixed', bottom: 22, left: '50%', transform: 'translateX(-50%)', zIndex: 200, background: '#1f1f1f', color: '#fff', borderRadius: 10, padding: '9px 16px', fontFamily: "var(--zr-police-sans)", fontSize: 'var(--zr-ui-md)', boxShadow: '0 6px 24px rgba(0,0,0,0.3)', pointerEvents: 'none' }}>{toast}</div>
      )}
    </Ctx.Provider>
  )
}
