import { describe, expect, it } from 'vitest'
import { AUDIO_MANIFEST_VERSION, buildAudioManifestV3, validateAudioManifest } from './audioManifest.js'

const cdn = (path = 'aa/file.bin', commit = 'abc1234') =>
  `https://cdn.jsdelivr.net/gh/matthieuhuguet/zenrayshards-audio-aabbccddeeff@${commit}/${path}`

describe('AudioManifest v3', () => {
  it('produit des offsets continus et des URLs CDN immuables depuis les parts navigateur', () => {
    const manifest = buildAudioManifestV3({
      name: 'track.wav',
      mime: 'audio/wav',
      size: 7,
      chunkSize: 4,
      cdnRepo: 'zenrayshards-audio-aabbccddeeff',
      cdnCommit: 'abc1234',
      dir: 'media/id',
      parts: ['000', '001'],
      ivs: ['A2MSp+pX6rJn+8zd', 'CRxWYSJ0OjaE72sn'],
      duration: 12.5,
    })

    expect(manifest.v).toBe(AUDIO_MANIFEST_VERSION)
    expect(manifest.mediaKind).toBe('audio')
    expect(manifest.parts).toEqual([
      expect.objectContaining({ start: 0, end: 3, size: 4, iv: 'A2MSp+pX6rJn+8zd' }),
      expect.objectContaining({ start: 4, end: 6, size: 3, iv: 'CRxWYSJ0OjaE72sn' }),
    ])
    expect(manifest.parts[0].url).toContain('/zenrayshards-audio-aabbccddeeff@abc1234/media/id/000.bin')
    expect(validateAudioManifest(manifest)).toBe(true)
  })

  it('accepte les parts bulk déjà résolues, y compris après rollover multi-repo', () => {
    const manifest = buildAudioManifestV3({
      name: 'long.flac', mime: 'audio/flac', size: 7, chunkSize: 4,
      parts: [
        { url: cdn('aa/part-0000.bin'), start: 0, end: 3, size: 4, iv: 'A2MSp+pX6rJn+8zd' },
        { url: cdn('bb/part-0001.bin', 'def5678'), start: 4, end: 6, size: 3, iv: 'CRxWYSJ0OjaE72sn' },
      ],
      track: '02', contentHash: 'a'.repeat(64), cover: cdn('cover/cover.webp'),
    })

    expect(manifest.track).toBe('02')
    expect(manifest.parts[1].url).toContain('@def5678/')
    expect(validateAudioManifest(manifest, { allowLegacy: false })).toBe(true)
  })

  it('garde un manifeste v1 public chiffré lisible pendant la migration', () => {
    const legacy = {
      type: 'chunked-media', v: 1, mime: 'audio/mpeg', size: 7, chunkSize: 4, count: 2,
      dir: 'media/legacy', parts: ['000', '001'], vis: 'public', alg: 'AES-GCM',
      cdnRepo: 'zenray-audio-public-01', cdnCommit: 'abc1234',
      ivs: ['A2MSp+pX6rJn+8zd', 'CRxWYSJ0OjaE72sn'],
    }
    expect(validateAudioManifest(legacy)).toBe(true)
    expect(() => validateAudioManifest(legacy, { allowLegacy: false })).toThrow(/legacy refusé/)
  })

  it('garde un manifeste v1 brut zenray-data lisible', () => {
    expect(validateAudioManifest({
      type: 'chunked-media', v: 1, mime: 'audio/mp4', size: 3, chunkSize: 4,
      count: 1, dir: 'media/legacy/raw', parts: ['000'],
    })).toBe(true)
  })

  it('garde un manifeste v2 à parts objet lisible', () => {
    expect(validateAudioManifest({
      type: 'chunked-media', v: 2, mediaKind: 'audio', mime: 'audio/wav', size: 3,
      chunkSize: 4, count: 1, vis: 'public', alg: 'AES-GCM',
      parts: [{ url: cdn(), start: 0, end: 2, size: 3, iv: 'A2MSp+pX6rJn+8zd' }],
    })).toBe(true)
  })

  it.each([
    ['offset discontinu', [{ url: cdn(), start: 2, end: 7, size: 6, iv: 'A2MSp+pX6rJn+8zd' }], /chunk audio invalide/],
    ['URL mutable', [{ url: 'https://cdn.jsdelivr.net/gh/a/b@main/part.bin', start: 0, end: 7, size: 8, iv: 'A2MSp+pX6rJn+8zd' }], /URL CDN audio non immuable/],
    ['IV absent', [{ url: cdn(), start: 0, end: 7, size: 8 }], /IV audio invalide/],
  ])('refuse un v3 invalide : %s', (_label, parts, error) => {
    const invalid = {
      type: 'chunked-media', v: 3, mediaKind: 'audio', name: 'bad.wav', mime: 'audio/wav',
      size: 8, chunkSize: 8, count: 1, duration: 0, vis: 'public', alg: 'AES-GCM',
      parts, addedAt: '2026-07-16T00:00:00.000Z',
    }
    expect(() => validateAudioManifest(invalid)).toThrow(error)
  })

  it('refuse une taille ou un nombre de parts incohérent', () => {
    expect(() => buildAudioManifestV3({
      name: 'bad.wav', size: 9, chunkSize: 4, cdnRepo: 'zenrayshards-audio-aabbccddeeff',
      cdnCommit: 'abc1234', dir: 'media/id', parts: ['000', '001'],
      ivs: ['A2MSp+pX6rJn+8zd', 'CRxWYSJ0OjaE72sn'],
    })).toThrow(/taille audio incohérente/)
  })
})
