// VerifyVideoCloudIdentity.mjs (12 October 2026): the identity proof ALONE, without sampling and without escalation.
// FR : la preuve par identite seule, sans echantillonnage ni escalade ; sert le mode ombre et les controles de concordance.
// The proof itself lives in lib/video-identity-proof.mjs (one implementation); VerifyVideoCloud.mjs is the entry point the
// upload worker calls and applies the policy (1 film in N read back in full, escalation on a remote failure).
//   node scripts/VerifyVideoCloudIdentity.mjs <manifest.media.json> <source> <receipt.json>
import { verifyVideoCloudByPolicy, resolveIdentityProofConfig } from './lib/video-identity-proof.mjs'

const [manifestPath, source, receiptPath] = process.argv.slice(2)
if (!manifestPath || !source || !receiptPath) throw new Error('Usage: VerifyVideoCloudIdentity.mjs manifest source receipt')
await verifyVideoCloudByPolicy({ manifestPath, source, receiptPath, config: resolveIdentityProofConfig({ mode: 'identity' }),
  sample: false, escalate: false, reuseReceipt: false })
