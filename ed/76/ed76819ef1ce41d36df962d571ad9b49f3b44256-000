import { afterEach, describe, expect, it } from 'vitest'
import { mkdtemp, mkdir, writeFile, readFile, rm, realpath, utimes, readdir } from 'node:fs/promises'
import { tmpdir } from 'node:os'
import path from 'node:path'
import { createAssetsService, mapLimit, hashLocalFile } from './AssetsService.mjs'
import { normalizeWorkspaceProject } from '../src/lib/projectWorkspace.js'

const cleanup = []
afterEach(async () => { while (cleanup.length) await cleanup.pop()() })

async function fixture(extraFiles = 0) {
  const root = await realpath(await mkdtemp(path.join(tmpdir(), 'zr-fluidity-')))
  cleanup.push(() => rm(root, { recursive: true, force: true }))
  const config = JSON.parse(await readFile(new URL('./AssetsConfig.json', import.meta.url), 'utf8'))
  config.storage.preventIdleSleepDuringTransfers = false
  config.roots = Object.fromEntries(['tmp', 'memory', 'houdini', 'unreal'].map((kind) => [kind, path.join(root, kind)]))
  config.additionalRoots = {}
  config.sceneAudit.enabled = false
  config.storage.stateDir = path.join(root, 'state'); config.storage.workspaceDir = path.join(root, 'loads'); config.projects = []
  config.storage.progressPath = path.join(root, 'missing-progress.md')
  for (const folder of Object.values(config.roots)) await mkdir(folder, { recursive: true })
  const folder = path.join(config.roots.tmp, 'test-project')
  await mkdir(folder); await writeFile(path.join(folder, 'scene.hiplc'), 'original bytes')
  for (let index = 0; index < extraFiles; index++) await writeFile(path.join(folder, `extra-${index}.png`), `extra ${index}`)
  const project = normalizeWorkspaceProject({ id: 'test-project', name: 'Test project', sources: [{ id: 'workshop', namespace: 'tmp', localPath: folder }] })
  const service = await createAssetsService({ config, getToken: async () => 'test', runProcess: async () => { throw new Error('Unexpected engine call') } })
  cleanup.push(() => service.close())
  return { root, config, folder, project, service }
}

describe('mapLimit', () => {
  it('keeps input order and never exceeds the limit', async () => {
    let running = 0, peak = 0
    const results = await mapLimit([5, 1, 4, 2, 3, 6], 2, async (value) => {
      running++; peak = Math.max(peak, running)
      await new Promise((resolve) => setTimeout(resolve, value))
      running--
      return value * 10
    })
    expect(results).toEqual([50, 10, 40, 20, 30, 60])
    expect(peak).toBe(2)
  })
  it('rejects with the first failure and stops handing out work', async () => {
    const started = []
    await expect(mapLimit([1, 2, 3, 4, 5, 6], 1, async (value) => {
      started.push(value)
      if (value === 2) throw new Error('boom')
    })).rejects.toThrow('boom')
    expect(started).toEqual([1, 2])
  })
})

describe('state saves', () => {
  it('coalesces a burst of saves and writes compact JSON with the latest state', async () => {
    const { service, project } = await fixture()
    await service.register(project)
    const original = service.statePath.bind(service)
    let writes = 0
    service.statePath = (id) => { writes++; return original(id) }
    const saves = []
    for (let step = 0; step < 25; step++) { service.state(project.id).marker = step; saves.push(service.save(project.id)) }
    await Promise.all(saves)
    expect(writes).toBeLessThanOrEqual(3)
    const text = await readFile(original(project.id), 'utf8')
    expect(JSON.parse(text).marker).toBe(24)
    expect(text.includes('\n')).toBe(false)
  })
  it('lets a later save start again after the burst finished', async () => {
    const { service, project } = await fixture()
    await service.register(project)
    await service.save(project.id)
    service.state(project.id).marker = 'later'
    await service.save(project.id)
    expect(JSON.parse(await readFile(service.statePath(project.id), 'utf8')).marker).toBe('later')
    expect(service.saveSlots.size).toBe(0)
  })
})

describe('snapshot memo', () => {
  it('reuses the combined file list until the state changes', async () => {
    const { service, project } = await fixture(3)
    await service.register(project)
    const first = service.snapshot(project.id).files
    expect(first.length).toBe(4)
    expect(service.snapshot(project.id).files).toBe(first)
    service.state(project.id).backups['unknown'] = undefined
    delete service.state(project.id).backups['unknown']
    service.touch(project.id)
    expect(service.snapshot(project.id).files).not.toBe(first)
    await service.inventory(project.id)
    expect(service.snapshot(project.id).files.length).toBe(4)
  })
})

describe('automatic backup scheduling', () => {
  it('starts at most one pass per minimum interval and lets a continuation through', async () => {
    const { service, project, config } = await fixture()
    config.watch.backupMinIntervalSeconds = 600
    await service.register(project)
    service.state(project.id).watched = true
    let passes = 0
    service.archiveNow = async (_id, _fileIds, job) => { passes++; job.count = 0; job.remainingCount = 0 }
    service.scheduleBackup(project.id)
    await service.queue
    await new Promise((resolve) => setTimeout(resolve, 5))
    expect(passes).toBe(1)
    service.scheduleBackup(project.id)
    await service.queue
    expect(passes).toBe(1)
    expect(service.backupDelayTimers.has(project.id)).toBe(true)
    service.scheduleBackup(project.id, { continuation: true })
    await service.queue
    await new Promise((resolve) => setTimeout(resolve, 5))
    expect(passes).toBe(2)
  })
})

describe('background archive yielding', () => {
  it('hands the writer to an interactive action at a batch boundary and then continues', async () => {
    const { service, project, config, folder } = await fixture()
    config.storage.batchFiles = 1
    config.storage.autoBatchLimit = 4
    await writeFile(path.join(folder, 'second.png'), 'second original')
    await service.register(project)
    const order = []
    service.cloudPublisher = async () => {}
    let queuedAction = false
    service.runProcess = async (script, args) => {
      if (script.endsWith('index-add-paths.mjs')) return { lastEvent: null }
      order.push('batch')
      if (!queuedAction) { queuedAction = true; service.enqueue(project.id, 'check', async () => { order.push('action') }) }
      const fiches = []
      for (const file of service.state(project.id).inventory.localFiles) {
        try { fiches.push({ rel: file.relativePath, taille: file.size, sha: await hashLocalFile(path.join(args[0], file.relativePath)), manifeste: `${file.relativePath}.file.json` }) }
        catch (error) { if (error.code !== 'ENOENT') throw error }
      }
      await writeFile(args.find((arg) => arg.startsWith('--index=')).slice(8), JSON.stringify({ dest: args[1], at: new Date().toISOString(), fiches }))
      return { lastEvent: { ev: 'done', skipped: [], verifyKo: 0 } }
    }
    service.state(project.id).watched = true
    service.scheduleBackup(project.id)
    for (let pass = 0; pass < 40; pass++) {
      await service.queue
      await new Promise((resolve) => setTimeout(resolve, 5))
      if (!service.pending.size && order.length >= 3) break
    }
    expect(order).toEqual(['batch', 'action', 'batch'])
    expect(service.snapshot(project.id).sync.pendingCount).toBe(0)
  })
})

describe('state directory hygiene', () => {
  it('removes old interrupted-write temporaries at start and keeps recent ones', async () => {
    const { config } = await fixture()
    await mkdir(config.storage.stateDir, { recursive: true })
    const old = path.join(config.storage.stateDir, 'Project-x.json.123.aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee.tmp')
    const recent = path.join(config.storage.stateDir, 'Project-y.json.124.aaaaaaaa-bbbb-cccc-dddd-ffffffffffff.tmp')
    const keep = path.join(config.storage.stateDir, 'Projects.json')
    for (const file of [old, recent]) await writeFile(file, 'x')
    await writeFile(keep, JSON.stringify({ projects: [] }))
    const longAgo = new Date(Date.now() - 3 * 3600 * 1000)
    await utimes(old, longAgo, longAgo)
    const service = await createAssetsService({ config, getToken: async () => 'test', runProcess: async () => { throw new Error('no engine') } })
    cleanup.push(() => service.close())
    const names = await readdir(config.storage.stateDir)
    expect(names).not.toContain(path.basename(old))
    expect(names).toContain(path.basename(recent))
    expect(names).toContain(path.basename(keep))
  })
})

describe('published snapshot size', () => {
  async function archived() {
    const { service, project } = await fixture()
    await service.register(project)
    service.runProcess = async (script, args) => {
      if (script.endsWith('index-add-paths.mjs')) return { lastEvent: null }
      const fiches = []
      for (const file of service.state(project.id).inventory.localFiles) {
        fiches.push({ rel: file.relativePath, taille: file.size, sha: await hashLocalFile(path.join(args[0], file.relativePath)), manifeste: `${file.relativePath}.file.json` })
      }
      await writeFile(args.find((arg) => arg.startsWith('--index=')).slice(8), JSON.stringify({ dest: args[1], at: new Date().toISOString(), fiches }))
      return { lastEvent: { ev: 'done', skipped: [], verifyKo: 0 } }
    }
    return { service, project }
  }

  it('leaves out the three manifest-location fields nothing reads from the cloud copy', async () => {
    const { service, project } = await archived()
    const job = service.enqueue(project.id, 'archive', (j, signal) => service.archiveNow(project.id, null, j, signal))
    await service.queue
    expect(service.jobs.get(job.jobId).state).toBe('done')
    const [file] = service.snapshot(project.id, { cloud: true }).files
    for (const gone of ['manifestPath', 'relativeManifest', 'sourceFolder', 'localPath']) expect(file[gone]).toBeUndefined()
    for (const kept of ['cloudPath', 'contentPath', 'expectedCloudPath', 'sha256', 'size']) expect(file[kept]).toBeDefined()
  })

  it('keeps an archived pass done when only the metadata publication fails', async () => {
    const { service, project } = await archived()
    service.cloudPublisher = async () => { throw new Error('remote rejected: file exceeds 100 MiB') }
    const job = service.enqueue(project.id, 'archive', (j, signal) => service.archiveNow(project.id, null, j, signal))
    await service.queue
    const finished = service.jobs.get(job.jobId)
    expect(finished.state).toBe('done')
    expect(finished.publishError).toMatch(/100 MiB/)
    expect(service.snapshot(project.id).events.some((event) => event.type === 'publish-error')).toBe(true)
  })
})
