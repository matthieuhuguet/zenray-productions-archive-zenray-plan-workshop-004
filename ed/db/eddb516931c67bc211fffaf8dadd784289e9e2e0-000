// Extensions traitées comme CODE/TEXTE même si le mime n'est pas text/* (aperçu <pre>).
const TEXTUAL_EXT = new Set(['md', 'markdown', 'txt', 'csv', 'tsv', 'log', 'json', 'yaml', 'yml', 'toml', 'xml', 'html', 'htm', 'css', 'scss',
  'js', 'mjs', 'cjs', 'ts', 'tsx', 'jsx', 'py', 'rb', 'php', 'java', 'c', 'h', 'cpp', 'cc', 'hpp', 'cs', 'go', 'rs', 'swift', 'kt',
  'scala', 'sh', 'bash', 'zsh', 'lua', 'r', 'sql', 'ini', 'env', 'conf', 'cube', 'vue', 'svelte', 'dart', 'graphql', 'gql', 'dockerfile', 'gitignore'])

export const extOf = (name) => {
  const lower = String(name || '').toLowerCase()
  // Compound extensions are semantic formats, not a generic `.sc` script.
  if (lower.endsWith('.bgeo.sc')) return 'bgeo.sc'
  return (lower.match(/\.([a-z0-9]+)$/i) || [, ''])[1]
}
export const mimeForName = (name) => MIME_BY_EXT[extOf(name)] || 'application/octet-stream'

// Catégorie d'aperçu — pilote le rendu dans le viewer. 'lib' = besoin d'un décodeur dynamique (lazy).
export function kindForName(name) {
  const e = extOf(name)
  const mime = MIME_BY_EXT[e] || ''
  if (mime.startsWith('audio/')) return 'audio'
  if (mime.startsWith('video/')) return 'video'
  // PSD exclu volontairement : LibFilePreview route image-lib vers le décodeur TIFF (UTIF), et un PSD (format
  // Adobe propre, jamais du TIFF) échouerait SYSTÉMATIQUEMENT le décodage -> mieux vaut le message "aperçu
  // indisponible" immédiat (catégorie par défaut 'binary') qu'une tentative de décodage vouée à l'échec à coup
  // sûr. DNG reste en image-lib : beaucoup de DNG sont bâtis sur TIFF/EP et se décodent réellement via UTIF.
  if (e === 'heic' || e === 'heif' || e === 'tif' || e === 'tiff' || e === 'dng') return 'image-lib'
  if (mime.startsWith('image/')) return 'image'
  if (e === 'pdf') return 'pdf'
  if (TEXTUAL_EXT.has(e)) return 'text'
  if (e === 'docx' || e === 'doc' || e === 'rtf') return 'doc-lib'
  if (e === 'xlsx' || e === 'xls') return 'sheet-lib'
  if (e === 'pptx' || e === 'ppt') return 'slides-lib'
  if (e === 'epub') return 'epub-lib'
  if (e === 'glb' || e === 'gltf' || e === 'obj' || e === 'stl' || e === 'fbx') return '3d-lib'
  if (['hda', 'otl', 'hip', 'hiplc', 'hipnc', 'bgeo', 'bgeo.sc', 'vdb'].includes(e)) return 'houdini'
  if (e === 'zip' || e === 'tar' || e === 'gz' || e === '7z' || e === 'rar') return 'archive'
  return 'binary'
}

// Aperçu NATIF possible (sans dépendance) ?
export const isNativePreview = (name) => ['audio', 'video', 'image', 'pdf', 'text'].includes(kindForName(name))
