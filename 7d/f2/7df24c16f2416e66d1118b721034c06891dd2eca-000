import React, { useEffect, useRef, useState } from 'react'
import { createPortal } from 'react-dom'
import Icon from '../Icon.jsx'
import { PALETTE } from '../../theme.js'
import './AssetsWorkspace.tokens.css'
import './ProjectWorkspace.css'

// 2 October 2026, 12:52 CEST: this DEV panel writes only root CSS variables and preserves chosen values.
const STORAGE_KEY = 'zr-assets-workspace-design-v2'
const GROUPS = [
  { id: 'space', title: 'Espace', controls: [
    { key: '--assets-content-width', label: 'Largeur de la page', min: 900, max: 1800, step: 10, unit: 'px' },
    { key: '--assets-rail-width', label: 'Largeur des projets', min: 190, max: 330, step: 2, unit: 'px' },
    { key: '--assets-page-padding', label: 'Marge de la page', min: 8, max: 60, step: 2, unit: 'px' },
    { key: '--assets-section-gap', label: 'Espace entre les blocs', min: 12, max: 60, step: 2, unit: 'px' },
    { key: '--assets-row-height', label: 'Hauteur des fichiers', min: 48, max: 100, step: 2, unit: 'px' },
    { key: '--assets-cover-height', label: 'Hauteur de la couverture', min: 100, max: 280, step: 2, unit: 'px' },
    { key: '--assets-radius', label: 'Arrondi', min: 0, max: 28, step: 1, unit: 'px' },
  ] },
  // 3 October 2026, 15:17 CEST: root parameters govern the alternate file views and location cards.
  { id: 'files', title: 'Fichiers et emplacements', controls: [
    { key: '--assets-tile-size', label: 'Largeur des icônes', min: 100, max: 260, step: 2, unit: 'px' },
    { key: '--assets-gallery-height', label: 'Hauteur de la galerie', min: 160, max: 500, step: 10, unit: 'px' },
    { key: '--assets-column-width', label: 'Largeur des colonnes', min: 180, max: 380, step: 10, unit: 'px' },
    { key: '--assets-card-padding', label: 'Marge des fiches', min: 8, max: 36, step: 2, unit: 'px' },
  ] },
  { id: 'type', title: 'Texte', controls: [
    { key: '--assets-title-size', label: 'Titre du projet', min: 24, max: 54, step: 1, unit: 'px' },
    { key: '--assets-ui-size', label: 'Interface', min: 12, max: 18, step: .5, unit: 'px' },
    { key: '--assets-body-size', label: 'Description', min: 14, max: 22, step: .5, unit: 'px' },
    { key: '--assets-line-height', label: 'Interligne', min: 1.2, max: 1.9, step: .05, unit: '' },
  ] },
  { id: 'surface', title: 'Surfaces', controls: [
    { key: '--assets-accent-strength', label: 'Teinte des sélections', min: 3, max: 30, step: 1, unit: '%' },
    { key: '--assets-surface-strength', label: 'Opacité des surfaces', min: 60, max: 100, step: 1, unit: '%' },
    { key: '--assets-border-strength', label: 'Bordures', min: 4, max: 28, step: 1, unit: '%' },
    { key: '--assets-hover-strength', label: 'Survol', min: 1, max: 12, step: 1, unit: '%' },
  ] },
  { id: 'motion', title: 'Mouvement', controls: [
    { key: '--assets-motion-duration', label: 'Durée des transitions', min: 0, max: 400, step: 10, unit: 'ms' },
  ] },
]
const CONTROLS = GROUPS.flatMap((group) => group.controls)

export default function AssetsDesignControls({ t }) {
  const [open, setOpen] = useState(false)
  const [values, setValues] = useState({})
  const [copyState, setCopyState] = useState('')
  const triggerRef = useRef(null)
  const panelRef = useRef(null)
  const defaultsRef = useRef({})
  useEffect(() => {
    const root = document.documentElement
    const computed = getComputedStyle(root)
    const defaults = Object.fromEntries(CONTROLS.map((control) => [control.key, parseFloat(computed.getPropertyValue(control.key))]))
    defaultsRef.current = defaults
    let saved = {}
    try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') } catch { saved = {} }
    const restored = Object.fromEntries(CONTROLS.map((control) => [control.key, Number.isFinite(Number(saved[control.key])) && saved[control.key] !== undefined ? Math.min(control.max, Math.max(control.min, Number(saved[control.key]))) : defaults[control.key]]))
    CONTROLS.forEach((control) => { if (saved[control.key] !== undefined && Number.isFinite(restored[control.key])) root.style.setProperty(control.key, `${restored[control.key]}${control.unit}`) })
    setValues(restored)
  }, [])
  useEffect(() => {
    if (open) panelRef.current?.focus()
  }, [open])
  const setValue = (control, value) => {
    const next = { ...values, [control.key]: Number(value) }
    document.documentElement.style.setProperty(control.key, `${value}${control.unit}`)
    setValues(next); setCopyState('')
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(next)) } catch { setCopyState('Réglage appliqué, mémorisation indisponible.') }
  }
  const reset = () => {
    CONTROLS.forEach((control) => document.documentElement.style.removeProperty(control.key))
    setValues(defaultsRef.current); setCopyState('Réglages initiaux restaurés.')
    try { localStorage.removeItem(STORAGE_KEY) } catch { setCopyState('Réglages restaurés, mémorisation indisponible.') }
  }
  const copy = async () => {
    const output = `ZenRay Assets : appliquer ces valeurs dans AssetsWorkspace.tokens.css : ${CONTROLS.map((control) => `${control.key}: ${values[control.key]}${control.unit}`).join('; ')}.`
    try { await navigator.clipboard.writeText(output); setCopyState('Valeurs copiées pour le prompt.') } catch { setCopyState('Copie refusée. Sélectionnez le texte ci-dessous.'); setCopyText(output) }
  }
  const [copyText, setCopyText] = useState('')
  const close = () => { setOpen(false); triggerRef.current?.focus() }
  const keyDown = (event) => {
    if (event.key === 'Escape') { event.stopPropagation(); close() }
    if (event.key === 'Tab') {
      const focusable = [...panelRef.current.querySelectorAll('button,input,textarea')].filter((element) => !element.disabled)
      const first = focusable[0], last = focusable[focusable.length - 1]
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus() }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus() }
    }
  }
  const dark = t?.textPrimary === PALETTE.textPrimaryDark
  const style = { '--assets-control-ink': t?.textPrimary || PALETTE.textPrimaryLight, '--assets-control-muted': t?.textSecondary || PALETTE.textSecondaryLight, '--assets-control-bg': t?.surface || PALETTE.surfaceLight, '--assets-control-accent': PALETTE.orange }
  return createPortal(<div className={`assets-design-controls${dark ? ' zr-dark' : ''}`} style={style}>
    {open ? <aside ref={panelRef} className="assets-design-panel" tabIndex={-1} aria-label="Réglages visuels ZenRay Assets" onKeyDown={keyDown}><header><div><span>Atelier local</span><h2>Réglages visuels</h2></div><button type="button" aria-label="Fermer les réglages" onClick={close}><Icon name="xmark" size={17} /></button></header><div className="assets-design-fields">{GROUPS.map((group) => <fieldset key={group.id}><legend>{group.title}</legend>{group.controls.map((control) => <label key={control.key}><span>{control.label}<output className="assets-number">{values[control.key]} {control.unit}</output></span><input type="range" aria-label={control.label} min={control.min} max={control.max} step={control.step} value={values[control.key] ?? control.min} onChange={(event) => setValue(control, event.target.value)} /></label>)}</fieldset>)}</div><footer><button type="button" className="assets-design-copy" onClick={copy}>Copier les valeurs pour le prompt</button><button type="button" onClick={reset}>Réinitialiser</button><p role="status">{copyState || 'Vos valeurs restent sur ce navigateur.'}</p>{copyText && <textarea aria-label="Valeurs à copier" readOnly value={copyText} onFocus={(event) => event.target.select()} />}</footer></aside> : <button ref={triggerRef} type="button" className="assets-design-trigger" onClick={() => setOpen(true)} aria-expanded={open} aria-label="Ouvrir les réglages visuels"><Icon name="gear" size={18} /> Réglages visuels</button>}
  </div>, document.body)
}
