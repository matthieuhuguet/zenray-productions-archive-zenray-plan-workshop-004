import React, { useEffect, useMemo, useRef, useState, useCallback } from 'react'
import { PALETTE, RADII, SHADOWS } from '../theme.js'
import { colToLetter, toA1, normSel, inRect, clamp } from './grid.js'
import { solve, isFormula, offsetFormula } from './formula.js'
import { toTSV, fromTSV, writeClipboard, readClipboard } from './clipboard.js'
import { toCSV, fromCSV, downloadCSV } from './csv.js'
import { makeHistory } from './history.js'
import { formatValue, cellStyle, condStyle, NUM_FORMATS } from './format.js'
import { safeMarkedParse } from '../safeMarked.js'

// LOT TABLES — SheetGrid : clone Excel / Google Sheets monté sur le schéma .db.json existant.
// La base reste {columns:[{id,name,type,options,w,format}], rows:[{id,cells:{colId:val}}]}.
// Ici on la regarde comme une GRILLE : colonne A = columns[0], ligne 1 = rows[0].
// Une cellule "=A1+B2" est une formule, calculée par le moteur src/table/formula.js.
const FONTS = { sans: "var(--zr-police-sans)", mono: "var(--zr-police-mono)" }
const RH = 34   // hauteur de ligne
const HH = 34   // hauteur d'en-tête
const GUT = 52  // gouttière des numéros de ligne
const DEFW = 130
const uid = (p = 'x') => p + Math.random().toString(36).slice(2, 8)

// gridSkin : palette dérivée du thème courant pour la grille — hairlines fins, zebra subtile, en-têtes en
// verre, accent macOS. Détecte le sombre via la couleur de texte. Défensif (t.glass optionnel).
function gridSkin(t) {
  const dark = t.textPrimary === PALETTE.textPrimaryDark
  return {
    line: dark ? 'rgba(255,255,255,0.075)' : 'rgba(0,0,0,0.07)',
    lineStrong: dark ? 'rgba(255,255,255,0.14)' : 'rgba(0,0,0,0.12)',
    // Zebra explicite demandée : lignes paires #fff (blanc), impaires #f4f5f5 (gris) en clair. Sombre = nuances.
    base: dark ? t.cardBg : '#ffffff',
    zebra: dark ? 'rgba(255,255,255,0.04)' : '#f4f5f5',
    headBg: (t.glass && t.glass.bgStrong) || t.windowBg,
    headFilter: (t.glass && t.glass.filter) || 'none',
    headText: dark ? 'rgba(236,236,234,0.80)' : '#3c3c43',
    accent: PALETTE.primary,
    accentSoft: PALETTE.primarySoft,
    selBg: t.selection,
  }
}

export default function SheetGrid({ t, db, onChange, onOpenPage, immersive }) {
  const cols = db.columns
  const rows = db.rows
  const nR = rows.length, nC = cols.length
  const sk = gridSkin(t)

  const rawGet = useCallback((r, c) => {
    if (r < 0 || c < 0 || r >= nR || c >= nC) return ''
    const v = rows[r].cells[cols[c].id]
    return v == null ? '' : v
  }, [rows, cols, nR, nC])

  // recalcul de toutes les formules (mémoïsé sur le contenu)
  const computed = useMemo(() => {
    const s = solve(rawGet, nR, nC)
    return s.computeAll()
  }, [rawGet, nR, nC])

  const dispValue = (r, c) => {
    const raw = rawGet(r, c)
    if (isFormula(raw)) { const k = r + ',' + c; return computed.has(k) ? computed.get(k) : '' }
    return raw
  }

  const [sel, setSel] = useState({ anchor: { row: 0, col: 0 }, focus: { row: 0, col: 0 } })
  const [editing, setEditing] = useState(null) // {row,col,value}
  const rect = normSel(sel)
  const [findOpen, setFindOpen] = useState(false)
  const [find, setFind] = useState({ q: '', repl: '' })
  const [autofill, setAutofill] = useState(null) // rect cible pendant le glissement de poignée
  const dragSel = useRef(false)
  const gridRef = useRef(null)
  const csvInputRef = useRef(null)
  const hist = useRef(makeHistory()).current
  // buffer de copie INTERNE : garde les formules brutes + l'origine, pour coller en décalant
  // les références comme Excel (=A1 copié de B2 et collé en B5 -> =A4). Le presse-papier système
  // (TSV) reste rempli en parallèle pour le copier/coller vers Excel.
  const copyBuf = useRef(null) // { rows:[[raw]], r0, c0, signature }
  const [, force] = useState(0)

  // ── persistance via le parent (DatabaseTable -> /api/page) ──
  const commit = (next, snapshotBefore = true) => {
    if (snapshotBefore) hist.push(db)
    onChange(next)
    force((x) => x + 1)
  }
  const setCellRaw = (r, c, val, snap = true) => {
    const next = { ...db, rows: rows.map((row, ri) => ri === r ? { ...row, cells: { ...row.cells, [cols[c].id]: val } } : row) }
    commit(next, snap)
  }
  const setManyCells = (writes, snap = true) => {
    // writes: [{r,c,val}]
    const byRow = new Map()
    for (const w of writes) { if (!byRow.has(w.r)) byRow.set(w.r, {}); byRow.get(w.r)[cols[w.c].id] = w.val }
    const next = { ...db, rows: rows.map((row, ri) => byRow.has(ri) ? { ...row, cells: { ...row.cells, ...byRow.get(ri) } } : row) }
    commit(next, snap)
  }

  // ── ajout auto de lignes / colonnes au besoin (comme un tableur infini) ──
  // CHAÎNABLE : on dérive d'une base optionnelle (défaut db). Indispensable quand paste/autofill
  // ajoutent À LA FOIS des lignes ET des colonnes : sans ça, ensureCols repartait de db et écrasait
  // les lignes que ensureRows venait d'ajouter (bug confirmé de perte de données, revue tables-Excel).
  const ensureRows = (n, from = db) => { if (n <= from.rows.length) return; const add = []; for (let i = from.rows.length; i < n; i++) add.push({ id: uid('r'), cells: {} }); return { ...from, rows: [...from.rows, ...add] } }
  const ensureCols = (n, from = db) => { if (n <= from.columns.length) return; const add = []; for (let i = from.columns.length; i < n; i++) add.push({ id: uid('c'), name: colToLetter(i), type: 'text', w: DEFW }); return { ...from, columns: [...from.columns, ...add] } }

  // ── undo / redo ──
  const doUndo = () => { const prev = hist.undo(db); if (prev) { onChange(prev); force((x) => x + 1) } }
  const doRedo = () => { const nxt = hist.redo(db); if (nxt) { onChange(nxt); force((x) => x + 1) } }

  // ── sélection ──
  const selectCell = (r, c, extend) => {
    r = clamp(r, 0, Math.max(0, nR - 1)); c = clamp(c, 0, Math.max(0, nC - 1))
    setSel((s) => extend ? { anchor: s.anchor, focus: { row: r, col: c } } : { anchor: { row: r, col: c }, focus: { row: r, col: c } })
  }
  const onCellMouseDown = (r, c, e) => {
    if (editing) return
    if (e.shiftKey) selectCell(r, c, true)
    else { selectCell(r, c, false); dragSel.current = true }
  }
  const onCellMouseEnter = (r, c) => { if (dragSel.current) selectCell(r, c, true); if (autofill) setAutofill(extendAutofill(r, c)) }
  // Listener mouseup STABLE (attaché une seule fois) : lit l'état courant via refs pour éviter de
  // ré-attacher/détacher à chaque render (sinon un relâchement pouvait être manqué pendant un drag).
  const autofillRef = useRef(autofill); autofillRef.current = autofill
  const applyAutofillRef = useRef(null)
  useEffect(() => {
    const up = () => {
      dragSel.current = false
      if (autofillRef.current) { applyAutofillRef.current && applyAutofillRef.current(); setAutofill(null) }
    }
    window.addEventListener('mouseup', up); return () => window.removeEventListener('mouseup', up)
  }, [])

  // ── édition ──
  const startEdit = (r, c, initial) => { const raw = rawGet(r, c); setEditing({ row: r, col: c, value: initial != null ? initial : (raw == null ? '' : String(raw)) }) }
  const commitEdit = (moveRow = 1, moveCol = 0) => {
    if (!editing) return
    const { row, col, value } = editing
    let base = db
    const er = ensureRows(row + 1, base); if (er) base = er
    const ec = ensureCols(col + 1, base); if (ec) base = ec
    const colId = base.columns[col].id
    const next = { ...base, rows: base.rows.map((rw, ri) => ri === row ? { ...rw, cells: { ...rw.cells, [colId]: castVal(value, base.columns[col].type) } } : rw) }
    commit(next, base === db)
    setEditing(null)
    if (moveRow || moveCol) selectCell(row + moveRow, col + moveCol, false)
  }
  const cancelEdit = () => setEditing(null)

  // ── clavier global de la grille ──
  const onKeyDown = (e) => {
    if (editing) {
      if (e.key === 'Enter') { e.preventDefault(); commitEdit(e.shiftKey ? -1 : 1, 0) }
      else if (e.key === 'Tab') { e.preventDefault(); commitEdit(0, e.shiftKey ? -1 : 1) }
      else if (e.key === 'Escape') { e.preventDefault(); cancelEdit() }
      return
    }
    const meta = e.metaKey || e.ctrlKey
    if (meta && e.key.toLowerCase() === 'z') { e.preventDefault(); e.shiftKey ? doRedo() : doUndo(); return }
    if (meta && e.key.toLowerCase() === 'y') { e.preventDefault(); doRedo(); return }
    if (meta && e.key.toLowerCase() === 'c') { e.preventDefault(); copySel(); return }
    if (meta && e.key.toLowerCase() === 'x') { e.preventDefault(); copySel(true); return }
    if (meta && e.key.toLowerCase() === 'v') { e.preventDefault(); pasteSel(); return }
    if (meta && e.key.toLowerCase() === 'a') { e.preventDefault(); setSel({ anchor: { row: 0, col: 0 }, focus: { row: nR - 1, col: nC - 1 } }); return }
    if (meta && e.key.toLowerCase() === 'f') { e.preventDefault(); setFindOpen(true); return }
    if (meta && e.key.toLowerCase() === 'b') { e.preventDefault(); toggleFmt('bold'); return }
    if (meta && e.key.toLowerCase() === 'i') { e.preventDefault(); toggleFmt('italic'); return }
    if (meta && e.key.toLowerCase() === 'u') { e.preventDefault(); toggleFmt('underline'); return }
    const f = sel.focus
    if (e.key === 'ArrowUp') { e.preventDefault(); selectCell(f.row - 1, f.col, e.shiftKey) }
    else if (e.key === 'ArrowDown') { e.preventDefault(); selectCell(f.row + 1, f.col, e.shiftKey) }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); selectCell(f.row, f.col - 1, e.shiftKey) }
    else if (e.key === 'ArrowRight' || e.key === 'Tab') { e.preventDefault(); selectCell(f.row, f.col + 1, e.shiftKey) }
    else if (e.key === 'Enter') { e.preventDefault(); startEdit(f.row, f.col) }
    else if (e.key === 'F2') { e.preventDefault(); startEdit(f.row, f.col) }
    else if (e.key === 'Delete' || e.key === 'Backspace') { e.preventDefault(); clearSel() }
    else if (e.key.length === 1 && !meta && !e.altKey) { startEdit(f.row, f.col, e.key) }
  }

  // ── copier / couper / coller ──
  const selGrid = () => { const g = []; for (let r = rect.r0; r <= rect.r1; r++) { const row = []; for (let c = rect.c0; c <= rect.c1; c++) row.push(dispValue(r, c)); g.push(row) } return g }
  const rawGrid = () => { const g = []; for (let r = rect.r0; r <= rect.r1; r++) { const row = []; for (let c = rect.c0; c <= rect.c1; c++) row.push(rawGet(r, c)); g.push(row) } return g }
  const copySel = async (cut) => {
    const tsv = toTSV(selGrid())
    copyBuf.current = { rows: rawGrid(), r0: rect.r0, c0: rect.c0, signature: tsv }
    await writeClipboard(tsv)
    if (cut) clearSel()
  }
  const clearSel = () => { const w = []; for (let r = rect.r0; r <= rect.r1; r++) for (let c = rect.c0; c <= rect.c1; c++) w.push({ r, c, val: '' }); setManyCells(w) }
  const pasteSel = async () => {
    const text = await readClipboard()
    // Coller INTERNE formule-aware : si le presse-papier système correspond exactement à notre
    // dernière copie, on réutilise les formules brutes et on les décale. Sinon (texte venu d'Excel,
    // d'ailleurs, ou presse-papier illisible), on colle le TSV tel quel.
    const buf = copyBuf.current
    const useBuf = buf && (text == null || text === buf.signature)
    const grid = useBuf ? buf.rows : (text == null ? null : fromTSV(text))
    if (!grid || !grid.length) return
    const r0 = rect.r0, c0 = rect.c0
    const dR = useBuf ? r0 - buf.r0 : 0, dC = useBuf ? c0 - buf.c0 : 0
    let base = db
    // Largeur max des lignes collées ; garde-fou 1 minimum pour une ligne TSV vide (sinon Math.max() = -Infinity).
    const maxW = Math.max(1, ...grid.map((g) => g.length || 0))
    const er = ensureRows(r0 + grid.length, base); if (er) base = er
    const ec = ensureCols(c0 + maxW, base); if (ec) base = ec
    hist.push(db)
    const byRow = new Map()
    grid.forEach((line, dr) => line.forEach((val0, dc) => { const r = r0 + dr, c = c0 + dc; const val = (useBuf && isFormula(val0)) ? offsetFormula(val0, dR, dC) : val0; if (!byRow.has(r)) byRow.set(r, {}); byRow.get(r)[base.columns[c].id] = castVal(val, base.columns[c].type) }))
    const next = { ...base, rows: base.rows.map((row, ri) => byRow.has(ri) ? { ...row, cells: { ...row.cells, ...byRow.get(ri) } } : row) }
    onChange(next); force((x) => x + 1)
    setSel({ anchor: { row: r0, col: c0 }, focus: { row: r0 + grid.length - 1, col: c0 + maxW - 1 } })
  }

  // ── autofill (poignée en bas à droite de la sélection) ──
  const extendAutofill = (r, c) => {
    // on n'autorise que l'extension verticale ou horizontale dominante
    const dDown = r - rect.r1, dRight = c - rect.c1
    if (Math.abs(dDown) >= Math.abs(dRight)) return { r0: rect.r0, c0: rect.c0, r1: Math.max(rect.r1, r), c1: rect.c1, dir: 'v' }
    return { r0: rect.r0, c0: rect.c0, r1: rect.r1, c1: Math.max(rect.c1, c), dir: 'h' }
  }
  const applyAutofill = () => {
    if (!autofill) return
    const a = autofill
    const srcH = rect.r1 - rect.r0 + 1, srcW = rect.c1 - rect.c0 + 1
    let base = db
    const er = ensureRows(a.r1 + 1, base); if (er) base = er
    const ec = ensureCols(a.c1 + 1, base); if (ec) base = ec
    hist.push(db)
    const writes = []
    if (a.dir === 'v') {
      // une série par colonne : on lit la pile source de cette colonne pour deviner le pas (1,2->3,4…)
      for (let c = rect.c0; c <= rect.c1; c++) {
        const srcCol = []; for (let r = rect.r0; r <= rect.r1; r++) srcCol.push(rawGet(r, c))
        const series = linearStep(srcCol)
        for (let r = rect.r1 + 1; r <= a.r1; r++) {
          const pos = r - rect.r0
          const srcR = rect.r0 + (pos % srcH)
          writes.push({ r, c, val: fillCell(rawGet(srcR, c), r - srcR, 0, series, pos) })
        }
      }
    } else {
      for (let r = rect.r0; r <= rect.r1; r++) {
        const srcRow = []; for (let c = rect.c0; c <= rect.c1; c++) srcRow.push(rawGet(r, c))
        const series = linearStep(srcRow)
        for (let c = rect.c1 + 1; c <= a.c1; c++) {
          const pos = c - rect.c0
          const srcC = rect.c0 + (pos % srcW)
          writes.push({ r, c, val: fillCell(rawGet(r, srcC), 0, c - srcC, series, pos) })
        }
      }
    }
    const byRow = new Map()
    for (const w of writes) { if (!byRow.has(w.r)) byRow.set(w.r, {}); byRow.get(w.r)[base.columns[w.c].id] = w.val }
    const next = { ...base, rows: base.rows.map((row, ri) => byRow.has(ri) ? { ...row, cells: { ...row.cells, ...byRow.get(ri) } } : row) }
    onChange(next); force((x) => x + 1)
  }
  applyAutofillRef.current = applyAutofill

  // ── find / replace ──
  const findNext = () => {
    if (!find.q) return
    const q = find.q.toLowerCase()
    const start = sel.focus
    for (let i = 1; i <= nR * nC; i++) {
      const idx = (start.row * nC + start.col + i) % (nR * nC)
      const r = Math.floor(idx / nC), c = idx % nC
      if (String(dispValue(r, c)).toLowerCase().includes(q)) { selectCell(r, c, false); return }
    }
  }
  const replaceAll = () => {
    if (!find.q) return
    hist.push(db)
    const next = { ...db, rows: rows.map((row) => { const cells = { ...row.cells }; for (const c of cols) { const v = cells[c.id]; if (typeof v === 'string' && v.includes(find.q)) cells[c.id] = v.split(find.q).join(find.repl) } return { ...row, cells } }) }
    commit(next, false)
  }

  // ── colonnes : redimension, type, format, freeze, reorder ──
  // Listeners STABLES (attachés une fois) lisant db/commit via refs : sinon réattache à chaque render.
  const resizeRef = useRef(null)
  const dbRef = useRef(db); dbRef.current = db
  const commitRef = useRef(commit); commitRef.current = commit
  const onChangeRef = useRef(onChange); onChangeRef.current = onChange
  useEffect(() => {
    const move = (e) => { const r = resizeRef.current; if (!r) return; const cur = dbRef.current; const w = Math.max(50, r.startW + (e.clientX - r.startX)); onChangeRef.current({ ...cur, columns: cur.columns.map((c) => c.id === r.colId ? { ...c, w } : c) }); force((x) => x + 1) }
    const up = () => { if (resizeRef.current) { resizeRef.current = null; document.body.style.cursor = ''; commitRef.current(dbRef.current, false) } }
    window.addEventListener('mousemove', move); window.addEventListener('mouseup', up)
    return () => { window.removeEventListener('mousemove', move); window.removeEventListener('mouseup', up) }
  }, []) // eslint-disable-line
  const updCol = (id, fields) => commit({ ...db, columns: cols.map((c) => c.id === id ? { ...c, ...fields } : c) })
  const [dragCol, setDragCol] = useState(null)
  const moveCol = (from, to) => { if (from === to) return; const n = [...cols]; const [m] = n.splice(from, 1); n.splice(to, 0, m); commit({ ...db, columns: n }) }
  const freeze = db.freeze || { cols: 1, rows: 0 } // 1ʳᵉ colonne figée par défaut (comme Sheets)
  const setFreeze = (f) => commit({ ...db, freeze: { ...freeze, ...f } }, false)

  const [ctx, setCtx] = useState(null) // menu contextuel {x,y,r,c}
  const insertRow = (at) => { const r = { id: uid('r'), cells: {} }; const n = [...rows]; n.splice(at, 0, r); commit({ ...db, rows: n }) }
  const insertCol = (at) => { const c = { id: uid('c'), name: colToLetter(nC), type: 'text', w: DEFW }; const n = [...cols]; n.splice(at, 0, c); commit({ ...db, columns: n }) }
  const delRow = (r) => commit({ ...db, rows: rows.filter((_, i) => i !== r) })
  const delCol = (c) => commit({ ...db, columns: cols.filter((_, i) => i !== c), rows: rows.map((row) => { const cells = { ...row.cells }; delete cells[cols[c].id]; return { ...row, cells } }) })

  // ── largeurs cumulées pour le freeze (offset sticky) ──
  const colW = (c) => cols[c].w || DEFW
  const stickyLeft = (c) => { let x = GUT; for (let i = 0; i < c; i++) x += colW(i); return x }
  // hauteur de ligne (resize au drag de la bordure inférieure du numéro de ligne)
  const rowH = (r) => (rows[r] && rows[r].h) || RH
  const rowResizeRef = useRef(null)
  useEffect(() => {
    const move = (e) => { const r = rowResizeRef.current; if (!r) return; const cur = dbRef.current; const h = Math.max(24, r.startH + (e.clientY - r.startY)); onChangeRef.current({ ...cur, rows: cur.rows.map((row, i) => i === r.rowIdx ? { ...row, h } : row) }); force((x) => x + 1) }
    const up = () => { if (rowResizeRef.current) { rowResizeRef.current = null; document.body.style.cursor = ''; commitRef.current(dbRef.current, false) } }
    window.addEventListener('mousemove', move); window.addEventListener('mouseup', up)
    return () => { window.removeEventListener('mousemove', move); window.removeEventListener('mouseup', up) }
  }, []) // eslint-disable-line

  const cellBg = (r, c, isFocus, inSel) => {
    const f = cols[c].cellFmt && cols[c].cellFmt[rows[r].id]
    if (f && f.bg) return f.bg
    if (inSel && !isFocus) return sk.selBg
    // Mise en forme conditionnelle (règles globales) : prime sur le zebra, pas sur la sélection ni le fond manuel.
    if (db.condFmt && db.condFmt.length) { const cs = condStyle(db.condFmt, dispValue(r, c)); if (cs && cs.bg) return cs.bg }
    if (isFocus) return sk.base
    return r % 2 === 1 ? sk.zebra : sk.base
  }
  const condTextColor = (r, c) => { if (!db.condFmt || !db.condFmt.length) return undefined; const cs = condStyle(db.condFmt, dispValue(r, c)); return cs && cs.color }
  // Fusion de cellules (rendu HORIZONTAL dans une même ligne : l'ancre s'élargit, les cellules couvertes
  // ne sont pas rendues). Les fusions multi-lignes sont mémorisées mais non span-rendues (dégradation propre).
  const mergeOf = (r, c) => (db.merges || []).find((m) => r >= m.r0 && r <= m.r1 && c >= m.c0 && c <= m.c1)

  const [menu, setMenu] = useState(null)   // menu déroulant ouvert (label) de la barre de menus
  const [condUI, setCondUI] = useState(false) // panneau mise en forme conditionnelle
  const [chart, setChart] = useState(false)   // panneau graphique
  // Données du graphique depuis la sélection : 1re colonne = libellés, colonnes suivantes = séries numériques.
  const chartData = () => {
    const labels = [], series = []
    const multi = rect.c1 > rect.c0
    for (let r = rect.r0; r <= rect.r1; r++) {
      labels.push(String(dispValue(r, rect.c0)))
      const row = []; for (let c = (multi ? rect.c0 + 1 : rect.c0); c <= rect.c1; c++) { const n = parseFloat(dispValue(r, c)); row.push(isNaN(n) ? 0 : n) }
      series.push(row)
    }
    const names = []; for (let c = (multi ? rect.c0 + 1 : rect.c0); c <= rect.c1; c++) names.push(cols[c].name || colToLetter(c))
    return { labels, series, names }
  }
  const c0 = rect.c0
  // Barre de menus type Excel/Sheets : chaque entrée = [label, action] (ou ['—'] séparateur).
  const MENUS = {
    Fichier: [
      ['Importer CSV…', () => csvInputRef.current && csvInputRef.current.click()],
      ['Exporter CSV', () => downloadCSV((db.name || 'table'), gridForExport())],
    ],
    Édition: [
      ['Annuler', doUndo, '⌘Z'], ['Rétablir', doRedo, '⌘⇧Z'], ['—'],
      ['Copier', () => copySel(false), '⌘C'], ['Couper', () => copySel(true), '⌘X'], ['Coller', pasteSel, '⌘V'],
      ['Effacer le contenu', clearSel, '⌫'], ['—'],
      ['Rechercher / Remplacer', () => setFindOpen(true), '⌘F'], ['Tout sélectionner', () => setSel({ anchor: { row: 0, col: 0 }, focus: { row: nR - 1, col: nC - 1 } }), '⌘A'],
