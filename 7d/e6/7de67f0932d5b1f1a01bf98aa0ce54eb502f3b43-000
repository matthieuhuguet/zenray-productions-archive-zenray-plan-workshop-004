#!/usr/bin/env node
// ZenRayMedia — MESURER l'étendue réelle d'un élément lumineux, au lieu de l'estimer.
//
//   node scripts/zrm-extent.mjs <capture> --win x0,y0,x1,y1 [--seuil 25]
//
// POURQUOI CE FICHIER EXISTE
// --------------------------
// Matthieu, 2026-07-28, trois fois de suite sur le même sceau : « le sceau n'est toujours pas
// compris en entier ». Je le recadrais à l'oeil, à chaque fois un peu plus large, à chaque fois
// encore trop court. Mesuré : la lueur descend jusqu'à y=1006 quand mon rectangle s'arrêtait à
// 972. Cinquante pixels qu'aucun coup d'oeil ne rattrape, parce qu'un halo n'a pas de bord — il
// s'éteint progressivement, et l'oeil place la limite là où l'image lui paraît finie, c'est-à-dire
// toujours trop tôt.
//
// La règle : ce qui peut être mesuré ne s'estime pas. Un élément qui brille (sceau, jauge, liseré,
// marqueur d'ATH) se borne par BALAYAGE DE PIXELS, jamais au jugé.
//
// Le critère est chromatique et non lumineux : sur un fond clair, un seuil de luminosité attrape
// le fond ; un écart entre canaux attrape la teinte de la lueur et rien d'autre. `--seuil` règle
// cet écart (25 par défaut) ; `--canaux rb` compare rouge et bleu (lueur jaune ou orange, le cas
// courant), `bg` bleu contre vert, `gr` vert contre rouge.

import { readFile } from 'node:fs/promises'
import { chromium } from 'playwright'

const arg = (n, d = null) => {
  const i = process.argv.indexOf(`--${n}`)
  return i >= 0 && process.argv[i + 1] ? process.argv[i + 1] : d
}

const file = process.argv[2]
if (!file || !arg('win')) {
  throw new Error('usage : node scripts/zrm-extent.mjs <capture> --win x0,y0,x1,y1 [--seuil 25] [--canaux rb]')
}
const win = arg('win').split(',').map(Number)
const seuil = Number(arg('seuil', 25))
const canaux = arg('canaux', 'rb')

const ext = file.split('.').pop().toLowerCase().replace('jpg', 'jpeg')
const src = `data:image/${ext};base64,${(await readFile(file)).toString('base64')}`

const browser = await chromium.launch()
const page = await browser.newPage()
const box = await page.evaluate(async ([u, w, s, ch]) => {
  const img = new Image(); img.src = u; await img.decode()
  const c = document.createElement('canvas')
  c.width = img.naturalWidth; c.height = img.naturalHeight
  c.getContext('2d').drawImage(img, 0, 0)
  const [X0, Y0, X1, Y1] = w
  const d = c.getContext('2d').getImageData(X0, Y0, X1 - X0, Y1 - Y0).data
  const pick = { rb: [0, 2], bg: [2, 1], gr: [1, 0] }[ch]
  let x0 = Infinity, y0 = Infinity, x1 = -1, y1 = -1
  for (let y = 0; y < Y1 - Y0; y++) {
    for (let x = 0; x < X1 - X0; x++) {
      const i = (y * (X1 - X0) + x) * 4
      if (d[i + pick[0]] - d[i + pick[1]] > s) {
        if (x < x0) x0 = x; if (x > x1) x1 = x
        if (y < y0) y0 = y; if (y > y1) y1 = y
      }
    }
  }
  return x1 < 0 ? null : [x0 + X0, y0 + Y0, x1 - x0 + 1, y1 - y0 + 1]
}, [src, win, seuil, canaux])
await browser.close()

if (!box) {
  console.log(`Aucun pixel au-dessus du seuil ${seuil} dans cette fenêtre — élargir la fenêtre ou baisser le seuil.`)
} else {
  console.log(`rect mesuré : ${JSON.stringify(box)}`)
  console.log(`(bornes ${box[0]}→${box[0] + box[2]} en x, ${box[1]}→${box[1] + box[3]} en y)`)
  if (win.some((v, i) => i < 2 ? box[i] <= v : false) || box[0] + box[2] >= win[2] || box[1] + box[3] >= win[3]) {
    console.log(`⚠ l'élément touche un bord de la fenêtre de mesure : il déborde probablement. Élargir --win.`)
  }
}
