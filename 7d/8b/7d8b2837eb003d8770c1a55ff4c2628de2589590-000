// FOLDER STYLE DIALOG (2 October 2026). Colour + SVG glyph of a folder, the way Finder offers it.
// The colour list is the tag palette (src/config/colors.js, same keys as the Finder tags); the glyph comes
// from a search bar over the thesvg.org catalogue (static manifest, filtered client side).
// FR : couleur + glyphe d'un dossier. Les couleurs sont celles des tags, le glyphe vient de thesvg.org.
//
// Nothing is saved here: `onApply({ color, icon })` hands the choice back to the owner of the tags file,
// so there is still ONE persistence path. A network failure is shown in the dialog and never cached.
import React, { useEffect, useMemo, useRef, useState } from 'react'
import { TAG_COLORS, FOLDER_ICON_SOURCE } from '../config/colors.js'
import { PALETTE, RADII, FONTS, SHADOWS } from '../theme.js'
import Icon from './Icon.jsx'
import FolderArt from './FolderArt.jsx'
import { loadIconRegistry, searchIcons, fetchIconRecord, glyphVariant } from '../lib/folderStyle.js'

const eyebrow = (t) => ({ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-3xs)', textTransform: 'uppercase', letterSpacing: 1, color: t.textSecondary })

function GlyphThumb({ icon, color }) {
  const url = FOLDER_ICON_SOURCE.iconUrl(icon.slug, glyphVariant(icon))
  return <span aria-hidden style={{ display: 'block', width: 26, height: 26, background: color, maskImage: `url("${url}")`, WebkitMaskImage: `url("${url}")`, maskSize: 'contain', WebkitMaskSize: 'contain', maskRepeat: 'no-repeat', WebkitMaskRepeat: 'no-repeat', maskPosition: 'center', WebkitMaskPosition: 'center' }} />
}

export default function FolderStyleDialog({ t, name, initialColor, initialIcon, tagLabel, onClose, onApply }) {
  const [color, setColor] = useState(initialColor || null)
  const [icon, setIcon] = useState(initialIcon || null)
  const [query, setQuery] = useState('')
  const [debounced, setDebounced] = useState('')
  const [registry, setRegistry] = useState(null)
  const [registryError, setRegistryError] = useState(null)
  const [pickError, setPickError] = useState(null)
  const [picking, setPicking] = useState(null)
  const alive = useRef(true)

  useEffect(() => { alive.current = true; return () => { alive.current = false } }, [])

  // The catalogue loads when the dialog opens (never at mount of the app), once per session.
  const loadRegistry = () => {
    setRegistryError(null)
    loadIconRegistry().then((ix) => { if (alive.current) setRegistry(ix) }).catch((err) => { if (alive.current) setRegistryError(err.message || 'thesvg.org is unreachable') })
  }
  useEffect(loadRegistry, [])

  useEffect(() => {
    const id = setTimeout(() => setDebounced(query), FOLDER_ICON_SOURCE.debounceMs)
    return () => clearTimeout(id)
  }, [query])

  useEffect(() => {
    const onKey = (ev) => { if (ev.key === 'Escape') onClose() }
    window.addEventListener('keydown', onKey)
    return () => window.removeEventListener('keydown', onKey)
  }, [onClose])

  const results = useMemo(() => (registry && debounced.trim() ? searchIcons(registry, debounced) : []), [registry, debounced])

  const pick = async (item) => {
    setPickError(null); setPicking(item.slug)
    try {
      const record = await fetchIconRecord(item)
      if (alive.current) setIcon(record)
    } catch (err) {
      if (alive.current) setPickError(err.message || 'Download failed')
    } finally {
      if (alive.current) setPicking(null)
    }
  }

  const tint = color ? (TAG_COLORS.find(([k]) => k === color) || [])[1] || null : null
  const swatch = (k, hex) => (
    <button key={k} type="button" title={tagLabel ? tagLabel(k) : k} aria-pressed={color === k} onClick={() => setColor(color === k ? null : k)}
      style={{ width: 22, height: 22, borderRadius: 99, background: hex, padding: 0, cursor: 'pointer', border: color === k ? `2px solid ${t.textPrimary}` : '2px solid transparent', boxShadow: color === k ? `0 0 0 2px ${t.cardBg} inset` : 'none' }} />
  )

  return (
    <div onClick={onClose} style={{ position: 'fixed', inset: 0, zIndex: 9980, background: 'rgba(0,0,0,0.45)', display: 'grid', placeItems: 'center', padding: 16 }}>
      <div onClick={(ev) => ev.stopPropagation()} role="dialog" aria-label="Personnaliser le dossier"
        style={{ width: 'min(560px, 94vw)', maxHeight: '82vh', display: 'flex', flexDirection: 'column', background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: RADII.lg, boxShadow: SHADOWS.lg, overflow: 'hidden' }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '15px 18px 10px' }}>
          <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xl)', fontWeight: 600, color: t.textPrimary, flex: 1, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>Personnaliser « {name} »</span>
          <button onClick={onClose} aria-label="Fermer" style={{ background: 'transparent', border: 'none', cursor: 'pointer', padding: 4, display: 'inline-flex', opacity: 0.6 }}><Icon name="xmark" size={14} weight={2} color={t.textPrimary} /></button>
        </div>

        <div style={{ display: 'flex', gap: 18, alignItems: 'center', padding: '4px 18px 12px' }}>
          <FolderArt width={104} color={tint} glyph={icon} />
          <div style={{ display: 'flex', flexDirection: 'column', gap: 8, minWidth: 0 }}>
            <span style={eyebrow(t)}>Couleur</span>
            <div style={{ display: 'flex', gap: 9, alignItems: 'center', flexWrap: 'wrap' }}>
              {TAG_COLORS.map(([k, hex]) => swatch(k, hex))}
              <button type="button" onClick={() => setColor(null)} title="Sans couleur" aria-label="Sans couleur" style={{ background: 'transparent', border: 'none', cursor: 'pointer', padding: 2, display: 'inline-flex', opacity: color ? 0.8 : 0.35 }}><Icon name="xmark" size={13} weight={2} color={t.textPrimary} /></button>
            </div>
            <span style={{ ...eyebrow(t), marginTop: 4 }}>Icône</span>
            <div style={{ display: 'flex', alignItems: 'center', gap: 8, minHeight: 20 }}>
              <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', color: icon ? t.textPrimary : t.textSecondary }}>{icon ? icon.slug : 'Aucune'}</span>
              {icon && <button type="button" onClick={() => setIcon(null)} style={{ background: 'transparent', border: 'none', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: PALETTE.primary, padding: 0 }}>Retirer</button>}
            </div>
          </div>
        </div>

        <div style={{ padding: '0 18px', display: 'flex', flexDirection: 'column', minHeight: 0, flex: 1 }}>
          <input autoFocus value={query} onChange={(ev) => setQuery(ev.target.value)} onKeyDown={(ev) => ev.stopPropagation()} placeholder="Rechercher une icône sur thesvg.org (github, figma, unreal…)"
            style={{ background: 'transparent', border: `1px solid ${t.border}`, borderRadius: RADII.sm, outline: 'none', padding: '8px 11px', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', color: t.textPrimary }} />
          <div style={{ minHeight: 150, maxHeight: 250, overflowY: 'auto', marginTop: 10, border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: 8 }}>
            {registryError ? (
              <div role="alert" style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', color: '#FF3B30', display: 'flex', gap: 10, alignItems: 'center', flexWrap: 'wrap' }}>
                <span>Catalogue thesvg.org indisponible : {registryError}.</span>
                <button type="button" onClick={loadRegistry} style={{ background: 'transparent', border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: '3px 10px', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: t.textPrimary }}>Réessayer</button>
              </div>
            ) : !registry ? (
              <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary }}>Chargement du catalogue thesvg.org…</span>
            ) : !debounced.trim() ? (
              <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary }}>{registry.length} icônes. Tape un nom pour chercher.</span>
            ) : results.length === 0 ? (
              <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary }}>Aucun résultat pour « {debounced.trim()} ».</span>
            ) : (
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(64px, 1fr))', gap: 6 }}>
                {results.map((item) => {
                  const on = icon && icon.slug === item.slug
                  return (
                    <button key={item.slug} type="button" title={item.title} onClick={() => pick(item)} disabled={!!picking}
                      style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 4, padding: '8px 4px 5px', borderRadius: 8, cursor: picking ? 'default' : 'pointer', background: on ? PALETTE.primarySoft : 'transparent', border: on ? `1.5px solid ${PALETTE.primary}` : '1.5px solid transparent', opacity: picking && picking !== item.slug ? 0.5 : 1, color: t.textPrimary }}>
                      <GlyphThumb icon={item} color={t.textPrimary} />
                      <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-3xs)', color: t.textSecondary, maxWidth: '100%', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{picking === item.slug ? '…' : item.title}</span>
                    </button>
                  )
                })}
              </div>
            )}
          </div>
          {pickError && <div role="alert" style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: '#FF3B30', marginTop: 6 }}>Icône non chargée : {pickError}.</div>}
        </div>

        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'flex-end', gap: 10, padding: '12px 18px 14px', borderTop: `1px solid ${t.border}`, marginTop: 10 }}>
          <button onClick={onClose} style={{ background: 'transparent', border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: '6px 14px', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', fontWeight: 500, color: t.textPrimary }}>Annuler</button>
          <button onClick={() => onApply({ color, icon })} disabled={!!picking}
            style={{ background: PALETTE.gradient, color: '#fff', border: 'none', borderRadius: RADII.sm, padding: '6px 18px', cursor: picking ? 'default' : 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', fontWeight: 600 }}>Appliquer</button>
        </div>
      </div>
    </div>
  )
}
