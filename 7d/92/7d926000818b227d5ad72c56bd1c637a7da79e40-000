const KEY = (id) => `zr:ui:${id}`
const EVT = 'zr:uipref'
export const getUiPref = (id, def = true) => { try { const v = localStorage.getItem(KEY(id)); return v == null ? def : v === '1' } catch { return def } }
export const setUiPref = (id, on) => {
  try { localStorage.setItem(KEY(id), on ? '1' : '0') } catch {}
  try { window.dispatchEvent(new CustomEvent(EVT, { detail: { id, on } })) } catch {}
}

// Hook : visible ?  — synchronisé entre tous les composants (événement fenêtre, pas de re-render global).
export function useUiPref(id, def = true) {
  const [on, setOn] = useState(() => getUiPref(id, def))
  useEffect(() => {
    const h = (e) => { if (e.detail && e.detail.id === id) setOn(!!e.detail.on) }
    window.addEventListener(EVT, h)
    return () => window.removeEventListener(EVT, h)
  }, [id])
  return [on, (v) => setUiPref(id, v)]
}

// Enveloppe déclarative : <Hideable id="lang">…</Hideable> -> rien du tout quand caché.
export function Hideable({ id, def = true, children }) {
  const [on] = useUiPref(id, def)
  return on ? children : null
}

// ── 3. appui long -> contextmenu (mobile) ───────────────────────────────────────────────────────────────
// Installé UNE fois (App). 450 ms immobile (tolérance 10 px) -> dispatch d'un vrai MouseEvent('contextmenu')
// sur l'élément touché : React (délégation racine) route vers le onContextMenu du composant, identique au
// clic droit desktop. Un mouvement (scroll) ou une fin de toucher avant l'échéance annule proprement.
//
// Tuile du Finder (data-zr-dir) = cas particulier (2026-07-06, drag mobile vers le fil d'ariane) : au lieu
// de déclencher le menu contextuel tout de suite, on émet un événement custom `zrlongpressarm` — App.jsx
// décide alors si le doigt reste immobile jusqu'au relâchement (menu contextuel classique, inchangé) ou s'il
// se met à bouger (le geste devient un drag tactile vers un segment du fil d'ariane). Aucun autre élément
// du site n'est affecté : ils gardent le déclenchement immédiat du contextmenu comme avant.
export function installLongPressContextMenu() {
  if (typeof window === 'undefined' || window.__zrLongPress) return
  window.__zrLongPress = true
  let timer = null, sx = 0, sy = 0, target = null
  const cancel = () => { if (timer) { clearTimeout(timer); timer = null } target = null }
  window.addEventListener('touchstart', (e) => {
    if (e.touches.length !== 1) return cancel()
    const t = e.touches[0]
    sx = t.clientX; sy = t.clientY; target = e.target
    timer = setTimeout(() => {
      const el = target; cancel()
      if (!el) return
      try { navigator.vibrate && navigator.vibrate(10) } catch {}
      const tile = el.closest && el.closest('[data-zr-dir]')
      if (tile) tile.dispatchEvent(new CustomEvent('zrlongpressarm', { bubbles: true, detail: { x: sx, y: sy, el } }))
      else el.dispatchEvent(new MouseEvent('contextmenu', { bubbles: true, cancelable: true, clientX: sx, clientY: sy, view: window }))
    }, 450)
  }, { passive: true })
  window.addEventListener('touchmove', (e) => {
    if (!timer) return
    const t = e.touches[0]
    if (Math.abs(t.clientX - sx) > 10 || Math.abs(t.clientY - sy) > 10) cancel()
  }, { passive: true })
  window.addEventListener('touchend', cancel, { passive: true })
  window.addEventListener('touchcancel', cancel, { passive: true })
}
