// uiPrefs.js — SYSTÈME UI GLOBAL (2026-07-06, plan UX validé par Matthieu) : trois briques transversales.
//
// 1. ÉCHELLE NOMBRE D'OR : tous les espacements/regroupements de boutons suivent une échelle unique dérivée
//    de φ (1.618) — base 8 px puis ~8·φⁿ arrondi à Fibonacci : 8, 13, 21, 34, 55. Un groupe de boutons est
//    espacé de S1 (8) à l'intérieur, les groupes entre eux de S2 (13), les sections de S3 (21). Les rangées
//    se CENTRENT (justify-content:center) ou se distribuent (space-between pleine largeur) — jamais
//    d'empilement arbitraire. S'applique desktop ET surtout mobile.
//
// 2. VISIBILITÉ PERSISTÉE : tout élément d'interface secondaire (badge, bouton d'info, fonction) peut être
//    caché/affiché, et ce choix SURVIT au rafraîchissement (localStorage `zr:ui:<id>`). Le point de
//    restauration unique est le menu « œil » (EyeMenu, en haut à droite) qui liste tous les éléments
//    enregistrés avec un interrupteur chacun — on ne peut donc jamais « perdre » un élément caché.
//
// 3. APPUI LONG = CLIC DROIT (mobile) : un écouteur GLOBAL touche (installé une fois) synthétise un
//    événement `contextmenu` sur l'élément touché après 450 ms sans mouvement — TOUS les onContextMenu
//    existants (tuiles Finder, fond de grille, favoris, tableur) marchent sur iPhone sans modification.

import React, { useEffect, useLayoutEffect, useRef, useState } from 'react'
import { createPortal } from 'react-dom'

// ── 1. échelle nombre d'or ──────────────────────────────────────────────────────────────────────────────
export const PHI = 1.618
export const GOLD = { s1: 8, s2: 13, s3: 21, s4: 34, s5: 55 } // ≈ 8·φⁿ (suite de Fibonacci)

// Bouton icône UNIQUE (2026-07-06, fix "boutons pas alignés") : même carré 34×34 (GOLD.s4), même absence de
// bordure au repos, même rayon — utilisé PARTOUT où un bouton icône apparaît en haut de page (retour, ⋯,
// langue, œil) pour qu'ils soient visuellement de la MÊME famille, jamais 3 styles différents côte à côte.
export const iconBtnStyle = (t, active = false) => ({
  width: GOLD.s4, height: GOLD.s4, flexShrink: 0, display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
  background: active ? (t.textPrimary || '#111') : 'transparent', color: active ? (t.cardBg || '#fff') : (t.textPrimary || '#111'),
  border: 'none', borderRadius: 999, cursor: 'pointer', padding: 0, transition: 'background .15s, color .15s',
})

// Popover minimal auto-fermant (clic extérieur / Échap), ancré sous un bouton icône iconBtnStyle. Un seul
// composant pour TOUS les popovers du site (langue, œil, menu d'actions) -> même comportement, même chrome.
export function Pop({ t, trigger, title, children, width = 200, align = 'right' }) {
  const [open, setOpen] = useState(false)
  const ref = useRef(null)      // wrapper du déclencheur
  const panelRef = useRef(null) // contenu du popover (dans le portail)
  const [pos, setPos] = useState(null) // { top, left } en coordonnées écran (position: fixed)

  // POPOVER EN PORTAIL (2026-07-22, fix "menu du gear crop") : rendu dans document.body en position:fixed, pas
  // en absolute dans le wrapper. Sinon un ANCÊTRE qui coupe (sidebar overflow:hidden, backdrop-filter créant un
  // bloc de confinement) rognait le menu -- et le z-index seul ne sauve JAMAIS d'un overflow clippé. On calcule
  // la position depuis le rect du déclencheur, on l'aligne (right/left) puis on la BORNE à l'écran (jamais hors-champ).
  const place = () => {
    const b = ref.current?.getBoundingClientRect()
    if (!b) return
    let left = align === 'left' ? b.left : b.right - width
    left = Math.max(8, Math.min(left, window.innerWidth - width - 8))
    const top = Math.min(b.bottom + 8, window.innerHeight - 16)
    setPos({ top, left })
  }
  useLayoutEffect(() => { if (open) place() }, [open]) // eslint-disable-line
  useEffect(() => {
    if (!open) return
    const away = (e) => { if (ref.current?.contains(e.target) || panelRef.current?.contains(e.target)) return; setOpen(false) }
    const esc = (e) => { if (e.key === 'Escape') setOpen(false) }
    const reflow = () => place()
    document.addEventListener('mousedown', away); document.addEventListener('keydown', esc)
    window.addEventListener('resize', reflow); window.addEventListener('scroll', reflow, true)
    return () => { document.removeEventListener('mousedown', away); document.removeEventListener('keydown', esc); window.removeEventListener('resize', reflow); window.removeEventListener('scroll', reflow, true) }
  }, [open]) // eslint-disable-line
  return (
    <div ref={ref} style={{ display: 'inline-flex' }}>
      <button onClick={() => setOpen((v) => !v)} title={title} className="zr-tap" style={iconBtnStyle(t, open)}>{trigger}</button>
      {open && pos && createPortal(
        <div ref={panelRef} style={{ position: 'fixed', top: pos.top, left: pos.left, zIndex: 4000, minWidth: width, maxWidth: `calc(100vw - 16px)`, maxHeight: `calc(100vh - ${pos.top + 16}px)`, overflowY: 'auto', background: t.cardBg || '#fff', border: `1px solid ${t.border || 'rgba(0,0,0,0.1)'}`, borderRadius: GOLD.s2, padding: GOLD.s1, boxShadow: '0 12px 34px -10px rgba(20,30,70,0.35)' }}>
          {children(() => setOpen(false))}
        </div>,
        document.body,
      )}
    </div>
  )
}

// ── 2. visibilité persistée ─────────────────────────────────────────────────────────────────────────────
// Registre des éléments cachables : id stable -> libellé humain (affiché dans le menu œil).
// AJOUTER ICI tout nouvel élément cachable — une ligne suffit, le menu œil le liste automatiquement.
export const HIDEABLES = [
  // 'lang' retiré le 2026-07-21 : la langue est désormais une section permanente du menu Réglages
  // (engrenage sidebar, SettingsMenu.jsx), plus une icône cachable -> le toggle n'aurait plus d'effet.
  { id: 'ghquota', label: 'Quota GitHub (pastille)' },
  { id: 'counts', label: 'Compteur d’éléments (Create)' },
  { id: 'crumbtags', label: 'Actions du fil d’Ariane (⋯)' },
