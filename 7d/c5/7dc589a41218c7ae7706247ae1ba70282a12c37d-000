// 12 October 2026: turns an archived image into a small cover thumbnail that fits the card exactly.
// 20 October 2026: upgraded to 720x406 at quality 0.85 for Retina 2x screens without pixelation.
// 20 October 2026: added custom adjustment support (pan X/Y, zoom, contain/cover with black letterbox bands).
// Center-cropped to the card ratio, WebP, as a data URI (about 15 to 40 KB): it can live inside the covers file
// and paints instantly, with no manifest read and no 5 MB download on the next visit.
// FR : transforme une image archivée en miniature Retina 720x406 recadrée au centre au format de la carte.
import { resolveEntryBytes } from './bulkZip.js'

export const COVER_THUMB = { width: 720, height: 406, quality: 0.85, maxBytes: 40e6 }

// Pure geometry, tested apart: where to draw a source image so it covers the box, centered.
export function coverDrawRect(sourceWidth, sourceHeight, width = COVER_THUMB.width, height = COVER_THUMB.height) {
  const scale = Math.max(width / sourceWidth, height / sourceHeight)
  const drawWidth = sourceWidth * scale
  const drawHeight = sourceHeight * scale
  return { x: (width - drawWidth) / 2, y: (height - drawHeight) / 2, width: drawWidth, height: drawHeight, scale }
}

// 20 October 2026: geometry for custom adjusted covers with pan X/Y, zoom, and fit modes (contain/cover).
export function coverAdjustedRect(sourceWidth, sourceHeight, options = {}) {
  const {
    width = COVER_THUMB.width,
    height = COVER_THUMB.height,
    panX = 0,
    panY = 0,
    zoom = 1,
    fitMode = 'cover',
  } = options
  const sw = Math.max(1, Number(sourceWidth) || width)
  const sh = Math.max(1, Number(sourceHeight) || height)
  const baseScale = fitMode === 'contain'
    ? Math.min(width / sw, height / sh)
    : Math.max(width / sw, height / sh)
  const scale = baseScale * Math.max(0.02, Number(zoom) || 1)
  const drawWidth = sw * scale
  const drawHeight = sh * scale
  const x = (width - drawWidth) / 2 + (Number(panX) || 0)
  const y = (height - drawHeight) / 2 + (Number(panY) || 0)
  return { x, y, width: drawWidth, height: drawHeight, scale, baseScale }
}

// 20 October 2026: paints an adjusted cover onto a canvas with a pure black background (#000000) for letterbox/pillarbox bands.
export function drawCoverCanvas(canvas, sourceImage, options = {}) {
  const { width = COVER_THUMB.width, height = COVER_THUMB.height } = options
  canvas.width = width
  canvas.height = height
  const context = canvas.getContext('2d')
  context.fillStyle = '#000000'
  context.fillRect(0, 0, width, height)
  const sw = sourceImage?.naturalWidth || sourceImage?.videoWidth || sourceImage?.width || width
  const sh = sourceImage?.naturalHeight || sourceImage?.videoHeight || sourceImage?.height || height
  const rect = coverAdjustedRect(sw, sh, { ...options, width, height })
  context.imageSmoothingEnabled = true
  context.imageSmoothingQuality = 'high'
  context.drawImage(sourceImage, rect.x, rect.y, rect.width, rect.height)
  return canvas
}

export async function coverThumbnailDataUri(file, options = {}) {
  const { width, height, quality, maxBytes } = { ...COVER_THUMB, ...options }
  if (file?.thumbnailUrl && !options.force) return file.thumbnailUrl
  if (!file?.contentPath || (Number(file.size) > maxBytes)) return undefined
  const entry = await resolveEntryBytes({ contentPath: file.contentPath, name: file.name })
  if (!entry?.bytes) return undefined
  const bitmap = await createImageBitmap(new Blob([entry.bytes]))
  try {
    const canvas = document.createElement('canvas')
    canvas.width = width
    canvas.height = height
    const rect = coverDrawRect(bitmap.width, bitmap.height, width, height)
    canvas.getContext('2d').drawImage(bitmap, rect.x, rect.y, rect.width, rect.height)
    return canvas.toDataURL('image/webp', quality)
  } finally { bitmap.close?.() }
}
