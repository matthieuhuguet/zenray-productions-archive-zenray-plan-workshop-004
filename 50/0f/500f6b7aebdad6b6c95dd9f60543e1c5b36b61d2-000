                {marquee && <span aria-hidden="true" style={{ position: 'absolute', zIndex: 3, pointerEvents: 'none', left: marquee.left, top: marquee.top, width: marquee.width, height: marquee.height, boxSizing: 'border-box', border: `1px solid ${PALETTE.primary}`, borderRadius: 3, background: 'rgba(10,132,255,0.14)' }} />}
              </div>
            )}
          </div>
        </div>
        {zipMsg && <div style={{ position: 'absolute', right: 18, bottom: showSpaceTip ? 58 : 18, zIndex: 4, color: t.textSecondary, fontSize: 'var(--zr-ui-sm)', padding: '6px 9px', borderRadius: 8, background: 'rgba(253,253,252,0.72)', backdropFilter: 'blur(14px)', WebkitBackdropFilter: 'blur(14px)' }}>{zipMsg}</div>}
        {showSpaceTip && <div style={{ position: 'absolute', left: '50%', bottom: 18, zIndex: 4, transform: 'translateX(-50%)', whiteSpace: 'nowrap', color: t.textSecondary, fontSize: 'var(--zr-ui-sm)', padding: '7px 11px', borderRadius: 9, background: 'rgba(253,253,252,0.74)', border: '1px solid rgba(31,31,30,0.10)', backdropFilter: 'blur(16px)', WebkitBackdropFilter: 'blur(16px)' }}><kbd style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', fontWeight: 650, color: t.textPrimary }}>Espace</kbd> · voir la photo en détail</div>}
      </main>

      {/* Upload in progress while the sheet is closed: a small pill, one tap to see it again. */}
      {!uploadOpen && guestUp.snap && !guestUp.snap.idle && guestUp.snap.counts.total > guestUp.snap.counts.skipped && (
        <button onClick={() => setUploadOpen(true)} style={{ position: 'fixed', left: 18, bottom: 18, zIndex: 300, display: 'inline-flex', alignItems: 'center', gap: 9, padding: '10px 16px', borderRadius: 99, border: 'none', cursor: 'pointer', background: 'rgba(253,253,252,0.92)', boxShadow: '0 8px 30px rgba(0,0,0,0.18)', color: t.textPrimary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', backdropFilter: 'blur(16px)', WebkitBackdropFilter: 'blur(16px)' }}>
          <SpinnerApple taille={14} couleur={PALETTE.primary} titre="Envoi en cours" /> Envoi de vos photos · {guestUp.snap.counts.done} / {guestUp.snap.counts.total - guestUp.snap.counts.skipped}
        </button>
      )}
      {shareToken && root && <GuestUploadSheet open={uploadOpen} onClose={() => setUploadOpen(false)} up={guestUp} rootLabel={crumbs[0] || 'galerie'} initialEntries={dropEntries}
        onView={(folderName, subPath) => { setSub(subPath ? `${folderName}/${subPath}` : folderName); setRefreshKey((k) => k + 1) }} />}

      {/* OVERLAY ouverture média : vidéo -> lecteur ; image -> plein écran. Fond flouté, clic hors -> ferme.
          Grows in / shrinks out over QUICKLOOK_ANIM_MS (same duration as the drive's Quick Look); images cross-fade on arrows. */}
      {open && (
        <div onClick={closeViewer}
          onTouchStart={(ev) => { const t0 = ev.touches[0]; swipeRef.current = t0 ? { x: t0.clientX, y: t0.clientY } : null }}
          onTouchEnd={(ev) => { const a = swipeRef.current; swipeRef.current = null; const t1 = ev.changedTouches[0]; if (!a || !t1 || open.node.kind === 'video') return; const dx = t1.clientX - a.x, dy = t1.clientY - a.y; if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.4) stepViewer(dx < 0 ? 1 : -1) }}
          style={{ position: 'fixed', inset: 0, zIndex: 200, background: 'rgba(20,22,30,0.55)', backdropFilter: 'blur(18px)', WebkitBackdropFilter: 'blur(18px)', display: 'grid', placeItems: 'center', padding: 'clamp(10px,3vw,40px)', touchAction: 'pan-y', animation: `${closing ? 'zrQlFadeOut' : 'zrQlFadeIn'} ${QUICKLOOK_ANIM_MS}ms ease forwards` }}>
          {medias.length > 1 && <button onClick={(ev) => { ev.stopPropagation(); stepViewer(-1) }} aria-label="Image précédente" title="Image précédente (←)" style={{ position: 'fixed', top: '50%', left: 24, transform: 'translateY(-50%)', zIndex: 201, width: 48, height: 48, border: 'none', borderRadius: 99, background: 'rgba(255,255,255,0.14)', color: '#fff', cursor: 'pointer', display: 'grid', placeItems: 'center' }}><Icon name="chevron.left" size={24} weight={1.8} color="#fff" /></button>}
          {medias.length > 1 && <button onClick={(ev) => { ev.stopPropagation(); stepViewer(1) }} aria-label="Image suivante" title="Image suivante (→)" style={{ position: 'fixed', top: '50%', right: 24, transform: 'translateY(-50%)', zIndex: 201, width: 48, height: 48, border: 'none', borderRadius: 99, background: 'rgba(255,255,255,0.14)', color: '#fff', cursor: 'pointer', display: 'grid', placeItems: 'center' }}><Icon name="chevron.right" size={24} weight={1.8} color="#fff" /></button>}
          <div style={{ position: 'fixed', top: 18, right: 22, zIndex: 201, color: 'rgba(255,255,255,0.6)', fontSize: 'var(--zr-ui-sm)', fontFamily: FONTS.sans, pointerEvents: 'none' }}>Espace/Échap fermer · ←/→ naviguer{openIndex >= 0 ? ` · ${openIndex + 1}/${medias.length}` : ''}</div>
          <div onClick={(e) => e.stopPropagation()} style={{ width: '100%', maxWidth: open.node.kind === 'video' ? 1100 : 1400, animation: `${closing ? 'zrQlOut' : 'zrQlIn'} ${QUICKLOOK_ANIM_MS}ms cubic-bezier(.2,.7,.3,1) forwards` }}>
            {open.node.kind === 'video'
              ? <div className="zr-liquid" style={{ borderRadius: 18, padding: 'clamp(10px,2vw,18px)' }}>
                  {open.path
                    ? <React.Suspense fallback={<div style={{ color: t.textSecondary, padding: 40, textAlign: 'center' }}>{i18nT('folder.loadingPlayer')}</div>}>
                        <LazyVideoPlayer2 key={open.path} t={t} path={open.path} manifest={open.meta} shared />
                      </React.Suspense>
                    : <div style={{ color: t.textSecondary, padding: 40, textAlign: 'center' }}>{open.error ? 'Média indisponible.' : i18nT('folder.loadingPlayer')}</div>}
                </div>
              : <SharedStage item={open} t={t} shareToken={shareToken} />}
          </div>
        </div>
      )}
    </div>
  )
}

// FULL-SIZE LOADS ARE RATIONED (2 October 2026, « image grise transparente lorsqu'on défile »). A photo of this gallery weighs
// 3 to 9 MB at full size and takes the server 3 to 13 s to decrypt. The viewer used to request the full size of EVERY photo the
// arrow passed over, plus the full size of the next one in advance: a few quick arrow presses queued a dozen multi-megabyte
// downloads, and the small thumbnails of the photos actually on screen waited behind them for tens of seconds. The viewer then
// showed an empty grey frame. Now: (1) the thumbnail is requested first and alone; (2) the full size only after the photo has
// stayed on screen for FULL_DWELL_MS; (3) only ONE full-size download may run, and leaving a photo aborts it; (4) neighbours are
// warmed with thumbnails only.
const FULL_DWELL_MS = 700
const THUMB_RETRIES = 3
let fullInFlight = null // { img, release }
function loadFullOnce(url, onDone) {
  if (fullInFlight) fullInFlight.release()           // a newer photo is now the one that counts
  const img = new Image()
  let done = false
  const release = () => { if (done) return; done = true; img.onload = null; img.onerror = null; try { img.src = '' } catch {} if (fullInFlight && fullInFlight.img === img) fullInFlight = null }
  fullInFlight = { img, release }
  img.onload = () => { if (done) return; done = true; if (fullInFlight && fullInFlight.img === img) fullInFlight = null; onDone(true) }
  img.onerror = () => { if (done) return; done = true; if (fullInFlight && fullInFlight.img === img) fullInFlight = null; onDone(false) }
  img.decoding = 'async'
  img.src = url
  return release
}

// CROSS-FADE BETWEEN IMAGES (2 October 2026). The image on screen stays until the NEXT ONE HAS ITS THUMBNAIL: the incoming layer
// is mounted invisible, and only when it reports ready do both fade (and slide a few pixels in the direction of the arrow) over
// QUICKLOOK_ANIM_MS and the old layer is dropped. Pressing arrows faster than images arrive therefore never shows an empty frame:
// it keeps the last good image, and only the newest pending layer survives. A failsafe swaps anyway after STAGE_FAILSAFE_MS so a
// stuck request shows its own loading/retry state instead of freezing the old photo forever.
const STAGE_FAILSAFE_MS = 4000
function SharedStage({ item, t, shareToken }) {
  const i18nT = useT()
  const idRef = useRef(0)
  const [layers, setLayers] = useState(() => [{ ...item, id: 0, ready: true, leaving: false }])
  useEffect(() => {
    setLayers((prev) => {
      const newest = prev[prev.length - 1]
      if (newest && !newest.leaving && newest.node.path === item.node.path) {
        // same entry: only its resolved data arrived
        return prev.map((l) => (l === newest ? { ...l, path: item.path, meta: item.meta, error: item.error } : l))
      }
      idRef.current += 1
      // keep what is visible (ready, not leaving); drop pending layers of photos we already moved past
      return [...prev.filter((l) => l.ready && !l.leaving), { ...item, id: idRef.current, ready: false, leaving: false }]
    })
  }, [item.node.path, item.path, item.meta, item.error]) // eslint-disable-line react-hooks/exhaustive-deps
  const markReady = (id) => setLayers((prev) => {
    if (!prev.some((l) => l.id === id && !l.ready)) return prev
    return prev.map((l) => (l.id === id ? { ...l, ready: true } : l.id < id ? { ...l, leaving: true } : l))
  })
  // failsafe for the newest pending layer
  useEffect(() => {
    const pending = layers.find((l) => !l.ready)
    if (!pending) return undefined
    const id = setTimeout(() => markReady(pending.id), STAGE_FAILSAFE_MS)
    return () => clearTimeout(id)
  }, [layers])
  useEffect(() => {
    if (!layers.some((l) => l.leaving)) return undefined
    const id = setTimeout(() => setLayers((prev) => prev.filter((l) => !l.leaving)), QUICKLOOK_ANIM_MS + 60)
    return () => clearTimeout(id)
  }, [layers])
  const dir = item.dir || 0
  const newestId = layers.length ? layers[layers.length - 1].id : 0
  return (
    <div style={{ display: 'grid', placeItems: 'center' }}>
      {layers.map((l) => (
        <div key={l.id} style={{ gridArea: '1 / 1', width: '100%', '--zr-dir': dir, pointerEvents: l.leaving || !l.ready ? 'none' : 'auto', opacity: l.ready ? undefined : 0, animation: l.leaving ? `zrShareOut ${QUICKLOOK_ANIM_MS}ms ease forwards` : (l.ready && l.id !== 0 ? `zrShareIn ${QUICKLOOK_ANIM_MS}ms cubic-bezier(.2,.7,.3,1) both` : 'none') }}>
          {l.path
            ? <SharedImage node={{ ...l.node, path: l.path }} meta={l.meta} t={t} shareToken={shareToken} active={!l.leaving && l.id === newestId} onFirstPaint={() => markReady(l.id)} />
            : <div style={{ color: '#fff', padding: 40, textAlign: 'center' }}>{l.error ? 'Image indisponible.' : i18nT('folder.loadingImage')}</div>}
        </div>
      ))}
    </div>
  )
}

// Image plein écran. FIX (2026-07-01) : déchiffrement CÔTÉ SERVEUR via /api/shared-media (public, la clé ne
// quitte jamais le serveur) au lieu du fetch('/api/media-key') client qui échouait (401) pour tout visiteur
// anonyme du lien -> l'image plein écran restait invisible pour le destinataire du /folder partagé.
function SharedImage({ node, meta, t, shareToken, active = true, onFirstPaint }) {
  const i18nT = useT()
  const [manifest, setManifest] = useState(meta || null)
  const [thumb, setThumb] = useState('loading')       // loading | ready | failed
  const [attempt, setAttempt] = useState(0)
  const [fullSrc, setFullSrc] = useState(null)        // set once the full size is completely downloaded
  const [viewport, setViewport] = useState(() => ({ w: typeof window === 'undefined' ? 1200 : window.innerWidth, h: typeof window === 'undefined' ? 800 : window.innerHeight }))
  const paintedRef = useRef(false)

  useEffect(() => {
    let dead = false
    setManifest(meta || null)
    if (meta) return () => { dead = true }
    if (!node || !node.path) return () => { dead = true }
    // Lecture d affichage : hors quota (voir src/lib/urlLecture.js).
    fetch(urlLectureAffichage(node.path, { share: shareToken }), { cache: 'no-store' })
      .then((r) => r.json())
      .then((j) => { const m = JSON.parse(j.markdown); if (!dead) setManifest(m) })
      .catch(() => {})
    return () => { dead = true }
  }, [node && node.path, meta, shareToken])

  useEffect(() => {
    const onResize = () => setViewport({ w: window.innerWidth, h: window.innerHeight })
    window.addEventListener('resize', onResize)
    return () => window.removeEventListener('resize', onResize)
  }, [])

  // tell the stage this layer can be shown: its thumbnail is there, or it definitively failed (then it shows its retry state)
  useEffect(() => {
    if (thumb !== 'loading' && !paintedRef.current) { paintedRef.current = true; if (onFirstPaint) onFirstPaint() }
  }, [thumb]) // eslint-disable-line react-hooks/exhaustive-deps

  // thumbnail failures are retried (a transient 5xx / reset must never leave a grey frame)
  useEffect(() => {
    if (thumb !== 'failed' || attempt >= THUMB_RETRIES) return undefined
    const id = setTimeout(() => { setAttempt((n) => n + 1); setThumb('loading') }, 600 * (attempt + 1))
    return () => clearTimeout(id)
  }, [thumb, attempt])

  const thumbReady = thumb === 'ready'
  // the full size: only for the photo that stays on screen, one download at a time, aborted on leaving
  useEffect(() => {
    if (!active || !thumbReady || fullSrc || !node || !node.path) return undefined
    let release = null
    const id = setTimeout(() => {
      const url = appendShareCredential(`/api/shared-media?path=${encodeURIComponent(node.path)}&kind=full`, shareToken)
      release = loadFullOnce(url, (ok) => { if (ok) setFullSrc(url) })
    }, FULL_DWELL_MS)
    return () => { clearTimeout(id); if (release) release() }
  }, [active, thumbReady, fullSrc, node && node.path, shareToken])

  if (!node || !node.path) return <div style={{ color: '#fff', padding: 40, textAlign: 'center' }}>{i18nT('folder.loadingImage')}</div>
  const width = Number(manifest && manifest.w) || 3
  const height = Number(manifest && manifest.h) || 4
  const ratio = width / height
  const frameWidth = Math.max(1, Math.min(1400, viewport.w * 0.94, viewport.h * 0.88 * ratio))
  const baseThumb = appendShareCredential(`/api/shared-media?path=${encodeURIComponent(node.path)}&kind=thumb`, shareToken)
  const thumbUrl = attempt ? `${baseThumb}&r=${attempt}` : baseThumb

  // PLUS DE FLOU (2026-07-13, demande Matthieu — même décision que QuickLookOverlay.jsx) : la vignette 1080p s'affiche nette en
  // simple fondu, le plein format se superpose en douceur quand il est prêt. Un SPINNER n'apparaît que si la vignette tarde
  // (il vaut mieux un cadre qui dit « ça charge » qu'un cadre gris muet), et un échec définitif propose de réessayer.
  // CENTRAGE HORIZONTAL (corrigé le 2026-07-31) : le cadre porte une largeur EXPLICITE et `margin auto` le centre ; passer le
  // parent en flex recentrerait aussi le lecteur vidéo, qui lui veut la pleine largeur.
  return <div style={{ position: 'relative', width: frameWidth, maxWidth: '100%', marginInline: 'auto', aspectRatio: `${width} / ${height}`, overflow: 'hidden', borderRadius: 14, background: 'rgba(0,0,0,0.30)', boxShadow: '0 18px 60px rgba(0,0,0,0.28)' }}>
    {thumb !== 'failed' && <img key={attempt} src={thumbUrl} alt="" fetchPriority="high" onLoad={() => setThumb('ready')} onError={() => setThumb('failed')}
      style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', objectFit: 'contain', opacity: thumbReady ? 1 : 0, transition: 'opacity 160ms ease' }} />}
    {fullSrc && <img src={fullSrc} alt="" decoding="async"
      style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', objectFit: 'contain', animation: `zrQlFadeIn ${QUICKLOOK_ANIM_MS}ms ease both` }} />}
    {thumb === 'loading' && <div role="status" aria-label="Chargement" style={{ position: 'absolute', inset: 0, display: 'grid', placeItems: 'center', color: '#fff' }}><SpinnerApple taille={26} couleur="#fff" titre="Chargement de l’image" /></div>}
    {thumb === 'failed' && attempt >= THUMB_RETRIES && (
      <div style={{ position: 'absolute', inset: 0, display: 'grid', placeItems: 'center', textAlign: 'center', color: '#fff', padding: 20 }}>
        <div><div style={{ opacity: 0.85, marginBottom: 12 }}>Image indisponible pour le moment.</div>
          <button onClick={(e) => { e.stopPropagation(); setAttempt(0); setThumb('loading') }} style={{ border: 'none', borderRadius: 9, padding: '7px 16px', background: 'rgba(255,255,255,0.2)', color: '#fff', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)' }}>Réessayer</button></div>
      </div>
    )}
  </div>
}
