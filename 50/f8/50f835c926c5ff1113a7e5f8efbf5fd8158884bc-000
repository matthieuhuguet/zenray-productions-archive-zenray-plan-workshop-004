})

// 15 October 2026: the Studio entry shows the whole ZenRay Motion Design app from the Mac (port 3104), or names its absence.
describe('Motion Design · Studio', () => {
  const tr = (k) => k
  it('shows the application of the Mac in a frame when it answers', async () => {
    render(<MotionStudio tr={tr} probe={async () => true} />)
    const frame = await screen.findByTestId('motion-studio')
    expect(frame.getAttribute('src')).toBe('http://127.0.0.1:3104/')
    expect(frame.getAttribute('allow')).toContain('local-network-access')
  })
  it('RED names the absence of the app instead of an empty frame', async () => {
    render(<MotionStudio tr={tr} probe={async () => false} />)
    expect(await screen.findByTestId('motion-studio-away')).toBeTruthy()
    expect(screen.queryByTestId('motion-studio')).toBeNull()
  })
  it('the view opens on Studio by default', async () => {
    localStorage.removeItem('zrmd:view:v1')
    render(<MotionDesignView t={t} reader={async () => CATALOGUE} bridgeFactory={awayBridge} />)
    expect(screen.getByTestId('motion-rail-studio').className).toContain('is-on')
  })
  it('the probe reads the embed status and treats a refusal or a network error as away', async () => {
    expect(await probeStudio(async () => ({ json: async () => ({ ok: true }) }))).toBe(true)
    expect(await probeStudio(async () => { throw new TypeError('Failed to fetch') })).toBe(false)
    expect(await probeStudio(async () => ({ json: async () => { throw new Error('empty') } }))).toBe(false)
  })
})
