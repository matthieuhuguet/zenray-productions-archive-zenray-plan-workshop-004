  schemaVersion: 1, kind: 'zenray-motion-catalogue', motionCount: 2, motions: [
    { id: 'zrmd-0001', title: 'Caption scale-settle', zmotion: 'z1', tags: ['caption'], aspects: ['16x9'], status: 'iterating', versionCount: 2,
      latest: { version: 'V_002', media: 'media-v2', poster: POSTER, durationSec: 1.35, fidelity: { overall: 0.9572, weakest: 'animation' } } },
    { id: 'zrmd-0002', title: 'Orb ignition', zmotion: 'z2', tags: ['orb'], aspects: ['16x9'], status: 'validated', versionCount: 1,
      latest: { version: 'V_001', media: 'media-o1', poster: POSTER, durationSec: 68.05, fidelity: { overall: 0.993 } } },
  ],
}
const ZMOTION = {
  kind: 'zenray-motion', id: 'zrmd-0001', localId: 'onekey-s02-caption-shine', title: 'Caption scale-settle',
  parameters: { layout: [{ key: 'layers.@caption.font.size', label: 'Taille du texte', kind: 'number', min: 24, max: 240, step: 0.1, value: 91.8 }],
    colour: [{ key: 'layers.@bg.color', label: 'Fond', kind: 'color', value: '#000000' }] },
  versions: [
    { version: 'V_001', state: 'published', fidelity: { overall: 0.91 }, renders: [{ media: 'media-v1', poster: POSTER, durationSec: 1.35 }] },
    { version: 'V_002', parent: 'V_001', state: 'published', note: 'pass 2', fidelity: { overall: 0.9572 }, renders: [{ media: 'media-v2', poster: POSTER, durationSec: 1.35 }] },
  ],
}
const MANIFEST = { type: 'hls', master: 'm.m3u8', poster: POSTER }
const t = { textPrimary: '#111', textSecondary: '#666', border: '#ddd', surface: '#fff' }
const awayBridge = () => {
  const away = async () => { const e = new Error('away'); e.code = 'bridge-unavailable'; throw e }
  return { status: vi.fn(away), catalogue: vi.fn(away), jobs: vi.fn(away), motion: vi.fn(away), iterate: vi.fn(away), job: vi.fn(away) }
}

// 15 October 2026: the view now opens on Studio; the gallery cases below start from Home explicitly.
beforeEach(() => { localStorage.clear(); localStorage.setItem('zr:lang', 'fr'); localStorage.setItem('zrmd:view:v1', 'home'); window.history.replaceState(null, '', '/') })
afterEach(cleanup)

describe('MotionDesignView', () => {
  it('renders the gallery from ONE catalogue read and filters by chip', async () => {
    const reader = vi.fn(async (path) => (path.endsWith('catalogue.json') ? CATALOGUE : null))
    render(<MotionDesignView t={t} reader={reader} bridgeFactory={awayBridge} />)
    expect(await screen.findByTestId('motion-card-zrmd-0001')).toBeInTheDocument()
    expect(screen.getByTestId('motion-card-zrmd-0002')).toBeInTheDocument()
    expect(reader.mock.calls.filter(([p]) => p.endsWith('catalogue.json')).length).toBe(1)
    expect(reader).toHaveBeenCalledTimes(1)
    const card = screen.getByTestId('motion-card-zrmd-0001')
    expect(within(card).getByText('V_002')).toBeInTheDocument()
    expect(within(card).getByText('0:01')).toHaveClass('zrm-num')
    expect(within(card).getByText('95,7 %')).toHaveClass('zrm-num')
    expect(within(card).getByText('Caption scale-settle')).toHaveClass('zrm-title')
    fireEvent.click(screen.getByTestId('motion-chip-validated'))
    expect(screen.queryByTestId('motion-card-zrmd-0001')).not.toBeInTheDocument()
    expect(screen.getByTestId('motion-chip-validated')).toHaveClass('is-on')
    await waitFor(() => expect(screen.getByTestId('motion-bridge-state').textContent).toMatch(/ne répond pas/))
  })

  it('names the empty, unreadable and transient states, and keeps the last catalogue on a transient failure', async () => {
    const empty = render(<MotionDesignView t={t} reader={vi.fn(async () => null)} bridgeFactory={awayBridge} />)
    expect(await screen.findByTestId('motion-empty')).toBeInTheDocument()
    empty.unmount()
    const bad = render(<MotionDesignView t={t} reader={vi.fn(async () => ({ kind: 'other' }))} bridgeFactory={awayBridge} />)
    expect(await screen.findByTestId('motion-unreadable')).toBeInTheDocument()
    bad.unmount()
    const failing = render(<MotionDesignView t={t} reader={vi.fn(async () => { throw new Error('lecture 503') })} bridgeFactory={awayBridge} />)
    expect(await screen.findByTestId('motion-error')).toBeInTheDocument()
    expect(screen.queryByTestId('motion-empty')).not.toBeInTheDocument()
    failing.unmount()
    localStorage.setItem('zrmd:catalogue:v1', JSON.stringify(CATALOGUE))
    render(<MotionDesignView t={t} reader={vi.fn(async () => { throw new Error('lecture 503') })} bridgeFactory={awayBridge} />)
    expect(await screen.findByTestId('motion-card-zrmd-0002')).toBeInTheDocument()
  })

  it('opens a motion page with its versions and the published player', async () => {
    const reader = vi.fn(async (path) => (path.endsWith('catalogue.json') ? CATALOGUE : path === 'z1' ? ZMOTION : path.startsWith('media-') ? MANIFEST : null))
    render(<MotionDesignView t={t} reader={reader} bridgeFactory={awayBridge} />)
    fireEvent.click(await screen.findByTestId('motion-card-zrmd-0001'))
    expect(await screen.findByTestId('motion-version-V_001')).toBeInTheDocument()
    expect(screen.getByTestId('motion-version-V_002')).toHaveClass('is-on')
    expect(await screen.findByTestId('video-player')).toHaveTextContent('media-v2')
    fireEvent.click(screen.getByTestId('motion-version-V_001'))
    await waitFor(() => expect(screen.getByTestId('video-player')).toHaveTextContent('media-v1'))
  })

  it('shows the Mac-only views as away when the service does not answer', async () => {
    render(<MotionDesignView t={t} reader={vi.fn(async () => CATALOGUE)} bridgeFactory={awayBridge} />)
    fireEvent.click(screen.getByTestId('motion-rail-montage'))
    expect(await screen.findByTestId('motion-montage-away')).toBeInTheDocument()
    fireEvent.click(screen.getByTestId('motion-rail-local'))
    expect(await screen.findByTestId('motion-away')).toBeInTheDocument()
  })

  it('lists the local catalogue when the Mac answers', async () => {
    const bridge = {
      status: vi.fn(async () => ({ ok: true })),
      cataloguePage: vi.fn(async () => ({ catalog: { schema: 'zrmd/catalog@1', hasMore: false, total: 1, motions: [{ id: 'local-one', title: 'Local one', latest: 'V_003', versions: ['V_001', 'V_002', 'V_003'], score: 0.97, duration: 2, posterUrl: 'http://127.0.0.1:3102/p' }] } })),
      jobs: vi.fn(async () => ({ jobs: [] })),
    }
    render(<MotionDesignView t={t} reader={vi.fn(async () => CATALOGUE)} bridgeFactory={() => bridge} />)
    await waitFor(() => expect(screen.getByTestId('motion-bridge-state').textContent).toContain('3102'))
    fireEvent.click(screen.getByTestId('motion-rail-local'))
    expect(await screen.findByTestId('motion-card-local-one')).toBeInTheDocument()
  })
})

describe('progressive catalogue (14 October 2026)', () => {
  const row = (n) => ({ id: `local-${n}`, title: `Local ${n}`, latest: 'V_001', versions: ['V_001'], score: 0.9, duration: 2 })
  const deferred = () => { let resolve, reject; const promise = new Promise((a, b) => { resolve = a; reject = b }); return { promise, resolve, reject } }
  const upBridge = (cataloguePage) => ({ status: vi.fn(async () => ({ ok: true })), cataloguePage, jobs: vi.fn(async () => ({ jobs: [] })) })
  const openLocal = async (bridge) => {
    render(<MotionDesignView t={t} reader={vi.fn(async () => CATALOGUE)} bridgeFactory={() => bridge} />)
    await waitFor(() => expect(screen.getByTestId('motion-bridge-state').textContent).toContain('3102'))
    fireEvent.click(screen.getByTestId('motion-rail-local'))
  }

  it('shows the first page at once and appends the next one when it arrives', async () => {
    const second = deferred()
    const cataloguePage = vi.fn(async ({ offset }) => (offset === 0
      ? { catalog: { schema: 'zrmd/catalog@1', total: 2, hasMore: true, motions: [row(1)] } }
      : second.promise))
    await openLocal(upBridge(cataloguePage))
    expect(await screen.findByTestId('motion-card-local-1')).toBeInTheDocument()
    expect(screen.queryByTestId('motion-card-local-2')).not.toBeInTheDocument()
    expect((await screen.findAllByTestId('motion-skeleton')).length).toBeGreaterThan(0)
    expect(screen.getByTestId('motion-count').textContent).toMatch(/1.*2/)
    second.resolve({ catalog: { schema: 'zrmd/catalog@1', total: 2, hasMore: false, motions: [row(2)] } })
    expect(await screen.findByTestId('motion-card-local-2')).toBeInTheDocument()
    await waitFor(() => expect(screen.queryByTestId('motion-skeleton')).not.toBeInTheDocument())
    expect(cataloguePage.mock.calls.map((c) => c[0].offset)).toEqual([0, 1])
  })

  it('RED: a failing page is a named error with a retry, never "Loading" for ever', async () => {
    let fail = true
    const cataloguePage = vi.fn(async () => {
      if (fail) throw new Error('timeout')
      return { catalog: { schema: 'zrmd/catalog@1', total: 1, hasMore: false, motions: [row(1)] } }
    })
    await openLocal(upBridge(cataloguePage))
    expect(await screen.findByTestId('motion-error')).toBeInTheDocument()
    expect(screen.queryByTestId('motion-loading')).not.toBeInTheDocument()
    fail = false
    fireEvent.click(screen.getByTestId('motion-retry'))
    expect(await screen.findByTestId('motion-card-local-1')).toBeInTheDocument()
  })

  it('keeps the cards already loaded when a later page fails and says so', async () => {
    const cataloguePage = vi.fn(async ({ offset }) => {
      if (offset > 0) throw new Error('timeout')
      return { catalog: { schema: 'zrmd/catalog@1', total: 3, hasMore: true, motions: [row(1)] } }
    })
    await openLocal(upBridge(cataloguePage))
    expect(await screen.findByTestId('motion-card-local-1')).toBeInTheDocument()
    expect(await screen.findByTestId('motion-partial')).toBeInTheDocument()
    expect(screen.getByTestId('motion-retry')).toBeInTheDocument()
  })

  it('draws cards by windows and reveals more on demand', async () => {
    class NeverVisible { observe() {} disconnect() {} }
    vi.stubGlobal('IntersectionObserver', NeverVisible)
    const many = { schemaVersion: 1, kind: 'zenray-motion-catalogue', motionCount: 60, motions: Array.from({ length: 60 }, (_, i) => (
      { id: `m-${String(i).padStart(2, '0')}`, title: `M ${i}`, zmotion: `z${i}`, tags: [], aspects: ['16x9'], status: 'iterating', versionCount: 1, latest: { version: 'V_001', durationSec: 2 } })) }
    render(<MotionDesignView t={t} reader={vi.fn(async () => many)} bridgeFactory={awayBridge} />)
    await screen.findByTestId('motion-card-m-00')
    expect(screen.getByTestId('motion-grid').querySelectorAll('[data-testid^="motion-card-"]').length).toBe(24)
    fireEvent.click(screen.getByTestId('motion-more'))
    await waitFor(() => expect(screen.getByTestId('motion-grid').querySelectorAll('[data-testid^="motion-card-"]').length).toBe(48))
    fireEvent.click(screen.getByTestId('motion-more'))
    await waitFor(() => expect(screen.getByTestId('motion-grid').querySelectorAll('[data-testid^="motion-card-"]').length).toBe(60))
    expect(screen.queryByTestId('motion-more')).not.toBeInTheDocument()
    vi.unstubAllGlobals()
  })
})


describe('MotionIterationPanel', () => {
  const tr = (k) => k
  const params = ZMOTION.parameters
  it('prefills the sliders and sends only the changed values', async () => {
    const send = vi.fn(async (payload) => ({ via: 'queue', id: 'req-20261012-101500-abcdef', payload }))
    render(<MotionIterationPanel motionId="onekey-s02-caption-shine" baseVersion="V_002" parameters={params} bridge={null} tr={tr} send={send} />)
    const size = screen.getByLabelText('Taille du texte')
    expect(size).toHaveValue('91.8')
    fireEvent.click(screen.getByTestId('motion-send'))
    expect(await screen.findByText('Aucun réglage modifié.')).toBeInTheDocument()
    expect(send).not.toHaveBeenCalled()
    fireEvent.change(size, { target: { value: '120' } })
    fireEvent.click(screen.getByTestId('motion-send'))
    await waitFor(() => expect(send).toHaveBeenCalledTimes(1))
    expect(send.mock.calls[0][0]).toEqual({ mode: 'params', motionId: 'onekey-s02-caption-shine', baseVersion: 'V_002', overrides: { 'layers.@caption.font.size': 120 } })
    expect(await screen.findByText(/motion.iter.viaQueue/)).toBeInTheDocument()
  })

  it('follows a bridge job to its new version', async () => {
    const bridge = { job: vi.fn(async () => ({ job: { id: 'j1', state: 'done', result: { version: 'V_003' }, steps: [{ name: 'render' }] } })) }
    const send = vi.fn(async () => ({ via: 'bridge', job: { id: 'j1', state: 'running', steps: [] } }))
    const onVersion = vi.fn()
    render(<MotionIterationPanel motionId="m" baseVersion="V_002" parameters={params} bridge={bridge} tr={tr} send={send} onVersion={onVersion} />)
    fireEvent.click(screen.getByTestId('motion-mode-format'))
    fireEvent.click(screen.getByTestId('motion-send'))
    await waitFor(() => expect(onVersion).toHaveBeenCalledWith('V_003'), { timeout: 4000 })
    expect(bridge.job).toHaveBeenCalledWith('j1')
    expect(send.mock.calls[0][0]).toMatchObject({ mode: 'format', formats: ['9x16'] })
    expect(screen.getByTestId('motion-iteration-state').textContent).toContain('V_003')
  })
})

