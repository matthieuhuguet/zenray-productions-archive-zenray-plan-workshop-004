    expect(spec).toEqual({ id: 'demo-ete-2026', formats: ['16x9'], fit: 'cover', clips: [{ kind: 'motion', motion: 'm1', version: 'V_002' }, { kind: 'file', path: '/Users/zenray/Movies/a.mp4' }] })
