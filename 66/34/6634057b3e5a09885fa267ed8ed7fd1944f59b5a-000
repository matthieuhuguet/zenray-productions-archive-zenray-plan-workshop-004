// 3 October 2026, 22:14 CEST: copy actions preserve exact paths and never select the surrounding file.
import React from 'react'
import { afterEach, expect, it, vi } from 'vitest'
import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
import FileLocations from './FileLocations.jsx'
afterEach(cleanup)
it('copies both exact paths and reflects deletion or disconnected state without claiming a missing backup', async () => {
  const writeText = vi.fn().mockResolvedValue(undefined)
  Object.defineProperty(navigator, 'clipboard', { configurable: true, value: { writeText } })
  const parentClick = vi.fn(), file = { name: 'ad.mov', localPath: '/Mac/Project/ad.mov', cloudPath: 'pages/ad.mov.file.json', present: true, status: 'backed-up' }
  const { rerender } = render(<div onClick={parentClick}><FileLocations file={file} connected /></div>)
  fireEvent.click(screen.getByRole('button', { name: 'Copier Mac' }))
  fireEvent.click(screen.getByRole('button', { name: 'Copier Cloud' }))
  await waitFor(() => expect(writeText.mock.calls).toEqual([['/Mac/Project/ad.mov'], ['pages/ad.mov.file.json']]))
  expect(parentClick).not.toHaveBeenCalled()
  rerender(<FileLocations file={{ ...file, present: false }} connected />)
  expect(screen.getByText('Absent de ce Mac')).toBeTruthy()
  expect(screen.getByText('Sauvegardé')).toBeTruthy()
  rerender(<FileLocations file={file} connected={false} />)
  expect(screen.getByText('Mac déconnecté, présence à vérifier')).toBeTruthy()
})
