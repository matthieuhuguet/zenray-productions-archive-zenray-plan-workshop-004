// 16 October 2026 14:25 Europe/Paris: explicit saving keeps the category draft on failed writes.
import { PERSONAL_CONFIG } from './japanesePersonalConfig.js'
import React, { useEffect, useState } from 'react'
export default function JapaneseLessonCategory({ recordId, annotation, busy, onSave }) {
  const [category,setCategory] = useState(annotation?.category || ''), [favorite,setFavorite] = useState(!!annotation?.favorite)
  useEffect(() => { setCategory(annotation?.category || ''); setFavorite(!!annotation?.favorite) }, [recordId,annotation?.revision])
  return <form onSubmit={event => { event.preventDefault(); onSave({action:'annotate',eventId:crypto.randomUUID(),recordId,category,favorite,expectedRevision:annotation?.revision || 0}) }}><fieldset disabled={busy}><label>Catégorie personnelle<input value={category} maxLength={PERSONAL_CONFIG.categoryLength} onChange={event=>setCategory(event.target.value)} placeholder="À revoir, conversation, voyage…" /></label><label><input type="checkbox" checked={favorite} onChange={event=>setFavorite(event.target.checked)} /> Favori</label><button disabled={busy}>Enregistrer le classement</button></fieldset></form>
}
