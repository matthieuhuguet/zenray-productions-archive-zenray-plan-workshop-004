// ZenRayMedia — L0 : les six contrats de données.
// Doc de référence : docs/zenraymedia/01-PLAN.md §5, docs/zenraymedia/04-WBS-COMPOSANTS.md L0.
//
// RÈGLE DURE (01-PLAN §5.5) : tout Job porte une `seed`. Aucun aléa non graine n'est autorisé
// dans le produit -- sinon deux rendus du même contenu diffèrent et le pipeline n'est plus
// réparable (risque R3 de 02-RISQUES). `Math.random()` est donc INTERDIT dans ce dossier :
// on passe toujours par `rng(seed)` ci-dessous.

export const REGISTERS = ['presse', 'créateur', 'institutionnel', 'luxe', 'technique', 'divertissement', 'pédagogique', 'promotionnel']
export const INTENTS = ['informer', 'convaincre', 'vendre', 'émouvoir', 'enseigner', 'annoncer', 'documenter']
export const BEAT_ROLES = ['hook', 'context', 'proof', 'demo', 'turn', 'payoff', 'cta']
export const BEAT_TEMPOS = ['still', 'calm', 'drive', 'snap']

export const ROLE_LABELS = {
  hook: 'Accroche', context: 'Contexte', proof: 'Preuve', demo: 'Démonstration',
  turn: 'Bascule', payoff: 'Chute', cta: 'Appel',
}

// --- Générateur déterministe (L0-10) -------------------------------------------------------
// mulberry32 : même graine -> même suite, sur toutes les machines. Utilisé pour le grain, les
// micro-décalages et tout choix "aléatoire" d'un thème.
export function rng(seed) {
  let a = (typeof seed === 'number' ? seed : hashString(String(seed ?? 'zenraymedia'))) >>> 0
  return function next() {
    a |= 0; a = (a + 0x6D2B79F5) | 0
    let t = Math.imul(a ^ (a >>> 15), 1 | a)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
}

export function hashString(str) {
  let h = 2166136261 >>> 0
  for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619) }
  return h >>> 0
}

// Identifiant stable et lisible, dérivé du contenu + d'un compteur fourni par l'appelant.
// Volontairement SANS Date.now() : un id ne doit pas dépendre de l'heure de fabrication.
export function makeId(prefix, seedText, counter = 0) {
  return `${prefix}-${hashString(`${seedText}#${counter}`).toString(36).padStart(7, '0')}`
}

// --- Helpers de validation ------------------------------------------------------------------
const isStr = (v) => typeof v === 'string'
const nonEmpty = (v) => isStr(v) && v.trim().length > 0
const isArr = Array.isArray

// Compte les phrases d'un texte. Sert la contrainte du message unique (WBS ZM-L2-02).
// Les abréviations courantes ne comptent pas comme fin de phrase.
export function sentenceCount(text) {
  if (!nonEmpty(text)) return 0
  const cleaned = String(text)
    .replace(/\b(M|Mme|Dr|etc|cf|ex|p|vs|Mr|St|n°|art)\./gi, '$1')
    .replace(/\d+\.\d+/g, '0')
  const parts = cleaned.split(/[.!?…]+(?:\s|$)/).map((s) => s.trim()).filter(Boolean)
  return parts.length
}

// --- 5.1 Brief --------------------------------------------------------------------------------
export function emptyBrief() {
  return {
    id: '', title: '', message: '', audience: '', register: 'créateur', intent: 'informer',
    evidence: [], constraints: { languages: ['fr'], maxDuration: null, mentions: [] }, sources: [],
  }
}

export function validateBrief(brief) {
  const errors = []
  if (!brief || typeof brief !== 'object') return [{ field: 'brief', code: 'shape', message: 'Brief absent.' }]
  if (!nonEmpty(brief.title)) errors.push({ field: 'title', code: 'required', message: 'Le titre de travail est obligatoire.' })
  if (!nonEmpty(brief.message)) errors.push({ field: 'message', code: 'required', message: 'Le message est obligatoire : une phrase, celle que le public doit retenir.' })
  // ZM-L2-02 : REFUS explicite, pas un avertissement.
  else if (sentenceCount(brief.message) > 1) errors.push({ field: 'message', code: 'single-sentence', message: `Le message doit tenir en UNE phrase (${sentenceCount(brief.message)} détectées). Choisis celle qui compte.` })
  if (!nonEmpty(brief.audience)) errors.push({ field: 'audience', code: 'required', message: 'Le public est obligatoire : à qui parles-tu, en clair ?' })
  if (!REGISTERS.includes(brief.register)) errors.push({ field: 'register', code: 'enum', message: 'Registre inconnu.' })
  if (!INTENTS.includes(brief.intent)) errors.push({ field: 'intent', code: 'enum', message: 'Intention inconnue.' })
  if (brief.evidence && !isArr(brief.evidence)) errors.push({ field: 'evidence', code: 'shape', message: 'Les preuves doivent former une liste.' })
  return errors
}

// --- 5.2 Cut ----------------------------------------------------------------------------------
export function validateCut(cut) {
  const errors = []
  if (!cut || typeof cut !== 'object') return [{ field: 'cut', code: 'shape', message: 'Cut absent.' }]
  if (!nonEmpty(cut.briefId)) errors.push({ field: 'briefId', code: 'required', message: 'Le cut doit référencer un brief.' })
  if (!isArr(cut.beats) || cut.beats.length === 0) {
    errors.push({ field: 'beats', code: 'required', message: 'Un cut contient au moins un beat.' })
    return errors
  }
  cut.beats.forEach((beat, i) => {
    if (!BEAT_ROLES.includes(beat?.role)) errors.push({ field: `beats[${i}].role`, code: 'enum', message: `Beat ${i + 1} : rôle manquant ou inconnu.` })
    if (!nonEmpty(beat?.text)) errors.push({ field: `beats[${i}].text`, code: 'required', message: `Beat ${i + 1} : texte vide.` })
    if (beat?.weight != null && (typeof beat.weight !== 'number' || beat.weight < 0 || beat.weight > 1)) errors.push({ field: `beats[${i}].weight`, code: 'range', message: `Beat ${i + 1} : le poids doit être compris entre 0 et 1.` })
    if (beat?.tempo && !BEAT_TEMPOS.includes(beat.tempo)) errors.push({ field: `beats[${i}].tempo`, code: 'enum', message: `Beat ${i + 1} : tempo inconnu.` })
    if (beat?.slots && !isArr(beat.slots)) errors.push({ field: `beats[${i}].slots`, code: 'shape', message: `Beat ${i + 1} : les emplacements doivent former une liste.` })
    if (isArr(beat?.slots) && beat.slots.length > 4) errors.push({ field: `beats[${i}].slots`, code: 'range', message: `Beat ${i + 1} : 4 emplacements média au maximum.` })
  })
  return errors
}

// --- 5.3 Theme --------------------------------------------------------------------------------
// Les 7 groupes de décisions (01-PLAN §10.2). `surface`, `palette`, `typography`, `grid` sont
// obligatoires ; `motion`, `chrome`, `sound` ont des valeurs par défaut (un thème d'article n'a
// pas besoin de mouvement ni de son pour être valide).
export const THEME_GROUPS = ['surface', 'palette', 'typography', 'grid', 'motion', 'chrome', 'sound']

export function validateTheme(theme) {
  const errors = []
  if (!theme || typeof theme !== 'object') return [{ field: 'theme', code: 'shape', message: 'Thème absent.' }]
  if (!/^T-\d{2}-\d-\d$/.test(theme.id || '')) errors.push({ field: 'id', code: 'format', message: 'Identifiant attendu : T-FF-S-V (ex. T-01-3-2).' })
  if (!nonEmpty(theme.name)) errors.push({ field: 'name', code: 'required', message: 'Le nom public du thème est obligatoire.' })
  for (const group of ['surface', 'palette', 'typography', 'grid']) {
    if (!theme[group] || typeof theme[group] !== 'object') errors.push({ field: group, code: 'required', message: `Groupe « ${group} » manquant.` })
  }
  if (theme.typography && !theme.typography.scale) errors.push({ field: 'typography.scale', code: 'required', message: 'Le thème doit poser son échelle typographique.' })
  if (!isArr(theme.formats) || theme.formats.length === 0) errors.push({ field: 'formats', code: 'required', message: 'Le thème doit déclarer au moins un format natif.' })
  // ZM-L4-16 : le calibrage est PRIVÉ. Un thème qui l'expose dans un champ public est refusé.
  const publicText = `${theme.name || ''} ${theme.description || ''}`.toLowerCase()
  const marks = ['bfm', 'carrefour', 'squeezie', 'playstation', 'weta', 'le monde', 'netflix', 'vogue', 'lidl']
  const leaked = marks.filter((m) => publicText.includes(m))
  if (leaked.length) errors.push({ field: 'name', code: 'trademark', message: `Marque déposée dans un champ public : ${leaked.join(', ')}. Le calibrage vit dans calibration.ref, jamais dans le nom.` })
  return errors
}

// --- 5.4 Format --------------------------------------------------------------------------------
export const FORMAT_KINDS = ['web', 'still', 'print', 'video', 'overlay']

export function validateFormat(format) {
  const errors = []
  if (!format || typeof format !== 'object') return [{ field: 'format', code: 'shape', message: 'Format absent.' }]
  if (!nonEmpty(format.id)) errors.push({ field: 'id', code: 'required', message: 'Identifiant de format manquant.' })
  if (!FORMAT_KINDS.includes(format.kind)) errors.push({ field: 'kind', code: 'enum', message: 'Type de format inconnu.' })
  const c = format.canvas
  // Une page web n'a PAS de hauteur : le contenu coule. `h:0` y est donc légal et volontaire.
  // Tout autre type de format (image, print, vidéo) doit poser ses deux dimensions.
  if (!c || !(c.w > 0)) errors.push({ field: 'canvas', code: 'required', message: 'Largeur de sortie manquante.' })
  else if (format.kind !== 'web' && !(c.h > 0)) errors.push({ field: 'canvas', code: 'required', message: `Hauteur de sortie manquante (obligatoire pour un format « ${format.kind} »).` })
  if (['video', 'overlay'].includes(format.kind) && !(format.time?.fps > 0)) errors.push({ field: 'time.fps', code: 'required', message: 'Un format temporel doit poser ses images par seconde.' })
  return errors
}

// --- 5.5 Job -----------------------------------------------------------------------------------
export function validateJob(job) {
  const errors = []
  if (!job || typeof job !== 'object') return [{ field: 'job', code: 'shape', message: 'Job absent.' }]
  if (!nonEmpty(job.cutId)) errors.push({ field: 'cutId', code: 'required', message: 'Job sans cut.' })
  if (!nonEmpty(job.themeId)) errors.push({ field: 'themeId', code: 'required', message: 'Job sans thème.' })
  if (!nonEmpty(job.formatId)) errors.push({ field: 'formatId', code: 'required', message: 'Job sans format.' })
  // RÈGLE DURE : pas de seed, pas de job. C'est ce qui rend un rendu rejouable.
  if (job.seed == null || job.seed === '') errors.push({ field: 'seed', code: 'required', message: 'Job sans graine : le rendu ne serait pas reproductible.' })
  return errors
}

// --- 5.6 Deliverable ----------------------------------------------------------------------------
export function validateDeliverable(deliverable) {
  const errors = []
  if (!deliverable || typeof deliverable !== 'object') return [{ field: 'deliverable', code: 'shape', message: 'Livrable absent.' }]
  if (!nonEmpty(deliverable.jobId)) errors.push({ field: 'jobId', code: 'required', message: 'Livrable orphelin.' })
  if (!(deliverable.bytes > 0)) errors.push({ field: 'bytes', code: 'required', message: 'Livrable vide.' })
  // Un livrable sans empreinte ni sonde est « non vérifié » : il ne peut pas être déclaré fini.
  if (!nonEmpty(deliverable.checksum)) errors.push({ field: 'checksum', code: 'required', message: 'Livrable sans empreinte : non vérifiable.' })
  if (!deliverable.probe) errors.push({ field: 'probe', code: 'required', message: 'Livrable sans sonde : non vérifié.' })
  return errors
}

// --- Document V3 (AUDIT T2) ---------------------------------------------------------------------
// Le contrat que 03-CODE-ARCHITECTURE-DONNEES.md recommande explicitement pour remplacer les cinq
// états actuellement globaux (chemin Create, SHA, thème, format, reçu) que changer de projet ne
// restaurait pas — le défaut déjà fermé par l'audit P0-T6/R8 plus tôt dans cette même session,
// formalisé ici comme contrat plutôt que laissé comme correctif ponctuel. DÉFINITION DE FORME
// SEULEMENT : le moteur de migration (R3) et l'autosauvegarde (R2) restent des cartes distinctes
// de ce même backlog, construites PAR-DESSUS cette forme, jamais mélangées ici.
export const DOCUMENT_SCHEMA_VERSION = 3

export function validateDocument(doc) {
  const errors = []
  if (!doc || typeof doc !== 'object') return [{ field: 'document', code: 'shape', message: 'Document absent.' }]
  if (!nonEmpty(doc.documentId)) errors.push({ field: 'documentId', code: 'required', message: 'Un document a besoin d’une identité STABLE, distincte de son chemin Create — celui-ci peut changer (renommage, déplacement), l’identité jamais.' })
  if (!Number.isInteger(doc.schemaVersion) || doc.schemaVersion < 1) errors.push({ field: 'schemaVersion', code: 'required', message: 'Version de schéma manquante ou invalide.' })
  if (!nonEmpty(doc.revisionId)) errors.push({ field: 'revisionId', code: 'required', message: 'Chaque sauvegarde a besoin de son propre identifiant de révision.' })
  if (doc.baseRevisionId != null && !isStr(doc.baseRevisionId)) errors.push({ field: 'baseRevisionId', code: 'shape', message: 'baseRevisionId doit être une chaîne, ou rester absent pour la toute première révision.' })
  if (!nonEmpty(doc.savedHash)) errors.push({ field: 'savedHash', code: 'required', message: 'Un document a besoin de l’empreinte de son dernier état ENREGISTRÉ, pour distinguer clean et dirty sans recalculer tout l’historique.' })
  // L'association Create appartient au DOCUMENT, jamais à un état global de la vue — sans quoi
  // ⌘S peut écrire le chemin du projet A avec le SHA du projet A sous la composition du projet B.
  if (doc.createPath != null && !isStr(doc.createPath)) errors.push({ field: 'createPath', code: 'shape', message: 'createPath doit être une chaîne, ou rester absent pour un document jamais enregistré dans Create.' })
  if (doc.createPath && !nonEmpty(doc.createSha)) errors.push({ field: 'createSha', code: 'required', message: 'Un document associé à un chemin Create doit porter le SHA de base correspondant.' })
  if (doc.publicationIds != null && !isArr(doc.publicationIds)) errors.push({ field: 'publicationIds', code: 'shape', message: 'publicationIds doit être une liste de références vers des objets Publication (5.10 ci-dessous), jamais des reçus dupliqués sur place.' })
  return errors
}

// --- Theme Package (AUDIT T2) ---------------------------------------------------------------------
// `validateTheme` (5.3 ci-dessus) valide la structure VISUELLE d'un thème (palette, typographie,
// grille…). Celui-ci valide autre chose : son EMPAQUETAGE en unité distribuable — le défaut nommé
// par l'audit (07-TRACEABILITE.md) : « le paquet de thème n'a pas une source unique », aujourd'hui
// éclaté entre le registre par nom, le header HTML, theme.json, le registre de composants et des
// tokens tapés à la main à plusieurs endroits différents.
export function validateThemePackage(pkg) {
  const errors = []
  if (!pkg || typeof pkg !== 'object') return [{ field: 'themePackage', code: 'shape', message: 'Paquet de thème absent.' }]
  if (!/^T-\d{2}-\d-\d$/.test(pkg.id || '')) errors.push({ field: 'id', code: 'format', message: 'Identifiant attendu : T-FF-S-V (ex. T-01-3-2), le même que le thème qu’il empaquette.' })
  if (!nonEmpty(pkg.packageVersion)) errors.push({ field: 'packageVersion', code: 'required', message: 'Version du PAQUET, distincte de la version du thème lui-même : un même thème peut être republié en paquet sans changer de contenu visuel.' })
  if (!isArr(pkg.pieces)) errors.push({ field: 'pieces', code: 'required', message: 'La liste des pièces (composants Lego) du paquet est obligatoire, même vide.' })
  if (!pkg.props || typeof pkg.props !== 'object') errors.push({ field: 'props', code: 'required', message: 'Le registre de props déclarées manque : sans lui, l’inspecteur ne peut pas savoir quels champs éditer ni avec quel contrôle.' })
  if (!isArr(pkg.assets)) errors.push({ field: 'assets', code: 'required', message: 'La liste des actifs (images, médias) référencés par le paquet est obligatoire, même vide.' })
  if (!isArr(pkg.fonts) || pkg.fonts.length === 0) errors.push({ field: 'fonts', code: 'required', message: 'Un paquet de thème déclare au moins une police.' })
  if (!nonEmpty(pkg.license)) errors.push({ field: 'license', code: 'required', message: 'Droits d’usage manquants : sans eux, impossible de savoir si le paquet peut être distribué ou seulement gardé en interne.' })
  if (!isArr(pkg.compatibleFormats) || pkg.compatibleFormats.length === 0) errors.push({ field: 'compatibleFormats', code: 'required', message: 'La liste des formats compatibles est obligatoire : c’est elle qui évite de proposer un thème vidéo sur un format impression.' })
  return errors
}

// --- Artifact (AUDIT T2) ---------------------------------------------------------------------
// Un artefact est un FICHIER PRODUIT (export PNG/PDF/HTML/ZIP), jamais la composition éditable
// elle-même — `Deliverable` (5.6 ci-dessus) porte déjà poids et empreinte pour un export SIMPLE,
// mais aucune provenance : impossible de dire QUEL Job, donc QUEL thème et QUEL format précis, a
// produit CE fichier retrouvé plus tard.
export const ARTIFACT_KINDS = ['html', 'png', 'pdf', 'zip']

export function validateArtifact(artifact) {
  const errors = []
  if (!artifact || typeof artifact !== 'object') return [{ field: 'artifact', code: 'shape', message: 'Artefact absent.' }]
  if (!ARTIFACT_KINDS.includes(artifact.kind)) errors.push({ field: 'kind', code: 'enum', message: 'Type d’artefact inconnu.' })
  if (!nonEmpty(artifact.checksum)) errors.push({ field: 'checksum', code: 'required', message: 'Artefact sans empreinte : non vérifiable.' })
  if (!(artifact.bytes > 0)) errors.push({ field: 'bytes', code: 'required', message: 'Artefact vide.' })
  if (['png', 'pdf'].includes(artifact.kind) && (!(artifact.width > 0) || !(artifact.height > 0))) errors.push({ field: 'dimensions', code: 'required', message: `Un artefact « ${artifact.kind} » doit porter ses dimensions réelles, mesurées, jamais celles du format visé.` })
  if (artifact.transparent != null && typeof artifact.transparent !== 'boolean') errors.push({ field: 'transparent', code: 'shape', message: 'transparent doit être un booléen.' })
  if (!nonEmpty(artifact.jobId)) errors.push({ field: 'jobId', code: 'required', message: 'Artefact sans provenance : impossible de savoir quel Job (donc quel Cut, quel thème, quelle graine) l’a produit.' })
  if (artifact.qa != null && typeof artifact.qa !== 'object') errors.push({ field: 'qa', code: 'shape', message: 'Le résultat de contrôle qualité doit être un objet, ou rester absent tant qu’aucun contrôle n’a eu lieu.' })
  return errors
}

// --- Publication (AUDIT T2) ---------------------------------------------------------------------
// Un objet PERSISTANT, distinct du GESTE de publier — c'est lui que la future galerie listera,
// jamais les seuls fichiers `.zmedia.json`. Les six états viennent mot pour mot de la porte de
// l'audit pour la carte V6 : « brouillon, prêt, exporté, remis, publié et échoué survivent au
// redémarrage ».
export const PUBLICATION_STATUSES = ['brouillon', 'prêt', 'exporté', 'remis', 'publié', 'échoué']

export function validatePublication(pub) {
  const errors = []
  if (!pub || typeof pub !== 'object') return [{ field: 'publication', code: 'shape', message: 'Publication absente.' }]
  if (!nonEmpty(pub.id)) errors.push({ field: 'id', code: 'required', message: 'Identifiant de publication manquant.' })
  if (!nonEmpty(pub.documentId)) errors.push({ field: 'documentId', code: 'required', message: 'Une publication référence le document qui l’a produite.' })
  if (!nonEmpty(pub.channel)) errors.push({ field: 'channel', code: 'required', message: 'Destination manquante (ex. « create », « instagram », « linkedin »).' })
  if (!PUBLICATION_STATUSES.includes(pub.status)) errors.push({ field: 'status', code: 'enum', message: 'Statut de publication inconnu.' })
  if (!isArr(pub.artifactIds)) errors.push({ field: 'artifactIds', code: 'required', message: 'La liste des artefacts remis est obligatoire, même vide tant que rien n’est encore remis.' })
  if (pub.status !== 'brouillon' && !(pub.attempts > 0)) errors.push({ field: 'attempts', code: 'required', message: 'Une publication qui a dépassé l’état brouillon porte nécessairement au moins UNE tentative.' })
  if (pub.status === 'échoué' && !nonEmpty(pub.error)) errors.push({ field: 'error', code: 'required', message: 'Une publication échouée doit porter le message d’erreur réel, jamais un échec silencieux.' })
  if (pub.status === 'publié' && !nonEmpty(pub.receiptUrl)) errors.push({ field: 'receiptUrl', code: 'required', message: 'Une publication réussie doit porter l’adresse du reçu distant.' })
  return errors
}

// --- L0-07 : validateur unique ---------------------------------------------------------------
// Un SEUL point d'entrée. Aucune validation ne doit être dupliquée ailleurs dans le produit.
const VALIDATORS = {
  brief: validateBrief, cut: validateCut, theme: validateTheme,
  format: validateFormat, job: validateJob, deliverable: validateDeliverable,
  document: validateDocument, themePackage: validateThemePackage,
  artifact: validateArtifact, publication: validatePublication,
}

export function validate(kind, value) {
  const fn = VALIDATORS[kind]
  if (!fn) throw new Error(`validate: contrat inconnu « ${kind} »`)
  return fn(value)
}

export function isValid(kind, value) { return validate(kind, value).length === 0 }

// Empreinte de contenu, pour les livrables produits côté navigateur (pas de crypto asynchrone
// nécessaire, on veut une signature stable et rapide, pas une garantie cryptographique).
export function checksumOf(text) {
  const s = String(text)
  return `zrm1-${hashString(s).toString(16)}-${s.length.toString(16)}`
}
