// Repointe les refs des posters fraîchement remplis (Scripts/_fill/_map.json) vers zenray-shelf-img @SHA (jsDelivr).
// Ne touche QUE les items encore image:null (idempotent, ne réécrit pas les 672 déjà pointés sur l'ancien SHA).
import { readFile, writeFile } from 'node:fs/promises'
const ROOT = new URL('../public/shelf/', import.meta.url)
const SHA = process.env.SHA
if (!SHA) { console.error('SHA manquant'); process.exit(1) }
const map = JSON.parse(await readFile(new URL('./_fill/_map.json', import.meta.url), 'utf8'))
const base = `https://cdn.jsdelivr.net/gh/matthieuhuguet/zenray-shelf-img@${SHA}`
for (const file of ['games.json', 'anime-manga.json', 'movies.json']) {
  const path = new URL(file, ROOT); const data = JSON.parse(await readFile(path, 'utf8'))
  let n = 0
  for (const it of data.items) { const e = map[it.id]; if (e && !it.image) { it.image = { kind: 'url', ref: `${base}/${e.file}` }; n++ } }
  await writeFile(path, JSON.stringify(data, null, 2)); console.log(`${file}: ${n} repointés`)
}
