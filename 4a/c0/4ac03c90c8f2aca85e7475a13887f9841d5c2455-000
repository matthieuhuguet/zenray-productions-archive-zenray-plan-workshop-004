// 21 October 2026: remember which manifests the search index already holds, so an unchanged one costs no index run.
// FR : mémoriser les manifestes déjà présents dans l'index de recherche, pour qu'un manifeste inchangé ne coûte aucune exécution.
//
// Measured 21 October 2026: a pass that re-archived two edited notes (same manifest paths as before) still spent 14 to 34 s reading and
// decrypting the 37 MB public delta just to find out that nothing was new. An entry is the path AND the file's SHA-256, so a file whose
// content changed (a new thumbnail, say) is indexed again. The ledger fails open: if it cannot be read, everything is simply re-indexed.
import { createHash } from 'node:crypto'
import { appendFile, readFile, rm } from 'node:fs/promises'

export function createIndexLedger(filePath) {
  let known = null
  const key = (manifestPath, sha256) => createHash('sha1').update(`${manifestPath}\0${sha256 || ''}`).digest('hex').slice(0, 16)
  const load = async () => {
    if (known) return known
    known = new Set()
    try { for (const line of (await readFile(filePath, 'utf8')).split('\n')) if (/^[0-9a-f]{16}$/.test(line)) known.add(line) }
    catch { /* unreadable or absent: behave as empty, the cost is only a re-index */ }
    return known
  }
  return {
    key,
    async missing(entries) {
      const set = await load()
      return entries.filter((entry) => !set.has(key(entry.path, entry.sha256)))
    },
    async record(entries) {
      const set = await load()
      const fresh = [...new Set(entries.map((entry) => key(entry.path, entry.sha256)))].filter((value) => !set.has(value))
      if (!fresh.length) return 0
      try { await appendFile(filePath, `${fresh.join('\n')}\n`, { mode: 0o600 }) } catch { return 0 }
      for (const value of fresh) set.add(value)
      return fresh.length
    },
    // To call whenever the index repository is rebuilt or recreated: its contents no longer back the ledger.
    async forget() { known = new Set(); await rm(filePath, { force: true }) },
  }
}
