#!/usr/bin/env node
// ZenRayMedia — BOUCLE DE COMPARAISON : rendu contre source, côte à côte.
//
//   node scripts/zrm-compare.mjs <composant.html> --sel .zrm-wheel \
//     --ref <capture.jpg> --rect x,y,w,h --out compare.png
//
//   node scripts/zrm-compare.mjs --spec <theme>/compare.json     # tous les composants d'un coup
//
// POURQUOI CE FICHIER EXISTE
// --------------------------
// Reproche de Matthieu, 2026-07-25 : « tu as juste à refaire une boucle derrière, tu compares
// ton output HTML, tu fais une capture, tu recompares avec le fichier d'origine. C'est pas
// difficile. » Il a raison sur les deux points — c'est simple, et je ne le faisais pas.
//
// J'écrivais un composant en regardant la capture, puis je le déclarais fait sans jamais poser
// les deux images l'une à côté de l'autre. Toutes les erreurs qui ont suivi viennent de là : des
// biseaux deux fois trop grands, des crochets trop écartés, une barre trop haute. Chacune saute
// aux yeux en comparaison et reste invisible de mémoire. On ne juge pas une ressemblance en
// alternant deux images à trente secondes d'intervalle — la mémoire visuelle ne tient pas.
//
// CE QUE FAIT LA BOUCLE
//   1. rend le composant dans un navigateur, sur le fond du thème ;
//   2. capture l'élément désigné ;
//   3. découpe la zone correspondante dans la capture d'origine ;
//   4. met les deux À LA MÊME LARGEUR et les empile — côte à côte pour la vue d'ensemble,
//      superposés en fondu pour les écarts de position ;
//   5. écrit une planche unique, à ouvrir et à regarder AVANT de déclarer un composant fait.
//
// La superposition en fondu est ce qui fait le travail : deux images côte à côte laissent croire
// qu'elles se ressemblent, deux images superposées montrent immédiatement le décalage.

import { readFile, writeFile, mkdir } from 'node:fs/promises'
import { existsSync } from 'node:fs'
import path from 'node:path'
import { chromium } from 'playwright'

async function dataUrl(file) {
  const buf = await readFile(file)
  const ext = path.extname(file).slice(1).toLowerCase().replace('jpg', 'jpeg')
  return `data:image/${ext};base64,${buf.toString('base64')}`
}

async function renderOne(page, { html, selector, width, height }) {
  await page.setViewportSize({ width: width || 1400, height: height || 900 })
  await page.goto('file://' + path.resolve(html))
  // Les polices sont embarquées en base64 : elles sont prêtes dès le chargement, mais les filtres
  // et les dégradés radiaux demandent une frame de plus. Sans cette attente, la capture montre un
  // composant sans ses halos — et on corrige un défaut qui n'existe pas.
  await page.waitForTimeout(500)
  const el = selector ? await page.$(selector) : null
  const shot = el ? await el.screenshot() : await page.screenshot()
  return 'data:image/png;base64,' + shot.toString('base64')
}

function sheet(pairs) {
  const blocks = pairs.map((p, i) => `
  <section>
    <h2><span class="n">${i + 1}</span>${p.name}
      <code>${p.ref} ${p.rect ? p.rect.join(',') : ''}</code></h2>

    <div class="row">
      <figure><figcaption>source</figcaption><img src="${p.refUrl}"></figure>
      <figure><figcaption>rendu</figcaption><img src="${p.outUrl}"></figure>
    </div>

    <!-- La superposition. C'est elle qui tranche : le curseur fait passer d'une image à l'autre
         au même endroit, et tout décalage de quelques pixels devient un mouvement. -->
    <div class="stackwrap">
      <figcaption>superposition — glisser pour fondre</figcaption>
      <div class="stack" id="s${i}">
        <img src="${p.refUrl}">
        <img src="${p.outUrl}" class="top">
      </div>
      <input type="range" min="0" max="100" value="50" oninput="document.querySelector('#s${i} .top').style.opacity=this.value/100">
    </div>
  </section>`).join('')

  return `<!doctype html><meta charset="utf-8"><title>ZenRayMedia — comparaison rendu / source</title>
<style>
  :root{color-scheme:dark}
  body{margin:0;padding:26px 30px 60px;background:#0d0f12;color:#cfd8e3;
    font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
  h1{font-size:20px;margin:0 0 4px;color:#fff}
  .intro{color:#8b98a8;max-width:76ch;margin:0 0 26px}
  section{background:#14181d;border:1px solid #232a32;border-radius:10px;padding:18px 20px;margin:0 0 20px}
  h2{display:flex;align-items:center;gap:10px;font-size:13px;margin:0 0 14px;
    text-transform:uppercase;letter-spacing:.08em;color:#8fa3b8;font-weight:600}
  h2 .n{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;
    border-radius:50%;background:#2b6ba1;color:#fff;font-size:11px;letter-spacing:0}
  h2 code{margin-left:auto;font:11px ui-monospace,monospace;color:#5d6b7a;text-transform:none;letter-spacing:0}
  .row{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:0 0 16px}
  figure{margin:0}
  figcaption{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#6b7a8a;margin:0 0 6px}
  img{display:block;width:100%;height:auto;background:#0a0d10;border:1px solid #232a32;border-radius:4px}
  .stackwrap{border-top:1px solid #1d232a;padding-top:14px}
  .stack{position:relative}
  .stack img{position:relative}
  .stack .top{position:absolute;inset:0;opacity:.5}
  input[type=range]{width:100%;margin-top:10px;accent-color:#7fd4ff}
</style>
<h1>Comparaison rendu / source</h1>
<p class="intro">À gauche la capture d'origine, à droite le rendu HTML, <strong>à la même largeur</strong>.
En dessous, les deux superposés : glisser le curseur fait passer de l'un à l'autre au même endroit.
Un écart de quelques pixels, invisible côte à côte, devient un mouvement en superposition.
<strong>Regarder cette planche avant de déclarer un composant fait.</strong></p>
${blocks}`
}

async function main() {
  const argv = process.argv.slice(2)
  const arg = (n, d = null) => { const i = argv.indexOf(`--${n}`); return i >= 0 && argv[i + 1] ? argv[i + 1] : d }

  let jobs = []
  let out = arg('out')
  const specPath = arg('spec')

  if (specPath) {
    // Un fichier de spec par thème : chaque composant y déclare son sélecteur, sa capture de
    // référence et le rectangle correspondant. C'est ce fichier qui rend la boucle REJOUABLE —
    // sans lui, il faudrait retrouver les coordonnées à chaque itération.
    const spec = JSON.parse(await readFile(specPath, 'utf8'))
    const base = path.dirname(specPath)
    jobs = spec.compare.map((c) => ({
      name: c.name,
      html: path.resolve(base, c.html),
      selector: c.selector,
      ref: path.resolve(base, c.ref),
      refLabel: c.ref,
      rect: c.rect,
      width: c.width, height: c.height,
    }))
    out = out || path.join(base, 'compare.html')
  } else {
    const html = argv.find((a) => !a.startsWith('--') && a.endsWith('.html'))
    if (!html) throw new Error('usage : node scripts/zrm-compare.mjs <composant.html> --sel <css> --ref <image> --rect x,y,w,h')
    jobs = [{
      name: path.basename(html, '.html'),
      html: path.resolve(html),
      selector: arg('sel'),
      ref: path.resolve(arg('ref')),
      refLabel: arg('ref'),
      rect: arg('rect') ? arg('rect').split(',').map(Number) : null,
      width: Number(arg('width', 1400)), height: Number(arg('height', 900)),
    }]
    out = out || 'compare.html'
  }

  // --dump : écrit chaque crop de référence en PNG, SANS rendre les composants.
  // Sert à VÉRIFIER les rectangles avant de leur faire confiance. Un rect faux produit une
  // comparaison d'apparence sérieuse contre une zone qui n'est pas le composant — c'est la
  // même faute que sur les sondes de police, et elle se corrige de la même façon : en regardant.
  const dumpOnly = argv.includes('--dump')

  const browser = await chromium.launch()
  const page = await browser.newPage()
  const pairs = []
  for (const job of jobs) {
    if (!existsSync(job.html) && !dumpOnly) throw new Error(`composant introuvable : ${job.html}`)
    const outUrl = dumpOnly ? '' : await renderOne(page, job)
    const srcUrl = await dataUrl(job.ref)
    // Découpe de la référence dans le navigateur, pour n'ajouter aucune dépendance d'image.
    const refUrl = await page.evaluate(async ([u, r]) => {
      const img = new Image(); img.src = u; await img.decode()
      if (!r) return u
      const c = document.createElement('canvas')
      c.width = r[2]; c.height = r[3]
      c.getContext('2d').drawImage(img, r[0], r[1], r[2], r[3], 0, 0, r[2], r[3])
      return c.toDataURL('image/png')
    }, [srcUrl, job.rect])
    pairs.push({ name: job.name, ref: job.refLabel, rect: job.rect, refUrl, outUrl })
    if (dumpOnly) {
      const dir = path.join(path.dirname(path.resolve(out)), 'refs')
      await mkdir(dir, { recursive: true })
      await writeFile(path.join(dir, `${job.name}.png`), Buffer.from(refUrl.split(',')[1], 'base64'))
      console.log(`  ${job.name.padEnd(24)} crop écrit`)
    } else {
      console.log(`  ${job.name.padEnd(24)} rendu + source découpée`)
    }
  }
  await browser.close()

  if (dumpOnly) {
    console.log(`\nCrops de référence écrits. LES REGARDER avant de lancer la comparaison.`)
    return
  }
  await mkdir(path.dirname(path.resolve(out)), { recursive: true })
  await writeFile(out, sheet(pairs))
  console.log(`\nPlanche : ${out}`)
  console.log(`À OUVRIR ET REGARDER avant de déclarer un composant fait.`)
}

main().catch((e) => { console.error(e.message || e); process.exit(1) })
