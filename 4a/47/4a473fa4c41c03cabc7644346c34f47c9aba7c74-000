// cmaf-stage.test.js (14 October 2026)
import { describe, it, expect, beforeEach, afterEach } from 'vitest'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { readStage, writeStage, removeStage } from './cmaf-stage.mjs'

let root, source, work, poster, stageDir
const packaged = () => ({ ok: true, mode: 'copy4', names: ['chunk_0_00001.m4s', 'chunk_1_00001.m4s'], totalBytes: 7, attempts: [{ mode: 'copy4', ok: true }] })

beforeEach(() => {
  root = fs.mkdtempSync(path.join(os.tmpdir(), 'cmaf-stage-'))
  source = path.join(root, 'film.mkv'); fs.writeFileSync(source, 'source bytes')
  work = path.join(root, 'work'); fs.mkdirSync(work)
  fs.writeFileSync(path.join(work, 'chunk_0_00001.m4s'), 'abcd')
  fs.writeFileSync(path.join(work, 'chunk_1_00001.m4s'), 'efg')
  fs.writeFileSync(path.join(work, 'master.m3u8'), '#EXTM3U')
  fs.writeFileSync(path.join(work, 'manifest.mpd'), '<MPD/>')
  poster = path.join(root, 'poster-current.jpg'); fs.writeFileSync(poster, 'jpg')
  stageDir = path.join(root, 'stage', 'abc')
})
afterEach(() => fs.rmSync(root, { recursive: true, force: true }))

describe('cmaf-stage', () => {
  it('keeps a packaged film and gives it back when nothing changed', () => {
    const kept = writeStage({ stageDir, workDir: work, posterFile: poster, sourcePath: source, packaged: packaged() })
    expect(fs.existsSync(work)).toBe(false)           // moved, not copied
    const found = readStage(stageDir, source)
    expect(found.packaged.names).toEqual(kept.packaged.names)
    expect(fs.readFileSync(path.join(found.filesDir, 'chunk_0_00001.m4s'), 'utf8')).toBe('abcd')
    expect(fs.readFileSync(found.posterFile, 'utf8')).toBe('jpg')
  })

  it('refuses a stage whose source changed, so the film is packaged again', () => {
    writeStage({ stageDir, workDir: work, posterFile: poster, sourcePath: source, packaged: packaged() })
    fs.writeFileSync(source, 'a different, longer source file')
    expect(readStage(stageDir, source)).toBeNull()
  })

  it('refuses a stage with a missing or truncated segment', () => {
    writeStage({ stageDir, workDir: work, posterFile: poster, sourcePath: source, packaged: packaged() })
    fs.writeFileSync(path.join(stageDir, 'files', 'chunk_1_00001.m4s'), 'e')
    expect(readStage(stageDir, source)).toBeNull()
    fs.rmSync(path.join(stageDir, 'files', 'chunk_1_00001.m4s'))
    expect(readStage(stageDir, source)).toBeNull()
  })

  it('refuses an incomplete record and a stage that does not exist', () => {
    expect(readStage(path.join(root, 'nothing'), source)).toBeNull()
    writeStage({ stageDir, workDir: work, posterFile: poster, sourcePath: source, packaged: packaged() })
    const file = path.join(stageDir, 'stage.json')
    const record = JSON.parse(fs.readFileSync(file, 'utf8')); record.complete = false
    fs.writeFileSync(file, JSON.stringify(record))
    expect(readStage(stageDir, source)).toBeNull()
  })

  it('removeStage deletes the whole directory', () => {
    writeStage({ stageDir, workDir: work, posterFile: poster, sourcePath: source, packaged: packaged() })
    removeStage(stageDir)
    expect(fs.existsSync(stageDir)).toBe(false)
  })
})
