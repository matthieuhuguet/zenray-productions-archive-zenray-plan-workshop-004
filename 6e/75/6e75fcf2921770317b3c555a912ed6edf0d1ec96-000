// Shared attachment contract for Plan and Calendar. (19 October 2026, 00:32 Paris)
export const PLAN_ATTACHMENTS = Object.freeze({ folder: 'pages/PlanAttachments', heading: 'Attachments', pickerMax: 96 })

export function attachmentUrl(token, origin) {
  return `${origin}/api/attachment-download?share=${encodeURIComponent(token)}`
}

export function calendarDescription(task, sourceNote = task.note || '') {
  const note = sourceNote.replace(/\n*<!-- zenray-attachments:start -->[\s\S]*?<!-- zenray-attachments:end -->/g, '')
  const links = (task.attachments || []).filter((item) => {
    try { return ['https:', 'http:'].includes(new URL(item.url).protocol) } catch { return false }
  }).map((item) => `${item.name || 'Download'}\n${item.url}`)
  return [note, links.length ? `<!-- zenray-attachments:start -->\n${PLAN_ATTACHMENTS.heading}\n${links.join('\n\n')}\n<!-- zenray-attachments:end -->` : ''].filter(Boolean).join('\n\n')
}

// Create drops carry the original media path, never a copy of its bytes. (19 October 2026, 01:08 Paris)
export const isCreateMediaPath = (path) => typeof path === 'string' && path.startsWith('pages/') && !/[\\?#%]/.test(path) && !path.split('/').some((part) => !part || part === '.' || part === '..') && /\.(?:media|img)\.json$/.test(path)

export function createDropPaths(raw) {
  try {
    const payload = JSON.parse(raw)
    const items = payload.items || [payload]
    return [...new Set(items.map((item) => item.path).filter(isCreateMediaPath))]
  } catch { return isCreateMediaPath(raw?.trim()) ? [raw.trim()] : [] }
}
