// 08 October 2026: Utilitaires récursifs pour l'arborescence infinie de groupes et sous-groupes.
function findFirstThumb(item) {
  if (!item) return null
  if (item.kind !== 'folder') return item.path || null
  for (const child of item.items || []) {
    const p = findFirstThumb(child)
    if (p) return p
  }
  return null
}

function findFolderPath(items, targetId) {
  if (!targetId) return []
  function search(list, path) {
    for (const it of list || []) {
      if (it.kind === 'folder') {
        const nextPath = [...path, it]
        if (it.id === targetId) return nextPath
        const found = search(it.items, nextPath)
        if (found) return found
      }
    }
    return null
  }
  return search(items, []) || []
}

function updateFolderInTree(list, targetId, updater) {
  return (list || []).map((it) => {
    if (it.kind !== 'folder') return it
    if (it.id === targetId) return updater(it)
    return { ...it, items: updateFolderInTree(it.items, targetId, updater) }
  })
}

function getAllFolders(list, prefix = '') {
  const res = []
  for (const x of list || []) {
    if (x.kind === 'folder') {
      const fullLabel = prefix ? `${prefix} › ${x.name}` : x.name
      res.push({ id: x.id, name: x.name, fullLabel })
      res.push(...getAllFolders(x.items, fullLabel))
    }
  }
  return res
}

function CrumbSep() {
  return (
    <svg viewBox="0 0 20 20" width="10" height="10" fill="none" stroke="currentColor" strokeWidth="1.7" strokeLinecap="round"
      style={{ color: 'var(--g9-soft)', margin: '0 2px', flexShrink: 0 }} aria-hidden="true">
      <path d="m8 5 5 5-5 5" />
    </svg>
  )
}

function buildFolderTreeNodes(list, onSelect, currentId) {
  const res = []
  for (const it of list || []) {
    if (it.kind === 'folder') {
      const kids = buildFolderTreeNodes(it.items, onSelect, currentId)
      const isSelected = currentId === it.id
      res.push({
        id: it.id,
        label: it.name,
        icon: <Icon name="folder" size={14} />,
        selected: isSelected,
        action: () => onSelect(it.id),
        children: kids.length > 0 ? [
          {
            id: `open-${it.id}`,
            label: `Ouvrir ${it.name}`,
            icon: <Icon name="arrow.up.right" size={14} />,
            action: () => onSelect(it.id),
          },
          ...kids,
        ] : undefined,
      })
    }
  }
  return res
}

function FolderTile({ folder, editing, onOpen, onEdit, onSave, onCancel, dragProps, ratio = '4 / 5', isArtistsGallery = false }) {
  const kids = (folder.items || []).slice(0, 4)
  const n = (folder.items || []).length
  const isArtist = Boolean(isArtistsGallery || folder.isArtist || (folder.projects && folder.projects.length > 0))
  const projectCount = (folder.projects || []).length
  const displayNote = isArtist && (folder.role || folder.studio)
    ? `${folder.role || ''}${folder.role && folder.studio ? ' · ' : ''}${folder.studio || ''}${folder.note ? ` : ${folder.note}` : ''}`
    : folder.note
  const initials = (folder.name || 'A').split(/\s+/).slice(0, 2).map((w) => w[0] || '').join('').toUpperCase()
  return (
    <div {...dragProps} style={{ width: '100%', position: 'relative', ...(dragProps?.style || {}) }}>
      <div className="zr-tap zr-ws-rim zr-gallery-visual" onClick={onOpen} role="button" tabIndex={0} aria-label={`Ouvrir ${folder.name || 'le groupe'}`}
        onKeyDown={(event) => { if (event.target === event.currentTarget && (event.key === 'Enter' || event.key === ' ')) { event.preventDefault(); onOpen() } }} style={{
        width: '100%', aspectRatio: ratio, cursor: 'pointer', position: 'relative',
        borderRadius: 8, overflow: 'hidden',
      }}>
        {kids.length > 0 ? (
          <GalleryThumb path={findFirstThumb(folder)} alt={folder.name || ''} style={{ width: '100%', height: '100%', objectFit: GALLERY_PRESENTATION.layout.imageFit, display: 'block' }} />
        ) : (
          <div style={{
            width: '100%', height: '100%', display: 'flex', flexDirection: 'column',
            alignItems: 'center', justifyContent: 'center', gap: 6,
            background: 'radial-gradient(circle at 30% 25%, rgba(10,132,255,.22), rgba(18,18,22,.92) 75%)',
          }}>
            <span style={{ font: '400 34px/1 var(--zr-police-serif)', color: 'rgba(255,255,255,.78)', letterSpacing: '.03em' }}>{initials}</span>
            {folder.handle ? <span style={{ font: '400 11px var(--zr-police-mono)', color: 'rgba(255,255,255,.5)' }}>@{folder.handle}</span> : null}
          </div>
        )}
        <TileCaption
          title={folder.name}
          note={displayNote}
          url={folder.url}
          handle={folder.handle}
          isArtist={isArtist}
          projectCount={projectCount}
          onEdit={onEdit}
          compte={n}
        />
        {editing ? <TileEditor item={folder} onSave={onSave} onCancel={onCancel} /> : null}
      </div>
    </div>
  )
}

// 10 October 2026: Pop-up widget dépliable et agrandissable pour parcourir tous les projets ArtStation d'un artiste.
// Porte les trois tailles préréglées (Normal, Large, Plein écran) + poignées de redimensionnement libre à la souris
// (bord droit, bord bas, coin bas-droit), recherche instantanée, accordéon dépliable projet par projet ou tout d'un coup,
// redirection directe vers le profil ArtStation et vers chaque projet ArtStation, et ajout direct de nouveaux projets.
function ArtistProjectsPopover({ artist, t, onClose, onOpenImage, onOpenGrid, onAddProject }) {
  const [sizeMode, setSizeMode] = React.useState('normal') // 'normal' | 'large' | 'max'
  const [customSize, setCustomSize] = React.useState(null) // { w, h } | null
  const [search, setSearch] = React.useState('')
  const [addingProject, setAddingProject] = React.useState(false)
  const [newProjTitle, setNewProjTitle] = React.useState('')
  const [newProjUrl, setNewProjUrl] = React.useState('')
  const [newProjCategory, setNewProjCategory] = React.useState('')
  const [newProjNote, setNewProjNote] = React.useState('')

  // 10 October 2026: Construit la liste des projets à partir de artist.projects, avec repli sur artist.items si un dossier a été créé à la main.
  const allProjects = React.useMemo(() => {
    if (Array.isArray(artist?.projects) && artist.projects.length > 0) {
      return artist.projects
    }
    const items = artist?.items || []
    if (items.length === 0) return []
    return [{
      id: `${artist.id}-default-proj`,
      title: `${artist.name} : Références`,
      category: artist.role || 'Portfolio ArtStation',
      url: artist.url || '',
      note: artist.note || '',
      items,
    }]
  }, [artist])

  // 10 October 2026: Par défaut, les 3 premiers projets sont dépliés à l'ouverture pour montrer immédiatement les planches.
  const [expandedIds, setExpandedIds] = React.useState(() => {
    const initial = new Set()
    allProjects.slice(0, 3).forEach((p) => initial.add(p.id))
    return initial
  })

  React.useEffect(() => {
    const initial = new Set()
    allProjects.slice(0, 3).forEach((p) => initial.add(p.id))
    setExpandedIds(initial)
  }, [artist?.id, allProjects])

  React.useEffect(() => {
    const onKey = (e) => {
      if (e.key === 'Escape') onClose()
    }
    window.addEventListener('keydown', onKey)
    return () => window.removeEventListener('keydown', onKey)
  }, [onClose])

  const filteredProjects = React.useMemo(() => {
    const q = search.trim().toLowerCase()
    if (!q) return allProjects
    return allProjects.filter((p) =>
      (p.title || '').toLowerCase().includes(q) ||
      (p.category || '').toLowerCase().includes(q) ||
      (p.note || '').toLowerCase().includes(q)
    )
  }, [allProjects, search])

  const allExpanded = filteredProjects.length > 0 && filteredProjects.every((p) => expandedIds.has(p.id))

  const toggleProject = (id) => {
    setExpandedIds((prev) => {
      const next = new Set(prev)
      if (next.has(id)) next.delete(id)
      else next.add(id)
      return next
    })
  }

  const toggleAll = () => {
    if (allExpanded) {
      setExpandedIds(new Set())
    } else {
      const next = new Set(expandedIds)
      filteredProjects.forEach((p) => next.add(p.id))
      setExpandedIds(next)
    }
  }

  const cycleSizeMode = () => {
    setCustomSize(null)
    setSizeMode((cur) => (cur === 'normal' ? 'large' : cur === 'large' ? 'max' : 'normal'))
  }

  // 10 October 2026: Redimensionnement libre à la souris par glisser sur le coin bas-droit, le bord droit ou le bord bas.
  const startResize = (axis) => (e) => {
    e.preventDefault()
    e.stopPropagation()
    const box = e.currentTarget.parentElement?.getBoundingClientRect()
    if (!box) return
    const startX = e.clientX
    const startY = e.clientY
    const startW = box.width
    const startH = box.height
    const onMove = (ev) => {
      const dx = ev.clientX - startX
      const dy = ev.clientY - startY
      const maxW = window.innerWidth - 32
      const maxH = window.innerHeight - 32
      setCustomSize({
        w: axis === 'y' ? startW : Math.max(520, Math.min(maxW, Math.round(startW + dx * 2))),
        h: axis === 'x' ? startH : Math.max(380, Math.min(maxH, Math.round(startH + dy * 2))),
      })
    }
    const onUp = () => {
      window.removeEventListener('mousemove', onMove)
      window.removeEventListener('mouseup', onUp)
    }
    window.addEventListener('mousemove', onMove)
    window.addEventListener('mouseup', onUp)
  }

  const presetDimensions = sizeMode === 'max'
    ? { width: '95vw', height: '92vh' }
    : sizeMode === 'large'
      ? { width: 'min(1180px, 94vw)', height: 'min(820px, 88vh)' }
      : { width: 'min(880px, 92vw)', height: 'min(660px, 84vh)' }

  const boxDimensions = customSize
    ? { width: `${customSize.w}px`, height: `${customSize.h}px` }
    : presetDimensions

