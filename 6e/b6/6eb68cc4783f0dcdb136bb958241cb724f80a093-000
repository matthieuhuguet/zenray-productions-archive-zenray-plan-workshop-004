// 10 October 2026, 22:58 CEST: Chrome fills clipboardData.files, Safari only clipboardData.items; read both so a pasted screenshot always lands.
// FR : Chrome remplit `files`, Safari seulement `items` ; on lit les deux pour qu'une capture arrive toujours.
function clipboardImageFile(clipboardData) {
  const fromFiles = [...(clipboardData?.files || [])]
  const fromItems = [...(clipboardData?.items || [])].filter((item) => item.kind === 'file').map((item) => item.getAsFile())
  return [...fromFiles, ...fromItems].find((file) => file && file.type && file.type.startsWith('image/')) || null
}

