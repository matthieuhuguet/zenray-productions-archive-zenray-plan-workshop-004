// CHEMIN BRUT (uploads/…, posé par /api/img lors d'un collage ou d'un glisser direct) CONTRE
// CHEMIN-MANIFESTE (posé depuis Create, un .img.json à déchiffrer). Deux origines, deux résolutions :
// un chemin brut est déjà une image servable telle quelle, le faire passer par
// `readImgManifestCached` tenterait de JSON.parse un binaire et échouerait en silence (vignette grise
// à vie). `uploads/` est le seul préfixe que `/api/img` écrit pour ce cas, donc le seul test fiable.
const isRawUpload = (p) => !!p && p.startsWith('uploads/')
const isHttpUrl = (p) => !!p && (p.startsWith('http://') || p.startsWith('https://'))
const rawUrl = (p) => `/api/img?path=${encodeURIComponent(p)}`

// VIGNETTE. `Views.jsx` exporte bien un `MediaThumb`, mais il pointe l'<img> directement sur
// `shardThumbUrl(m)` — l'URL jsDelivr de l'objet CHIFFRÉ. Correct pour les images publiques EN CLAIR
// (ancien schéma), faux pour le schéma actuel (public mais chiffré AES-GCM) : le navigateur reçoit des
// octets chiffrés, pas un WebP, et affiche l'icône cassée. `resolveThumbUrl`/`resolveFullUrl`
// (ImageNodeViewer.jsx) sont les résolveurs ASYNC prévus pour ce cas hors-hook : ils déchiffrent et
// rendent un objectURL affichable, avec repli automatique en clair si l'image ne l'est pas.
function GalleryThumb({ path, alt, style }) {
  const raw = isRawUpload(path)
  const isHttp = isHttpUrl(path)
  const [url, setUrl] = React.useState(null)
  React.useEffect(() => {
    if (raw || isHttp) return undefined // rien à résoudre, l'URL brute suffit déjà
    let vivant = true
    readImgManifestCached(path).then((m) => m && resolveThumbUrl(m)).then((u) => { if (vivant && u) setUrl(u) })
    return () => { vivant = false }
  }, [path, raw, isHttp])
  if (isHttp) return <img src={path} alt={alt || ''} loading="lazy" style={style} />
  if (raw) return <img src={rawUrl(path)} alt={alt || ''} loading="lazy" style={style} />
  if (!url) return <div style={{ ...style, background: 'rgba(128,128,128,.10)' }} />
  return <img src={url} alt={alt || ''} loading="lazy" style={style} />
}

// Tuile plein écran au clic : même manifeste en cache que la vignette (`readImgManifestCached`),
// seule la résolution PLEINE (`resolveFullUrl`, elle aussi déchiffrée) diffère de la vignette WebP.
// PORTÉ vers <body> : un `position: fixed` posé dans l'arbre de la page (sous le conteneur défilant
// `overflowY: auto` de la zone de contenu, App.jsx) casse dès qu'un ancêtre gagne un
// transform/filter/contain, retombant relatif à CET ancêtre au lieu du viewport réel — l'image
// s'ouvre alors décalée par rapport à l'endroit cliqué. Même correctif que le popover de Plan.
function Lightbox({ item, path: legacyPath, name: legacyName, onClose, onStep = null, position = null }) {
  // 15 October 2026: Escape closes, the arrow keys step through the displayed references, the counter says where you are.
  React.useEffect(() => {
    const onKey = (e) => {
      if (e.key === 'Escape') { e.preventDefault(); onClose() }
      else if (onStep && e.key === 'ArrowRight') { e.preventDefault(); onStep(1) }
      else if (onStep && e.key === 'ArrowLeft') { e.preventDefault(); onStep(-1) }
    }
    window.addEventListener('keydown', onKey)
    return () => window.removeEventListener('keydown', onKey)
  }, [onClose, onStep])
  const path = item?.path || legacyPath
  const name = item?.name || item?.title || legacyName
  const sourceUrl = item?.url
  const raw = isRawUpload(path)
  const isHttp = isHttpUrl(path)
  const [url, setUrl] = React.useState(null)
  React.useEffect(() => {
    if (raw || isHttp) return undefined
    let vivant = true
    readImgManifestCached(path).then((m) => m && resolveFullUrl(m)).then((u) => { if (vivant && u) setUrl(u) })
    return () => { vivant = false }
  }, [path, raw, isHttp])
  const shown = isHttp ? path : (raw ? rawUrl(path) : url)
  return createPortal((
    <div role="dialog" aria-modal="true" aria-label={item.title || name || 'Image'} onClick={onClose} style={{
      position: 'fixed', inset: 0, zIndex: 4000, background: 'rgba(10,10,12,.88)',
      display: 'grid', placeItems: 'center', padding: '5vh 5vw', cursor: 'zoom-out',
    }}>
      <div style={{ position: 'absolute', top: 18, right: 20, display: 'flex', alignItems: 'center', gap: 10 }}>
        {sourceUrl && (
          <a href={sourceUrl} target="_blank" rel="noopener noreferrer" onClick={(e) => e.stopPropagation()}
            title={`Ouvrir le lien source : ${sourceUrl}`}
            style={{
              display: 'inline-flex', alignItems: 'center', gap: 6, padding: '7px 14px', borderRadius: 999,
              background: 'rgba(255,255,255,.16)', color: '#fff', textDecoration: 'none',
              font: '400 13px var(--zr-police-sans)', backdropFilter: 'blur(10px)',
              transition: 'background .15s ease',
            }}
            onMouseEnter={(e) => { e.currentTarget.style.background = 'rgba(255,255,255,.28)' }}
            onMouseLeave={(e) => { e.currentTarget.style.background = 'rgba(255,255,255,.16)' }}>
            <Icon name="arrow.up.right" size={13} color="#fff" />
            <span>Ouvrir la source ({(() => { try { return new URL(sourceUrl).hostname.replace(/^www\./, '') } catch { return 'lien' } })()})</span>
          </a>
        )}
        <button type="button" onClick={onClose} aria-label="Fermer" title="Fermer" style={{
          width: 34, height: 34, borderRadius: 999,
          border: 0, background: 'rgba(255,255,255,.14)', color: '#fff', display: 'grid', placeItems: 'center', cursor: 'pointer',
        }}><Icon name="xmark" size={16} color="#fff" /></button>
      </div>
      {position && position.total > 1 && (
        <div aria-live="polite" style={{ position: 'absolute', bottom: 16, left: '50%', transform: 'translateX(-50%)', padding: '4px 12px', borderRadius: 999, background: 'rgba(255,255,255,.14)', color: '#fff', font: '400 12px var(--zr-police-serif)' }}>
          {position.index + 1} / {position.total}
        </div>
      )}
      {shown ? (
        <img src={shown} alt={name || ''} style={{ maxWidth: '100%', maxHeight: '90vh', borderRadius: 3, boxShadow: '0 30px 90px -20px rgba(0,0,0,.7)' }} onClick={(e) => e.stopPropagation()} />
      ) : (
        <div style={{ color: 'rgba(255,255,255,.6)', font: "400 13px var(--zr-police-sans)" }}>chargement…</div>
      )}
    </div>
  ), document.body)
}

// FONDU 0,35 s : le contenu est REMONTÉ (key=folderId côté appelant) donc React le traite comme un
// nouvel arbre, qui démarre à opacité 0 et rejoint 1 au montage — un fondu d'entrée simple, sans
// machine à états ni double-montage ancien/nouveau. L'ancien contenu, lui, disparaît instantanément
// au démontage : à l'œil, la transition reste fluide (rien ne saute brutalement à pleine opacité).
function FadeIn({ children }) {
  const [on, setOn] = React.useState(false)
  React.useEffect(() => { const r = requestAnimationFrame(() => setOn(true)); return () => cancelAnimationFrame(r) }, [])
  return <div style={{ opacity: on ? 1 : 0, transition: 'opacity .35s ease' }}>{children}</div>
}

