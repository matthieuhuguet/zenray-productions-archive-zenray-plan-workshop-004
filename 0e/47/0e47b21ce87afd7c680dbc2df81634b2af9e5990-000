import React from 'react'
import { cleanup, fireEvent, render } from '@testing-library/react'
import { afterEach, describe, expect, it, vi } from 'vitest'
import SeekBar, { clampSeekFraction } from './SeekBar.jsx'

afterEach(cleanup)

describe('SeekBar', () => {
  it('borne toujours la position au domaine lisible', () => {
    expect(clampSeekFraction(-3)).toBe(0)
    expect(clampSeekFraction(3)).toBe(1)
    expect(clampSeekFraction('0.42')).toBe(0.42)
    expect(clampSeekFraction('invalid')).toBe(0)
  })

  it('prévisualise un drag puis ne commit qu’une fois au relâchement', () => {
    const onSeek = vi.fn()
    const onPreview = vi.fn()
    const view = render(<SeekBar value={0.1} onSeek={onSeek} onPreview={onPreview} />)
    const range = view.getByRole('slider')

    fireEvent.pointerDown(range, { pointerId: 1 })
    fireEvent.input(range, { target: { value: '0.64' } })
    expect(onPreview).toHaveBeenLastCalledWith(0.64)
    expect(onSeek).not.toHaveBeenCalled()

    fireEvent.pointerUp(range, { pointerId: 1 })
    fireEvent.blur(range)
    expect(onSeek).toHaveBeenCalledTimes(1)
    expect(onSeek).toHaveBeenCalledWith(0.64)
  })

  it('garantit le commit si le pointeur est annulé ou si le contrôle perd le focus', () => {
    const onSeek = vi.fn()
    const view = render(<SeekBar value={0} onSeek={onSeek} />)
    const range = view.getByRole('slider')

    fireEvent.pointerDown(range, { pointerId: 2 })
    fireEvent.input(range, { target: { value: '0.33' } })
    fireEvent.pointerCancel(range, { pointerId: 2 })
    expect(onSeek).toHaveBeenLastCalledWith(0.33)

    fireEvent.input(range, { target: { value: '0.77' } })
    fireEvent.blur(range)
    expect(onSeek).toHaveBeenLastCalledWith(0.77)
    expect(onSeek).toHaveBeenCalledTimes(2)
  })

  it('valide le clavier et permet une annulation explicite avec Escape', () => {
    const onSeek = vi.fn()
    const onCancel = vi.fn()
    const view = render(<SeekBar value={0.2} onSeek={onSeek} onCancel={onCancel} />)
    const range = view.getByRole('slider')

    fireEvent.keyDown(range, { key: 'ArrowRight' })
    fireEvent.input(range, { target: { value: '0.3' } })
    fireEvent.keyUp(range, { key: 'ArrowRight' })
    expect(onSeek).toHaveBeenLastCalledWith(0.3)

    fireEvent.keyDown(range, { key: 'ArrowRight' })
    fireEvent.input(range, { target: { value: '0.4' } })
    fireEvent.keyDown(range, { key: 'Escape' })
    fireEvent.blur(range)
    expect(onSeek).toHaveBeenCalledTimes(1)
    expect(onCancel).toHaveBeenCalledTimes(1)
  })
})
