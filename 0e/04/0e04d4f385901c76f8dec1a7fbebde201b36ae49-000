import { describe, it, expect } from 'vitest'
import { rememberSharePlacement, shareViaParam, shareViaFromUrl } from './shareVia.js'
import { urlLectureAffichage } from './urlLecture.js'
import { appendShareCredential } from './shareLinks.js'

describe('via : le lien d’où vient une image partagée accompagne ses requêtes', () => {
  it('urlLectureAffichage et appendShareCredential ajoutent via une fois le lien résolu', () => {
    const canon = 'pages/Photos/Mois/IMG_1.JPG.img.json'
    const lien = 'pages/Photos/Mois/galerie/IMG_1.JPG.img.json'
    expect(urlLectureAffichage(canon, { share: 'T' })).not.toContain('via=')
    rememberSharePlacement(canon, lien)
    expect(urlLectureAffichage(canon, { share: 'T' })).toContain(`&via=${encodeURIComponent(lien)}`)
    expect(appendShareCredential(`/api/shared-media?path=${encodeURIComponent(canon)}&kind=thumb`, 'T')).toContain(`&via=${encodeURIComponent(lien)}`)
    expect(shareViaParam('pages/inconnu.img.json')).toBe('')
    expect(shareViaFromUrl('/api/page?action=tree&dir=x')).toBe('')
  })
})
