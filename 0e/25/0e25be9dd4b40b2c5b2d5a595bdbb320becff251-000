export function createHttp(config, { fetchImpl = (...args) => fetch(...args), sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms)) } = {}) {
  const { userAgent, timeoutMs, retries } = config.http

  async function request(url, { json = false, headers = {}, method = 'GET', body } = {}) {
    let failure
    for (let attempt = 0; attempt <= retries; attempt++) {
      try {
        const response = await fetchImpl(url, { method, ...(body !== undefined ? { body } : {}), headers: { 'user-agent': userAgent, accept: json ? 'application/json' : 'text/html,application/json', ...headers }, signal: AbortSignal.timeout(timeoutMs), redirect: 'follow' })
        if (response.status === 404) { const error = new Error(`HTTP 404 ${url}`); error.status = 404; error.final = true; throw error }
        if (!response.ok) { const error = new Error(`HTTP ${response.status} ${url}`); error.status = response.status; throw error }
        const text = await response.text()
        if (!json) return text
        try { return JSON.parse(text) } catch { const error = new Error(`Invalid JSON ${url}`); error.final = true; throw error }
      } catch (error) {
        failure = error
        if (error.final || attempt === retries) break
        await sleep(500 * 2 ** attempt)
      }
    }
    throw failure
  }

  return { text: (url, options) => request(url, { ...options, json: false }), json: (url, options) => request(url, { ...options, json: true }), postJson: (url, payload) => request(url, { json: true, method: 'POST', body: JSON.stringify(payload), headers: { 'content-type': 'application/json' } }) }
}

/** Runs `worker` over `items` with at most `limit` in flight; one failure never stops the others. */
export async function mapLimited(items, limit, worker) {
  const results = new Array(items.length)
  let cursor = 0
  async function lane() {
    while (cursor < items.length) {
      const index = cursor++
      try { results[index] = { ok: true, value: await worker(items[index], index) } } catch (error) { results[index] = { ok: false, error } }
    }
  }
  await Promise.all(Array.from({ length: Math.max(1, Math.min(limit, items.length)) }, lane))
  return results
}
