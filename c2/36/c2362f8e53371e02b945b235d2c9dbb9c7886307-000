import { describe, expect, it } from 'vitest'
import { collectMusicFlagDirs, isUnderMusicFolder, MUSIC_FLAG_FILE } from './musicFolderFlag.js'

describe('musicFolderFlag', () => {
  it('repère un dossier marqué et route ses descendants, même profonds', () => {
    const paths = ['pages/Music/.zrmusic.json', 'pages/Music/Psycho-Pass/song.media.json', 'pages/Photos/a.img.json']
    const flagDirs = collectMusicFlagDirs(paths)
    expect(flagDirs.has('pages/Music')).toBe(true)
    expect(isUnderMusicFolder('pages/Music/Psycho-Pass/song.media.json', flagDirs)).toBe(true)
    expect(isUnderMusicFolder('pages/Photos/a.img.json', flagDirs)).toBe(false)
  })

  it('survit à un renommage du dossier : le marqueur suit le nouveau chemin, pas l\'ancien', () => {
    // Avant renommage : "Music" -> après : "Musique". Le marqueur (déplacé avec le dossier via move-tree)
    // pointe désormais sous le nouveau nom ; l'ancien préfixe en dur ne matcherait plus, le marqueur si.
    const paths = ['pages/Musique/.zrmusic.json', 'pages/Musique/song.media.json']
    const flagDirs = collectMusicFlagDirs(paths)
    expect(isUnderMusicFolder('pages/Musique/song.media.json', flagDirs)).toBe(true)
    expect(isUnderMusicFolder('pages/Music/song.media.json', flagDirs)).toBe(false) // ancien chemin, disparu
  })

  it('ne route rien sans marqueur nulle part dans l\'arbre', () => {
    const flagDirs = collectMusicFlagDirs(['pages/Music/song.media.json'])
    expect(flagDirs.size).toBe(0)
    expect(isUnderMusicFolder('pages/Music/song.media.json', flagDirs)).toBe(false)
  })

  it("ne confond pas un dossier marqué avec un simple préfixe de nom (ex. 'pages/Musical/')", () => {
    const flagDirs = collectMusicFlagDirs(['pages/Music/.zrmusic.json'])
    expect(isUnderMusicFolder('pages/Musical/song.media.json', flagDirs)).toBe(false)
  })

  it('exporte le nom de fichier marqueur attendu par App.jsx', () => {
    expect(MUSIC_FLAG_FILE).toBe('.zrmusic.json')
  })
})
