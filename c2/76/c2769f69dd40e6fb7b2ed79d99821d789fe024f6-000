import { describe, it, expect } from 'vitest'
import { totalHours } from './push-policy-simulation.mjs'

const GB = 1e9
const LINES_MBPS = [0.5, 1, 5, 11, 40]
const MTBF = { flaky: 1800, stable: 6 * 3600 }
const VOLUMES_GB = [3, 30, 250, 2500]

describe('the adaptive batch is never slower than the best fixed batch (model, 14 October 2026)', () => {
  for (const [name, mtbf] of Object.entries(MTBF)) {
    for (const mbps of LINES_MBPS) {
      it(`${name} line, ${mbps} MB/s: adaptive within 3 percent of the best fixed batch, over every volume`, () => {
        for (const volume of VOLUMES_GB) {
          const adaptive = totalHours(volume * GB, 'adaptive', mbps * 1e6, mtbf)
          const best = Math.min(...['95', '190', '760', '1900'].map((size) => totalHours(volume * GB, size, mbps * 1e6, mtbf)))
          expect(adaptive).toBeLessThanOrEqual(best * 1.03)
        }
      })
    }
  }
  it('is strictly better than a fixed 1 900 MiB batch on a slow flaky line, and equal on a fast stable one', () => {
    expect(totalHours(30 * GB, 'adaptive', 1e6, 1800)).toBeLessThan(totalHours(30 * GB, '1900', 1e6, 1800) * 0.9)
    expect(totalHours(30 * GB, 'adaptive', 40e6, 6 * 3600)).toBeCloseTo(totalHours(30 * GB, '1900', 40e6, 6 * 3600), 6)
  })
})
