export const CUSTOM_GALLERIES_STORAGE_KEY = 'zr:custom-galleries:v1'

export function getCustomGalleries() {
  if (typeof window === 'undefined') return []
  try {
    const raw = localStorage.getItem(CUSTOM_GALLERIES_STORAGE_KEY)
    return raw ? JSON.parse(raw) : []
  } catch {
    return []
  }
}

export function saveCustomGallery(gallery) {
  if (typeof window === 'undefined' || !gallery?.key) return
  try {
    const list = getCustomGalleries().filter((g) => g.key !== gallery.key)
    list.push(gallery)
    localStorage.setItem(CUSTOM_GALLERIES_STORAGE_KEY, JSON.stringify(list))
    window.dispatchEvent(new CustomEvent('zr:pointer-galleries-changed', { detail: gallery }))
  } catch {}
}

export function getAllGalleries() {
  const custom = getCustomGalleries()
  const customKeys = new Set(custom.map((g) => g.key))
  return [...POINTER_GALLERIES.filter((g) => !customKeys.has(g.key)), ...custom]
}

export const isPointerGallery = (key) => getAllGalleries().some((g) => g.key === key || (key === 'mariage-clea-septembre-2026' && g.key === 'marriage-clea-septembre-2026'))

export const galleryByKey = (key) => {
  const normKey = (key === 'mariage-clea-septembre-2026') ? 'marriage-clea-septembre-2026' : key
  return getAllGalleries().find((g) => g.key === normKey) || null
}
