// FolderCommentsFeed.jsx: rectangle unique translucide Liquid Glass pour commentaires de dossier.
// Mis a jour le 06 October 2026 pour ZenRayProgress.
// Typographie en AnthropicSerif, animation fluide de 0.35 sec, reactivite immediate sans latence,
// et elimination totale des commentaires fantomes.

import React, { useState, useEffect, useCallback, useMemo } from 'react'
import Icon from './Icon.jsx'
import { FONTS, PALETTE } from '../theme.js'

export function getHistoryKey(folder) {
  return 'zr:folder-comment-history:' + (folder || 'pages')
}

export function getDismissedKey(folder) {
  return 'zr:folder-comment-dismissed:' + (folder || 'pages')
}

export function hasFolderCommentHistory(folder) {
  try {
    const raw = localStorage.getItem(getHistoryKey(folder))
    if (!raw) return false
    const list = JSON.parse(raw)
    return Array.isArray(list) && list.length > 0
  } catch {
    return false
  }
}

function formatDate(isoOrTimestamp) {
  if (!isoOrTimestamp) return '06 October 2026'
  try {
    const d = new Date(isoOrTimestamp)
    if (isNaN(d.getTime())) return '06 October 2026'
    const day = String(d.getDate()).padStart(2, '0')
    const months = [
      'January', 'February', 'March', 'April', 'May', 'June',
      'July', 'August', 'September', 'October', 'November', 'December'
    ]
    const m = months[d.getMonth()]
    const y = d.getFullYear()
    const hh = String(d.getHours()).padStart(2, '0')
    const mm = String(d.getMinutes()).padStart(2, '0')
    return `${day} ${m} ${y}, ${hh}:${mm}`
  } catch {
    return '06 October 2026'
  }
}

function cleanTitle(name) {
  if (!name) return 'Commentaire'
  return name
    .replace(/\.(comment\.json|md)$/i, '')
    .replace(/^[0-9]+[ _.-]*/, '')
    .trim() || 'Commentaire'
}

export default function FolderCommentsFeed({
  folder,
  entries = [],
  onAddComment,
  onDeleteComment,
  onOpenEntry,
  t,
  isDark = false,
  forceOpen = 0,
  restoreOpen = 0,
}) {
  const [isEditing, setIsEditing] = useState(false)
  const [draftTitle, setDraftTitle] = useState('')
  const [draftBody, setDraftBody] = useState('')
  const [saving, setSaving] = useState(false)
  const [loadedComments, setLoadedComments] = useState([])
  const [dismissed, setDismissed] = useState(false)
  const [isDismissing, setIsDismissing] = useState(false)
  const [showRestoreModal, setShowRestoreModal] = useState(false)
  const [historyList, setHistoryList] = useState([])

  // Reinitialisation immediate a chaque changement de dossier (pas de fuite entre dossiers)
  useEffect(() => {
    setLoadedComments([])
    setIsEditing(false)
    setIsDismissing(false)
    try {
      const isDismissed = localStorage.getItem(getDismissedKey(folder)) === 'true'
      setDismissed(isDismissed)
      const rawHist = localStorage.getItem(getHistoryKey(folder))
      const hist = rawHist ? JSON.parse(rawHist) : []
      setHistoryList(Array.isArray(hist) ? hist : [])
    } catch {
      setDismissed(false)
      setHistoryList([])
    }
  }, [folder])

  // Declencheur de composition depuis le menu clic droit
  useEffect(() => {
    if (forceOpen > 0) {
      try {
        localStorage.removeItem(getDismissedKey(folder))
      } catch {}
      setDismissed(false)
      setIsDismissing(false)
      setIsEditing(true)
    }
  }, [forceOpen, folder])

  // Declencheur d'ouverture de l'interface de restauration depuis le menu clic droit
  useEffect(() => {
    if (restoreOpen > 0) {
      setShowRestoreModal(true)
    }
  }, [restoreOpen])

  // Chargement des commentaires specifiques au dossier
  useEffect(() => {
    let active = true
    if (!entries.length) {
      setLoadedComments((prev) => (prev.some((c) => c.isOptimistic) ? prev : []))
      return
    }

    Promise.all(
      entries.map(async (e) => {
        const p = e.contentPath || e.dir
        if (!p) return null
        try {
          const res = await fetch(`/api/page?action=read&path=${encodeURIComponent(p)}`, { cache: 'no-store' })
          const j = await res.json()
          let parsedTitle = cleanTitle(e.name)
          let parsedBody = ''
          let createdAt = e.createdAt || new Date().toISOString()

          if (j && j.markdown) {
            try {
              const data = JSON.parse(j.markdown)
              if (data && data.type === 'comment') {
                parsedBody = data.body || data.text || ''
                if (data.title) parsedTitle = data.title
                if (data.createdAt) createdAt = data.createdAt
              } else {
                parsedBody = j.markdown
              }
            } catch {
              parsedBody = j.markdown.replace(/^#\s+[^\n]+\n+/, '').trim()
            }
          }

          return {
            id: p,
            path: p,
            title: parsedTitle,
            body: parsedBody || parsedTitle,
            createdAt,
          }
        } catch {
          return null
        }
      })
    ).then((results) => {
      if (!active) return
      const valid = results.filter(Boolean)
      setLoadedComments(valid)

      // Memorisation dans l'historique du dossier pour restauration
      if (valid.length) {
        try {
          const key = getHistoryKey(folder)
          const raw = localStorage.getItem(key)
          const currentHist = raw ? JSON.parse(raw) : []
          let updated = [...currentHist]
          for (const item of valid) {
            if (!updated.some((x) => x.body === item.body && x.title === item.title)) {
              updated.unshift(item)
            }
          }
          updated = updated.slice(0, 15)
          localStorage.setItem(key, JSON.stringify(updated))
          setHistoryList(updated)
        } catch {}
      }
    })

    return () => {
      active = false
    }
  }, [folder, entries])

  // Commentaire actif : UNIQUEMENT les commentaires presents ou ajoutes dans ce dossier
  const activeComment = useMemo(() => {
    if (loadedComments.length > 0) return loadedComments[0]
    return null
  }, [loadedComments])

  // Enlever le commentaire au clic sur la petite croix avec animation 0.35s
  const handleDismiss = useCallback(() => {
    if (isDismissing) return
    setIsDismissing(true)
    try {
      localStorage.setItem(getDismissedKey(folder), 'true')
    } catch {}
    setTimeout(() => {
      setDismissed(true)
      setIsDismissing(false)
    }, 350)
  }, [folder, isDismissing])

  // Restaurer un commentaire depuis l'interface d'historique (0ms, animation 0.35s)
  const handleRestoreItem = useCallback(async (item) => {
    try {
      localStorage.removeItem(getDismissedKey(folder))
    } catch {}
    setDismissed(false)
    setIsDismissing(false)
    setLoadedComments([item])
    setShowRestoreModal(false)

    if (onAddComment && !loadedComments.some((x) => x.body === item.body)) {
      try {
        await onAddComment(item.body, item.title)
      } catch {}
    }
  }, [folder, onAddComment, loadedComments])

  // Publication d'un nouveau commentaire avec reactivite immediate (0ms)
  const handleSave = useCallback(async () => {
    const text = draftBody.trim()
    if (!text || !onAddComment) return
    const title = draftTitle.trim()
    const nowIso = new Date().toISOString()
    const optimisticComment = {
      id: 'optimistic-' + Date.now(),
      title: title || 'Commentaire',
      body: text,
      createdAt: nowIso,
      isOptimistic: true,
    }

    // Affichage instantane dans l'interface
    setLoadedComments([optimisticComment])
    setDismissed(false)
    setIsDismissing(false)
    setIsEditing(false)
    setDraftTitle('')
    setDraftBody('')

    // Sauvegarde immediate dans l'historique local pour pouvoir restaurer
    try {
      const key = getHistoryKey(folder)
      const raw = localStorage.getItem(key)
      const currentHist = raw ? JSON.parse(raw) : []
      const updated = [optimisticComment, ...currentHist.filter((x) => x.body !== text)].slice(0, 15)
      localStorage.setItem(key, JSON.stringify(updated))
      localStorage.removeItem(getDismissedKey(folder))
      setHistoryList(updated)
    } catch {}

    setSaving(true)
    try {
      const res = await onAddComment(text, title)
      if (res && res.comment && res.path) {
        setLoadedComments([{
          id: res.path,
          path: res.path,
          title: res.comment.title || title || 'Commentaire',
          body: res.comment.body || text,
          createdAt: res.comment.createdAt || nowIso,
        }])
      }
    } catch (err) {
      console.error('Erreur enregistrement commentaire:', err)
    } finally {
      setSaving(false)
    }
  }, [draftBody, draftTitle, onAddComment, folder])

  // Styles CSS embarques pour animations 0.35s
  const animationStyles = (
    <style>{`
      @keyframes zrCommentEnter {
        0% {
          opacity: 0;
          transform: translateY(-8px) scale(0.985);
          filter: blur(4px);
        }
        100% {
          opacity: 1;
          transform: translateY(0) scale(1);
          filter: blur(0);
        }
      }
      @keyframes zrCommentExit {
        0% {
          opacity: 1;
          transform: translateY(0) scale(1);
          filter: blur(0);
          max-height: 400px;
          margin-bottom: 16px;
        }
        100% {
          opacity: 0;
          transform: translateY(-8px) scale(0.985);
          filter: blur(4px);
          max-height: 0;
          margin-bottom: 0;
          padding-top: 0;
          padding-bottom: 0;
          overflow: hidden;
        }
      }
      @keyframes zrCommentModalIn {
        0% {
          opacity: 0;
          transform: scale(0.96) translateY(6px);
        }
        100% {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }
      .zr-folder-single-comment {
        animation: zrCommentEnter 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .zr-folder-single-comment.zr-comment-exit {
        animation: zrCommentExit 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
        pointer-events: none;
      }
      .zr-comment-modal-content {
        animation: zrCommentModalIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
      }
    `}</style>
  )

  // Modale de restauration de commentaire
  const restoreModal = showRestoreModal && (
    <div
      style={{
        position: 'fixed',
        inset: 0,
        zIndex: 1000,
        background: 'rgba(0, 0, 0, 0.40)',
        backdropFilter: 'blur(8px)',
        WebkitBackdropFilter: 'blur(8px)',
        display: 'grid',
        placeItems: 'center',
        padding: 20,
      }}
      onClick={() => setShowRestoreModal(false)}
    >
      <div
        className="zr-comment-modal-content"
        style={{
          width: 'min(520px, 92vw)',
          borderRadius: 18,
          background: isDark
            ? 'linear-gradient(135deg, rgba(30, 27, 75, 0.94), rgba(15, 23, 42, 0.96))'
            : 'linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(243, 232, 255, 0.96))',
          backdropFilter: 'blur(24px) saturate(180%)',
          WebkitBackdropFilter: 'blur(24px) saturate(180%)',
          border: isDark ? '1px solid rgba(167, 139, 250, 0.40)' : '1px solid rgba(167, 139, 250, 0.45)',
          boxShadow: '0 20px 40px -10px rgba(0, 0, 0, 0.40)',
          padding: '22px 24px',
          boxSizing: 'border-box',
          display: 'flex',
          flexDirection: 'column',
          gap: 16,
        }}
        onClick={(e) => e.stopPropagation()}
      >
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: 9 }}>
            <span
              style={{
                width: 28,
                height: 28,
                borderRadius: 999,
                background: 'rgba(139, 92, 246, 0.20)',
                color: '#8b5cf6',
                display: 'grid',
                placeItems: 'center',
              }}
            >
              <Icon name="arrow.uturn.backward" size={13} weight={2} />
            </span>
            <div
              style={{
                fontFamily: FONTS.sans || 'var(--zr-police-sans)',
                fontSize: 16,
                fontWeight: 600,
                color: t.textPrimary,
              }}
            >
              Réafficher un ancien commentaire
            </div>
          </div>
          <button
            onClick={() => setShowRestoreModal(false)}
            style={{
              width: 26,
              height: 26,
              borderRadius: 999,
              border: 'none',
              background: 'transparent',
              color: t.textSecondary,
              cursor: 'pointer',
              display: 'grid',
              placeItems: 'center',
            }}
          >
            <Icon name="xmark" size={13} weight={2} />
          </button>
        </div>

        <div style={{ maxHeight: 320, overflowY: 'auto', display: 'flex', flexDirection: 'column', gap: 10 }}>
          {historyList.length === 0 ? (
            <div style={{ color: t.textSecondary, fontSize: 14, textAlign: 'center', padding: '24px 0' }}>
              Aucun ancien commentaire dans l'historique de ce dossier.
            </div>
          ) : (
            historyList.map((item, idx) => (
              <div
                key={item.id || idx}
                style={{
                  padding: '12px 14px',
                  borderRadius: 12,
                  background: isDark ? 'rgba(255, 255, 255, 0.06)' : 'rgba(255, 255, 255, 0.65)',
                  border: isDark ? '1px solid rgba(255, 255, 255, 0.12)' : '1px solid rgba(167, 139, 250, 0.25)',
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'space-between',
                  gap: 12,
                }}
              >
                <div style={{ flex: 1, minWidth: 0 }}>
                  {item.title && item.title !== item.body && (
                    <div
                      style={{
                        fontFamily: FONTS.serif || 'var(--zr-police-serif)',
                        fontSize: 15,
                        fontWeight: 600,
                        color: t.textPrimary,
                        marginBottom: 3,
                        overflow: 'hidden',
                        textOverflow: 'ellipsis',
                        whiteSpace: 'nowrap',
                      }}
                    >
                      {item.title}
                    </div>
                  )}
                  <div
                    style={{
                      fontFamily: FONTS.serif || 'var(--zr-police-serif)',
                      fontSize: 14,
                      color: t.textPrimary,
                      lineHeight: 1.4,
                      display: '-webkit-box',
                      WebkitLineClamp: 2,
                      WebkitBoxOrient: 'vertical',
                      overflow: 'hidden',
                    }}
                  >
                    {item.body}
                  </div>
                  <div style={{ fontSize: 11, fontFamily: FONTS.serif || 'var(--zr-police-serif)', color: t.textTertiary || t.textSecondary, marginTop: 4 }}>
                    {formatDate(item.createdAt)}
                  </div>
                </div>
                <button
                  onClick={() => handleRestoreItem(item)}
                  style={{
                    padding: '6px 14px',
                    borderRadius: 999,
                    border: 'none',
                    background: '#8b5cf6',
                    color: '#FFFFFF',
                    fontSize: 12,
                    fontWeight: 500,
                    cursor: 'pointer',
                    whiteSpace: 'nowrap',
                    flexShrink: 0,
                  }}
                >
                  Réafficher
                </button>
              </div>
            ))
          )}
        </div>
      </div>
    </div>
  )

  // Mode edition directe dans le rectangle Liquid Glass
  if (isEditing) {
    return (
      <>
        {animationStyles}
        {restoreModal}
        <div
          className="zr-folder-single-comment"
          style={{
            margin: '0 12px 16px 12px',
            padding: '16px 20px',
            borderRadius: 16,
            background: isDark
              ? 'linear-gradient(135deg, rgba(139, 92, 246, 0.18), rgba(59, 130, 246, 0.14))'
              : 'linear-gradient(135deg, rgba(167, 139, 250, 0.18), rgba(147, 197, 253, 0.20))',
            backdropFilter: 'blur(20px) saturate(180%)',
            WebkitBackdropFilter: 'blur(20px) saturate(180%)',
            border: isDark
              ? '1px solid rgba(167, 139, 250, 0.40)'
              : '1px solid rgba(167, 139, 250, 0.48)',
            boxShadow: isDark
              ? '0 8px 24px -4px rgba(124, 58, 237, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.25)'
              : '0 8px 24px -4px rgba(124, 58, 237, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.70)',
            position: 'relative',
            display: 'flex',
            flexDirection: 'column',
            gap: 10,
            boxSizing: 'border-box',
          }}
        >
          <input
            autoFocus
            type="text"
            value={draftTitle}
            onChange={(e) => setDraftTitle(e.target.value)}
            placeholder="Titre du commentaire (optionnel)"
            style={{
              background: isDark ? 'rgba(0, 0, 0, 0.25)' : 'rgba(255, 255, 255, 0.65)',
              border: isDark ? '1px solid rgba(167, 139, 250, 0.30)' : '1px solid rgba(167, 139, 250, 0.35)',
              borderRadius: 8,
              padding: '7px 12px',
              fontFamily: FONTS.serif || 'var(--zr-police-serif)',
              fontSize: 16,
              color: t.textPrimary,
              outline: 'none',
            }}
          />
          <textarea
            rows={3}
            value={draftBody}
            onChange={(e) => setDraftBody(e.target.value)}
            onKeyDown={(e) => {
              if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
                e.preventDefault()
                handleSave()
              }
            }}
            placeholder="Écrire un commentaire pour ce dossier…"
            style={{
              background: isDark ? 'rgba(0, 0, 0, 0.25)' : 'rgba(255, 255, 255, 0.65)',
              border: isDark ? '1px solid rgba(167, 139, 250, 0.30)' : '1px solid rgba(167, 139, 250, 0.35)',
              borderRadius: 8,
              padding: '10px 12px',
              fontFamily: FONTS.serif || 'var(--zr-police-serif)',
              fontSize: 15,
              lineHeight: 1.5,
              color: t.textPrimary,
              outline: 'none',
              resize: 'vertical',
            }}
          />
          <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 8 }}>
            <button
              type="button"
              onClick={() => {
                setIsEditing(false)
                setDraftTitle('')
                setDraftBody('')
              }}
              style={{
                padding: '6px 14px',
                borderRadius: 999,
                border: 'none',
                background: isDark ? 'rgba(255, 255, 255, 0.10)' : 'rgba(0, 0, 0, 0.06)',
                color: t.textPrimary,
                cursor: 'pointer',
                fontSize: 13,
                fontFamily: FONTS.sans || 'var(--zr-police-sans)',
              }}
            >
              Annuler
            </button>
            <button
              type="button"
              disabled={saving || !draftBody.trim()}
              onClick={handleSave}
              style={{
                padding: '6px 16px',
                borderRadius: 999,
                border: 'none',
                background: '#8b5cf6',
                color: '#FFFFFF',
                fontWeight: 500,
                cursor: draftBody.trim() ? 'pointer' : 'default',
                opacity: draftBody.trim() ? 1 : 0.5,
                fontSize: 13,
                fontFamily: FONTS.sans || 'var(--zr-police-sans)',
                transition: 'opacity 0.2s ease, transform 0.2s ease',
              }}
            >
              {saving ? 'Publication…' : 'Enregistrer'}
            </button>
          </div>
        </div>
      </>
    )
  }

  // Si aucun commentaire actif ou commentaire masque par la croix, ne rien afficher (sauf pendant l'animation de sortie)
  if (!activeComment || (dismissed && !isDismissing)) {
    return restoreModal || null
  }

  // Rendu du rectangle unique Liquid Glass avec petite croix et animation 0.35s
  return (
    <>
      {animationStyles}
      {restoreModal}
      <div
        className={`zr-folder-single-comment ${isDismissing ? 'zr-comment-exit' : ''}`}
        style={{
          margin: '0 12px 16px 12px',
          padding: '16px 20px',
          borderRadius: 16,
          background: isDark
            ? 'linear-gradient(135deg, rgba(139, 92, 246, 0.16), rgba(59, 130, 246, 0.12))'
            : 'linear-gradient(135deg, rgba(167, 139, 250, 0.16), rgba(147, 197, 253, 0.18))',
          backdropFilter: 'blur(20px) saturate(180%)',
          WebkitBackdropFilter: 'blur(20px) saturate(180%)',
          border: isDark
            ? '1px solid rgba(167, 139, 250, 0.32)'
            : '1px solid rgba(167, 139, 250, 0.40)',
          boxShadow: isDark
            ? '0 8px 24px -4px rgba(124, 58, 237, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.20)'
            : '0 8px 24px -4px rgba(124, 58, 237, 0.10), inset 0 1px 0 rgba(255, 255, 255, 0.60)',
          position: 'relative',
          display: 'flex',
          flexDirection: 'column',
          gap: 6,
          boxSizing: 'border-box',
        }}
      >
        {/* Petite croix pour enlever le commentaire */}
        <button
          type="button"
          onClick={handleDismiss}
          title="Enlever le commentaire"
          aria-label="Enlever le commentaire"
          style={{
            position: 'absolute',
            top: 12,
            right: 12,
            width: 24,
            height: 24,
            borderRadius: 999,
            border: 'none',
            background: isDark ? 'rgba(255, 255, 255, 0.10)' : 'rgba(0, 0, 0, 0.05)',
            color: t.textSecondary,
            display: 'grid',
            placeItems: 'center',
            cursor: 'pointer',
            transition: 'background 0.2s ease, color 0.2s ease, transform 0.2s ease',
          }}
          onMouseEnter={(e) => {
            e.currentTarget.style.background = isDark ? 'rgba(255, 255, 255, 0.22)' : 'rgba(0, 0, 0, 0.12)'
            e.currentTarget.style.color = t.textPrimary
            e.currentTarget.style.transform = 'scale(1.08)'
          }}
          onMouseLeave={(e) => {
            e.currentTarget.style.background = isDark ? 'rgba(255, 255, 255, 0.10)' : 'rgba(0, 0, 0, 0.05)'
            e.currentTarget.style.color = t.textSecondary
            e.currentTarget.style.transform = 'scale(1)'
          }}
        >
          <Icon name="xmark" size={11} weight={2.2} />
        </button>

        {/* Titre si different du corps */}
        {activeComment.title && activeComment.title !== activeComment.body && (
          <div
            style={{
              fontFamily: FONTS.serif || 'var(--zr-police-serif)',
              fontSize: 17,
              fontWeight: 600,
              color: t.textPrimary,
              paddingRight: 28,
            }}
          >
            {activeComment.title}
          </div>
        )}

        {/* Corps en AnthropicSerif */}
        {activeComment.body && (
          <div
            style={{
              fontFamily: FONTS.serif || 'var(--zr-police-serif)',
              fontSize: 15,
              lineHeight: 1.6,
              color: t.textPrimary,
              whiteSpace: 'pre-wrap',
              paddingRight: 28,
            }}
          >
            {activeComment.body}
          </div>
        )}

        {/* Date en bas avec nombres en AnthropicSerif */}
        <div
          style={{
            display: 'flex',
            alignItems: 'center',
            gap: 7,
            marginTop: 4,
            fontSize: 11,
            fontFamily: FONTS.serif || 'var(--zr-police-serif)',
            color: t.textTertiary || t.textSecondary,
            opacity: 0.85,
          }}
        >
          <Icon name="bubble.left" size={10} />
          <span>{formatDate(activeComment.createdAt)}</span>
        </div>
      </div>
    </>
  )
}
