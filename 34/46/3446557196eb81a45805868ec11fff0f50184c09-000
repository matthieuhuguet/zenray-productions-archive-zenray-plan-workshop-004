/* ═══ LA PASTILLE FLOTTANTE ════════════════════════════════════════════════════════════════════════
   Elle occupe le coin bas gauche, que rien n'occupait : le mini-lecteur audio s'ancre SOUS la barre
   latérale, donc haut, et les deux ne se rencontrent jamais. Vérifié plutôt que supposé, parce que
   deux objets flottants qui se recouvrent ne se voient qu'une fois en production. */

.zrtb {
  position: fixed;
  /* Repli quand aucune barre latérale n'est visible : le coin de la fenêtre est alors réellement libre.
     Dès qu'une barre est mesurée, le composant surcharge ce `left` en ligne, à sa droite.
     ÉCART DE RÉGION, PAS DE VOISINAGE. Les 12 et 16 pixels du premier jet étaient des écarts de
     voisinage, ceux qu'on met entre deux choses qui vont ensemble. Une pastille flottante ne va avec
     rien : posée si près du panneau et du bord, l'œil la rattachait à eux, et c'est cela qu'on lit
     comme « collé ». Les 28 pixels la détachent sans l'exiler. */
  --zrtb-air: 28px;
  left: max(var(--zrtb-air), env(safe-area-inset-left));
  bottom: max(var(--zrtb-air), env(safe-area-inset-bottom));
  z-index: 118;
  display: flex; align-items: center; gap: 0;
  padding: 6px; border: 0; border-radius: 999px; cursor: pointer;
  color: var(--g9-fg);
  background: color-mix(in srgb, var(--g9-bg) 82%, transparent);
  backdrop-filter: blur(18px) saturate(1.5);
  -webkit-backdrop-filter: blur(18px) saturate(1.5);
  box-shadow:
    0 1px 0 0 color-mix(in srgb, var(--g9-fg) 8%, transparent) inset,
    0 10px 30px -12px rgba(0,0,0,.35);
  /* L'entrée dépasse la cible et revient : c'est le `back` de la conférence, et il dit « je viens
     d'arriver » là où un fondu simple dirait « j'étais déjà là ». */
  animation: zrtb-entree .46s cubic-bezier(.34,1.56,.64,1);
  /* La barre latérale se replie et se déplie ; sans transition sur `left`, la pastille SAUTERAIT d'un
     bord à l'autre à chaque fois. Elle glisse, et le déplacement devient lisible au lieu d'être subi. */
  transition: box-shadow .22s ease, background .22s ease, transform .2s cubic-bezier(.34,1.56,.64,1), left .3s cubic-bezier(.16,1,.3,1);
}
@keyframes zrtb-entree {
  0%   { opacity: 0; transform: translateY(14px) scale(.82) }
  100% { opacity: 1; transform: translateY(0) scale(1) }
}
/* Le soulèvement et l'ombre bougent ENSEMBLE : une chose qui monte projette une ombre plus large et
   plus lointaine. Faire varier l'une sans l'autre donne un objet qui grandit au lieu de se lever. */
.zrtb:hover {
  transform: translateY(-3px) scale(1.03);
  box-shadow: 0 1px 0 0 color-mix(in srgb, var(--g9-fg) 12%, transparent) inset, 0 22px 48px -12px rgba(0,0,0,.5);
}
.zrtb:active { transform: translateY(0) scale(.96); }   /* enfoncement immédiat, sans tween à l'aller */
.zrtb:focus-visible { outline: 2px solid var(--rc-cyan, #2bb8c4); outline-offset: 3px; }

.zrtb-roue { position: relative; display: grid; place-items: center; width: 54px; height: 54px; flex: none; }

/* Chiffres en serif, règle typographique du dépôt : TOUS les nombres visibles de l'interface. Et
   tabulaires, sinon passer de 10 à 9 minutes décale le nombre dans son cercle et l'on croit à un
   tressaillement de la roue. */
.zrtb-nombre {
  position: absolute; pointer-events: none;
  font-family: var(--zr-police-serif); font-weight: 400; font-size: 19px;
  font-variant-numeric: tabular-nums; letter-spacing: -.01em;
  color: var(--g9-fg);
}

/* ── L'ÉTIQUETTE, DÉPLOYÉE AU SURVOL SEULEMENT ────────────────────────────────────────────────────
   `grid-template-columns` de 0fr à 1fr plutôt qu'une largeur maximale devinée : la capsule s'ouvre à la
   largeur EXACTE du texte, quel qu'il soit, et un titre court ne laisse pas de vide à sa droite. Une
   valeur en dur aurait fallu être choisie pour le pire titre, donc fausse pour tous les autres. */
.zrtb-etiquette {
  display: grid; grid-template-columns: 0fr;
  overflow: hidden; text-align: left;
  transition: grid-template-columns .34s cubic-bezier(.16,1,.3,1), opacity .24s ease, padding .34s cubic-bezier(.16,1,.3,1);
  opacity: 0; padding: 0;
}
.zrtb:hover .zrtb-etiquette, .zrtb:focus-visible .zrtb-etiquette {
  grid-template-columns: 1fr; opacity: 1; padding: 0 14px 0 10px;
}
.zrtb-etiquette > * { min-width: 0; overflow: hidden; }
.zrtb-titre {
  display: block; white-space: nowrap; text-overflow: ellipsis; max-width: 210px;
  font-family: var(--zr-police-sans); font-weight: 400; font-size: 13px; color: var(--g9-fg);
}
.zrtb-sous {
  display: block; white-space: nowrap;
  font-family: var(--zr-police-sans); font-weight: 400; font-size: 11px; color: var(--g9-muted);
}

/* LA FIN. La pastille passe au vert et cesse de respirer par à-coups : la roue est pleine, il n'y a
   plus rien à attendre, et elle se retire d'elle-même quelques secondes plus tard. */
.zrtb-fini { box-shadow: 0 0 0 1px color-mix(in srgb, #30d158 45%, transparent), 0 16px 40px -12px rgba(48,209,88,.35); }
.zrtb-fini .zrtb-nombre { color: #30d158; }

@media (prefers-reduced-motion: reduce) {
  .zrtb { animation: none !important; }
  .zrtb, .zrtb-etiquette { transition-duration: .01ms !important; }
}

/* Trois caractères au centre (« 24h ») dans un cercle de cinquante-quatre pixels : la taille descend,
   sinon le nombre touche l'anneau de progression et les deux se disputent le même trait. */
.zrtb-nombre-long { font-size: 16px; letter-spacing: -.02em; }
