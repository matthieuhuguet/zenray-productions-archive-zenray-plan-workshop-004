// 14 October 2026, 11:55 CEST: shared SRS rules; availability and exposure never imply mastery.
export const STUDY_CONFIG = Object.freeze({
  schemaVersion: 1, historyPath: 'Japanese/Japanese1.md', statePath: 'Japanese/Site/study.json',
  trackerPath: 'Japanese/DrillTracker.md', indexPath: 'Japanese/Site/japanese.json',
  cataloguePath: 'Japanese/Site/corpus/catalogue.json', levels: ['N5', 'N4', 'N3', 'N2', 'N1', 'beyond-N1', 'culture', 'all'],
  srs: { redRetryMs: 15 * 60 * 1000, orangeMs: 2 * 86400000, greenMs: 5 * 86400000, greenSuccesses: 2, fluentMs: 5000 },
  preferences: { level: 'N4', batch: 5, reviewBatch: 10, scale: 17 },
})
export const STAGE_LABELS = { new: 'À découvrir', red: 'À reprendre', orange: 'En consolidation', green: 'Bien restitué', mastered: 'Acquis', suspended: 'À revalider' }
export function emptyStudyState() { return { schemaVersion: 1, progress: {}, eventIds: [], gaps: [], preferences: { ...STUDY_CONFIG.preferences } } }
export function nextStudyStage(previous, grades, elapsed, now, config = STUDY_CONFIG.srs) {
  if (!Array.isArray(grades) || !grades.length || grades.length !== elapsed?.length
    || grades.some(g => !['fluent', 'hesitated', 'failed'].includes(g))
    || elapsed.some(ms => !Number.isFinite(ms) || ms < 0 || ms > 1800000)) throw new Error('Résultats de restitution invalides.')
  const fluent = grades.every((grade, index) => grade === 'fluent' && elapsed[index] <= config.fluentMs)
  let stage = previous.stage, greenSuccesses = previous.greenSuccesses || 0, delay = config.redRetryMs
  if (!fluent) { stage = previous.stage === 'green' ? 'orange' : 'red'; greenSuccesses = 0; delay = stage === 'orange' ? config.orangeMs : config.redRetryMs }
  else if (stage === 'red') { stage = 'orange'; delay = config.orangeMs }
  else if (stage === 'orange') { stage = 'green'; delay = config.greenMs }
  else if (stage === 'green') { greenSuccesses++; stage = greenSuccesses >= config.greenSuccesses ? 'mastered' : 'green'; delay = stage === 'mastered' ? 0 : config.greenMs }
  else throw new Error('Cette fiche ne fait pas partie des révisions dues.')
  return { ...previous, stage, greenSuccesses, reviews: (previous.reviews || 0) + 1, due: now + delay, reviewedAt: now,
    ...(previous.placementPassed !== undefined ? { placementPassed: previous.placementPassed && fluent } : {}) }
}
export function studyCardStatus(record, state, now = Date.now(), records = []) {
  const saved = state.progress[record.id]
  const suspended = saved && saved.contentHash !== record.lessonContentHash
  const progress = suspended ? null : saved
  const missing = (record.prerequisites || []).filter(id => {
    const prerequisite = records.find(card => card.id === id), progress = state.progress[id]
    return !prerequisite || prerequisite.lessonValidation?.status !== 'approved' || !progress
      || progress.contentHash !== prerequisite.lessonContentHash || !(progress.placementPassed || ['green', 'mastered'].includes(progress.stage))
  })
  return { stage: suspended ? 'suspended' : progress?.stage || 'new', progress, missing,
    // 15 October 2026, 10:00 CEST: a newly approved revision can be studied again without inheriting old mastery.
    available: (!saved || suspended) && !missing.length && record.lessonValidation?.status === 'approved',
    due: !!progress && progress.stage !== 'mastered' && progress.due <= now }
}
export function validateStudyPreferences(updates) {
  for (const [key, value] of Object.entries(updates)) {
    if (key === 'level' && STUDY_CONFIG.levels.includes(value)) continue
    const range = { batch: [1, 20], reviewBatch: [1, 50], scale: [14, 23] }[key]
    if (!range || !Number.isInteger(value) || value < range[0] || value > range[1]) throw new Error('Réglage hors limites : ' + key)
  }
  return updates
}
