#!/usr/bin/env python3
# IdentityShadowWatcher.py (12 October 2026): evidence for the decision "proof by object identity instead of the full read-back".
# FR : tourne a cote du worker. Pour chaque film deja envoye et encore present en local, execute la preuve par identite d'objets
# (3 a 4 s) et journalise son verdict dans IdentityShadow.jsonl. Ne decide de rien, ne supprime rien, n'ecrit aucun recu officiel.
import json, os, subprocess, sys, time, glob
from pathlib import Path
from datetime import datetime

BASE = Path('/Users/zenray/.claude/tmp/tmp-movies-series-upload')
REPO = Path('/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress')
CLONE = BASE / 'ManifestClone'
OUT = BASE / 'IdentityShadow.jsonl'
SCRATCH = BASE / 'SpeedResearch' / 'identity-shadow'
SCRATCH.mkdir(parents=True, exist_ok=True)
done = set()
if OUT.exists():
    for line in OUT.read_text().splitlines():
        try: done.add(json.loads(line)['name'])
        except Exception: pass

def sources():
    mapping = {}
    for item in json.loads((BASE / 'ReadyUploadPlan.json').read_text()):
        mapping[item['name']] = Path(item['src'])
    for item in json.loads((BASE / 'FullFilteredQueue.json').read_text()):
        name = item.get('name') or Path(item['source']).name
        staged = BASE / 'FilteredStage' / name
        prepared = BASE / 'Prepared' / name
        mapping[name] = prepared if prepared.exists() else (staged if staged.exists() else Path(item['source']))
    return mapping

deadline = time.time() + 6 * 3600
token = subprocess.check_output(['gh', 'auth', 'token'], text=True).strip()
while time.time() < deadline:
    try:
        mapping = sources()
        for manifest in CLONE.glob('pages/**/*.media.json'):
            name_stem = manifest.name[:-len('.media.json')]
            src = mapping.get(name_stem)
            if not src or not src.exists() or name_stem in done:
                continue
            try:
                data = json.loads(manifest.read_text())
            except Exception:
                continue
            if not data.get('parts') or not data.get('hlsDashVerified') or data.get('size') != src.stat().st_size:
                continue
            receipt = SCRATCH / (name_stem[:80].replace('/', '_') + '.identity.json')
            started = time.time()
            res = subprocess.run(['node', str(REPO / 'scripts/VerifyVideoCloudIdentity.mjs'), str(manifest), str(src), str(receipt)],
                                 cwd=REPO, env={**os.environ, 'GITHUB_TOKEN': token}, capture_output=True, text=True)
            row = {'at': datetime.now().astimezone().isoformat(), 'name': name_stem, 'bytes': src.stat().st_size, 'ok': res.returncode == 0,
                   'seconds': round(time.time() - started, 1), 'detail': ((res.stdout or res.stderr).strip().splitlines() or [''])[-1][:200]}
            with open(OUT, 'a') as handle:
                handle.write(json.dumps(row, ensure_ascii=False) + '\n')
            done.add(name_stem)
            receipt.unlink(missing_ok=True)
    except Exception as exc:
        print('watcher error', exc, file=sys.stderr)
    time.sleep(60)
