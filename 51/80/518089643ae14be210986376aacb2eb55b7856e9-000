// 20 October 2026, 15:16 CEST: articles precede files only when explicitly declared, in both existing layouts.
import React from 'react'
import { beforeEach,afterEach,it,expect,vi } from 'vitest'
import { render,screen,fireEvent,cleanup,within } from '@testing-library/react'
import ProjectWorkspace from './ProjectWorkspace.jsx'
afterEach(cleanup)
beforeEach(()=>{localStorage.clear();localStorage.setItem('assets.layout','classic');history.replaceState(null,'','/')})
const file={id:'workshop:Article/index.html',name:'index.html',relativePath:'Article/index.html',kind:'text'}
const project={id:'uv-match-height',name:'UV-Match Height',article:{fileId:file.id,title:'Article UV-Match Height',thumbnailUrl:'data:image/webp;base64,YQ=='},files:[file]}
it.each(['classic','tube'])('opens the article first in %s and keeps the file view accessible',async layout=>{
  localStorage.setItem('assets.layout',layout);history.replaceState(null,'','/?project=uv-match-height')
  render(<ProjectWorkspace projects={[project]} activeProjectId={project.id} readArticle={vi.fn().mockResolvedValue('<h1>Height article</h1>')} />)
  expect((await screen.findByTitle('Article UV-Match Height')).getAttribute('srcdoc')).toContain('Height article')
  const tabs=screen.getByRole('navigation',{name:'Vues du projet'})
  expect(within(tabs).getAllByRole('button')[0].textContent).toBe('Article')
  fireEvent.click(within(tabs).getByRole('button',{name:/Fichiers/}))
  expect(screen.queryByTitle('Article UV-Match Height')).toBeNull()
  expect(screen.getAllByText('index.html').length).toBeGreaterThan(0)
})
it('does not adopt an arbitrary HTML file as an article',()=>{
  render(<ProjectWorkspace projects={[{...project,article:undefined}]} activeProjectId={project.id} />)
  expect(screen.queryByRole('button',{name:'Article'})).toBeNull()
  expect(screen.getAllByText('index.html').length).toBeGreaterThan(0)
})
it('shows a declared missing article as an error rather than an empty file grid',async()=>{
  render(<ProjectWorkspace projects={[{...project,files:[]}]} activeProjectId={project.id} />)
  expect((await screen.findByRole('alert')).textContent).toContain('absent de l’inventaire')
  expect(screen.getByRole('button',{name:/Fichiers/})).toBeDefined()
})
it('uses the article opening thumbnail on the project card without reading HTML at home',()=>{
  localStorage.setItem('assets.layout','tube')
  const read=vi.fn()
  const {container}=render(<ProjectWorkspace projects={[project]} readArticle={read} />)
  expect(container.querySelector('.tube-card img').getAttribute('src')).toBe(project.article.thumbnailUrl)
  expect(read).not.toHaveBeenCalled()
})
