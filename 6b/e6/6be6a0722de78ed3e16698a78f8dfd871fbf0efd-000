// 3 October 2026, 21:40 CEST: a read-only inspector keeps the existing file filters, selection and transfers intact.
import React, { useMemo, useState } from 'react'
import { STORAGE_VIEWS, STORAGE_PAGE_SIZE, storageBreakdown, storageChartGroups } from '../../lib/assetsStorageBreakdown.js'
import FileLocations from './FileLocations.jsx'
import { fileSizeLabel } from '../../lib/assetsFileQuery.js'

const labels = { tmp: 'tmp', memory: 'Memory', houdini: 'Houdini', unreal: 'Unreal', cloud: 'Cloud' }
export default function StorageBreakdown({ files, project, connected, onOpenFile }) {
  const [mode, setMode] = useState('folders')
  const [focus, setFocus] = useState(null)
  const [limit, setLimit] = useState(STORAGE_PAGE_SIZE)
  const breakdown = useMemo(() => storageBreakdown(files, mode), [files, mode])
  const focused = focus ? { ...focus, files: files.filter(file => focus.ids.has(file.id)) } : null
  const rows = focused ? storageBreakdown(focused.files, 'files').groups : breakdown.groups
  const chart = storageChartGroups(focused && focus.chartMode !== 'files' ? storageBreakdown(focused.files, 'types').groups : rows)
  const chartFiles = focused ? focused.files : files
  const selectGroup = (group) => {
    if ((focused || mode === 'files') && group.files.length === 1) onOpenFile?.(group.files[0])
    else { setFocus({ label: group.label, chartMode: focused ? 'files' : 'types', ids: new Set(group.files.map(file => file.id)) }); setLimit(STORAGE_PAGE_SIZE) }
  }
  const selectMode = (next) => { setMode(next); setFocus(null); setLimit(STORAGE_PAGE_SIZE) }
  return <details className="assets-storage" aria-label="Répartition de l’espace">
    <summary>Qu’est-ce qui prend de l’espace ? <span className="assets-number">{fileSizeLabel(files)}</span></summary>
    <p className="assets-footnote">Volume des fichiers indexés, hors versions historiques du cloud. Il peut différer de l’espace physique sur le disque.</p>
    <div className="assets-file-filters" role="group" aria-label="Répartition par">{STORAGE_VIEWS.map((view) => <button type="button" key={view.id} data-active={mode === view.id} aria-pressed={mode === view.id} onClick={() => selectMode(view.id)}>{view.label}</button>)}</div>
    {focused && <p><button type="button" className="assets-text-button" onClick={() => { setFocus(null); setLimit(STORAGE_PAGE_SIZE) }}>Retour à la répartition</button> · <code>{focused.label}</code> · <span className="assets-number">{fileSizeLabel(focused.files)}</span></p>}
    {!focused && mode === 'folders' && <p className="assets-footnote">Chaque fichier compte dans son dossier direct ; les dossiers parents ne sont pas ajoutés une seconde fois.</p>}
    <div className="assets-storage-overview">
      <div className="assets-storage-circle">
        <svg viewBox="0 0 120 120" role="img" aria-label="Diagramme de la répartition du volume">
          <circle className="assets-storage-track" cx="60" cy="60" r="46" fill="none" strokeWidth="16" />
          {chart.map((group, index) => {
            const offset = chart.slice(0, index).reduce((sum, item) => sum + item.percent, 0)
            return group.percent > 0 && <circle key={group.key} className={`assets-storage-segment assets-storage-color-${index}`} cx="60" cy="60" r="46" fill="none" strokeWidth="16" pathLength="100" strokeDasharray={`${group.percent} ${100 - group.percent}`} strokeDashoffset={-offset} transform="rotate(-90 60 60)" onClick={() => selectGroup(group)}><title>{group.label} : {fileSizeLabel(group.files)} ({group.percent.toLocaleString('fr', { maximumFractionDigits: 1 })} %)</title></circle>
          })}
        </svg>
        <div className="assets-storage-center"><span className="assets-number">{fileSizeLabel(chartFiles)}</span><small>{focused ? 'Ce groupe' : 'Ce projet'}</small></div>
      </div>
      <div className="assets-storage-legend">{chart.map((group, index) => <button type="button" key={group.key} onClick={() => selectGroup(group)} disabled={(focused || mode === 'files') && group.files.length === 1 && !onOpenFile}>
        <span className={`assets-storage-dot assets-storage-color-${index}`} />
        <span className="assets-storage-name">{group.label}<small><span className="assets-number">{group.files.length}</span> fichier{group.files.length > 1 ? 's' : ''}</small></span>
        <span className="assets-number">{fileSizeLabel(group.files)}<small>{group.percent.toLocaleString('fr', { maximumFractionDigits: 1 })} %</small></span>
      </button>)}</div>
    </div>
    <details className="assets-storage-detail"><summary>Voir le détail des fichiers et dossiers</summary><div className="assets-storage-rows">{rows.slice(0, limit).map((group) => {
      const file = group.files[0]
      const leaf = Boolean(focused || mode === 'files')
      return <div className="assets-storage-item" key={group.key}><button type="button" className="assets-storage-row" key={group.key} disabled={leaf && !onOpenFile} onClick={() => selectGroup(group)}>
        <span className="assets-storage-name"><span>{group.label}</span><small>{leaf ? `${labels[file.namespace] || file.namespace || 'Cloud'} · ${file.relativePath}` : mode === 'folders' ? `${labels[group.namespace] || group.namespace || 'Cloud'} · ${group.source}` : <><span className="assets-number">{group.files.length}</span> fichiers</>}</small></span>
        <span className="assets-number">{fileSizeLabel(group.files)}</span>
        <span className="assets-number">{group.percent.toLocaleString('fr', { maximumFractionDigits: 1 })} %</span>
        <span className="assets-storage-bar" aria-hidden="true"><span style={{ width: `${group.percent}%` }} /></span>
      </button>{leaf && <FileLocations file={file} project={project} connected={connected} />}</div>
    })}</div>
    {!rows.length && <p>Aucun fichier indexé.</p>}
    {rows.length > limit && <button type="button" className="assets-text-button" onClick={() => setLimit(limit + STORAGE_PAGE_SIZE)}>Afficher plus</button>}</details>
    {breakdown.unknown > 0 && <p className="assets-footnote">Les pourcentages portent uniquement sur les tailles connues.</p>}
  </details>
}
