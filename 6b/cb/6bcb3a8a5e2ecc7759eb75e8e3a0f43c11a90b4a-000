// LOT TABLES — utilitaires de grille (conversion A1 <-> index, plages, sélection).
// Une grille tableur a des colonnes A, B, C… et des lignes 1, 2, 3…
// On convertit entre la notation humaine "B5" et les index machine {row:4, col:1}.

// Numéro de colonne -> lettre(s) : 0->A, 25->Z, 26->AA…
export function colToLetter(n) {
  let s = ''
  n = n + 1
  while (n > 0) { const r = (n - 1) % 26; s = String.fromCharCode(65 + r) + s; n = Math.floor((n - 1) / 26) }
  return s
}

// Lettre(s) -> numéro de colonne : A->0, Z->25, AA->26…
export function letterToCol(s) {
  s = s.toUpperCase(); let n = 0
  for (let i = 0; i < s.length; i++) n = n * 26 + (s.charCodeAt(i) - 64)
  return n - 1
}

// "B5" -> {row:4, col:1}. Gère le $ des références absolues ($B$5).
// absCol / absRow disent si la lettre / le chiffre était précédé d'un $ ($B$5 = les deux figés).
// Cette info est indispensable pour décaler une formule (autofill, coller) en gardant les $ intacts.
export function parseA1(ref) {
  const m = /^(\$?)([A-Za-z]+)(\$?)(\d+)$/.exec(ref.trim())
  if (!m) return null
  return { col: letterToCol(m[2]), row: parseInt(m[4], 10) - 1, absCol: m[1] === '$', absRow: m[3] === '$' }
}

// {row,col} -> "B5"
export function toA1(row, col) { return colToLetter(col) + (row + 1) }

// "A1:B5" -> {r0,c0,r1,c1} normalisé (coin haut-gauche -> coin bas-droit).
export function parseRange(ref) {
  const parts = ref.split(':')
  if (parts.length === 1) { const p = parseA1(parts[0]); return p ? { r0: p.row, c0: p.col, r1: p.row, c1: p.col } : null }
  const a = parseA1(parts[0]), b = parseA1(parts[1])
  if (!a || !b) return null
  return { r0: Math.min(a.row, b.row), c0: Math.min(a.col, b.col), r1: Math.max(a.row, b.row), c1: Math.max(a.col, b.col) }
}

// Normalise une sélection {anchor:{row,col}, focus:{row,col}} en rectangle.
export function normSel(sel) {
  if (!sel) return null
  const { anchor: a, focus: f } = sel
  return { r0: Math.min(a.row, f.row), c0: Math.min(a.col, f.col), r1: Math.max(a.row, f.row), c1: Math.max(a.col, f.col) }
}

export function inRect(row, col, rect) {
  return rect && row >= rect.r0 && row <= rect.r1 && col >= rect.c0 && col <= rect.c1
}

export function clamp(n, lo, hi) { return Math.max(lo, Math.min(hi, n)) }
