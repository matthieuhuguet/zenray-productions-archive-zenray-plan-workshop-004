// REQUEST FRAMING for /api/guest-upload (2 October 2026): [4 bytes big-endian header length][header JSON][payload bytes].
// The header lists the parts with their byte lengths, in payload order. Plain binary body: no multipart parser needed in the Worker,
// and the Cloudflare adapter already hands binary bodies to handlers as a Uint8Array. Isomorphic (no DOM, no Node API).
const enc = new TextEncoder()
const dec = new TextDecoder()

export function packFrame(header, payloads = []) {
  const head = enc.encode(JSON.stringify(header))
  let total = 4 + head.length
  for (const p of payloads) total += p.byteLength
  const out = new Uint8Array(total)
  new DataView(out.buffer).setUint32(0, head.length)
  out.set(head, 4)
  let off = 4 + head.length
  for (const p of payloads) { out.set(p, off); off += p.byteLength }
  return out
}

/** Returns { header, payload: Uint8Array } or throws a short Error('bad-frame'). */
export function unpackFrame(bytes) {
  if (!(bytes instanceof Uint8Array) || bytes.byteLength < 6) throw new Error('bad-frame')
  const len = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength).getUint32(0)
  if (len < 2 || len > 256 * 1024 || 4 + len > bytes.byteLength) throw new Error('bad-frame')
  let header
  try { header = JSON.parse(dec.decode(bytes.subarray(4, 4 + len))) } catch { throw new Error('bad-frame') }
  return { header, payload: bytes.subarray(4 + len) }
}

/** Splits `payload` into the parts announced by `header.parts` ({ len }), verifying the total. */
export function sliceParts(parts, payload) {
  let off = 0
  const out = []
  for (const p of parts) {
    const len = Number(p.len)
    if (!Number.isInteger(len) || len < 0 || off + len > payload.byteLength) throw new Error('bad-frame')
    out.push(payload.subarray(off, off + len)); off += len
  }
  if (off !== payload.byteLength) throw new Error('bad-frame')
  return out
}
