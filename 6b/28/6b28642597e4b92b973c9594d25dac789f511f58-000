// Un analyseur de saisie est exactement le genre d'objet qui se teste : beaucoup d'entrées, une sortie,
// et des erreurs SILENCIEUSES. « 90s » lu comme quatre-vingt-dix minutes ne lève aucune exception, il
// lance simplement un bloc d'une heure et demie.
//
// Le dernier bloc est celui qui compte le plus. Il ne verifie pas qu'on refuse, il verifie POURQUOI on
// refuse : « 24h » avait été compris et rejeté avec « durée non comprise », ce qui envoyait chercher une
// faute de syntaxe inexistante. Distinguer les raisons est ce qui empêche un refus de devenir une énigme.
import { describe, expect, it } from 'vitest'
import { analyserDuree, messageRefus, formaterDuree, BORNES } from './dureeSaisie.js'

const sec = (t) => analyserDuree(t).secondes
const ok = (t) => analyserDuree(t).ok

describe('analyserDuree, ce qu\'elle accepte', () => {
  it('lit un nombre nu comme des minutes, comme les paliers', () => {
    expect(sec('7')).toBe(420)
    expect(sec(' 25 ')).toBe(1500)
  })

  it('lit toutes les écritures d\'unité, français et anglais, courtes et longues', () => {
    for (const t of ['90s', '90 sec', '90 secs', '90 seconde', '90 secondes', '90 second', '90 seconds', '90"'])
      expect(sec(t), t).toBe(90)
    for (const t of ['7m', '7mn', '7 min', '7 mins', '7 minute', '7 minutes', "7'"])
      expect(sec(t), t).toBe(420)
    for (const t of ['1h', '1 hr', '1 hrs', '1 hour', '1 hours', '1 heure', '1 heures'])
      expect(sec(t), t).toBe(3600)
  })

  it('applique l\'unité du dessous au nombre nu qui suit', () => {
    expect(sec('2m30')).toBe(150)
    expect(sec('1h30')).toBe(5400)
    expect(sec('1h 30m 15s')).toBe(5415)
  })

  it('tolère les liaisons qu\'on écrit sans y penser', () => {
    expect(sec('1h et 30')).toBe(5400)
    expect(sec('1h + 30m')).toBe(5400)
    expect(sec('1 h 30 min')).toBe(5400)
  })

  it('lit la forme à deux-points par le RANG et non par les lettres', () => {
    expect(sec('2:30')).toBe(150)          // et non deux minutes plus trente minutes
    expect(sec('1:02:30')).toBe(3750)
    expect(sec('0:45')).toBe(45)
    expect(ok('2:75')).toBe(false)         // 75 secondes n'existe pas
  })

  it('accepte la virgule décimale, qui est ce qu\'un clavier français produit', () => {
    expect(sec('1,5m')).toBe(90)
    expect(sec('0,5h')).toBe(1800)
  })

  it('va jusqu\'à la journée entière, le cas qui a motivé la correction', () => {
    expect(sec('24h')).toBe(86400)
    expect(sec('12 hours')).toBe(43200)
    expect(sec('2h30')).toBe(9000)
  })
})

describe('analyserDuree, ce qu\'elle refuse ET POURQUOI', () => {
  it('nomme une saisie vide', () => {
    expect(analyserDuree('').raison).toBe('vide')
    expect(analyserDuree('   ').raison).toBe('vide')
    expect(analyserDuree(null).raison).toBe('vide')
  })

  it('nomme une saisie incomprise', () => {
    expect(analyserDuree('bonjour').raison).toBe('incomprise')
    expect(analyserDuree('7 patates').raison).toBe('incomprise')
    expect(analyserDuree('trois heures').raison).toBe('incomprise')
  })

  it('nomme un dépassement au lieu de crier à la faute de syntaxe', () => {
    // C'EST LE CAS PAYÉ EN VRAI. « 24h » puis « 25h » sont écrits pareil ; l'un passe, l'autre non, et
    // la différence n'a rien à voir avec la syntaxe. Le dire est tout le sujet de ce test.
    const trop = analyserDuree('25h')
    expect(trop.ok).toBe(false)
    expect(trop.raison).toBe('longue')
    expect(trop.secondes).toBe(90000)              // la valeur a bien été comprise
    expect(messageRefus(trop)).toBe('trop long, 24 h au maximum')

    const court = analyserDuree('2s')
    expect(court.raison).toBe('courte')
    expect(court.secondes).toBe(2)
    expect(messageRefus(court)).toBe('trop court, 5 s au minimum')

    expect(messageRefus(analyserDuree('bonjour'))).toBe('durée non comprise')
  })

  it('accepte pile sur les bornes, aux deux extrémités', () => {
    expect(sec(`${BORNES.min}s`)).toBe(BORNES.min)
    expect(sec('24h')).toBe(BORNES.max)
  })
})

describe('formaterDuree', () => {
  it('rend la forme la plus courte qui reste exacte', () => {
    expect(formaterDuree(45)).toBe('45 s')
    expect(formaterDuree(420)).toBe('7 min')
    expect(formaterDuree(150)).toBe('2 min 30')
    expect(formaterDuree(3600)).toBe('1 h')
    expect(formaterDuree(5400)).toBe('1 h 30')
    expect(formaterDuree(5415)).toBe('1 h 30 min 15')
    expect(formaterDuree(86400)).toBe('24 h')
  })
})
