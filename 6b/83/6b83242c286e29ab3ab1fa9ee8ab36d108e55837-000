// 3 October 2026, 13:02 : Analytics, read from PostKit's own store. Two rules are visible on screen: a metric the platform does not expose is
// "n/a" and never 0, and every answer shows how fresh it is. Charts are plain inline SVG: no chart library for a bar and a grid. (3 October 2026)
import React, { useMemo, useState } from 'react'
import { POSTKIT } from './postkitConfig.js'
import { useAction, useQuery } from './usePostKit.js'
import { qs } from './postkitClient.js'
import { Badge, Btn, Card, Empty, ErrorLine, Field, Metric, Num, PlatformDot, Tile, ago, change, metric } from './ui.jsx'
import { PLATFORM_COLORS } from '../config/colors.js'

const METRIC_ROWS = [['views', 'Views'], ['reach', 'Reach'], ['likes', 'Likes'], ['comments', 'Comments'], ['shares', 'Shares'], ['saves', 'Saves'], ['impressions', 'Impressions'], ['clicks', 'Clicks']]
const DAYS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
const tzOf = () => { try { return Intl.DateTimeFormat().resolvedOptions().timeZone } catch { return 'UTC' } }

export function Bars({ series }) {
  const dates = [...new Set(series.map((s) => s.date))].sort()
  const platforms = [...new Set(series.map((s) => s.platform || 'all'))]
  const totals = dates.map((d) => series.filter((s) => s.date === d).reduce((n, s) => n + s.total, 0))
  const max = Math.max(1, ...totals)
  const w = 520; const h = 120; const bw = Math.max(4, Math.min(28, w / Math.max(dates.length, 1) - 4))
  return (
    <svg viewBox={`0 0 ${w} ${h + 18}`} className="zr-pk-chart" role="img" aria-label="Metric over time">
      {dates.map((d, i) => {
        let y = h
        return <g key={d}>{platforms.map((p) => { const v = series.find((s) => s.date === d && (s.platform || 'all') === p)?.total || 0; const bh = (v / max) * (h - 8); y -= bh; return <rect key={p} x={i * (bw + 4)} y={y} width={bw} height={bh} rx="2" fill={PLATFORM_COLORS[p] || 'currentColor'} opacity="0.85" /> })}<text x={i * (bw + 4)} y={h + 14} fontSize="9" fill="currentColor" opacity="0.55">{d.slice(5, 10)}</text></g>
      })}
    </svg>
  )
}

export function HeatGrid({ cells }) {
  const max = Math.max(1, ...cells.map((c) => c.averageEngagement))
  const by = new Map(cells.map((c) => [`${c.weekday}|${c.hour}`, c]))
  return (
    <div className="zr-pk-heat" role="img" aria-label="Best times to post">
      {DAYS.map((d, wd) => <div key={d} className="zr-pk-heatrow"><span className="zr-pk-heatday">{d}</span>{Array.from({ length: 24 }, (_, h) => { const c = by.get(`${wd}|${h}`); return <i key={h} className="zr-pk-cell" style={{ opacity: c ? 0.18 + 0.82 * (c.averageEngagement / max) : 0.05 }} title={c ? `${d} ${h}:00, ${c.posts} post(s), avg ${c.averageEngagement}${c.posts < 3 ? ' (too few posts to act on)' : ''}` : `${d} ${h}:00, no data`} /> })}</div>)}
    </div>
  )
}

function ManualMetrics({ client, accounts, reload }) {
  const manual = accounts.filter((a) => a.status === 'CONNECTED' && !a.capabilities?.analytics && a.capabilities?.publish)
  const [f, setF] = useState({ accountId: manual[0]?.id || '', platformPostId: '', permalink: '', views: '', likes: '' })
  const act = useAction(reload)
  if (!manual.length) return null
  const num = (v) => (v === '' ? undefined : Number(v))
  return (
    <details className="zr-pk-details"><summary>Record figures by hand (ArtStation, LinkedIn…)</summary>
      <p className="zr-pk-meta">These platforms expose no automatic reading. Hand-typed figures are marked <em>manual</em> and never mixed with measured ones.</p>
      <div className="zr-pk-grid3">
        <Field label="Account"><select value={f.accountId} onChange={(e) => setF({ ...f, accountId: e.target.value })}>{manual.map((a) => <option key={a.id} value={a.id}>{a.platform} @{a.username}</option>)}</select></Field>
        <Field label="Post id or URL"><input value={f.platformPostId} onChange={(e) => setF({ ...f, platformPostId: e.target.value })} /></Field>
        <Field label="Permalink"><input value={f.permalink} onChange={(e) => setF({ ...f, permalink: e.target.value })} /></Field>
        <Field label="Views"><input inputMode="numeric" value={f.views} onChange={(e) => setF({ ...f, views: e.target.value })} /></Field>
        <Field label="Likes"><input inputMode="numeric" value={f.likes} onChange={(e) => setF({ ...f, likes: e.target.value })} /></Field>
      </div>
      <Btn busy={act.busy} disabled={!f.platformPostId} onClick={() => act.run(() => client.post('/v1/analytics/manual', { accountId: f.accountId, platformPostId: f.platformPostId, permalink: f.permalink || undefined, metrics: { views: num(f.views), likes: num(f.likes) } }))}>Save figures</Btn>
      <ErrorLine error={act.error} />
    </details>
  )
}

export default function AnalyticsPanel({ client, overview, reload }) {
  const [days, setDays] = useState(POSTKIT.defaultWindowDays)
  const from = useMemo(() => new Date(Date.now() - days * 86_400_000).toISOString(), [days])
  const tz = useMemo(tzOf, [])
  const summary = useQuery(client, `/v1/analytics/summary${qs({ from })}`)
  const top = useQuery(client, `/v1/analytics/posts${qs({ from, sortBy: 'engagement', limit: 8 })}`)
  const accounts = useQuery(client, `/v1/analytics/accounts${qs({ from })}`)
  const series = useQuery(client, `/v1/analytics/timeseries${qs({ from, metric: 'engagement', granularity: days > 90 ? 'week' : 'day', byPlatform: true })}`)
  const best = useQuery(client, `/v1/analytics/best-times${qs({ from, timezone: tz })}`)
  const acc = useQuery(client, `/v1/analytics/accumulation${qs({ from })}`)
  const fol = useQuery(client, `/v1/analytics/followers${qs({ from })}`)
  const reloadAll = async () => { await Promise.all([summary, top, accounts, series, best, acc, fol].map((q) => q.reload())); await reload() }
  const sync = useAction(reloadAll)
  const s = summary.data
  return (
    <>
      <Card title="Analytics" aside={<div className="zr-pk-chips">{POSTKIT.analyticsWindowsDays.map((d) => <button key={d} className={`zr-pk-tab${days === d ? ' is-on' : ''}`} onClick={() => setDays(d)}>{d} d</button>)}<Btn busy={sync.busy} onClick={() => sync.run(() => client.post('/v1/analytics/sync', {}))}>Refresh</Btn></div>}>
        <ErrorLine error={summary.error || sync.error} />
        {s ? (
          <>
            <p className="zr-pk-meta">Read from PostKit's store{s.lastSyncAt ? `, last collected ${ago(s.lastSyncAt)}` : ', nothing collected yet'}{s.nextSyncAt ? `, next ${ago(s.nextSyncAt)}`.replace(' ago', '') : ''}. {s.window.clamped && <Badge tone="warn">history clamped to {s.window.maxHistoryDays} days</Badge>}</p>
            <div className="zr-pk-tiles">
              <Tile label="Posts" value={s.posts.value} sub={change(s.posts.change)} />
              <Tile label="Engagement rate" value={s.engagementRate.value === null ? 'n/a' : `${s.engagementRate.value}%`} sub={change(s.engagementRate.change, 'pts')} />
              {s.followers.total !== null && <Tile label="Followers" value={metric(s.followers.total)} sub={`${s.followers.change > 0 ? '+' : ''}${s.followers.change} in window`} />}
              {METRIC_ROWS.map(([k, label]) => <Tile key={k} label={label} value={s.metrics[k].value === null ? 'n/a' : metric(s.metrics[k].value)} sub={s.metrics[k].value === null ? 'not exposed' : change(s.metrics[k].change)} />)}
            </div>
          </>
        ) : <Empty>{summary.loading ? 'Loading…' : 'No data.'}</Empty>}
      </Card>

      <div className="zr-pk-grid2">
        <Card title="Engagement over time">{series.data?.series?.length ? <Bars series={series.data.series} /> : <Empty>No engagement measured in this window.</Empty>}</Card>
        <Card title={`Best times to post (${tz})`}>{best.data?.cells?.length ? <HeatGrid cells={best.data.cells} /> : <Empty>Not enough posts yet.</Empty>}</Card>
      </div>

      <div className="zr-pk-grid2">
        <Card title="Top posts">
          {top.data?.posts?.length ? <table className="zr-pk-table"><thead><tr><th>Post</th><th>Source</th><th>Eng.</th><th>Views</th></tr></thead><tbody>{top.data.posts.map((p) => <tr key={p.id}><td><PlatformDot platform={p.platform} label={(p.caption || p.platformPostId || '').slice(0, 48)} /></td><td><Badge tone={p.source === 'external' ? 'muted' : 'info'}>{p.source === 'plugkit' ? 'postkit' : p.source}</Badge></td><td><Metric value={p.engagement} /></td><td><Metric value={p.metrics?.views} /></td></tr>)}</tbody></table> : <Empty>No post in this window.</Empty>}
        </Card>
        <Card title="By account">
          {accounts.data?.accounts?.length ? <table className="zr-pk-table"><thead><tr><th>Account</th><th>Posts</th><th>Rate</th><th>Reach</th></tr></thead><tbody>{accounts.data.accounts.map((a) => <tr key={a.accountId}><td><PlatformDot platform={a.platform} label={`@${a.username}`} /></td><td><Num>{a.posts}</Num></td><td>{a.engagementRate === null ? <Metric value={null} /> : <Num>{a.engagementRate}%</Num>}</td><td><Metric value={a.metrics.reach} /></td></tr>)}</tbody></table> : <Empty>No account.</Empty>}
        </Card>
      </div>

      <div className="zr-pk-grid2">
        <Card title="Engagement accumulation">
          {acc.data?.buckets?.length ? <ul className="zr-pk-bars">{acc.data.buckets.map((b) => <li key={b.bucket}><span>{b.bucket}</span><i style={{ width: `${b.share}%` }} /><Num>{b.share}%</Num><small>{b.samples} post(s)</small></li>)}</ul> : <Empty>Fills in as your posts age: each one is measured again and again.</Empty>}
        </Card>
        <Card title="Followers">
          {fol.data?.accounts?.length ? <ul className="zr-pk-list">{fol.data.accounts.map((a) => <li key={a.accountId} className="zr-pk-row"><PlatformDot platform={a.platform} label={`@${a.username}`} /><span className="zr-pk-spacer" /><Num>{metric(a.series[a.series.length - 1].followers)}</Num><Badge tone={a.growth >= 0 ? 'ok' : 'warn'}>{a.growth > 0 ? '+' : ''}{a.growth}</Badge></li>)}</ul> : <Empty>The series starts the day an account is connected: no platform hands back history it did not record.</Empty>}
        </Card>
      </div>
      <Card><ManualMetrics client={client} accounts={overview.data.accounts} reload={reloadAll} /></Card>
    </>
  )
}
