// 3 October 2026, 21:45 CEST: a diagram drilldown remains read-only and preserves source files.
import React from 'react'
import { afterEach, expect, it, vi } from 'vitest'
import { cleanup, fireEvent, render, screen, within } from '@testing-library/react'
import StorageBreakdown from './StorageBreakdown.jsx'
afterEach(cleanup)
it('shows proportional folders, drills into their files and opens the exact file only on request', () => {
  const files = [{ id: 'a', name: 'a.exr', relativePath: 'render/final/a.exr', size: 7000000 }, { id: 'b', name: 'b.png', relativePath: 'textures/b.png', size: 3000000 }]
  const before = JSON.stringify(files), onOpenFile = vi.fn()
  const { container } = render(<StorageBreakdown files={files} onOpenFile={onOpenFile} />)
  expect(screen.getByRole('img', { name: 'Diagramme de la répartition du volume' })).toBeTruthy()
  const legend = container.querySelector('.assets-storage-legend')
  expect(within(legend).getByText('70 %')).toBeTruthy()
  fireEvent.click(within(legend).getByRole('button', { name: /render\/final/ }))
  expect(onOpenFile).not.toHaveBeenCalled()
  expect(within(legend).getByText('.exr')).toBeTruthy()
  fireEvent.click(within(legend).getByRole('button', { name: /.exr/ }))
  expect(onOpenFile).toHaveBeenCalledWith(files[0])
  fireEvent.click(screen.getByRole('button', { name: 'Retour à la répartition' }))
  fireEvent.click(screen.getByRole('button', { name: 'Fichiers', exact: true }))
  fireEvent.click(within(legend).getByRole('button', { name: /a.exr/ }))
  expect(onOpenFile).toHaveBeenCalledWith(files[0])
  fireEvent.click(screen.getByRole('button', { name: 'Types', exact: true }))
  expect(within(legend).getByText('.exr')).toBeTruthy()
  expect(JSON.stringify(files)).toBe(before)
})
