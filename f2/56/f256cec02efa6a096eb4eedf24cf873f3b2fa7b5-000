// 14 October 2026: guard. Every player saves its speed and its subtitle choice through playerPrefs.js; VideoPlayer2 also saves the
// audio language and the quality. Without this, one player quietly goes back to forgetting the choices between two videos.
// FR : garde : chaque lecteur sauvegarde vitesse et sous-titres par playerPrefs.js ; sinon un lecteur oublie a nouveau d'une video a l'autre.
import { describe, it, expect } from 'vitest'
import fs from 'node:fs'
import path from 'node:path'

const read = (name) => fs.readFileSync(path.resolve(__dirname, '../components', name), 'utf8')

describe('player preferences are wired in every player', () => {
  it.each(['VideoPlayer2.jsx', 'VideoPlayer.jsx', 'StreamVideo.jsx', 'StreamVideoMSE.jsx'])('%s saves and restores the speed', (name) => {
    const src = read(name)
    expect(src).toContain("from '../media/playerPrefs.js'")
    expect(src).toMatch(/readPlayerPrefs\(playerStorage\(\)\)\.speed/)
    expect(src).toContain('PLAYER_PREF_KEYS.speed')
  })
  it.each(['VideoPlayer2.jsx', 'VideoPlayer.jsx', 'StreamVideo.jsx', 'StreamVideoMSE.jsx'])('%s saves the subtitle language and on/off', (name) => {
    const src = read(name)
    expect(src).toContain('PLAYER_PREF_KEYS.subLang')
    expect(src).toContain('PLAYER_PREF_KEYS.subsOn')
  })
  it('VideoPlayer2 also saves the audio language and the quality, and picks the track again for each film', () => {
    const src = read('VideoPlayer2.jsx')
    expect(src).toContain('PLAYER_PREF_KEYS.audioLang')
    expect(src).toContain('PLAYER_PREF_KEYS.qualityHeight')
    expect(src).toMatch(/findByLang\(availableSubTracks/)
    expect(src).toMatch(/subSignature/)
  })
  it('RED: the track is no longer chosen by its first position only', () => {
    expect(read('VideoPlayer2.jsx')).not.toMatch(/useState\(\(\) => \(availableSubTracks\[0\] \? availableSubTracks\[0\]\.id : null\)\)/)
  })
})
