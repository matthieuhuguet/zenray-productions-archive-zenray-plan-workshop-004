// 5 October 2026: the daily batch. A handful of the best vacancies, each with its letter one click away and its application page
// beside it; "Fait" records the application with today's date so the history stays true. Nothing is ever sent from here.
// FR : le lot du jour. Quelques-unes des meilleures annonces, chacune avec sa lettre a un clic et sa page de candidature ; "Fait" date la candidature.
import React, { useEffect, useMemo, useState } from 'react'
import { BATCH, doneToday, pickBatch } from '../../lib/freelanceBatch.js'
import { addMessage, readableDate } from '../../lib/freelanceStudios.js'
import { countryOf, currentVersion, kindLabel, scoreOf, sourceLabelOf, tierOf } from '../../lib/freelanceEngineModel.js'
import { urlLectureAffichage } from '../../lib/urlLecture.js'
import { notify } from '../Notifications.jsx'
import { UI } from '../../config/colors.js'
import { Button, GlassPill, P, Panel } from './ui.jsx'

// 14 October 2026: the letter of a vacancy copied straight from the batch card, without opening the sheet first.
// FR : la lettre d'une annonce copiee depuis la carte du lot, sans ouvrir la fiche.
async function copyLetterOf(studio) {
  const path = studio.engine?.letterPath
  if (!path) { notify({ title: 'Pas de lettre prête', body: 'Ouvre la fiche pour la générer.' }); return false }
  try {
    const response = await (await fetch(urlLectureAffichage(path, { fresh: true }), { cache: 'no-cache' })).json()
    const archive = response && typeof response.markdown === 'string' ? JSON.parse(response.markdown) : null
    const version = archive && Array.isArray(archive.versions) ? currentVersion(archive) : null
    if (!version?.text) throw new Error('empty')
    await navigator.clipboard.writeText(version.text)
    notify({ title: `Lettre copiée : ${studio.name}`, body: 'Prête à coller dans le formulaire.' })
    return true
  } catch {
    notify({ title: 'Copie impossible', body: 'Ouvre la fiche pour relire et copier la lettre.' })
    return false
  }
}

// 6 October 2026, 02:47: reset the former default once, then retain future explicit choices.
const SIZE_KEY = 'zr:freelance:batchSize:v2'
const readSize = () => { try { const n = Number(localStorage.getItem(SIZE_KEY)); return BATCH.sizes.includes(n) ? n : BATCH.defaultSize } catch { return BATCH.defaultSize } }
const TIER_COLOR = { high: UI.green, medium: UI.orange, low: UI.gray }

export default function FreelanceBatch({ t, studios, today, open, onToggle, onOpen, onChange, bridge = null }) {
  const [size, setSize] = useState(readSize)
  const [busy, setBusy] = useState('')
  const [help, setHelp] = useState(false)
  const [note, setNote] = useState('')
  const [confirmAll, setConfirmAll] = useState(false)
  const { picked, waiting, duplicates } = useMemo(() => pickBatch(studios, { today, size }), [studios, today, size])
  const done = doneToday(studios, today)
  const chooseSize = (n) => { setSize(n); try { localStorage.setItem(SIZE_KEY, String(n)) } catch {} }
  const markDone = async (studio) => {
    setBusy(studio.id)
    const via = studio.engine?.applyUrl || studio.link || 'page de candidature'
    await onChange(addMessage(studio, { text: `Candidature faite depuis le lot du jour (${via}). Le texte exact envoyé n’a pas été copié ici ; la dernière lettre écrite pour cette offre reste dans sa fiche.`, channel: 'mail' }))
    setBusy('')
  }
  // 16 October 2026: "Préparer N candidatures" starts ZenRay Apply on this Mac through the local service: it pre-fills the best N forms
  // (details, CV, exact letter) and stops before sending. Matthieu reviews in a window and sends himself; "Fait" dates what he sent.
  // FR : « Préparer N candidatures » lance ZenRay Apply via le service local ; rien n'est envoyé, Matthieu relit, envoie, puis « Fait ».
  const [apply, setApply] = useState(null)
  const [applyNote, setApplyNote] = useState('')
  const [confirmSent, setConfirmSent] = useState(false)
  const refreshApply = async () => { try { setApply(await bridge.applyStatus()) } catch { setApply(null) } }
  useEffect(() => { if (bridge?.applyStatus) refreshApply() }, [])
  useEffect(() => {
    if (!apply?.running) return undefined
    const timer = setInterval(refreshApply, 3000)
    return () => clearInterval(timer)
  }, [apply?.running])
  const startApply = async () => {
    setApplyNote('')
    try { const result = await bridge.applyStart(size); if (!result.started) setApplyNote('Une préparation est déjà en cours.'); await refreshApply() } catch (error) { setApplyNote(error.message || 'Le service local ne répond pas.') }
  }
  const openReady = async () => { setApplyNote(''); try { await bridge.applyOpen(); setApplyNote('Les pages prêtes s’ouvrent dans une fenêtre : relis, réponds aux questions, envoie, puis « Fait ».') } catch (error) { setApplyNote(error.message) } }
  const readyItems = (apply?.run?.items || []).filter((item) => item.phase === 'ready')
  const studioOf = (id) => studios.find((entry) => entry.id === id)
  const markReadyDone = async () => {
    if (!confirmSent) { setConfirmSent(true); return }
    setConfirmSent(false); setBusy('all')
    for (const item of readyItems) { const entry = studioOf(item.id); if (entry && entry.status === 'to_contact') await markDone(entry) }
    setBusy('')
  }
  const urls = picked.map(({ studio }) => studio.engine?.applyUrl || studio.link).filter(Boolean)
  // 14 October 2026: one click opens the whole batch as tabs through the local service (no pop-up blocker); the browser is the fallback.
  const openAll = async () => {
    setNote('')
    try {
      if (!bridge?.openLinks) throw new Error('no bridge')
      const result = await bridge.openLinks(urls)
      setNote(`${result.opened} onglet${result.opened > 1 ? 's' : ''} ouvert${result.opened > 1 ? 's' : ''}${result.skipped?.length ? ` · ${result.skipped.length} lien${result.skipped.length > 1 ? 's' : ''} écarté${result.skipped.length > 1 ? 's' : ''}` : ''}.`)
    } catch {
      let opened = 0
      for (const url of urls) { if (window.open(url, '_blank', 'noopener,noreferrer')) opened += 1 }
      setNote(opened === urls.length ? `${opened} onglet${opened > 1 ? 's' : ''} ouvert${opened > 1 ? 's' : ''}.`
        : `Le service local est éteint : le navigateur n’a ouvert que ${opened} onglet${opened > 1 ? 's' : ''} sur ${urls.length}. Autorise les fenêtres pour ce site ou rallume le service.`)
    }
  }
  const markAllDone = async () => {
    if (!confirmAll) { setConfirmAll(true); return }
    setConfirmAll(false); setBusy('all')
    for (const { studio } of picked) await markDone(studio)
    setBusy('')
  }
  const small = { fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, lineHeight: 1.5 }
  const ellipsis = { overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }
  return (
    <Panel t={t} title="Lot du jour" open={open} onToggle={onToggle} aside={`${picked.length} à envoyer · ${done} faite${done > 1 ? 's' : ''} aujourd’hui`}>
      <div style={{ display: 'flex', gap: 8, alignItems: 'center', flexWrap: 'wrap', marginBottom: 10 }}>
        {BATCH.sizes.map((n) => <GlassPill key={n} t={t} onClick={() => chooseSize(n)} active={size === n} title={`Un lot de ${n} candidatures`}>{n}</GlassPill>)}
        <GlassPill t={t} onClick={() => setHelp(!help)} active={help} title="Comment ça marche">?</GlassPill>
        <Button t={t} primary small disabled={!urls.length} onClick={openAll} title="Ouvre toutes les pages de candidature du lot, chacune dans son onglet">Ouvrir les {urls.length} pages</Button>
        <Button t={t} small disabled={!picked.length || busy === 'all'} onClick={markAllDone} title="Enregistre toutes les candidatures du lot avec la date d’aujourd’hui">{confirmAll ? `Confirmer : ${picked.length} faites ?` : 'Tout marquer fait'}</Button>
        <span style={{ ...small, marginLeft: 'auto' }} title="Annonces pertinentes qui attendent un prochain lot, et postes publiés plusieurs fois comptés une seule fois">{waiting.length} en attente · {duplicates} doublon{duplicates > 1 ? 's' : ''} écarté{duplicates > 1 ? 's' : ''}</span>
      </div>
      {note && <p role="status" style={{ ...small, margin: '0 0 10px' }}>{note}</p>}
      {bridge?.applyStart && (
        <div style={{ margin: '0 0 12px', padding: '10px 12px', border: `1px solid ${t.border}`, borderRadius: P.radius }}>
          <div style={{ display: 'flex', gap: 8, alignItems: 'center', flexWrap: 'wrap' }}>
            <Button t={t} primary small disabled={Boolean(apply?.running)} onClick={startApply} title="Pré-remplit les meilleures offres à formulaire (coordonnées, CV, lettre) dans un navigateur privé, sans rien envoyer">{apply?.running ? `Préparation de ${apply.size} en cours…` : `Préparer ${size} candidatures`}</Button>
            {apply?.run && <span style={small}><span style={{ fontFamily: P.serif, fontWeight: P.numberWeight }}>{apply.run.ready}</span> prêtes · <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight }}>{apply.run.blocked}</span> bloquées{apply.run.totalSeconds != null ? ` · ${Math.round(apply.run.totalSeconds)} s` : ''}</span>}
            {readyItems.length > 0 && <Button t={t} small onClick={openReady} title="Rouvre les pages prêtes pré-remplies dans une fenêtre pour relire et envoyer toi-même">Ouvrir les {readyItems.length} prêtes</Button>}
            {readyItems.length > 0 && <Button t={t} small disabled={busy === 'all'} onClick={markReadyDone} title="À utiliser après ton envoi : date les prêtes comme candidatures faites">{confirmSent ? `Confirmer : ${readyItems.length} envoyées ?` : 'J’ai envoyé les prêtes'}</Button>}
          </div>
          <p style={{ ...small, margin: '6px 0 0' }}>Rien n’est envoyé d’ici : tu relis, tu réponds aux questions sensibles, tu envoies, puis « J’ai envoyé ».{!apply && ' Service local éteint ou injoignable.'}</p>
          {applyNote && <p role="status" style={{ ...small, margin: '6px 0 0' }}>{applyNote}</p>}
          {apply?.error && <p role="status" style={{ ...small, margin: '6px 0 0' }}>Dernière préparation en échec : {apply.error}</p>}
          {apply?.run && (
            <div style={{ display: 'grid', gap: 3, marginTop: 8 }}>
              {apply.run.items.map((item) => (
                <div key={item.id} style={{ display: 'flex', gap: 8, alignItems: 'baseline', ...small, fontSize: 12 }} title={item.note}>
                  <span aria-hidden="true" style={{ width: 8, height: 8, borderRadius: 999, background: item.phase === 'ready' ? UI.green : UI.gray, flex: 'none' }} />
                  <span style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 14, color: t.textPrimary }}>{item.studio}</span>
                  <span style={{ flex: 1, minWidth: 0, ...ellipsis }}>{item.note}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      )}
      {help && (
        <p style={{ ...small, margin: '0 0 12px' }}>
          Les meilleures annonces ouvertes, une fois chacune (le même poste publié dans plusieurs pays compte pour un), deux au plus par studio.
          « Lettre » ouvre la fiche pour relire et copier le texte, « candidater » ouvre la page du studio, « Fait » date la candidature.
          La pastille et le chiffre disent l’adéquation avec ton CV sur 100 (vert 60 et plus, orange 40 à 59).
        </p>
      )}
      {!picked.length && <p style={small}>Rien à envoyer pour l’instant : tout ce qui est pertinent est déjà traité. La prochaine recherche automatique en apportera peut-être.</p>}
      <div style={{ display: 'grid', gap: 6 }}>
        {picked.map(({ studio, duplicates: repeats }, index) => {
          const pastel = P.batchPastels[index % P.batchPastels.length]
          const country = countryOf(studio)
          const locationLabel = country.code !== 'OTHER' ? `${country.flag} ${studio.city || country.label}` : studio.city
          const meta = [locationLabel, kindLabel(studio), sourceLabelOf(studio), studio.engine?.validThrough ? `réponse avant le ${readableDate(studio.engine.validThrough)}` : ''].filter(Boolean).join(' · ') + (repeats ? ` · publié ${repeats + 1} fois` : '')
          return (
            <div key={studio.id} style={{ display: 'flex', gap: 12, alignItems: 'center', border: `1px solid ${t.border}`, borderLeft: `3px solid ${pastel}`, background: `${pastel}25`, borderRadius: P.radius, padding: '8px 12px' }}>
              <span title={`Adéquation avec ton CV : ${scoreOf(studio)} sur 100`} style={{ display: 'inline-flex', alignItems: 'center', gap: 6, minWidth: 42, fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 13 }}>
                <span aria-hidden="true" style={{ width: 9, height: 9, borderRadius: 999, background: TIER_COLOR[tierOf(studio)] || UI.gray }} />{scoreOf(studio)}
              </span>
              <span style={{ flex: 1, minWidth: 0 }} title={`${studio.name} · ${studio.role}`}>
                <span style={{ display: 'block', ...ellipsis }}>
                  <span style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 15.5 }}>{studio.name}</span>
                  <span style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>{'  ·  '}{studio.role}</span>
                </span>
                <span style={{ display: 'block', ...small, fontSize: 12, ...ellipsis }}>{meta}</span>
              </span>
              <Button t={t} primary small onClick={() => onOpen(studio.id)} title="Ouvre la fiche : lettre prête à relire et copier">Lettre</Button>
              {studio.engine?.letterPath && <Button t={t} small onClick={() => copyLetterOf(studio)} title="Copie la lettre prête, à coller dans le formulaire">Copier</Button>}
              {(studio.engine?.applyUrl || studio.link) && <a href={studio.engine?.applyUrl || studio.link} target="_blank" rel="noreferrer" title="Page de candidature du studio" style={{ ...small, textDecoration: 'none' }}>↗</a>}
              <Button t={t} small disabled={busy === studio.id} onClick={() => markDone(studio)} title="Enregistre la candidature avec la date d’aujourd’hui">Fait</Button>
            </div>
          )
        })}
      </div>
    </Panel>
  )
}
