import { describe, it, expect, vi, beforeEach } from 'vitest'

// ═══ UN ÉCHEC PASSAGER NE DOIT PAS DURER TOUTE LA SESSION ═══════════════════════════════════════
//
// Symptôme réel (2026-08-31) : « Lien média indisponible » sur des images existantes, pendant que le
// quota GitHub était épuisé — et l'image restait indisponible APRÈS le rétablissement du quota,
// jusqu'au rechargement de la page. L'échec survivait très largement à sa cause.

vi.mock('./manifestReadCache.js', () => ({ readPageCached: vi.fn() }))
const { readPageCached } = await import('./manifestReadCache.js')
const { resolveEaglePath, __resetEagleLinkCache } = await import('./eagleLink.js')

beforeEach(() => { vi.clearAllMocks(); __resetEagleLinkCache?.() })

describe('le cache de résolution garde les succès, oublie les échecs', () => {
  it('LE BUG : après un échec de quota, un second regard RÉESSAIE', async () => {
    readPageCached
      .mockResolvedValueOnce(null)                                            // quota épuisé
      .mockResolvedValueOnce({ ok: true, path: 'pages/vrai.img.json', linked: true })
    const premier = await resolveEaglePath('pages/lien.img.json')
    expect(premier.linked).toBe(false)
    const second = await resolveEaglePath('pages/lien.img.json')
    // Sans le correctif, cette ligne rendait encore l'échec mémorisé.
    expect(second.path).toBe('pages/vrai.img.json')
    expect(readPageCached).toHaveBeenCalledTimes(2)
  })

  it('un SUCCÈS reste en cache — on ne redemande pas ce qu’on sait', async () => {
    readPageCached.mockResolvedValue({ ok: true, path: 'pages/vrai.img.json', linked: true })
    await resolveEaglePath('pages/a.img.json')
    await resolveEaglePath('pages/a.img.json')
    expect(readPageCached).toHaveBeenCalledTimes(1)
  })

  it('« ce n’est pas un lien » est une réponse stable, donc cachée', async () => {
    readPageCached.mockResolvedValue({ ok: true, path: 'pages/direct.img.json', linked: false })
    const r = await resolveEaglePath('pages/direct.img.json')
    expect(r.linked).toBe(false)
    await resolveEaglePath('pages/direct.img.json')
    expect(readPageCached).toHaveBeenCalledTimes(1)
  })
})
