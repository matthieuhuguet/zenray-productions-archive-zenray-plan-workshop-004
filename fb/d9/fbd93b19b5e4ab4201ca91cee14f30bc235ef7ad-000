// upload-img-all.mjs — uploade TOUTES les images d'une arbo (récursif) via le pipeline image (vignette jsDelivr
// + original raw.github chiffré). Dest MIROIR du chemin. Saute celles DÉJÀ en ligne (.img.json présent).
// Démarre sur un shard NEUF (ZR_START_SHARD) -> aucun clone de shard plein.
//
// Usage : GITHUB_TOKEN=.. ZR_START_SHARD=11 node Scripts/upload-img-all.mjs "<racine>" "<préfixe dest>"

import { makeImgShardCtx, ingestImageBulk, resolveImgManifest } from './img-ingest.mjs'
import { pushBlobs } from './video-mse-lib.mjs'
import { loadZenrayDataInventory } from './lib/zenray-data-inventory.mjs'
import { readdir } from 'node:fs/promises'
import path from 'node:path'

const token = process.env.GITHUB_TOKEN
const OWNER = 'matthieuhuguet'
const DATA = 'zenray-data'
const REPO = '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress'
const ROOT = process.argv[2]
const DESTPREFIX = (process.argv[3] || 'pages/Photos/DJI').replace(/\/+$/, '')
if (!token || !ROOT) { console.error('usage: GITHUB_TOKEN=.. ZR_START_SHARD=NN node upload-img-all.mjs <racine> [destPrefix]'); process.exit(1) }

const IMGEXT = /\.(jpg|jpeg|png|heic|webp|avif|gif|tif|tiff|dng|bmp)$/i
const relOf = (f) => path.relative(ROOT, f)
const destOf = (f) => `${DESTPREFIX}/${path.dirname(relOf(f))}`.replace(/\/\.$/, '')
const manifestPathOf = (f) => `${destOf(f)}/${path.basename(f)}.img.json`

async function walk(dir) {
  const out = []
  for (const e of await readdir(dir, { withFileTypes: true })) {
    if (e.name.startsWith('.')) continue
    const p = path.join(dir, e.name)
    if (e.isDirectory()) out.push(...await walk(p))
    else if (IMGEXT.test(e.name)) out.push(p)
  }
  return out
}
const all = (await walk(ROOT)).sort()
console.log(`\n=== IMAGES sous ${ROOT} : ${all.length} trouvées ===`)
console.log('Inventaire Git zenray-data (une synchro, puis skips locaux)…')
const online = await loadZenrayDataInventory({ token, owner: OWNER, repo: DATA, prefix: DESTPREFIX })
const todo = []
for (const f of all) { if (online.has(manifestPathOf(f))) continue; todo.push(f) }
console.log(`=== À UPLOADER : ${todo.length} image(s) (le reste déjà en ligne) ===\n`)
if (!todo.length) { console.log('rien à uploader (tout déjà en ligne), aucun shard créé.'); process.exit(0) }

const ctx = makeImgShardCtx({ token, work: process.env.HOME + '/.zr-archive-work-img', repoRoot: REPO, log: (...a) => console.log('   ', ...a) })
await ctx.openShard()

let done = 0, batch = []
async function flushBatch() {
  if (!batch.length) return
  await ctx.flush()
  const blobs = []
  for (const b of batch) { try { blobs.push(resolveImgManifest(b, ctx)) } catch (e) { console.log(`  ⚠ résolution: ${(e.message || e).toString().slice(0, 80)}`) } }
  for (let i = 0; i < blobs.length; i += 200) await pushBlobs(token, DATA, blobs.slice(i, i + 200), `img bulk all`, () => {})
  batch = []
}
for (const f of todo) {
  try {
    const pending = await ingestImageBulk(f, path.basename(f), destOf(f), ctx)
    batch.push(pending); done++
    if (done % 40 === 0) { await flushBatch(); console.log(`✓ EN LIGNE ${done}/${todo.length} images`) }
  } catch (e) { console.log(`✗ ÉCHEC ${relOf(f)} : ${(e && e.message || e).toString().slice(0, 140)}`) }
}
await flushBatch()
console.log(`\n✓✓ BATCH IMG ALL COMPLET — ${done}/${todo.length} images uploadées.`)
