// 15 October 2026: a long list draws one page of cards and reveals the rest on request (617 vacancies were 10 000 DOM nodes).
it('draws 72 cards of a long group and reveals the rest by pages', async () => {
  const many = Array.from({ length: 200 }, (_, index) => base(`job_${index}`, `Studio ${String(index).padStart(3, '0')}`, { engine: engine({ score: 90 - (index % 50), firstSeenAt: '2026-09-01' }) }))
  const fetchMock = router()
  vi.stubGlobal('fetch', vi.fn(async (url, init) => {
    const u = String(url)
    if (u.startsWith('/api/page?action=read') && !u.includes('raw=1')) return { ok: true, json: async () => ({ sha: 'sha1', markdown: JSON.stringify({ v: 2, studios: many }) }) }
    return fetchMock(url, init)
  }))
  render(<FreelanceView t={t} />)
  await screen.findAllByText(/Studio \d{3}/)
  const toggle = screen.getByRole('button', { name: /Lot du jour/ })
  if (toggle.getAttribute('aria-expanded') === 'true') fireEvent.click(toggle)
  const cards = () => screen.getAllByText(/^Studio \d{3}$/)
  await waitFor(() => expect(cards().length).toBe(72))
  fireEvent.click(screen.getByRole('button', { name: /Afficher 72 de plus · 128 restantes/ }))
  await waitFor(() => expect(cards().length).toBe(144))
  fireEvent.click(screen.getByRole('button', { name: /Afficher 56 de plus · 56 restantes/ }))
  await waitFor(() => expect(cards().length).toBe(200))
  expect(screen.queryByRole('button', { name: /Afficher .* de plus/ })).toBeNull()
})
