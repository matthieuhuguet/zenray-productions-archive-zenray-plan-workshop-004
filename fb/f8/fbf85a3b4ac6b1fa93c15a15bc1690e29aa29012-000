const engine = (extra) => ({ source: 'afjv', sourceLabel: 'AFJV', kind: 'offer', score: 80, tier: 'high', skills: ['Houdini'], contactEmails: [], applyUrl: 'https://x/apply', firstSeenAt: '2026-09-01', lastSeenAt: today, missedRuns: 0, closedAt: '', ...extra })
const base = (id, name, extra = {}) => ({ id, name, role: 'Technical Artist', link: `https://x/${id}`, city: 'Paris', status: 'to_contact', createdAt: '2026-09-30', contactedAt: '', messages: [], history: [], notes: '', ...extra })
const studios = [
  base('job_new', 'Studio Neuf', { engine: engine({ firstSeenAt: today, letterPath: 'freelance/letters/job_new.json', scoreWhy: ['Poste proche du métier (+38)'] }) }),
  base('job_mid', 'Studio Moyen', { engine: engine({ score: 45, tier: 'medium', firstSeenAt: '2026-09-01' }) }),
  base('job_gone', 'Studio Fermé', { engine: engine({ score: 90, closedAt: '2026-10-03' }) }),
  base('crm', 'Une Personne', { role: 'Recruiter', link: '' }),
  base('job_refus', 'Voodoo', { role: 'Technical Artist (AI), Portfolio Games Team, Freelance', status: 'declined', contactedAt: '2026-10-06', messages: [{ at: '2026-10-06', channel: 'mail', text: 'sent' }], history: [{ at: '2026-10-12', from: 'contacted', to: 'declined', note: 'refus détecté par e-mail' }], engine: engine({ source: 'arbeitnow', sourceLabel: 'Arbeitnow', language: 'en', score: 67, firstSeenAt: '2026-10-05' }) }),
]
const letter = { v: 1, studioId: 'job_new', versions: [{ at: '2026-10-04T08:00:00Z', by: 'engine', subject: 'Objet de la lettre', text: 'Texte de la lettre.', lang: 'fr', kind: 'offer', hookSource: 'offer', reason: 'initial' }] }
const engineFile = { v: 1, lastRun: { finishedAt: new Date().toISOString(), added: 1 }, nextRunDue: new Date(Date.now() + 5 * 3600000).toISOString(), sources: [{ key: 'afjv', label: 'AFJV', listed: 104, matched: 31, complete: true, errors: [], checkedAt: new Date().toISOString() }], cv: { pdf: { fr: 'https://cdn/cv-fr.pdf', en: 'https://cdn/cv-en.pdf' }, updated: { fr: 'Octobre 2026' } }, latestWork: [{ title: 'Ceramic Tiles', url: 'https://matthieuhuguet.com/reels/ceramic' }], claude: { enabled: false, model: 'claude-sonnet-5-5', effort: 'medium' }, manualSearches: [{ board: 'LinkedIn', label: 'Technical Artist', url: 'https://www.linkedin.com/jobs/search/?keywords=technical%20artist' }] }
const template = { v: 1, status: 'seed', variables: { age: 25, portfolio: 'matthieuhuguet.com' }, hooks: {}, fr: { translated: false, blocks: { greeting: 'Bonjour', identity: 'Je m’appelle' }, reasons: { offer: 'Offre' }, subjects: { offer: 'Candidature' }, seekingVariants: {}, hookFromOffer: 'x', latestWork: 'y' }, en: { translated: true, blocks: {}, reasons: {}, subjects: {} } }

let saved
function router() {
  saved = []
  return vi.fn(async (url, init = {}) => {
    const u = String(url)
    const json = (data, ok = true) => ({ ok, json: async () => data })
    if (u.includes(':3101/api/freelance-engine')) return json({ running: null, lastOk: true, lastReport: null, nextRunDue: engineFile.nextRunDue })
    if (u.startsWith('/api/page?action=read')) {
      const path = decodeURIComponent(u.match(/path=([^&]+)/)[1])
      if (u.includes('raw=1')) {
        const data = { 'freelance/engine.json': engineFile, 'freelance/letter-template.json': template, 'freelance/letters/job_new.json': letter }[path]
        return data ? json({ markdown: JSON.stringify(data) }) : json({ missing: true })
      }
      return json({ sha: 'sha1', markdown: JSON.stringify({ v: 2, studios }) })
    }
    if (u === '/api/page' && init.method === 'POST') { const body = JSON.parse(init.body); saved.push(body); return json({ ok: true, sha: 'sha2' }) }
    return json({}, false)
  })
}
beforeEach(() => { vi.stubGlobal('fetch', router()); localStorage.clear() })
afterEach(() => { cleanup(); vi.unstubAllGlobals() })

// The daily batch is open by default and repeats the best cards; the list tests close it first so each card appears once.
// FR : le lot du jour est ouvert par defaut et repete les meilleures fiches ; les tests de liste le ferment d'abord.
const loaded = async () => { await screen.findAllByText('Studio Neuf'); const toggle = screen.getByRole('button', { name: /Lot du jour/ }); if (toggle.getAttribute('aria-expanded') === 'true') fireEvent.click(toggle); await screen.findByText('Studio Neuf') }

it('shows the vacancies by fit, flags the new one, hides the closed one, and counts them', async () => {
  render(<FreelanceView t={t} />)
  await loaded()
  expect(screen.getByText('Studio Moyen')).toBeTruthy()
  expect(screen.queryByText('Studio Fermé')).toBeNull()
  expect(screen.getByText('Nouveau', { selector: 'span' })).toBeTruthy()
  expect(screen.getByText('Lettre prête')).toBeTruthy()
  expect(screen.getByText(/3 à contacter \(1 nouvelle\)/)).toBeTruthy()
  const names = screen.getAllByTitle(/Studio|Une Personne/).map((node) => node.getAttribute('title'))
  expect(names.indexOf('Studio Neuf')).toBeLessThan(names.indexOf('Studio Moyen'))
  expect(await screen.findByRole('status')).toHaveTextContent('dernière recherche')
})

it('puts the feedback mail one click away on the refused card, without opening the studio', async () => {
  Object.assign(navigator, { clipboard: { writeText: vi.fn().mockResolvedValue() } })
  render(<FreelanceView t={t} />)
  await loaded()
  expect(screen.getByText(/Refus reçus/)).toBeTruthy()
  expect(screen.getByText('Refusé', { selector: 'span' })).toBeTruthy()
  const group = screen.getByRole('group', { name: 'Demande de retour : Voodoo' })
  expect(within(group).getByText('pas encore envoyé')).toBeTruthy()
  fireEvent.click(within(group).getByRole('button', { name: 'Copier le mail' }))
  await waitFor(() => expect(navigator.clipboard.writeText).toHaveBeenCalledTimes(1))
  expect(navigator.clipboard.writeText.mock.calls[0][0].startsWith('Hello Voodoo team,')).toBe(true)
  fireEvent.click(within(group).getByRole('button', { name: 'FR' }))
  fireEvent.click(within(group).getByRole('button', { name: 'Copier le mail' }))
  await waitFor(() => expect(navigator.clipboard.writeText).toHaveBeenCalledTimes(2))
  expect(navigator.clipboard.writeText.mock.calls[1][0].startsWith('Bonjour l’équipe Voodoo,')).toBe(true)
  expect(saved).toHaveLength(0)
  fireEvent.click(within(group).getByRole('button', { name: 'Ouvrir la fiche' }))
  expect(await screen.findByLabelText('Mail')).toBeTruthy()
})

