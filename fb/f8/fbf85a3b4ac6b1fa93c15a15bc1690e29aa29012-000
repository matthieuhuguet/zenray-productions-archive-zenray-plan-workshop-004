it('opens an application with its letter and logs the exact text as sent only on request', async () => {
  render(<FreelanceView t={t} />)
  fireEvent.click(await screen.findByTitle('Studio Neuf'))
  expect(await screen.findByLabelText('Lettre')).toHaveValue('Texte de la lettre.')
  expect(screen.getByText(/Poste proche du métier/, { exact: false })).toBeTruthy()
  expect(saved).toHaveLength(0)
  fireEvent.click(screen.getByRole('button', { name: 'Marquer comme envoyée' }))
  await waitFor(() => expect(saved).toHaveLength(1))
  const store = JSON.parse(saved[0].markdown)
  const studio = store.studios.find((s) => s.id === 'job_new')
  expect(studio.messages).toEqual([{ at: today, channel: 'mail', text: 'Texte de la lettre.' }])
  expect(studio.status).toBe('contacted')
  expect(store.studios.find((s) => s.id === 'job_mid').engine.score).toBe(45)
})

