  signature: 'Matthieu Huguet',
  layout: ['greeting', 'thanks', 'ask', 'q1', 'q2', 'easy', 'future', 'closing', 'signature'],
  en: {
    subject: 'Feedback request: {role}',
    subjectNoRole: 'Feedback request about my application',
    blocks: {
      greeting: 'Hello {studio} team,',
      thanks: 'Thank you for your answer about the {role} position, and for the time you took to review my application.',
      thanksNoRole: 'Thank you for your answer, and for the time you took to review my application.',
      ask: 'I understand that the team is focusing on profiles closer to its immediate needs. A short piece of feedback from you would help me a lot to improve my profile:',
      q1: '1. Which part of my profile or portfolio was the furthest from what the team needs right now (level of experience, tools, type of projects)?',
      q2: '2. Is there one thing you would have liked to see in my application, that I could work on before applying again?',
      easy: 'Two lines are more than enough.',
      future: 'I would also be glad to be considered for a future opening that fits better.',
      closing: 'Thank you again, and I wish you and the team the best.',
      signature: '{signature}\n{portfolio}',
    },
  },
  fr: {
    subject: 'Demande de retour : {role}',
    subjectNoRole: 'Demande de retour sur ma candidature',
    blocks: {
      greeting: 'Bonjour l’équipe {studio},',
      thanks: 'Merci pour votre réponse concernant le poste « {role} », et pour le temps consacré à l’étude de ma candidature.',
      thanksNoRole: 'Merci pour votre réponse, et pour le temps consacré à l’étude de ma candidature.',
      ask: 'Je comprends que l’équipe se concentre sur des profils plus proches de ses besoins immédiats. Un court retour de votre part m’aiderait beaucoup à améliorer mon profil :',
      q1: '1. Quelle partie de mon profil ou de mon portfolio était la plus éloignée de ce que l’équipe recherche en ce moment (niveau d’expérience, outils, type de projets) ?',
      q2: '2. Y a-t-il un élément précis que vous auriez aimé voir dans ma candidature, et sur lequel je pourrais travailler avant de postuler à nouveau ?',
      easy: 'Deux lignes me suffisent largement.',
