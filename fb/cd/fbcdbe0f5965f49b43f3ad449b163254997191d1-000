/** The studio field that remembers the request was sent: written once, by the page, when he says so. */
export const FEEDBACK_SENT_FIELD = 'feedbackRequestedAt'

/** The studio as a greeting wants it: "d3t (Keywords Studios)" greets "d3t". */
export const greetingName = (name) => String(name || '').replace(/\s*\([^)]*\)\s*$/, '').trim() || String(name || '').trim()

/** A role as a sentence wants it: no studio tag in brackets, no contract hint at the end. */
export function cleanRole(role) {
  return String(role || '')
    .replace(/^\s*\[[^\]]*\]\s*/, '')
    .replace(/\s*\((?=[^)]*(?:contract|cdd|cdi|stage|intern|fixed term|h\/f|f\/h|m\/f|w\/m|full[- ]time|part[- ]time|\d+[- ]month))[^)]*\)\s*$/i, '')
    .replace(/\s*[,\-–]\s*freelance\s*$/i, '')
    .replace(/\s+/g, ' ')
    .trim()
}

/** A refusal is the only state this mail belongs to. */
export const canRequestFeedback = (studio) => Boolean(studio) && studio.status === 'declined'

/** The language the studio wrote in: its listing language, French when unknown. */
export const feedbackLanguage = (studio) => (studio && studio.engine && studio.engine.language === 'en' ? 'en' : 'fr')

/** The day the refusal was recorded: the last status change to `declined`, else the last message. */
export function refusalDate(studio) {
  if (!studio) return ''
  const events = (Array.isArray(studio.history) ? studio.history : []).filter((entry) => entry && entry.to === 'declined')
  const fromHistory = events.length ? toIsoDate(events[events.length - 1].at) : ''
  if (fromHistory) return fromHistory
  const messages = Array.isArray(studio.messages) ? studio.messages : []
  return messages.length ? toIsoDate(messages[messages.length - 1].at) : ''
}

function fill(text, values, where) {
  return text.replace(/\{([a-zA-Z]+)\}/g, (match, name) => {
    if (!(name in values)) throw new Error(`Feedback request parameter {${name}} has no value (${where})`)
    return values[name]
  })
}

const noLongDash = (text) => String(text).replace(/\s*[–—]\s*/g, ', ')

/**
 * Composes the mail. `role` overrides the stored role (the refusal may name the position differently).
 * Returns { lang, subject, text }. Pure.
 */
export function buildFeedbackRequest({ studio, lang, role, config = FEEDBACK_REQUEST } = {}) {
  if (!studio) throw new Error('A feedback request needs a studio')
  const language = FEEDBACK_LANGS.includes(lang) ? lang : feedbackLanguage(studio)
  const part = config[language]
  const cleanedRole = cleanRole(role !== undefined && role !== null ? role : studio.role)
  const values = { studio: greetingName(studio.name), role: cleanedRole, signature: config.signature, portfolio: config.portfolio }
  const blocks = { ...part.blocks, thanks: cleanedRole ? part.blocks.thanks : part.blocks.thanksNoRole }
  const paragraphs = config.layout.map((id) => {
    if (!(id in blocks)) throw new Error(`Feedback request layout names a block that does not exist: ${id}`)
    return fill(blocks[id], values, id).trim()
  }).filter(Boolean)
  const subject = fill(cleanedRole ? part.subject : part.subjectNoRole, values, 'subject')
  return { lang: language, subject: noLongDash(subject), text: noLongDash(paragraphs.join('\n\n')) }
}
