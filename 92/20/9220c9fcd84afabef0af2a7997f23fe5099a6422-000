// 2026-09-12 ZenRay Freelance v2: the studios to contact, the ones already contacted, the exact
// message that was sent, and the dated trail of every state change.
//
// FR : les studios a contacter, ceux deja contactes, le message exact qui a ete envoye, et la trace
// datee de chaque changement d'etat.
//
// Pure module: strings, dates and objects only, no browser API, so the whole model is testable.
// Every write returns a NEW studio: the stored history is append-only, exactly like PROGRESS.md.
// FR : module pur, chaque ecriture rend un NOUVEAU studio et l'historique ne se reecrit jamais.
import { UI } from '../config/colors.js'
import { kindForName } from './fileKinds.js'

/** The pipeline, in order. Keys are written into the data and never change; labels are shown. */
export const STATUSES = [
  { key: 'to_contact', label: 'À contacter', color: UI.gray },
  { key: 'contacted', label: 'Contacté', color: UI.orange },
  { key: 'replied', label: 'A répondu', color: UI.blue },
  { key: 'interview', label: 'Entretien', color: UI.purple },
  { key: 'offer', label: 'Offre reçue', color: UI.green },
  { key: 'declined', label: 'Refusé', color: UI.red },
  { key: 'deprecated', label: 'Périmé', color: '#8E8E93' },
  { key: 'archived', label: 'Archivé', color: UI.yellow },
]
const BY_KEY = Object.fromEntries(STATUSES.map((s) => [s.key, s]))
/** A status is "contacted" from the moment a message left: the dot turns on at the first message. */
export const CONTACTED_FROM = ['contacted', 'replied', 'interview', 'offer', 'declined']

// The legacy French statuses of the 2026 application tracker, kept readable forever.
const LEGACY_STATUS = {
  'Postulé': 'contacted',
  'Relancé': 'contacted',
  'Entretien': 'interview',
  'Offre reçue': 'offer',
  'Refusé': 'declined',
  'Abandonné': 'archived',
  'Périmé': 'deprecated',
  'Perime': 'deprecated',
  'Deprecated': 'deprecated',
}

export const isoDay = (d = new Date()) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`

// 07 October 2026: robust ISO date normalizer supporting YYYY-MM-DD, timestamps and ISO strings.
export function toIsoDate(val) {
  if (!val) return ''
  const s = String(val).trim()
  if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0, 10)
  if (/^\d{10,13}$/.test(s)) {
    const num = Number(s)
    const ms = s.length === 10 ? num * 1000 : num
    const d = new Date(ms)
    if (!Number.isNaN(d.getTime())) return d.toISOString().slice(0, 10)
  }
  const d = new Date(s)
  if (!Number.isNaN(d.getTime()) && d.getFullYear() > 2000) return d.toISOString().slice(0, 10)
  return ''
}

const MONTHS = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre']
/** `2026-09-12` or `2026-09-12T08:30:00Z` become `12 septembre 2026`. */
export const readableDate = (iso) => {
  const norm = toIsoDate(iso)
  if (!norm) return ''
  const mIndex = Number(norm.slice(5, 7)) - 1
  if (mIndex < 0 || mIndex >= MONTHS.length) return ''
  return `${Number(norm.slice(8, 10))} ${MONTHS[mIndex]} ${norm.slice(0, 4)}`
}

export function parseIsoDate(val) {
  const norm = toIsoDate(val)
  if (!norm) return null
  const d = new Date(norm + 'T00:00:00Z')
  return Number.isNaN(d.getTime()) ? null : d
}

export function daysDiff(fromIso, toIso) {
  const d1 = parseIsoDate(fromIso)
  const d2 = parseIsoDate(toIso)
  if (!d1 || !d2) return null
  return Math.round((d2.getTime() - d1.getTime()) / (1000 * 60 * 60 * 24))
}

export function foundDateOf(studio) {
  if (!studio) return ''
  return toIsoDate(studio.engine?.publishedAt) || toIsoDate(studio.engine?.firstSeenAt) || toIsoDate(studio.createdAt) || toIsoDate(studio.date) || ''
}

export function contactedDateOf(studio) {
  if (!studio) return ''
  return toIsoDate(studio.contactedAt) || (studio.messages?.length ? toIsoDate(studio.messages[0].at) : '') || ''
}

export function chronologyOf(studio, today = isoDay()) {
  const foundAt = foundDateOf(studio)
  const contactedAt = contactedDateOf(studio)
  const publishedAt = toIsoDate(studio?.engine?.publishedAt)
  const closedAt = toIsoDate(studio?.engine?.closedAt)
  const lastMsg = studio?.messages?.length ? studio.messages[studio.messages.length - 1] : null
  const lastActivityAt = toIsoDate(lastMsg?.at) || (studio?.history?.length ? toIsoDate(studio.history[studio.history.length - 1].at) : '') || contactedAt || foundAt || ''

  const daysToContact = (foundAt && contactedAt) ? daysDiff(foundAt, contactedAt) : null
  const daysSinceFound = foundAt ? daysDiff(foundAt, today) : null
  const daysSinceContact = contactedAt ? daysDiff(contactedAt, today) : null

  return {
    foundAt,
    foundLabel: readableDate(foundAt),
    publishedAt,
    publishedLabel: readableDate(publishedAt),
    contactedAt,
    contactedLabel: readableDate(contactedAt),
    lastActivityAt,
    lastActivityLabel: readableDate(lastActivityAt),
    closedAt,
    closedLabel: readableDate(closedAt),
    daysToContact,
    daysSinceFound,
    daysSinceContact,
  }
}

export const statusOf = (studio) => BY_KEY[studio && studio.status] || BY_KEY.to_contact
export const statusLabel = (key) => (BY_KEY[key] || BY_KEY.to_contact).label
export const statusColor = (key) => (BY_KEY[key] || BY_KEY.to_contact).color

// 07 October 2026: Normalize an attachment record (image, pdf, audio, video, doc, binary)
export function normalizeAttachment(raw) {
  if (!raw || typeof raw !== 'object') return null
  const name = String(raw.name || raw.title || '').trim()
  if (!name) return null
  const id = String(raw.id || `att_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`)
  const size = typeof raw.size === 'number' && Number.isFinite(raw.size) && raw.size >= 0 ? raw.size : 0
  const type = String(raw.type || raw.mime || '')
  const kind = String(raw.kind || (name ? kindForName(name) : 'binary'))
  const nodePath = String(raw.nodePath || raw.path || '')
  const url = String(raw.url || '')
  const addedAt = toIsoDate(raw.addedAt) || isoDay()
  const rel = String(raw.rel || '')
  return {
    id,
    name,
    size,
    type,
    kind,
    nodePath,
    url,
    addedAt,
    rel,
  }
}

/** One studio, from either schema. Unknown shapes rejected rather than half read. */
export function normalizeStudio(raw) {
  if (!raw || typeof raw !== 'object') return null
  const name = String(raw.name || raw.company || '').trim()
  if (!name) return null
  const status = BY_KEY[raw.status] ? raw.status : (LEGACY_STATUS[raw.status] || 'to_contact')
  const messages = (Array.isArray(raw.messages) ? raw.messages : [])
    .map((m) => ({ at: String(m.at || ''), channel: String(m.channel || 'mail'), text: String(m.text || '') }))
    .filter((m) => m.text)
    .sort((a, b) => String(a.at).localeCompare(String(b.at)))
  const history = (Array.isArray(raw.history) ? raw.history : [])
    .map((h) => ({ at: String(h.at || ''), from: String(h.from || ''), to: String(h.to || ''), note: String(h.note || '') }))
    .filter((h) => h.to)
  const attachments = (Array.isArray(raw.attachments) ? raw.attachments : [])
    .map(normalizeAttachment)
    .filter(Boolean)
  return {
    ...raw,
    id: String(raw.id || `s${Date.now()}${Math.random().toString(36).slice(2, 6)}`),
    name,
    role: String(raw.role || '').trim(),
    link: String(raw.link || '').trim(),
    city: String(raw.city || '').trim(),
    status,
    createdAt: String(raw.createdAt || raw.date || ''),
    contactedAt: String(raw.contactedAt || (CONTACTED_FROM.includes(status) ? (raw.date || '') : '')),
    messages,
    history,
    attachments,
    notes: String(raw.notes || ''),
    offerDetailsPath: String(raw.offerDetailsPath || ''),
  }
}

/** The whole file, from v1 (`applications`) or v2 (`studios`). Never throws on a broken file. */
export function normalizeStore(json) {
  const src = json && typeof json === 'object' ? json : {}
  const list = Array.isArray(src.studios) ? src.studios : (Array.isArray(src.applications) ? src.applications : [])
  return { ...src, v: 2, studios: list.map(normalizeStudio).filter(Boolean) }
}

// 30 September 2026, 19:45 Europe/Paris: Merge only the edited fields into the current drive record.
// 07 October 2026: Safe concurrent merge for attachments by id.
export function applyStudioChange(current, before, next) {
  const remote = current.studios.find((studio) => studio.id === next.id)
  if (!remote) throw new Error('Cette fiche a été supprimée. Recharge la liste avant de la modifier.')
  const changed = { ...remote }
  for (const key of Object.keys(next)) {
    if (JSON.stringify(before[key]) === JSON.stringify(next[key])) continue
    if (key === 'messages' || key === 'history') {
      const original = new Set(before[key].map((item) => JSON.stringify(item)))
      const existing = new Set(remote[key].map((item) => JSON.stringify(item)))
      changed[key] = [...remote[key], ...next[key].filter((item) => !original.has(JSON.stringify(item)) && !existing.has(JSON.stringify(item)))]
    } else if (key === 'attachments') {
      const beforeList = Array.isArray(before.attachments) ? before.attachments : []
      const nextList = Array.isArray(next.attachments) ? next.attachments : []
      const remoteList = Array.isArray(remote.attachments) ? remote.attachments : []
      const beforeIds = new Set(beforeList.map((a) => a.id))
      const nextIds = new Set(nextList.map((a) => a.id))
      const deletedIds = new Set(beforeList.filter((a) => !nextIds.has(a.id)).map((a) => a.id))
      const added = nextList.filter((a) => !beforeIds.has(a.id))
      const kept = remoteList.filter((a) => !deletedIds.has(a.id))
      const keptIds = new Set(kept.map((a) => a.id))
      changed.attachments = [...kept, ...added.filter((a) => !keptIds.has(a.id))]
    } else {
      if (JSON.stringify(remote[key]) !== JSON.stringify(before[key]) && JSON.stringify(remote[key]) !== JSON.stringify(next[key])) {
        throw new Error('Cette fiche a changé dans un autre onglet. Recharge-la avant de modifier ce champ.')
      }
      changed[key] = next[key]
    }
  }
  return { ...current, studios: current.studios.map((studio) => studio.id === next.id ? changed : studio) }
}

/** A status change is an EVENT: the previous state stays readable, it is never overwritten. */
export function setStatus(studio, next, at = isoDay(), note = '') {
  if (!BY_KEY[next] || studio.status === next) return studio
  const contactedAt = studio.contactedAt || (CONTACTED_FROM.includes(next) ? at : '')
  return { ...studio, status: next, contactedAt, history: [...(studio.history || []), { at, from: studio.status, to: next, note }] }
}

/** Recording the message that was really sent, which is the whole point of the backup. */
export function addMessage(studio, { text, channel = 'mail', at = isoDay() }) {
  const body = String(text || '').trim()
  if (!body) return studio
  const withMsg = { ...studio, messages: [...studio.messages, { at, channel, text: body }] }
  return studio.status === 'to_contact' ? setStatus(withMsg, 'contacted', at, 'premier message') : withMsg
}

// 07 October 2026: Add or update an attachment in studio
export function addAttachment(studio, attachment) {
  const norm = normalizeAttachment(attachment)
  if (!norm) return studio
  const existing = studio.attachments || []
  const idx = existing.findIndex((a) => a.id === norm.id || (norm.nodePath && a.nodePath === norm.nodePath))
  const nextList = idx >= 0
    ? existing.map((a, i) => i === idx ? { ...a, ...norm } : a)
    : [...existing, norm]
  return { ...studio, attachments: nextList }
}

// 07 October 2026: Remove an attachment from studio by its id
export function removeAttachment(studio, attachmentId) {
  if (!attachmentId) return studio
  return {
    ...studio,
    attachments: (studio.attachments || []).filter((a) => a.id !== attachmentId),
  }
}

export const lastMessage = (studio) => (studio.messages.length ? studio.messages[studio.messages.length - 1] : null)

/** Sections of the dashboard, in pipeline order, empty ones dropped. */
export function groupByStatus(studios) {
  return STATUSES
    .map((s) => ({ key: s.key, label: s.label, color: s.color, items: studios.filter((x) => x.status === s.key) }))
    .filter((g) => g.items.length)
}

export function counts(studios) {
  const contacted = studios.filter((s) => CONTACTED_FROM.includes(s.status)).length
  return {
    total: studios.length,
    toContact: studios.filter((s) => s.status === 'to_contact').length,
    contacted,
    answered: studios.filter((s) => ['replied', 'interview', 'offer'].includes(s.status)).length,
    deprecated: studios.filter((s) => s.status === 'deprecated').length,
    messages: studios.reduce((n, s) => n + s.messages.length, 0),
    attachments: studios.reduce((n, s) => n + (s.attachments ? s.attachments.length : 0), 0),
  }
}

// 07 October 2026: Determine whether an offer is closed on source or expired past its validity
export function isOutdatedStudio(studio, today = isoDay()) {
  if (!studio) return false
  if (studio.status === 'deprecated') return true
  const engine = studio.engine
  if (!engine) return false
  if (engine.closedAt) return true
  if (engine.validThrough && String(engine.validThrough).slice(0, 10) < today) return true
  return false
}

// 07 October 2026: Mark an individual studio offer as deprecated
export function deprecateStudio(studio, at = isoDay(), note = 'offre plus à jour / fermée sur le site source') {
  if (!studio || studio.status === 'deprecated') return studio
  return setStatus(studio, 'deprecated', at, note)
}

// 07 October 2026: Automatically transition all uncontacted offers that are closed or expired into deprecated
export function deprecateOutdatedStudios(studios, today = isoDay()) {
  if (!Array.isArray(studios)) return []
  return studios.map((s) => {
    if (s.status === 'to_contact' && isOutdatedStudio(s, today)) {
      return deprecateStudio(s, today, 'offre fermée ou expirée sur le site source')
    }
    return s
  })
}

/** The progress backup: every dated event of every studio, most recent first. */
export function timeline(studios, limit = 60) {
  const out = []
  for (const s of studios) {
    for (const m of s.messages) out.push({ at: m.at, studio: s.name, id: s.id, kind: 'message', label: `message envoyé (${m.channel})`, text: m.text })
    for (const h of s.history) out.push({ at: h.at, studio: s.name, id: s.id, kind: 'status', label: `${statusLabel(h.from)} → ${statusLabel(h.to)}`, text: h.note })
    for (const a of (s.attachments || [])) out.push({ at: a.addedAt, studio: s.name, id: s.id, kind: 'attachment', label: `pièce jointe ajoutée (${a.kind || 'fichier'})`, text: a.name })
  }
  return out.sort((a, b) => String(b.at).localeCompare(String(a.at))).slice(0, limit)
}

/** Search on what the eye looks for: the studio, the role, the city, the text already sent. */
export function searchStudios(studios, query) {
  const q = String(query || '').trim().toLowerCase()
  if (!q) return studios
  return studios.filter((s) => [
    s.name, s.role, s.city, s.notes,
    ...s.messages.map((m) => m.text),
    ...(s.attachments || []).map((a) => `${a.name} ${a.rel || ''}`),
  ].join(' ').toLowerCase().includes(q))
}
