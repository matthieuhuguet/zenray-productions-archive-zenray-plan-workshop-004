// ═══ LES EXTENSIONS DE NŒUD, ÉCRITES UNE SEULE FOIS ═════════════════════════════════════════════
//
// CE QUE LA DISPERSION A COÛTÉ, mesuré le 2026-08-31. La même liste d'extensions existait en
// QUATORZE copies dans huit fichiers, et elles avaient déjà divergé :
//
//   server/nodeTreeFilter.js ....... md, db, media, img, canvas, ref, embed, file, plan
//   scripts/build-search-index.mjs . md, db, media, img, canvas, ——, embed, file, ————
//
// Le constructeur d'index avait oublié `ref.json` et `plan.json`. Conséquence vérifiée sur le drive :
// trois boards Ref et un plan existent réellement, et une reconstruction complète de l'index les
// efface de la recherche. Ils ne sont pas perdus — ils deviennent introuvables, ce qui est pire,
// puisque rien ne le signale.
//
// LA RÈGLE DU PROJET le disait déjà, dans `page.js` : « même piège que server/nodeTreeFilter.js : un
// nœud absent de cette regex reste invisible à l'indexation, même s'il existe bel et bien sur
// GitHub ». Le commentaire était juste ; il était simplement écrit à côté de la treizième copie.
//
// AJOUTER UN TYPE DE NŒUD SE FAIT DONC ICI, ET NULLE PART AILLEURS. Un test compare toutes les
// listes du dépôt à celle-ci et rougit dès qu'une copie s'en écarte.

// L'ordre n'a aucune importance ; l'exhaustivité, si.
export const EXTENSIONS_NOEUDS = [
  'md',            // page Markdown
  'db.json',       // table
  'media.json',    // vidéo, audio, PDF, binaire découpé
  'img.json',      // image
  'canvas.json',   // board Ref, ancien nom
  'ref.json',      // board Ref, nom courant
  'embed.json',    // vidéo intégrée
  'file.json',     // archive
  'plan.json',     // calendrier ZenRay Plan
  'zmedia.json',   // document ZenRayMedia
  // 9 October 2026 08:05 CEST: Include the standalone comment node already recognized by the UI.
  'comment.json',  // standalone comment node, distinct from the page companion .comments.json
]

// Les marqueurs de dossier : ils font exister un dossier pour git, et ne doivent JAMAIS apparaître
// comme des nœuds. Une copie qui en oublie un le montre comme un faux fichier dans l'arborescence.
export const MARQUEURS_DOSSIER = [
  '.zrfolder.json',
  '.zrmusic.json',
  '.zreagle-folder.json',
]

const echappe = (s) => s.replace(/\./g, '\\.')

// `x.img.json` mais pas `x.props.json` : l'expression exige la fin de chaîne.
export const RE_NOEUD = new RegExp(`\\.(${EXTENSIONS_NOEUDS.filter((e) => e !== 'md').map(echappe).join('|')})$|\\.md$`)

// Variante « suffixe feuille » : rend l'extension complète d'un chemin de nœud, ou null.
export function extensionFeuille(chemin) {
  const m = String(chemin || '').match(RE_NOEUD)
  return m ? m[0] : null
}

const PAGE_TWIN_SUFFIXES = ['.blocknote.json', '.comments.json', '.props.json']

// 9 October 2026 08:07 CEST: Keep page companions identical across move, trash, restore, and purge.
export function nodeFilesForPath(path) {
  if (extensionFeuille(path) !== '.md') return [path]
  return [path, ...PAGE_TWIN_SUFFIXES.map((suffix) => path.replace(/\.md$/, suffix))]
}

// 9 October 2026 08:07 CEST: Share the supported suffix contract with both single and batch moves.
export function nodeFilePairsForMove(from, to) {
  const fromExtension = extensionFeuille(from)
  const toExtension = extensionFeuille(to)
  const isBoardAliasPair = (fromExtension === '.canvas.json' || fromExtension === '.ref.json')
    && (toExtension === '.canvas.json' || toExtension === '.ref.json')
  if (!fromExtension || !toExtension || (fromExtension !== toExtension && !isBoardAliasPair)) return null
  if (fromExtension !== '.md') return [[from, to]]
  return [[from, to], ...PAGE_TWIN_SUFFIXES.map((suffix) => [from.replace(/\.md$/, suffix), to.replace(/\.md$/, suffix)])]
}

// Retire l'extension technique pour l'affichage. Sans source unique, chaque vue réécrivait la sienne
// avec une liste différente — d'où des noms montrés « Agenda.plan.json » au lieu d'« Agenda ».
export function sansExtensionNoeud(nom) {
  return String(nom || '').replace(RE_NOEUD, '')
}

export function estMarqueurDossier(chemin) {
  const nom = String(chemin || '').split('/').pop()
  return MARQUEURS_DOSSIER.includes(nom)
}
