// 7 October 2026: one posting, one key, whichever site relists it; and an index never adds a vacancy a studio's own board already has.
import { describe, it, expect } from 'vitest'
import { postingKey } from './lib/PostingKey.mjs'
import { postingKey as pagePostingKey } from '../../src/lib/freelanceBatch.js'
import { mergeStore } from './StoreMerge.mjs'
import config from './FreelanceConfig.json'

describe('posting key', () => {
  const cases = [['GameSim (Keywords Studios)', 'Vivier de candidatures : VFX Artist - GameSim - Talent Pool'], ['GameSim', 'VFX Artist | Artiste en effets'], ['Riot Games', 'Rendering Technical Artist II [Remote]'], ['Épic Games', 'Technical Artist']]
  it('ignores prefixes, location tails, brackets, case and accents', () => {
    expect(postingKey(...cases[0])).toBe(postingKey(...cases[1]))
    expect(postingKey('Riot Games', 'Rendering Technical Artist II')).toBe(postingKey(...cases[2]))
    expect(postingKey(...cases[3])).toBe(postingKey('epic games', 'technical artist'))
    expect(postingKey('A', 'Technical Artist')).not.toBe(postingKey('B', 'Technical Artist'))
  })
  it('the page and the engine agree on the same cases', () => {
    for (const [name, role] of cases) expect(postingKey(name, role)).toBe(pagePostingKey({ name, role }))
  })
})

describe('merge: an index does not duplicate a studio board', () => {
  const NOW = new Date('2026-10-07T10:00:00Z')
  const listing = (sourceKey, name, title, url) => ({ sourceKey, sourceLabel: sourceKey, name, title, url, sourceId: `${sourceKey}:${url}`, text: 'Houdini Unreal Engine Python', contract: 'Freelance', country: 'FR', published: '2026-10-06' })
  const board = (key, ...listings) => ({ key, label: key, listings, seenIds: [], listed: listings.length, matched: listings.length, complete: false, partial: true, errors: [] })
  it('keeps the studio board record, skips the index twin, counts it, and still adds a different job', () => {
    const { store, report } = mergeStore({ studios: [] }, [
      { ...board('greenhouse:acme', listing('greenhouse:acme', 'Acme', 'Technical Artist', 'https://boards.greenhouse.io/acme/1')), complete: true, partial: false },
      board('index:devquest', listing('index:devquest', 'Acme', 'Technical Artist', 'https://devquest.gg/other'), listing('index:devquest', 'Acme', 'VFX Artist', 'https://devquest.gg/vfx')),
    ], config, { now: NOW })
    expect(store.studios.map((s) => `${s.engine.source}|${s.role}`).sort()).toEqual(['greenhouse:acme|Technical Artist', 'index:devquest|VFX Artist'])
    expect(report.duplicates).toBe(1)
  })
  it('two index sites listing the same job: the first one wins', () => {
    const { store, report } = mergeStore({ studios: [] }, [board('index:a', listing('index:a', 'Acme', 'Technical Artist', 'https://a/1')), board('index:b', listing('index:b', 'Acme', 'Technical Artist', 'https://b/1'))], config, { now: NOW })
    expect(store.studios).toHaveLength(1); expect(report.duplicates).toBe(1)
  })
  it('a closed record does not block a new posting of the same job', () => {
    const closed = { id: 'job_old', name: 'Acme', role: 'Technical Artist', link: 'https://old/1', status: 'to_contact', engine: { source: 'greenhouse:acme', closedAt: '2026-10-01', lastSeenAt: '2026-09-20' } }
    const { store } = mergeStore({ studios: [closed] }, [board('index:a', listing('index:a', 'Acme', 'Technical Artist', 'https://a/1'))], config, { now: NOW })
    expect(store.studios).toHaveLength(2)
  })
})
