// 12 October 2026: project thumbnails and real activity time for ZenRay Assets.
// A project cover is an image of the project: chosen by hand (right click), or found by name (thumbnail, cover...),
// or the first image as a last resort. Generated bookkeeping files never count as the project being edited.
// FR : miniatures de projet et vraie date d'activité. Un fichier généré par le service ne compte jamais comme une édition.

export const IMAGE_EXT = /\.(png|jpe?g|webp|avif|gif|heic)$/i
const GENERATED = /(^|\/)(ConversationIndex\.(json|md)|ConversationDigest[^/]*|FileMap\.md|Project\.json|\.DS_Store)$|\.tmp$/i
// A file whose whole name says "this is the icon of the project".
const EXACT = /^(thumbnail|thumbnails|thumb|miniature|cover|couverture|poster|affiche|icon|icone|icône|project[-_ ]?icon|key[-_ ]?art)$/i
// A name or folder that contains such a word.
const WORD = /(^|[^a-z0-9])(thumbnail|thumbnails|thumb|miniature|cover|couverture|poster|affiche|icon|icone|icône|key[-_ ]?art|hero)([^a-z0-9]|$)/i
const WEAK = /(^|[^a-z0-9])(preview|apercu|aperçu)([^a-z0-9]|$)/i
// Build output, plugins and web icons are never the icon of a project, even when they are named icon.
const NOISE_PATH = /(^|\/)(dist|build|node_modules|Plugins|Release|Intermediate|Saved|worktree|pages-deploy[^/]*|\.git)(\/|$)/i
const NOISE_NAME = /apple-touch-icon|favicon|android-chrome|hengine|sprite|atlas/i

export const isGeneratedFile = (file) => GENERATED.test(String(file?.relativePath || file?.name || ''))
export const isImageFile = (file) => ['image', 'image-lib'].includes(file?.kind) || IMAGE_EXT.test(String(file?.name || file?.relativePath || ''))
// An image can only be shown as a cover when something can render it: its cloud manifest (contentPath) or a direct URL.
export const hasRenderableSource = (file) => Boolean(file?.contentPath || file?.thumbnailUrl || file?.coverUrl)

const leafOf = (file) => String(file?.name || String(file?.relativePath || '').split('/').pop() || '')
const withoutExt = (name) => name.replace(/\.[^.]+$/, '')
const dirsOf = (file) => String(file?.relativePath || '').split('/').slice(0, -1).join('/')
const depthOf = (file) => String(file?.relativePath || '').split('/').filter(Boolean).length - 1
const natural = (a, b) => String(a).localeCompare(String(b), 'fr', { numeric: true })

// Name-based score only (no depth): > 0 means "named like a thumbnail".
export function namedScore(file) {
  const base = withoutExt(leafOf(file))
  let score = 0
  if (EXACT.test(base)) score = 100
  else if (WORD.test(base)) score = 60
  if (WORD.test(dirsOf(file))) score += 25
  return score
}
const isNoise = (file) => NOISE_PATH.test(String(file?.relativePath || '')) || NOISE_NAME.test(leafOf(file))
const weakScore = (file) => WEAK.test(withoutExt(leafOf(file))) ? 10 : 0

// Best cover among files. With `named: true` only a file named like a thumbnail is accepted.
export function pickProjectCover(files, { named = false } = {}) {
  const candidates = (files || []).filter((file) => isImageFile(file) && hasRenderableSource(file) && !isGeneratedFile(file) && !isNoise(file))
  const scored = candidates.map((file) => ({ file, strong: namedScore(file), score: namedScore(file) + weakScore(file), depth: depthOf(file) }))
    .filter((entry) => !named || entry.strong >= 25)
  scored.sort((a, b) => b.score - a.score || a.depth - b.depth || natural(a.file.relativePath || a.file.name, b.file.relativePath || b.file.name))
  const best = scored[0]
  return best ? { file: best.file, reason: best.strong >= 25 ? 'named' : 'first-image' } : null
}

// The few fields a renderer needs to draw the file again later; this is what gets stored.
// 20 October 2026: preserves adjustMeta (panX, panY, zoom, fitMode) when present.
export function coverReference(file) {
  const reference = {}
  for (const key of ['id', 'name', 'relativePath', 'sourceId', 'namespace', 'kind', 'type', 'size', 'status', 'cloudPath', 'contentPath', 'thumbnailUrl', 'adjustMeta']) if (file?.[key] !== undefined) reference[key] = file[key]
  return reference
}

const timestamp = (value) => {
  if (value === undefined || value === null || value === '') return 0
  const parsed = typeof value === 'number' ? value : Date.parse(value)
  return Number.isFinite(parsed) && parsed > 0 ? parsed : 0
}
// Latest real edit among files: generated files and publication/polling times are ignored on purpose.
export function lastFileActivity(files) {
  let recent = 0
  for (const file of files || []) {
    if (isGeneratedFile(file)) continue
    recent = Math.max(recent, timestamp(file.mtimeMs), timestamp(file.modifiedAt), timestamp(file.updatedAt))
  }
  return recent
}
