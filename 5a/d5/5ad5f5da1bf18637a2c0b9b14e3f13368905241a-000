import { describe, expect, it } from 'vitest'
import { readFileSync } from 'node:fs'
import { fileURLToPath } from 'node:url'
import path from 'node:path'

const scripts = path.dirname(fileURLToPath(import.meta.url))
const read = (name) => readFileSync(path.join(scripts, name), 'utf8')

describe('pipeline vidéo canonique', () => {
  it('garde les anciens CLI comme alias sans logique dupliquée', () => {
    for (const name of ['video-mse.mjs', 'video-transcode.mjs']) {
      const source = read(name)
      expect(source).toContain("import('./video-mse-cli.mjs')")
      expect(source).not.toMatch(/function\s+(probe|chunkStream|pushAll|fragIndexOf)\b/)
      expect(source.split('\n').length).toBeLessThan(12)
    }
  })

  it('utilise MSE par défaut dans le worker UI', () => {
    const source = read('transcode-worker.mjs')
    expect(source).toContain("args.includes('--dash-legacy')")
    expect(source).toContain('USE_DASH_LEGACY ? transcodeDash : transcodeOne')
    expect(source).not.toContain('const USE_HLS')
  })

  it('utilise video-raw dans les chemins bulk et worker de login', () => {
    for (const name of ['media-ingest.mjs', 'zenray-uploader.mjs']) {
      const source = read(name)
      expect(source).toContain('ingestVideoRaw')
      expect(source).not.toContain('transcodeHls(')
      expect(source).not.toContain('transcodeDash(')
    }
  })
})
