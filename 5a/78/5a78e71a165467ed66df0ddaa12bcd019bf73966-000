import { describe, it, expect } from 'vitest'
import { sansAccent, memeChemin, sousLaRacine } from './sansAccent.js'

// ═══ LE LIEN PARTAGÉ LE 2026-08-31, QUI RENDAIT « EMPTY FOLDER » ════════════════════════════════
const ANCIEN = 'pages/Photos/DJI/29 Août 2026/Photos'      // figé dans le jeton signé
const NOUVEAU = 'pages/Photos/DJI/29 Aout 2026/Photos'     // le dossier réel après renommage

describe('un lien émis avant le renommage mène encore au bon dossier', () => {
  it('LE BUG : l’ancien chemin et le nouveau désignent la même chose', () => {
    expect(memeChemin(ANCIEN, NOUVEAU)).toBe(true)
  })

  it('la comparaison littérale, elle, échouait — c’est bien là qu’était le défaut', () => {
    expect(ANCIEN === NOUVEAU).toBe(false)
  })

  it('le partage borne toujours au bon sous-arbre', () => {
    expect(sousLaRacine(NOUVEAU + '/IMG_5522.jpeg.img.json', ANCIEN)).toBe(true)
    expect(sousLaRacine(ANCIEN, ANCIEN)).toBe(true)
  })

  it('ET IL NE FUIT PAS : un dossier voisin reste refusé', () => {
    // Le point qui compte pour la sécurité : tolérer l'accent ne doit pas ouvrir l'accès au reste.
    expect(sousLaRacine('pages/Photos/DJI/29 Aout 2026/Videos', ANCIEN)).toBe(false)
    expect(sousLaRacine('pages/Autre', ANCIEN)).toBe(false)
    // Le préfixe qui ressemble sans en être un : « PhotosBis » n'est pas sous « Photos ».
    expect(sousLaRacine(NOUVEAU + 'Bis/x.img.json', ANCIEN)).toBe(false)
  })

  it('les deux formes Unicode de macOS et de GitHub se comparent égales', () => {
    expect(memeChemin('Août'.normalize('NFD'), 'Août'.normalize('NFC'))).toBe(true)
  })

  it('le japonais passe intact — un macron retiré changerait le mot', () => {
    expect(sansAccent('壁の向こうへ')).toBe('壁の向こうへ')
    expect(memeChemin('pages/東京', 'pages/東京')).toBe(true)
  })
})
