// ═══ NEUTRALISER LES DONNÉES AVANT DE PHOTOGRAPHIER L'INTERFACE ══════════════════════════════════
//
// Consigne de Matthieu (2026-08-27) : « reproduis les assets exactement identiques au pixel, mais
// ensuite utilise du Lorem Ipsum afin de ne pas divulguer mes informations personnelles ».
//
// LE POINT DÉLICAT EST QU'IL FAUT LES DEUX À LA FOIS. Redessiner l'interface à la main donnerait des
// données neutres et une ressemblance approximative ; photographier l'application telle quelle donnerait
// le pixel exact et son contenu privé. On photographie donc l'application RÉELLE après avoir remplacé
// son contenu, ce qui garde la mise en page au pixel près, avec ses polices, ses ombres et ses
// espacements, et ne montre plus rien de personnel.
//
// LA LONGUEUR EST CONSERVÉE, et ce n'est pas un détail : un titre de trois mots remplacé par un titre
// de huit changerait le retour à la ligne, donc la hauteur de la tuile, donc la grille entière. Le
// remplacement se fait mot à mot, en gardant le nombre de mots et l'ordre de grandeur des longueurs.
//
// CE QUI RESTE VISIBLE, sur sa décision explicite : la navigation de la barre latérale, les noms de
// dossiers génériques, et toute la vue japonaise, qui est l'aspect « apprendre une compétence » et ne
// contient rien de compromettant.

const LOREM = ['lorem', 'ipsum', 'dolor', 'sit', 'amet', 'consectetur', 'adipiscing', 'elit', 'sed', 'do',
  'eiusmod', 'tempor', 'incididunt', 'labore', 'dolore', 'magna', 'aliqua', 'enim', 'minim', 'veniam',
  'quis', 'nostrud', 'exercitation', 'ullamco', 'laboris', 'nisi', 'aliquip', 'commodo', 'consequat']

// LES ZONES ÉPARGNÉES, ET LA FAUTE QUI LES RENDAIT INOPÉRANTES. La première version listait `.zrt-` et
// `.jp-`, qui ne sont pas des sélecteurs de classe mais des PRÉFIXES : `closest('.zrt-')` cherche une
// classe valant exactement « zrt- » et ne trouve donc jamais rien. Le minuteur n'était pas épargné, son
// canvas de particules couvre toute la scène, et la planche est ressortie en un rectangle gris. L'échec
// était muet : la capture existait, elle ne montrait simplement plus l'interface.
//
// On distingue donc deux formes. Un SÉLECTEUR complet se teste par `closest`. Un PRÉFIXE de classe se
// teste en remontant les ancêtres et en lisant leur liste de classes, ce qu'aucun sélecteur CSS ne sait
// faire pour un début de nom.
const EPARGNE_SELECTEURS = ['aside', '.zr-navitem', '.zr-segmente', '.zrp-weekdays', '.zrp-day-num',
  '[role=menu]', '[class*=menu]', '[class*=crumb]', '[class*=toolbar]']
// Le minuteur et la vue japonaise sont épargnés EN ENTIER : le premier ne contient aucune donnée
// personnelle, la seconde est autorisée explicitement par Matthieu.
const EPARGNE_PREFIXES = ['zrt-', 'jp-', 'zrp-btn', 'zrp-anneau', 'zr-ws-toolbar', 'zr-seg']

// Les noms de dossiers génériques restent : ce sont des mots fourre-tout, du même niveau que « Create »
// ou « Skills », et les masquer rendrait la capture illisible sans rien protéger.
const DOSSIERS_OK = new Set(['_backup index', '_index', 'anime', 'archives', 'audio', 'bases', 'build',
  'calendar', 'characters', 'cloud', 'design', 'documents', 'environments', 'goals', 'media', 'memory',
  'movies_series', 'music', 'photos', 'references', 'screenshots', 'sport', 'table', 'videos',
  'zenrayproductions', 'zenrayshards', 'bgm', 'sfx', 'vo', 'ref', 'create', 'plan', 'notes', 'skills',
  'shelf', 'projects', 'freelance', 'japan', 'japanese', 'timer', 'dashboard', 'favoris', 'new', 'search'])

let graine = 7
const tirage = () => (graine = (graine * 1103515245 + 12345) % 2147483648) / 2147483648

function loremDeLongueur(source) {
  const mots = source.trim().split(/\s+/)
  return mots.map((m) => {
    if (/^[\d\s:/,.%+-]+$/.test(m)) return m                    // les nombres restent : ils font la mise en page
    const cible = Math.max(2, m.length)
    let choix = LOREM[Math.floor(tirage() * LOREM.length)]
    // On approche la longueur du mot d'origine pour ne pas déplacer les retours à la ligne.
    for (let i = 0; i < 6 && Math.abs(choix.length - cible) > 3; i++) choix = LOREM[Math.floor(tirage() * LOREM.length)]
    const r = choix.slice(0, Math.max(2, Math.min(choix.length, cible + 2)))
    return /^[A-ZÉÈÀ]/.test(m) ? r[0].toUpperCase() + r.slice(1) : r
  }).join(' ')
}

function epargne(el) {
  if (EPARGNE_SELECTEURS.some((s) => { try { return !!el.closest(s) } catch { return false } })) return true
  for (let n = el; n && n !== document.body; n = n.parentElement) {
    const cls = typeof n.className === 'string' ? n.className : (n.getAttribute?.('class') || '')
    if (EPARGNE_PREFIXES.some((p) => cls.split(/\s+/).some((c) => c.startsWith(p)))) return true
  }
  return false
}

window.__neutraliser = function () {
  // 1. LE TEXTE. On parcourt les nœuds de texte plutôt que `innerHTML` : réécrire du HTML détruirait les
  //    éléments imbriqués, donc la mise en page, ce qui est exactement ce qu'on cherche à préserver.
  const marcheur = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT)
  const aTraiter = []
  while (marcheur.nextNode()) {
    const n = marcheur.currentNode
    const t = n.textContent
    if (!t || !t.trim() || t.trim().length < 3) continue
    const parent = n.parentElement
    if (!parent || epargne(parent)) continue
    if (DOSSIERS_OK.has(t.trim().toLowerCase())) continue
    if (/[ぁ-んァ-ン一-龯]/.test(t)) continue                    // japonais : autorisé
    aTraiter.push(n)
  }
  aTraiter.forEach((n) => { n.textContent = loremDeLongueur(n.textContent) })

  // 2. LES IMAGES, ET LA DISTINCTION QUI COMPTE. Une icône de dossier n'est pas une donnée, c'est du
  //    DESSIN : c'est même exactement ce que l'article vient montrer. La première passe les avait
  //    remplacées avec les vignettes, et la grille de Create se retrouvait pavée de rectangles gris.
  //    On garde donc tout ce qui vient de `/icons/` et tout ce qui est vectoriel, on ne remplace que ce
  //    qui porte un contenu : photo, vignette de média, pochette, capture.
  const estDecor = (el) => {
    const src = (el.currentSrc || el.src || '')
    return src.includes('/icons/') || /\.svg(\?|$)/.test(src) || src.startsWith('data:image/svg')
  }
  // ON NEUTRALISE EN PLACE, JAMAIS EN REMPLAÇANT LE NŒUD. La première version faisait `replaceWith`, ce
  // qui arrache un nœud dont React garde la référence : à sa mise à jour suivante, React appelle
  // `insertBefore` sur un parent qui n'est plus le bon et la vue entière s'effondre sur « Une vue a
  // rencontré une erreur ». La galerie Design est ressortie en écran d'erreur, pas en galerie.
  //
  // Changer la SOURCE d'une image laisse le nœud exactement où il est, donc React continue de le
  // reconnaître, et la mise en page ne bouge pas d'un pixel puisque c'est le même élément aux mêmes
  // dimensions. Même raisonnement pour un canvas, qu'on repeint au lieu de le remplacer.
  const APLAT = 'data:image/svg+xml;utf8,' + encodeURIComponent(
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 5" preserveAspectRatio="none">'
    + '<defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1">'
    + '<stop offset="0" stop-color="#c9d4e2"/><stop offset="0.6" stop-color="#9fb0c6"/>'
    + '<stop offset="1" stop-color="#8ea2bb"/></linearGradient></defs>'
    + '<rect width="8" height="5" fill="url(#g)"/></svg>')

  document.querySelectorAll('img').forEach((el) => {
    if (epargne(el) || estDecor(el)) return
    el.removeAttribute('srcset')
    el.src = APLAT
  })
  document.querySelectorAll('canvas').forEach((el) => {
    if (epargne(el)) return
    const c = el.getContext('2d')
    if (!c || el.width < 8 || el.height < 8) return
    const d = c.createLinearGradient(0, 0, el.width, el.height)
    d.addColorStop(0, '#c9d4e2'); d.addColorStop(0.6, '#9fb0c6'); d.addColorStop(1, '#8ea2bb')
    c.fillStyle = d; c.fillRect(0, 0, el.width, el.height)
  })
  // LE FOND CALCULÉ, PAS SEULEMENT LE FOND EN LIGNE. Une vignette posée par une feuille de style plutôt
  // que par un attribut `style` échappait au filtre : la galerie Design en a laissé passer une, petite
  // mais bien réelle. On interroge donc le style CALCULÉ de chaque élément, seule lecture qui voie ce
  // que le navigateur affiche vraiment, d'où qu'il vienne.
  document.querySelectorAll('*').forEach((el) => {
    if (epargne(el)) return
    const f = getComputedStyle(el).backgroundImage
    if (f && f.includes('url(') && !f.includes('.svg')) {
      el.style.backgroundImage = 'linear-gradient(135deg,#c9d4e2,#9fb0c6 60%,#8ea2bb)'
    }
  })
  // `<picture>` sert une source différente de celle de son `<img>` : neutraliser l'image sans neutraliser
  // ses sources laisse le navigateur remettre l'originale au premier redimensionnement.
  document.querySelectorAll('picture source').forEach((el) => { if (!epargne(el)) el.remove() })
  return true
}
