import { describe, expect, it, vi } from 'vitest'
import { createLruCache, createLruSet } from './lruCache.js'

describe('bounded LRU cache', () => {
  it('promeut les lectures et évince réellement la plus ancienne entrée', () => {
    const evicted = vi.fn()
    const cache = createLruCache({ maxEntries: 2, onEvict: evicted })
    cache.set('a', 1); cache.set('b', 2); expect(cache.get('a')).toBe(1); cache.set('c', 3)
    expect(cache.has('a')).toBe(true)
    expect(cache.has('b')).toBe(false)
    expect(evicted).toHaveBeenCalledWith(2, 'b')
  })

  it('notifie aussi les révocations explicites et le clear', () => {
    const evicted = vi.fn()
    const cache = createLruCache({ maxEntries: 3, onEvict: evicted })
    cache.set('a', 'blob:a'); cache.set('b', 'blob:b')
    cache.delete('a'); cache.clear()
    expect(evicted.mock.calls).toEqual([['blob:a', 'a'], ['blob:b', 'b']])
  })

  it('borne également les ensembles de marqueurs', () => {
    const set = createLruSet(2)
    set.add('a').add('b'); set.has('a'); set.add('c')
    expect(set.has('a')).toBe(true)
    expect(set.has('b')).toBe(false)
    expect(set.has('c')).toBe(true)
  })
})
