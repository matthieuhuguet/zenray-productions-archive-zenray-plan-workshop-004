// 9 October 2026, 00:37 CEST: menu actions reuse the authenticated Assets bridge and its safety plans.
import { requestAssets } from '../BridgeClient.mjs'

export async function runDashboardAction(action, projectId, request = requestAssets) {
  if (!projectId) throw new Error('Choisis un projet')
  let result
  if (action === 'archive') {
    result = await request({ action: 'archive', projectId })
  } else if (action === 'load') {
    const { plan } = await request({ action: 'load-plan', projectId })
    const fileIds = (plan?.entries || []).filter((entry) => entry.ready).map((entry) => entry.id)
    if (!fileIds.length) throw new Error('Aucun fichier sauvegardé et vérifié à charger')
    result = await request({ action: 'restore', projectId, fileIds })
  } else if (action === 'unload') {
    // 10 October 2026, 12:37 CEST: the server plans the entire copy, including memory files absent from the working inventory.
    const { plan } = await request({ action: 'unload-plan', projectId })
    if (plan?.blockers?.length) throw new Error('La copie contient des fichiers à vérifier et reste protégée')
    if (!plan?.count) throw new Error('Aucune copie chargée à décharger')
    result = await request({ action: 'unload', projectId })
  } else {
    throw new Error('Action Assets inconnue')
  }
  return { action, projectId, jobId: result.job?.id || null, state: result.job?.state || 'queued' }
}
