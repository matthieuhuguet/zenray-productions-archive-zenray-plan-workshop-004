import { describe, expect, it } from 'vitest'
import { classifyRepoProbe } from './repo-probe.mjs'

describe('sonde non destructive d’un dépôt distant', () => {
  it('reconnaît un dépôt qui contient déjà un commit', () => {
    expect(classifyRepoProbe(0, '[{"sha":"abc"}]')).toEqual({ kind: 'content' })
  })

  it('distingue un dépôt absent d’un dépôt vide', () => {
    expect(classifyRepoProbe(1, '', 'gh: Not Found (HTTP 404)')).toEqual({ kind: 'missing' })
    expect(classifyRepoProbe(1, '', 'gh: Git Repository is empty. (HTTP 409)')).toEqual({ kind: 'empty' })
  })

  it('refuse de transformer une panne réseau en dépôt vide', () => {
    expect(classifyRepoProbe(null, '', '', new Error('ETIMEDOUT'))).toEqual({ kind: 'error', message: 'ETIMEDOUT' })
    expect(classifyRepoProbe(1, '', 'connection reset')).toEqual({ kind: 'error', message: 'connection reset' })
  })

  it('refuse une réponse réussie dont le contenu est inattendu', () => {
    expect(classifyRepoProbe(0, '[]')).toEqual({ kind: 'error', message: '[]' })
  })
})
