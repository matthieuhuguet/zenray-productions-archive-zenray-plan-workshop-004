import React, { useEffect, useState } from 'react'
import { typeOfPath } from '../create/node.js'
import { readJson } from '../ref/content.js'
import { embedIframeUrl, isEmbed } from '../ref/embed.js'
import { PALETTE, RADII } from '../theme.js'

// Renderer EXPLICITE d'un nœud `.embed.json` (plan §6 Phase 0, §13 P0).
// Garde-fou : un embed s'ouvre ICI, JAMAIS dans l'éditeur Markdown. On ne persiste/affiche AUCUN HTML brut :
// on lit le manifest (provider/id/url canonique), on montre une CARTE inactive (vignette + titre), et l'iframe
// YouTube no-cookie sandboxée ne se monte qu'au clic « Lire » (plan §4.4, §10 sécurité embeds).

const SANS = "var(--zr-police-sans)"

// L'iframe reçoit un attribut `allow` (Permissions Policy — caméra/micro/géoloc y sont des tokens valides).
// makeEmbed() n'écrit toujours QUE le sextuplet ci-dessous, mais il vit dans le manifeste .embed.json sur
// GitHub : un fichier corrompu/édité à la main ne doit jamais pouvoir injecter un token de permission non prévu
// dans un iframe réellement monté. Whitelist plutôt que passthrough.
const ALLOWED_PERMISSIONS = new Set(['accelerometer', 'clipboard-write', 'encrypted-media', 'gyroscope', 'picture-in-picture', 'web-share'])
const safeAllow = (allow) => String(allow || '').split(';').map((s) => s.trim()).filter((s) => ALLOWED_PERMISSIONS.has(s)).join('; ')

export default function EmbedNodeViewer({ t, path, title }) {
  const tt = t || { textSecondary: PALETTE.gray600, bg: '#FDFDFC', border: 'rgba(0,0,0,0.1)', textPrimary: '#1d1d1f' }
  const [data, setData] = useState(null)
  const [phase, setPhase] = useState('loading')
  const [playing, setPlaying] = useState(false)

  useEffect(() => {
    let live = true
    setPhase('loading'); setPlaying(false)
    readJson(path).then(({ data, missing }) => {
      if (!live) return
      if (missing || !isEmbed(data)) { setPhase('error'); return }
      setData(data); setPhase('ready')
    })
    return () => { live = false }
  }, [path])

  if (typeOfPath(path) !== 'embed') {
    return <div style={{ padding: 24, fontFamily: SANS, fontSize: 'var(--zr-ui-md)', color: tt.textSecondary }}>Type de nœud non supporté par l'embed Ref.</div>
  }
  if (phase === 'loading') return <div style={{ padding: 24, fontFamily: SANS, fontSize: 'var(--zr-ui-md)', color: tt.textSecondary }}>Chargement de l'embed…</div>
  if (phase === 'error') return <div style={{ padding: 24, fontFamily: SANS, fontSize: 'var(--zr-ui-md)', color: PALETTE.red }}>Embed illisible ou provider non autorisé.</div>

  const thumb = data.provider === 'youtube' ? `https://i.ytimg.com/vi/${data.providerId}/hqdefault.jpg` : null
  const heading = title || data.title || 'Embed'
  const iframeUrl = embedIframeUrl(data)
  let safeIframeUrl = null
  try {
    const url = new URL(iframeUrl)
    if (url.protocol === 'https:' && url.hostname === 'www.youtube-nocookie.com' && /^\/embed\/[\w-]{6,20}$/.test(url.pathname)) safeIframeUrl = url.toString()
  } catch {}
  if (!safeIframeUrl) return <div style={{ padding: 24, fontFamily: SANS, fontSize: 'var(--zr-ui-md)', color: PALETTE.red }}>Embed refusé : origine non autorisée.</div>

  return (
    <div style={{ padding: 24, fontFamily: SANS }}>
      <div style={{ maxWidth: 900, margin: '0 auto', background: tt.bg, border: `1px solid ${tt.border}`, borderRadius: RADII.lg, overflow: 'hidden' }}>
        <div style={{ position: 'relative', width: '100%', aspectRatio: '16 / 9', background: '#000' }}>
          {playing ? (
            <iframe
              src={safeIframeUrl}
              title={heading}
              loading="lazy"
              allow={safeAllow(data.embedPolicy && data.embedPolicy.allow)}
              referrerPolicy="strict-origin-when-cross-origin"
              sandbox="allow-scripts allow-presentation allow-popups"
              style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', border: 'none' }}
            />
          ) : (
            <button onClick={() => setPlaying(true)} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', border: 'none', cursor: 'pointer', padding: 0, background: thumb ? `center/cover no-repeat url("${thumb}")` : '#000' }} aria-label="Lire la vidéo">
              <span style={{ position: 'absolute', top: '50%', left: '50%', transform: 'translate(-50%,-50%)', width: 64, height: 64, borderRadius: 99, background: 'rgba(0,0,0,0.55)', display: 'grid', placeItems: 'center' }}>
                <span style={{ borderStyle: 'solid', borderWidth: '12px 0 12px 20px', borderColor: 'transparent transparent transparent #fff', marginLeft: 4 }} />
              </span>
            </button>
          )}
        </div>
        <div style={{ padding: '12px 16px' }}>
          <div style={{ fontSize: 'var(--zr-ui-xl)', fontWeight: 600, color: tt.textPrimary }}>{heading}</div>
          <div style={{ fontSize: 'var(--zr-ui-sm)', color: tt.textSecondary, marginTop: 4 }}>
            {data.provider} · <a href={data.url} target="_blank" rel="noreferrer" style={{ color: PALETTE.primary, textDecoration: 'none' }}>ouvrir la source</a>
          </div>
        </div>
      </div>
    </div>
  )
}
