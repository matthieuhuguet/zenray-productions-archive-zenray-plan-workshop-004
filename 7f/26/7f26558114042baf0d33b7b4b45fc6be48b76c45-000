/* ZenRay Ref — chrome V9 du board (Memory/Design/ui-design/ui-components-zenray-v9.html).
   Toolbar verticale gauche façon Figma/Miro + picker d'images du drive, en matériau --g9-*
   (variables deux thèmes définies dans src/fonts.css : light sur :root, dark sous .zr-dark). */

.zr-ref-glass {
  color: var(--g9-fg);
  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-a),
    var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%);
  -webkit-backdrop-filter: blur(27px) saturate(169%);
}

/* ── Toolbar verticale gauche ───────────────────────────────────────────── */
.zr-ref-toolbar {
  position: absolute;
  left: 14px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 300;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 8px 7px;
  border-radius: 20px;
  pointer-events: auto;
}
.zr-ref-tool {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  padding: 0;
  border: 0;
  border-radius: 11px;
  background: transparent;
  color: var(--g9-fg);
  cursor: pointer;
  transition: background-color var(--g9-timing) var(--g9-ease), color var(--g9-timing) var(--g9-ease), transform var(--g9-timing) var(--g9-ease);
}
.zr-ref-tool:hover { background: color-mix(in srgb, var(--g9-fg) 7%, transparent); }
.zr-ref-tool:active { transform: scale(.92); }
.zr-ref-tool.active { color: #0a84ff; background: rgba(10, 132, 255, .13); }
.zr-ref-tool:disabled { opacity: .35; cursor: default; }
.zr-ref-sep { width: 26px; height: 1px; margin: 5px 0; background: color-mix(in srgb, var(--g9-fg) 12%, transparent); }

/* Popover "plus d'outils" accolé à la toolbar. */
.zr-ref-more {
  position: absolute;
  left: calc(100% + 8px);
  bottom: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 7px;
  border-radius: 16px;
  min-width: 150px;
}
.zr-ref-more button {
  display: flex;
  align-items: center;
  gap: 9px;
  width: 100%;
  padding: 7px 10px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: var(--g9-fg);
  font: 300 var(--zr-ui-sm)/1 var(--zr-police-sans);
  cursor: pointer;
  white-space: nowrap;
  transition: background-color var(--g9-timing) var(--g9-ease);
}
.zr-ref-more button:hover { background: color-mix(in srgb, var(--g9-fg) 7%, transparent); }
.zr-ref-more button.active { color: #0a84ff; background: rgba(10, 132, 255, .13); }

/* ── Picker d'images du drive ───────────────────────────────────────────── */
.zr-ref-picker {
  position: absolute;
  right: 14px;
  top: 14px;
  bottom: 14px;
  z-index: 300;
  width: 324px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px;
  border-radius: 20px;
  font-family: var(--zr-police-sans);
}
.zr-ref-picker-head { display: flex; align-items: center; gap: 8px; }
.zr-ref-picker-title { flex: 1; font-size: var(--zr-ui-sm); font-weight: 400; letter-spacing: .02em; color: var(--g9-muted); text-transform: uppercase; }
.zr-ref-picker-close { width: 26px; height: 26px; display: grid; place-items: center; border: 0; border-radius: 8px; background: transparent; color: var(--g9-muted); cursor: pointer; transition: background-color var(--g9-timing) var(--g9-ease); }
.zr-ref-picker-close:hover { background: color-mix(in srgb, var(--g9-fg) 8%, transparent); color: var(--g9-fg); }
.zr-ref-picker-scroll { flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: thin; }
.zr-ref-picker-note { padding: 8px 4px; font-size: var(--zr-ui-2xs); font-weight: 400; color: var(--g9-muted); }
.zr-ref-picker-section { margin: 8px 4px 5px; font: 400 var(--zr-ui-2xs)/1 var(--zr-police-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--g9-soft); }
.zr-ref-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; }
.zr-ref-cell {
  position: relative;
  aspect-ratio: 1;
  padding: 0;
  border: 0;
  border-radius: 10px;
  overflow: hidden;
  background: color-mix(in srgb, var(--g9-fg) 6%, transparent);
  cursor: pointer;
  transition: transform var(--g9-timing) var(--g9-ease), filter var(--g9-timing) var(--g9-ease);
}
.zr-ref-cell:hover { transform: scale(1.04); filter: brightness(1.06); }
.zr-ref-cell:active { transform: scale(.97); }
.zr-ref-cell img { width: 100%; height: 100%; object-fit: cover; display: block; }
.zr-ref-cell .zr-ref-cell-name {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 10px 6px 4px;
  font: 300 var(--zr-ui-3xs)/1.2 var(--zr-police-sans);
  color: #fff;
  text-align: left;
  background: linear-gradient(transparent, rgba(0,0,0,.55));
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  opacity: 0; transition: opacity var(--g9-timing) var(--g9-ease);
}
.zr-ref-cell:hover .zr-ref-cell-name { opacity: 1; }
.zr-ref-more-btn {
  margin: 8px auto 2px;
  display: block;
  padding: 7px 16px;
  border: 0;
  border-radius: 999px;
  background: color-mix(in srgb, var(--g9-fg) 8%, transparent);
  color: var(--g9-fg);
  font: 300 var(--zr-ui-sm)/1 var(--zr-police-sans);
  cursor: pointer;
  transition: background-color var(--g9-timing) var(--g9-ease);
}
.zr-ref-more-btn:hover { background: color-mix(in srgb, var(--g9-fg) 14%, transparent); }

/* ── Images du board : bords arrondis façon macOS Preview ───────────────── */
.zr-ref-host .tl-image { border-radius: 12px; }
.zr-ref-host .tl-image-container { border-radius: 12px; overflow: hidden; }
