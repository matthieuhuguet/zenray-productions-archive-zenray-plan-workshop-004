import React, { useEffect, useRef, useState } from 'react'
import { PALETTE, RADII } from '../theme.js'
import Icon from './Icon.jsx'
import { readProps, writeProps, orientationOf, domainOf, humanBytes } from '../eagle/meta.js'

// C211e — Panneau droit façon Eagle : notes + tags + rating + URL, attachés au fichier via le bloc `eagle` du .props.json.
// Debounce 800ms à l'écriture. Source unique = ce .props.json (pas d'index).
export default function EagleInspector({ t, path, title, onOpen }) {
  const [props, setProps] = useState(null)
  const sha = useRef(null)
  const timer = useRef(null)
  const activePath = useRef(path)
  const shaByPath = useRef(new Map())
  const pending = useRef(null)
  const saveChain = useRef(Promise.resolve())

  const enqueueSave = (job) => {
    saveChain.current = saveChain.current.then(async () => {
      const expectedSha = shaByPath.current.get(job.path) ?? job.sha ?? null
      const nextSha = await writeProps(job.path, job.next, expectedSha)
      if (!nextSha) return
      shaByPath.current.set(job.path, nextSha)
      if (activePath.current === job.path) sha.current = nextSha
    }).catch(() => {})
    return saveChain.current
  }
  const flushPending = () => {
    clearTimeout(timer.current)
    timer.current = null
    const job = pending.current
    pending.current = null
    if (job) enqueueSave(job)
  }

  useEffect(() => {
    let live = true
    activePath.current = path
    setProps(null)
    readProps(path).then(({ props, sha: s }) => {
      if (!live) return
      sha.current = s
      shaByPath.current.set(path, s)
      setProps(props)
    })
    // Une édition du fichier quitté est vidée immédiatement avec SON chemin et SON SHA ; elle ne peut plus
    // emprunter le SHA du fichier suivant ni être annulée par son prochain debounce.
    return () => { live = false; if (pending.current?.path === path) flushPending() }
  }, [path])

  const save = (next) => {
    setProps(next)
    clearTimeout(timer.current)
    pending.current = { path, next, sha: shaByPath.current.get(path) ?? sha.current }
    timer.current = setTimeout(flushPending, 800)
  }
  const eagle = (props && props.eagle) || {}
  const setEagle = (patch) => save({ ...props, eagle: { ...eagle, ...patch } })

  if (!props) return <div style={{ padding: 16, color: t.textSecondary, fontSize: 'var(--zr-ui-md)' }}>chargement…</div>
  const tags = Array.isArray(eagle.tags) ? eagle.tags : []
  const row = { display: 'flex', flexDirection: 'column', gap: 5, marginBottom: 16 }
  const label = { fontFamily: "var(--zr-police-sans)", fontSize: 'var(--zr-ui-2xs)', textTransform: 'uppercase', letterSpacing: 1, color: t.textSecondary }
  const input = { background: t.surface, border: `1px solid ${t.border}`, borderRadius: RADII.sm, color: t.textPrimary, fontSize: 'var(--zr-ui-md)', padding: '7px 9px', outline: 'none', fontFamily: "var(--zr-police-sans)", width: '100%', boxSizing: 'border-box' }

  return (
    <div className="zr-glass" style={{ width: 280, flex: '0 0 280px', height: '100%', overflowY: 'auto', padding: '16px 14px', borderLeft: t.hairline || `1px solid ${t.border}`, boxShadow: 'none', borderRadius: 0 }}>
      <div style={{ fontFamily: "var(--zr-police-sans)", fontSize: 'var(--zr-ui-2xl)', fontWeight: 700, color: t.textPrimary, marginBottom: 4, wordBreak: 'break-word' }}>{title}</div>
      {eagle.src && <img src={eagle.src} alt="" style={{ width: '100%', borderRadius: RADII.md, marginBottom: 14, background: t.bg }} />}

      <div style={row}><span style={label}>Note</span>
        <div style={{ display: 'flex', gap: 4 }}>{[1, 2, 3, 4, 5].map((n) => { const on = (eagle.rating || 0) >= n; return <button key={n} onClick={() => setEagle({ rating: eagle.rating === n ? 0 : n })} style={{ background: 'none', border: 'none', cursor: 'pointer', padding: 0, display: 'inline-flex' }}><Icon name="star" size={18} grad={on} color={on ? PALETTE.primary : t.border} /></button> })}</div>
      </div>

      <div style={row}><span style={label}>Notes</span>
        <textarea value={eagle.notes || ''} onChange={(e) => setEagle({ notes: e.target.value })} placeholder="Ajouter une note…" rows={4} style={{ ...input, resize: 'vertical', lineHeight: 1.5 }} />
      </div>

      <div style={row}><span style={label}>Tags</span>
        <div style={{ display: 'flex', flexWrap: 'wrap', gap: 5 }}>
          {tags.map((tag) => <span key={tag} style={{ display: 'inline-flex', alignItems: 'center', gap: 4, background: PALETTE.primarySoft, color: PALETTE.primary, borderRadius: 99, padding: '2px 4px 2px 9px', fontSize: 'var(--zr-ui-sm)' }}>{tag}<button onClick={() => setEagle({ tags: tags.filter((x) => x !== tag) })} style={{ background: 'none', border: 'none', color: PALETTE.primary, cursor: 'pointer', padding: '0 2px', display: 'inline-flex', alignItems: 'center' }}><Icon name="xmark" size={11} weight={2.2} color={PALETTE.primary} /></button></span>)}
          <input placeholder="+ tag" onKeyDown={(e) => { if (e.key === 'Enter' && e.target.value.trim()) { const v = e.target.value.trim(); if (!tags.includes(v)) setEagle({ tags: [...tags, v] }); e.target.value = '' } }} style={{ ...input, width: 70, padding: '2px 8px', fontSize: 'var(--zr-ui-sm)' }} />
        </div>
      </div>

      <div style={row}><span style={label}>URL source</span>
        <input value={eagle.url || ''} onChange={(e) => setEagle({ url: e.target.value })} placeholder="https://…" style={input} />
        {eagle.url && <a href={eagle.url} target="_blank" rel="noreferrer" style={{ display: 'inline-flex', alignItems: 'center', gap: 4, color: PALETTE.primary, fontSize: 'var(--zr-ui-xs)', textDecoration: 'none' }}><Icon name="arrow.up.right" size={12} color={PALETTE.primary} />{domainOf(eagle.url)}</a>}
      </div>

      <div style={{ borderTop: t.hairline || `1px solid ${t.border}`, paddingTop: 12, fontFamily: "var(--zr-police-sans)", fontSize: 'var(--zr-ui-xs)', color: t.textSecondary, lineHeight: 1.8 }}>
        {eagle.w && eagle.h ? <div>{eagle.w}×{eagle.h} · {orientationOf(eagle.w, eagle.h)}</div> : null}
        {eagle.bytes ? <div>{humanBytes(eagle.bytes)}</div> : null}
        {eagle.mime ? <div>{eagle.mime}</div> : null}
      </div>

      <button onClick={onOpen} style={{ marginTop: 14, width: '100%', background: PALETTE.gradient, color: '#fff', border: 'none', borderRadius: RADII.sm, padding: '8px', cursor: 'pointer', fontSize: 'var(--zr-ui-md)', fontWeight: 600 }}>Ouvrir</button>
    </div>
  )
}
