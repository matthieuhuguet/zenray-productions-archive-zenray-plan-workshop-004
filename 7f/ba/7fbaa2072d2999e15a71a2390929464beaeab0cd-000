import { describe, expect, it } from 'vitest'
import { isEagleLink } from './eagleLink.js'

describe('Eagle link descriptor', () => {
  it('accepts only the versioned placement schema', () => {
    expect(isEagleLink({ type: 'zenray-eagle-link/v1', resourceId: 'zr_123' })).toBe(true)
    expect(isEagleLink({ type: 'zenray-eagle-link/v1' })).toBe(false)
    expect(isEagleLink({ type: 'youtube', resourceId: 'zr_123' })).toBe(false)
  })
})
