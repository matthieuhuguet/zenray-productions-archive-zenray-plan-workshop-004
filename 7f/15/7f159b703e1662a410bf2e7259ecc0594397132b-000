import { describe, it, expect } from 'vitest'
import { readFileSync } from 'node:fs'
import { EXTENSIONS_NOEUDS, MARQUEURS_DOSSIER, RE_NOEUD, sansExtensionNoeud, estMarqueurDossier, nodeFilePairsForMove, nodeFilesForPath } from './extensionsNoeuds.js'

// ═══ AUCUNE COPIE DE LA LISTE NE DOIT DIVERGER ══════════════════════════════════════════════════
//
// La même liste d'extensions existait en quatorze copies dans huit fichiers, et deux d'entre elles
// avaient déjà divergé : `build-search-index.mjs` avait oublié `ref.json` et `plan.json`, si bien
// qu'une reconstruction d'index effaçait de la recherche trois boards Ref et un plan qui existent
// réellement sur le drive.
//
// Ce contrôle lit les fichiers du dépôt, extrait chaque liste qu'il y trouve, et la compare à la
// source unique. Il rougit sur l'oubli AVANT qu'il ne se voie — c'est-à-dire avant qu'un nœud ne
// devienne introuvable sans que rien ne le signale.

// Les fichiers qui portent une liste d'extensions de nœud. Un fichier absent d'ici n'est pas
// contrôlé : l'ajouter quand on y écrit une nouvelle liste fait partie du travail.
const PORTEURS = [
  'server/nodeTreeFilter.js',
  'scripts/build-search-index.mjs',
  // Ajouté le 2026-08-31 : `MOVE_NODE_RE` y était recopié TROIS fois, et les trois copies avaient
  // oublié `ref.json` et `zmedia.json`. Un board Ref déplacé n'était donc pas réindexé : il
  // disparaissait de la recherche sans que rien ne le signale.
  'server/page.js',
]

// Extrait les extensions d'une alternance de type `md|db\.json|img\.json`.
function extensionsDe(source) {
  const listes = []
  for (const m of source.matchAll(/\(([a-z]{2,}(?:\\\.[a-z]+)?(?:\|[a-z]{2,}(?:\\\.[a-z]+)?){3,})\)/g)) {
    const parts = m[1].split('|').map((p) => p.replace(/\\\./g, '.'))
    // On ne garde que les alternances qui ressemblent VRAIMENT à une liste de nœuds : au moins
    // `img.json` ou `md` dedans, sinon on ramasserait n'importe quelle autre expression du fichier.
    if (parts.includes('img.json') || (parts.includes('md') && parts.some((p) => p.endsWith('.json')))) {
      listes.push(parts)
    }
  }
  return listes
}

describe('la liste des extensions de nœud n’existe qu’à un seul endroit', () => {
  // 9 October 2026 08:05 CEST: Include the comment node already recognized by the UI model.
  it('la source unique couvre les onze types de nœuds du projet', () => {
    for (const e of ['md', 'img.json', 'media.json', 'db.json', 'canvas.json', 'ref.json', 'embed.json', 'file.json', 'plan.json', 'zmedia.json', 'comment.json']) {
      expect(EXTENSIONS_NOEUDS, `${e} manque à la source unique`).toContain(e)
    }
  })

  it.each(PORTEURS)('%s ne contient aucune liste plus courte que la source', (fichier) => {
    let src
    try { src = readFileSync(fichier, 'utf8') } catch { return }   // fichier déplacé : rien à contrôler
    for (const liste of extensionsDe(src)) {
      const manquants = EXTENSIONS_NOEUDS.filter((e) => !liste.includes(e))
      expect(manquants, `${fichier} oublie ${manquants.join(', ')} — ces nœuds deviendront invisibles sans que rien ne le signale`)
        .toEqual([])
    }
  })

  // 9 October 2026 08:20 CEST: Catch stale matcher names in the standalone index builder.
  it('the search index builder calls the shared node matcher', () => {
    const builder = readFileSync('scripts/build-search-index.mjs', 'utf8')
    expect(builder).toContain('RE_NOEUD.test(e.name)')
    expect(builder).not.toContain('NODE_RE')
  })

  it('DÉTECTE vraiment un oubli : la liste amputée qui a causé le bug rougit', () => {
    // Un contrôle qui n'a jamais rougi n'a rien prouvé. On lui donne la liste exacte de
    // `build-search-index.mjs` avant correction.
    const amputee = ['md', 'db.json', 'media.json', 'img.json', 'canvas.json', 'embed.json', 'file.json']
    const manquants = EXTENSIONS_NOEUDS.filter((e) => !amputee.includes(e))
    expect(manquants).toEqual(['ref.json', 'plan.json', 'zmedia.json', 'comment.json'])
  })
})

describe('RE_NOEUD reconnaît un nœud, et rien d’autre', () => {
  it('accepte les onze types', () => {
    for (const e of EXTENSIONS_NOEUDS) expect(RE_NOEUD.test(`pages/A/x.${e}`), `${e} refusé`).toBe(true)
  })

  it('refuse les jumeaux techniques d’une page', () => {
    // `.props.json`, `.comments.json` et `.blocknote.json` accompagnent une page : les compter comme
    // des nœuds ferait apparaître trois fantômes par page dans l'arborescence.
    for (const f of ['x.props.json', 'x.comments.json', 'x.blocknote.json', 'x.json', 'x.txt']) {
      expect(RE_NOEUD.test(`pages/A/${f}`), `${f} accepté à tort`).toBe(false)
    }
  })

  it('sansExtensionNoeud rend le nom affichable', () => {
    expect(sansExtensionNoeud('Agenda.plan.json')).toBe('Agenda')
    expect(sansExtensionNoeud('Board.ref.json')).toBe('Board')
    expect(sansExtensionNoeud('Notes.md')).toBe('Notes')
    expect(sansExtensionNoeud('IMG_5522.jpeg.img.json')).toBe('IMG_5522.jpeg')
  })
})

describe('node move paths', () => {
  // 9 October 2026 08:07 CEST: Prove every registered suffix is accepted by the shared move contract.
  it.each(EXTENSIONS_NOEUDS)('moves a %s node with its expected files', (extension) => {
    const from = `pages/Project/source.${extension}`
    const to = `trash/Project/target.${extension}`
    const expected = extension === 'md'
      ? [[from, to], ...['.blocknote.json', '.comments.json', '.props.json'].map((suffix) => [from.replace(/\.md$/, suffix), to.replace(/\.md$/, suffix)])]
      : [[from, to]]
    expect(nodeFilePairsForMove(from, to)).toEqual(expected)
  })

  it('allows the legacy canvas and current ref board suffixes to move as one type', () => {
    expect(nodeFilePairsForMove('pages/Old.canvas.json', 'pages/New.ref.json'))
      .toEqual([['pages/Old.canvas.json', 'pages/New.ref.json']])
  })

  it('rejects unknown suffixes, mismatched node types, and page sidecars as primary nodes', () => {
    expect(nodeFilePairsForMove('pages/a.png', 'pages/b.png')).toBeNull()
    expect(nodeFilePairsForMove('pages/a.md', 'pages/b.comment.json')).toBeNull()
    expect(nodeFilePairsForMove('pages/a.props.json', 'pages/b.props.json')).toBeNull()
  })

  it('lists page twins together while keeping archived Markdown files independent', () => {
    expect(nodeFilesForPath('trash/Note.md')).toEqual([
      'trash/Note.md', 'trash/Note.blocknote.json', 'trash/Note.comments.json', 'trash/Note.props.json',
    ])
    expect(nodeFilesForPath('trash/Note.md.file.json')).toEqual(['trash/Note.md.file.json'])
  })
})

describe('les marqueurs de dossier ne sont jamais des nœuds', () => {
  it('les trois marqueurs sont reconnus', () => {
    for (const m of MARQUEURS_DOSSIER) expect(estMarqueurDossier(`pages/A/${m}`), `${m} non reconnu`).toBe(true)
  })

  it('`.zrmusic.json` en fait partie — son oubli affichait un faux dossier', () => {
    expect(MARQUEURS_DOSSIER).toContain('.zrmusic.json')
    expect(estMarqueurDossier('pages/Musique/.zrmusic.json')).toBe(true)
  })

  it('un vrai nœud n’est pas pris pour un marqueur', () => {
    expect(estMarqueurDossier('pages/A/photo.img.json')).toBe(false)
  })
})
