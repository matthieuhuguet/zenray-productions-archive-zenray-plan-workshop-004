// 5 October 2026: Matthieu's own searches, as the page reads and writes `freelance/my-searches.json`.
// Removing one only dates it (`removedAt`): the file is a history, nothing is ever erased.
// FR : les recherches de Matthieu. Retirer une recherche la date seulement : le fichier est un historique, rien ne s'efface.
export const SEARCHES_PATH = 'freelance/my-searches.json'

export const normalizeSearches = (data) => {
  const list = data && Array.isArray(data.searches) ? data.searches.filter((entry) => entry && entry.id) : []
  return { v: 1, searches: list }
}
export const activeSearches = (file) => normalizeSearches(file).searches.filter((entry) => !entry.removedAt)
export const isAddress = (text) => /^https?:\/\/\S+$/i.test(String(text || '').trim())

/** The same address or keywords twice is one search; returns the file unchanged then. */
export function addSearch(file, { label = '', input, at, id }) {
  const value = String(input || '').trim()
  if (!value) return { file: normalizeSearches(file), error: 'Écris des mots-clés ou colle une adresse.' }
  const current = normalizeSearches(file)
  const entry = isAddress(value)
    ? { id, kind: 'link', label: String(label || '').trim() || value.replace(/^https?:\/\/(www\.)?/i, '').slice(0, 60), url: value, addedAt: at }
    : { id, kind: 'keywords', label: String(label || '').trim() || value.slice(0, 60), keywords: value, addedAt: at }
  const same = (other) => !other.removedAt && other.kind === entry.kind && (entry.kind === 'link' ? other.url === entry.url : String(other.keywords).toLowerCase() === value.toLowerCase())
  if (current.searches.some(same)) return { file: current, error: 'Cette recherche existe déjà.' }
  return { file: { ...current, searches: [...current.searches, entry] }, entry }
}

export function removeSearch(file, id, at) {
  const current = normalizeSearches(file)
  return { ...current, searches: current.searches.map((entry) => (entry.id === id && !entry.removedAt ? { ...entry, removedAt: at } : entry)) }
}
