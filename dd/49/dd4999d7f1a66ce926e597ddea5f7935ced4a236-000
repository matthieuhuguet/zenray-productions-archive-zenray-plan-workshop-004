// 3 October 2026, 22:14 CEST: a destination never proves a backup, and disconnected metadata never proves local presence.
import { expect, it } from 'vitest'
import { assetsFileLocations } from './assetsFileLocations.js'
const project = { folder: 'pages/ZenRayAssets/tiles', sources: [{ id: 'scene', namespace: 'houdini', localPath: '/Production/Tiles' }] }
it('keeps full observed paths and distinguishes present, missing, pending and divergent versions', () => {
  const file = { name: 'ad.mov', sourceId: 'scene', relativePath: 'render/ad.mov', present: true, status: 'local-only' }
  const pending = assetsFileLocations(file, project, true)
  expect(pending.local).toMatchObject({ path: '/Production/Tiles/render/ad.mov', state: 'Sur ce Mac' })
  expect(pending.cloud).toMatchObject({ path: 'pages/ZenRayAssets/tiles/sources/houdini/scene/render/ad.mov', state: 'Destination prévue, pas encore sauvegardé' })
  const loaded = assetsFileLocations({ ...file, loadedCopy: true, localPath: '/ManagedCopy/render/ad.mov', cloudPath: 'pages/verified/ad.mov.file.json', status: 'backed-up' }, project, true)
  expect(loaded.local.path).toBe('/ManagedCopy/render/ad.mov')
  expect(loaded.local.state).toBe('Copie chargée')
  expect(loaded.cloud.state).toBe('Sauvegardé')
  expect(assetsFileLocations({ ...file, present: false }, project, true).local.state).toBe('Absent de ce Mac')
  expect(assetsFileLocations({ ...file, cloudPath: 'cloud/ad.mov', status: 'modified' }, project, true).cloud.state).toBe('Versions différentes')
})
it('does not invent local presence or unsafe paths and updates when cloud evidence appears', () => {
  const file = { name: 'a.png', relativePath: 'a.png', cloudPath: 'cloud/a.png' }
  expect(assetsFileLocations(file, {}, false).local).toMatchObject({ path: null, state: 'Mac déconnecté, présence à vérifier' })
  expect(assetsFileLocations({ sourceId: 'scene', relativePath: '../a.png' }, project, true).local.path).toBeNull()
  expect(assetsFileLocations({}, {}, true).cloud.path).toBeNull()
  expect(assetsFileLocations({ ...file, present: true, localPath: '/New/a.png' }, {}, true).local.state).toBe('Sur ce Mac')
})

// 10 October 2026, 19:20 CEST: Legacy and malformed source identities must not crash cloud file rendering.
it.each([undefined, 'shorts/houdini-layers'])(
  'keeps cloud files readable when a legacy project source ID is %s', (sourceId) => {
  const legacyProject = {
    id: 'roof-tiles-copernicus-short',
    folder: 'pages/ZenRayAssets/tmp-roof-tiles-copernicus-short',
    sources: [{ id: sourceId, localPath: '/Users/zenray/.claude/tmp/roof-tiles', target: 'shorts/houdini-layers' }],
  }
  const legacyFile = {
    id: 'pages/ZenRayAssets/tmp-roof-tiles-copernicus-short/shorts/houdini-layers/walkthrough.mov.file.json',
    name: 'walkthrough.mov',
    relativePath: 'shorts/houdini-layers/walkthrough.mov',
    contentPath: 'pages/ZenRayAssets/tmp-roof-tiles-copernicus-short/shorts/houdini-layers/walkthrough.mov.file.json',
    status: 'cloud-only',
  }

  const locations = assetsFileLocations(legacyFile, legacyProject, false)
  expect(locations.local.path).toBeNull()
  expect(locations.cloud.path).toBe(legacyFile.contentPath)
  expect(locations.cloud.state).toBe('Archive référencée')
})

// 3 October 2026, 22:18 CEST: missing descendants do not prove a folder is absent, and mixed archive coverage stays partial.
it('maps a column folder from descendants of different depths without inventing complete coverage', async () => {
  const { assetsFolderFile } = await import('./assetsFileLocations.js')
  const files = [{ sourceId: 'scene', relativePath: 'render/a.mov', present: false }, { sourceId: 'scene', relativePath: 'render/deep/b.mov', localPath: '/Copy/render/deep/b.mov', cloudPath: 'pages/tiles/render/deep/b.mov.file.json', status: 'backed-up' }]
  const folder = assetsFolderFile(files, 1, 'render')
  expect(folder.localPath).toBe('/Copy/render')
  expect(folder.cloudPath).toBe('pages/tiles/render')
  expect(assetsFileLocations(folder, project, true).cloud.state).toBe('Sauvegarde partielle')
  expect(assetsFileLocations(folder, project, true).local.state).toBe('Présence à vérifier')
  const root = assetsFolderFile([{ sourceId: 'scene', relativePath: 'a.mov' }], 0, 'scene')
  expect(assetsFileLocations(root, project, true).local.path).toBe('/Production/Tiles/')
})
