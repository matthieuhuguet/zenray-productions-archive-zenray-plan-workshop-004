          </div>) : <div className="assets-origin-unlinked"><span>Aucun dossier relié</span>{onLinkProject && <button type="button" onClick={() => onLinkProject(project, type.id)}>Relier un dossier <Icon name="plus" size={13} /></button>}</div>}
        </section>
      })}
    </div>
    <div className="assets-cloud-destination"><Icon name="lock.icloud" size={22} /><div><span className="assets-eyebrow">Destination du projet</span><code>{project.folder || 'Destination à définir'}</code></div>{project.folder && <ActionButton icon="arrow.up.right" onClick={() => window.dispatchEvent(new CustomEvent('zr:create-folder', { detail: { path: project.folder } }))}>Ouvrir dans Create</ActionButton>}{onArchive && <ActionButton icon="arrow.up" onClick={() => onArchive(project, [])} disabled={!connected || busy}>Sauvegarder le projet</ActionButton>}</div>
    {workshopPath && <div className="assets-shared-host"><Icon name="externaldrive" size={18} /><div><strong>Atelier du projet</strong><p>Déposez vos nouveaux fichiers ici pour les suivre et les sauvegarder automatiquement.</p><code>{workshopPath}</code></div>{onOpenWorkshop && <ActionButton icon="arrow.up.right" onClick={() => onOpenWorkshop(project)} disabled={!connected}>Ouvrir l’atelier</ActionButton>}</div>}
    {dependencyIds.map((id) => { const dependency = project.dependencies?.find((entry) => entry?.projectId === id); return <div className="assets-shared-host" key={id}><Icon name="link" size={18} /><div><strong>{projects.find((entry) => entry.id === id)?.name || dependency?.name || id}</strong><p>{dependency?.description}</p></div><ActionButton onClick={() => onSelectProject?.(id)}>Voir le projet hôte</ActionButton></div> })}
    <SceneResources project={project} projects={projects} connected={connected} onNavigateResource={onNavigateResource} onPrepareScene={onPrepareScene} busy={busy} />
    <p className="assets-footnote">{connected && checkedAt ? <>Dernier relevé : <span className="assets-number">{dateLabel(checkedAt)}</span>.</> : 'Connectez le Mac pour relever les dossiers actuels.'} Les emplacements restent visibles lorsque le Mac est déconnecté.</p>
  </section>
}

function Activity({ events, project, onPreview }) {
  const [search, setSearch] = useState('')
  const [eventFilter, setEventFilter] = useState('all')
  const filtered = events.filter(event => eventFilter === 'all' || (eventFilter === 'discussion' ? ['prompt', 'iteration', 'feedback', 'rule', 'result', 'order'].includes(event.type) : !['prompt', 'iteration', 'feedback', 'rule', 'result', 'order'].includes(event.type))).filter((event) => `${event.title || ''} ${event.body || event.detail || ''}`.toLocaleLowerCase('fr').includes(search.trim().toLocaleLowerCase('fr')))
  if (!events.length) return <EmptyState icon="clock.arrow.2.circlepath" title="Le suivi commence ici">Les sauvegardes, chargements et notes de ce projet se réunissent dans cet historique.</EmptyState>
  return <section className="assets-activity" aria-label="Historique du projet"><div className="assets-section-heading"><div><h3>La mémoire du projet</h3><p>Prompts, décisions et résultats composent la même chronologie.</p></div></div><input className="assets-search" aria-label="Rechercher dans la mémoire du projet" placeholder="Retrouver un prompt, une décision ou une itération" value={search} onChange={(event) => setSearch(event.target.value)} /><label className="assets-select-label">Afficher <select aria-label="Filtrer l’historique" value={eventFilter} onChange={event => setEventFilter(event.target.value)}><option value="all">Tout l’historique</option><option value="discussion">Discussions et feedbacks</option><option value="operations">Fichiers et opérations</option></select></label><p className="assets-footnote">Codex et Claude Code : messages des sessions liées. Gemini et Antigravity : compte rendu explicite de fin de tour, tant que leur conversation native n’est pas importée.</p><ol className="assets-timeline">{filtered.map((event, index) => {
    const type = EVENT_TYPES[event.type] || { label: 'Action', icon: 'clock' }
    const timestamp = event.createdAt || event.at || event.date
    return <li key={event.id || `${timestamp}:${index}`}><span className="assets-timeline-symbol"><Icon name={type.icon} size={16} /></span><div className="assets-timeline-content"><span className="assets-eyebrow">{type.label}{event.provenance && <> · {event.provenance.provider || 'Feedback'}{event.provenance.actor === 'subagent' && ' · Sous-agent'} · {event.provenance.mode === 'transcript' ? 'Conversation capturée' : event.provenance.mode === 'checkpoint' ? 'Compte rendu de fin de tour' : 'Note consignée'}</>}</span><div><h4>{event.title || event.message || 'Action du projet'}</h4>{timestamp && <time className="assets-number" dateTime={String(timestamp)}>{timestampLabel(timestamp)}</time>}</div>{(event.detail || event.body) && <details><summary>{String(event.detail || event.body).split('\n').find((line) => line.trim())?.slice(0, 180) || 'Lire le contenu'}</summary><p>{event.detail || event.body}</p></details>}{event.provenance?.transcriptFile && <small className="assets-footnote">Source : <code>{event.provenance.transcriptFile}</code></small>}{event.file && onPreview && <button type="button" className="assets-text-button" onClick={() => onPreview(event.file, project)}>Lire le fichier <Icon name="arrow.up.right" size={13} /></button>}</div></li>
  })}</ol></section>
}

// 9 October 2026, 11:04 CEST: Place synchronization controls with their Mac and cloud locations.
function ProjectTransfer({ project, bridgeConnected, busy, interactiveBusy, pendingCount, pendingOperation, operation, activeJob, selectedFiles, downloadableFiles, onWatch, onArchive, onLoad, onUnload, onRecover, runAction }) {
  return <section className="assets-project-transfer" aria-label="Sauvegarde et chargement"><div><Icon name="lock.icloud" size={22} /><div><span className="assets-transfer-title">{busy ? (pendingOperation && operation?.label ? `${operation.label}${operation.state === 'queued' ? ' en attente' : ''}` : null) || (activeJob ? `${TRANSFER_LABELS[activeJob.type] || 'Action'} ${activeJob.state === 'queued' ? 'en attente' : 'en cours'}…` : 'Action en cours…') : bridgeConnected && pendingCount ? <><span className="assets-number">{numberFormat.format(pendingCount)}</span> fichiers à sauvegarder</> : bridgeConnected ? 'Projet relié au Mac' : 'Retrouver le projet sur ce Mac'}</span><p>{busy && operation?.detail ? operation.detail : bridgeConnected && pendingCount ? 'Les fichiers modifiés rejoignent leur dossier dans le cloud.' : bridgeConnected ? project.workspace?.path ? 'La copie de travail est suivie. Les sources de production restent en place.' : 'La sauvegarde et le chargement gardent les mêmes emplacements.' : 'Le cloud est consultable. Connectez le Mac pour connaître ses fichiers actuels.'}</p></div></div><div className="assets-transfer-actions">{onWatch && <ActionButton icon="arrow.clockwise" onClick={() => runAction(onWatch, project, !project.sync?.watched)} disabled={!bridgeConnected || interactiveBusy}>{project.sync?.watched ? 'Auto activée' : 'Activer auto'}</ActionButton>}{onArchive && <ActionButton icon="arrow.up" onClick={() => runAction(onArchive, project, selectedFiles)} disabled={!bridgeConnected || busy}>Sauvegarder{selectedFiles.length ? ' la sélection' : ''}</ActionButton>}{onLoad && <ActionButton icon="arrow.down" onClick={() => runAction(onLoad, project, selectedFiles)} disabled={!bridgeConnected || interactiveBusy || !downloadableFiles.length}>{project.workspace?.path ? 'Compléter la copie' : 'Charger sur le Mac'}</ActionButton>}{onUnload && <ActionButton icon="externaldrive" onClick={() => runAction(onUnload, project, selectedFiles)} disabled={!bridgeConnected || interactiveBusy || !project.workspace?.path}>Décharger la copie chargée</ActionButton>}{onRecover && project.workspace?.recoverableCount > 0 && <ActionButton icon="arrow.down" onClick={() => runAction(onRecover, project)} disabled={!bridgeConnected || interactiveBusy || !!project.workspace?.path}>Récupérer la copie déchargée</ActionButton>}</div></section>
