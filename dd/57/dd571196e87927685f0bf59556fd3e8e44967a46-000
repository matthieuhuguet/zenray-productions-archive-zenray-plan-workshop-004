    {showConversationArchives && visible.length > 0 && <><div className="assets-rail-label">Archives de conversations <span className="assets-number">{numberFormat.format(visible.length)}</span></div><nav className="assets-project-list" aria-label="Choisir une archive de conversations">{projectItems}</nav></>}
