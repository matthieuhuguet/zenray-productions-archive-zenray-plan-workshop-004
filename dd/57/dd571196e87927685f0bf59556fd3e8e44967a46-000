// 3 October 2026, 04:31 CEST: expose exact resource links while keeping unresolved references and runtime verification distinct.
function SceneResources({ project, projects, connected, onNavigateResource, onPrepareScene, busy }) {
  const scenes = project.sceneReferences || []
  const pendingCount = connected ? project.sync?.sceneAuditPendingCount || 0 : 0
  if (!scenes.length && !pendingCount) return null
  const referenceLabels = { 'relocation-required': 'À reconnecter à la copie chargée', unresolved: 'À identifier', 'outside-mapping': 'Hors du projet', ambiguous: 'Plusieurs correspondances', dynamic: 'Séquence à vérifier', relative: 'Chemin relatif', uri: 'Ressource de session', directory: 'Dossier', internal: 'Ressource interne', output: 'Sortie' }
  return <section aria-label="Ressources des scènes"><div className="assets-section-heading"><div><h3>Ressources des scènes</h3><p>Les fichiers reliés au projet et aux bibliothèques partagées.</p></div></div>{pendingCount > 0 && <p className="assets-footnote" role="status"><span className="assets-number">{pendingCount}</span> {pendingCount === 1 ? 'scène en cours ou en attente d’analyse automatique.' : 'scènes en cours ou en attente d’analyse automatique.'}</p>}{scenes.map((scene) => {
    const targets = [...new Map(scene.references.filter((reference) => ['mapped', 'relocation-required'].includes(reference.type)).flatMap((reference) => reference.targets).map((target) => [`${target.projectId}/${target.fileId}`, target])).values()]
    const unresolved = scene.references.filter((reference) => ['unresolved', 'outside-mapping', 'ambiguous', 'dynamic', 'relative', 'relocation-required'].includes(reference.type))
    const sceneName = scene.sceneFileId.split(':').slice(1).join(':')
    const sceneFile = project.files?.find((file) => file.id === scene.sceneFileId)
    const canPrepare = connected && scene.state === 'current' && sceneFile?.loadedCopy && ['verified', 'backed-up'].includes(sceneFile.status)
    const preparation = scene.preparation
    return <details className="assets-origin-card assets-scene-resources" key={scene.sceneFileId}>
      <summary><code>{sceneName}</code>{scene.state === 'current' ? <span><span className="assets-number">{targets.length}</span> {targets.length === 1 ? 'fichier identifié' : 'fichiers identifiés'}{unresolved.length > 0 && <> · <span className="assets-number">{unresolved.length}</span> {unresolved.length === 1 ? 'référence à vérifier' : 'références à vérifier'}</>}</span> : <span>Analyse périmée</span>}</summary>
      {scene.state !== 'current' ? <p className="assets-footnote">La scène a changé. Son analyse se renouvelle automatiquement sur le Mac connecté.</p> : <>
        {targets.map((target) => <div className="assets-source-detail assets-scene-resource" key={`${target.projectId}/${target.fileId}`}><button type="button" className="assets-path-button" onClick={() => onNavigateResource(target)}><code>{target.relativePath}</code><Icon name="arrow.up.right" size={13} /></button><div className="assets-source-meta"><span>{target.projectId === project.id ? 'Ce projet' : projects.find((entry) => entry.id === target.projectId)?.name || target.projectId}</span><Status status={target.status} /></div></div>)}
        {unresolved.length > 0 && <details className="assets-source-detail"><summary>Références à vérifier</summary><p className="assets-footnote">Un chemin non identifié ne prouve pas qu’un fichier manque.</p>{unresolved.map((reference) => <div className="assets-source-detail" key={reference.referenceId}><code>{reference.parameterPath || 'Référence sans paramètre'}</code><p>{referenceLabels[reference.type]}</p></div>)}</details>}
      </>}
      {/* 3 October 2026, 09:19 CEST: a narrow resource proof stays distinct from a saved portable or rendered scene. */}
      {preparation && <div className="assets-source-detail" role="status"><p>{preparation.state === 'stale' ? 'La copie ou une ressource a changé. La vérification est à refaire.' : `Reconnexion vérifiée ${timestampLabel(preparation.checkedAt)}${connected && preparation.state === 'verified' ? ' pour les copies actuelles' : ''}.`}</p><p className="assets-footnote"><span className="assets-number">{preparation.inputCount}</span> entrées · <span className="assets-number">{preparation.libraryCount}</span> bibliothèques · <span className="assets-number">{preparation.instanceCount}</span> instances.</p>{(preparation.warningCount > 0 || preparation.diagnosticCount > 0) && <p className="assets-footnote">Le contrôle comporte des diagnostics conservés dans la preuve locale.</p>}</div>}
      {onPrepareScene && <ActionButton icon="checkmark" disabled={!canPrepare || busy} onClick={() => onPrepareScene(project, scene)}>Vérifier les ressources chargées</ActionButton>}
      <p className="assets-footnote">Le fonctionnement de la scène après rechargement reste à vérifier.</p>
    </details>
  })}</section>
}

