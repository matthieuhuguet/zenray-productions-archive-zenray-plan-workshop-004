function fileView(file, index) {
  const path = file.relativePath || file.path || file.contentPath || file.cloudPath || file.id || ''
  const name = file.name || (file.relativePath ? path : stripLeafExt(path)).split('/').pop() || 'Fichier'
  return {
    ...file,
    id: file.id || file.contentPath || file.cloudPath || `${path}:${index}`,
    name,
    relativePath: file.relativePath || name,
    kind: file.kind || kindForName(name),
    namespace: file.namespace || file.source || file.sourceId?.split(':')[0] || '',
    searchable: `${name} ${path} ${file.cloudPath || ''}`.toLocaleLowerCase('fr'),
  }
}

function dateLabel(value) {
  if (!value) return ''
  const date = new Date(value)
  return Number.isFinite(date.getTime()) ? dateFormat.format(date) : ''
}

function timestampLabel(value) {
  const date = new Date(value)
  return Number.isFinite(date.getTime()) ? `${dateFormat.format(date)} · ${timeFormat.format(date)}` : ''
}

function Status({ status = 'unknown', children }) {
  const state = FILE_STATES[status] || { label: 'État inconnu', tone: 'quiet', icon: 'clock' }
  return <span className={`assets-status assets-status-${state.tone}`}><span className="assets-status-dot" aria-hidden="true" />{children || state.label}</span>
}

function ActionButton({ icon, children, primary = false, ...props }) {
  return <button type="button" className={`assets-button${primary ? ' assets-button-primary' : ''}`} {...props}>{icon && <Icon name={icon} size={16} />}{children}</button>
}

function projectFileCount(project) {
  return Math.max(0, project?.files?.length || 0, Number(project?.sync?.count) || 0, Number(project?.inventory?.count) || 0)
}

// 8 October 2026 23:21 CEST: separate project spaces from archived conversation workspaces in the overview.
function ProjectInventorySummary({ projects, conversations = [], loading }) {
  const fileCount = projects.reduce((total, project) => total + projectFileCount(project), 0)
  const projectCount = projects.filter((project) => project.category !== 'Conversations').length
  const conversationArchiveCount = projects.length - projectCount
  return <section className="assets-inventory-summary" aria-label="Inventaire Assets" aria-busy={loading}>
    <div className="assets-inventory-topline"><span className="assets-eyebrow">Tout votre atelier</span><span className="assets-inventory-bricks" aria-hidden="true">{Array.from({ length: 5 }, (_, index) => <i key={index} />)}</span></div>
    <div className="assets-inventory-totals">
      <div><span className="assets-number">{loading ? '…' : numberFormat.format(projects.length)}</span><span>espaces</span></div>
      <div><span className="assets-number">{loading ? '…' : numberFormat.format(fileCount)}</span><span>fichiers</span></div>
    </div>
    <p>{loading ? 'Lecture des espaces et de leurs fichiers.' : `${numberFormat.format(projectCount)} ${projectCount === 1 ? 'projet' : 'projets'}, ${numberFormat.format(conversationArchiveCount)} ${conversationArchiveCount === 1 ? 'archive de conversation' : 'archives de conversations'} · ${numberFormat.format(conversations.length)} conversations indexées.`}</p>
  </section>
}

function FileImage({ file, renderThumbnail, cover = false }) {
  // A stored direct thumbnail (cover chosen or found by name) paints at once and never goes through a manifest read.
  if (file?.thumbnailUrl || file?.coverUrl) return <img src={file.thumbnailUrl || file.coverUrl} alt="" loading="lazy" decoding="async" />
  if (renderThumbnail && (file?.contentPath || file?.cloudPath || file?.kind === 'image')) return renderThumbnail(file, { size: cover ? 280 : 44, cover })
  if (file?.thumbnailUrl || file?.coverUrl) return <img src={file.thumbnailUrl || file.coverUrl} alt="" loading="lazy" />
  return <Icon name={KIND_ICONS[file?.kind] || 'doc'} size={cover ? 40 : 24} />
}

