// 9 October 2026, 11:04 CEST: Show indexed evidence and primary binding as separate facts.
function ProjectConversations({ project, projects, conversations, indexState, onOpen }) {
  return <section className="assets-project-conversations" aria-label="Conversations liées au projet">
    <div className="assets-section-heading"><div><h3>Conversations liées</h3><p>Les liens par activité restent distincts du projet principal de chaque session.</p></div><span className="assets-number">{numberFormat.format(conversations.length)}</span></div>
    {indexState?.state === 'error' && <p role="alert">Index des conversations illisible : {indexState.error}</p>}
    {indexState?.state === 'missing-index' && <p role="status">L’index de ce projet n’est pas encore disponible.</p>}
    {indexState?.state === 'missing-source' && <p role="status">Aucun dossier Memory n’est relié à ce projet.</p>}
    {!conversations.length && !['error', 'missing-index', 'missing-source'].includes(indexState?.state) && <p role="status">Recherche des conversations liées…</p>}
    {conversations.length > 0 && <div className="assets-linked-conversation-list">{conversations.map((item) => {
      const primaryName = projects.find((candidate) => candidate.id === item.primaryProjectId)?.name || item.primaryProjectId
      const linkLabel = item.linkRelation === 'primary' ? 'Projet principal' : `Lié par activité · ${item.linkStrength === 'strong' ? 'forte' : item.linkStrength === 'weak' ? 'à confirmer' : 'indexée'}`
      return <button type="button" className="assets-linked-conversation" key={item.id} onClick={() => onOpen(item)}>
        <ConversationBadge provider={item.provider} />
        <span className="assets-linked-conversation-copy"><span>{item.title}</span><small>{linkLabel}{item.primaryProjectId && item.primaryProjectId !== project.id ? ` · Projet principal : ${primaryName}` : ''}</small></span>
        <span className="assets-linked-conversation-status">{item.readable ? 'Lire l’original' : 'Original indisponible'}</span>
      </button>
    })}</div>}
    {indexState?.scannedAt && <p className="assets-footnote">Index contrôlé le <span className="assets-number">{dateLabel(indexState.scannedAt)}</span>.</p>}
  </section>
}


export default function ProjectWorkspace({
  conversationMirrorStatus, conversations = [], projectConversationLinks, readConversation,
  projects: suppliedProjects = [], activeProjectId, onSelectProject, workspaceProject, files: suppliedFiles, activity,
  t, loading = false, error, offline = false, bridgeConnected = false, bridgeCheckedAt,
  operation, onRetry, onLinkProject, onArchive, onLoad, onUnload, onRecover, onPrepareScene, onDownload, onPreview, onWatch,
  onOpenPath, onOpenWorkshop, onOpenLegacy, renderThumbnail, readArticle,
}) {
  const [activeConversation, setActiveConversation] = useState(null)
  const [conversationReturnProjectId, setConversationReturnProjectId] = useState(null)
  const currentConversation = conversations.find(item => item.id === activeConversation?.id) || activeConversation
  const [internalProjectId, setInternalProjectId] = useState(null)
  // 12 October 2026: a chosen thumbnail (right click) or one found by name replaces the project's automatic cover everywhere.
  const { covers, setCover, previewCover, clearCover } = useProjectCovers()
  const projects = useMemo(() => suppliedProjects.map((item) => {
    const chosen = covers[item.id]
    const value = chosen?.file ? { ...item, coverFile: chosen.file, coverChoice: chosen.choice } : item
    const thumbnail = chosen?.choice !== 'manual' && articleThumbnail(item)
    return thumbnail ? { ...value, coverUrl: thumbnail } : value
  }), [suppliedProjects, covers])
  // 12 October 2026: Tube is the default layout; Classic stays one click away for comparison.
  const [layout, setLayoutState] = useState(() => { try { return localStorage.getItem('assets.layout') === 'classic' ? 'classic' : 'tube' } catch { return 'tube' } })
  const setLayout = (value) => { setLayoutState(value); try { localStorage.setItem('assets.layout', value) } catch { /* storage may be blocked */ } }
  const tube = layout === 'tube'
  // Home grid first, unless the URL names a project (shared link or reload inside a project).
  const [tubeHome, setTubeHome] = useState(() => { try { return !new URLSearchParams(location.search).has('project') } catch { return true } })
  const [projectSearch, setProjectSearch] = useState('')
  const [fileSearch, setFileSearch] = useState('')
  const [sourceFilter, setSourceFilter] = useState('all')
  const [statusFilter, setStatusFilter] = useState('all')
  const [tab, setTab] = useState(null)
  const [selected, setSelected] = useState(new Set())
  const [focusId, setFocusId] = useState(null)
  const [fileLayout, setFileLayout] = useState('list')
  const [query, setQuery] = useState({ ...FILE_QUERY_DEFAULTS })
  const sort = query.sort
  const setSort = (key) => setQuery(previous => ({ ...previous, sort: key, direction: previous.sort === key && previous.direction === 'asc' ? 'desc' : 'asc' }))
  const [page, setPage] = useState(1)
  const [message, setMessage] = useState('')
  const [actionBusy, setActionBusy] = useState(false)
  const [resourceTarget, setResourceTarget] = useState(null)
  const selectAllRef = useRef(null)
  const currentId = activeProjectId ?? internalProjectId
  // 12 October 2026: while the catalogue still loads, a requested project is not replaced by the first one of the list.
  const registryProject = projects.find((project) => project.id === currentId) || (currentId && loading ? null : projects[0]) || null
  const project = registryProject ? workspaceProject?.id === registryProject.id ? { ...registryProject, ...workspaceProject } : registryProject : null
  const projectId = project?.id
  // 20 October 2026, 15:15 CEST: only projects with an explicit article open it before their files.
  const hasArticle = Boolean(project?.article?.fileId)
  // 21 October 2026 : ?article=<fileId> opens another HTML document of this project in the Article tab (the project's article index links to each article
  // this way : the file is read live from the Mac, else from its latest archive, so a link never shows a stale copy and needs no push)
  const [linkedArticleId] = useState(() => { try { return new URLSearchParams(location.search).get('article') } catch { return null } })
  const currentTab = (tab === 'article' && !hasArticle ? 'files' : tab) || (hasArticle ? 'article' : 'files')
  const projectTabs = hasArticle ? [{ id: 'article', label: 'Article', icon: 'doc.text' }, ...TABS] : TABS
  const linkedIndexRows = projectConversationLinks && projectConversationLinks.projectId === projectId ? projectConversationLinks.conversations : project?.conversationLinks?.conversations
  const linkedProjectConversations = useMemo(() => mergeProjectConversations(linkedIndexRows, conversations, projectId), [linkedIndexRows, conversations, projectId])
  const openConversation = (item) => {
    setConversationReturnProjectId(item.projectId || projectId || item.primaryProjectId || null)
    setActiveConversation(item)
  }
  const projectFiles = suppliedFiles ?? project?.files ?? []
  const files = useMemo(() => projectFiles.map(fileView), [projectFiles])
  const sources = project?.sources || project?.origins || []
  const events = activity ?? project?.events ?? project?.activity ?? []
  const checkedAt = bridgeCheckedAt || project?.checkedAt
  const activeJob = project?.jobs?.find((job) => job.state === 'running') || project?.jobs?.find((job) => job.state === 'queued')
  const pendingOperation = Boolean(operation && !['idle', 'complete', 'error'].includes(operation.state))
  // 14 October 2026: an automatic (background) pass never locks the buttons; the service hands the writer to a clicked action at the next batch.
  const foregroundJob = project?.jobs?.find((job) => !job.background && (job.state === 'running' || job.state === 'queued'))
  const busy = actionBusy || Boolean(foregroundJob) || pendingOperation
  // 2 October 2026, 15:22 CEST: cloud backups may queue a foreground action instead of disabling its button.
  const interactiveBusy = actionBusy || Boolean(foregroundJob && foregroundJob.type !== 'archive') || pendingOperation
  const visible = useMemo(() => queryAssetsFiles(files.filter((file) =>
    (sourceFilter === 'all' || (sourceFilter === 'cloud' ? !!(file.contentPath || file.cloudPath) : file.namespace === sourceFilter || sources.find(source => source.id === file.sourceId)?.namespace === sourceFilter))
    && (statusFilter === 'all' || (statusFilter === 'pending' ? (bridgeConnected && file.sourceConflict) || ['local-only', 'pending', 'modified', 'error'].includes(file.status) : file.status === statusFilter))),
    { ...query, search: fileSearch }), [files, fileSearch, sourceFilter, statusFilter, query, sources, bridgeConnected])

  const selectedFiles = files.filter((file) => selected.has(file.id))
  const pageCount = Math.max(1, Math.ceil(visible.length / PAGE_SIZE))
  const currentPage = Math.min(page, pageCount)
  const displayed = visible.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE)
  const downloadableFiles = (selectedFiles.length ? selectedFiles : visible).filter((file) => file.downloadable !== false && (file.contentPath || file.cloudPath))
  const pendingCount = project?.sync?.pendingCount ?? files.filter((file) => ['local-only', 'pending', 'modified'].includes(file.status)).length
  const totalBytes = files.reduce((total, file) => total + (Number(file.size) || 0), 0)
  const allVisibleSelected = visible.length > 0 && visible.every((file) => selected.has(file.id))
  const hasVisibleSelection = visible.some((file) => selected.has(file.id))
  const focusedFile = files.find((file) => file.id === focusId) || selectedFiles[0]

  useEffect(() => { setTab(null); setSelected(new Set()); setFocusId(null); setFileSearch(''); setSourceFilter('all'); setStatusFilter('all'); setQuery({ ...FILE_QUERY_DEFAULTS }); setMessage('') }, [projectId])
  useEffect(() => { setPage(1) }, [projectId, fileSearch, sourceFilter, statusFilter, query])
  useEffect(() => { if (selectAllRef.current) selectAllRef.current.indeterminate = hasVisibleSelection && !allVisibleSelected }, [hasVisibleSelection, allVisibleSelected])
  useEffect(() => { const current = new Set(files.map((file) => file.id)); setSelected((previous) => [...previous].every((id) => current.has(id)) ? previous : new Set([...previous].filter((id) => current.has(id)))) }, [files])
  // 3 October 2026, 04:32 CEST: locate a resource by exact identity after its own project has become active.
  useEffect(() => {
    if (resourceTarget?.projectId !== projectId || !files.some((file) => file.id === resourceTarget?.fileId)) return
    setTab('files'); setFileSearch(resourceTarget.relativePath); setSourceFilter('all'); setStatusFilter('all'); setQuery({ ...FILE_QUERY_DEFAULTS })
    setFocusId(resourceTarget.fileId); setSelected(new Set([resourceTarget.fileId])); setResourceTarget(null)
  }, [resourceTarget, projectId, files])

  const chooseProject = (id) => { setInternalProjectId(id); setTubeHome(false); onSelectProject?.(id) }
  const toggleFile = (file, event) => {
    setFocusId(file.id)
    setSelected((previous) => {
      const next = new Set(previous)
      if (event?.shiftKey && focusId) {
        const start = visible.findIndex((item) => item.id === focusId)
        const end = visible.findIndex((item) => item.id === file.id)
        if (start >= 0 && end >= 0) visible.slice(Math.min(start, end), Math.max(start, end) + 1).forEach((item) => next.add(item.id))
      } else if (next.has(file.id)) next.delete(file.id)
      else next.add(file.id)
      return next
    })
  }
  const toggleVisible = () => setSelected((previous) => { const next = new Set(previous); visible.forEach((file) => allVisibleSelected ? next.delete(file.id) : next.add(file.id)); return next })
  const runReadAction = async (callback, ...args) => {
    if (!callback) return
    setMessage('')
    try { await callback(...args) } catch (failure) { setMessage(failure.message || 'Lecture impossible.') }
  }
  const runAction = async (callback, ...args) => {
    if (!callback || interactiveBusy) return
    setActionBusy(true); setMessage('')
    try { await callback(...args) } catch (failure) { setMessage(failure?.message || 'Cette action n’a pas abouti. Réessayez.') } finally { setActionBusy(false) }
  }
  const keyDown = (event) => {
    if (event.target.closest('input, select, textarea, button, a')) return
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'a') { event.preventDefault(); setSelected(new Set(visible.map((file) => file.id))); return }
    if (event.key === 'Escape') { setSelected(new Set()); return }
    if (event.key === ' ' && focusedFile && onPreview) { event.preventDefault(); runReadAction(onPreview, focusedFile, project); return }
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault()
      const index = visible.findIndex((file) => file.id === focusId)
      const next = visible[Math.max(0, Math.min(visible.length - 1, index + (event.key === 'ArrowDown' ? 1 : -1)))]
      if (next) { setFocusId(next.id); setSelected(new Set([next.id])) }
    }
  }
  const themeVariables = {
    '--assets-ink': t?.textPrimary || PALETTE.textPrimaryLight,
    '--assets-muted': t?.textSecondary || PALETTE.textSecondaryLight,
    '--assets-background': t?.bg || PALETTE.bgLight,
    '--assets-surface': t?.surface || PALETTE.surfaceLight,
    '--assets-accent': PALETTE.orange,
    '--assets-positive': UI.green,
    '--assets-warning': UI.orange,
    '--assets-error': UI.red,
  }
  const coverFile = project?.coverFile || files.find((file) => file.kind === 'image' && (file.contentPath || file.cloudPath || file.thumbnailUrl))
  // Opening a project that has no chosen thumbnail but holds a file named like one adopts it, once, and remembers it.
  const autoCoverTried = useRef(new Set())
  // The stored reference carries a small fitted thumbnail (data URI) so the card never needs the original image again.
  const chooseCover = async (file, choice = 'manual', reason) => {
    previewCover(projectId, file, choice)
    let thumbnailUrl
    try { thumbnailUrl = await coverThumbnailDataUri(file) } catch { /* the app falls back to the shared renderer */ }
    return setCover(projectId, thumbnailUrl ? { ...file, thumbnailUrl } : file, choice, reason)
  }
  const [adjustTarget, setAdjustTarget] = useState(null)
  const openAdjustCover = (targetProject, targetFile) => {
    if (!targetProject) return
    const file = targetFile || targetProject.coverFile || (targetProject.coverUrl ? { thumbnailUrl: targetProject.coverUrl, name: `${targetProject.name} cover` } : null)
    if (!file && (!targetProject.files || !targetProject.files.length)) {
      if (targetProject.id === projectId && files.length) {
        const picked = pickProjectCover(files)?.file || files.find((f) => f.kind === 'image')
        if (picked) {
          setAdjustTarget({ project: targetProject, file: picked })
          return
        }
      }
      setMessage("Ce projet n'a aucune image à cadrer.")
      return
    }
    setAdjustTarget({ project: targetProject, file })
  }

  const handleSaveAdjustedCover = async (thumbnailUrl, metadata = {}) => {
    if (!adjustTarget?.project?.id) return
    const pid = adjustTarget.project.id
    const baseFile = adjustTarget.file || adjustTarget.project.coverFile || {
      id: `cover-${pid}`,
      name: `${pid}-cover.webp`,
      kind: 'image',
    }
    const updatedFile = {
      ...baseFile,
      thumbnailUrl,
      adjustMeta: metadata,
    }
    previewCover(pid, updatedFile, 'manual')
    const result = await setCover(pid, updatedFile, 'manual', 'adjusted')
    setAdjustTarget(null)
    setMessage('Miniature ajustée et enregistrée.')
    return result
  }
  useEffect(() => {
    const current = covers[projectId]
    // A manual choice is final; an automatic one can still be upgraded when a file named like a thumbnail appears.
    if (!projectId || articleThumbnail(project) || !files.length || autoCoverTried.current.has(projectId) || (current && (current.choice === 'manual' || current.reason === 'named'))) return
    autoCoverTried.current.add(projectId)
    const picked = pickProjectCover(files, { named: true })
    if (picked && picked.file.id !== current?.file?.id) chooseCover(picked.file, 'auto', 'named')
  }, [projectId, files, covers])

  const layoutSwitch = <TubeLayoutSwitch layout={layout} onChange={setLayout} />
  return <div className="assets-workspace" data-layout={layout} style={themeVariables} onKeyDown={keyDown}>
    {!tube && <ProjectRail conversationMirrorStatus={conversationMirrorStatus} conversations={conversations} activeConversation={currentConversation} onConversation={(item) => { setConversationReturnProjectId(item.projectId || projectId); setActiveConversation(item) }} projects={projects} activeId={projectId} onSelect={(id) => { setActiveConversation(null); chooseProject(id) }} onLinkProject={onLinkProject} onAdjustCover={openAdjustCover} search={projectSearch} onSearch={setProjectSearch} renderThumbnail={renderThumbnail} loading={loading} />}
    <main className="assets-workspace-main" aria-label="Espace du projet" tabIndex={0}>
      <div className="assets-layout-bar">{layoutSwitch}</div>
      {!tube && <LiveTransfersPanel />}
      {tube && tubeHome && !currentConversation ? <><div className="tube-head"><h1>ZenRay <em>Assets</em></h1></div><TubeHome projects={projects} covers={covers} conversations={conversations} onSelect={chooseProject} onConversation={(item) => { setConversationReturnProjectId(item.projectId || null); setActiveConversation(item) }} onLinkProject={onLinkProject} onAdjustCover={openAdjustCover} renderThumbnail={renderThumbnail} loading={loading} /></> : currentConversation ? <><button type="button" className="assets-text-button" onClick={() => { setActiveConversation(null); if (conversationReturnProjectId || currentConversation.projectId) chooseProject(conversationReturnProjectId || currentConversation.projectId); setConversationReturnProjectId(null) }}>Retour au projet</button><ConversationView conversation={currentConversation} readConversation={readConversation} connected={bridgeConnected} /></> : <>
      {(offline || error || message) && <div className={`assets-notice${error || message ? ' assets-notice-error' : ''}`} role={error || message ? 'alert' : 'status'}><Icon name={offline ? 'externaldrive' : 'xmark'} size={16} /><span>{message || (typeof error === 'string' ? error : error?.message) || 'Connexion interrompue. Les fichiers déjà chargés restent consultables.'}</span>{onRetry && <button type="button" onClick={onRetry}>Réessayer <Icon name="arrow.clockwise" size={13} /></button>}</div>}
      {/* 3 October 2026, 03:21 CEST: a live watcher failure remains visible while archived files stay available. */}
      {bridgeConnected && project?.sync?.sourceConflictCount > 0 && <div className="assets-notice" role="alert"><Icon name="exclamationmark.triangle" size={16} /><span><span className="assets-number">{project.sync.sourceConflictCount}</span> {project.sync.sourceConflictCount === 1 ? 'fichier existe' : 'fichiers existent'} en deux versions différentes : original et copie chargée. Le programme conserve les deux versions avant de poursuivre leur sauvegarde ; les autres fichiers restent suivis.</span></div>}
      {bridgeConnected && project?.sync?.watchError && <div className="assets-notice" role="status" title={project.sync.watchError}><Icon name="arrow.clockwise" size={16} /><span>Le suivi d’un emplacement attend son rétablissement. Reconnexion automatique en cours.</span></div>}
      {bridgeConnected && project?.sync?.feedbackError && <div className="assets-notice" role="status" title={project.sync.feedbackError}><Icon name="bubble.left" size={16} /><span>La collecte automatique des prompts rencontre une erreur. Certaines sessions attendent une vérification.</span></div>}
      {/* 3 October 2026, 04:25 CEST: a failed automatic scene analysis remains visible while file tracking continues. */}
      {bridgeConnected && project?.sync?.sceneAuditError && <div className="assets-notice" role="status" title={project.sync.sceneAuditError}><Icon name="arrow.clockwise" size={16} /><span>L’analyse des ressources d’une scène attend une nouvelle tentative automatique. Le suivi des fichiers continue.</span></div>}
      {loading && !project ? <div className="assets-loading" role="status"><span className="assets-loading-line" /><span className="assets-loading-line" /><p>Chargement des projets…</p></div> : !project ? <EmptyState icon="archivebox" title="Un endroit pour chaque projet" action={onLinkProject && <ActionButton icon="plus" primary onClick={onLinkProject}>Relier mon premier projet</ActionButton>}>Reliez un chantier pour réunir ses fichiers du Mac, ses notes et son archive cloud.</EmptyState> : <>
        <div className="assets-project-topline">{tube ? <button type="button" className="tube-back" onClick={() => setTubeHome(true)}><Icon name="chevron.left" size={13} />Projets</button> : <span><Icon name="archivebox" size={14} /> <span>Projets</span><Icon name="chevron.right" size={11} /><span>{project.name}</span></span>}<div className="assets-bridge-state"><span className="assets-status-dot" data-connected={bridgeConnected} />{bridgeConnected ? 'Mac connecté' : 'État local inconnu'}{onRetry && <button type="button" className="assets-icon-button" aria-label="Actualiser les états du projet" title="Actualiser les états" onClick={onRetry} disabled={loading}><Icon name="arrow.clockwise" size={14} /></button>}</div></div>
        <header className="assets-project-header"><div className="assets-project-intro"><h2>{project.name}</h2>{(project.summary || project.description) && <p>{project.summary || project.description}</p>}<div className="assets-source-weights">{SOURCE_TYPES.map((type) => ({ ...type, bytes: sources.filter((source) => source.namespace === type.id).reduce((total, source) => total + (source.bytes || 0), 0) })).filter((source) => source.bytes > 0).map((source) => <span key={source.id}>{source.label} <span className="assets-number">{readableSize(source.bytes)}</span></span>)}</div><div className="assets-project-facts"><span><span className="assets-number">{numberFormat.format(files.length)}</span> fichiers</span>{totalBytes > 0 && <span className="assets-number">{readableSize(totalBytes)}</span>}{project.date && <span className="assets-number">{dateLabel(project.date)}</span>}</div></div><div className="assets-project-cover" data-placeholder={!coverFile && !project.coverUrl} onContextMenu={(event) => { event.preventDefault(); openAdjustCover(project, coverFile) }} title="Clic droit pour modifier la miniature">{project.coverUrl ? <img src={project.coverUrl} alt="" loading="lazy" /> : coverFile ? <FileImage file={coverFile} renderThumbnail={renderThumbnail} cover /> : <><Icon name="archivebox" size={34} /><span>Archive du projet</span></>}</div></header>


        <nav className="assets-tabs" aria-label="Vues du projet">{projectTabs.map((item) => <button type="button" key={item.id} aria-current={currentTab === item.id ? 'page' : undefined} data-active={currentTab === item.id} onClick={() => setTab(item.id)}><Icon name={item.icon} size={16} />{item.label}{item.id === 'conversations' ? <span className="assets-number">{numberFormat.format(linkedProjectConversations.length)}</span> : item.id === 'files' && <span className="assets-number">{numberFormat.format(files.length)}</span>}</button>)}{onOpenLegacy && <button type="button" className="assets-legacy-link" onClick={() => onOpenLegacy(project)}>Voir la collection <Icon name="arrow.up.right" size={13} /></button>}</nav>
        {currentTab === 'article' ? <ProjectArticle project={project} file={linkedArticleFile(project, files, linkedArticleId) || projectArticleFile(project, files)} readArticle={readArticle} /> : currentTab === 'origins' ? <><ProjectTransfer project={project} bridgeConnected={bridgeConnected} busy={busy} interactiveBusy={interactiveBusy} pendingCount={pendingCount} pendingOperation={pendingOperation} operation={operation} activeJob={activeJob} selectedFiles={selectedFiles} downloadableFiles={downloadableFiles} onWatch={onWatch} onArchive={onArchive} onLoad={onLoad} onUnload={onUnload} onRecover={onRecover} runAction={runAction} />        <Origins project={project} projects={projects} sources={sources} onSelectProject={chooseProject} onNavigateResource={(target) => { setResourceTarget(target); if (target.projectId !== projectId) chooseProject(target.projectId) }} connected={bridgeConnected} checkedAt={checkedAt} onOpenPath={onOpenPath} onOpenWorkshop={onOpenWorkshop ? (target) => runReadAction(onOpenWorkshop, target) : undefined} onLinkProject={onLinkProject} onArchive={onArchive ? (...args) => runAction(onArchive, ...args) : undefined} onPrepareScene={onPrepareScene ? (...args) => runAction(onPrepareScene, ...args) : undefined} busy={busy} /></> : currentTab === 'conversations' ? <ProjectConversations project={project} projects={projects} conversations={linkedProjectConversations} indexState={projectConversationLinks} onOpen={openConversation} /> : currentTab === 'activity' || currentTab === 'prompts' ? <Activity events={currentTab === 'prompts' ? events.filter((event) => ['prompt','feedback','iteration','rule'].includes(event.type)) : events} project={project} onPreview={onPreview} /> : tube ? <TubeProject project={project} files={files} visible={visible} sources={sources} selected={selected} onToggle={toggleFile} onPreview={onPreview ? (file) => runReadAction(onPreview, file, project) : undefined} onDownload={onDownload ? (list) => runReadAction(onDownload, list, { ...project, name: `tmp-${project.id}` }) : undefined} offline={offline} renderThumbnail={renderThumbnail} themeVars={themeVariables} coverId={covers[projectId]?.file?.id || project?.coverFile?.id} onSetCover={(file) => chooseCover(file, 'manual')} onClearCover={() => clearCover(projectId)} onAdjustCover={(file) => openAdjustCover(project, file)} search={fileSearch} onSearch={setFileSearch} sort={sort} direction={query.direction} onSort={setSort} /> : <>
        <section className="assets-files" aria-label="Fichiers du projet">
          <div className="assets-file-toolbar"><label className="assets-search assets-file-search"><Icon name="magnifyingglass" size={15} /><input aria-label="Rechercher un fichier" value={fileSearch} onChange={(event) => setFileSearch(event.target.value)} placeholder="Rechercher un fichier ou un chemin" />{fileSearch && <button type="button" className="assets-icon-button" aria-label="Effacer la recherche de fichiers" onClick={() => setFileSearch('')}><Icon name="xmark" size={13} /></button>}</label><div className="assets-file-toolbar-controls"><div className="assets-view-switch" role="group" aria-label="Présentation des fichiers">{FILE_VIEWS.map(view => <button type="button" className="assets-button" key={view.id} aria-pressed={fileLayout === view.id} onClick={() => setFileLayout(view.id)}><Icon name={view.icon} size={15} />{view.label}</button>)}</div><label className="assets-select-label"><span className="assets-sr-only">État des fichiers</span><select value={statusFilter} onChange={(event) => setStatusFilter(event.target.value)}><option value="all">Tous les états</option><option value="pending">À sauvegarder</option><option value="backed-up">Sauvegardés</option><option value="verified">Vérifiés</option><option value="error">À vérifier</option></select></label><ActionButton icon="arrow.down" primary disabled={!onDownload || !downloadableFiles.length || selectedFiles.length > downloadableFiles.length || offline} onClick={() => runReadAction(onDownload, downloadableFiles, project)}>Télécharger{selectedFiles.length ? <> <span className="assets-number">{downloadableFiles.length}</span></> : downloadableFiles.length === files.length ? ' tout' : <> les <span className="assets-number">{downloadableFiles.length}</span> sauvegardés</>}</ActionButton></div></div>
          <FileFilters files={files} query={query} onChange={setQuery} />
          <div className="assets-file-filters" aria-label="Filtrer par origine">{[{ id: 'all', label: 'Tout' }, { id: 'cloud', label: 'Cloud' }, ...SOURCE_TYPES].map((source) => <button type="button" key={source.id} data-active={sourceFilter === source.id} aria-pressed={sourceFilter === source.id} onClick={() => setSourceFilter(source.id)}>{source.label}</button>)}<span className="assets-filter-count" aria-label="Taille des fichiers filtrés"><span className="assets-number">{numberFormat.format(visible.length)}</span> fichiers · <span className="assets-number">{fileSizeLabel(visible)}</span></span></div>
          {selectedFiles.length > 0 && <div className="assets-selection-bar" role="status"><span><span className="assets-number">{numberFormat.format(selectedFiles.length)}</span> sélectionnés · <span className="assets-number">{fileSizeLabel(selectedFiles)}</span></span><button type="button" onClick={() => setSelected(new Set(files.map((file) => file.id)))}>Tout le projet</button><button type="button" onClick={() => setSelected(new Set())}>Effacer <Icon name="xmark" size={12} /></button></div>}
          {!files.length ? <EmptyState title="Les fichiers se réunissent ici">{bridgeConnected ? 'L’inventaire ne contient aucun fichier. Reliez les dossiers de ce projet dans Emplacements.' : 'L’archive ne contient aucun fichier chargé dans cette vue. Actualisez le cloud ou reliez un dossier local.'}</EmptyState> : !visible.length ? <EmptyState icon="magnifyingglass" title="Aucun fichier ne correspond" action={<ActionButton onClick={() => { setFileSearch(''); setSourceFilter('all'); setStatusFilter('all'); setQuery({ ...FILE_QUERY_DEFAULTS }) }}>Effacer les filtres</ActionButton>}>Changez le nom, l’origine ou l’état recherché.</EmptyState> : fileLayout !== 'list' ? <FilePresentations project={project} connected={bridgeConnected} key={projectId} view={fileLayout} files={fileLayout === 'columns' ? visible : displayed} selected={selected} focusedFile={focusedFile} onToggle={toggleFile} onFocus={file => setFocusId(file.id)} onPreview={onPreview ? file => runReadAction(onPreview, file, project) : undefined} renderImage={(file, cover) => <FileImage file={file} renderThumbnail={renderThumbnail} cover={cover} />} /> : <div className="assets-file-table" role="table" aria-label="Liste des fichiers"><div className="assets-file-table-head" role="row"><span role="columnheader"><input ref={selectAllRef} type="checkbox" aria-label="Sélectionner tous les fichiers filtrés" checked={allVisibleSelected} onChange={toggleVisible} /></span><button type="button" role="columnheader" onClick={() => setSort('name')}>Nom{sort === 'name' && <Icon name="chevron.down" size={11} />}</button><button type="button" role="columnheader" onClick={() => setSort('kind')}>Type</button><button type="button" role="columnheader" onClick={() => setSort('date')}>Date et heure</button><span role="columnheader">Origine</span><span role="columnheader">Cloud</span><button type="button" role="columnheader" className="assets-size-heading" onClick={() => setSort('size')}>Taille{sort === 'size' && <Icon name="chevron.down" size={11} />}</button><span className="assets-sr-only" role="columnheader">Actions</span></div>{displayed.map((file) => {
            const source = sources.find((item) => item.id === file.sourceId)
            const namespace = source?.namespace || file.namespace
            const downloadable = file.downloadable !== false && (file.contentPath || file.cloudPath)
            return <div className="assets-file-row" role="row" key={file.id} data-selected={selected.has(file.id)} data-focused={focusId === file.id} onClick={(event) => { if (!event.target.closest('button,input,a')) toggleFile(file, event) }} onDoubleClick={(event) => { if (!event.target.closest('button,input,a') && onPreview) runReadAction(onPreview, file, project) }}><span role="cell" className="assets-file-check"><input type="checkbox" aria-label={`Sélectionner ${file.name}`} checked={selected.has(file.id)} onChange={(event) => toggleFile(file, event.nativeEvent)} /></span><div role="cell" className="assets-file-name"><span className="assets-file-thumb"><FileImage file={file} renderThumbnail={renderThumbnail} /></span><div><button type="button" className="assets-file-name-button" onClick={() => { setFocusId(file.id); onPreview && runReadAction(onPreview, file, project) }} title={file.name}>{file.name}</button><FileLocations file={file} project={project} connected={bridgeConnected} /><span className="assets-file-mobile-meta"><span>{SOURCE_LABELS[namespace] || (downloadable ? 'Cloud' : 'Mac')}</span><Status status={bridgeConnected && file.sourceConflict ? 'source-conflict' : file.status || (downloadable ? 'cloud-only' : 'unknown')} /></span></div></div><span role="cell" className="assets-file-kind">{extOf(file.name).toUpperCase() || file.kind}</span><time role="cell" className="assets-file-date assets-number">{fileDate(file) !== null ? timestampLabel(fileDate(file)) : 'Non connue'}</time><span role="cell" className="assets-file-origin"><Icon name={SOURCE_TYPES.find((item) => item.id === namespace)?.icon || 'lock.icloud'} size={14} />{SOURCE_LABELS[namespace] || (downloadable ? 'Cloud' : 'Mac')}</span><span role="cell" className="assets-file-state"><Status status={bridgeConnected && file.sourceConflict ? 'source-conflict' : file.status || (downloadable ? 'cloud-only' : 'unknown')} /></span><span role="cell" className="assets-file-size assets-number">{Number.isFinite(file.size) ? readableSize(file.size) || '0 Ko' : 'À relever'}</span><span role="cell" className="assets-file-actions">{onPreview && <button type="button" className="assets-icon-button" aria-label={`Aperçu de ${file.name}`} title="Aperçu" onClick={() => runReadAction(onPreview, file, project)}><Icon name="eye" size={16} /></button>}{onDownload && <button type="button" className="assets-icon-button" aria-label={`Télécharger ${file.name}`} title="Télécharger" disabled={!downloadable || offline} onClick={() => runReadAction(onDownload, [file], project)}><Icon name="arrow.down" size={16} /></button>}</span></div>
          })}</div>}
          <footer className="assets-file-footer">{fileLayout !== 'columns' && displayed.length < visible.length && <span aria-label="Taille de la page affichée"><span className="assets-number">{numberFormat.format(displayed.length)}</span> affichés · <span className="assets-number">{fileSizeLabel(displayed)}</span></span>}<span>{selectedFiles.length ? <><span className="assets-number">{numberFormat.format(selectedFiles.length)}</span> fichiers sélectionnés</> : 'Sélectionnez un fichier, plusieurs ou tout le projet.'}</span><span className="assets-pagination" hidden={fileLayout === 'columns'}><button type="button" className="assets-text-button" disabled={currentPage === 1} onClick={() => setPage(currentPage - 1)}>Précédent</button><span className="assets-number">{currentPage} / {pageCount}</span><button type="button" className="assets-text-button" disabled={currentPage === pageCount} onClick={() => setPage(currentPage + 1)}>Suivant</button></span></footer>
        {/* 9 October 2026, 11:15 CEST: Keep sibling keys unique so layout changes unmount the old presentation. */}
        <StorageBreakdown key={`storage:${projectId}`} project={project} connected={bridgeConnected} files={files} onOpenFile={onPreview ? (file) => runReadAction(onPreview, file, project) : undefined} /></section>
        </>}
      </>}
      </>}
    </main>
    {adjustTarget && <CoverAdjustModal project={adjustTarget.project} file={adjustTarget.file} themeVars={themeVariables} onClose={() => setAdjustTarget(null)} onSave={handleSaveAdjustedCover} />}
  </div>
}
