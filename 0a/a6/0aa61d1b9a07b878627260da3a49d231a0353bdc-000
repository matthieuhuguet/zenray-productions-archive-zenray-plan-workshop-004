// 9 October 2026, 11:04 CEST: Keep path evidence separate from a conversation's primary project binding.
export function mergeProjectConversations(indexRows, catalogue, projectId) {
  if (!Array.isArray(indexRows) || typeof projectId !== 'string' || !projectId) return []
  const byId = new Map((Array.isArray(catalogue) ? catalogue : []).filter(item => item?.id).map(item => [item.id, item]))
  const bySession = new Map((Array.isArray(catalogue) ? catalogue : []).filter(item => item?.sessionId).map(item => [item.sessionId, item]))
  const seen = new Set()
  return indexRows.flatMap(row => {
    if (!row || row.projectId !== projectId) return []
    const id = row.conversationId || (row.provider && row.sessionId ? `${row.provider}:${row.sessionId}` : null)
    if (!id || seen.has(id)) return []
    seen.add(id)
    const original = byId.get(id) || bySession.get(row.sessionId) || null
    const primaryProjectId = original?.projectId || row.boundProject || null
    return [{
      ...original,
      id,
      sessionId: row.sessionId || original?.sessionId || id.slice(id.indexOf(':') + 1),
      title: original?.title || row.title || id,
      provider: original?.provider || row.provider || id.split(':', 1)[0],
      updatedAt: original?.updatedAt || row.updatedAt || row.last || null,
      projectId,
      primaryProjectId,
      linkStrength: row.strength || 'unknown',
      linkRelation: primaryProjectId === projectId ? 'primary' : 'evidence',
      readable: original?.readable === true,
      unavailableReason: original?.unavailableReason || (original?.readable === true ? null : 'transcript-missing'),
    }]
  }).sort((left, right) => Date.parse(right.updatedAt || 0) - Date.parse(left.updatedAt || 0))
}
