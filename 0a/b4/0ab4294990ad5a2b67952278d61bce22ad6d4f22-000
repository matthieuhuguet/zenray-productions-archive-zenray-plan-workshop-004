// Lecture LIVE read-only d'un fichier markdown d'un repo perso (Memory / .claude) via le token serveur.
// CONTENU servi par raw.githubusercontent.com : NE COMPTE PAS dans la limite REST 5000/h (contrairement à
// l'API contents qui la consommait -> 'not-found' trompeur quand le quota tombait). Même pattern que page.js/img.js.
// Env : GITHUB_TOKEN (lecture sur les repos), MEMORY_REPO (def matthieuhuguet/Memory), CLAUDE_REPO (def .claude).
import { documentRepo, isAllowedDocumentPath, normalizeDocumentPath } from './doc-access-policy.js'

export default async function handler(req, res) {
  const token = process.env.GITHUB_TOKEN
  const target = documentRepo(req.query.repo)
  const branch = process.env.MEMORY_BRANCH || 'main'
  const path = normalizeDocumentPath(req.query.path)

  if (!target) return res.status(400).json({ markdown: null, error: 'bad-repo' })
  if (!isAllowedDocumentPath(path)) return res.status(403).json({ markdown: null, error: 'forbidden-path' })
  if (!token) return res.status(200).json({ markdown: null, error: 'no-token' })

  try {
    // raw CDN (immuable côté quota REST). Le token autorise la lecture des repos privés.
    const encodedPath = path.split('/').map(encodeURIComponent).join('/')
    const r = await fetch(`https://raw.githubusercontent.com/${target.repo}/${branch}/${encodedPath}`, {
      headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' },
      cache: 'no-store',
    })
    if (r.status === 401 || r.status === 403) return res.status(200).json({ markdown: null, error: 'token-expired' })
    if (r.status === 404) return res.status(200).json({ markdown: null, error: 'not-found' })
    if (!r.ok) { const t = await r.text(); return res.status(200).json({ markdown: null, error: 'github', detail: t.slice(0, 160) }) }
    const md = await r.text()
    res.setHeader('Cache-Control', 'no-store')
    return res.status(200).json({ markdown: md, path })
  } catch {
    return res.status(200).json({ markdown: null, error: 'fetch' })
  }
}
