import { describe, it, expect } from 'vitest'
import { sessionId, entriesOf, upsertEntry, removeEntry, lastPerformance, renderNote, noteBlock, summary, resolvePlanPath } from './sportPlan.js'
import { applyNoteBlock, dayParts, dayNotePath } from './dayNote.js'
import { SPORT } from '../config/sport.js'

const board = () => ({ type: 'plan', tasks: [{ id: 'x1', title: 'Autre', date: '2026-10-12' }] })
const e1 = { ex: 'dips', name: 'Dips lestés', sets: 3, reps: 8, kg: 10 }
const e2 = { ex: 'ohp', name: 'Développé militaire', sets: 4, reps: 6, kg: 0 }
const NOW = '2026-10-16T14:27:00.000Z'

describe('carte Plan unique par jour', () => {
  it('crée UNE tâche faite par jour, sans toucher aux autres', () => {
    const b = upsertEntry(board(), '2026-10-12', { ...e1, at: '09:12' }, NOW)
    expect(b.tasks).toHaveLength(2)
    const t = b.tasks.find((x) => x.id === sessionId('2026-10-12'))
    expect(t).toMatchObject({ status: 'done', date: '2026-10-12', startTime: '09:12', title: SPORT.plan.title })
    expect(t.sport.entries).toHaveLength(1)
  })
  it('un second exercice S AJOUTE à la même carte, il n en crée pas une autre', () => {
    let b = upsertEntry(board(), '2026-10-12', { ...e1, at: '09:12' }, NOW)
    b = upsertEntry(b, '2026-10-12', { ...e2, at: '09:30' }, NOW)
    expect(b.tasks.filter((x) => x.id === sessionId('2026-10-12'))).toHaveLength(1)
    expect(entriesOf(b, '2026-10-12').map((e) => e.ex)).toEqual(['dips', 'ohp'])
    expect(b.tasks.find((x) => x.id === sessionId('2026-10-12')).note).toContain('Développé militaire : 4 × 6')
  })
  it('modifier un exercice le remplace sur place et garde son heure d origine', () => {
    let b = upsertEntry(board(), '2026-10-12', { ...e1, at: '09:12' }, NOW)
    b = upsertEntry(b, '2026-10-12', { ...e1, reps: 10, at: '18:00' }, NOW)
    expect(entriesOf(b, '2026-10-12')).toHaveLength(1)
    expect(entriesOf(b, '2026-10-12')[0]).toMatchObject({ reps: 10, at: '09:12' })
  })
  it('retirer le dernier exercice supprime toute la carte', () => {
    let b = upsertEntry(board(), '2026-10-12', { ...e1, at: '09:12' }, NOW)
    b = removeEntry(b, '2026-10-12', 'dips', NOW)
    expect(b.tasks.map((x) => x.id)).toEqual(['x1'])
  })
  it('un jour passé reste un jour passé : la date de la carte est celle choisie', () => {
    const b = upsertEntry(board(), '2026-10-01', { ...e1, at: '07:00' }, NOW)
    expect(b.tasks.find((x) => x.sport).date).toBe('2026-10-01')
    expect(entriesOf(b, '2026-10-16')).toEqual([])
  })
  it('la dernière performance ignore le jour courant', () => {
    let b = upsertEntry(board(), '2026-10-01', { ...e1, sets: 3, at: '07:00' }, NOW)
    b = upsertEntry(b, '2026-10-16', { ...e1, sets: 4, at: '07:00' }, NOW)
    expect(lastPerformance(b, 'dips', '2026-10-16')).toMatchObject({ sets: 3, date: '2026-10-01' })
  })
  it('affiche toujours l unité kg quand il y a une charge', () => {
    expect(summary(e1)).toBe('3 × 8 · 10 kg')
    expect(summary(e2)).toBe('4 × 6')
  })
  it('le plan actif : réglage manuel, puis épinglé, puis cache, puis repli', () => {
    expect(resolvePlanPath({ override: 'a.plan.json', pinned: ['b.plan.json'] })).toBe('a.plan.json')
    expect(resolvePlanPath({ pinned: ['b.plan.json'], cached: ['c.plan.json'] })).toBe('b.plan.json')
    expect(resolvePlanPath({ pinned: ['pas-un-plan.md'], cached: ['c.plan.json'] })).toBe('c.plan.json')
    expect(resolvePlanPath({})).toBe(SPORT.plan.fallbackPath)
  })
})

describe('note du jour', () => {
  const entries = [{ ...e1, at: '09:12' }, { ...e2, at: '09:30' }]
  it('titre et dossier sans accent, comme les notes existantes', () => {
    expect(dayParts('2026-08-04')).toEqual({ title: '4 Aout 2026', month: 'Aout 2026' })
  })
  it('résout le dossier Calendar existant (suffixe technique compris), jamais un chemin deviné', () => {
    const paths = ['pages/Calendar-76ct/Aout 2026-1lhw/4 Aout 2026.md', 'pages/Calendar-76ct/Matthieu2026-l8at.plan.json']
    expect(dayNotePath(paths, '2026-08-12')).toBe('pages/Calendar-76ct/Aout 2026-1lhw/12 Aout 2026.md')
  })
  it('ajoute le bloc à la fin d une note existante sans toucher au reste', () => {
    const out = applyNoteBlock('# 12 Octobre 2026\n\nMon texte\n', '12 Octobre 2026', entries)
    expect(out.startsWith('# 12 Octobre 2026\n\nMon texte\n')).toBe(true)
    expect(out).toContain(noteBlock(entries))
  })
  it('réécrit le bloc EXISTANT au lieu de le doubler (idempotent)', () => {
    const once = applyNoteBlock('# T\n\nMon texte\n', 'T', entries)
    const twice = applyNoteBlock(once, 'T', [...entries, { ...e1, ex: 'x', name: 'Autre', at: '10:00' }])
    expect(twice.match(/sport:start/g)).toHaveLength(1)
    expect(twice).toContain('Autre : 3 × 8')
    expect(applyNoteBlock(twice, 'T', [...entries, { ...e1, ex: 'x', name: 'Autre', at: '10:00' }])).toBe(twice)
  })
  it('crée la note quand elle n existe pas, avec son titre', () => {
    expect(applyNoteBlock('', '12 Octobre 2026', entries).startsWith('# 12 Octobre 2026\n\n')).toBe(true)
  })
  it('retirer tous les exercices enlève le bloc mais garde le texte', () => {
    const once = applyNoteBlock('# T\n\nMon texte\n', 'T', entries)
    const out = applyNoteBlock(once, 'T', [])
    expect(out).not.toContain('sport:start')
    expect(out).toContain('Mon texte')
  })
  it('le rendu de la note nomme les exercices avec unité', () => {
    expect(renderNote(entries)).toBe('- 09:12 Dips lestés : 3 × 8 · 10 kg\n- 09:30 Développé militaire : 4 × 6')
  })
})
