// Remplit `image` des jeux (public/shelf/games.json) via RAWG (clé en env RAWG_KEY, JAMAIS commitée).
// RAWG = base de jeux, 20k req/mois, pas de throttle agressif -> concurrence OK.
// NB : RAWG renvoie background_image (art PAYSAGE du jeu), pas une jaquette portrait. Crop central en carte 2:3.
// Idempotent : ne remplit que les jeux sans image. URL écrite = image publique RAWG (pas la clé).
import { readFile, writeFile } from 'node:fs/promises'

const ROOT = new URL('../public/shelf/', import.meta.url)
const KEY = process.env.RAWG_KEY
if (!KEY) { console.error('RAWG_KEY manquant en env'); process.exit(1) }
const clean = (s) => String(s).replace(/\s*\(\d{4}\)\s*$/, '').replace(/\s*[:\-–]\s*$/, '').trim()

async function rawg(name) {
  const u = `https://api.rawg.io/api/games?key=${KEY}&search=${encodeURIComponent(clean(name))}&page_size=1&search_precise=true`
  for (let a = 0; a < 3; a++) {
    try {
      const r = await fetch(u)
      if (r.status === 429) { await new Promise((z) => setTimeout(z, 900)); continue }
      if (!r.ok) return null
      const j = await r.json()
      return (j && j.results && j.results[0] && j.results[0].background_image) || null
    } catch { return null }
  }
  return null
}

async function pool(items, limit, fn) {
  let i = 0
  await Promise.all(Array.from({ length: Math.min(limit, items.length) }, async () => {
    while (i < items.length) { const idx = i++; await fn(items[idx]) }
  }))
}

const path = new URL('games.json', ROOT)
const data = JSON.parse(await readFile(path, 'utf8'))
const todo = data.items.filter((it) => !it.image)
let filled = 0
await pool(todo, 12, async (it) => { const url = await rawg(it.name); if (url) { it.image = { kind: 'url', ref: url }; filled++ } })
await writeFile(path, JSON.stringify(data, null, 2))
const total = data.items.filter((i) => i.image).length
console.log(`games.json: +${filled} cette passe -> ${total}/${data.items.length}`)
