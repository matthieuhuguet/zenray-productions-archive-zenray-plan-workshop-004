// retarget-folder.test.mjs (12 October 2026)
import test from 'node:test'
import assert from 'node:assert/strict'
import { retargetFolder } from './media-rename.mjs'

test('a film in a release-named folder goes to the root', () => {
  assert.equal(retargetFolder('Confessions (2010) (1080p BluRay x265 HEVC 10bit AAC 5.1 Japanese Silence)/Confessions (2010).mkv'), 'Confessions (2010).mkv')
  assert.equal(retargetFolder('1000.Men.And.Me.The.Bonnie.Blue.Story.2025.1080p.WEB.H264-CBFM [CheerfulTomato]/1000 Men And Me The Bonnie Blue Story.mkv'), '1000 Men And Me The Bonnie Blue Story.mkv')
})

test('an episode under a clean series folder and a season is left alone', () => {
  assert.equal(retargetFolder('House Of The Dragon/Saison 03/House Of The Dragon S03E07.mkv'), 'House Of The Dragon/Saison 03/House Of The Dragon S03E07.mkv')
})

test('a clean folder keeps its film', () => {
  assert.equal(retargetFolder('Hors Normes (2019)/Hors Normes (2019).mp4'), 'Hors Normes (2019)/Hors Normes (2019).mp4')
})

test('a folder alias files a special under the clean series', () => {
  const aliases = { 'Mushishi (2005) BDrip 1080p FLAC x265-GundamGuy': 'Mushishi' }
  assert.equal(retargetFolder('Mushishi (2005) BDrip 1080p FLAC x265-GundamGuy/Spéciaux & Film/Mushishi Film (2015).mkv', aliases), 'Mushishi/Spéciaux & Film/Mushishi Film (2015).mkv')
})

test('a file already at the root is untouched', () => {
  assert.equal(retargetFolder('Black Panther.mkv'), 'Black Panther.mkv')
})
