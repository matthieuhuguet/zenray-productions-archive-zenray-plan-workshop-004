export function videoGitAuthEnvironment(baseEnv, token) {
  if (!token) throw new Error('GitHub token is required for private video shards')
  const currentCount = Number.parseInt(baseEnv.GIT_CONFIG_COUNT || '0', 10)
  const authIndex = Number.isInteger(currentCount) && currentCount >= 0 ? currentCount : 0
  return {
