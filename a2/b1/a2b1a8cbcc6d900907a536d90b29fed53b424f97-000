// 12 October 2026: the answer to a repository creation, kept whole (headers and body) so that a GitHub refusal names its cause.
// The curl call used to discard both (-o /dev/null), which left three 30 minute waves of HTTP 403 unexplained. Only RESPONSE headers
// are printed (-i); the request, with its credentials, never is.
// FR : la reponse a une creation de depot est gardee en entier ; un refus de GitHub nomme alors sa cause.
export function repoCreateFailure(stdout) {
  const out = String(stdout || '')
  const code = out.trim().split('\n').pop().trim()
  const header = (name) => new RegExp(`^${name}:\\s*(.+)$`, 'im').exec(out)?.[1]?.trim()
  const message = /"message"\s*:\s*"([^"]*)"/.exec(out)?.[1] || ''
  const detail = [
    header('retry-after') ? `retry-after=${header('retry-after')}s` : '',
    header('x-ratelimit-remaining') ? `ratelimit-remaining=${header('x-ratelimit-remaining')}` : '',
    message ? `message="${message.slice(0, 160)}"` : '',
  ].filter(Boolean).join(' ')
  return { code, detail }
}

// 10 October 2026, 14:49 CEST: Tune push batches to measured network speed without changing shard capacity.
// 12 October 2026: without ZR_SHARD_PUSH_BATCH_MB the answer is the top of the push policy (20 parts, 1 900 MiB); with it the
// batch is fixed and the adaptive policy is disabled (backward compatible). FR : sans variable, le haut de la politique.
export function videoRawPushBatchBytes(env = process.env, partBytes = PART) {
  const config = loadPushPolicyConfig(env)
  const configuredMegabytes = Number(env.ZR_SHARD_PUSH_BATCH_MB)
  if (Number.isFinite(configuredMegabytes) && configuredMegabytes > 0) {
    return Math.max(partBytes + 16, Math.floor(configuredMegabytes * 1024 * 1024))
  }
  return config.ladder[config.ladder.length - 1] * config.partBytes
}

