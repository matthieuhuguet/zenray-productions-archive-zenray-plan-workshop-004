// MobileUploadButton.jsx — UPLOAD TRIVIAL sur iPhone (et tout mobile).
//
// EN CLAIR : sur téléphone, on veut envoyer une photo/vidéo/fichier en un geste. Ce bouton flottant (FAB)
// ouvre une petite feuille du bas (bottom-sheet) avec 3 entrées : Photo/Vidéo (appareil photo iOS), Galerie,
// Fichiers. Chaque entrée déclenche un <input type=file> natif ; les fichiers choisis partent dans `onUpload`,
// qui est branché sur runCapture -> classify : une image devient .img.json (affichable), une vidéo part en HLS,
// JAMAIS un chunk binaire opaque. Zéro routeur dédié mobile : on réutilise exactement le pipeline du desktop.
//
// Design : Liquid glass, accent corail #cc7c5e, graisses <= Medium. Respecte la safe-area (encoche/barre iOS).
import React, { useRef, useState } from 'react'
import Icon from './Icon.jsx'

const ACCENT = '#cc7c5e'

export default function MobileUploadButton({ t, onUpload }) {
  const [open, setOpen] = useState(false)
  const camRef = useRef(null)   // appareil photo direct (capture)
  const galRef = useRef(null)   // bibliothèque photos/vidéos
  const fileRef = useRef(null)  // tous fichiers
  const pick = (ref) => { setOpen(false); if (ref.current) ref.current.click() }
  const onChange = (ev) => { const fs = ev.target.files; ev.target.value = ''; if (fs && fs.length) onUpload(fs) }

  const dark = t && t.cardBg && /(?:#0|#1|#2|rgb\(\s*[0-4])/.test(String(t.cardBg))
  const sheetBg = dark ? 'rgba(28,28,30,0.86)' : 'rgba(255,255,255,0.86)'
  const itemBorder = dark ? 'rgba(255,255,255,0.10)' : 'rgba(0,0,0,0.06)'
  const txt = t ? t.textPrimary : '#1f1f1e'

  const Item = ({ icon, label, onClick }) => (
    <button onClick={onClick} style={{ display: 'flex', alignItems: 'center', gap: 14, width: '100%', padding: '15px 16px', background: 'transparent', border: 'none', borderBottom: `1px solid ${itemBorder}`, cursor: 'pointer', fontFamily: "var(--zr-police-sans)", fontSize: 'var(--zr-ui-2xl)', fontWeight: 500, color: txt, textAlign: 'left' }}>
      <span style={{ display: 'inline-flex', width: 38, height: 38, borderRadius: 11, alignItems: 'center', justifyContent: 'center', background: 'rgba(204,124,94,0.14)' }}><Icon name={icon} size={19} color={ACCENT} weight={1.7} /></span>
      {label}
    </button>
  )

  return (
    <>
      {/* inputs natifs cachés : c'est eux qui ouvrent la vraie UI système iOS */}
      <input ref={camRef} type="file" accept="image/*,video/*" capture="environment" style={{ display: 'none' }} onChange={onChange} />
      <input ref={galRef} type="file" accept="image/*,video/*" multiple style={{ display: 'none' }} onChange={onChange} />
      <input ref={fileRef} type="file" multiple style={{ display: 'none' }} onChange={onChange} />

      {/* FAB */}
      <button aria-label="Ajouter un fichier" onClick={() => setOpen(true)}
        style={{ position: 'fixed', right: 18, bottom: 'calc(20px + env(safe-area-inset-bottom))', zIndex: 90, width: 58, height: 58, borderRadius: 99, border: '1.5px solid rgba(255,255,255,0.55)', background: ACCENT, boxShadow: '0 10px 26px -8px rgba(204,124,94,0.7)', cursor: 'pointer', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
        <Icon name="plus" size={26} color="#fff" weight={2} />
      </button>

      {open && (
        <div onClick={() => setOpen(false)} style={{ position: 'fixed', inset: 0, zIndex: 95, background: 'rgba(0,0,0,0.28)', display: 'flex', flexDirection: 'column', justifyContent: 'flex-end' }}>
          <div onClick={(e) => e.stopPropagation()} className="zr-liquid" style={{ margin: 10, marginBottom: 'calc(10px + env(safe-area-inset-bottom))', borderRadius: 20, overflow: 'hidden', background: sheetBg, backdropFilter: 'blur(22px) saturate(160%)', WebkitBackdropFilter: 'blur(22px) saturate(160%)', border: `1.5px solid rgba(255,255,255,0.5)`, boxShadow: '0 24px 60px -18px rgba(0,0,0,0.5)' }}>
            <div style={{ padding: '14px 16px 8px', fontFamily: "var(--zr-police-serif)", fontStyle: 'italic', fontSize: 'var(--zr-ui-3xl)', color: txt, opacity: 0.8 }}>Ajouter</div>
            <Item icon="film" label="Prendre une photo ou vidéo" onClick={() => pick(camRef)} />
            <Item icon="photo" label="Depuis la galerie" onClick={() => pick(galRef)} />
            <Item icon="folder" label="Choisir des fichiers" onClick={() => pick(fileRef)} />
            <button onClick={() => setOpen(false)} style={{ width: '100%', padding: '15px 16px', background: 'transparent', border: 'none', cursor: 'pointer', fontFamily: "var(--zr-police-sans)", fontSize: 'var(--zr-ui-2xl)', fontWeight: 500, color: ACCENT }}>Annuler</button>
          </div>
        </div>
      )}
    </>
  )
}
