// ZENRAY ASSETS v2 (2026-09-11).
//
// A drive of LINKS, not a gallery of templates. A project is a Create folder
// `pages/ZenRayAssets/tmp-<slug>/` where every file was uploaded (archive-folder.mjs, skill
// zenray-assets). This view never stores a byte: it reads the project list from
// `pages/.zr-assets.json`, lists each project folder from the search INDEX the app already loaded
// (zero quota), draws each file with Create's own thumbnail (NodeThumb, passed by App) and opens it
// in Create's Quick Look. Everything stays archived and downloadable in Create.
//
// FR : un drive de LIENS, pas une galerie de gabarits. Un projet est un dossier Create
// `tmp-<slug>` ; cette vue ne stocke rien, elle liste le dossier depuis l'index (aucune requête de
// quota), montre chaque fichier avec la vignette de Create et l'ouvre dans le Quick Look.
//
// The green / orange dot: the browser cannot see the Mac's disk, so the upload script records, per
// source, whether the local copy still exists (`sources[].present`). Orange = still on the Mac, it
// takes space; green = only in the cloud. The button copies the verified purge command, it never
// deletes anything itself.
// FR : pastille verte = uniquement sur le cloud, orange = encore sur le Mac ; le bouton copie la
// commande de purge vérifiée, il ne supprime jamais rien lui-même.
import React, { useEffect, useMemo, useState } from 'react'
import { readJson } from '../lib/saveJson.js'
import { loadSearchIndex, getIndexPaths, getNodeSize } from '../search/searchIndexClient.js'
import { pgPretty } from '../lib/pgPretty.js'
import { DOT } from '../config/colors.js'
import { readableSize, normalizeProject, mergeAssetsProjects, compareProjectsByDateDesc, projectPaths, coverPath, coverPaths, folderView, crumbs, excerptOf, storageState, sourceState } from '../lib/assetsProjects.js'
import { kindForName } from '../lib/fileKinds.js'
import { urlLectureAffichage } from '../lib/urlLecture.js'
import { downloadUrls } from '../lib/archiveChunks.js'
import { assembleBlobUrl } from '../lib/fetchAsset.js'
import { useInView } from '../media/useImageThumb.js'
import { lazyRetry } from '../lib/lazyRetry.js'
import { notify } from './Notifications.jsx'
import QuickLookOverlay from './QuickLookOverlay.jsx'
import AssetsWorkspaceView from './assets/AssetsWorkspaceView.jsx'

const LazyMaterialStudio = lazyRetry(() => import('./assets/MaterialStudio.jsx'))
const LazyMeshStudio = lazyRetry(() => import('./assets/MeshStudio.jsx'))

const STORE_PATH = 'pages/.zr-assets.json'
const PURGE_COMMAND = 'node ~/.claude/skills/zenray-assets/scripts/zenray-assets-upload.mjs free'

// The parameter interface of the page: every value judged by eye lives here and nowhere else.
// FR : l'interface de paramètres de la page, toute valeur jugée à l'œil vit ici.
const P = {
  serif: 'var(--zr-police-serif)',
  sans: 'var(--zr-police-sans)',
  mono: 'var(--zr-police-mono)',
  serifWeight: 350,
  numberWeight: 400,
  accent: '#9A5B3C',
  column: 1240,
  projectGrid: 'repeat(auto-fill, minmax(min(100%, 300px), 1fr))',
  fileGrid: 'repeat(auto-fill, minmax(min(100%, 176px), 1fr))',
  coverRatio: '4 / 3',
  fileRatio: '1 / 1',
  coverThumb: 300,
  fileThumb: 150,
  radius: 8,
  mosaicMax: 4,      // images shown on a project card (Matthieu, 2026-09-23)
  mosaicGap: 2,
}

const MONTHS = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre']
const readableDate = (iso) => (!iso || iso.length < 10) ? (iso || '') : `${Number(iso.slice(8, 10))} ${MONTHS[Number(iso.slice(5, 7)) - 1]} ${iso.slice(0, 4)}`
const extensionOf = (e) => { const m = /\.([a-z0-9]{1,6})$/i.exec(e.name || ''); return m ? m[1].toUpperCase() : '' }

// The fallback plate, from mockup 02: a declared placeholder, never a fake render.
// FR : la planche de repli, un emplacement déclaré, jamais une fausse capture.
function softPlate(i = 0) {
  const h = [42, 22, 336, 205, 138][i % 5]
  const line = 'rgba(34,33,30,0.26)'
  const pattern = `repeating-linear-gradient(${38 + (i % 3) * 17}deg, ${line} 0 .5px, transparent .5px 13px)`
  return `${pattern}, linear-gradient(${146 + (i % 4) * 21}deg, hsl(${h} 16% 93%), hsl(${h} 16% 85%))`
}

function Dot({ color }) {
  return <span aria-hidden="true" style={{ width: DOT.size, height: DOT.size, borderRadius: 999, background: color, flex: '0 0 auto' }} />
}

function StatusPill({ color, children, t }) {
  return (
    <span style={{ display: 'inline-flex', alignItems: 'center', gap: DOT.gap, fontSize: 12.5, color: t.textSecondary, whiteSpace: 'nowrap' }}>
      <Dot color={color} />{children}
    </span>
  )
}

function useIndexPaths() {
  const [paths, setPaths] = useState(() => getIndexPaths())
  useEffect(() => {
    let alive = true
    loadSearchIndex().then(() => { if (alive) setPaths(getIndexPaths()) }).catch(() => {})
    return () => { alive = false }
  }, [])
  return paths
}

function LegacyAssetsView({ t, NodeThumb, initialProjectId = null }) {
  const [projects, setProjects] = useState(null)
  const [category, setCategory] = useState('Tout')
  const [query, setQuery] = useState('')
  const [openId, setOpenId] = useState(initialProjectId)
  const paths = useIndexPaths()

  useEffect(() => {
    let alive = true
    readJson(STORE_PATH)
      .then(({ data }) => {
        if (!alive) return
        const list = data && (data.projects || data.projets)
        setProjects(mergeAssetsProjects(list))
      })
      .catch(() => { if (alive) setProjects(mergeAssetsProjects([])) })
    return () => { alive = false }
  }, [])

  // Categories come from the projects themselves: a new category appears without touching this file.
  // FR : les catégories viennent des projets eux-mêmes.
  const categories = useMemo(() => {
    if (!projects) return []
    return ['Tout', ...[...new Set(projects.map((p) => p.category).filter(Boolean))].sort()]
  }, [projects])

  const visible = useMemo(() => {
    if (!projects) return []
    const q = query.trim().toLowerCase()
    return projects
      .filter((p) => (category === 'Tout' || p.category === category)
        && (!q || `${p.name} ${p.summary} ${p.components.map((c) => `${c.name} ${c.short}`).join(' ')}`.toLowerCase().includes(q)))
      .sort(compareProjectsByDateDesc)
  }, [projects, category, query])

  if (!projects) return <div style={{ color: t.textSecondary, padding: 24, fontFamily: P.sans }}>chargement…</div>

  const openProject = openId ? projects.find((p) => p.id === openId) : null

  return (
    <div style={{ maxWidth: P.column, margin: '0 auto', padding: '22px 34px 96px', fontFamily: P.sans, color: t.textPrimary }}>
      <header style={{ display: 'flex', alignItems: 'flex-end', gap: 24, flexWrap: 'wrap', paddingBottom: 18 }}>
        <h1 onClick={() => setOpenId(null)} style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 27, letterSpacing: '-0.015em', margin: 0, lineHeight: 1.1, cursor: openProject ? 'pointer' : 'default' }}>
          ZenRay <em style={{ fontStyle: 'italic', fontWeight: 300, color: t.textSecondary }}>Assets</em>
        </h1>
        {!openProject && (
          <label style={{ marginLeft: 'auto', display: 'flex', alignItems: 'center', gap: 9, minWidth: 260, flex: '0 1 340px',
            borderBottom: `1px solid ${t.border}`, padding: '5px 2px' }}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={t.textSecondary} strokeWidth="2"
              strokeLinecap="round" aria-hidden="true" style={{ flex: '0 0 14px' }}>
              <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.6-3.6" />
            </svg>
            <input value={query} onChange={(e) => setQuery(e.target.value)} placeholder="Rechercher dans la collection"
              style={{ flex: 1, minWidth: 0, border: 0, outline: 'none', background: 'transparent', color: t.textPrimary, fontFamily: P.sans, fontSize: 14 }} />
          </label>
        )}
      </header>

      {openProject ? (
        openProject.id === 'zenray-assets-materials' || openProject.category === 'Materials' ? (
          <React.Suspense fallback={<div style={{ color: t.textSecondary, padding: 24, fontFamily: P.sans }}>chargement du studio…</div>}>
            <LazyMaterialStudio project={openProject} t={t} onBack={() => setOpenId(null)} />
          </React.Suspense>
        ) : openProject.id === 'zenray-assets-meshes' ? (
          <React.Suspense fallback={<div style={{ color: t.textSecondary, padding: 24, fontFamily: P.sans }}>chargement du studio…</div>}>
            <LazyMeshStudio project={openProject} t={t} onBack={() => setOpenId(null)} />
          </React.Suspense>
        ) : (
          <ProjectDetail project={openProject} t={t} paths={paths} NodeThumb={NodeThumb} onBack={() => setOpenId(null)} />
        )
      ) : <>
          {categories.length > 2 && (
            <nav style={{ display: 'flex', flexWrap: 'wrap', gap: 18, padding: '4px 0 26px', borderBottom: `1px solid ${t.border}` }}>
              {categories.map((c) => {
                const on = c === category
                const n = c === 'Tout' ? projects.length : projects.filter((p) => p.category === c).length
                return (
                  <button key={c} type="button" onClick={() => setCategory(c)}
                    style={{ border: 0, background: 'transparent', cursor: 'pointer', padding: '2px 0', fontFamily: P.sans,
                      fontSize: 13.5, color: on ? P.accent : t.textSecondary, boxShadow: on ? `inset 0 -1px 0 0 ${P.accent}` : undefined }}>
                    {c}<span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 11.5, opacity: 0.6, marginLeft: 6 }}>{n}</span>
                  </button>
                )
              })}
            </nav>
          )}
          {visible.length === 0 && (
            <p style={{ maxWidth: '54ch', fontSize: 15, lineHeight: 1.66, color: t.textSecondary, margin: '30px 0 0' }}>
              {projects.length === 0 ? 'Rien n’a encore été déposé.' : 'Aucun projet ne correspond.'}
            </p>
          )}
          <div style={{ display: 'grid', gridTemplateColumns: P.projectGrid, gap: '34px 26px', paddingTop: 30 }}>
            {visible.map((p, i) => (
              <ProjectCard key={p.id} project={p} index={i} t={t} paths={paths} NodeThumb={NodeThumb} onOpen={() => setOpenId(p.id)} />
            ))}
          </div>
        </>}
    </div>
  )
}

// 2 October 2026, 13:25 CEST: one project workspace reuses the existing archive previews and studios.
export default function AssetsView(props) {
  return <AssetsWorkspaceView {...props} LegacyView={LegacyAssetsView} />
}

// A speaking thumbnail for an archived text file (md, html, css, js, json…): its title and first
// lines, read once when the tile becomes visible, cached for the session. Files above TEXT_THUMB_MAX
// keep their extension card: a thumbnail never downloads a heavy file.
// FR : la vignette parlante d'un fichier texte archivé, lue une fois quand la tuile devient visible.
const TEXT_THUMB_MAX = 300 * 1024
const excerptCache = new Map()
async function readExcerpt(path, name) {
  if (excerptCache.has(path)) return excerptCache.get(path)
  const j = await fetch(urlLectureAffichage(path)).then((r) => r.json())
  const m = JSON.parse(j.markdown)
  if (!m || (m.size || 0) > TEXT_THUMB_MAX) { excerptCache.set(path, null); return null }
  const url = await assembleBlobUrl({ urls: downloadUrls(m), mime: 'text/plain' })
  try {
    const x = excerptOf(name, await (await fetch(url)).text())
    if (excerptCache.size > 400) excerptCache.delete(excerptCache.keys().next().value)
    excerptCache.set(path, x)
    return x
  } finally { URL.revokeObjectURL(url) }
}

function ExtCard({ ext, t, glyph }) {
  return (
    <span style={{ display: 'grid', placeItems: 'center', gap: 6, textAlign: 'center' }}>
      {glyph && <span style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 44, lineHeight: 1, color: t.textPrimary }}>{glyph}</span>}
      <span style={{ fontSize: 11, letterSpacing: '0.14em', color: t.textSecondary }}>{ext}</span>
    </span>
  )
}

function TextThumb({ entry, t }) {
  const [excerpt, setExcerpt] = useState(() => excerptCache.get(entry.contentPath))
  const { ref, inView } = useInView()
  useEffect(() => {
    if (!inView || excerpt !== undefined) return undefined
    let alive = true
    readExcerpt(entry.contentPath, entry.name).then((x) => { if (alive) setExcerpt(x) }).catch(() => { if (alive) setExcerpt(null) })
    return () => { alive = false }
  }, [inView, entry.contentPath, entry.name, excerpt])
  const ext = extensionOf(entry)
  return (
    <span ref={ref} style={{ position: 'absolute', inset: 10, display: 'flex', flexDirection: 'column', gap: 5, overflow: 'hidden',
      padding: '12px 12px 10px', borderRadius: 4, background: t.cardBg || t.bg, boxShadow: `0 1px 0 ${t.border}, 0 8px 22px -16px rgba(0,0,0,.45)` }}>
      {!excerpt ? <span style={{ margin: 'auto' }}><ExtCard ext={ext} t={t} /></span> : <>
        {excerpt.title && <span style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 13, lineHeight: 1.2, color: t.textPrimary }}>{excerpt.title}</span>}
        {excerpt.lines.map((l, i) => (
          <span key={i} style={{ fontFamily: excerpt.mono ? P.mono : P.sans, fontSize: excerpt.mono ? 8.5 : 9, lineHeight: 1.35, color: t.textSecondary,
            whiteSpace: excerpt.mono ? 'pre' : 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{l}</span>
        ))}
        <span style={{ marginTop: 'auto', fontSize: 9, letterSpacing: '0.14em', color: t.textSecondary }}>{ext}</span>
      </>}
    </span>
  )
}

// The thumbnail of one file: Create's own for images, videos and audio, a speaking card for text
// and fonts. FR : la vignette d'un fichier, celle de Create pour les médias, une carte parlante sinon.
function FileThumb({ entry, t, NodeThumb }) {
  const archived = entry.contentPath.endsWith('.file.json')
  if (archived && kindForName(entry.name) === 'text') return <TextThumb entry={entry} t={t} />
  if (archived && /\.(woff2?|ttf|otf)$/i.test(entry.name)) return <ExtCard ext={extensionOf(entry)} t={t} glyph="Aa" />
  return NodeThumb ? <NodeThumb e={entry} size={P.fileThumb} /> : null
}

// A project card: its cover, its name, how many files, where they live.
// FR : la carte d'un projet, sa couverture, son nom, son nombre de fichiers, où ils vivent.
function ProjectCard({ project, index, t, paths, NodeThumb, onOpen }) {
  const own = useMemo(() => projectPaths(project.folder, paths), [project.folder, paths])
  const covers = project.folder ? coverPaths(project, own, P.mosaicMax) : []
  const cover = covers[0] || null
  const legacyImage = !project.folder && project.showcase[0] && project.showcase[0].image
  const state = storageState(project)
  const count = project.folder ? own.length : project.components.length
  return (
    <button type="button" onClick={onOpen} style={{ display: 'flex', flexDirection: 'column', textAlign: 'left', padding: 0, border: 0, background: 'transparent', cursor: 'pointer', color: 'inherit', minWidth: 0 }}>
      <span style={{ display: 'grid', placeItems: 'center', aspectRatio: P.coverRatio, width: '100%', overflow: 'hidden', borderRadius: P.radius,
        border: `1px solid ${t.border}`, background: (cover || legacyImage) ? 'rgba(128,128,128,0.08)' : softPlate(index) }}>
        {covers.length > 0 && NodeThumb && (
          // 1 image fills, 2 split, 3 = one tall + two, 4 = two by two. / FR : la mosaique suit le nombre d'images.
          <span style={{ display: 'grid', width: '100%', height: '100%', gap: P.mosaicGap,
            gridTemplateColumns: covers.length === 1 ? '1fr' : '1fr 1fr',
            gridTemplateRows: covers.length > 2 ? '1fr 1fr' : '1fr' }}>
            {covers.map((c, i) => (
              <span key={c} style={{ overflow: 'hidden', minWidth: 0, minHeight: 0, gridRow: covers.length === 3 && i === 0 ? 'span 2' : undefined, display: 'grid' }}>
                <NodeThumb e={{ contentPath: c, isImage: true, hasKids: false }} size={covers.length === 1 ? P.coverThumb : Math.round(P.coverThumb / 2)} />
              </span>
            ))}
          </span>
        )}
        {!cover && legacyImage && <img src={legacyImage} alt="" loading="lazy" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />}
      </span>
      <span style={{ display: 'flex', alignItems: 'baseline', gap: 10, padding: '14px 2px 0' }}>
        {project.category && <span style={{ fontSize: 10.5, letterSpacing: '0.13em', textTransform: 'uppercase', color: P.accent }}>{project.category}</span>}
        <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 12.5, color: t.textSecondary, marginLeft: 'auto' }}>{count ? `${count} ${project.folder ? 'fichiers' : 'composants'}` : ''}</span>
      </span>
      <span style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 20, letterSpacing: '-0.015em', lineHeight: 1.2, padding: '6px 2px 0' }}>{project.name}</span>
      {project.summary && <span style={{ fontSize: 13, lineHeight: 1.55, color: t.textSecondary, padding: '6px 2px 0', display: '-webkit-box', WebkitLineClamp: 2, WebkitBoxOrient: 'vertical', overflow: 'hidden' }}>{project.summary}</span>}
      {state && <span style={{ padding: '10px 2px 0' }}><StatusPill color={state.color} t={t}>{state.label}</StatusPill></span>}
    </button>
  )
}

// A grid of file tiles; each opens in Quick Look. FR : une grille de tuiles, chacune s'ouvre en Quick Look.
function FileGrid({ files, t, NodeThumb, onPick }) {
  return (
    <div style={{ display: 'grid', gridTemplateColumns: P.fileGrid, gap: '22px 18px' }}>
      {files.map((e) => (
        <button key={e.contentPath} type="button" onClick={() => onPick(e)} title={e.name}
          style={{ display: 'flex', flexDirection: 'column', padding: 0, border: 0, background: 'transparent', cursor: 'pointer', color: 'inherit', textAlign: 'left', minWidth: 0 }}>
          <span style={{ position: 'relative', display: 'grid', placeItems: 'center', aspectRatio: P.fileRatio, width: '100%', overflow: 'hidden', borderRadius: P.radius, background: 'rgba(128,128,128,0.08)', border: `1px solid ${t.border}` }}>
            <FileThumb entry={e} t={t} NodeThumb={NodeThumb} />
          </span>
          <span style={{ fontSize: 12.5, lineHeight: 1.35, padding: '9px 2px 0', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{pgPretty(e.name)}</span>
          <span style={{ display: 'flex', gap: 8, fontSize: 11.5, color: t.textSecondary, padding: '3px 2px 0' }}>
            <span>{extensionOf(e)}</span>
            <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, marginLeft: 'auto' }}>{readableSize(getNodeSize(e.contentPath))}</span>
          </span>
        </button>
      ))}
    </div>
  )
}

// A deeper folder, shown as a card that opens IN PLACE, never by jumping into Create.
// FR : un dossier plus profond, en carte qui s'ouvre sur place, jamais en basculant dans Create.
function FolderCards({ folders, t, NodeThumb, onOpen }) {
  if (!folders.length) return null
  return (
    <div style={{ display: 'grid', gridTemplateColumns: P.fileGrid, gap: '22px 18px', marginTop: 22 }}>
      {folders.map((f) => (
        <button key={f.dir} type="button" onClick={() => onOpen(f.dir)} title={f.name}
          style={{ display: 'flex', flexDirection: 'column', padding: 0, border: 0, background: 'transparent', cursor: 'pointer', color: 'inherit', textAlign: 'left', minWidth: 0 }}>
          <span style={{ position: 'relative', display: 'grid', placeItems: 'center', aspectRatio: P.fileRatio, width: '100%', overflow: 'hidden', borderRadius: P.radius, background: 'rgba(128,128,128,0.08)', border: `1px solid ${t.border}` }}>
            {NodeThumb && <NodeThumb e={{ hasKids: true, contentPath: null }} size={P.fileThumb * 0.6} />}
          </span>
          <span style={{ display: 'flex', alignItems: 'baseline', gap: 8, padding: '9px 2px 0', minWidth: 0 }}>
            <span style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 15, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{f.name}</span>
            <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 11.5, color: t.textSecondary, marginLeft: 'auto' }}>{f.count}</span>
          </span>
          <span style={{ fontSize: 11.5, color: t.textSecondary, padding: '3px 2px 0' }}>Dossier</span>
        </button>
      ))}
    </div>
  )
}

function GroupTitle({ title, count, t, onOpen }) {
  return (
