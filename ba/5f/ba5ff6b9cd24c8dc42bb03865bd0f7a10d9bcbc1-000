// An open project: the open folder's files, one group per sub-folder, deeper folders as cards, a
// breadcrumb to climb back. Everything stays in ZenRay Assets; Create is one explicit link away.
// FR : un projet ouvert ; tout reste dans ZenRay Assets, Create n'est qu'à un lien explicite.
function ProjectDetail({ project, t, paths, NodeThumb, onBack }) {
  const own = useMemo(() => projectPaths(project.folder, paths), [project.folder, paths])
  const [dir, setDir] = useState(project.folder)
  useEffect(() => { setDir(project.folder) }, [project.folder])
  const view = useMemo(() => (dir ? folderView(dir, own) : { files: [], groups: [] }), [dir, own])
  const flat = useMemo(() => [...view.files, ...view.groups.flatMap((g) => g.files)], [view])
  const [quick, setQuick] = useState(null)
  const state = storageState(project)
  const trail = project.folder ? crumbs(project.folder, dir) : []

  const copyPurge = () => {
    const command = `${PURGE_COMMAND} ${project.id}`
    navigator.clipboard.writeText(command).then(
      () => notify({ kind: 'info', label: 'ZenRay Assets', title: 'Commande copiée', body: 'Colle-la dans le Terminal : elle revérifie le drive avant de supprimer quoi que ce soit.' }),
      () => notify({ kind: 'error', label: 'ZenRay Assets', title: 'Copie impossible', body: command }),
    )
  }

  const step = (d) => {
    const i = flat.findIndex((e) => e.contentPath === quick?.contentPath)
    if (i < 0 || !flat.length) return
    setQuick(flat[(i + d + flat.length) % flat.length])
  }

  return (
    <article style={{ paddingTop: 8 }}>
      <button type="button" onClick={onBack} style={{ border: 0, background: 'transparent', padding: '4px 0', cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 13 }}>← Tous les projets</button>
      <header style={{ display: 'flex', alignItems: 'baseline', gap: 16, flexWrap: 'wrap', padding: '14px 0 18px', borderBottom: `1px solid ${t.border}` }}>
        {project.category && <span style={{ fontSize: 10.5, letterSpacing: '0.13em', textTransform: 'uppercase', color: P.accent }}>{project.category}</span>}
        <h2 style={{ flexBasis: '100%', fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 31, letterSpacing: '-0.02em', margin: '6px 0 0', lineHeight: 1.14 }}>{project.name}</h2>
        <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 13, color: t.textSecondary }}>{readableDate(project.date)}</span>
        {project.folder && <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 13, color: t.textSecondary }}>{own.length} fichiers</span>}
        {project.folder && <a href={`/?folder=${encodeURIComponent(dir || project.folder)}`} style={{ marginLeft: 'auto', fontSize: 12.5, color: t.textSecondary }}>Ouvrir dans Create ↗</a>}
      </header>
      {project.summary && dir === project.folder && <p style={{ maxWidth: '64ch', fontSize: 15, lineHeight: 1.62, color: t.textSecondary, margin: '18px 0 0' }}>{project.summary}</p>}

      {state && dir === project.folder && (
        <section style={{ margin: '22px 0 0', padding: '14px 16px', borderRadius: P.radius, border: `1px solid ${t.border}` }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: 16, flexWrap: 'wrap' }}>
            <StatusPill color={state.color} t={t}>{state.label}</StatusPill>
            {project.sources.some((s) => s.present && !s.keep) && (
              <button type="button" onClick={copyPurge} style={{ marginLeft: 'auto', border: `1px solid ${t.border}`, borderRadius: 999, background: 'transparent', color: t.textPrimary, padding: '5px 14px', cursor: 'pointer', fontFamily: P.sans, fontSize: 12.5 }}>
                Libérer l’espace sur le Mac
              </button>
            )}
          </div>
          <div style={{ marginTop: 10, display: 'grid', gap: 6 }}>
            {project.sources.map((s) => {
              const st = sourceState(s)
              return (
                <div key={`${s.localPath}>${s.target}`} style={{ display: 'flex', gap: 12, alignItems: 'center', fontSize: 12, color: t.textSecondary, minWidth: 0 }}>
                  <Dot color={st.color} />
                  <span style={{ fontFamily: P.mono, fontSize: 11.5, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', minWidth: 0, flex: '1 1 auto' }}>{s.localPath}</span>
                  <span style={{ flex: '0 0 auto' }}>→ {s.target}</span>
                  <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, flex: '0 0 auto' }}>{st.label}</span>
                </div>
              )
            })}
          </div>
        </section>
      )}

      {trail.length > 0 && (
        <nav style={{ display: 'flex', flexWrap: 'wrap', alignItems: 'baseline', gap: 8, padding: '26px 0 0', fontSize: 13, color: t.textSecondary }}>
          <button type="button" onClick={() => setDir(project.folder)} style={{ border: 0, background: 'transparent', padding: 0, cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 13 }}>{project.name}</button>
          {trail.map((c, i) => (
            <React.Fragment key={c.dir}>
              <span aria-hidden="true">/</span>
              {i === trail.length - 1
                ? <span style={{ color: t.textPrimary }}>{c.name}</span>
                : <button type="button" onClick={() => setDir(c.dir)} style={{ border: 0, background: 'transparent', padding: 0, cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 13 }}>{c.name}</button>}
            </React.Fragment>
          ))}
        </nav>
      )}

      {project.folder && own.length === 0 && (
        <p style={{ maxWidth: '60ch', fontSize: 14, lineHeight: 1.6, color: t.textSecondary, margin: '28px 0 0' }}>
          Ce dossier n’apparaît pas encore dans l’index. Il est bien dans Create : ouvre-le avec le lien ci-dessus,
          ou relance l’indexation depuis le skill zenray-assets.
        </p>
      )}

      {view.files.length > 0 && (
        <section style={{ padding: '36px 0 0' }}>
          <GroupTitle title={trail.length ? trail[trail.length - 1].name : 'Fichiers'} count={view.files.length} t={t} />
          <FileGrid files={view.files} t={t} NodeThumb={NodeThumb} onPick={setQuick} />
        </section>
      )}

      {view.groups.map((g) => (
        <section key={g.dir} style={{ padding: '36px 0 0' }}>
          <GroupTitle title={g.title} count={g.count} t={t} onOpen={g.folders.length ? () => setDir(g.dir) : undefined} />
          {g.files.length > 0 && <FileGrid files={g.files} t={t} NodeThumb={NodeThumb} onPick={setQuick} />}
          <FolderCards folders={g.folders} t={t} NodeThumb={NodeThumb} onOpen={setDir} />
        </section>
      ))}

      {!project.folder && <LegacyProject project={project} t={t} />}

      {quick && (
        <QuickLookOverlay t={t} item={quick} prettyName={pgPretty}
          onPrev={() => step(-1)} onNext={() => step(1)} onClose={() => setQuick(null)}
          onOpen={() => { const d = quick.dir.slice(0, quick.dir.lastIndexOf('/')); setQuick(null); setDir(d) }} />
      )}
    </article>
  )
}

// Projects declared before v2 (no Create folder): their showcase and component list, unchanged.
// FR : les projets déposés avant la v2, sans dossier Create, gardent leur vitrine et leurs composants.
function LegacyProject({ project, t }) {
  const number = { fontFamily: P.serif, fontWeight: P.numberWeight }
  const groups = [...new Set(project.components.map((c) => c.group || 'Composants'))]
  return (
    <>
      {project.showcase.length > 0 && (
        <section style={{ padding: '40px 0 0' }}>
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(min(100%, 420px), 1fr))', gap: '32px 28px' }}>
            {project.showcase.map((v, i) => (
              <figure key={v.image || v.title} style={{ margin: 0 }}>
                <div style={{ borderRadius: P.radius, overflow: 'hidden', border: `1px solid ${t.border}`, ...(v.image ? {} : { aspectRatio: '3 / 2', background: softPlate(i) }) }}>
                  {v.image && <img src={v.image} alt={v.title} loading="lazy" style={{ display: 'block', width: '100%', height: 'auto' }} />}
                </div>
                <figcaption style={{ padding: '13px 2px 0' }}>
                  <div style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 17, letterSpacing: '-0.012em' }}>{v.title}</div>
                  {v.note && <p style={{ fontSize: 12.5, lineHeight: 1.55, color: t.textSecondary, margin: '5px 0 0', maxWidth: '46ch' }}>{v.note}</p>}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}
      {project.components.length > 0 && (
        <section style={{ padding: '50px 0 0' }}>
          {groups.map((g) => {
            const items = project.components.filter((c) => (c.group || 'Composants') === g)
            return (
              <div key={g} style={{ padding: '0 0 26px' }}>
                <div style={{ display: 'flex', alignItems: 'baseline', gap: 12, margin: '0 0 4px' }}>
                  <h3 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 20, letterSpacing: '-0.015em', margin: 0 }}>{g}</h3>
                  <span style={{ ...number, fontSize: 12.5, color: t.textSecondary }}>{items.length}</span>
                  <span style={{ flex: 1, height: 1, background: t.border }} />
                </div>
                {items.map((c) => (
                  <div key={c.name} style={{ display: 'flex', gap: 20, alignItems: 'baseline', padding: '13px 2px', borderBottom: `1px solid ${t.border}` }}>
                    <div style={{ flex: '1 1 280px', minWidth: 0 }}>
                      <div style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 16, letterSpacing: '-0.012em' }}>{c.name}</div>
                      <p style={{ fontSize: 12.5, lineHeight: 1.55, color: t.textSecondary, margin: '4px 0 0', maxWidth: '72ch' }}>{c.short}</p>
                    </div>
                    <span style={{ fontSize: 11.5, color: t.textSecondary, flex: '0 0 auto' }}>{c.engine}</span>
                    <span style={{ ...number, fontSize: 12, color: t.textSecondary, flex: '0 0 64px', textAlign: 'right' }}>{c.size}</span>
                    <span style={{ ...number, fontSize: 12, color: t.textSecondary, flex: '0 0 76px', textAlign: 'right' }}>{c.date}</span>
                    {c.link && (c.link.startsWith('http')
                      ? <a href={c.link} target="_blank" rel="noopener noreferrer" style={{ fontSize: 11.5, color: P.accent, flex: '0 0 auto', whiteSpace: 'nowrap' }}>Ouvrir sur GitHub ↗</a>
                      : <a href={`/?folder=${encodeURIComponent(c.link)}`} style={{ fontSize: 11.5, color: P.accent, flex: '0 0 auto', whiteSpace: 'nowrap' }}>Ouvrir →</a>)}
                  </div>
                ))}
              </div>
            )
          })}
        </section>
      )}
    </>
  )
}
