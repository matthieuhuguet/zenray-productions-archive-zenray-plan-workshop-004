/* 12 October 2026: Tube layout. Every value is changed here once (or from the dev design panel). */
/* FR : disposition Tube, une valeur se change ici une seule fois. */
:root {
  --tube-card-min: 260px;
  --tube-file-min: 168px;
  --tube-gap: 22px;
  --tube-radius: 14px;
  --tube-cover-ratio: 1.778;
  --tube-title-size: 14px;
  --tube-meta-size: 12.5px;
  --tube-lift: 3px;
  --tube-fade: 220ms;
  --tube-spinner: 22px;
  --tube-row-height: 40px;
  --tube-column-width: 220px;
  --tube-side-width: 190px;
  --tube-bar-height: 6px;
  --tube-ring-size: 30px;
  /* Source colours (storage bar, ring and dots). */
  --tube-src-tmp: #e0875e;
  --tube-src-memory: #8e7cc3;
  --tube-src-houdini: #e7b14a;
  --tube-src-unreal: #4f8fd8;
  --tube-src-cloud: #9aa3ad;
  --tube-select: #2f6fe4;
  /* Titles in the Tube view: Inter Bold (Matthieu, 12 October 2026), everything else stays Regular. */
  --tube-title-weight: 700;
}

/* The Tube view is Inter only (decision of 12 October 2026): serif is tiring in a UI that is used all day.
   The serif and number variables fall back to the sans stack inside this layout, so titles, numbers and the
   folder name all render in Inter without touching the other layouts. */
.assets-workspace[data-layout="tube"],
.tube-sheet-root {
  --zr-police-serif: var(--zr-police-sans);
  --zr-poids-serif: 400;
  --zr-poids-nombres: 400;
}
.assets-workspace[data-layout="tube"] { grid-template-columns: minmax(0, 1fr); width: 100%; padding-left: var(--assets-page-padding); padding-right: var(--assets-page-padding); }
.assets-workspace[data-layout="tube"] .assets-project-header { grid-template-columns: minmax(0, 1fr) minmax(140px, 18%); margin-bottom: 14px; }
.assets-workspace[data-layout="tube"] .assets-source-weights { display: none; }
.assets-workspace[data-layout="tube"] .assets-project-intro > p { font: 400 var(--tube-meta-size)/1.5 var(--zr-police-sans); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.assets-workspace[data-layout="tube"] .assets-project-cover { max-height: 110px; }
.assets-workspace[data-layout="tube"] .assets-number,
.tube-sheet-root .assets-number { font-family: var(--zr-police-sans); font-weight: 400; font-variant-numeric: tabular-nums; }

.tube-layout-switch { display: inline-flex; gap: 2px; padding: 3px; border-radius: 99px; background: var(--assets-hover); }
.tube-layout-switch button { padding: 5px 12px; border: 0; border-radius: 99px; background: none; color: var(--assets-muted); font: inherit; font-size: 12.5px; cursor: pointer; }
.tube-layout-switch button[aria-pressed="true"] { background: var(--assets-surface); color: var(--assets-ink); box-shadow: 0 1px 3px rgb(0 0 0 / .12); }
.tube-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 18px; }
.tube-head h1 { margin: 0; font-family: var(--zr-police-sans); font-weight: var(--tube-title-weight); font-size: var(--assets-title-size); letter-spacing: -.02em; }
.assets-workspace[data-layout="tube"] .assets-project-intro h2 { font-family: var(--zr-police-sans); font-weight: var(--tube-title-weight); letter-spacing: -.02em; }
.tube-head h1 em { color: var(--assets-muted); font-style: normal; font-weight: 400; }
.tube-back { display: inline-flex; align-items: center; gap: 4px; border: 0; background: none; color: var(--assets-muted); font: inherit; cursor: pointer; padding: 0; }
.tube-back:hover { color: var(--assets-ink); }

.tube-bar, .tube-toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
.tube-search { flex: 1; max-width: 560px; display: flex; align-items: center; gap: 10px; height: 38px; padding: 0 14px; border-radius: 99px; background: var(--assets-wash); border: 1px solid var(--assets-stroke); color: var(--assets-muted); }
.tube-search input { flex: 1; min-width: 0; border: 0; outline: none; background: none; font: inherit; color: var(--assets-ink); }
.tube-search button { border: 0; background: none; color: inherit; cursor: pointer; padding: 2px; }
.tube-round, .tube-download { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-width: 38px; height: 38px; padding: 0 14px; border-radius: 99px; border: 1px solid var(--assets-stroke); background: var(--assets-wash); color: var(--assets-ink); font: inherit; cursor: pointer; }
.tube-download { margin-left: auto; }
.tube-download:disabled { opacity: .4; cursor: default; }
.tube-chips { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
.tube-chip { padding: 7px 14px; border-radius: 99px; border: 1px solid var(--assets-stroke); background: var(--assets-wash); color: var(--assets-muted); font: inherit; cursor: pointer; }
.tube-chip[aria-pressed="true"] { background: var(--assets-ink); color: var(--assets-background); border-color: transparent; }

/* Home grid and file grid */
.tube-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--tube-card-min), 1fr)); gap: calc(var(--tube-gap) * 1.4) var(--tube-gap); }
.tube-file-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--tube-file-min), 1fr)); gap: var(--tube-gap); align-items: start; }
.tube-card, .tube-file-open { width: 100%; display: flex; flex-direction: column; align-items: stretch; min-width: 0; padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; cursor: pointer; }
.tube-file { position: relative; min-width: 0; }

/* The shape carries the type. */
.tube-thumb { position: relative; display: block; width: 100%; overflow: hidden; border-radius: var(--tube-radius); background: var(--assets-hover); aspect-ratio: var(--tube-cover-ratio); transition: transform var(--tube-fade), box-shadow var(--tube-fade); }
.tube-file .tube-thumb { aspect-ratio: 1; }
.tube-thumb[data-shape="image"], .tube-thumb[data-shape="3d"], .tube-thumb[data-shape="other"] { aspect-ratio: 1; }
.tube-thumb[data-shape="doc"] .tube-glyph::before, .tube-thumb[data-shape="audio"] .tube-glyph::before { content: ""; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); background: var(--assets-surface); box-shadow: 0 6px 18px -10px rgb(0 0 0 / .35); }
.tube-thumb[data-shape="doc"] .tube-glyph::before { width: 54%; height: 70%; border-radius: 6px; }
.tube-thumb[data-shape="audio"] .tube-glyph::before { width: 64%; height: 64%; border-radius: 50%; }
.tube-glyph > * { position: relative; }
.tube-thumb[data-shape="video"]::after { content: ""; position: absolute; right: 9px; bottom: 9px; z-index: 2; width: 0; height: 0; border-style: solid; border-width: 6px 0 6px 10px; border-color: transparent transparent transparent rgb(255 255 255 / .92); filter: drop-shadow(0 1px 2px rgb(0 0 0 / .5)); }
.tube-thumb > img, .tube-thumb > canvas, .tube-thumb > video, .tube-thumb > div, .tube-thumb > span:not(.tube-spinner):not(.tube-dot):not(.tube-glyph):not(.tube-initials) { position: absolute; inset: 0; width: 100% !important; height: 100% !important; object-fit: cover; }
/* Shared renderers nest their image deeper: every descendant is cropped to the box, never stretched. */
.tube-thumb img, .tube-thumb canvas, .tube-thumb video { width: 100% !important; height: 100% !important; max-width: none !important; object-fit: cover !important; display: block; }
/* Shared thumbnail renderers carry their own fixed pixel size: the tube shape owns the box instead. */
.tube-thumb div { width: 100% !important; height: 100% !important; max-width: none !important; border-radius: 0 !important; }
/* While a shared renderer has no image yet it draws a placeholder icon: keep it faint and small so the spinner reads first. */
.tube-thumb > div { display: grid; place-items: center; }
.tube-thumb svg:not(.tube-glyph svg):not(.tube-spinner svg) { width: 34% !important; height: auto !important; opacity: .22; position: absolute; left: 33%; top: 50%; transform: translateY(-50%); }
.tube-card:hover .tube-thumb, .tube-file-open:hover .tube-thumb { transform: translateY(calc(var(--tube-lift) * -1)); box-shadow: 0 14px 30px -14px rgb(0 0 0 / .35); }
.tube-glyph { position: absolute; inset: 0; display: grid; place-items: center; color: var(--assets-muted); }
.tube-dot { position: absolute; left: 9px; top: 9px; width: 8px; height: 8px; border-radius: 50%; background: var(--assets-accent); box-shadow: 0 0 0 2px rgb(255 255 255 / .85); z-index: 2; }
.tube-file[data-selected="true"] .tube-thumb { outline: 2px solid var(--assets-accent); outline-offset: 2px; }

.tube-spinner { position: absolute; left: 50%; top: 50%; width: var(--tube-spinner); height: var(--tube-spinner); transform: translate(-50%, -50%); }
.tube-spinner i { position: absolute; left: 46%; top: 0; width: 8%; height: 28%; border-radius: 2px; background: var(--assets-muted); transform-origin: 50% 178%; animation: tube-spin 1s linear infinite; }
@keyframes tube-spin { from { opacity: 1 } to { opacity: .15 } }

.tube-title { margin-top: 10px; font-size: var(--tube-title-size); line-height: 1.35; color: var(--assets-ink); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word; }
.tube-meta { margin-top: 3px; font-size: var(--tube-meta-size); color: var(--assets-muted); }
.tube-skeleton { display: block; height: 12px; width: 70%; margin-top: 12px; border-radius: 6px; background: var(--assets-hover); }
.tube-check { position: absolute; right: 8px; top: 8px; z-index: 3; opacity: 0; transition: opacity var(--tube-fade); }
.tube-file:hover .tube-check, .tube-file[data-selected="true"] .tube-check, .tube-check:focus-within { opacity: 1; }
.tube-more { display: block; margin: 26px auto 0; padding: 9px 18px; border-radius: 99px; border: 1px solid var(--assets-stroke); background: var(--assets-wash); color: var(--assets-ink); font: inherit; cursor: pointer; }
.tube-empty { color: var(--assets-muted); margin: 24px 0; }

/* Storage: ring on the left, bar and legend next to it */
.tube-storage { display: flex; align-items: center; gap: 16px; margin: 4px 0 18px; }
.tube-ring-wrap { position: relative; display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px 4px 4px; border-radius: 99px; background: var(--assets-hover); cursor: default; outline: none; flex: none; }
.tube-ring { width: var(--tube-ring-size); height: var(--tube-ring-size); }
.tube-ring-pop { position: absolute; top: calc(100% + 8px); left: 0; width: 290px; padding: 12px; border-radius: 12px; background: var(--assets-surface); box-shadow: 0 18px 40px -12px rgb(0 0 0 / .35); z-index: 6; display: none; flex-direction: column; gap: 6px; }
.tube-ring-wrap:hover .tube-ring-pop, .tube-ring-wrap:focus-within .tube-ring-pop { display: flex; }
.tube-ring-row { display: grid; grid-template-columns: 10px 1fr auto; gap: 8px; align-items: center; }
.tube-ring-row small { color: var(--assets-muted); }
.tube-ring-meter { grid-column: 2 / -1; height: 3px; border-radius: 3px; background: var(--assets-hover); overflow: hidden; }
.tube-ring-meter i { display: block; height: 100%; }
.tube-bar-wrap { flex: 1; min-width: 0; }
.tube-stbar { display: flex; gap: 2px; height: var(--tube-bar-height); border-radius: 99px; overflow: hidden; }
.tube-stbar button { border: 0; padding: 0; cursor: pointer; transition: opacity var(--tube-fade), filter var(--tube-fade); }
.tube-stbar button:hover { filter: brightness(1.1); }
.tube-legend { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 7px; font-size: var(--tube-meta-size); color: var(--assets-muted); }
.tube-legend button { display: inline-flex; align-items: center; gap: 6px; border: 0; background: none; color: inherit; font: inherit; cursor: pointer; padding: 0; }
.tube-src-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; flex: none; background: var(--assets-muted); }
.tube-src-dot[data-src="tmp"] { background: var(--tube-src-tmp); }
.tube-src-dot[data-src="memory"] { background: var(--tube-src-memory); }
.tube-src-dot[data-src="houdini"] { background: var(--tube-src-houdini); }
.tube-src-dot[data-src="unreal"] { background: var(--tube-src-unreal); }
.tube-src-dot[data-src="cloud"] { background: var(--tube-src-cloud); }

/* Sidebar and main */
.tube-split { display: grid; grid-template-columns: var(--tube-side-width) minmax(0, 1fr); gap: 22px; }
.tube-side { border-right: 1px solid var(--assets-stroke); padding-right: 14px; align-self: start; position: sticky; top: 12px; }
.tube-side-label { font-size: 11px; color: var(--assets-muted); margin: 4px 8px 6px; }
.tube-side > button { display: flex; width: 100%; align-items: center; gap: 9px; padding: 7px 8px; border: 0; border-radius: 8px; background: none; color: var(--assets-ink); font: inherit; text-align: left; cursor: pointer; }
.tube-side > button[data-on="true"] { background: var(--assets-hover); }
.tube-side > button:disabled { opacity: .35; cursor: default; }
.tube-side > button .assets-number { margin-left: auto; color: var(--assets-muted); }
.tube-names-label { margin-top: 16px; }
.tube-names { display: flex; gap: 2px; padding: 2px; border-radius: 8px; background: var(--assets-hover); margin: 0 4px; }
.tube-names button { flex: 1; padding: 5px 4px; border: 0; border-radius: 6px; background: none; color: var(--assets-muted); font: inherit; font-size: 12px; cursor: pointer; }
.tube-names button[aria-pressed="true"] { background: var(--assets-surface); color: var(--assets-ink); box-shadow: 0 1px 3px rgb(0 0 0 / .15); }
.tube-main { min-width: 0; }
.tube-seg { display: inline-flex; padding: 2px; border-radius: 8px; background: var(--assets-hover); }
.tube-seg button { width: 32px; height: 28px; display: grid; place-items: center; border: 0; border-radius: 6px; background: none; color: var(--assets-muted); cursor: pointer; }
.tube-seg button[aria-pressed="true"] { background: var(--assets-surface); color: var(--assets-ink); box-shadow: 0 1px 3px rgb(0 0 0 / .15); }

/* List view */
.tube-list { border-radius: 10px; overflow: hidden; }
.tube-lr { display: grid; grid-template-columns: 28px minmax(0, 1fr) 150px 90px 90px; gap: 12px; align-items: center; min-height: var(--tube-row-height); padding: 0 10px; }
.tube-lr:nth-child(even):not(.tube-lr-h) { background: var(--assets-hover); }
.tube-lr[data-selected="true"] { background: var(--tube-select) !important; color: #fff; }
.tube-lr[data-selected="true"] .tube-lr-open, .tube-lr[data-selected="true"] .tube-lr-loc, .tube-lr[data-selected="true"] .assets-number { color: #fff; }
.tube-lr-h { min-height: 30px; color: var(--assets-muted); font-size: 11.5px; }
.tube-lr-head { border: 0; background: none; color: inherit; font: inherit; cursor: pointer; padding: 0; display: inline-flex; align-items: center; gap: 4px; }
.tube-lr-open { display: flex; align-items: center; gap: 10px; min-width: 0; border: 0; background: none; color: var(--assets-ink); font: inherit; text-align: left; cursor: pointer; padding: 0; }
.tube-lr-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tube-mini { --tube-spinner: 12px; flex: none; width: 28px; }
.tube-mini .tube-thumb { aspect-ratio: 1; border-radius: 6px; }
.tube-lr-loc { display: inline-flex; align-items: center; gap: 7px; color: var(--assets-muted); min-width: 0; overflow: hidden; white-space: nowrap; }
.tube-lr > .assets-number { color: var(--assets-muted); text-align: right; }

/* Columns view */
.tube-columns { display: flex; height: 380px; border: 1px solid var(--assets-stroke); border-radius: 10px; overflow-x: auto; }
.tube-col { flex: none; width: var(--tube-column-width); border-right: 1px solid var(--assets-stroke); overflow-y: auto; padding: 4px; }
.tube-ci { display: flex; width: 100%; align-items: center; gap: 8px; padding: 6px 8px; border: 0; border-radius: 6px; background: none; color: var(--assets-ink); font: inherit; text-align: left; cursor: pointer; }
.tube-ci > span { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tube-ci[data-on="true"] { background: var(--tube-select); color: #fff; }
.tube-col-preview { flex: 1; min-width: 240px; display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 18px; text-align: center; color: var(--assets-muted); }
.tube-preview-thumb { width: min(220px, 100%); border: 0; background: none; padding: 0; cursor: pointer; }
.tube-col-preview strong { font-weight: 400; color: var(--assets-ink); word-break: break-word; }

/* Gallery view */
.tube-gallery { outline: none; }
.tube-stage { display: block; width: 100%; padding: 0; border: 0; background: var(--assets-hover); border-radius: 12px; overflow: hidden; cursor: pointer; }
.tube-stage .tube-thumb { aspect-ratio: 16 / 7; border-radius: 0; }
.tube-stage-cap { display: flex; justify-content: space-between; gap: 12px; margin: 10px 0; color: var(--assets-muted); }
.tube-strip { display: flex; gap: 6px; overflow-x: auto; padding: 4px 2px; }
.tube-strip button { flex: none; width: 64px; padding: 0; border: 0; background: none; cursor: pointer; border-radius: 7px; --tube-spinner: 14px; }
.tube-strip button .tube-thumb { aspect-ratio: 1; border-radius: 7px; }
.tube-strip button[data-on="true"] { outline: 2px solid var(--tube-select); outline-offset: 1px; }

/* Download sheet: portaled to body, so it carries its own theme variables */
.tube-sheet-root { --assets-stroke: color-mix(in srgb, var(--assets-ink) var(--assets-border-strength, 12%), transparent); --assets-hover: color-mix(in srgb, var(--assets-ink) var(--assets-hover-strength, 4%), transparent); position: fixed; inset: 0; z-index: 9000; display: grid; place-items: start center; padding-top: 6vh; font-family: var(--zr-police-sans); color: var(--assets-ink); font-size: 13.5px; }
.tube-sheet-back { position: absolute; inset: 0; background: rgb(0 0 0 / .28); }
.tube-sheet { position: relative; width: min(720px, calc(100% - 32px)); max-height: 84vh; overflow: auto; background: var(--assets-surface); border-radius: 16px; box-shadow: 0 30px 80px -20px rgb(0 0 0 / .5); padding: 24px 26px; }
.tube-sheet-close { position: absolute; right: 14px; top: 14px; border: 0; background: var(--assets-hover); width: 28px; height: 28px; border-radius: 50%; color: var(--assets-muted); cursor: pointer; display: grid; place-items: center; }
.tube-zip { display: grid; grid-template-columns: 120px 1fr; gap: 24px; align-items: center; }
.tube-zip-icon { position: relative; display: block; width: 120px; aspect-ratio: 1.15; }
.tube-zip-icon i { position: absolute; display: block; }
.tube-zip-icon i:nth-child(1) { left: 0; top: 2%; width: 42%; height: 18%; border-radius: 8px 8px 0 0; background: #6fa6ea; }
.tube-zip-icon i:nth-child(2) { inset: 10% 0 0 0; border-radius: 10px; background: linear-gradient(#7fb3f0, #5a95e0); }
.tube-zip-icon i:nth-child(3) { inset: 22% 0 0 0; border-radius: 10px; background: linear-gradient(#a8cdf7, #78acee); }
.tube-zip-name { margin: 0; font-family: var(--zr-police-sans); font-weight: var(--tube-title-weight); font-size: 24px; line-height: 1.2; letter-spacing: -.02em; word-break: break-word; }
.tube-zip-subs { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 8px; margin: 14px 0; }
.tube-zip-sub { padding: 9px 12px; border-radius: 10px; background: var(--assets-hover); }
.tube-zip-sub strong { display: block; font-weight: 400; }
.tube-zip-sub small { color: var(--assets-muted); }
.tube-primary { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border: 0; border-radius: 99px; background: var(--assets-ink); color: var(--assets-background); font: inherit; cursor: pointer; }
.tube-primary:disabled { opacity: .4; cursor: default; }
.tube-tree { margin-top: 22px; border-top: 1px solid var(--assets-stroke); padding-top: 14px; }
.tube-tr-root { display: flex; align-items: center; gap: 8px; padding: 4px 0; font-size: 15px; }
.tube-tr { padding-left: 14px; }
.tube-tr > summary { display: flex; align-items: center; gap: 8px; padding: 4px 0; cursor: pointer; list-style: none; }
.tube-tr > summary::-webkit-details-marker { display: none; }
.tube-tr-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tube-tr-sz { margin-left: auto; color: var(--assets-muted); white-space: nowrap; }
.tube-tr-kids { padding-left: 4px; }
.tube-tr-file { display: flex; gap: 8px; padding: 3px 0 3px 36px; color: var(--assets-muted); }
.tube-sheet .tube-meta { margin-top: 14px; }

@media (max-width: 720px) {
  :root { --tube-card-min: 100%; --tube-file-min: 130px; --tube-gap: 14px; }
  .assets-workspace[data-layout="tube"] .assets-project-header { grid-template-columns: 1fr; }
  .tube-split { grid-template-columns: 1fr; }
  .tube-side { border-right: 0; padding-right: 0; position: static; }
  .tube-lr { grid-template-columns: 28px minmax(0, 1fr) 70px; }
  .tube-lr-loc, .tube-lr > .assets-number:nth-of-type(1) { display: none; }
  .tube-zip { grid-template-columns: 1fr; }
}

/* Project without any image: initials on a pastel from the name, so a card is never an empty grey box. */
.tube-thumb[data-placeholder] { background: hsl(var(--tube-ph-hue, 210) 38% 86%); }
.tube-initials { position: absolute; inset: 0; display: grid; place-items: center; font-size: 34px; font-weight: 700; letter-spacing: -.02em; color: hsl(var(--tube-ph-hue, 210) 30% 38%); }
:root[data-theme="dark"] .tube-thumb[data-placeholder], .zr-dark .tube-thumb[data-placeholder] { background: hsl(var(--tube-ph-hue, 210) 22% 24%); }

/* The shared layout switch sits in one place in every view: top right of the content column. */
.assets-layout-bar { display: flex; justify-content: flex-end; align-items: center; min-height: 34px; margin: 0 0 12px; }
.assets-layout-bar .tube-layout-switch { height: 32px; align-items: center; }
.assets-layout-bar .tube-layout-switch button { height: 26px; line-height: 26px; padding: 0 14px; }

/* Chosen thumbnail: right-click menu, badge and toast. */
.tube-cover-badge { position: absolute; left: 8px; top: 8px; z-index: 4; padding: 2px 8px; border-radius: 99px; background: var(--assets-ink); color: var(--assets-background); font-size: 11px; line-height: 1.5; pointer-events: none; }
.tube-cover-badge-inline { position: static; margin-left: 8px; flex: none; }
.tube-menu-root { position: fixed; inset: 0; z-index: 9100; font-family: var(--zr-police-sans); }
.tube-menu { position: fixed; min-width: 250px; padding: 6px; border-radius: 12px; background: var(--assets-surface); color: var(--assets-ink); box-shadow: 0 18px 50px -12px rgb(0 0 0 / .4), 0 0 0 1px rgb(0 0 0 / .06); }
.tube-menu button { display: flex; width: 100%; align-items: center; gap: 10px; padding: 8px 10px; border: 0; border-radius: 8px; background: none; color: inherit; font: inherit; font-size: 13.5px; text-align: left; cursor: pointer; }
.tube-menu button:hover { background: var(--tube-select); color: #fff; }
.tube-toast { position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%); z-index: 9200; padding: 10px 18px; border-radius: 99px; background: var(--assets-ink); color: var(--assets-background); font-size: 13px; box-shadow: 0 12px 30px -10px rgb(0 0 0 / .45); }

.tube-glyph { flex-direction: column; gap: 6px; align-content: center; }
.tube-ext { font-size: 10.5px; letter-spacing: .06em; color: var(--assets-muted); opacity: .85; }
.tube-thumb[data-shape="doc"] .tube-glyph, .tube-thumb[data-shape="audio"] .tube-glyph { z-index: 1; }
/* A faint renderer placeholder must never sit above a real glyph. */
.tube-glyph ~ * svg:not(.tube-spinner svg) { display: none; }

/* 20 October 2026: the bindings list, one row per project with its bound conversations; every size reuses the tube tokens above. */
.tube-bindings { display: flex; flex-direction: column; gap: 8px; }
.tube-binding { border: 1px solid var(--assets-stroke); border-radius: 14px; background: var(--assets-wash); }
.tube-binding > summary { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 14px; align-items: center; padding: 12px 16px; cursor: pointer; list-style: none; }
.tube-binding > summary::-webkit-details-marker { display: none; }
.tube-binding-name button, .tube-binding-name span { font: inherit; font-size: var(--tube-title-size); font-weight: var(--tube-title-weight); color: var(--assets-ink); background: none; border: 0; padding: 0; cursor: pointer; text-align: left; }
.tube-binding-providers { display: flex; gap: 10px; }
.tube-binding-provider { display: inline-flex; align-items: center; gap: 4px; font-size: var(--tube-meta-size); color: var(--assets-muted); }
.tube-binding ul { margin: 0; padding: 0 12px 10px; list-style: none; }
.tube-binding li button { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 10px; align-items: center; width: 100%; padding: 8px 6px; border: 0; background: none; color: var(--assets-ink); font: inherit; font-size: var(--tube-meta-size); text-align: left; cursor: pointer; border-radius: 8px; }
.tube-binding li button:hover { background: var(--assets-hover); }
.tube-binding li button span:nth-child(2) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 20 October 2026: thumbnail adjust modal (right click on project cover). */
.tube-adjust-overlay { position: fixed; inset: 0; z-index: 9400; background: rgba(0, 0, 0, 0.76); backdrop-filter: blur(10px); display: flex; align-items: center; justify-content: center; padding: 20px; font-family: var(--zr-police-sans); }
.tube-adjust-modal { max-width: 660px; width: 100%; max-height: 90vh; overflow-y: auto; background: var(--assets-surface); color: var(--assets-ink); border-radius: 18px; border: 1px solid var(--assets-stroke); box-shadow: 0 24px 64px rgba(0, 0, 0, 0.55); display: flex; flex-direction: column; }
.tube-adjust-header { display: flex; align-items: center; justify-content: space-between; padding: 14px 20px; border-bottom: 1px solid var(--assets-stroke); }
.tube-adjust-title-group h3 { margin: 0; font-size: 16px; font-weight: 600; color: var(--assets-ink); }
.tube-adjust-sub { font-size: 11.5px; color: var(--assets-muted); font-family: var(--zr-police-mono); }
.tube-adjust-close { border: 0; background: none; color: var(--assets-muted); cursor: pointer; padding: 6px; border-radius: 6px; display: grid; place-items: center; }
.tube-adjust-close:hover { color: var(--assets-ink); background: var(--assets-hover); }

.tube-adjust-viewport-wrap { padding: 16px 20px 8px; display: flex; flex-direction: column; gap: 8px; }
.tube-adjust-viewport { width: 100%; aspect-ratio: 16 / 9; background: #000000; border-radius: 12px; overflow: hidden; position: relative; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.12); }
.tube-adjust-canvas { width: 100%; height: 100%; display: block; cursor: grab; object-fit: contain; }
.tube-adjust-canvas.is-dragging { cursor: grabbing; }
.tube-adjust-loading, .tube-adjust-error { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; color: #ffffff; font-size: 13px; }
.tube-adjust-hint { font-size: 11px; color: var(--assets-muted); text-align: center; }

.tube-adjust-controls { padding: 12px 20px; display: flex; flex-direction: column; gap: 14px; }
.tube-adjust-presets { display: flex; flex-direction: column; gap: 6px; }
.tube-adjust-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--assets-muted); font-weight: 600; }
.tube-adjust-btn-group { display: flex; flex-wrap: wrap; gap: 8px; }
.tube-adjust-btn-group .tube-chip.is-active { background: var(--assets-ink); color: var(--assets-background); }

.tube-adjust-sliders { display: flex; flex-direction: column; gap: 8px; }
.tube-adjust-row { display: grid; grid-template-columns: 140px 24px 1fr 24px; gap: 8px; align-items: center; }
.tube-adjust-slider-label { font-size: 12px; color: var(--assets-ink); }
.tube-adjust-step-btn, .tube-adjust-zero-btn { background: var(--assets-wash); border: 1px solid var(--assets-stroke); color: var(--assets-ink); border-radius: 6px; height: 24px; width: 24px; display: grid; place-items: center; font-size: 12px; cursor: pointer; }
.tube-adjust-step-btn:hover, .tube-adjust-zero-btn:hover { background: var(--assets-hover); }
.tube-adjust-row input[type="range"] { accent-color: var(--assets-accent, #ff6b35); cursor: pointer; }

.tube-adjust-footer { padding: 14px 20px; border-top: 1px solid var(--assets-stroke); display: flex; justify-content: flex-end; gap: 10px; }
.tube-adjust-cancel { padding: 8px 16px; border-radius: 8px; background: none; border: 1px solid var(--assets-stroke); color: var(--assets-ink); font: inherit; font-size: 13px; cursor: pointer; }
.tube-adjust-cancel:hover { background: var(--assets-hover); }
.tube-adjust-save { padding: 8px 20px; border-radius: 8px; background: var(--assets-accent, #ff6b35); border: 0; color: #ffffff; font: inherit; font-size: 13px; font-weight: 500; cursor: pointer; box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3); }
.tube-adjust-save:hover { filter: brightness(1.08); }
.tube-adjust-save:disabled { opacity: 0.5; cursor: default; }
