import React, { useCallback, useEffect, useId, useMemo, useRef, useState } from 'react'
import { PALETTE, TRANSITIONS } from '../theme.js'
import Icon from './Icon.jsx'
import { ColumnMenuColumn, ColumnMenuItem, ColumnMenuShell, useReducedMotion } from './ColumnMenu.jsx'

const FONT = "var(--zr-police-sans)"

function nodeChildren(node) {
  return Array.isArray(node?.children) ? node.children.filter(Boolean) : []
}

/**
 * Menu d'actions récursif façon Finder « As Columns ».
 *
 * - `nodes`: { id, label, icon, children, action, disabled, danger, selected, keepOpen }
 * - trigger interne: fournir `trigger` (ReactNode) ou une fonction render-prop.
 * - popover contrôlé (clic droit): fournir `open`, `anchor` et `onClose`, sans trigger.
 *
 * Le hover reste purement visuel. Seul un clic ouvre une branche ou exécute
 * une feuille. La coque, le viewport clamp et le scroll horizontal sont
 * centralisés dans ColumnMenuShell.
 */
export function ActionColumnMenu({
  t,
  nodes = [],
  trigger,
  open: controlledOpen,
  anchor: controlledAnchor,
  onClose,
  onOpenChange,
  disabled = false,
  align = 'left',
  reserveColumns = 2,
  showChevron = true,
  ariaLabel = 'Actions',
  title,
  columnWidth = 238,
  initialChain = null,
  maxHeight = 420,
  minHeight = 160,
  triggerClassName = 'zr-tap',
  triggerStyle,
  className = '',
}) {
  const rawId = useId()
  const menuId = `zr-action-columns-${rawId.replace(/:/g, '')}`
  const triggerRef = useRef(null)
  const [internalAnchor, setInternalAnchor] = useState(null)
  const [chain, setChain] = useState([])
  const reducedMotion = useReducedMotion()
  const isControlled = typeof controlledOpen === 'boolean' || (controlledAnchor != null && trigger == null)
  const isOpen = isControlled ? (controlledOpen ?? Boolean(controlledAnchor)) : Boolean(internalAnchor)
  const anchor = controlledAnchor || internalAnchor || { left: 12, top: 12, triggerTop: 12 }

  const close = useCallback(() => {
    if (!isControlled) setInternalAnchor(null)
    setChain([])
    onOpenChange?.(false)
    onClose?.()
  }, [isControlled, onClose, onOpenChange])

  const toggle = useCallback((event) => {
    if (disabled) return
    if (isOpen) {
      close()
      return
    }
    const element = event?.currentTarget || triggerRef.current
    const rect = element?.getBoundingClientRect?.()
    const nextAnchor = rect
      ? {
          // La colonne racine reste accolée au trigger. Près du bord droit, la coque
          // conserve cette position et son scroller révèle les colonnes suivantes :
          // aucune colonne fantôme entre le bouton et le menu.
          left: align === 'right' ? rect.right - columnWidth : rect.left,
          top: rect.bottom + 6,
          triggerTop: rect.top,
        }
      : { left: 12, top: 12, triggerTop: 12 }
    if (!isControlled) setInternalAnchor(nextAnchor)
    onOpenChange?.(true, nextAnchor)
  }, [align, close, columnWidth, disabled, isControlled, isOpen, onOpenChange])

  // Un nouveau popover contextuel constitue une nouvelle session de navigation.
  const anchorKey = `${Number(anchor?.left || 0)}:${Number(anchor?.top || 0)}`
  useEffect(() => {
    if (!isOpen) setChain([])
  }, [isOpen])
  // 14 October 2026: `initialChain` lists branch ids that open WITH the menu (the "Mode d'envoi" names column is visible from the
  // first right click). FR : branches ouvertes des l'ouverture du menu.
  useEffect(() => {
    if (isControlled && isOpen) setChain(Array.isArray(initialChain) ? initialChain : [])
  }, [anchorKey, isControlled, isOpen]) // eslint-disable-line react-hooks/exhaustive-deps

  // Résout les identifiants contre l'arbre vivant : aucune action ni branche
  // n'est conservée dans une closure obsolète après une mise à jour des nodes.
  const selectedPath = useMemo(() => {
    const path = []
    let candidates = Array.isArray(nodes) ? nodes : []
    for (const id of chain) {
      const match = candidates.find((candidate) => candidate?.id === id)
      if (!match || nodeChildren(match).length === 0) break
      path.push(match)
      candidates = nodeChildren(match)
    }
    return path
  }, [chain, nodes])

  // Si l'arbre vivant change, retire seulement les branches qui n'existent plus.
  useEffect(() => {
    if (selectedPath.length < chain.length) setChain((current) => current.slice(0, selectedPath.length))
  }, [chain.length, selectedPath.length])

  const columns = useMemo(() => {
    const result = [Array.isArray(nodes) ? nodes.filter(Boolean) : []]
    for (const selected of selectedPath) {
      const children = nodeChildren(selected)
      if (children.length === 0) break
      result.push(children)
    }
    return result
  }, [nodes, selectedPath])

  const selectNode = useCallback((node, depth) => {
    if (!node || node.disabled) return
    const children = nodeChildren(node)
    if (children.length > 0) {
      setChain((current) => [...current.slice(0, depth), node.id])
      return
    }

    const path = [...selectedPath.slice(0, depth), node]
    try {
      node.action?.({ node, path, depth, close })
    } finally {
      if (!node.keepOpen) close()
    }
  }, [close, selectedPath])

  const renderedColumns = columns.map((items, depth) => {
    const parent = depth > 0 ? selectedPath[depth - 1] : null
    return (
      <ColumnMenuColumn
        key={`column-${depth}-${parent?.id ?? 'root'}`}
        t={t}
        width={columnWidth}
        index={depth}
        label={depth === 0 ? ariaLabel : String(parent?.label ?? '')}
      >
        {items.length === 0 ? (
          <ColumnMenuItem t={t} disabled>Aucune action</ColumnMenuItem>
        ) : items.map((node, index) => {
          // 14 October 2026: `header` = a non clickable heading inside a column (mode title above the film names).
          if (node.header) {
            return (
              <div key={node.id ?? `${depth}-${index}`} role="presentation"
                style={{ display: 'flex', alignItems: 'center', gap: 8, padding: index === 0 ? '4px 10px 3px' : '10px 10px 3px', fontFamily: FONT,
                  fontSize: 'var(--zr-ui-md)', fontWeight: 600, color: node.color || 'inherit', whiteSpace: 'nowrap' }}>
                {node.icon && <span aria-hidden="true" style={{ width: 18, display: 'inline-flex', justifyContent: 'center' }}>{node.icon}</span>}
                <span style={{ overflow: 'hidden', textOverflow: 'ellipsis' }}>{node.label}</span>
                {node.count != null && <span style={{ opacity: .6, fontWeight: 500 }}>· {node.count}</span>}
              </div>
            )
          }
          const children = nodeChildren(node)
          const inChain = chain[depth] === node.id
          const selected = Boolean(inChain || node.selected)
          const icon = typeof node.icon === 'function' ? node.icon({ node, selected }) : node.icon
          const customTrailing = typeof node.trailing === 'function'
            ? node.trailing({ node, selected })
            : node.trailing
          const trailing = children.length > 0
            ? <span style={{ display: 'inline-flex', alignItems: 'center', gap: 6 }}>{customTrailing}{customTrailing != null && <span aria-hidden="true">·</span>}<Icon name="chevron.right" size={10} weight={2} /></span>
            : customTrailing
          return (
            <ColumnMenuItem
              key={node.id ?? `${depth}-${index}`}
              t={t}
              icon={icon}
              trailing={trailing}
              selected={selected}
              danger={Boolean(node.danger)}
              disabled={Boolean(node.disabled)}
              title={typeof node.label === 'string' ? node.label : undefined}
              onClick={() => selectNode(node, depth)}
            >
              {node.label}
            </ColumnMenuItem>
          )
        })}
      </ColumnMenuColumn>
    )
  })

  const triggerProps = {
    ref: triggerRef,
    type: 'button',
    'data-zr-action-menu-trigger': menuId,
    'aria-haspopup': 'menu',
    'aria-expanded': isOpen,
    'aria-controls': isOpen ? `${menuId}-menu` : undefined,
    'aria-label': title || ariaLabel,
    disabled,
    onClick: toggle,
  }

  let triggerElement = null
  if (trigger != null) {
    triggerElement = typeof trigger === 'function'
      ? trigger({ open: isOpen, disabled, triggerProps })
      : (
        <button
          {...triggerProps}
          className={triggerClassName}
          title={title}
          style={{
            minHeight: 32,
            display: 'inline-flex',
            alignItems: 'center',
            justifyContent: 'center',
            gap: 6,
            padding: '5px 10px',
            borderRadius: 999,
            border: `1px solid ${isOpen ? `${PALETTE.primary}55` : (t?.border || 'rgba(60,60,67,.18)')}`,
            background: isOpen ? PALETTE.primarySoft : 'transparent',
            color: isOpen ? PALETTE.primary : (t?.textSecondary || 'currentColor'),
            cursor: disabled ? 'default' : 'pointer',
            opacity: disabled ? .45 : 1,
            fontFamily: FONT,
            fontSize: 'var(--zr-ui-sm)',
            fontWeight: 500,
            transition: reducedMotion ? 'none' : TRANSITIONS.micro,
            ...triggerStyle,
          }}
        >
          {trigger}
          {showChevron && <Icon name="chevron.down" size={10} weight={2} />}
        </button>
      )
  }

  return (
    <>
      {triggerElement}
      {isOpen && (
        <ColumnMenuShell
          id={`${menuId}-menu`}
          t={t}
          anchor={anchor}
          onClose={close}
          ariaLabel={ariaLabel}
          columnWidth={columnWidth}
          maxHeight={maxHeight}
          minHeight={minHeight}
          triggerRef={triggerRef}
          triggerSelector={trigger != null ? `[data-zr-action-menu-trigger="${menuId}"]` : undefined}
          className={className}
          columns={renderedColumns}
        />
      )}
    </>
  )
}

export default ActionColumnMenu

// Forme explicite pour les clics droits : aucun déclencheur n'est rendu.
export function ActionColumnPopover(props) {
  return <ActionColumnMenu {...props} trigger={null} />
}
