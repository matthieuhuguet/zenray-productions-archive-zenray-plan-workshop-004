// Calcul de progression LifeOS (objectifs.json) — extrait de App.jsx (batch refactor structurel
// 2026-07-16). Pur, sans dépendance React ; consommé par Board/Overall/Domains/DomainCard.
import DATA from '../objectives.json'

export const objProg = (steps, o) => { const ms = o.milestones || []; if (!ms.length) return (o.pct || 0) / 100; let d = 0; ms.forEach((m, i) => { if (steps[`${o.id}|${i}`]) d++ }); return d / ms.length }
export const domProg = (steps, dom) => { const o = dom.objectives || []; return o.length ? o.reduce((s, x) => s + objProg(steps, x), 0) / o.length : 0 }
export const allObjs = () => DATA.domains.flatMap((d) => d.objectives.map((o) => ({ ...o, _domain: d.label })))
export const overall = (steps) => { const a = allObjs(); return a.length ? a.reduce((s, o) => s + objProg(steps, o), 0) / a.length : 0 }
export const pc = (x) => Math.round(x * 100)
