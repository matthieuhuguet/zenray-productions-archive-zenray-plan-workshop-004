// Classe une URL pour l'insertion (mode Embed). Réutilise l'allowlist YouTube STRICTE de la feature Ref.
// Jamais d'iframe arbitraire : seuls image directe + YouTube sont reconnus, le reste retombe sur Bookmark.
import { parseYouTube } from '../../ref/embed.js'

export function sanitizeUrl(raw) {
  if (typeof raw !== 'string') return null
  const s = raw.trim()
  try { const u = new URL(s); return /^https?:$/.test(u.protocol) ? u.href : null } catch { return null }
}

export function isImageUrl(u) {
  return /\.(png|jpe?g|gif|webp|avif|svg)(\?|#|$)/i.test(u || '')
}

// Renvoie { kind:'image' } | { kind:'youtube', providerId, embedUrl, start } | { kind:'unknown' }
export function classifyUrl(url) {
  if (isImageUrl(url)) return { kind: 'image' }
  const yt = parseYouTube(url)
  if (yt) {
    const base = `https://www.youtube-nocookie.com/embed/${yt.providerId}`
    return { kind: 'youtube', providerId: yt.providerId, start: yt.start || 0, embedUrl: yt.start ? `${base}?start=${yt.start}` : base }
  }
  return { kind: 'unknown' }
}
