export function stateCardFromManifest(rel, manifest, manifestPath = null) {
  const versions = Array.isArray(manifest.versions) && manifest.versions.length ? manifest.versions : []
  const date = manifest.ts || manifest.addedAt || null
  return {
    rel,
    taille: manifest.size || manifest.clearSize || 0,
    sha: manifest.sha256 || manifest.sourceSha256 || '',
    versions: versions.length || 1,
    premier: versions[0]?.ts || date,
    dernier: versions[versions.length - 1]?.ts || date,
    supprime: !!manifest.deleted,
    depuis: manifest.depuis || null,
    manifeste: manifestPath,
  }
}

export function mergePreviousStateCards(currentCards, previousCards, ownsPath) {
  const merged = new Map(currentCards)
  for (const card of previousCards || []) {
    if (!card?.rel) continue
    // La voie courante décide seulement de sa tranche. Pour les autres, le dernier index écrit est plus frais
    // que son clone pris au début du passage et doit donc gagner.
    if (!ownsPath(card.rel) || !merged.has(card.rel)) merged.set(card.rel, card)
  }
  return merged
}
