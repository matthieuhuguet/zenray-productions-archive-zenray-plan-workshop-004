// 4 October 2026: the token is found whatever the terminal did to it, and never invented from a fragment.
import { describe, expect, it } from 'vitest'
import { extractToken } from './TokenCapture.mjs'

const TOKEN = `sk-ant-oat01-${'aB3_-'.repeat(20)}ZZ`
describe('extractToken', () => {
  it('reads the token from the plain screen', () => {
    expect(extractToken(`✓ Long-lived authentication token created successfully!\n\nYour OAuth token (valid for 1 year):\n\n${TOKEN}\n\nStore this token securely.`)).toBe(TOKEN)
  })
  it('ignores colours and carriage returns', () => {
    expect(extractToken(`\u001b[32m✓ created\u001b[39m\r\nYour OAuth token (valid for 1 year):\r\n\u001b[33m${TOKEN}\u001b[39m\r\n\r\nStore this token securely.`)).toBe(TOKEN)
  })
  it('joins a token a narrow terminal broke over several lines, without swallowing the next sentence', () => {
    const cut = `${TOKEN.slice(0, 40)}\n${TOKEN.slice(40, 80)}\n${TOKEN.slice(80)}`
    expect(extractToken(`Your OAuth token (valid for 1 year):\n\n${cut}\n\nStore this token securely. You won't be able to see it again.`)).toBe(TOKEN)
  })
  it('falls back to the last token on the screen, and returns nothing for a fragment or no token', () => {
    expect(extractToken(`old sk-ant-oat01-${'x'.repeat(70)}\nnew ${TOKEN}`)).toBe(TOKEN)
    expect(extractToken('sk-ant-oat01-short')).toBe('')
    expect(extractToken('Login cancelled')).toBe('')
  })
})
