// LA SEULE CHOSE QUI DIFFÈRE VRAIMENT ENTRE VERCEL ET CLOUDFLARE.
//
// Ce fichier a d'abord été écrit trois fois plus long, parce que j'avais supposé qu'un Worker
// n'avait ni système de fichiers, ni `node:crypto`, ni `process.env`. **Les trois suppositions
// étaient fausses**, et les vérifier a supprimé l'essentiel du travail de migration :
//
//   node:fs      supporté (mémoire ; les fichiers du bundle se lisent sous `/bundle`)
//   node:crypto  supporté, y compris createHash, createHmac, randomBytes, createDecipheriv
//   node:path    supporté          node:url  supporté
//   process.env  PEUPLÉ automatiquement avec les variables et secrets du Worker, dès lors que
//                `nodejs_compat_populate_process_env` est actif — il l'est par défaut pour toute
//                date de compatibilité postérieure au 2025-04-01
//
// Les 38 variables d'environnement et les 112 lectures de `process.env` n'ont donc RIEN à changer,
// et les cinq primitives de `node:crypto` non plus. Vérifié sur la documentation Cloudflare le
// 2026-07-30, après avoir écrit un audit qui affirmait le contraire.
//
// CE QUI RESTE, ET C'EST TOUT
// ---------------------------
// Un seul point : lire un fichier LIVRÉ avec le déploiement. `server/share-og.js` lit
// `dist/index.html` pour y injecter les métadonnées Open Graph. Vercel le rend disponible par
// `includeFiles` dans `vercel.json` ; Cloudflare le rend disponible par le service d'assets, sous
// un autre chemin. Une fonction, deux implémentations, et le reste du code ignore où il tourne.
//
// La leçon vaut plus que le fichier : **une abstraction écrite avant d'avoir vérifié la contrainte
// abstrait surtout l'ignorance de celui qui l'écrit.** Trois requêtes de documentation ont fait
// fondre cent lignes.

// ── Node : Vercel, et le serveur local ──────────────────────────────────────────────────────────
const nodePlatform = {
  nom: 'node',
  async readAsset(cheminRelatif) {
    const { readFileSync } = await import('node:fs')
    const path = (await import('node:path')).default
    const { fileURLToPath } = await import('node:url')
    const racine = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
    return readFileSync(path.join(racine, cheminRelatif), 'utf8')
  },
}

// ── Cloudflare ──────────────────────────────────────────────────────────────────────────────────
//
// `env.ASSETS.fetch()` rend un fichier publié avec le déploiement. Le préfixe `dist/` appartient à
// l'arborescence de construction et disparaît une fois le site publié, d'où le retrait.
// L'hôte de l'URL est arbitraire : seul le chemin est lu.
export function cloudflarePlatform(env) {
  return {
    nom: 'cloudflare',
    async readAsset(cheminRelatif) {
      const chemin = cheminRelatif.replace(/^dist\//, '')
      const r = await env.ASSETS.fetch(new Request(`https://assets.local/${chemin}`))
      if (!r.ok) throw new Error(`asset introuvable : ${cheminRelatif} (${r.status})`)
      return r.text()
    },
  }
}

let courant = nodePlatform

/** Appelé une fois par requête par l'adaptateur Cloudflare, jamais ailleurs. */
export function setPlatform(p) { courant = p }

/** Lit un fichier livré avec le déploiement, par exemple `dist/index.html`. */
export const readAsset = (chemin) => courant.readAsset(chemin)

/** Le nom de l'hôte courant. Sert aux diagnostics et au test de non-régression. */
export const platformName = () => courant.nom
