// 14 October 2026: markers persist across a reload for ten minutes; a failed read is never remembered as "no marker".
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'

const store = new Map()
beforeEach(() => {
  store.clear()
  vi.stubGlobal('localStorage', { getItem: (k) => store.get(k) ?? null, setItem: (k, v) => store.set(k, String(v)), removeItem: (k) => store.delete(k) })
  vi.useFakeTimers()
})
afterEach(() => { vi.useRealTimers(); vi.unstubAllGlobals(); vi.resetModules() })

const answer = (body) => ({ ok: true, json: async () => body })

describe('folder visibility markers', () => {
  it('reads a marker once, persists it, and a reloaded page does not ask again', async () => {
    const fetchMock = vi.fn(async () => answer({ markdown: JSON.stringify({ vis: 'private' }) }))
    vi.stubGlobal('fetch', fetchMock)
    const first = await import('./folderVisibility.js')
    expect(await first.resolveFolderVis('pages/Photos')).toBe('private')
    await vi.advanceTimersByTimeAsync(500)
    expect(store.get('zr:folderVis:v1')).toContain('private')
    const calls = fetchMock.mock.calls.length

    vi.resetModules()
    const reloaded = await import('./folderVisibility.js')
    expect(await reloaded.resolveFolderVis('pages/Photos')).toBe('private')
    expect(fetchMock.mock.calls.length).toBe(calls)
  })

  it('does not remember a failed read as an absence', async () => {
    const fetchMock = vi.fn()
      .mockRejectedValueOnce(new Error('offline'))
      .mockResolvedValue(answer({ markdown: JSON.stringify({ vis: 'private' }) }))
    vi.stubGlobal('fetch', fetchMock)
    const mod = await import('./folderVisibility.js')
    await mod.resolveFolderVis('pages/Secret') // offline: falls back to the default for this call only
    await vi.advanceTimersByTimeAsync(500)
    expect(store.get('zr:folderVis:v1') || '').not.toContain('pages/Secret')
    mod.invalidateVisibility()
    expect(await mod.resolveFolderVis('pages/Secret')).toBe('private')
  })

  it('ignores a persisted copy older than ten minutes and clears it on invalidation', async () => {
    store.set('zr:folderVis:v1', JSON.stringify({ at: Date.now() - 11 * 60 * 1000, entries: { 'pages/Old': 'private' } }))
    const fetchMock = vi.fn(async () => answer({ missing: true, markdown: '' }))
    vi.stubGlobal('fetch', fetchMock)
    const mod = await import('./folderVisibility.js')
    expect(await mod.resolveFolderVis('pages/Old')).toBe('public')
    expect(fetchMock).toHaveBeenCalled()
    mod.invalidateVisibility()
    expect(store.has('zr:folderVis:v1')).toBe(false)
  })
})
