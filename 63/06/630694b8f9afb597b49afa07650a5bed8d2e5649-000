// 5 October 2026: his own searches. Paste a studio's careers page or type keywords: a recognised board is read by the engine at every
// pass (every six hours), anything else stays a link to open. Removing one only dates it; the file keeps the history.
// FR : ses recherches. Colle la page carrieres d'un studio ou tape des mots-cles : un tableau reconnu est lu a chaque passe, le reste reste un lien.
import React, { useState } from 'react'
import { activeSearches, isAddress } from '../../lib/freelanceSearches.js'
import { Button, Field, P, glassStyle } from './ui.jsx'

const MODE = { board: 'lu par le moteur à chaque recherche', keywords: 'mots-clés ajoutés aux recherches automatiques et à LinkedIn', index: 'page lue par le moteur à chaque recherche : ses liens d’offres sont suivis',
  link: 'lien à ouvrir toi-même', invalid: 'adresse non reconnue' }

export default function FreelanceMySearches({ t, file, engine, onAdd, onRemove }) {
  const [input, setInput] = useState('')
  const [label, setLabel] = useState('')
  const [error, setError] = useState('')
  const list = activeSearches(file)
  const statusOf = (id) => (engine?.mySearches || []).find((entry) => entry.id === id)
  const small = { fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, lineHeight: 1.5 }
  const submit = async () => {
    const result = await onAdd({ input, label })
    if (result?.error) { setError(result.error); return }
    setError(''); setInput(''); setLabel('')
  }
  return (
    <div>
      <p style={{ ...small, margin: '0 0 12px' }}>
        Colle l’adresse de la page carrières d’un studio (Greenhouse, Lever, Ashby, SmartRecruiters, Recruitee, Breezy : le moteur la lit seul, toutes les six heures)
        ou tape des mots-clés. Toute autre page publique (https) est lue aussi : sa fiche d’offre, ou les liens d’offres qu’elle contient. {isAddress(input) ? 'Adresse détectée.' : input.trim() ? 'Mots-clés détectés.' : ''}
      </p>
      <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', marginBottom: 10 }}>
        <Field t={t} value={input} onChange={(v) => { setInput(v); setError('') }} placeholder="Adresse d’une page carrières, ou mots-clés" width={320} onKeyDown={(e) => { if (e.key === 'Enter') submit() }} />
        <Field t={t} value={label} onChange={setLabel} placeholder="Nom (facultatif)" width={150} />
        <Button t={t} primary onClick={submit}>+ recherche</Button>
      </div>
      {error && <p role="alert" style={{ ...small, color: '#eb584f', margin: '0 0 10px' }}>{error}</p>}
      <div style={{ display: 'grid', gap: 8 }}>
        {list.map((entry) => {
          const status = statusOf(entry.id)
          return (
            <div key={entry.id} style={{ display: 'flex', gap: 10, alignItems: 'baseline', flexWrap: 'wrap', fontFamily: P.sans, fontSize: 13 }}>
              <span style={{ ...glassStyle(t), padding: '2px 10px' }}>{entry.label}</span>
              {entry.url && <a href={entry.url} target="_blank" rel="noreferrer" style={{ color: t.textSecondary, fontSize: 12.5 }}>ouvrir ↗</a>}
              <span style={small}>{status ? MODE[status.mode] : 'sera prise en compte à la prochaine recherche'}</span>
              <button type="button" onClick={() => onRemove(entry.id)} style={{ marginLeft: 'auto', background: 'none', border: 'none', cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 12.5 }}>retirer</button>
            </div>
          )
        })}
        {!list.length && <span style={small}>Aucune recherche à toi pour l’instant.</span>}
      </div>
    </div>
  )
}
