// 5 October 2026: the fixed Paris slots, across summer time, winter time and a clock change.
import { describe, it, expect } from 'vitest'
import { slotAfter, slotAtOrBefore } from './lib/Schedule.mjs'

const cfg = { hours: [0, 6, 12, 18], timeZone: 'Europe/Paris' }
describe('fixed slots', () => {
  it('summer: 10:48 Paris (08:48Z) is followed by 12:00 Paris (10:00Z)', () => {
    expect(slotAfter(new Date('2026-10-05T08:48:00Z'), cfg).toISOString()).toBe('2026-10-05T10:00:00.000Z')
    expect(slotAtOrBefore(new Date('2026-10-05T08:48:00Z'), cfg).toISOString()).toBe('2026-10-05T04:00:00.000Z')
  })
  it('winter: 23:30 Paris (22:30Z) is followed by midnight Paris (23:00Z)', () => {
    expect(slotAfter(new Date('2026-12-05T22:30:00Z'), cfg).toISOString()).toBe('2026-12-05T23:00:00.000Z')
  })
  it('a run exactly on a slot waits for the next one', () => {
    expect(slotAfter(new Date('2026-10-05T10:00:00Z'), cfg).toISOString()).toBe('2026-10-05T16:00:00.000Z')
  })
  it('clock change night (29 Mar 2026) still lands on midnight and 06:00 Paris', () => {
    expect(slotAfter(new Date('2026-03-28T23:30:00Z'), cfg).toISOString()).toBe('2026-03-29T04:00:00.000Z')
  })
})
