// film-categories.mjs (14 October 2026): the cloud base folder of the films and its category folders, read from the ONE table
// scripts/Films/WorkCategories.json (also read by the Python worker). FR : base cloud des films, lue depuis la table unique.
import fs from 'node:fs'

const TABLE_URL = new URL('../Films/WorkCategories.json', import.meta.url)

export function loadFilmCategories(tableUrl = TABLE_URL) {
  const table = JSON.parse(fs.readFileSync(tableUrl, 'utf8'))
  for (const key of ['base', 'legacyBase', 'categories', 'works']) {
    if (!(key in table)) throw new Error(`WorkCategories.json is missing "${key}"`)
  }
  return table
}

export const FILM_BASE = loadFilmCategories().base

export function categoryFolder(category, table = loadFilmCategories()) {
  if (!table.categories.includes(category)) {
    throw new Error(`Unknown category "${category}", expected one of ${table.categories.join(', ')}`)
  }
  return `${table.base}/${category}`
}
