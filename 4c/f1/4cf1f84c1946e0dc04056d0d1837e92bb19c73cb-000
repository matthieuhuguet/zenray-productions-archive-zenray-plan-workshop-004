// 14 October 2026: the badge says how a film reached the drive. FR : la pastille dit comment le film est arrive sur le drive.
import { describe, it, expect } from 'vitest'
import { deliveryKind, deliveryRows } from '../lib/deliveryKind.js'

const tr = (k) => k
describe('delivery badge', () => {
  it('archive only: parts and no master or mpd', () => {
    expect(deliveryKind({ type: 'video-raw', parts: [{ url: 'x' }] })).toBe('archive')
  })
  it('both: parts plus master and mpd', () => {
    expect(deliveryKind({ type: 'video-raw', parts: [{ url: 'x' }], master: 'a.m3u8', mpd: 'a.mpd' })).toBe('both')
  })
  it('streaming only: master without parts', () => {
    expect(deliveryKind({ type: 'dash', master: 'a.m3u8' })).toBe('streaming')
  })
  it('no badge for YouTube, nothing, or an unknown shape', () => {
    expect(deliveryKind({ type: 'youtube', url: 'x' })).toBe(null)
    expect(deliveryKind(null)).toBe(null)
    expect(deliveryKind({ type: 'video-raw' })).toBe(null)
  })
  it('details rows carry the measured fields', () => {
    const rows = deliveryRows({ codec: 'hevc', width: 1920, height: 1080, duration: 1475, size: 795100574, parts: [1, 2], alg: 'AES-GCM',
      audio: [{ lang: 'jpn', label: '日本語' }], subtitles: [{ lang: 'fre', label: 'Français' }] }, 'archive', tr)
    const flat = Object.fromEntries(rows)
    expect(flat['player.dCodec']).toContain('hevc')
    expect(flat['player.dSize']).toBe('758 MiB')
    expect(flat['player.dParts']).toContain('AES-GCM')
    expect(flat['player.dSubtitles']).toBe('Français')
  })
})
