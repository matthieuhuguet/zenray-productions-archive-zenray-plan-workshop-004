import { MARQUEURS_DOSSIER } from '../../server/extensionsNoeuds.js'
// 9 October 2026 08:08 CEST: Keep the builders aligned with every registered node suffix and legacy field.
// C210b builds type-aware trees; the exhaustive suffix contract is tested against server/extensionsNoeuds.js.
import { typeOfPath, stripLeafExt, legacyFlags } from './node.js'

// Marqueur d'un DOSSIER VIDE persistant : `<dir>/.zrfolder.json`. Un dossier sans aucun nœud (ni sous-nœud)
// n'existe pas en Git tout seul (Git ne suit pas les dossiers vides) ; ce fichier sentinelle le matérialise.
// Il ne doit JAMAIS apparaître comme une entrée fichier : il prouve seulement l'existence de SON dossier parent.
// SOURCE UNIQUE (2026-08-31). Cette liste oubliait `.zrmusic.json` : un dossier « bibliotheque
// musicale » marque par lui seul n etait donc pas reconnu comme un dossier, et son marqueur
// s affichait comme un faux fichier. `MARQUEURS_DOSSIER` vit dans server/extensionsNoeuds.js, qui
// est du JS pur sans dependance serveur ; un test compare les deux listes et rougit si elles
// divergent. Le slash de tete est ajoute ici, parce que ce fichier compare des SUFFIXES de chemin.
const FOLDER_MARKERS = MARQUEURS_DOSSIER.map((m) => '/' + m)
const folderMarkerOf = (p) => FOLDER_MARKERS.find((marker) => p.endsWith(marker)) || ''
const isFolderMarker = (p) => !!folderMarkerOf(p)
// Sidecars de STREAMING (DASH/HLS) : playlists .m3u8/.mpd + clé .hlskey.bin. Ils vivent À PLAT à côté du
// manifeste .media.json (la vidéo) mais ne doivent JAMAIS apparaître comme des nœuds : seul le .media.json
// est la vidéo affichée. Les ignorer évite à la fois le dossier parasite et les fichiers parasites.
const isStreamSidecar = (p) => /\.(m3u8|mpd)$/i.test(p) || p.endsWith('.hlskey.bin')
const folderOfMarker = (p) => p.slice(0, -folderMarkerOf(p).length) // '<...>/Foo/.zrfolder.json' -> '<...>/Foo'

// Arbre Notion : X (contenu) et le dossier X/ fusionnés sous le même nom. node.type = type du contentPath.
export function buildTree(paths) {
  const root = { name: '', children: {}, contentPath: null, type: 'folder' }
  for (const p of paths) {
    if (isStreamSidecar(p)) continue // playlists/clé de streaming : jamais des nœuds
    // Marqueur de dossier vide : on crée seulement la chaîne de dossiers, sans nœud-feuille.
    const marker = isFolderMarker(p)
    const base = marker ? folderOfMarker(p) : p
    const stripped = (marker ? base : stripLeafExt(base)).replace(/^pages\//, '')
    if (!stripped) continue
    const segs = stripped.split('/')
    let node = root
    segs.forEach((seg, i) => {
      node.children[seg] = node.children[seg] || { name: seg, children: {}, contentPath: null, type: 'folder' }
      node = node.children[seg]
      if (!marker && i === segs.length - 1) { node.contentPath = p; node.type = typeOfPath(p) }
    })
  }
  return root
}

// Entrées directement sous `dir`, fusionnant page (X.md) + dossier (X/) + bases/médias (X.db.json…) sous le même nom.
export function entriesOf(paths, dir) {
  const prefix = dir.endsWith('/') ? dir : dir + '/'
  const map = {}
  for (const p of (paths || [])) {
    if (!p.startsWith(prefix)) continue
    if (isStreamSidecar(p)) continue // playlists/clé de streaming : jamais des nœuds
    // Marqueur de dossier vide : établit l'EXISTENCE d'un dossier, jamais une entrée fichier.
    if (isFolderMarker(p)) {
      const rel = folderOfMarker(p).slice(prefix.length) // '' = marqueur du dossier courant lui-même
      if (!rel) continue
      const seg = rel.split('/')[0]
      map[seg] = map[seg] || { name: seg, contentPath: null, hasKids: false, dir: prefix + seg, type: 'folder', isDb: false, isMedia: false, isImage: false }
      if (rel.indexOf('/') !== -1) map[seg].hasKids = true
      continue
    }
    const rest = stripLeafExt(p.slice(prefix.length))
    if (!rest) continue
    const seg = rest.split('/')[0]
    const isLeaf = rest.indexOf('/') === -1
    map[seg] = map[seg] || { name: seg, contentPath: null, hasKids: false, dir: prefix + seg, type: 'folder', isDb: false, isMedia: false, isImage: false }
    if (isLeaf) {
      const type = typeOfPath(p)
      map[seg].contentPath = p
      map[seg].type = type
      Object.assign(map[seg], legacyFlags(type))
    } else {
      map[seg].hasKids = true
    }
  }
  return Object.values(map).sort((a, b) => a.name.localeCompare(b.name))
}
