import React, { useEffect, useMemo, useState } from 'react'
import SpinnerApple from '../components/SpinnerApple.jsx'
import { getIndexPaths, loadSearchIndex } from '../search/searchIndexClient.js'
import { isCreateMediaPath, PLAN_ATTACHMENTS } from './planAttachments.js'

// Search the existing index, then read only the file the user selects. (19 October 2026, 01:08 Paris)
export default function PlanCreatePicker({ onPick, disabled }) {
  const [query, setQuery] = useState('')
  const [path, setPath] = useState('')
  const [mode, setMode] = useState('auto')
  const [entries, setEntries] = useState([])
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState('')
  useEffect(() => {
    let live = true
    loadSearchIndex().then(() => {
      if (live) setEntries(getIndexPaths().filter(isCreateMediaPath).map((path) => ({ path, name: path.split('/').pop().replace(/\.(?:media|img)\.json$/, ''), key: path.toLowerCase() })))
    }).catch((cause) => { if (live) setError(`Create index unavailable: ${cause.message}. You can paste a path below.`) })
      .finally(() => { if (live) setLoading(false) })
    return () => { live = false }
  }, [])
  const results = useMemo(() => {
    const needle = query.trim().toLowerCase(), found = []
    if (!needle) return found
    for (const entry of entries) {
      if (!entry.key.includes(needle)) continue
      found.push(entry)
      if (found.length === PLAN_ATTACHMENTS.pickerMax) break
    }
    return found
  }, [entries, query])
  return <div className="zrp-create-picker" aria-label="Create attachments">
    <label>Calendar link
      <select aria-label="Calendar link mode" value={mode} disabled={disabled} onChange={(event) => setMode(event.target.value)}>
        <option value="auto">Shared view for films and images</option>
        <option value="download">Download file</option>
      </select>
    </label>
    <input className="zrp-input" aria-label="Search Create files" placeholder="Search Create…" value={query} onChange={(event) => setQuery(event.target.value)} />
    {loading && <SpinnerApple titre="Loading Create files" />}
    {error && <div role="alert">{error}</div>}
    {query && !loading && !results.length && <small>No matching media. Paste its Create path below.</small>}
    <div className="zrp-create-picker-results">
      {results.map((entry) => <button type="button" className="zrp-menu-item" key={entry.path} disabled={disabled} title={entry.path} onClick={() => onPick(entry.path, mode)}>{entry.name}</button>)}
    </div>
    <input className="zrp-input" aria-label="Create file path" placeholder="pages/…/file.media.json" value={path} onChange={(event) => setPath(event.target.value)}
      onKeyDown={(event) => { if (event.key === 'Enter') { event.preventDefault(); event.stopPropagation(); if (path.trim()) onPick(path.trim(), mode) } }} />
    <button type="button" className="zrp-meta-chip" disabled={disabled || !path.trim()} onClick={() => onPick(path.trim(), mode)}>Link this Create file</button>
    <small>Existing files stay in Create. Films open in their shared player; other files download.</small>
  </div>
}
