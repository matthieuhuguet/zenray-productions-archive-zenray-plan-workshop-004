// ═══ POURQUOI CE MODULE SE TESTE, ET NE PEUT PAS SE VÉRIFIER À L'ŒIL ═════════════════════════════
//
// Il repose entièrement sur `requestAnimationFrame`, or le volet d'inspection du navigateur tourne avec
// `document.visibilityState` à « hidden », état dans lequel Chrome SUSPEND les rappels d'animation.
// Regarder l'écran n'y prouve donc rien : on verrait une page immobile aussi bien si le code marchait
// que s'il ne faisait rien du tout. En pilotant le temps et les images nous-mêmes, on lit la courbe
// réelle, image par image, ce qu'aucun œil ne saurait faire de toute façon.
//
// Deux vues dépendent maintenant de ce fichier, le Finder de Create et le retour au jour courant du
// Plan. Une régression ici les casserait toutes les deux en silence : le défilement continuerait de
// fonctionner, il changerait seulement de caractère, et personne ne saurait dire quand.
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
import { scrollAnimeVers, cibleCentree, DUREE_SCROLL } from './scrollAnime.js'

let temps = 0
let images = []

const fauxScroller = (scrollTop = 0, clientHeight = 500, scrollHeight = 5000) => ({
  scrollTop, clientHeight, scrollHeight,
  getBoundingClientRect: () => ({ top: 0, height: clientHeight }),
})

// On joue les images à la main : chaque appel avance l'horloge et exécute les rappels en attente.
const jouerImage = (ms) => {
  temps += ms
  const aJouer = images
  images = []
  aJouer.forEach((f) => f(temps))
}

describe('cibleCentree', () => {
  it('place l\'élément au centre exact de la zone visible', () => {
    const sc = fauxScroller(1000, 500, 5000)
    // Un élément de 100 px dont le haut est à 300 px du haut de la zone : pour le centrer il faut
    // amener son haut à (500 - 100) / 2 = 200, donc défiler de 100 px de plus.
    const el = { getBoundingClientRect: () => ({ top: 300, height: 100 }) }
    expect(cibleCentree(sc, el)).toBe(1100)
  })

  it('ne défile jamais au-delà de ce qui existe, dans les deux sens', () => {
    const hautDeTout = fauxScroller(0, 500, 5000)
    expect(cibleCentree(hautDeTout, { getBoundingClientRect: () => ({ top: 0, height: 100 }) })).toBe(0)
    const basDeTout = fauxScroller(4400, 500, 5000)
    expect(cibleCentree(basDeTout, { getBoundingClientRect: () => ({ top: 480, height: 100 }) })).toBe(4500)
  })
})

describe('scrollAnimeVers', () => {
  beforeEach(() => {
    temps = 0
    images = []
    vi.stubGlobal('requestAnimationFrame', (f) => { images.push(f); return images.length })
    vi.stubGlobal('cancelAnimationFrame', vi.fn())
    vi.stubGlobal('performance', { now: () => temps })
    vi.stubGlobal('matchMedia', () => ({ matches: false }))
  })
  afterEach(() => vi.unstubAllGlobals())

  it('suit un EaseOutExpo exact et atterrit PILE sur la cible', () => {
    const sc = fauxScroller(0)
    const ref = { current: 0 }
    scrollAnimeVers(sc, 1000, ref)

    // À la moitié du temps, un EaseOutExpo a déjà parcouru 1 - 2^-5, soit environ 96,9 %. C'est ce
    // départ brutal puis cette longue arrivée qui font tout le caractère de la courbe : une courbe
    // symétrique serait à 50 % ici, et le déplacement se lirait comme un ascenseur.
    jouerImage(DUREE_SCROLL / 2)
    expect(sc.scrollTop).toBeCloseTo(1000 * (1 - Math.pow(2, -5)), 5)
    expect(sc.scrollTop / 1000).toBeGreaterThan(0.96)

    jouerImage(DUREE_SCROLL / 2)
    // La dernière image force la valeur exacte : `1 - 2^-10` vaut 0,999 et non 1, si bien qu'un
    // atterrissage laissé à la formule s'arrêterait à un pixel de la cible, indéfiniment.
    expect(sc.scrollTop).toBe(1000)
    expect(ref.current).toBe(0)     // l'animation se déclare finie plutôt que de tourner à vide
  })

  it('remonte aussi bien qu\'il descend', () => {
    const sc = fauxScroller(2000)
    const ref = { current: 0 }
    scrollAnimeVers(sc, 500, ref)
    jouerImage(DUREE_SCROLL)
    expect(sc.scrollTop).toBe(500)
  })

  it('annule l\'animation en cours au lieu de lutter contre elle', () => {
    const sc = fauxScroller(0)
    const ref = { current: 0 }
    scrollAnimeVers(sc, 1000, ref)
    jouerImage(60)
    const enChemin = sc.scrollTop
    expect(enChemin).toBeGreaterThan(0)
    expect(enChemin).toBeLessThan(1000)

    scrollAnimeVers(sc, 200, ref)   // nouvelle demande : la précédente doit être abandonnée
    expect(cancelAnimationFrame).toHaveBeenCalled()
    jouerImage(DUREE_SCROLL)
    // Deux animations vivantes écriraient tour à tour dans la même propriété et le défilement
    // tremblerait ; une seule reste, donc on arrive exactement sur la NOUVELLE cible.
    expect(sc.scrollTop).toBe(200)
  })

  it('saute directement à la cible quand le système demande moins d\'animation', () => {
    vi.stubGlobal('matchMedia', () => ({ matches: true }))
    const sc = fauxScroller(0)
    const ref = { current: 0 }
    scrollAnimeVers(sc, 1000, ref)
    expect(sc.scrollTop).toBe(1000)   // on arrive au même endroit, sans le trajet
    expect(images).toHaveLength(0)    // et sans demander une seule image
  })
})
