const WEEKDAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday']

export function planDayLabel(selectedIso, todayIso) {
  if (selectedIso === todayIso) return 'Today'
  const [year, month, day] = String(selectedIso || '').split('-').map(Number)
  const date = new Date(year, (month || 1) - 1, day || 1)
  return WEEKDAY_NAMES[date.getDay()]
}

export function planDateDirection(nextIso, previousIso) {
  if (nextIso === previousIso) return 'still'
  return nextIso < previousIso ? 'backward' : 'forward'
}

// Tile time and bare title (23 October 2026, 17:10 Paris). The time is computed from startTime and durationMin; a range already written in the title is removed, so it never shows twice.
// FR : heure de tuile calculée et titre nu ; une plage déjà écrite dans le titre est retirée, jamais affichée deux fois.
const TIME_PREFIX = /^\d{1,2}:\d{2}\s*[-–]\s*\d{1,2}:\d{2}\s*·\s*/
const hhmm = (min) => `${String(Math.floor(min / 60) % 24).padStart(2, '0')}:${String(min % 60).padStart(2, '0')}`
export const planTileBareTitle = (task) => String(task?.title || '').replace(TIME_PREFIX, '')
export function planTileTime(task, config = PLAN_UI.tileTime) {
  const m = /^(\d{1,2}):(\d{2})$/.exec(task?.startTime || '')
  if (!config.show || !m) return ''
  const start = Number(m[1]) * 60 + Number(m[2])
  return `${hhmm(start)}${config.separator}${hhmm(start + Math.max(0, Number(task.durationMin) || 0))}`
}
export function planTileTitle(task, config = PLAN_UI.tileTime) {
  const time = planTileTime(task, config)
  return time ? `${time}${config.join}${planTileBareTitle(task)}` : planTileBareTitle(task)
}
