// THE GUEST UPLOADER, PLATFORM-FREE (2 October 2026). It decides WHAT to send and WHEN; everything that touches a platform is injected
// (`adapters`: hashing, thumbnail, blob slicing, the HTTP call, timers, the network state), so the very same code runs in the browser
// (src/guest/browserAdapters.js), in tests against the real server logic with a fake GitHub, and in the simulation script.
//
// THE PROMISE TO THE GUEST: a photo never fails in front of them. Whatever goes wrong (network, GitHub, a busy server, a rate limit), the
// uploader waits and tries again, with growing pauses and a smaller batch, until it works. The only things that stop it are polite and
// final: the daily cap, a link that no longer accepts photos, a file that is not an image. None of them is an error message.
//
// HOW A BATCH SHRINKS. After SPLIT_AFTER_FAILURES failures a batch of several photos is cut in halves; a big photo's next chunk is halved
// (down to MIN_PART_BYTES). Photos above PART_BYTES travel one chunk per request; the server returns signed receipts for the chunks it
// has stored and the final request cites them, so a retry never re-sends a chunk that is already safe.
import { GUEST } from '../config/guestUpload.js'
import { packFrame } from '../lib/guestFrame.js'
import { cleanGuestName, cleanSubPath, splitImageName } from '../lib/guestNames.js'

let seq = 0
const newPid = () => `p${Date.now().toString(36)}${(++seq).toString(36)}${Math.floor(Math.random() * 1e6).toString(36)}`.slice(0, 40)

export function createGuestUploader({ token, adapters, onChange = () => {}, config = GUEST }) {
  const A = adapters
  const sleep = A.sleep || ((ms) => new Promise((r) => setTimeout(r, ms)))
  const items = new Map()                 // id -> item
  const order = []                        // ids in arrival order
  let name = ''
  let sub = ''
  let folder = ''                         // the folder name the server actually used (it may add « (invité) »)
  let notice = null                       // null | 'daily' | 'link' | 'offline' | 'waiting'
  let noticeUntil = 0
  let running = false
  let stopped = false
  let loopPromise = null
  let preparing = 0
  let batchCap = config.REQUEST_PHOTOS         // photos per request; halves after repeated failures, doubles back after successes
  const stats = { requests: 0, failures: 0, splits: 0 }

  const emit = () => { try { onChange(snapshot()) } catch { /* a UI error must never stop an upload */ } }
  const setNotice = (n, until = 0) => { notice = n; noticeUntil = until; emit() }

  function snapshot() {
    const list = order.map((id) => items.get(id)).filter(Boolean)
    const count = (f) => list.filter(f).length
    return {
      items: list.map((it) => ({ id: it.id, tag: it.tag || null, file: it.file, name: it.display, size: it.size, status: it.status, progress: it.progress, path: it.path || null, sub: it.sub, reason: it.reason || null })),
      counts: { total: list.length, done: count((i) => i.status === 'done'), skipped: count((i) => i.status === 'skipped'), active: count((i) => i.status === 'sending' || i.status === 'preparing'), waiting: count((i) => ['queued', 'ready'].includes(i.status)) },
      notice, noticeUntil, folder, name, sub, running, idle: !running, /* nothing is being sent: finished, or stopped politely (daily cap, link no longer accepting photos) */ stats: { ...stats },
    }
  }

  // ── adding files ───────────────────────────────────────────────────────────────────────────────
  function add(entries) {
    let added = 0
    for (const e of entries) {
      const file = e.file || e
      const rel = e.rel != null ? e.rel : (file.webkitRelativePath || '')
      const nm = splitImageName(file.name)
      const relDirs = rel && rel.includes('/') ? rel.split('/').slice(0, -1) : []
      const itemSub = cleanSubPath([...(sub ? sub.split('/') : []), ...relDirs])
      const key = `${file.name}|${file.size}|${file.lastModified || 0}|${itemSub}`
      const tag = e.tag || null
      if (!nm) { const id = newPid(); items.set(id, { id, tag, file, display: file.name, size: file.size || 0, status: 'skipped', reason: 'type', progress: 0, sub: itemSub, key }); order.push(id); continue }
      if ([...items.values()].some((x) => x.key === key && x.status !== 'skipped')) continue    // the same file picked twice
      if (file.size > config.MAX_PHOTO_BYTES) { const id = newPid(); items.set(id, { id, tag, file, display: nm.display, size: file.size, status: 'skipped', reason: 'size', progress: 0, sub: itemSub, key }); order.push(id); continue }
      const id = newPid()
      items.set(id, { id, tag, file, display: nm.display, size: file.size, status: 'queued', progress: 0, sub: itemSub, key, pid: id, offset: 0, idx: 0, receipts: [], partBytes: config.PART_BYTES, tries: 0 })
      order.push(id); added++
    }
    emit()
    if (added) { pumpPrepare(); start() }
    return added
  }

  // ── preparing: hash + thumbnail ────────────────────────────────────────────────────────────
  async function prepare(it) {
    it.status = 'preparing'; emit()
    try {
      const buf = await A.readBlob(it.file, 0, it.file.size)
      it.hash = await A.hashBytes(buf)
      if (A.seen && A.seen(it.hash)) { it.status = 'done'; it.progress = 1; emit(); return }   // already uploaded in an earlier visit
      const th = await A.makeThumb(it.file).catch(() => null)
      it.thumb = th && th.bytes ? th : null
      it.grid = th && th.grid && th.grid.bytes ? th.grid : null
      it.w = (th && th.w) || 0; it.h = (th && th.h) || 0
      it.status = 'ready'
    } catch {
      it.status = 'queued'; it.tries = (it.tries || 0) + 1
      if (it.tries > 4) { it.status = 'skipped'; it.reason = 'unreadable' }
    }
    emit()
  }

  // One photo is prepared at a time (a big photo is read whole to hash it), always one ahead of the one being sent.
  function pumpPrepare() {
    if (stopped || preparing >= 1) return
    const next = order.map((id) => items.get(id)).find((it) => it && it.status === 'queued')
    if (!next) return
    preparing++
    prepare(next).finally(() => { preparing--; if (!stopped) { pumpPrepare(); kick() } })
  }

  // ── building a request ───────────────────────────────────────────────────────────────────────
  // Small photos travel together (up to REQUEST_BYTES / REQUEST_PHOTOS, same destination folder); a big photo travels alone, one chunk at a time.
  async function nextRequest() {
    const ready = order.map((id) => items.get(id)).filter((it) => it && it.status === 'ready')
    if (!ready.length) return null
    const first = ready[0]
    const header = { v: 1, d: token, name, sub: first.sub, op: 'put', shard: first.shard || null, parts: [], photos: [] }
    const payloads = []
    const members = []
    const addPhoto = async (it, partLen) => {
      const final = it.offset + partLen >= it.size
      const meta = { pid: it.pid, name: it.display, size: it.size, hash: it.hash, w: it.w, h: it.h, thumbW: it.thumb ? it.thumb.thumbW : 0, thumbH: it.thumb ? it.thumb.thumbH : 0, thumbSW: it.grid ? it.grid.thumbSW : 0, thumbSH: it.grid ? it.grid.thumbSH : 0, nChunks: final ? it.idx + 1 : it.idx + 2, finalize: final, receipts: it.receipts }
      header.photos.push(meta)
      const chunk = await A.readBlob(it.file, it.offset, it.offset + partLen)
      header.parts.push({ pid: it.pid, role: 'chunk', idx: it.idx, len: chunk.byteLength }); payloads.push(chunk)
      if (it.idx === 0 && it.thumb) { header.parts.push({ pid: it.pid, role: 'thumb', idx: 0, len: it.thumb.bytes.byteLength }); payloads.push(it.thumb.bytes) }
      if (it.idx === 0 && it.grid) { header.parts.push({ pid: it.pid, role: 'thumbs', idx: 0, len: it.grid.bytes.byteLength }); payloads.push(it.grid.bytes) }
      members.push({ it, partLen, final })
    }
    if (first.size > first.partBytes || first.offset > 0 || first.idx > 0) {
      await addPhoto(first, Math.min(first.partBytes, first.size - first.offset))
    } else {
      let bytes = 0
      for (const it of ready) {
        if (it.sub !== first.sub || it.size > it.partBytes || it.offset > 0) continue
        const cost = it.size + (it.thumb ? it.thumb.bytes.byteLength : 0) + (it.grid ? it.grid.bytes.byteLength : 0)
        if (members.length && (bytes + cost > config.REQUEST_BYTES || members.length >= batchCap)) break
        await addPhoto(it, it.size); bytes += cost
      }
    }
    const shardOf = members.map((m) => m.it.shard).find(Boolean)
    header.shard = shardOf || null
    return { frame: packFrame(header, payloads), members, bytes: payloads.reduce((n, p) => n + p.byteLength, 0) }
  }

  // ── applying a reply ──────────────────────────────────────────────────────────────────────────
  function apply(reply, members) {
    if (reply.folder) folder = reply.folder
    const byPid = new Map((reply.results || []).map((r) => [r.pid, r]))
    for (const m of members) {
      const it = m.it
      const r = byPid.get(it.pid)
      if (!r) { it.status = 'ready'; continue }
      it.status = 'ready'
      if (r.status === 'added' || r.status === 'exists') { it.status = 'done'; it.progress = 1; it.path = r.path; if (A.remember) A.remember(it.hash) }
      else if (r.status === 'part') {
        it.receipts = [...it.receipts, ...(r.receipts || []).filter((x) => x.role === 'chunk' || x.role === 'thumb' || x.role === 'thumbs')]
        it.shard = reply.shard || it.shard
        it.offset += m.partLen; it.idx += 1; it.progress = Math.min(0.99, it.offset / it.size)
        if (m.final) { it.offset = 0; it.idx = 0; it.receipts = [] }   // the server said « part » on the last chunk: start again cleanly
      } else if (r.status === 'incomplete') { it.offset = 0; it.idx = 0; it.receipts = []; it.shard = null }
      else if (r.status === 'rejected') { it.status = 'skipped'; it.reason = r.reason || 'bad' }
    }
    emit()
  }

  // ── sending one request, retrying until it goes through ─────────────────────────────────────
  async function sendWithRetry(req) {
    let failures = 0
    for (;;) {
      if (stopped) return null
      if (A.isOnline && !A.isOnline()) { setNotice('offline'); await (A.waitOnline ? A.waitOnline(8000) : sleep(2000)); if (stopped) return null; continue }
      let reply = null
      try {
        stats.requests++
        for (const m of req.members) { m.it.status = 'sending' }
        emit()
        reply = await A.send(req.frame, { onProgress: (f) => { for (const m of req.members) m.it.progress = Math.max(m.it.progress, Math.min(0.99, (m.it.offset + m.partLen * f) / m.it.size)); emit() } })
      } catch { reply = null }
      if (reply && reply.ok) { if (notice === 'offline' || notice === 'waiting') setNotice(null); return reply }
      if (reply && reply.ok === false && reply.retry === false) return reply     // a polite, final stop
      failures++; stats.failures++
      const wait = Math.max(reply && reply.waitMs ? reply.waitMs : 0, config.BACKOFF_MS[Math.min(failures - 1, config.BACKOFF_MS.length - 1)])
      if (failures >= config.SPLIT_AFTER_FAILURES && shrink(req)) return { shrunk: true }
      if (failures >= 3) setNotice('waiting')
      for (const m of req.members) m.it.status = 'ready'
      emit()
      await sleep(wait + Math.floor(Math.random() * wait * 0.25))
    }
  }

  // Cut the batch in halves, or halve the chunk of a big photo. Returns true when something got smaller (the caller rebuilds the request).
  function shrink(req) {
    for (const m of req.members) m.it.status = 'ready'
    if (req.members.length > 1) { batchCap = Math.max(1, Math.floor(req.members.length / 2)); stats.splits++; return true }
    const it = req.members[0].it
    if (it.partBytes > config.MIN_PART_BYTES) { it.partBytes = Math.max(config.MIN_PART_BYTES, Math.floor(it.partBytes / 2)); stats.splits++; return true }
    return false
  }

  // ── the loop ────────────────────────────────────────────────────────────────────────────────
  async function loop() {
    running = true; emit()
    try {
      while (!stopped) {
        pumpPrepare()
        const req = await nextRequest()
        if (!req) {
          if (order.some((id) => ['queued', 'preparing'].includes(items.get(id) && items.get(id).status))) { await waitKick(); continue }
          break
        }
        let reply = await sendWithRetry(req)
        if (!reply) break
        if (reply.shrunk) continue
        if (reply.ok === false) {
          for (const m of req.members) m.it.status = 'ready'
          if (reply.reason === 'daily') { setNotice('daily', Date.now() + (reply.waitMs || 0)); break }
          if (reply.reason === 'invalid-link' || reply.reason === 'disabled') { setNotice('link'); break }
          if (reply.reason === 'bad-request') { for (const m of req.members) { m.it.status = 'skipped'; m.it.reason = 'bad' } emit(); continue }
          await sleep(3000); continue
        }
        apply(reply, req.members)
        batchCap = Math.min(config.REQUEST_PHOTOS, batchCap * 2)
        if (reply.day && reply.day.used >= reply.day.max) { setNotice('daily', Date.now() + 60_000); break }
      }
    } finally { running = false; emit() }
  }

  let kickResolve = null
  const waitKick = () => new Promise((r) => { kickResolve = r; setTimeout(r, 400) })
  const kick = () => { if (kickResolve) { const r = kickResolve; kickResolve = null; r() } }

  function start() {
    if (stopped || !name) return null           // nothing is sent before the guest has told us who they are
    if (running && loopPromise) { kick(); return loopPromise }
    if (notice === 'daily' && noticeUntil > Date.now()) return null
    if (notice === 'daily' || notice === 'link') setNotice(null)
    loopPromise = loop().finally(() => { loopPromise = null })
    return loopPromise
  }

  /** Creates a sub-folder in the guest's space (retried like everything else). */
  async function createFolder(subName) {
    const target = cleanSubPath([...(sub ? sub.split('/') : []), subName])
    if (!target) return null
    const header = { v: 1, d: token, name, sub: target, op: 'mkdir', parts: [], photos: [] }
    const req = { frame: packFrame(header, []), members: [] }
    const reply = await sendWithRetry(req)
    if (reply && reply.ok) { if (reply.folder) folder = reply.folder; emit(); return target }
    return null
  }

  return {
    add, start, createFolder, snapshot,
    setName(n) { name = cleanGuestName(n); emit(); if (order.length) { pumpPrepare(); start() } },
    setSub(s) { sub = cleanSubPath(s); emit() },
    getName: () => name,
    stop() { stopped = true; kick() },
    resume() { stopped = false; if (notice === 'daily' || notice === 'link') setNotice(null); return start() },
    idle: () => (loopPromise ? loopPromise : Promise.resolve()),
  }
}
