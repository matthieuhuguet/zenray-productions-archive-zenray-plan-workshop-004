}
let shard = null, shardDir = null, shardBytes = 0, sincePush = 0, pending = []  // pending: [{v, base, dest, segMap{name->shardPath}, init, segs(localnames), duration, vcodec, acodec}]
const PUSH_CHUNK = 150 * 1024 * 1024 // pousse tous les ~150 Mo (RAM git bornée ~170 Mo, mesuré)

async function openShard() {
  shardNum = shardNum ? shardNum + 1 : nextFreeShard()
  shard = `zenray-vid-public-${String(shardNum).padStart(2, '0')}`
  shardDir = path.join(WORK, shard)
  await rm(shardDir, { recursive: true, force: true }); await mkdir(shardDir, { recursive: true })
  git(shardDir, ['init', '-q']); git(shardDir, ['branch', '-M', 'main'])
  // ANTI-RAM (vidéo déjà compressée = delta inutile et coûteux) : git ne doit NI deltifier NI zlib-compresser.
  // ANTI-RAM CRITIQUE : gc.auto 0 (l'auto-gc repack TOUT le repo en RAM = 40 Go observés) + zéro delta/compression.
  for (const [k, v] of [['user.email', 'bot@zenray'], ['user.name', 'zenray-bot'],
    ['gc.auto', '0'], ['gc.autoDetach', 'false'], ['maintenance.auto', 'false'],
    ['core.bigFileThreshold', '1m'], ['core.compression', '0'], ['core.looseCompression', '0'], ['pack.compression', '0'],
    ['pack.window', '0'], ['pack.depth', '0'], ['pack.threads', '1'], ['pack.windowMemory', '32m'],
    // http.version HTTP/1.1 (2026-06-10) : sur certains réseaux (nouveau wifi), le HTTP/2 par défaut de git CASSE
    // les gros pushes (erreur 500 + « unexpected disconnect while reading sideband packet »), alors que les petits
    // passent. Testé : un push de 144 Mo échoue en HTTP/2, réussit en HTTP/1.1. postBuffer monté à 512 Mo.
    ['pack.deltaCacheSize', '1m'], ['http.postBuffer', '524288000'], ['http.version', 'HTTP/1.1']]) git(shardDir, ['config', k, v])
  await writeFile(path.join(shardDir, 'README.md'), `# ${shard}\nZenRay drive — shard vidéo public (segments fMP4/CMAF, hashés, servis via jsDelivr).\n`)
  // créer le repo distant VIDE + établir origin avec le commit README (push minuscule)
  // ROBUSTE : un 401/timeout transitoire de l'API GitHub (auth gh momentanément KO) ne doit PLUS tuer toute la
  // migration. On retente la création 5× avec backoff ; un « already exists » = succès ; sinon fallback REST direct
  // (POST /user/repos) qui n'utilise pas GraphQL. N'échoue qu'après épuisement de toutes les voies.
  const repoExists = () => spawnSync('gh', ['repo', 'view', `${OWNER}/${shard}`, '--json', 'name'], { encoding: 'utf8' }).status === 0
  let created = false
  for (let attempt = 1; attempt <= 5 && !created; attempt++) {
    const r = spawnSync('gh', ['repo', 'create', `${OWNER}/${shard}`, '--public', '-d', 'ZenRay drive — shard vidéo public (fMP4/jsDelivr)'], { encoding: 'utf8' })
    if (r.status === 0 || /already exists|Name already/i.test((r.stderr || '') + (r.stdout || ''))) { created = true; break }
    // fallback REST (pas de GraphQL) avec le token capturé
    const rest = spawnSync('curl', ['-s', '-o', '/dev/null', '-w', '%{http_code}', '-X', 'POST', '-H', `Authorization: Bearer ${TOKEN}`, 'https://api.github.com/user/repos', '-d', JSON.stringify({ name: shard, private: false, description: 'ZenRay drive — shard vidéo public (fMP4/jsDelivr)' })], { encoding: 'utf8' })
    if (/^(201|422)$/.test((rest.stdout || '').trim()) || repoExists()) { created = true; break }
    console.error(`repo create tentative ${attempt}/5 échec (${shard}):`, ((r.stderr || '').slice(0, 100)) + ' | REST ' + (rest.stdout || ''))
    await sleep(3000 * attempt)
  }
  if (!created) { console.error('repo create épuisé', shard); throw new Error('repo-create') }
  await sleep(1500)
  git(shardDir, ['add', '-A']); git(shardDir, ['commit', '-q', '-m', 'init'])
  git(shardDir, ['remote', 'add', 'origin', `https://x-access-token:${TOKEN}@github.com/${OWNER}/${shard}.git`])
  git(shardDir, ['push', '-q', 'origin', 'HEAD:main'], 120000)
  if (!prog.shards.includes(shard)) prog.shards.push(shard)
  shardBytes = 0; sincePush = 0; pending = []
  console.log(`\n>>> SHARD ${shard} ouvert (remote créé, push incrémental 150 Mo)`)
}

// PUSH INCRÉMENTAL : commit + push ce qui s'est accumulé (~150 Mo) -> pack petit -> RAM ~170 Mo (mesuré).
// Jamais un gros pack d'un coup (git deltifie/repack en RAM = explose). Retour false si push échoue.
async function pushChunk() {
  const st = git(shardDir, ['status', '--porcelain'])
  if (!st.stdout.trim()) return true
  git(shardDir, ['add', '-A']); git(shardDir, ['commit', '-q', '-m', `+segments`])
  for (let a = 0; a < 4; a++) { const ps = git(shardDir, ['push', '-q', 'origin', 'HEAD:main'], 300000); if (ps.status === 0) { sincePush = 0; return true } console.error(`  push retry ${a + 1}/4`, (ps.stderr || '').slice(-140)); await sleep(3000 * (a + 1)) }
  return false
}

async function flushShard() {
  if (!pending.length) return
  // push final de ce qui reste, puis on fige le commit
  if (!await pushChunk()) { console.error('PUSH FINAL ÉCHEC — sources conservées', shard); for (const p of pending) prog.failed.push({ id: p.v.id, name: p.v.name, reason: 'push-shard' }); await save(); pending = []; return }
  const commit = git(shardDir, ['rev-parse', 'HEAD']).stdout.trim()
  console.log(`  ✓ shard ${shard} poussé (commit ${commit.slice(0, 7)}, ${(shardBytes / 1073741824).toFixed(2)} Go, ${pending.length} vidéos)`)

  // 2) manifestes + playlists -> zenray-data (1 commit inline)
  const jsd = (sp) => `https://cdn.jsdelivr.net/gh/${OWNER}/${shard}@${commit}/${sp}`
  const textBlobs = []
  for (const p of pending) {
    // réécrit la playlist (gardée en RAM) avec les URLs jsDelivr finales
    let pl = p.plRaw.split('\n').map((line) => {
      const mm = line.match(/^#EXT-X-MAP:URI="([^"]+)"/); if (mm) return line.replace(mm[1], jsd(p.segMap['init.mp4']))
      const t = line.trim(); if (/^seg_\d+\.m4s$/.test(t)) return jsd(p.segMap[t]); return line
    }).join('\n')
    const baseDir = `${p.dest}/${p.base}`
    const masterPath = `${baseDir}/master.m3u8`, mediaPath = `${baseDir}/stream.m3u8`
    const master = `#EXTM3U\n#EXT-X-VERSION:7\n#EXT-X-STREAM-INF:BANDWIDTH=6000000,CODECS="${p.vcodec === 'vp9' ? 'vp09.00.50.08' : 'avc1.640028'}"\n/api/hls?path=${encodeURIComponent(mediaPath)}\n`
    const manifest = { type: 'hls', v: 1, name: `${p.base}.mp4`, mime: 'application/vnd.apple.mpegurl', duration: p.duration, master: masterPath, enc: 'none', container: 'fmp4', vcodec: p.vcodec, acodec: p.acodec, publicRepo: shard, commitPublic: commit, segments: p.segs.length, count: p.segs.length, size: p.bytes, createdAt: new Date().toISOString() }
    textBlobs.push({ path: mediaPath, content: pl }, { path: masterPath, content: master }, { path: `${baseDir}/${p.base}.mp4.media.json`, content: JSON.stringify(manifest, null, 2) })
    p.firstSegUrl = jsd(p.segMap[p.segs[0]]); p.mfPath = `${baseDir}/${p.base}.mp4.media.json`
  }
  let ok = true
  for (let i = 0; i < textBlobs.length; i += 600) { if (!await commitInline(DATA, textBlobs.slice(i, i + 600), `vidéos fMP4 ${shard}`)) { ok = false; break } }
  if (!ok) { console.error('MANIFESTES ÉCHEC — sources conservées'); for (const p of pending) prog.failed.push({ id: p.v.id, name: p.v.name, reason: 'manifest' }); await save(); pending = []; return }

  // 3) VÉRIF RAPIDE = le segment est-il sur GITHUB (raw) ? (vérité backup ; jsDelivr ne fait que servir
  //    plus tard, cold cache lent). En PARALLÈLE ×16 -> ~3 s au lieu de 30 min. 200 raw -> purge sûre.
  const rawOf = (u) => u.replace(/^https:\/\/cdn\.jsdelivr\.net\/gh\/([^/]+)\/([^@]+)@([^/]+)\//, 'https://raw.githubusercontent.com/$1/$2/$3/')
  let vi = 0
  const verdicts = new Array(pending.length)
  await Promise.all(Array.from({ length: 16 }, async () => {
    while (vi < pending.length) { const k = vi++; const p = pending[k]
      let code = 0; for (let i = 0; i < 3 && code !== 200; i++) { code = await headStatus(rawOf(p.firstSegUrl), true); if (code !== 200) await sleep(1000) }
      verdicts[k] = code }
  }))
  for (let k = 0; k < pending.length; k++) {
    const p = pending[k]
    if (verdicts[k] !== 200) { console.error(`  vérif KO (${verdicts[k]}) ${p.base} — source conservée`); prog.failed.push({ id: p.v.id, name: p.v.name, reason: 'verify-' + verdicts[k] }); continue }
    try {
      await rm(path.join(LIB, 'images', p.v.dir), { recursive: true, force: true })
      await appendFile(RESTORE, `${p.v.dir}\t${p.v.id}\t${(p.v.name || '').replace(/\t/g, ' ')}\t${p.v.size}\tPURGED\n`)
      prog.done.push({ id: p.v.id, name: p.v.name, size: p.v.size, base: p.base, dest: p.dest, shard })
      prog.savedBytes += p.v.size; prog.purgedBytes += p.v.size
    } catch (e) { prog.failed.push({ id: p.v.id, name: p.v.name, reason: 'purge:' + String(e).slice(0, 50) }) }
  }
  await save()
  console.log(`  ✓ ${pending.length} manifestes + vérif + purge. Total purgé: ${(prog.purgedBytes / 1073741824).toFixed(1)} Go`)
  await rm(shardDir, { recursive: true, force: true })
  pending = []
}

