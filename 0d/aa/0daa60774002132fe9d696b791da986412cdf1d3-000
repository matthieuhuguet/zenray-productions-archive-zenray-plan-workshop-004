  // non finalisée sont pousser-ables sans risque : blobs adressés par hash, le manifeste n'arrive qu'au flushShard.
  let vbytes = 0; let copiedSincePush = 0; let pushKO = false; const segMap = {}
  for (const f of [res.init, ...res.segs]) {
    const src = path.join(outDir, f)
    const fsz = (await stat(src)).size; vbytes += fsz
    const sp = shardPathFor(await sha256File(src), f.endsWith('.mp4') ? 'mp4' : 'm4s'); segMap[f] = sp
    const dst = path.join(shardDir, sp); await mkdir(path.dirname(dst), { recursive: true }); await copyFile(src, dst)
    copiedSincePush += fsz
    if (copiedSincePush >= PUSH_CHUNK) { if (!await pushChunk()) { pushKO = true; break } copiedSincePush = 0 }
  }
  if (pushKO) {
    console.error(`push intra-vidéo échec — abandon shard ${shard}, ${v.name} retentée plus tard, on continue`)
    prog.failed.push({ id: v.id, name: v.name, reason: 'push-shard' })
    for (const p of pending) prog.failed.push({ id: p.v.id, name: p.v.name, reason: 'push-shard' })
    await save(); pending = []; await rm(outDir, { recursive: true, force: true })
    await openShard(); continue
  }
  const folderPath = v.folders.length ? (fmap.get(v.folders[0]) || '_Unsorted') : '_Unsorted'
  const plRaw = await readFile(path.join(outDir, 'stream.m3u8'), 'utf8') // gardé en RAM (Ko) -> outDir purgeable de suite
  pending.push({ v, base, dest: `pages/References/${folderPath}`, segMap, init: res.init, segs: res.segs, duration: res.duration, vcodec: res.vcodec, acodec: res.acodec, bytes: vbytes, plRaw })
  shardBytes += vbytes; sincePush += vbytes
  console.log(`  [${n}/${vids.length}] ${v.name} (${(v.size / 1048576).toFixed(0)} Mo src -> ${(vbytes / 1048576).toFixed(0)} Mo fMP4) [shard ${(shardBytes / 1073741824).toFixed(2)} Go]`)
  await rm(outDir, { recursive: true, force: true }) // temp libéré tout de suite (segments copiés dans le shard, playlist gardée en RAM via plRaw)
  // Push raté (réseau / rejet GitHub) : ON NE TUE PLUS toute la run. On abandonne le shard courant (ses vidéos =
  // sources CONSERVÉES, marquées 'push-shard' donc retentées au prochain lancement après nettoyage), et on repart
  // sur un shard frais pour continuer la file. Avant : `break` mettait fin à TOUT au premier hoquet.
  if (sincePush >= PUSH_CHUNK) {
    if (!await pushChunk()) {
      console.error(`push incrément échec — abandon shard ${shard}, vidéos retentées plus tard, on continue`)
      for (const p of pending) prog.failed.push({ id: p.v.id, name: p.v.name, reason: 'push-shard' })
      await save(); pending = []; shardBytes = 0; sincePush = 0
      await openShard(); continue
    }
  }
  if (shardBytes >= SHARD_CAP) { await flushShard(); await openShard() }
}
await flushShard()
prog.running = false; prog.current = null; await save()
// purge des outDir de ce run
for (const d of await readdir(TMP).catch(() => [])) await rm(path.join(TMP, d), { recursive: true, force: true }).catch(() => {})
console.log(`\n=== TERMINÉ — ${prog.done.length} vidéos, ${(prog.purgedBytes / 1073741824).toFixed(1)} Go purgés, ${prog.failed.length} échecs ===`)
