// --- API throw-safe (manifestes texte uniquement) ---
async function gh(p, init = {}, tries = 5) {
  for (let i = 0; i < tries; i++) {
    try { return await fetch(`https://api.github.com/${p}`, { ...init, headers: { Authorization: `Bearer ${TOKEN}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zr-vid-bulk', ...(init.headers || {}) } }) }
    catch { await sleep(1500 * (i + 1)) }
  }
  return { ok: false, status: 0, json: async () => ({}), text: async () => '' }
}
// commit d'un lot de fichiers TEXTE (manifestes/playlists) via arbre inline : 1 tree + 1 commit + 1 ref.
async function commitInline(repo, files, msg) {
  for (let a = 0; a < 8; a++) {
    const ref = await (await gh(`repos/${OWNER}/${repo}/git/ref/heads/${BRANCH}`)).json(); const head = ref.object?.sha; if (!head) { await sleep(1500); continue }
    const base = (await (await gh(`repos/${OWNER}/${repo}/git/commits/${head}`)).json()).tree?.sha; if (!base) { await sleep(1500); continue }
    const tree = files.map((f) => ({ path: f.path, mode: '100644', type: 'blob', content: f.content }))
    const nt = await (await gh(`repos/${OWNER}/${repo}/git/trees`, { method: 'POST', body: JSON.stringify({ base_tree: base, tree }) })).json(); if (!nt.sha) { await sleep(2000); continue }
    const nc = await (await gh(`repos/${OWNER}/${repo}/git/commits`, { method: 'POST', body: JSON.stringify({ message: msg, tree: nt.sha, parents: [head] }) })).json(); if (!nc.sha) { await sleep(2000); continue }
    const up = await gh(`repos/${OWNER}/${repo}/git/refs/heads/${BRANCH}`, { method: 'PATCH', body: JSON.stringify({ sha: nc.sha, force: false }) })
    if (up.ok) return true
    await sleep(1500)
  }
  return false
}
