async function findVideoFile(dirAbs) {
  let best = null, bestSize = -1
  for (const f of await readdir(dirAbs)) { if (!VIDEXT.includes(f.split('.').pop().toLowerCase()) || f.includes('_thumbnail')) continue; const s = (await stat(path.join(dirAbs, f))).size; if (s > bestSize) { bestSize = s; best = f } }
  return best ? path.join(dirAbs, best) : null
}

// --- transcode une vidéo -> segments fMP4 dans outDir (garde-fou 19 Mo). Renvoie {segs, init, duration, vcodec, acodec} ou null. ---
async function transcode(input, outDir) {
  await rm(outDir, { recursive: true, force: true }); await mkdir(outDir, { recursive: true })
  let probe; try { probe = JSON.parse((await exec(FFPROBE, ['-v', 'error', '-show_entries', 'format=duration:stream=codec_type,codec_name', '-of', 'json', input])).stdout) } catch { return null }
  const vcodec = (probe.streams.find((s) => s.codec_type === 'video') || {}).codec_name || ''
  const acodec = (probe.streams.find((s) => s.codec_type === 'audio') || {}).codec_name || ''
  const duration = Number(probe.format?.duration) || 0
  const baseCmd = (vargs, t = HLS_TIME) => ['-y', '-loglevel', 'error', '-i', input, ...vargs, '-f', 'hls', '-hls_time', String(t), '-hls_playlist_type', 'vod', '-hls_segment_type', 'fmp4', '-hls_fmp4_init_filename', 'init.mp4', '-hls_segment_filename', path.join(outDir, 'seg_%03d.m4s'), path.join(outDir, 'stream.m3u8')]
  let strat = 'copy'
  try { await exec(FFMPEG, baseCmd(['-c', 'copy']), { maxBuffer: 1 << 23 }) }
  catch { strat = 'hw'; try { await exec(FFMPEG, baseCmd(['-c:v', 'h264_videotoolbox', '-b:v', '6M', '-c:a', 'aac', '-ac', '2', '-b:a', '160k', '-force_key_frames', `expr:gte(t,n_forced*${HLS_TIME})`]), { maxBuffer: 1 << 23 }) } catch { return null } }
  // garde-fou 19 Mo (limite service jsDelivr)
  let files = await readdir(outDir), segs = files.filter((f) => /\.m4s$/.test(f)).sort()
  const maxSeg = async () => Math.max(...(await Promise.all(segs.map((f) => stat(path.join(outDir, f)).then((x) => x.size)))), 0)
  for (const r of [{ t: 3 }, { t: 2 }, { t: 1 }, { t: 6, reenc: true }]) {
    if ((await maxSeg()) <= SEG_MAX) break
    for (const f of files) if (/\.m4s$|\.m3u8$|init\.mp4/.test(f)) await rm(path.join(outDir, f), { force: true })
    const vargs = (r.reenc || strat !== 'copy') ? ['-c:v', 'h264_videotoolbox', '-b:v', '6M', '-c:a', 'aac', '-ac', '2', '-b:a', '160k', '-force_key_frames', `expr:gte(t,n_forced*${r.t})`] : ['-c', 'copy']
    if (r.reenc) strat = 'hw'
    try { await exec(FFMPEG, baseCmd(vargs, r.t), { maxBuffer: 1 << 23 }) } catch { return null }
    files = await readdir(outDir); segs = files.filter((f) => /\.m4s$/.test(f)).sort()
  }
  if (!existsSync(path.join(outDir, 'init.mp4')) || !segs.length) return null
  return { segs, init: 'init.mp4', duration, vcodec, acodec, strat }
}

// --- shard local : ouvrir / fermer (push unique + manifestes + vérif + purge) ---
let shardNum = 0
function nextFreeShard() {
  // UN seul appel : liste les repos zenray-vid-public-* et prend max(NN)+1. Pas de boucle ls-remote (hang).
  try {
