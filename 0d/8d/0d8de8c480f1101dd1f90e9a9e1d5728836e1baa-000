  const pages = { undefined: { messages: [{ kind: 'prompt', text: `build a video from ${LILY}/versions`, timestamp: '2026-10-05T23:45:00Z' }, { kind: 'answer', text: 'an unrelated answer' }], nextBefore: 10 }, 10: { messages: [{ kind: 'answer', text: `wrote ${LILY}/out.mp4`, timestamp: '2026-10-05T23:47:00Z' }], nextBefore: null } }
