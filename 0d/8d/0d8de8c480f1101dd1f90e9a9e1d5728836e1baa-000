// @vitest-environment node
// 6 October 2026, 22:10 CEST: conversations are linked to projects by EXACT PATH EVIDENCE, never by intuition; the digest filter never leaks what is not about the project.
import { it, expect } from 'vitest'
import { mkdtemp, mkdir, writeFile, appendFile, readFile, rm } from 'node:fs/promises'
import path from 'node:path'
import os from 'node:os'
import { LINK_SETTINGS, projectMarkers, scanJsonl, scanDecoded, linkConversations, suggestions, renderConversationIndex, citingProject, renderDigest } from './ConversationLinks.mjs'

const TILES = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/CeramicTiles01', LILY = '/Users/zenray/Create/Build/Productions/ZenRayHoudini/VegetationCollection01'
const index = { projects: { tiles: { locations: { houdini: [{ localPath: TILES }], tmp: [{ localPath: '/Users/zenray/.claude/tmp/tmp-tiles-01' }] } }, lily: { locations: { houdini: [{ localPath: LILY }], short: [{ localPath: '/tmp/a' }] } } } }
const line = value => JSON.stringify(value) + '\n'
const claudeUser = (text, at) => line({ type: 'user', timestamp: at, message: { role: 'user', content: text } })
const claudeAssistant = (text, at) => line({ type: 'assistant', timestamp: at, message: { role: 'assistant', content: [{ type: 'text', text }] } })
const claudeResult = (text, at) => line({ type: 'user', timestamp: at, message: { role: 'user', content: [{ type: 'tool_result', content: text }] } })

it('builds markers from exact paths, ignores short ones and credits a shared path to every project', () => {
  const markers = projectMarkers(index)
  expect(markers.map(item => item.marker)).toContain(LILY)
  expect(markers.map(item => item.marker)).toContain('pages/ZenRayAssets/lily/')
  expect(markers.map(item => item.marker)).not.toContain('/tmp/a')
  const shared = projectMarkers({ projects: { one: { locations: { x: [{ localPath: LILY }] } }, two: { locations: { x: [{ localPath: LILY }] } } } }).find(item => item.marker === LILY)
  expect(shared.projects.sort()).toEqual(['one', 'two'])
  expect(LINK_SETTINGS.minimumMarkerLength).toBeGreaterThan('/tmp/a'.length)
})

it('counts prompts, work and tool results of a Claude transcript, and resumes from the saved offset', async () => {
  const dir = await mkdtemp(path.join(os.tmpdir(), 'links-claude-'))
  try {
    const file = path.join(dir, 'session.jsonl'), markers = projectMarkers(index)
    await writeFile(file, claudeUser(`open ${LILY}/hip`, '2026-10-05T08:00:00Z') + claudeAssistant(`I edit ${LILY}/Scripts/a.py`, '2026-10-05T08:01:00Z') + claudeResult(`${LILY}/out`, '2026-10-05T08:02:00Z') + claudeUser('unrelated', '2026-10-05T08:03:00Z'))
    const first = await scanJsonl(file, 'claude', markers, null)
    expect(first.hits.lily).toMatchObject({ lines: 3, work: 1, prompts: 1, first: '2026-10-05T08:00:00Z', last: '2026-10-05T08:02:00Z' })
    expect(first.hits.tiles).toBeUndefined()
    await appendFile(file, claudeAssistant(`again ${LILY}/x`, '2026-10-05T09:00:00Z'))
    const second = await scanJsonl(file, 'claude', markers, first)
    expect(second.hits.lily).toMatchObject({ lines: 4, work: 2, prompts: 1, last: '2026-10-05T09:00:00Z' })
    expect(second.offset).toBe((await readFile(file)).length)
    // a last line that is still being written (no newline) is not consumed, the next scan reads it again once complete
    await appendFile(file, claudeUser(`partial ${LILY}`, '2026-10-05T10:00:00Z').trimEnd())
    const third = await scanJsonl(file, 'claude', markers, second)
    expect(third.hits.lily.lines).toBe(4)
    expect(third.offset).toBe(second.offset)
    // a different set of markers invalidates the cache instead of mixing two meanings
    const other = await scanJsonl(file, 'claude', projectMarkers({ projects: { lily: { locations: { x: [{ localPath: LILY + '/Scripts' }] } } } }), third)
    expect(other.hits.lily.lines).toBe(1)   // only the line that cites <project>/Scripts; a stale cache would have kept 4
  } finally { await rm(dir, { recursive: true, force: true }) }
})

it('classifies Codex user prompts and function calls', async () => {
  const dir = await mkdtemp(path.join(os.tmpdir(), 'links-codex-'))
  try {
    const file = path.join(dir, 'rollout.jsonl')
    await writeFile(file, line({ timestamp: '2026-10-05T11:00:00Z', type: 'response_item', payload: { role: 'user', content: [{ type: 'input_text', text: `read ${TILES}` }] } }) + line({ timestamp: '2026-10-05T11:01:00Z', type: 'response_item', payload: { type: 'function_call', name: 'exec_command', arguments: `ls ${TILES}` } }))
    const result = await scanJsonl(file, 'codex', projectMarkers(index), null)
    expect(result.hits.tiles).toMatchObject({ lines: 2, work: 1, prompts: 1 })
  } finally { await rm(dir, { recursive: true, force: true }) }
})

