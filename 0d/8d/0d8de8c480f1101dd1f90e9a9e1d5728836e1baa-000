it('links conversations by evidence, rates it, caches it and only suggests unbound strong single-project rows', async () => {
  const dir = await mkdtemp(path.join(os.tmpdir(), 'links-all-'))
  try {
    const state = path.join(dir, 'state'); await mkdir(state)
    const strong = path.join(dir, 'strong.jsonl'), weak = path.join(dir, 'weak.jsonl'), both = path.join(dir, 'both.jsonl'), bound = path.join(dir, 'bound.jsonl'), gem = path.join(dir, 'gem.db'), gemRaw = path.join(dir, 'gemraw.db')
    await writeFile(strong, claudeUser(`work in ${LILY}`, '2026-10-05T08:00:00Z') + claudeAssistant(`edit ${LILY}/a`, '2026-10-05T08:01:00Z'))
    await writeFile(weak, claudeAssistant(`only one look at ${LILY}`, '2026-10-05T08:00:00Z'))
    await writeFile(both, [1, 2, 3].map(n => claudeAssistant(`edit ${LILY}/${n} and ${TILES}/${n}`, '2026-10-05T08:0' + n + ':00Z')).join(''))
    await writeFile(bound, claudeUser(`work in ${LILY}`, '2026-10-05T08:00:00Z') + claudeAssistant(`edit ${LILY}/a`, '2026-10-05T08:01:00Z'))
    await writeFile(gem, Buffer.from(`binary ${LILY} binary`)); await writeFile(gemRaw, Buffer.from(`binary ${LILY} hidden injected context only`))
    const conversations = [
      { id: 'claude:strong', provider: 'claude', sessionId: 'strong', readable: true, localPath: strong, title: 'Strong', updatedAt: 1, bytes: 10 },
      { id: 'claude:weak', provider: 'claude', sessionId: 'weak', readable: true, localPath: weak, title: 'Weak', updatedAt: 1, bytes: 10 },
      { id: 'claude:both', provider: 'claude', sessionId: 'both', readable: true, localPath: both, title: 'Both', updatedAt: 1, bytes: 10 },
      { id: 'claude:bound', provider: 'claude', sessionId: 'bound', readable: true, localPath: bound, title: 'Bound', updatedAt: 1, bytes: 10 },
      { id: 'gemini:gem', provider: 'gemini', sessionId: 'gem', readable: true, localPath: gem, title: 'Gem', updatedAt: 1, bytes: 10 },
      { id: 'gemini:raw', provider: 'gemini', sessionId: 'raw', readable: true, localPath: gemRaw, title: 'Raw', updatedAt: 1, bytes: 10 },
      { id: 'claude:hidden', provider: 'claude', sessionId: 'hidden', readable: false, localPath: strong, title: 'Not readable', updatedAt: 1, bytes: 10 },
    ]
    const decoded = { 'gemini:gem': { messages: [{ kind: 'prompt', text: `make a video of ${LILY}/versions`, timestamp: '2026-10-05T23:45:00Z' }, { kind: 'answer', text: `done in ${LILY}/video`, timestamp: '2026-10-05T23:46:00Z' }] }, 'gemini:raw': { messages: [{ kind: 'prompt', text: 'a question with no project path at all', timestamp: '2026-10-05T23:45:00Z' }] } }
    const calls = []
    const links = await linkConversations({ conversations, index, stateDir: state, bindings: { bound: 'lily' }, readConversation: async id => { calls.push(id); return decoded[id] } })
    const by = Object.fromEntries(links.rows.map(row => [row.id, row]))
    expect(by['claude:strong'].evidence[0]).toMatchObject({ projectId: 'lily', strength: 'strong', prompts: 1, work: 1 })
    expect(by['claude:weak'].evidence[0].strength).toBe('weak')
    expect(by['claude:both'].evidence.map(item => item.projectId).sort()).toEqual(['lily', 'tiles'])
    expect(by['gemini:gem'].evidence[0]).toMatchObject({ projectId: 'lily', strength: 'strong' })
    expect(by['gemini:raw']).toBeUndefined()
    expect(by['claude:hidden']).toBeUndefined()
    expect(by['claude:bound'].boundProject).toBe('lily')
    expect(suggestions(links.rows).map(item => item.conversationId).sort()).toEqual(['claude:strong', 'gemini:gem'])
    // cache: a second run reads nothing again and decodes no Gemini conversation
    calls.length = 0
    const again = await linkConversations({ conversations, index, stateDir: state, bindings: {}, readConversation: async id => { calls.push(id); return decoded[id] } })
    expect(calls).toEqual([])
    expect(again.rows.length).toBe(links.rows.length)
    expect(JSON.parse(await readFile(path.join(state, 'ConversationLinks.json'), 'utf8')).files[strong].offset).toBeGreaterThan(0)
    expect(by['claude:strong'].boundProject).toBeNull()
    // the readable index of the project memory
    const markdown = renderConversationIndex('lily', links, '6 October 2026')
    expect(markdown).toContain('# Conversations that worked on lily')
    expect(markdown).toContain('`claude:strong`')
    expect(markdown).toContain('| claude | Bound | strong |')
  } finally { await rm(dir, { recursive: true, force: true }) }
})

it('digests keep ONLY the messages that cite the project and say so', () => {
  const messages = [
    { id: 1, kind: 'prompt', text: `build the video from ${LILY}/versions`, timestamp: '2026-10-05T23:45:00Z' },
    { id: 2, kind: 'prompt', text: 'my private job application answers', timestamp: '2026-10-05T23:46:00Z' },
    { id: 3, kind: 'answer', text: `done: ${LILY}/video/a.mp4 ` + 'x'.repeat(50), timestamp: '2026-10-05T23:47:00Z' },
  ]
  const kept = citingProject(messages, index, 'lily')
  expect(kept.map(item => item.id)).toEqual([1, 3])
  expect(() => citingProject(messages, index, 'unknown')).toThrow('No registered path')
  const markdown = renderDigest({ id: 'gemini:x', conversation: { title: 'T', provider: 'gemini' }, messages: [...kept].reverse(), pages: 2, project: 'lily', maxChars: 20 })
  expect(markdown).toContain('that cite the paths of lily')
  expect(markdown).not.toContain('private job')
  expect(markdown.indexOf('2026-10-05T23:45:00Z')).toBeLessThan(markdown.indexOf('2026-10-05T23:47:00Z'))
  expect(markdown).toMatch(/\[\.\.\. \d+ more characters in the original\]/)
  expect(renderDigest({ id: 'x', messages: [], project: undefined })).not.toContain('deliberately left out')
})
