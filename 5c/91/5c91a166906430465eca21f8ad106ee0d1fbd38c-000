import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { describe, expect, it } from 'vitest'
import { cloneLockDir, withCloneLock } from './clone-lock.mjs'

const makeClone = () => fs.mkdtempSync(path.join(os.tmpdir(), 'clone-lock-'))
const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms))

describe('clone lock', () => {
  it('puts the lock directory next to the clone, never inside it', () => {
    const clone = makeClone()
    expect(cloneLockDir(clone)).toBe(`${fs.realpathSync(clone)}.lock`)
    expect(cloneLockDir(clone).startsWith(fs.realpathSync(clone) + path.sep)).toBe(false)
  })
  it('runs two critical sections one after the other, never overlapping', async () => {
    const clone = makeClone()
    const events = []
    const section = (name) => withCloneLock(clone, name, async () => {
      events.push(`${name}:in`); await sleep(60); events.push(`${name}:out`)
    })
    await Promise.all([section('a'), section('b'), section('c')])
    // every "in" is immediately followed by its own "out"
    for (let i = 0; i < events.length; i += 2) expect(events[i].split(':')[0]).toBe(events[i + 1].split(':')[0])
    expect(events).toHaveLength(6)
  })
  it('releases the lock when the section throws', async () => {
    const clone = makeClone()
    await expect(withCloneLock(clone, 'boom', async () => { throw new Error('boom') })).rejects.toThrow('boom')
    expect(fs.existsSync(cloneLockDir(clone))).toBe(false)
    await withCloneLock(clone, 'after', async () => 'ok')
  })
})
