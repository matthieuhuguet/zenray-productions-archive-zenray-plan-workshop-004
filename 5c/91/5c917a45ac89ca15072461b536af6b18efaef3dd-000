import { describe, expect, it } from 'vitest'
import { mediaManifestPath } from './media-ingest.mjs'

describe('adresse du manifeste audio ou PDF', () => {
  it('reste stable pour une même source et ne porte aucun suffixe aléatoire', () => {
    expect(mediaManifestPath('pages/Cloud/Downloads/Audio', 'Audio/piste.mp3'))
      .toBe('pages/Cloud/Downloads/Audio/piste.mp3.media.json')
  })
})
