const NAMED = { amp: '&', lt: '<', gt: '>', quot: '"', apos: "'", nbsp: ' ', rsquo: '’', lsquo: '‘', ldquo: '“', rdquo: '”', hellip: '…', ndash: '\u2013', mdash: '\u2014', eacute: 'é', egrave: 'è', ecirc: 'ê', agrave: 'à', acirc: 'â', ccedil: 'ç', ocirc: 'ô', icirc: 'î', ucirc: 'û', ugrave: 'ù', euml: 'ë', iuml: 'ï', copy: '©', reg: '®', trade: '™', bull: '•', middot: '·', laquo: '«', raquo: '»', deg: '°', euro: '€' }

export function decodeEntities(value) {
  return String(value ?? '').replace(/&(#x[0-9a-f]+|#\d+|[a-z][a-z0-9]+);/gi, (match, body) => {
    if (body[0] === '#') {
      const code = body[1].toLowerCase() === 'x' ? parseInt(body.slice(2), 16) : parseInt(body.slice(1), 10)
      return Number.isFinite(code) && code > 0 && code < 0x110000 ? String.fromCodePoint(code) : match
    }
    return NAMED[body.toLowerCase()] ?? match
  })
}

const DROP = /<(script|style|noscript|svg|form|nav|footer|picture|template)\b[^>]*>[\s\S]*?<\/\1>/gi

/** Flat one-line text, as the collector's notes need. */
export function clean(value) {
  return decodeEntities(decodeEntities(String(value ?? '')).replace(DROP, ' ').replace(/<[^>]+>/g, ' ')).replace(/\s+/g, ' ').trim()
}

/** Readable paragraphs with bullets, as the archived offer detail needs. */
export function readable(value) {
  const text = decodeEntities(String(value ?? ''))
    .replace(DROP, ' ')
    .replace(/<li\b[^>]*>/gi, '\n• ')
    .replace(/<\/(p|div|ul|ol|h[1-6]|section|article|tr)>/gi, '\n\n')
    .replace(/<(br|hr)\s*\/?>/gi, '\n')
    .replace(/<(p|div|ul|ol|h[1-6]|section|article|tr)\b[^>]*>/gi, '\n\n')
    .replace(/<[^>]+>/g, '')
    .replace(/\r/g, '')
  return decodeEntities(text).replace(/[ \t ]+/g, ' ').replace(/ *\n */g, '\n').replace(/\n{3,}/g, '\n\n').trim()
}

/**
 * JSON-LD written by hand often carries a raw line break, a stray backslash inside a string, or a semicolon where a comma belongs. Strict parsing first; only a
 * failure falls back to cleaning those two defects, never to guessing at structure.
 * FR : le JSON-LD ecrit a la main porte souvent un saut de ligne brut ou un antislash isole. Lecture stricte d'abord, nettoyage
 * de ces deux defauts seulement en cas d'echec.
 */
export function tolerantJson(text) {
  try { return JSON.parse(text) } catch {}
  try { return JSON.parse(String(text).replace(/("|\d|true|false|null|\}|\])\s*;(\s*"[A-Za-z@])/g, '$1,$2').replace(/;(\s*[}\]])/g, '$1').replace(/\\(?!["\\/bfnrtu])/g, '').replace(/[\u0000-\u001F]/g, ' ')) } catch { return null }
}

/** The first JobPosting of the page's JSON-LD blocks, or null. */
export function jobPosting(html) {
  for (const match of String(html).matchAll(/<script[^>]*type=["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/gi)) {
    const data = tolerantJson(match[1])
    if (!data) continue
    const list = Array.isArray(data) ? data : data['@graph'] || [data]
    const found = list.find((item) => item && item['@type'] === 'JobPosting')
    if (found) return found
  }
  return null
}

/** Same offer, same key: host and path only, trailing slash and query dropped. */
export function canonicalUrl(value) {
  try {
    const url = new URL(value)
    return `${url.protocol}//${url.host.toLowerCase()}${url.pathname.replace(/\/+$/, '')}`
  } catch { return String(value || '') }
}

const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
export const englishDay = (date = new Date()) => `${date.getDate()} ${MONTHS[date.getMonth()]} ${date.getFullYear()}`
export const isoDay = (date = new Date()) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`
export function dateLabel(value) {
  if (value === undefined || value === null || value === '') return 'Non publiée'
  const date = typeof value === 'number' ? new Date(value) : new Date(String(value))
  return Number.isNaN(date.getTime()) ? clean(value) || 'Non publiée' : englishDay(date)
}

/** Emails of an advertisement text, minus the technical addresses nobody should write to. */
export function recruiterEmails(text) {
  const found = [...new Set(String(text || '').match(/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/g) || [])]
  return found.filter((email) => !/noreply|no-reply|privacy|support|example|greenhouse|recruitmentprivacy|dpo@|sentry/i.test(email))
}

/** No long dash anywhere in text we produce for Matthieu (his global rule). */
export const noLongDash = (value) => String(value ?? '').replace(/\s*[\u2014\u2013]\s*/g, ', ')
