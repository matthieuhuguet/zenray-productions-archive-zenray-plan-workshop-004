// LOT TABLES — formats d'affichage des valeurs (nombre, monnaie, pourcentage, date).
// La valeur stockée ne change pas ; seul l'affichage est habillé. Comme dans Excel,
// "0.25" peut s'afficher "25 %" ou "0,25 €" selon le format choisi pour la colonne/cellule.

export const NUM_FORMATS = [
  ['auto', 'Automatique'],
  ['number', 'Nombre'],
  ['currency', 'Monnaie €'],
  ['currencyUsd', 'Monnaie $'],
  ['percent', 'Pourcentage'],
  ['date', 'Date'],
  ['datetime', 'Date + heure'],
  ['text', 'Texte brut'],
]

const isNumeric = (v) => v !== '' && v != null && !isNaN(parseFloat(v)) && isFinite(v)

// Habille une valeur CALCULÉE pour l'affichage selon le format demandé.
export function formatValue(v, fmt, decimals) {
  if (v == null || v === '') return ''
  if (typeof v === 'boolean') return v ? '✓' : ''
  const d = decimals == null ? undefined : decimals
  switch (fmt) {
    case 'number': return isNumeric(v) ? Number(v).toLocaleString('fr-FR', fixOpts(d)) : String(v)
    case 'currency': return isNumeric(v) ? Number(v).toLocaleString('fr-FR', { style: 'currency', currency: 'EUR', ...fixOpts(d) }) : String(v)
    case 'currencyUsd': return isNumeric(v) ? Number(v).toLocaleString('en-US', { style: 'currency', currency: 'USD', ...fixOpts(d) }) : String(v)
    case 'percent': return isNumeric(v) ? Number(v).toLocaleString('fr-FR', { style: 'percent', ...fixOpts(d == null ? 0 : d) }) : String(v)
    case 'date': { const dt = new Date(v); return isNaN(dt) ? String(v) : dt.toLocaleDateString('fr-FR') }
    case 'datetime': { const dt = new Date(v); return isNaN(dt) ? String(v) : dt.toLocaleString('fr-FR') }
    case 'text': return String(v)
    default: return isNumeric(v) && typeof v !== 'string' ? Number(v).toLocaleString('fr-FR') : String(v)
  }
}
function fixOpts(d) { return d == null ? {} : { minimumFractionDigits: d, maximumFractionDigits: d } }

// Style CSS dérivé du formatage de cellule (gras, italique, couleur, alignement).
export function cellStyle(f) {
  if (!f) return {}
  const s = {}
  if (f.bold) s.fontWeight = 700
  if (f.italic) s.fontStyle = 'italic'
  const deco = []
  if (f.underline) deco.push('underline')
  if (f.strike) deco.push('line-through')
  if (deco.length) s.textDecoration = deco.join(' ')
  if (f.fontSize) s.fontSize = f.fontSize
  if (f.color) s.color = f.color
  if (f.bg) s.background = f.bg
  if (f.align) s.textAlign = f.align
  if (f.wrap) { s.whiteSpace = 'normal'; s.wordBreak = 'break-word'; s.lineHeight = 1.25 }
  if (f.border) {
    const bc = (v) => v === true ? '#9aa0a6' : v
    if (f.border.top) s.borderTop = `1.5px solid ${bc(f.border.top)}`
    if (f.border.right) s.borderRight = `1.5px solid ${bc(f.border.right)}`
    if (f.border.bottom) s.borderBottom = `1.5px solid ${bc(f.border.bottom)}`
    if (f.border.left) s.borderLeft = `1.5px solid ${bc(f.border.left)}`
  }
  return s
}

// MISE EN FORME CONDITIONNELLE : règles d'une table évaluées sur une valeur -> {bg,color} à fusionner.
// rules = [{op,value,bg,color}] (op: > < >= <= = != contains empty notEmpty). Première règle qui matche gagne.
export function condStyle(rules, value) {
  if (!rules || !rules.length) return null
  const num = parseFloat(value)
  const sv = value == null ? '' : String(value)
  for (const r of rules) {
    const rv = r.value
    let hit = false
    switch (r.op) {
      case '>': hit = !isNaN(num) && num > parseFloat(rv); break
      case '<': hit = !isNaN(num) && num < parseFloat(rv); break
      case '>=': hit = !isNaN(num) && num >= parseFloat(rv); break
      case '<=': hit = !isNaN(num) && num <= parseFloat(rv); break
      case '=': hit = sv === String(rv); break
      case '!=': hit = sv !== String(rv); break
      case 'contains': hit = sv.toLowerCase().includes(String(rv).toLowerCase()); break
      case 'empty': hit = sv === ''; break
      case 'notEmpty': hit = sv !== ''; break
      default: hit = false
    }
    if (hit) return { bg: r.bg, color: r.color }
  }
  return null
}
