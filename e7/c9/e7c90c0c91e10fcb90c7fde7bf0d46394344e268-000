import { createPortal } from 'react-dom'
import { SHADOWS } from '../theme.js'
import Icon from '../components/Icon.jsx'

// Rendu partagé des modales « colle un lien par ligne » (Liens YouTube, Liens audio YouTube, Liens Google
// Maps). AVANT cette extraction, App.jsx rendait 3 blocs JSX quasi identiques (même overlay, même carte,
// même textarea, mêmes boutons Annuler/Ajouter avec le même badge de progression) — seuls l'icône/couleur/
// texte d'intro/placeholder changeaient. `modal` vient de useLinkImportModal (état + submit) ; ce composant
// ne fait QUE le rendu, câblé sur cet état.
export default function LinkImportModal({ modal, icon, color = '#d97757', label, body, placeholder, t, fonts }) {
  const { open, setOpen, text, setText, busy, progress, submit } = modal
  if (!open) return null
  return createPortal(
    <div onClick={() => !busy && setOpen(false)} style={{ position: 'fixed', inset: 0, zIndex: 9999, background: 'rgba(0,0,0,0.45)', display: 'grid', placeItems: 'center', padding: 16 }}>
      <div onClick={(e) => e.stopPropagation()} style={{ width: 520, maxWidth: '92vw', background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: 16, padding: 20, boxShadow: SHADOWS.lg }}>
        <div style={{ fontFamily: fonts.sans, fontSize: 'var(--zr-ui-2xl)', fontWeight: 700, color: t.textPrimary, marginBottom: 6, display: 'flex', alignItems: 'center', gap: 8 }}>
          <Icon name={icon} size={17} color={color} />{label}
        </div>
        <div style={{ fontFamily: fonts.sans, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary, marginBottom: 12, lineHeight: 1.5 }}>{body}</div>
        <textarea value={text} onChange={(e) => setText(e.target.value)} rows={6} autoFocus disabled={busy}
          placeholder={placeholder}
          style={{ width: '100%', boxSizing: 'border-box', fontFamily: fonts.mono, fontSize: 'var(--zr-ui-sm)', color: t.textPrimary, background: 'transparent', border: `1.5px solid ${t.textPrimary}`, borderRadius: 10, padding: 10, outline: 'none', resize: 'vertical' }} />
        <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 8, marginTop: 14 }}>
          <button onClick={() => setOpen(false)} disabled={busy} style={{ background: 'transparent', color: t.textPrimary, border: `1.5px solid ${t.textPrimary}`, borderRadius: 8, padding: '7px 16px', cursor: 'pointer', fontSize: 'var(--zr-ui-md)', fontWeight: 600 }}>Annuler</button>
          <button onClick={submit} disabled={busy || !text.trim()} style={{ background: t.textPrimary, color: t.cardBg, border: 'none', borderRadius: 8, padding: '7px 16px', cursor: 'pointer', fontSize: 'var(--zr-ui-md)', fontWeight: 600, opacity: (busy || !text.trim()) ? 0.4 : 1 }}>
            {busy ? `${Math.round(progress * 100)}%` : 'Ajouter'}
          </button>
        </div>
      </div>
    </div>, document.body
  )
}
