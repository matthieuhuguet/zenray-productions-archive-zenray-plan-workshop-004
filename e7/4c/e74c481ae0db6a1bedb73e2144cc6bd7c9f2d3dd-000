/* ═══ ROUE CYBERNÉTIQUE, LES MOUVEMENTS ═══════════════════════════════════════════════════════════
   Trois rotations de périodes premières entre elles, dont une à contresens, et une respiration lente
   par-dessus. Aucune de ces animations ne coûte une mise en page : elles ne touchent que `transform` et
   `opacity`, donc elles vivent sur le compositeur et ne réveillent jamais le calcul de style de la page
   qui les héberge. C'est la condition pour qu'une pastille qui tourne en permanence, sur toutes les
   vues, ne coûte rien à ce que Matthieu est vraiment en train de faire. */

:root {
  /* LE TURQUOISE, UNE FOIS, DEUX VALEURS. Celui de la référence est un cyan d'écran noir : posé sur le
     fond blanc du site il disparaît, et un ton plus profond y devient nécessaire. Sur fond sombre c'est
     l'inverse. Écrire la couleur en dur revenait donc à choisir lequel des deux thèmes serait raté.
     Déclaré ICI et non sur `.rc` : la capsule qui entoure la roue en a besoin pour son contour de
     focus, et une variable posée sur le `<svg>` ne remonte pas à ce qui le contient. */
  --rc-cyan: #2bb8c4;
  --rc-bleu: #3b82f7;
}
.zr-dark { --rc-cyan: #5fe3e8; --rc-bleu: #5c9bff; }

.rc { overflow: visible; display: block; }
.rc-stop-a { stop-color: var(--rc-cyan); }
.rc-stop-b { stop-color: var(--rc-bleu); }
/* ── LE REPÈRE DES ROTATIONS, ET UNE ERREUR QUI NE SE VOIT QU'À MI-COURSE ─────────────────────────
   Première version : `transform-box: fill-box` sur TOUS les éléments de la roue. C'était faux, et faux
   d'une façon parfaitement invisible au départ. L'arc de progression porte son propre
   `transform="rotate(-90 50 50)"`, qui veut dire « pivote autour du centre du repère » ; sous
   `fill-box`, ces coordonnées se lisent dans la boîte de l'arc LUI-MÊME, si bien qu'il pivotait autour
   d'un point situé loin dehors et se dessinait à côté de la roue. Tant que le bloc venait de démarrer,
   l'arc était vide et le défaut restait caché : il n'apparaissait qu'une fois la course entamée.
   `view-box` rapporte les transformations au repère 0 0 100 100 déclaré par le `viewBox`, donc
   `50% 50%` y désigne exactement le centre de la roue, quelle que soit la forme de chaque groupe. Et le
   sélecteur ne nomme QUE ce qui tourne réellement : ce qui ne bouge pas n'a aucune raison de voir son
   repère redéfini. */
.rc-souffle, .rc-graduations, .rc-arcs-ext, .rc-arcs-int {
  transform-box: view-box;
  transform-origin: 50% 50%;
}

/* ── LA RESPIRATION ───────────────────────────────────────────────────────────────────────────────
   Sinusoïdale par le `ease-in-out`, jamais linéaire : un souffle qui accélère et ralentit se lit comme
   vivant, un souffle à vitesse constante se lit comme un moteur. */
.rc-souffle { animation: rc-souffle var(--rc-respire, 4.6s) ease-in-out infinite; }
@keyframes rc-souffle {
  0%, 100% { transform: scale(1) }
  50%      { transform: scale(var(--rc-ampli, 1.035)) }
}

.rc-halo {
  fill: none; stroke: var(--rc-cyan); stroke-width: 8;
  opacity: .10; filter: blur(2px);
  animation: rc-halo var(--rc-respire, 4.6s) ease-in-out infinite;
}
@keyframes rc-halo {
  0%, 100% { opacity: .22; stroke-width: 10 }
  50%      { opacity: .08; stroke-width: 6 }
}

/* ── LES ROTATIONS ────────────────────────────────────────────────────────────────────────────────
   96 s, 27 s à contresens, 15 s. Aucun de ces nombres n'est un multiple d'un autre : les trois anneaux
   ne se réalignent donc jamais, et l'œil ne trouve aucune boucle à mémoriser. C'est ce qui distingue
   une machine qui calcule d'un indicateur qui tourne. */
.rc-graduations { animation: rc-tourne 96s linear infinite; }
.rc-arcs-ext    { animation: rc-tourne 27s linear infinite reverse; }
.rc-arcs-int    { animation: rc-tourne 15s linear infinite; }
@keyframes rc-tourne { from { transform: rotate(0deg) } to { transform: rotate(360deg) } }

/* ── LES TRAITS ───────────────────────────────────────────────────────────────────────────────────
   Tout est sous 0,5 d'opacité sauf l'arc de progression. Un HUD de jeu brille parce qu'il doit se lire
   dans une bataille ; posé dans un coin d'interface, il n'a rien à concurrencer, et la même intensité
   deviendrait du bruit. Seule la donnée a le droit d'être franche. */
.rc-grad { stroke: currentColor; opacity: .26; }
.rc-grad-fort { opacity: .5; }
.rc-arcs-ext path { stroke: var(--rc-cyan); opacity: .6; }
.rc-arcs-int path { stroke: currentColor; opacity: .3; }
.rc-equerres line { stroke: var(--rc-cyan); opacity: .7; }
.rc-piste { stroke: currentColor; opacity: .16; }

.rc-progres {
  stroke: url(#rc-degrade);
  /* La transition sur le tiret est ce qui empêche l'arc de sauter d'un cran chaque seconde : il GLISSE
     vers sa nouvelle longueur, si bien qu'on ne voit jamais le pas de la mesure, seulement la course. */
  transition: stroke-dasharray .9s cubic-bezier(.16,1,.3,1);
  filter: drop-shadow(0 0 3px color-mix(in srgb, var(--rc-cyan) 60%, transparent));
}

/* DERNIÈRE MINUTE : la couleur monte et la respiration s'accélère. Rien d'autre ne change, parce que
   l'urgence se dit par le rythme, jamais par un élément de plus. */
.rc-urgent .rc-progres { stroke: #ff6254; filter: drop-shadow(0 0 4px rgba(255,98,84,.6)); }
.rc-urgent .rc-halo { stroke: #ff6254; }
.rc-urgent .rc-souffle, .rc-urgent .rc-halo { animation-duration: 1.5s; }

/* ── LE GARDE-FOU ─────────────────────────────────────────────────────────────────────────────────
   `prefers-reduced-motion` arrête TOUT, et la roue reste parfaitement lisible : l'arc de progression
   dit encore où en est le bloc, ce qui est la seule chose qu'elle avait à dire. Le juice n'est jamais
   une raison de rendre une interface pénible à quelqu'un que le mouvement dérange. */
@media (prefers-reduced-motion: reduce) {
  .rc-souffle, .rc-halo, .rc-graduations, .rc-arcs-ext, .rc-arcs-int { animation: none !important; }
  .rc-progres { transition-duration: .01ms !important; }
}
