import { describe, it, expect, beforeEach } from 'vitest'
import {
  isAudioEntry,
  getCachedAudioManifest,
  setCachedAudioManifest,
  getCachedAudioUrl,
  setCachedAudioUrl,
  clearAudioQuickCache,
} from './audioQuickCache.js'

describe('audioQuickCache: gestion du cache rapide de streaming audio', () => {
  beforeEach(() => {
    clearAudioQuickCache()
  })

  it('detecte correctement les entrees audio par extension ou type', () => {
    expect(isAudioEntry({ name: 'track.mp3' })).toBe(true)
    expect(isAudioEntry({ name: 'sfx.wav' })).toBe(true)
    expect(isAudioEntry({ name: 'song.flac' })).toBe(true)
    expect(isAudioEntry({ name: 'ambient.m4a' })).toBe(true)
    expect(isAudioEntry({ name: 'clip.ogg' })).toBe(true)
    expect(isAudioEntry({ name: 'sound.aac' })).toBe(true)
    expect(isAudioEntry({ name: 'voice', mime: 'audio/mpeg' })).toBe(true)
    expect(isAudioEntry({ name: 'photo.jpg' })).toBe(false)
    expect(isAudioEntry({ name: 'video.mp4' })).toBe(false)
    expect(isAudioEntry(null)).toBe(false)
  })

  it('stocke et recupere les manifestes audio en synchrone', () => {
    const mockManifest = { name: 'track.mp3', mime: 'audio/mpeg', size: 102400 }
    expect(getCachedAudioManifest('Audio/SFX/track.media.json')).toBeNull()

    setCachedAudioManifest('Audio/SFX/track.media.json', mockManifest)
    expect(getCachedAudioManifest('Audio/SFX/track.media.json')).toEqual(mockManifest)
  })

  it('stocke et recupere les URLs resolues de streaming audio', () => {
    expect(getCachedAudioUrl('Audio/SFX/track.media.json')).toBeNull()

    setCachedAudioUrl('Audio/SFX/track.media.json', 'blob:http://localhost/mock-audio')
    expect(getCachedAudioUrl('Audio/SFX/track.media.json')).toBe('blob:http://localhost/mock-audio')
  })

  it('detecte les entrees audio basees sur contentPath .media.json et .file.json', () => {
    expect(isAudioEntry({ type: 'media', contentPath: 'pages/Audio/SFX/rse/alarm1.mp3.media.json' })).toBe(true)
    expect(isAudioEntry({ type: 'media', contentPath: 'pages/Audio/SFX/rse/sound.wav.media.json' })).toBe(true)
    expect(isAudioEntry({ type: 'file', contentPath: 'pages/Audio/SFX/archive.mp3.file.json' })).toBe(true)
    expect(isAudioEntry({ type: 'media', contentPath: 'pages/Video/clip.mp4.media.json' })).toBe(false)
  })
})
