import React, { useRef } from 'react'
import { act, cleanup, render } from '@testing-library/react'
import { afterEach, describe, expect, it } from 'vitest'
import { VirtualList, VirtualIconGrid, LIST_ROW_H } from './VirtualScroll.jsx'

// jsdom ne calcule aucun layout réel (clientHeight/clientWidth/scrollHeight restent à 0 par défaut) :
// on les fige via defineProperty pour simuler un conteneur scrollable de taille connue, comme le vrai
// conteneur Finder (gridScrollRef) en navigateur.
function mockScrollBox(el, { clientHeight, clientWidth = 800 }) {
  Object.defineProperty(el, 'clientHeight', { configurable: true, value: clientHeight })
  Object.defineProperty(el, 'clientWidth', { configurable: true, value: clientWidth })
  Object.defineProperty(el, 'scrollHeight', { configurable: true, value: 1e9 }) // très grand -> jamais le facteur limitant
}

// Le recalcul de fenêtre (recompute) est planifié dans un requestAnimationFrame (scroll coalescé, voir
// useVirtualWindow) : on attend deux rAF imbriqués pour être sûr qu'il a tourné avant d'inspecter le DOM
// (même idiome que le scroll-vers-lettre de Pages()).
async function flushRaf() {
  await act(async () => {
    await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)))
  })
}

function makeEntries(n) {
  return Array.from({ length: n }, (_, i) => ({ dir: `pages/item-${i}`, name: `item-${i}` }))
}

describe('VirtualList', () => {
  afterEach(() => cleanup())

  it('ne monte QUE les lignes visibles + overscan, jamais les N lignes (anti-freeze 100k)', async () => {
    const entries = makeEntries(100000)
    let scrollRef
    function Probe() {
      const ref = useRef(null)
      scrollRef = ref
      return (
        <div ref={ref} style={{ height: 400, overflow: 'auto' }}>
          <VirtualList entries={entries} rowHeight={LIST_ROW_H} scrollRef={ref}
            renderRow={(e) => <div key={e.dir} data-testid="row" data-dir={e.dir}>{e.name}</div>} />
        </div>
      )
    }
    const { container } = render(<Probe />)
    mockScrollBox(scrollRef.current, { clientHeight: 400 })
    act(() => { scrollRef.current.dispatchEvent(new Event('scroll')) })
    await flushRaf()

    const rows = container.querySelectorAll('[data-testid="row"]')
    expect(rows.length).toBeGreaterThan(0)
    expect(rows.length).toBeLessThan(100) // très loin des 100 000 entrées : preuve que ça fenêtre bien
    // Le spacer (hauteur totale simulée) doit refléter TOUTES les entrées, pour une scrollbar à la bonne taille.
    const spacer = container.querySelector('[data-zr-virtual-list]')
    expect(spacer.style.height).toBe(`${100000 * LIST_ROW_H}px`)
  })

  it('scroller plus bas change la tranche de lignes rendues (fenêtre glissante)', async () => {
    const entries = makeEntries(1000)
    let scrollRef
    function Probe() {
      const ref = useRef(null)
      scrollRef = ref
      return (
        <div ref={ref} style={{ height: 400, overflow: 'auto' }}>
          <VirtualList entries={entries} rowHeight={LIST_ROW_H} scrollRef={ref}
            renderRow={(e) => <div key={e.dir} data-testid="row" data-dir={e.dir}>{e.name}</div>} />
        </div>
      )
    }
    const { container } = render(<Probe />)
    mockScrollBox(scrollRef.current, { clientHeight: 400 })
    scrollRef.current.scrollTop = 0
    act(() => { scrollRef.current.dispatchEvent(new Event('scroll')) })
    await flushRaf()
    const dirsAtTop = [...container.querySelectorAll('[data-testid="row"]')].map((n) => n.dataset.dir)
    expect(dirsAtTop).toContain('pages/item-0')
    expect(dirsAtTop).not.toContain('pages/item-500')

    scrollRef.current.scrollTop = 500 * LIST_ROW_H
    act(() => { scrollRef.current.dispatchEvent(new Event('scroll')) })
    await flushRaf()
    const dirsAfterScroll = [...container.querySelectorAll('[data-testid="row"]')].map((n) => n.dataset.dir)
    expect(dirsAfterScroll).not.toContain('pages/item-0')
    expect(dirsAfterScroll).toContain('pages/item-500')
  })

  it('remonte au parent les contentPath de la fenêtre rendue via onWindow', async () => {
    const entries = Array.from({ length: 200 }, (_, i) => ({ dir: `pages/item-${i}`, name: `item-${i}`, contentPath: `pages/item-${i}.img.json` }))
    let scrollRef
    let seenWindow = null
    function Probe() {
      const ref = useRef(null)
      scrollRef = ref
      return (
        <div ref={ref} style={{ height: 400, overflow: 'auto' }}>
          <VirtualList entries={entries} rowHeight={LIST_ROW_H} scrollRef={ref}
            renderRow={(e) => <div key={e.dir}>{e.name}</div>}
            onWindow={(paths) => { seenWindow = paths }} />
        </div>
      )
    }
    render(<Probe />)
    mockScrollBox(scrollRef.current, { clientHeight: 400 })
    act(() => { scrollRef.current.dispatchEvent(new Event('scroll')) })
    await flushRaf()

    expect(Array.isArray(seenWindow)).toBe(true)
    expect(seenWindow.length).toBeGreaterThan(0)
    expect(seenWindow.every((p) => p.endsWith('.img.json'))).toBe(true)
  })
})

describe('VirtualIconGrid', () => {
  afterEach(() => cleanup())

  it('ne monte QUE les tuiles visibles + overscan, jamais les N tuiles (anti-freeze 100k)', async () => {
    const entries = makeEntries(100000)
    let scrollRef
    function Probe() {
      const ref = useRef(null)
      scrollRef = ref
      return (
        <div ref={ref} style={{ height: 400, overflow: 'auto' }}>
          <VirtualIconGrid entries={entries} zoom={132} scrollRef={ref}
            renderTile={(e) => <div key={e.dir} data-testid="tile" data-dir={e.dir} />} />
        </div>
      )
    }
    const { container } = render(<Probe />)
    mockScrollBox(scrollRef.current, { clientHeight: 400, clientWidth: 800 })
    act(() => { window.dispatchEvent(new Event('resize')) }) // measure() -> width réel + recompute
    await flushRaf()

    const tiles = container.querySelectorAll('[data-testid="tile"]')
    expect(tiles.length).toBeGreaterThan(0)
    expect(tiles.length).toBeLessThan(200)
  })
})
