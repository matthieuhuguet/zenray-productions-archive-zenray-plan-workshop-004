export function classifyCommitResult(commitStatus, stagedDiffStatus = null) {
  if (commitStatus === 0) return 'committed'
  if (stagedDiffStatus === 0) return 'unchanged'
  return 'failed'
}

export function requireCommitSha(result, label = 'Git') {
  const sha = String(result?.stdout || '').trim()
  if (result?.status !== 0 || !/^[0-9a-f]{40}$/i.test(sha)) {
    throw new Error(`commit ${label} illisible`)
  }
  return sha
}
