import React, { useCallback, useEffect, useRef, useState } from 'react'

const SEEK_KEYS = new Set(['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End', 'PageUp', 'PageDown'])

export function clampSeekFraction(value) {
  const number = Number(value)
  if (!Number.isFinite(number)) return 0
  return Math.max(0, Math.min(1, number))
}

// Contrat de seek unique pour les lecteurs ZenRay :
// - le déplacement reste local pendant le drag (pas de rafale Spotify/YouTube) ;
// - pointerup, pointercancel, capture perdue, clavier et blur valident tous la dernière valeur ;
// - Escape est la seule annulation explicite et ne modifie pas la lecture ;
// - un même geste ne peut produire qu'un seul seek provider.
export default function SeekBar({
  value = 0,
  disabled = false,
  onSeek,
  onPreview,
  onCancel,
  ariaLabel = 'Position de lecture',
  className,
  style,
}) {
  const external = clampSeekFraction(value)
  const externalRef = useRef(external)
  const draftRef = useRef(null)
  const gestureRef = useRef(0)
  const committedGestureRef = useRef(-1)
  const pointerActiveRef = useRef(false)
  const [draft, setDraft] = useState(null)

  useEffect(() => { externalRef.current = external }, [external])

  const begin = useCallback(() => {
    gestureRef.current += 1
    committedGestureRef.current = -1
  }, [])

  const preview = useCallback((raw) => {
    if (disabled) return externalRef.current
    // Une technologie d’assistance peut modifier le range sans pointerdown ni
    // keydown : son premier input ouvre alors un nouveau geste, validé au blur.
    if (draftRef.current == null && committedGestureRef.current === gestureRef.current) begin()
    const next = clampSeekFraction(raw)
    if (draftRef.current !== next) {
      draftRef.current = next
      setDraft(next)
      onPreview?.(next)
    }
    return next
  }, [begin, disabled, onPreview])

  const finish = useCallback((raw) => {
    if (disabled) return
    const gesture = gestureRef.current
    if (committedGestureRef.current === gesture) return
    const next = clampSeekFraction(raw ?? draftRef.current ?? externalRef.current)
    committedGestureRef.current = gesture
    pointerActiveRef.current = false
    draftRef.current = null
    setDraft(null)
    onSeek?.(next)
  }, [disabled, onSeek])

  const cancel = useCallback(() => {
    pointerActiveRef.current = false
    draftRef.current = null
    setDraft(null)
    committedGestureRef.current = gestureRef.current
    onCancel?.()
  }, [onCancel])

  return (
    <input
      aria-label={ariaLabel}
      className={className}
      type="range"
      min="0"
      max="1"
      step="0.001"
      disabled={disabled}
      value={draft == null ? external : draft}
      onPointerDown={(event) => {
        if (disabled) return
        begin()
        pointerActiveRef.current = true
        event.currentTarget.setPointerCapture?.(event.pointerId)
      }}
      onInput={(event) => preview(event.currentTarget.value)}
      onChange={(event) => preview(event.currentTarget.value)}
      onPointerUp={(event) => {
        if (!pointerActiveRef.current) return
        const raw = event.currentTarget.value
        finish(raw)
        if (event.currentTarget.hasPointerCapture?.(event.pointerId)) event.currentTarget.releasePointerCapture(event.pointerId)
      }}
      onPointerCancel={() => finish()}
      onLostPointerCapture={() => { if (pointerActiveRef.current) finish() }}
      onKeyDown={(event) => {
        if (event.key === 'Escape') {
          event.preventDefault()
          cancel()
          return
        }
        if (SEEK_KEYS.has(event.key) && draftRef.current == null) begin()
      }}
      onKeyUp={(event) => { if (SEEK_KEYS.has(event.key)) finish(event.currentTarget.value) }}
      onBlur={() => { if (draftRef.current != null) finish() }}
      style={style}
    />
  )
}
