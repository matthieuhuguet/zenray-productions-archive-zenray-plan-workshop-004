import { afterEach, describe, expect, it, vi } from 'vitest'
import repos from './repos.js'

function response() {
  return {
    statusCode: 200,
    body: null,
    setHeader: vi.fn(),
    status(code) { this.statusCode = code; return this },
    json(value) { this.body = value; return this },
  }
}

describe('GET /api/repos pagination', () => {
  afterEach(() => {
    vi.unstubAllEnvs()
    vi.restoreAllMocks()
  })

  it('inclut les dépôts utiles au-delà de la cinquième page GitHub', async () => {
    vi.stubEnv('GITHUB_TOKEN', 'test-token')
    const pages = Array.from({ length: 5 }, () => Array.from({ length: 100 }, () => ({ name: 'other-repo', size: 0 })))
    pages.push([{ name: 'zenrayshards-img-abcdef123456', size: 1024, private: true }])
    const calls = []
    vi.spyOn(globalThis, 'fetch').mockImplementation(async (url) => {
      const page = Number(new URL(url).searchParams.get('page'))
      calls.push(page)
      return { ok: true, json: async () => pages[page - 1] || [] }
    })

    const res = response()
    await repos({ method: 'GET', query: {}, headers: {} }, res)

    expect(calls).toEqual([1, 2, 3, 4, 5, 6])
    expect(res.body.repos).toHaveLength(1)
    expect(res.body.repos[0].name).toBe('zenrayshards-img-abcdef123456')
    expect(res.body.totalMB).toBe(1)
  })
})
