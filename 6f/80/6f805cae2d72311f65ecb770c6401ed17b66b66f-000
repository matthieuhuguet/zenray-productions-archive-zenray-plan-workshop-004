// 5 October 2026: the production smoke test that would have caught the "0 prospects" regression. It reads the real data through the real
// API, then the real page bundle, and fails (exit code 1) on an empty list, a far smaller list than the repository's, or a missing marker.
// FR : le test de fumee de production qui aurait attrape la regression « 0 prospect » : il relit les vraies donnees par la vraie API, puis le vrai
// bundle de la page, et echoue sur une liste vide, nettement plus petite que celle du depot, ou sans le texte repere.
// Usage: node scripts/Freelance/CheckProduction.mjs [--json] [--site=https://zenray-progress.pages.dev] [--min=300] [--secret=...]
const args = Object.fromEntries(process.argv.slice(2).filter((a) => a.startsWith('--')).map((a) => { const [k, v = 'true'] = a.slice(2).split('='); return [k, v] }))
const site = args.site || 'https://zenray-progress.pages.dev'
const min = Number(args.min || 300)
const secret = args.secret || process.env.ZENRAY_API_SECRET || ''
const MARKERS = ['Lot du jour', 'Mes recherches', 'Autres industries']
const results = []
const check = (name, ok, detail = '') => results.push({ name, ok: Boolean(ok), detail })

async function get(url, headers = {}) {
  const response = await fetch(url, { headers, cache: 'no-store' })
  return { status: response.status, text: await response.text() }
}

try {
  const api = await get(`${site}/api/page?action=read&path=freelance/applications.json`, secret ? { 'x-zr-auth': secret } : {})
  check('api answers', api.status === 200, `HTTP ${api.status}`)
  let studios = null
  try { const body = JSON.parse(api.text); studios = JSON.parse(body.markdown || 'null')?.studios } catch {}
  check('api returns the store (not an empty body)', Array.isArray(studios), api.text.slice(0, 80))
  check(`store holds at least ${min} studios`, Array.isArray(studios) && studios.length >= min, `${studios ? studios.length : 0} studios`)
  const html = await get(`${site}/`)
  const entry = (html.text.match(/assets\/index-[A-Za-z0-9_-]+\.js/) || [])[0]
  check('page entry found', Boolean(entry), entry || 'none')
  let chunk = ''
  if (entry) {
    const main = (await get(`${site}/${entry}`)).text
    const name = (main.match(/FreelanceView-[A-Za-z0-9_-]+\.js/) || [])[0]
    chunk = name ? (await get(`${site}/assets/${name}`)).text : ''
    check('freelance chunk found', Boolean(name), name || 'none')
  }
  for (const marker of MARKERS) check(`page has "${marker}"`, chunk.includes(marker))
} catch (error) { check('check ran', false, error.message) }

const failed = results.filter((r) => !r.ok)
if (args.json) console.log(JSON.stringify({ ok: !failed.length, results }, null, 2))
else for (const r of results) console.log(`${r.ok ? 'OK  ' : 'FAIL'} ${r.name}${r.detail ? ` : ${r.detail}` : ''}`)
process.exit(failed.length ? 1 : 0)
