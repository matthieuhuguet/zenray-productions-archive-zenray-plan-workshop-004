// 10 October 2026, 14:34 UTC: Verify freshness, measured progress, and visible-tab polling.
import { afterEach, describe, expect, it, vi } from 'vitest'
import { activityPercent, createActivitySource, isActivityFresh, readableFileName } from './activitySource.js'

describe('activitySource helpers', () => {
  it('uses only complete, consistent numeric progress values', () => {
    expect(activityPercent({ completedUnits: 1, totalUnits: 4 })).toBe(25)
    expect(activityPercent({ completedBytes: 1024, totalBytes: 2048 })).toBe(50)
    expect(activityPercent({ completedUnits: 5, totalUnits: 4 })).toBeNull()
    expect(activityPercent({ completedUnits: '1', totalUnits: 4 })).toBeNull()
    expect(activityPercent({ completedBytes: 1, totalBytes: 0 })).toBeNull()
  })

  it('keeps only valid activity updated in the last 24 hours', () => {
    const now = Date.parse('2026-10-10T14:34:00Z')
    expect(isActivityFresh({ updatedAt: '2026-10-10T14:33:00Z' }, now)).toBe(true)
    expect(isActivityFresh({ updatedAt: '2026-10-09T14:33:59Z' }, now)).toBe(false)
    expect(isActivityFresh({ updatedAt: 'not-a-date' }, now)).toBe(false)
    expect(isActivityFresh({ updatedAt: '2026-10-10T14:35:00Z' }, now)).toBe(false)
  })

  it('shows only a readable file name when the activity contains a path', () => {
    expect(readableFileName('/Volumes/Drive/Film.mkv')).toBe('Film.mkv')
    expect(readableFileName('')).toBe('')
  })
})

describe('createActivitySource', () => {
  afterEach(() => { vi.useRealTimers() })

  it('polls every five seconds while visible and pauses when hidden', async () => {
    vi.useFakeTimers()
    const listeners = new Map()
    const documentImpl = {
      visibilityState: 'visible',
      addEventListener: (name, fn) => listeners.set(name, fn),
      removeEventListener: (name) => listeners.delete(name),
    }
    const fetchImpl = vi.fn(async () => ({ ok: true, json: async () => ({ active: [], recentFiles: [] }) }))
    const source = createActivitySource({ fetchImpl, documentImpl })
    source.start()
    await vi.waitFor(() => expect(fetchImpl).toHaveBeenCalledTimes(1))
    await vi.advanceTimersByTimeAsync(5000)
    expect(fetchImpl).toHaveBeenCalledTimes(2)

    documentImpl.visibilityState = 'hidden'
    listeners.get('visibilitychange')()
    await vi.advanceTimersByTimeAsync(15000)
    expect(fetchImpl).toHaveBeenCalledTimes(2)

    documentImpl.visibilityState = 'visible'
    listeners.get('visibilitychange')()
    await vi.waitFor(() => expect(fetchImpl).toHaveBeenCalledTimes(3))
    source.stop()
    expect(listeners.has('visibilitychange')).toBe(false)
  })
})
