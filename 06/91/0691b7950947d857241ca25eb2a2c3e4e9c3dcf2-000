// FILES FROM A DROP OR A PICKER, FOLDERS INCLUDED (2 October 2026). A drop can carry whole folders: they are walked (bounded) so a guest can drag a
// folder of photos from their computer and keep its sub-folders. Returns [{ file, rel }] where `rel` is the path inside the dropped folder.
const MAX_FILES = 3000

async function walk(entry, prefix, out) {
  if (out.length >= MAX_FILES) return
  if (entry.isFile) {
    await new Promise((resolve) => entry.file((f) => { out.push({ file: f, rel: `${prefix}${entry.name}` }); resolve() }, resolve))
  } else if (entry.isDirectory) {
    const reader = entry.createReader()
    for (;;) {
      const batch = await new Promise((resolve) => reader.readEntries(resolve, () => resolve([])))
      if (!batch.length) break
      for (const e of batch) await walk(e, `${prefix}${entry.name}/`, out)
    }
  }
}

export async function filesFromDataTransfer(dt) {
  const out = []
  const items = dt && dt.items ? Array.from(dt.items) : []
  const entries = items.map((i) => (i.webkitGetAsEntry ? i.webkitGetAsEntry() : null)).filter(Boolean)
  if (entries.length) { for (const e of entries) await walk(e, '', out); return out }
  return Array.from((dt && dt.files) || []).map((file) => ({ file, rel: file.webkitRelativePath || '' }))
}

/** From an <input type=file>: webkitRelativePath already carries the folder structure. */
export const filesFromInput = (input) => Array.from(input.files || []).map((file) => ({ file, rel: file.webkitRelativePath || '' }))
