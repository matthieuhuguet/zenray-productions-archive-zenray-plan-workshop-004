// Config UNIQUE de publication (partagée UI + serveur). Supprime les hardcodes éparpillés.
// Le serveur peut surcharger via env (WEBSITE_REPO, etc.). L'UI utilise les valeurs par défaut.
export const PUBLISH = {
  websiteRepo: 'matthieuhuguet/ZenRayWebsite',
  websiteBranch: 'master',
  canonicalBaseUrl: 'https://matthieuhuguet.com',
  routeBase: '/reels',
}

// URL publique canonique d'un article live.
export const liveUrlFor = (slug) => `${PUBLISH.canonicalBaseUrl}${PUBLISH.routeBase}/${slug}`

// Slugify partagé (mêmes règles serveur/UI = slug stable).
export const slugify = (s) =>
  (s || 'article').toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '')
    .replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '').slice(0, 60) || 'article'
