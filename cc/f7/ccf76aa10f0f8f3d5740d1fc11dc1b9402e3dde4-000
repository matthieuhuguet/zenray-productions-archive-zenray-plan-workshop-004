// GET /api/upload-cmd?dest=<pages/...>&name=<fichier.mkv>
// Génère la COMMANDE d'upload vidéo (sens entrée, miroir de hls-download-info).
//
// EN CLAIR : le navigateur ne peut pas lire le disque ni lancer ffmpeg. Donc on copie à l'utilisateur
// une commande à coller dans son Terminal. Cette commande lance le transcodage HLS LOCAL (ffmpeg) puis
// pousse les segments chiffrés sur le repo public (jsDelivr) + le manifeste privé, DANS le dossier Create
// où l'utilisateur a cliqué (dest, capturé depuis le fil d'Ariane). Le nom du fichier vient du file picker
// du site ; le chemin est pré-rempli sur ~/Downloads/<nom> (cas fréquent), à ajuster/glisser si ailleurs.

// En local, le serveur tourne depuis la racine du projet (process.cwd()).
// Sur Vercel, process.cwd() = /var/task (cwd serverless) -> le `cd` serait faux sur la machine de l'utilisateur.
// On permet donc de fixer le chemin du repo LOCAL via l'env CMD_ROOT (defini sur Vercel) pour que la commande
// Terminal generee depuis le site deploye soit executable telle quelle sur le Mac de l'utilisateur.
const ROOT = process.env.CMD_ROOT || process.cwd()

// dest autorisé : un dossier sous pages/, sans remontée.
const safeDest = (d) => typeof d === 'string' && d.startsWith('pages') && !d.includes('..') && !d.startsWith('/')
// échappe les guillemets doubles pour une commande shell entre "...".
const shq = (s) => String(s || '').replace(/"/g, '\\"')

export default async function handler(req, res) {
  res.setHeader('Cache-Control', 'no-store')
  const dest = (req.query.dest || 'pages').toString().replace(/\/$/, '')
  if (!safeDest(dest)) return res.status(400).json({ ok: false, error: 'bad-dest' })
  const name = (req.query.name || '').toString().slice(0, 200)
  const proto = (req.headers['x-forwarded-proto'] || 'http')
  const apiBase = `${proto}://${req.headers.host || 'localhost:3100'}`
  // Chemin pré-rempli : ~/Downloads/<nom>. L'utilisateur peut glisser sa vidéo dans le Terminal pour le remplacer.
  const filePath = name ? `$HOME/Downloads/${shq(name)}` : '<CHEMIN_DE_TA_VIDEO>'
  const cmd = `cd "${shq(ROOT)}" && GITHUB_TOKEN=$(gh auth token) node scripts/video-hls.mjs "${filePath}" --push --dest "${shq(dest)}" --api ${apiBase}`
  return res.status(200).json({ ok: true, cmd, dest, name, filePath })
}
