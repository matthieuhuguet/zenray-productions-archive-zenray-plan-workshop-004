import { describe, it, expect } from 'vitest'
import fs from 'node:fs'
import EXERCISES from './exercises.json'
import { SPORT, SPORT_GROUPS } from '../config/sport.js'

describe('base d’exercices Sport', () => {
  it('chaque exercice a un identifiant unique et son image existe dans public/', () => {
    const ids = EXERCISES.map((e) => e.id)
    expect(new Set(ids).size).toBe(ids.length)
    for (const e of EXERCISES) {
      expect(e.image, `${e.id} sans image`).toBeTruthy()
      expect(fs.existsSync(`public${e.image}`), `${e.image} introuvable`).toBe(true)
    }
  })
  it('le programme est numéroté 1, 2, 3… sans trou, dans l’ordre du fichier', () => {
    expect(EXERCISES.map((e) => e.program)).toEqual(EXERCISES.map((_, i) => i + 1))
  })
  it('chaque groupe est connu des filtres et a sa teinte', () => {
    for (const e of EXERCISES) { expect(SPORT_GROUPS).toContain(e.group); expect(SPORT.groupTint[e.group]).toBeTruthy() }
  })
  it('les photos d’objectif listées existent', () => {
    for (const p of SPORT.goalPhotos) expect(fs.existsSync(`public${p.src}`), p.src).toBe(true)
  })
})
