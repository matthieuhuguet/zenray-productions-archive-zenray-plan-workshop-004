// LOT TABLES — undo / redo.
// Principe simple et fiable : on garde une pile de "photos" (snapshots) du contenu de la base.
// Chaque modification empile l'état précédent. Ctrl+Z revient en arrière, Ctrl+Y refait.
// On stocke des clones JSON pour éviter les références partagées.

export function makeHistory(limit = 100) {
  let past = [], future = []
  return {
    push(snapshot) {
      past.push(clone(snapshot))
      if (past.length > limit) past.shift()
      future = []
    },
    canUndo: () => past.length > 0,
    canRedo: () => future.length > 0,
    // undo(current) -> état précédent (et range current dans le futur)
    undo(current) { if (!past.length) return null; future.push(clone(current)); return past.pop() },
    redo(current) { if (!future.length) return null; past.push(clone(current)); return future.pop() },
    reset() { past = []; future = [] },
  }
}
const clone = (o) => JSON.parse(JSON.stringify(o))
