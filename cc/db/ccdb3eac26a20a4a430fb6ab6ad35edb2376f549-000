// WebAssembly codecs for the share preview, Cloudflare Workers build only (2 October 2026).
// The `.wasm` imports below are resolved by wrangler's bundler into compiled WebAssembly modules; they do not exist in
// plain Node, which is why share-cover.js loads this file with a dynamic import and falls back to the stored cover when
// it cannot (local server, tests, Vercel).
import decodeWebp, { init as initWebp } from '@jsquash/webp/decode.js'
import encodeJpeg, { init as initJpeg } from '@jsquash/jpeg/encode.js'
import webpWasm from '@jsquash/webp/codec/dec/webp_dec.wasm'
import jpegWasm from '@jsquash/jpeg/codec/enc/mozjpeg_enc.wasm'

let ready = null
export function codecs() {
  if (!ready) ready = Promise.all([initWebp(webpWasm), initJpeg(jpegWasm)]).then(() => ({ decode: decodeWebp, encode: encodeJpeg })).catch((e) => { ready = null; throw e })
  return ready
}
