#!/usr/bin/env node
// MediaRename.mjs (12 October 2026): the rename phase before an upload. Four verbs, all local, none touches the cloud.
//   node scripts/MediaRename.mjs plan  --root <dir> [--out plan.json] [--alias "Old Title=New Title"] [--flat]
//   node scripts/MediaRename.mjs apply --plan plan.json --approved         (ONLY after Matthieu validated the table)
//   node scripts/MediaRename.mjs undo  --log <dir>/RenameLog.jsonl
//   node scripts/MediaRename.mjs check --upload-plan ReadyUploadPlan.json | --manifests <dir containing pages/>
import fs from 'node:fs'
import path from 'node:path'
import { applyRename, checkParity, planRename, renderPlanTable, undoRename } from './lib/media-rename.mjs'

const argv = process.argv.slice(2)
const verb = argv[0]
const value = (flag) => { const i = argv.indexOf(flag); return i >= 0 ? argv[i + 1] : '' }
const values = (flag) => argv.flatMap((a, i) => (a === flag ? [argv[i + 1]] : []))

try {
  if (verb === 'plan') {
    const aliases = Object.fromEntries(values('--alias').map((pair) => pair.split('=').map((s) => s.trim())))
    const plan = planRename(value('--root'), { aliases, subfolders: !argv.includes('--flat') })
    const out = path.resolve(value('--out') || path.join(plan.root, 'RenamePlan.json'))
    fs.writeFileSync(out, JSON.stringify(plan, null, 2) + '\n')
    console.log(renderPlanTable(plan))
    console.log(`\n${plan.counts.toRename} to rename, ${plan.counts.needReview} to review. Plan: ${out}`)
  } else if (verb === 'apply') {
    const planPath = path.resolve(value('--plan'))
    const plan = JSON.parse(fs.readFileSync(planPath, 'utf8'))
    const result = applyRename(plan, { approved: argv.includes('--approved'), dry: argv.includes('--dry') })
    if (!argv.includes('--dry')) fs.writeFileSync(planPath, JSON.stringify(plan, null, 2) + '\n')
    console.log(JSON.stringify(result))
  } else if (verb === 'undo') {
    console.log(JSON.stringify(undoRename(path.resolve(value('--log')))))
  } else if (verb === 'check') {
    let entries = []
    if (value('--upload-plan')) entries = JSON.parse(fs.readFileSync(value('--upload-plan'), 'utf8')).map((x) => ({ src: x.src, name: x.name, dest: x.dest }))
    else if (value('--manifests')) {
      const walk = (dir) => { for (const e of fs.readdirSync(dir, { withFileTypes: true })) { const f = path.join(dir, e.name); if (e.isDirectory()) { if (e.name !== '.git' && e.name !== '.streams') walk(f) } else if (e.name.endsWith('.media.json')) entries.push({ name: e.name.replace(/\.media\.json$/, ''), dest: path.dirname(f) }) } }
      walk(path.join(path.resolve(value('--manifests')), 'pages'))
    } else throw new Error('check needs --upload-plan or --manifests')
    const report = checkParity(entries)
    console.log(argv.includes('--json') ? JSON.stringify({ ...report, problems: report.problems.slice(0, 25) }, null, 2) : `${report.ok ? 'OK' : 'RED'}: ${report.checked} names checked, ${report.problems.length} problems`)
    process.exitCode = report.ok ? 0 : 1
  } else throw new Error('Usage: plan | apply | undo | check')
} catch (error) { console.error(error?.message || error); process.exit(2) }
