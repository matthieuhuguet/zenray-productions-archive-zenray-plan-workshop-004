// 20 October 2026: the "bindings" list of ZenRay Assets, one row per project that has at least one conversation bound to it.
// Pure: projects and conversations in, rows out, so it is testable. It never invents a link: a conversation without projectId is counted as unbound.
// FR : la liste des liaisons de ZenRay Assets, une ligne par projet qui a au moins une conversation liee. Aucune liaison n'est inventee.
export function bindingsByProject(projects = [], conversations = []) {
  const names = new Map(projects.map((project) => [project.id, project.name]))
  const rows = new Map()
  let unbound = 0
  for (const conversation of conversations) {
    if (!conversation.projectId) { unbound += 1; continue }
    const row = rows.get(conversation.projectId) || { projectId: conversation.projectId, name: names.get(conversation.projectId) || conversation.projectId, known: names.has(conversation.projectId), conversations: [], providers: {} }
    row.conversations.push(conversation)
    row.providers[conversation.provider] = (row.providers[conversation.provider] || 0) + 1
    rows.set(conversation.projectId, row)
  }
  const time = (item) => Date.parse(item.updatedAt) || 0
  const list = [...rows.values()].map((row) => ({ ...row, conversations: row.conversations.sort((a, b) => time(b) - time(a)), lastAt: Math.max(...row.conversations.map(time)) }))
    .sort((a, b) => b.lastAt - a.lastAt)
  return { rows: list, unbound, boundConversations: conversations.length - unbound }
}
