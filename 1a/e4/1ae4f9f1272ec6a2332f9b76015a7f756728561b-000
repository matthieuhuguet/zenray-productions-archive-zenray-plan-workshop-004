export function dashboardSnapshot(result) {
  if (!Array.isArray(result.projects) || !result.checkedAt) throw new Error('Invalid Assets status')
  return { checkedAt: result.checkedAt, projects: result.projects.map(project => ({
    id: project.id, name: project.name, workspace: project.workspace?.state || 'unknown', stats: normalizeStats(project.stats),
    errors: Array.isArray(project.errors) ? project.errors : [project.sync?.error, project.sync?.feedbackError, project.sync?.watchError, project.sync?.sceneAuditError, project.sync?.conversationIndexError].filter(Boolean),
    jobs: (project.jobs || []).map(job => ({ id: job.id, type: job.type, state: job.state, error: job.error || null,
      progress: normalizeProgress(job.progress), detail: progressLabel(job.progress), createdAt: job.createdAt || '' })),
  })).sort((a,b) => activityRank(b) - activityRank(a)
    || (b.stats?.fileCount ?? -1) - (a.stats?.fileCount ?? -1) || a.name.localeCompare(b.name) || a.id.localeCompare(b.id)),
  transferRates: {
    uploadBytesPerSecond: validCount(result.transferRates?.uploadBytesPerSecond) ? result.transferRates.uploadBytesPerSecond : 0,
    downloadBytesPerSecond: validCount(result.transferRates?.downloadBytesPerSecond) ? result.transferRates.downloadBytesPerSecond : 0,
  } }
}
function active(job) { return ['queued','running'].includes(job.state) }
function activityRank(project) { return project.jobs.some(job => job.state === 'running') ? 2 : project.jobs.some(job => job.state === 'queued') ? 1 : 0 }
function validCount(value) { return Number.isSafeInteger(value) && value >= 0 }
function normalizeStats(stats) {
  if (!stats || !['fileCount','macFileCount','cloudFileCount','pendingUploadCount','loadedFileCount','localBytes','cloudBytes'].every(key => validCount(stats[key]))) return null
  return Object.fromEntries(['fileCount','macFileCount','cloudFileCount','pendingUploadCount','loadedFileCount','localBytes','cloudBytes'].map(key => [key, stats[key]]))
}
function normalizeProgress(progress) {
  if (!progress || typeof progress !== 'object') return null
  return Object.fromEntries(['ev','envoyes','recus','done','total','seen','ko'].flatMap(key => {
    const value = progress[key]
    return key === 'ev' ? typeof value === 'string' ? [[key, value]] : [] : validCount(value) ? [[key, value]] : []
  }))
}
export function dashboardTotals(projects) {
  const counted = projects.filter(project => project.stats)
  return {
    projectCount: projects.length,
    countedProjectCount: counted.length,
    fileCount: counted.reduce((sum, project) => sum + project.stats.fileCount, 0),
    macFileCount: counted.reduce((sum, project) => sum + project.stats.macFileCount, 0),
    cloudFileCount: counted.reduce((sum, project) => sum + project.stats.cloudFileCount, 0),
    complete: counted.length === projects.length,
  }
}
export function formatRate(bytesPerSecond) {
  const safeRate = Number.isFinite(bytesPerSecond) && bytesPerSecond > 0 ? bytesPerSecond : 0
  const kilobytes = Math.round(safeRate / 1000)
  return kilobytes < 1000 ? `${kilobytes} KB/s` : `${Math.round(safeRate / 1000000)} MB/s`
}
export function progressLabel(progress) {
  if (!progress) return ''
  const valid = validCount
  if (progress.ev === 'download' && valid(progress.recus)) return `Downloaded: ${progress.recus} bytes received`
  if (progress.ev === 'transfer' && valid(progress.envoyes)) return `Uploaded: ${progress.envoyes} bytes confirmed`
  if (progress.ev === 'chunk' && valid(progress.done) && valid(progress.total) && progress.done <= progress.total) return `Preparing file: ${progress.done} / ${progress.total} bytes`
  if (progress.ev === 'progress' && valid(progress.seen) && valid(progress.total) && progress.seen <= progress.total) return `Files scanned: ${progress.seen} / ${progress.total}`
  if (progress.ev === 'verify') return progress.ko > 0 ? 'Verification failed' : 'Verifying cloud copy'
  if (progress.ev === 'done') return 'Archive phase finished; awaiting operation result'
  return String(progress.ev || '')
}
