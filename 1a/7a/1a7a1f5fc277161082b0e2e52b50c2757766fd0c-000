import { describe, it, expect } from 'vitest'
import { deplacerDansRegistre, deplacerPlusieurs } from './eagleRegistry.js'

const T = '2026-08-31T01:00:00.000Z'
const registre = (over = {}) => ({
  v: 1, type: 'zenray-eagle-resource/v1', resourceId: 'zr_abc', kind: 'img',
  sourcePath: 'pages/A/photo.img.json',
  placements: ['pages/A/photo.img.json', 'pages/Tri/photo.img.json'],
  ...over,
})

describe('deplacerDansRegistre — un déplacement ne casse jamais les références', () => {
  it('déplacer le CANONIQUE bouge sourcePath ET son placement', () => {
    const r = deplacerDansRegistre(registre(), { resourceId: 'zr_abc', from: 'pages/A/photo.img.json', to: 'pages/B/photo.img.json', canonical: true, maintenant: T })
    expect(r.sourcePath).toBe('pages/B/photo.img.json')
    expect(r.placements.sort()).toEqual(['pages/B/photo.img.json', 'pages/Tri/photo.img.json'])
    expect(r.updatedAt).toBe(T)
  })

  it('déplacer un LIEN ne touche JAMAIS sourcePath', () => {
    // Sinon le registre déclarerait qu'un fichier de 150 octets est la source du média, et toutes
    // les autres références pointeraient vers un lien qui pointe vers rien.
    const r = deplacerDansRegistre(registre(), { resourceId: 'zr_abc', from: 'pages/Tri/photo.img.json', to: 'pages/Tri2/photo.img.json', canonical: false, maintenant: T })
    expect(r.sourcePath).toBe('pages/A/photo.img.json')
    expect(r.placements.sort()).toEqual(['pages/A/photo.img.json', 'pages/Tri2/photo.img.json'])
  })

  it('ne modifie pas l’entrée : fonction pure', () => {
    const avant = registre()
    const copie = JSON.parse(JSON.stringify(avant))
    deplacerDansRegistre(avant, { resourceId: 'zr_abc', from: 'pages/A/photo.img.json', to: 'pages/B/photo.img.json', canonical: true, maintenant: T })
    expect(avant).toEqual(copie)
  })

  it('rend null quand le registre ne concerne pas cette ressource', () => {
    expect(deplacerDansRegistre(registre(), { resourceId: 'zr_autre', from: 'a', to: 'b', canonical: true })).toBe(null)
    expect(deplacerDansRegistre(null, { resourceId: 'zr_abc', from: 'a', to: 'b', canonical: true })).toBe(null)
  })

  it('rend null sur un déplacement qui n’en est pas un', () => {
    expect(deplacerDansRegistre(registre(), { resourceId: 'zr_abc', from: 'x', to: 'x', canonical: true })).toBe(null)
    expect(deplacerDansRegistre(registre(), { resourceId: 'zr_abc', from: '', to: 'b', canonical: true })).toBe(null)
  })

  it('un registre SANS liste de placements en reçoit une, déduite de sa source', () => {
    const r = deplacerDansRegistre(registre({ placements: undefined }), { resourceId: 'zr_abc', from: 'pages/A/photo.img.json', to: 'pages/B/photo.img.json', canonical: true, maintenant: T })
    expect(r.placements).toEqual(['pages/B/photo.img.json'])
  })

  it('déplacer le canonique quand sourcePath pointe AILLEURS ne le déplace pas', () => {
    // Cas de l'original promu en infrastructure cachée après suppression : sa source n'est plus là.
    const r = deplacerDansRegistre(registre({ sourcePath: 'pages/.zr-resources/canonical/zr_abc.img.json' }), { resourceId: 'zr_abc', from: 'pages/A/photo.img.json', to: 'pages/B/photo.img.json', canonical: true, maintenant: T })
    expect(r.sourcePath).toBe('pages/.zr-resources/canonical/zr_abc.img.json')
    expect(r.placements).toContain('pages/B/photo.img.json')
  })
})

describe('deplacerPlusieurs — un dossier déplace plusieurs emplacements à la fois', () => {
  it('applique TOUS les mouvements, sans que le dernier écrase les autres', () => {
    // C'est la faute que ce module empêche : écrire le registre après chaque mouvement ferait
    // perdre toutes les mutations sauf la dernière, sans le moindre bruit.
    const r = deplacerPlusieurs(registre(), [
      { resourceId: 'zr_abc', from: 'pages/A/photo.img.json', to: 'pages/B/photo.img.json', canonical: true },
      { resourceId: 'zr_abc', from: 'pages/Tri/photo.img.json', to: 'pages/B/Tri/photo.img.json', canonical: false },
    ], T)
    expect(r.sourcePath).toBe('pages/B/photo.img.json')
    expect(r.placements.sort()).toEqual(['pages/B/Tri/photo.img.json', 'pages/B/photo.img.json'])
  })

  it('rend null si aucun mouvement ne concerne ce registre', () => {
    expect(deplacerPlusieurs(registre(), [{ resourceId: 'zr_autre', from: 'a', to: 'b', canonical: true }], T)).toBe(null)
    expect(deplacerPlusieurs(registre(), [], T)).toBe(null)
  })
})

describe('les dossiers liés portent sourceDir, pas sourcePath', () => {
  const dossier = () => ({
    v: 1, resourceId: 'zr_dir', kind: 'folder',
    sourceDir: 'pages/A/Bundle',
    placements: ['pages/A/Bundle', 'pages/Tri/Bundle'],
  })

  it('déplacer le dossier CANONIQUE bouge sourceDir', () => {
    // Sans ce cas, brancher ce module sur move-tree casserait le déplacement d'un dossier lié.
    const r = deplacerDansRegistre(dossier(), { resourceId: 'zr_dir', from: 'pages/A/Bundle', to: 'pages/B/Bundle', canonical: true, kind: 'folder', maintenant: T })
    expect(r.sourceDir).toBe('pages/B/Bundle')
    expect(r.placements.sort()).toEqual(['pages/B/Bundle', 'pages/Tri/Bundle'])
  })

  it('déplacer un dossier-LIEN ne touche pas sourceDir', () => {
    const r = deplacerDansRegistre(dossier(), { resourceId: 'zr_dir', from: 'pages/Tri/Bundle', to: 'pages/Tri2/Bundle', canonical: false, kind: 'folder', maintenant: T })
    expect(r.sourceDir).toBe('pages/A/Bundle')
  })

  it('une FEUILLE ne touche jamais sourceDir, et un DOSSIER jamais sourcePath', () => {
    const melange = { resourceId: 'zr_x', sourcePath: 'pages/A/f.img.json', sourceDir: 'pages/A/D', placements: [] }
    const feuille = deplacerDansRegistre(melange, { resourceId: 'zr_x', from: 'pages/A/f.img.json', to: 'pages/B/f.img.json', canonical: true, kind: 'leaf', maintenant: T })
    expect(feuille.sourcePath).toBe('pages/B/f.img.json')
    expect(feuille.sourceDir).toBe('pages/A/D')
    const dir = deplacerDansRegistre(melange, { resourceId: 'zr_x', from: 'pages/A/D', to: 'pages/B/D', canonical: true, kind: 'folder', maintenant: T })
    expect(dir.sourceDir).toBe('pages/B/D')
    expect(dir.sourcePath).toBe('pages/A/f.img.json')
  })
})
