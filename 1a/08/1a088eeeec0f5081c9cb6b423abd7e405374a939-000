// 3 October 2026, 12:52 : Inbox: one list of conversations whatever the platform. Meta platforms accept free text only within 24 hours of the
// contact's last message, so the composer says when the window closes instead of letting the send fail. (3 October 2026)
import React, { useState } from 'react'
import { useAction, useQuery } from './usePostKit.js'
import { Badge, Btn, Card, Empty, ErrorLine, Field, PlatformDot, ago, when } from './ui.jsx'

const WINDOW_MS = 24 * 3_600_000

function Simulator({ client, accounts, onDone }) {
  const sandbox = accounts.filter((a) => a.platform === 'sandbox' && a.status === 'CONNECTED')
  const [f, setF] = useState({ accountId: sandbox[0]?.id || '', handle: 'lea', text: 'Hello!', kind: 'message' })
  const act = useAction(onDone)
  if (!sandbox.length) return null
  return (
    <details className="zr-pk-details"><summary>Simulate an inbound message (sandbox)</summary>
      <div className="zr-pk-grid3">
        <Field label="Account"><select value={f.accountId} onChange={(e) => setF({ ...f, accountId: e.target.value })}>{sandbox.map((a) => <option key={a.id} value={a.id}>{a.username}</option>)}</select></Field>
        <Field label="From"><input value={f.handle} onChange={(e) => setF({ ...f, handle: e.target.value })} /></Field>
        <Field label="Kind"><select value={f.kind} onChange={(e) => setF({ ...f, kind: e.target.value })}><option value="message">message</option><option value="story_reply">story reply</option></select></Field>
      </div>
      <div className="zr-pk-inline"><input value={f.text} onChange={(e) => setF({ ...f, text: e.target.value })} aria-label="Message text" /><Btn busy={act.busy} onClick={() => act.run(() => client.post('/v1/sandbox/inject', { accountId: f.accountId, kind: f.kind, handle: f.handle, text: f.text }))}>Send</Btn></div>
      <ErrorLine error={act.error} />
    </details>
  )
}

function Thread({ conv, account, client, reload }) {
  const msgs = useQuery(client, `/v1/inbox/conversations/${conv.id}/messages`)
  const [text, setText] = useState('')
  const act = useAction(async () => { await msgs.reload(); await reload() })
  const windowed = account?.capabilities?.messagingWindow
  const closesAt = windowed && conv.lastInboundAt ? Date.parse(conv.lastInboundAt) + WINDOW_MS : null
  const closed = windowed && (!closesAt || closesAt < Date.now())
  const rows = [...(msgs.data?.messages || [])].reverse()
  return (
    <div className="zr-pk-thread">
      <div className="zr-pk-row"><PlatformDot platform={conv.platform} label={conv.contactName || conv.contactHandle} />{windowed && (closed ? <Badge tone="warn">24 h window closed</Badge> : <Badge tone="ok">free text until {when(new Date(closesAt).toISOString())}</Badge>)}</div>
      <ol className="zr-pk-msgs">{rows.map((m) => <li key={m.id} className={`zr-pk-msg is-${m.direction}`}><span>{m.text}</span><small>{when(m.at)}{m.via && m.via !== 'api' ? ` · ${m.via}` : ''}</small></li>)}</ol>
      {closed && <p className="zr-pk-meta">Free-form replies are refused by the platform now. WhatsApp accepts an approved template; Instagram and Facebook reopen only through a private reply to a comment.</p>}
      <div className="zr-pk-inline"><input value={text} disabled={closed} onChange={(e) => setText(e.target.value)} placeholder={closed ? 'Window closed' : 'Reply (sent at once, no undo)'} aria-label="Reply" /><Btn tone="primary" busy={act.busy} disabled={closed || !text} onClick={() => act.run(async () => { await client.post(`/v1/inbox/conversations/${conv.id}/messages`, { text }); setText('') })}>Send</Btn></div>
      <ErrorLine error={act.error} />
    </div>
  )
}

export default function InboxPanel({ client, overview, reload }) {
  const list = useQuery(client, '/v1/inbox/conversations?limit=100')
  const [sel, setSel] = useState(null)
  const accounts = overview.data.accounts
  const sync = useAction(async () => { await list.reload(); await reload() })
  const convs = list.data?.conversations || []
  const current = convs.find((c) => c.id === sel) || null
  const open = async (c) => { setSel(c.id); if (c.unread) { await client.post(`/v1/inbox/conversations/${c.id}/read`).catch(() => {}); list.reload(); reload() } }
  return (
    <>
      <Card title="Inbox" aside={<Btn busy={sync.busy} onClick={() => sync.run(() => client.post('/v1/inbox/conversations/sync', {}))}>Sync from platforms</Btn>}>
        <ErrorLine error={list.error || sync.error} />
        <div className="zr-pk-split">
          <ul className="zr-pk-list zr-pk-convs">{convs.length === 0 ? <Empty>{list.loading ? 'Loading…' : 'No conversation yet.'}</Empty> : convs.map((c) => (
            <li key={c.id}><button className={`zr-pk-conv${sel === c.id ? ' is-on' : ''}`} onClick={() => open(c)}><div className="zr-pk-row"><PlatformDot platform={c.platform} label={c.contactName || c.contactHandle} />{c.unread && <Badge tone="info">new</Badge>}<span className="zr-pk-spacer" /><span className="zr-pk-when">{ago(c.lastMessageAt)}</span></div><p className="zr-pk-meta">{c.lastMessagePreview}</p></button></li>
          ))}</ul>
          <div>{current ? <Thread key={current.id} conv={current} account={accounts.find((a) => a.id === current.accountId)} client={client} reload={async () => { await list.reload(); await reload() }} /> : <Empty>Select a conversation.</Empty>}</div>
        </div>
      </Card>
      <Card><Simulator client={client} accounts={accounts} onDone={async () => { await list.reload(); await reload() }} /></Card>
    </>
  )
}
