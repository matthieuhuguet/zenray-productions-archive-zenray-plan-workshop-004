// BANC DE MESURE DE L'APERÇU — outil d'atelier, jamais en production.
//
// Il monte le VRAI QuickLookOverlay avec un `/api/page` bouchonné à la latence MESURÉE de la
// production (150-250 ms, relevé au curl le 2026-08-31), et chronomètre le délai entre l'appui sur
// Espace et le premier pixel affiché. C'est la seule façon d'obtenir un chiffre sans le drive.
import React from 'react'
import { createRoot } from 'react-dom/client'
import QuickLookOverlay from './components/QuickLookOverlay.jsx'
import { readImgManifestCached } from './components/ImageNodeViewer.jsx'
import { THEMES } from './theme.js'
import { amorcerIndexLocal } from './search/searchIndexClient.js'

const CHEMIN = 'pages/Photos/DJI/29 Aout 2026/Photos/IMG_5447.jpeg.img.json'
const LATENCE = 200   // ms, mediane mesuree en production

// Une vignette webp minuscule mais VALIDE, en clair (vis public sans chiffrement) : on mesure le
// chemin de l'app, pas la vitesse d'un CDN.
const PIXEL = 'data:image/webp;base64,UklGRiIAAABXRUJQVlA4ICgAAAAwAQCdASoBAAEAAQAcJaQAA3AA/vuUAAA='

const MANIFESTE = {
  type: 'image', v: 1, name: 'IMG_5447.jpeg', ext: 'jpeg', w: 4032, h: 3024, size: 3200000,
  vis: 'public', cdnRepo: 'zenrayshards-img-test', cdnCommit: 'abc123',
  cdnPath: 'x/plein.webp', cdnChunks: [{ path: 'x/y.bin', size: 3200000 }],
  thumb: PIXEL, thumbW: 1440, thumbH: 1080,
}

// L'INDEX EST PEUPLE COMME EN VRAI : il porte l'adresse de la vignette de chaque image, et c'est ce
// que l'apercu consulte desormais AVANT tout appel reseau. Sans lui, le banc mesurerait un chemin
// qui n'existe plus — celui ou l'index est vide.
amorcerIndexLocal({
  paths: Array.from({ length: 200 }, (_, n) => CHEMIN.replace('IMG_5447', 'IMG_' + (5447 + n))),
  thumbs: Object.fromEntries(Array.from({ length: 200 }, (_, n) => [
    CHEMIN.replace('IMG_5447', 'IMG_' + (5447 + n)),
    { u: PIXEL },
  ])),
})

const vrai = window.fetch.bind(window)
window.fetch = async (url, opts) => {
  const u = String(url)
  if (u.includes('/api/page')) {
    await new Promise((r) => setTimeout(r, LATENCE))
    if (u.includes('action=resolve-link')) return new Response(JSON.stringify({ ok: true, path: CHEMIN, linked: false }), { headers: { 'content-type': 'application/json' } })
    if (u.includes('action=read')) return new Response(JSON.stringify({ markdown: JSON.stringify(MANIFESTE) }), { headers: { 'content-type': 'application/json' } })
    return new Response(JSON.stringify({ ok: true }), { headers: { 'content-type': 'application/json' } })
  }
  if (u.includes('cdn.jsdelivr.net')) {
    // Le CDN est hors du peri­metre du banc : on rend le pixel immediatement. Ce qu'on mesure est le
    // cout STRUCTUREL de l'app — montage, resolution, rendu — pas la vitesse d'un CDN.
    const bin = Uint8Array.from(atob(PIXEL.split(',')[1]), (c) => c.charCodeAt(0))
    return new Response(bin, { headers: { 'content-type': 'image/webp' } })
  }
  return vrai(url, opts)
}

const itemPour = (n) => {
  const p = CHEMIN.replace('IMG_5447', 'IMG_' + (5447 + n))
  return { name: 'IMG_' + (5447 + n) + '.jpeg', contentPath: p, dir: p.replace('.img.json', ''), type: 'image', isImage: true }
}

function Banc() {
  const [n, setN] = React.useState(-1)
  React.useEffect(() => {
    // PRÉCHAUFFAGE : simule ce que la grille vient de faire en affichant les vignettes. C'est le cas
    // NOMINAL — celui que Matthieu vit : les images sont À L'ÉCRAN quand il appuie sur Espace.
    window.__prechauffer = async (combien) => {
      for (let i = 0; i < combien; i++) await readImgManifestCached(itemPour(i).contentPath)
      return true
    }
    // Chaque ouverture vise une image DIFFÉRENTE : c'est le parcours à la flèche.
    window.__ouvrir = (i) => { window.__t0 = performance.now(); setN(i) }
    window.__fermer = () => setN(-1)
  }, [])
  return (
    <div style={{ background: '#1d1d1f', minHeight: '100vh' }}>
      {n >= 0 && <QuickLookOverlay key={n} t={THEMES.dark} item={itemPour(n)} prettyName={(x) => x}
        onPrev={() => {}} onNext={() => {}} onClose={() => setN(-1)} onOpen={() => {}} />}
    </div>
  )
}
createRoot(document.getElementById('root')).render(<Banc />)
