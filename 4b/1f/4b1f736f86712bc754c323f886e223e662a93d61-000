// storageInfo.js — extracts from a MANIFEST (media/img/file.json) the "where and how it is stored"
// (2026-07-05, explicit request from Matthieu: see live, for each file, the GitHub repo(s), the part
// count, the owning feature). Source of truth = the manifest itself (no extra network call).
// Consumed by the INDEX view (sidebar) and the right-click "Stockage (Index)" on any media.

const repoOfUrl = (u) => {
  const m = /(?:raw\.githubusercontent\.com|cdn\.jsdelivr\.net\/gh)\/([^/@]+)\/([^/@]+)/.exec(String(u || ''))
  return m ? m[2] : null
}

// manifest type -> site feature (short labels, readable by anyone)
export function featureOf(m, nodePath = '') {
  if (!m || typeof m !== 'object') return 'Inconnu'
  if (m.type === 'youtube') return m.audioOnly ? 'Audio YouTube (widget)' : 'Lien YouTube (zéro stockage)'
  if (m.type === 'gmaps') return 'Google Maps (embed)'
  // FMP4-SINGLE (14 October 2026): add the label of the single fMP4 download parts here. FR : ajouter ici le libelle du telechargement fMP4 unique.
  if (m.type === 'video-raw') return 'Vidéo ZenRayShards (parts 95 Mo, lecture Service Worker)'
  if (m.type === 'blob-raw') return 'Fichier brut ZenRayShards (parts 95 Mo)'
  if (m.type === 'dash' || m.mpd) return 'Vidéo DASH (legacy, segments jsDelivr)'
  if (m.type === 'hls' || m.master) return 'Vidéo HLS (legacy, segments jsDelivr)'
  if (m.type === 'chunked-media') return 'Audio/PDF chunké chiffré (/api/stream)'
  if (/\.img\.json$/.test(nodePath) || m.cdnPath || (Array.isArray(m.cdnChunks) && m.cdnChunks.length)) {
    return (Array.isArray(m.cdnChunks) && m.cdnChunks.length > 1) ? `Image chiffrée (jsDelivr, ${m.cdnChunks.length} morceaux ≤19 Mo)` : 'Image chiffrée (jsDelivr)'
  }
  if (/\.file\.json$/.test(nodePath)) return 'Archive de dossier (chunks)'
  return m.type || 'Média'
}

// -> { feature, size, enc, priv, repos: [{ repo, parts, bytes }], totalParts }
export function storageOf(m, nodePath = '') {
  const out = { feature: featureOf(m, nodePath), size: m && m.size || 0, enc: !!(m && (m.enc || m.alg)), priv: !!(m && m.private), repos: [], totalParts: 0 }
  const byRepo = new Map()
  const add = (repo, bytes = 0) => {
    if (!repo) return
    const cur = byRepo.get(repo) || { repo, parts: 0, bytes: 0 }
    cur.parts++; cur.bytes += bytes || 0
    byRepo.set(repo, cur)
  }
  if (m && Array.isArray(m.parts)) {
    for (const p of m.parts) {
      if (typeof p === 'string') continue // legacy chunked-media: parts = ['000','001',...] (repo via cdnRepo)
      add(repoOfUrl(p.url), p.size)
    }
  }
  if (m && m.cdnRepo) {
    // New image schema (cdnChunks[]): ONE add per real chunk -> exact part count in the UI
    // (instead of always showing "1 part" for an image that actually has several on the repo).
    if (Array.isArray(m.cdnChunks) && m.cdnChunks.length) m.cdnChunks.forEach((_, i) => add(m.cdnRepo, i === 0 ? m.size : 0))
    else add(m.cdnRepo, m.size) // old single-file schema / chunked-media: one carrying repo
  }
  if (m && m.repo && !m.cdnRepo) add(m.repo, m.size) // legacy private media
  out.repos = [...byRepo.values()]
  out.totalParts = out.repos.reduce((a, r) => a + r.parts, 0)
  return out
}

export const fmtBytes = (b) => b >= 1073741824 ? (b / 1073741824).toFixed(2) + ' Go' : b >= 1048576 ? (b / 1048576).toFixed(1) + ' Mo' : Math.max(1, Math.round(b / 1024)) + ' Ko'
