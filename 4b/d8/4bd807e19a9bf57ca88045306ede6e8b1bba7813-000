// 3 October 2026, 13:18 : The platform matrix: what each connector can do and how far it has been verified. The three additions to the original
// PlugKit (website, LinkedIn, ArtStation) are marked, so what is new is never confused with what was reproduced. (3 October 2026)
import React from 'react'
import { POSTKIT } from './postkitConfig.js'
import { Badge, Card, PlatformDot, Verification } from './ui.jsx'

const NEW_HERE = new Set(['website', 'artstation', 'linkedin'])
const COLUMNS = ['publish', 'messaging', 'comments', 'analytics', 'ads', 'stories', 'unpublish']

export default function PlatformsPanel({ overview }) {
  const platforms = overview.data.platforms
  return (
    <Card title="Platforms" aside={<span className="zr-pk-meta">{platforms.length} connectors</span>}>
      <div className="zr-pk-scroll">
        <table className="zr-pk-table zr-pk-matrix">
          <thead><tr><th>Platform</th><th>Verified</th>{COLUMNS.map((c) => <th key={c}>{POSTKIT.capabilityLabels[c]}</th>)}<th>Connection</th></tr></thead>
          <tbody>{platforms.map((p) => (
            <tr key={p.platform}>
              <td><PlatformDot platform={p.platform} label={p.label} />{NEW_HERE.has(p.platform) && <Badge tone="info" title="Not in the original PlugKit (LinkedIn is only half-documented there)">added</Badge>}</td>
              <td><Verification level={p.verification} /></td>
              {COLUMNS.map((c) => <td key={c} className="zr-pk-yes" aria-label={`${p.label} ${c}: ${p.capabilities[c] ? 'yes' : 'no'}`}>{p.capabilities[c] ? 'yes' : <span className="zr-pk-no">·</span>}</td>)}
              <td className="zr-pk-meta">{p.auth}</td>
            </tr>))}</tbody>
        </table>
      </div>
      <ul className="zr-pk-notes">{platforms.filter((p) => p.note).map((p) => <li key={p.platform}><strong>{p.label}.</strong> {p.note}{p.requiredEnv?.length ? <> Needs <code>{p.requiredEnv.join(', ')}</code>.</> : null}</li>)}</ul>
      <div className="zr-pk-chips">{Object.entries(POSTKIT.verification).map(([k, v]) => <span key={k} className="zr-pk-chip"><Verification level={k} /><span className="zr-pk-meta">{v.help}</span></span>)}</div>
    </Card>
  )
}
