import { describe, it, expect, vi } from 'vitest'
import { attendreLaPreuve, ATTENTES } from './attendreLisible.js'

const sansDormir = () => { const vues = []; return { dormir: async (ms) => { vues.push(ms) }, vues } }

describe('attendreLaPreuve — on attend une preuve, pas un chrono', () => {
  it('rend la main AU PREMIER essai quand la chose est déjà là', async () => {
    const d = sansDormir()
    const r = await attendreLaPreuve(() => true, { dormir: d.dormir })
    expect(r).toEqual({ ok: true, essais: 1 })
    expect(d.vues).toEqual([])   // aucune attente inutile : c'est tout l'intérêt
  })

  it('réessaie et réussit dès que la chose apparaît', async () => {
    const d = sansDormir()
    let n = 0
    const r = await attendreLaPreuve(() => ++n >= 3, { dormir: d.dormir })
    expect(r).toEqual({ ok: true, essais: 3 })
    expect(d.vues).toEqual([120, 240])   // exactement deux attentes, doublées
  })

  it('ÉCHOUE proprement au plafond plutôt que de boucler', async () => {
    // Un vérificateur qui ne vire jamais au rouge n'a rien prouvé.
    const d = sansDormir()
    const r = await attendreLaPreuve(() => false, { dormir: d.dormir })
    expect(r).toEqual({ ok: false, essais: ATTENTES.essais })
  })

  it('n’attend PAS après le dernier essai : l’attente finale serait perdue', async () => {
    const d = sansDormir()
    await attendreLaPreuve(() => false, { essais: 3, dormir: d.dormir })
    expect(d.vues).toHaveLength(2)       // trois essais, deux attentes
    expect(d.vues).toEqual([120, 240])
  })

  it('l’attente DOUBLE : marteler un service qui réplique ne l’accélère pas', async () => {
    const d = sansDormir()
    await attendreLaPreuve(() => false, { essais: 5, base: 100, dormir: d.dormir })
    expect(d.vues).toEqual([100, 200, 400, 800])
  })

  it('une sonde qui LÈVE compte comme une absence, elle ne casse pas l’attente', async () => {
    const d = sansDormir()
    let n = 0
    const r = await attendreLaPreuve(() => { if (++n < 2) throw new Error('réseau'); return true }, { dormir: d.dormir })
    expect(r.ok).toBe(true)
    expect(r.essais).toBe(2)
  })

  it('la sonde est appelée exactement autant de fois qu’il y a d’essais', async () => {
    const sonde = vi.fn().mockResolvedValue(false)
    await attendreLaPreuve(sonde, { essais: 4, dormir: async () => {} })
    expect(sonde).toHaveBeenCalledTimes(4)
  })
})
