// 5 October 2026: fixed clock slots (00:00, 06:00, 12:00, 18:00 Europe/Paris) instead of "6 hours after the last run".
// FR : creneaux fixes sur l'horloge (00h, 06h, 12h, 18h, heure de Paris) au lieu de "6 h apres la derniere passe".
const formatters = new Map()
const parts = (date, zone) => {
  if (!formatters.has(zone)) formatters.set(zone, new Intl.DateTimeFormat('en-GB', { timeZone: zone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }))
  const map = Object.fromEntries(formatters.get(zone).formatToParts(date).map((p) => [p.type, p.value]))
  return { hour: Number(map.hour), minute: Number(map.minute) }
}
const isSlot = (date, zone, hours) => { const p = parts(date, zone); return p.minute === 0 && hours.includes(p.hour) }

/** The latest slot instant at or before `date`. */
export function slotAtOrBefore(date, { hours, timeZone }) {
  let t = Math.floor(date.getTime() / 60000) * 60000
  for (let i = 0; i < 24 * 60 + 61; i += 1, t -= 60000) if (isSlot(new Date(t), timeZone, hours)) return new Date(t)
  throw new Error('No schedule slot found')
}

/** The first slot strictly after `date`. */
export function slotAfter(date, { hours, timeZone }) {
  let t = Math.floor(date.getTime() / 60000) * 60000 + 60000
  for (let i = 0; i < 24 * 60 + 61; i += 1, t += 60000) if (isSlot(new Date(t), timeZone, hours)) return new Date(t)
  throw new Error('No schedule slot found')
}
