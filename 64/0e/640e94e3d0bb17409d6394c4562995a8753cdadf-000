// GUEST UPLOAD: every limit and size in ONE place (2 October 2026). Isomorphic (numbers only): imported by the Worker
// (server/guest-upload.js) AND by the browser uploader (src/guest/), so the two can never disagree.
// FR : toutes les limites de l'ajout de photos par les invités, au même endroit, partagées client et serveur.
import { MiB } from './chunkPolicy.js'

export const GUEST = Object.freeze({
  ROUTE: '/api/guest-upload',

  // Limits set by Matthieu on 2 October 2026. They apply ONLY to what comes through a share link; the owner (drive code) has none.
  DAILY_MAX: 1024,                 // photos per UTC day, all guests together
  MAX_PHOTO_BYTES: 95 * MiB,       // per photo

  // Sizes. A request never carries more than REQUEST_BYTES of plaintext: the Worker holds the body, the ciphertext and two
  // base64 copies at once (about 4x), and a Worker has 128 MB. PART_BYTES is one storage chunk (ciphertext = +16 bytes, far
  // below the ~20 MB jsDelivr serving limit).
  PART_BYTES: 8 * MiB,
  REQUEST_BYTES: 10 * MiB,
  REQUEST_PHOTOS: 6,
  FRAME_MAX_BYTES: 12 * MiB,       // hard server cap on one request body
  MIN_PART_BYTES: 1 * MiB,         // the client may shrink chunks down to this when a big photo keeps failing

  // Names
  NAME_MAX: 40,
  SEGMENT_MAX: 40,
  DEPTH_MAX: 3,
  STEM_MAX: 80,

  // Where the state lives (GitHub only: the drive repo itself)
  GUEST_MARKER: '.zrguest.json',
  FOLDER_MARKER: '.zrfolder.json',
  STATE_DIR: '_guest',
  SHARD_ROLLOVER_KB: Math.round(4.3 * 1024 * 1024),

  // Client retry policy: every failure is retried, never shown. Pauses grow, with jitter.
  BACKOFF_MS: [1500, 4000, 9000, 20000, 45000, 60000],
  SPLIT_AFTER_FAILURES: 2,         // after this many failures a batch is split in halves
})

export const IMAGE_EXTS = Object.freeze(['jpg', 'jpeg', 'png', 'webp', 'gif', 'heic', 'heif', 'avif', 'bmp', 'tif', 'tiff'])
