// 7 October 2026: the notifier says how many offers are new and how long ago he was last told; it never fails a pass and sends no mail.
import { describe, it, expect } from 'vitest'
import { mkdtemp, readdir, readFile } from 'node:fs/promises'
import os from 'node:os'
import path from 'node:path'
import { buildDigest, agoLabel, createNotifier } from './Notify.mjs'
import config from './FreelanceConfig.json'

const NOW = new Date('2026-10-07T12:00:00Z')
const report = { added: 12, addedSummary: [
  { name: 'Ripple & Roll', role: 'Technical Artist', score: 89, tier: 'high', lane: 'games', source: 'Hitmarker', country: 'GB', applyUrl: 'https://x/1' },
  { name: 'Film Co', role: 'Houdini FX "Artist"', score: 70, tier: 'high', lane: 'other', source: 'Remotive', country: '', applyUrl: 'https://x/2' },
  { name: 'Studio', role: 'Level Artist', score: 41, tier: 'medium', lane: 'games', source: 'DevQuest', country: '', applyUrl: '' },
] }

describe('digest', () => {
  it('counts, says how long ago, lists the best with links, and flags the lane', () => {
    const d = buildDigest(report, { lastNotifiedAt: '2026-10-07T06:00:00Z', now: NOW, top: 2 })
    expect(d.subtitle).toBe('12 nouvelles offres, il y a 6 h que tu n’avais pas été prévenu')
    expect(d.strong).toBe(2); expect(d.body.split('\n')).toHaveLength(3)
    expect(d.markdown).toContain('- 89 | Ripple & Roll | Technical Artist | jeu vidéo | Hitmarker | GB | https://x/1')
    expect(d.markdown).toContain('autres industries')
    expect(d.markdown).toContain('Les 10 autres sont dans la page.')
  })
  it('says nothing when nothing is new, and says "une" for one', () => {
    expect(buildDigest({ added: 0 }, { now: NOW })).toBeNull()
    expect(buildDigest({ added: 1, addedSummary: [] }, { now: NOW }).subtitle).toBe('1 nouvelle offre')
  })
  it('flags a big first import', () => {
    expect(buildDigest({ added: 400, addedSummary: report.addedSummary }, { now: NOW }).markdown).toContain('Import initial')
  })
  it('agoLabel is coarse and safe', () => {
    expect(agoLabel(null, NOW)).toBe(''); expect(agoLabel('2026-10-07T11:30:00Z', NOW)).toBe('il y a 30 min'); expect(agoLabel('2026-10-04T12:00:00Z', NOW)).toBe('il y a 3 jours'); expect(agoLabel('2030-01-01', NOW)).toBe('')
  })
})

describe('notifier', () => {
  const make = (overrides = {}, exec = async () => ({})) => createNotifier({ config: { ...config, notify: { ...config.notify, ...overrides } }, directory: overrides.dir, exec, now: () => NOW })
  it('writes a dated digest file and calls osascript with an escaped script, no shell', async () => {
    const dir = await mkdtemp(path.join(os.tmpdir(), 'notify-')); const calls = []
    const done = await make({ dir }, async (cmd, args) => { calls.push([cmd, args]) }).notify(report, { lastNotifiedAt: null })
    expect(done.sent).toEqual(['file', 'macos'])
    const files = await readdir(path.join(dir, 'Digests')); expect(files).toHaveLength(1)
    expect(await readFile(path.join(dir, 'Digests', files[0]), 'utf8')).toContain('Technical Artist')
    expect(calls[0][0]).toBe('osascript'); expect(calls[0][1][0]).toBe('-e'); expect(calls[0][1][1]).toContain('display notification')
    expect(calls[0][1][1]).not.toMatch(/[^\\]"Artist"/)
  })
  it('a failing osascript or an unwritable folder never throws', async () => {
    const done = await make({ dir: '/proc/definitely/not/writable' }, async () => { throw new Error('not allowed') }).notify(report)
    expect(Array.isArray(done.sent)).toBe(true)
  })
  it('disabled, or nothing new: nothing is done', async () => {
    let called = 0
    expect((await make({ enabled: false }, async () => { called += 1 }).notify(report)).skipped).toBe('disabled')
    expect((await make({}, async () => { called += 1 }).notify({ added: 0 })).skipped).toBe('nothing new')
    expect(called).toBe(0)
  })
})
