import React, { useState, useMemo } from 'react'
import MeshViewer3D from './MeshViewer3D.jsx'

// Studio de la collection ZenRayAssetsMeshes.
// Bibliotheque de meshes 3D (Static Meshes & Skeletal Meshes pour Unreal Engine et Houdini).
// Visualisation WebGL avec filaire (wireframe), normales, MatCap clay et fiche polycount.
// Zero tiret cadratin.

const P = {
  serif: 'var(--zr-police-serif)',
  sans: 'var(--zr-police-sans)',
  mono: 'var(--zr-police-mono)',
  serifWeight: 350,
  numberWeight: 400,
  accent: '#9A5B3C',
  radius: 8,
}

// Meshes 3D de demonstration reels
const DEFAULT_MESHES = [
  {
    id: 'louisiana-bayou-church-armature',
    name: 'Louisiana Bayou Church Armature & Porch',
    meshType: 'Static Mesh',
    category: 'Architecture',
    targetEngine: 'Unreal Engine 5 · Houdini',
    sourceFile: 'LouisianaBayou_Church_Armature.fbx',
    polycount: 32130,
    vertices: 18450,
    dimensions: '457 × 863 × 633 cm',
    submeshes: 4,
    sampleType: 'church-component',
    summary: 'Structure principale et porche de la chapelle Louisiana Bayou modélisée sous Houdini pour Unreal Engine 5. 32 130 triangles, UV optimisés et 4 slots de matériaux.',
    date: '2026-09-19',
  },
  {
    id: 'procedural-bayou-shutters',
    name: 'Procedural Bayou Shutters',
    meshType: 'Static Mesh',
    category: 'Props',
    targetEngine: 'Unreal Engine 5 · Houdini',
    sourceFile: 'HDA_Procedural_Shutters.fbx',
    polycount: 4800,
    vertices: 2600,
    dimensions: '120 × 220 × 10 cm',
    submeshes: 2,
    sampleType: 'shutters',
    summary: 'Volets a persiennes proceduraux du bayou avec inclinaison et usure parametriques, exportes en fbx pour Unreal.',
    date: '2026-09-14',
  },
  {
    id: 'modular-wooden-stairs',
    name: 'Modular Wooden Porch Stairs',
    meshType: 'Static Mesh',
    category: 'Architecture',
    targetEngine: 'Unreal Engine 5 · Houdini',
    sourceFile: 'HDA_PorchStairs.fbx',
    polycount: 8200,
    vertices: 4500,
    dimensions: '200 × 160 × 320 cm',
    submeshes: 1,
    sampleType: 'stairs',
    summary: 'Escalier d acces procedurale pour perron de chapelle, marches usees et garde-corps asymetrique.',
    date: '2026-09-10',
  },
  {
    id: 'pampa-grass-foliage-cluster',
    name: 'Pampa Grass Foliage Cluster',
    meshType: 'Static Mesh',
    category: 'Végétation',
    targetEngine: 'Unreal Engine 5 (Nanite/LOD)',
    sourceFile: 'PampaGrass_Cluster_LOD0.fbx',
    polycount: 2400,
    vertices: 1520,
    dimensions: '80 × 180 × 80 cm',
    submeshes: 1,
    sampleType: 'church-component',
    summary: 'Touffe d herbe de la pampa du bayou avec cartes de normales pre-calculees et courbure pour le vent.',
    date: '2026-08-25',
  },
]

export default function MeshStudio({ project, t, onBack }) {
  const [selectedMesh, setSelectedMesh] = useState(null)
  const [category, setCategory] = useState('Tout')
  const [typeFilter, setTypeFilter] = useState('Tous')
  const [query, setQuery] = useState('')

  const meshes = useMemo(() => {
    return (project.meshes && project.meshes.length > 0) ? project.meshes : DEFAULT_MESHES
  }, [project.meshes])

  const categories = useMemo(() => {
    return ['Tout', ...new Set(meshes.map((m) => m.category).filter(Boolean))]
  }, [meshes])

  const types = useMemo(() => {
    return ['Tous', ...new Set(meshes.map((m) => m.meshType).filter(Boolean))]
  }, [meshes])

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase()
    return meshes.filter((m) => {
      const matchCat = category === 'Tout' || m.category === category
      const matchType = typeFilter === 'Tous' || m.meshType === typeFilter
      const matchQuery = !q || `${m.name} ${m.summary} ${m.targetEngine} ${m.category}`.toLowerCase().includes(q)
      return matchCat && matchType && matchQuery
    })
  }, [meshes, category, typeFilter, query])

  if (selectedMesh) {
    return (
      <MeshViewer3D
        meshItem={selectedMesh}
        t={t}
        onBack={() => setSelectedMesh(null)}
      />
    )
  }

  return (
    <article style={{ display: 'flex', flexDirection: 'column', gap: 24, fontFamily: P.sans, color: t.textPrimary }}>
      {/* En-tete du studio */}
      <div>
        <button type="button" onClick={onBack}
          style={{ border: 0, background: 'transparent', padding: '4px 0', cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 13 }}>
          ← Tous les projets ZenRay Assets
        </button>
        <header style={{ display: 'flex', alignItems: 'baseline', gap: 16, flexWrap: 'wrap', padding: '14px 0 16px', borderBottom: `1px solid ${t.border}` }}>
          <span style={{ fontSize: 10.5, letterSpacing: '0.13em', textTransform: 'uppercase', color: P.accent }}>
            Bibliothèque 3D
          </span>
          <h1 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 32, letterSpacing: '-0.02em', margin: 0 }}>
            ZenRay Assets <em style={{ fontStyle: 'italic', fontWeight: 300, color: t.textSecondary }}>Meshes</em>
          </h1>
          <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 13, color: t.textSecondary, marginLeft: 'auto' }}>
            {meshes.length} modèles
          </span>
        </header>
        <p style={{ maxWidth: '68ch', fontSize: 15, lineHeight: 1.62, color: t.textSecondary, margin: '14px 0 0' }}>
          Bibliothèque et base de sauvegarde de meshes 3D (Static Meshes et Skeletal Meshes pour Unreal Engine et Houdini).
          Chaque modèle s'inspecte en 3D temps réel avec modes ombré, filaire (wireframe), normales de surface, MatCap clay et fiche polycount.
        </p>
      </div>

      {/* Barre de filtres et recherche */}
      <div style={{ display: 'flex', alignItems: 'center', gap: 20, flexWrap: 'wrap', borderBottom: `1px solid ${t.border}`, paddingBottom: 16 }}>
        {/* Filtres de categorie */}
        <nav style={{ display: 'flex', gap: 14, flexWrap: 'wrap' }}>
          {categories.map((c) => {
            const on = c === category
            return (
              <button key={c} type="button" onClick={() => setCategory(c)}
                style={{ border: 0, background: 'transparent', cursor: 'pointer', padding: '2px 0', fontFamily: P.sans,
                  fontSize: 13, color: on ? P.accent : t.textSecondary, boxShadow: on ? `inset 0 -1px 0 0 ${P.accent}` : undefined }}>
                {c}
              </button>
            )
          })}
        </nav>

        {/* Filtre par type */}
        <div style={{ display: 'flex', alignItems: 'center', gap: 8, fontSize: 12.5, color: t.textSecondary, marginLeft: 'auto' }}>
          <span>Type :</span>
          <select value={typeFilter} onChange={(e) => setTypeFilter(e.target.value)}
            style={{ border: `1px solid ${t.border}`, borderRadius: 6, background: t.cardBg || t.bg, color: t.textPrimary, padding: '4px 8px', fontSize: 12, fontFamily: P.sans }}>
            {types.map((tp) => (
              <option key={tp} value={tp}>{tp}</option>
            ))}
          </select>
        </div>

        {/* Champ de recherche */}
        <label style={{ display: 'flex', alignItems: 'center', gap: 8, border: `1px solid ${t.border}`, borderRadius: 6, padding: '4px 10px', background: t.cardBg || t.bg }}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke={t.textSecondary} strokeWidth="2" strokeLinecap="round">
            <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.6-3.6" />
          </svg>
          <input value={query} onChange={(e) => setQuery(e.target.value)} placeholder="Rechercher un mesh"
            style={{ border: 0, outline: 'none', background: 'transparent', color: t.textPrimary, fontSize: 12.5, fontFamily: P.sans, width: 160 }} />
        </label>
      </div>

      {/* Grille des cartes de meshes */}
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(min(100%, 340px), 1fr))', gap: '30px 24px', paddingTop: 10 }}>
        {filtered.map((mesh) => (
          <button key={mesh.id} type="button" onClick={() => setSelectedMesh(mesh)}
            style={{ display: 'flex', flexDirection: 'column', textAlign: 'left', padding: 0, border: 0, background: 'transparent', cursor: 'pointer', color: 'inherit' }}>
            {/* Vignette simulant l'objet 3D */}
            <div style={{ position: 'relative', width: '100%', aspectRatio: '16 / 10', borderRadius: P.radius, overflow: 'hidden', border: `1px solid ${t.border}`,
              background: 'linear-gradient(145deg, #252428 0%, #151417 100%)', display: 'grid', placeItems: 'center' }}>
              <div style={{ width: '40%', height: '55%', borderRadius: 6, border: '1px solid rgba(255,255,255,0.15)',
                background: 'linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.02) 100%)',
                boxShadow: '0 10px 25px rgba(0,0,0,0.5)' }} />
              <div style={{ position: 'absolute', bottom: 10, right: 10, background: 'rgba(15,15,18,0.75)', backdropFilter: 'blur(6px)',
                padding: '3px 8px', borderRadius: 4, fontSize: 11, fontFamily: P.serif, fontWeight: P.numberWeight, color: '#ffffff' }}>
                {mesh.polycount.toLocaleString('fr-FR')} tris
              </div>
            </div>

            {/* Infos du mesh */}
            <div style={{ display: 'flex', alignItems: 'baseline', gap: 8, padding: '12px 2px 0' }}>
              <span style={{ fontSize: 10.5, letterSpacing: '0.12em', textTransform: 'uppercase', color: P.accent }}>{mesh.category}</span>
              <span style={{ fontSize: 11.5, color: t.textSecondary, marginLeft: 'auto' }}>{mesh.meshType}</span>
            </div>
            <div style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 19, letterSpacing: '-0.015em', lineHeight: 1.25, padding: '4px 2px 0' }}>
              {mesh.name}
            </div>
            <div style={{ fontSize: 12.5, lineHeight: 1.5, color: t.textSecondary, padding: '6px 2px 0', display: '-webkit-box', WebkitLineClamp: 2, WebkitBoxOrient: 'vertical', overflow: 'hidden' }}>
              {mesh.summary}
            </div>

            {/* Fiche rapide : moteur et dimensions */}
            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', padding: '10px 2px 0', fontSize: 11.5, color: t.textSecondary }}>
              <span>{mesh.targetEngine}</span>
              <span style={{ fontFamily: P.mono, fontSize: 11 }}>{mesh.dimensions}</span>
            </div>
          </button>
        ))}
      </div>
    </article>
  )
}
