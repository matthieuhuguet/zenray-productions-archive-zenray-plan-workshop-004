import React, { useState } from 'react'
import { PALETTE } from '../theme.js'

// C35/C37 — cellule typée réutilisable (propriétés Notion + bases). Types : text/number/select/multi/date/checkbox/url/relation.
const FONTS = { sans: "var(--zr-police-sans)" }
export const PROP_TYPES = [['text', 'Texte'], ['number', 'Nombre'], ['formula', 'Formule'], ['select', 'Sélection'], ['multi', 'Multi-select'], ['date', 'Date'], ['checkbox', 'Case'], ['url', 'URL'], ['relation', 'Relation']]

const prettyName = (p) => p.split('/').pop().replace(/\.md$/, '').replace(/-[a-z0-9]{1,4}$/, '').replace(/[-_]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())

// C37 — relation : lie cette page à une ou plusieurs autres pages. value = tableau de chemins. pages = [{path,name}]. onOpenPage(path) navigue.
function RelationCell({ t, value, pages = [], onChange, onOpenPage }) {
  const [q, setQ] = useState('')
  const [open, setOpen] = useState(false)
  const arr = Array.isArray(value) ? value : (value ? [value] : [])
  const matches = q.trim() ? pages.filter((p) => !arr.includes(p.path) && (p.name || p.path).toLowerCase().includes(q.toLowerCase())).slice(0, 8) : []
  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 5, position: 'relative' }}>
      <div style={{ display: 'flex', gap: 5, flexWrap: 'wrap', alignItems: 'center' }}>
        {arr.map((p) => (
          <span key={p} style={{ display: 'inline-flex', alignItems: 'center', gap: 4, background: t.surface, border: `1px solid ${t.border}`, borderRadius: 99, padding: '1px 4px 1px 9px', fontSize: 'var(--zr-ui-sm)' }}>
            <button onClick={() => onOpenPage && onOpenPage(p)} style={{ background: 'transparent', border: 'none', color: PALETTE.primary, cursor: 'pointer', padding: 0, fontSize: 'var(--zr-ui-sm)' }}>▦ {prettyName(p)}</button>
            <button onClick={() => onChange(arr.filter((x) => x !== p))} style={{ background: 'transparent', border: 'none', color: t.textSecondary, cursor: 'pointer', padding: '0 2px', fontSize: 'var(--zr-ui-md)' }}>×</button>
          </span>
        ))}
        <button onClick={() => setOpen((v) => !v)} style={{ background: 'transparent', border: `1px dashed ${t.border}`, color: t.textSecondary, borderRadius: 99, padding: '1px 9px', fontSize: 'var(--zr-ui-sm)', cursor: 'pointer' }}>+ lier</button>
      </div>
      {open && (
        <div style={{ position: 'relative', zIndex: 20 }}>
          <input autoFocus value={q} onChange={(e) => setQ(e.target.value)} placeholder="Chercher une page…" style={{ background: t.surface, border: `1px solid ${t.border}`, borderRadius: 6, color: t.textPrimary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', outline: 'none', padding: '4px 8px', width: 240 }} />
          {matches.length > 0 && (
            <div style={{ position: 'absolute', top: 30, left: 0, background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: 8, boxShadow: '0 8px 24px rgba(0,0,0,0.18)', padding: 4, width: 240, maxHeight: 220, overflowY: 'auto' }}>
              {matches.map((p) => (
                <button key={p.path} onClick={() => { onChange([...arr, p.path]); setQ(''); setOpen(false) }} style={{ display: 'block', width: '100%', textAlign: 'left', background: 'transparent', border: 'none', color: t.textPrimary, cursor: 'pointer', padding: '5px 8px', borderRadius: 5, fontSize: 'var(--zr-ui-sm)' }}>{p.name || prettyName(p.path)}</button>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  )
}

export function TypedCell({ t, type, value, options = [], onChange, placeholder = 'Vide', pages = [], onOpenPage }) {
  const base = { background: 'transparent', border: 'none', outline: 'none', color: t.textPrimary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', width: '100%', padding: 0 }
  if (type === 'relation') return <RelationCell t={t} value={value} pages={pages} onChange={onChange} onOpenPage={onOpenPage} />
  if (type === 'formula') return <span aria-readonly="true" title="Valeur calculée" style={{ ...base, display: 'block', color: value == null || value === '' ? t.textSecondary : t.textPrimary, fontFamily: FONTS.sans }}>{value == null || value === '' ? '—' : String(value)}</span>
  if (type === 'checkbox') return <input type="checkbox" checked={!!value} onChange={(e) => onChange(e.target.checked)} style={{ cursor: 'pointer' }} />
  if (type === 'date') return <input type="date" value={value || ''} onChange={(e) => onChange(e.target.value)} style={{ ...base, color: value ? t.textPrimary : t.textSecondary, cursor: 'pointer' }} />
  if (type === 'number') return <input type="number" value={value ?? ''} placeholder={placeholder} onChange={(e) => onChange(e.target.value)} style={{ ...base, fontFamily: FONTS.sans }} />
  if (type === 'url') return (
    <span style={{ display: 'flex', gap: 6, alignItems: 'center', width: '100%' }}>
      <input value={value || ''} placeholder={placeholder} onChange={(e) => onChange(e.target.value)} style={base} />
      {value && <a href={value} target="_blank" rel="noreferrer" style={{ color: PALETTE.primary, textDecoration: 'none' }}>↗</a>}
    </span>
  )
  if (type === 'select') return (
    <select value={value || ''} onChange={(e) => onChange(e.target.value)} style={{ ...base, cursor: 'pointer' }}>
      <option value="">—</option>
      {options.map((o) => <option key={o} value={o}>{o}</option>)}
    </select>
  )
  if (type === 'multi') {
    const arr = Array.isArray(value) ? value : (value ? [value] : [])
    return (
      <div style={{ display: 'flex', gap: 5, flexWrap: 'wrap' }}>
        {options.length === 0 && <span style={{ color: t.textSecondary, opacity: 0.6, fontSize: 'var(--zr-ui-sm)' }}>définir des options</span>}
        {options.map((o) => { const on = arr.includes(o); return <button key={o} onClick={() => onChange(on ? arr.filter((x) => x !== o) : [...arr, o])} style={{ border: `1px solid ${on ? PALETTE.primary : t.border}`, background: on ? PALETTE.primarySoft : 'transparent', color: on ? PALETTE.primary : t.textSecondary, borderRadius: 99, padding: '1px 9px', fontSize: 'var(--zr-ui-sm)', cursor: 'pointer' }}>{o}</button> })}
      </div>
    )
  }
  return <input value={value ?? ''} placeholder={placeholder} onChange={(e) => onChange(e.target.value)} style={base} />
}
