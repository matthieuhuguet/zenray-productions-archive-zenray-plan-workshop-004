import { describe, expect, it } from 'vitest'
import { classifyCommitResult, requireCommitSha } from './git-result.mjs'

describe('preuve d’un commit Git', () => {
  it('accepte un commit réussi', () => {
    expect(classifyCommitResult(0)).toBe('committed')
  })

  it('accepte un refus seulement si aucune donnée ne reste staged', () => {
    expect(classifyCommitResult(1, 0)).toBe('unchanged')
  })

  it('refuse un commit raté lorsque des données restent staged ou que la preuve échoue', () => {
    expect(classifyCommitResult(1, 1)).toBe('failed')
    expect(classifyCommitResult(null, null)).toBe('failed')
    expect(classifyCommitResult(1, 128)).toBe('failed')
  })
})

describe('preuve d’une empreinte Git', () => {
  it('rend uniquement un HEAD complet issu d’une commande réussie', () => {
    const sha = 'a'.repeat(40)
    expect(requireCommitSha({ status: 0, stdout: ` ${sha}\n` }, 'test')).toBe(sha)
    expect(() => requireCommitSha({ status: 1, stdout: sha }, 'test')).toThrow('commit test illisible')
    expect(() => requireCommitSha({ status: 0, stdout: 'fatal' }, 'test')).toThrow('commit test illisible')
  })
})
