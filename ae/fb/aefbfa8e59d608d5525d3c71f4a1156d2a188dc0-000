// LES GOALS (2026-08-11, demande de Matthieu).
//
// Trois blocs, disposition dictée par lui après avoir montré la référence « Global New Yorker »
// (DD.NYC) : le CLASSEMENT à gauche, les IMAGES à droite, le DESCRIPTIF puis les CITATIONS dessous.
//
// LA COLONNE DE GAUCHE EST UN SÉLECTEUR, pas une liste (précision du 2026-08-11). C'est ce que fait
// la référence et que la première version avait manqué : on y voit cinq continents dont un seul est
// rouge plein, et cliquer en change. Ici, cliquer un axe le met en rouge plein, délave les autres,
// change les images de droite et fait apparaître SON descriptif en bas. Par défaut on ne lit donc
// que quatre titres — « sinon, en règle générale, t'as juste le titre GameDev puis japonais, donc
// japonais un peu grisé ». Les rangs chiffrés et les emojis ont été retirés à sa demande : l'ordre
// de lecture porte déjà le classement, le chiffre le redisait.
//
// DEUX RÈGLES DU PROJET SONT LEVÉES ICI, PAR SA DÉCISION EXPLICITE, ET NULLE PART AILLEURS :
//   · « JAMAIS de gras » (CLAUDE.md, 2026-06-11, plafond 500) — il tranche « garde le gras » après
//     que je lui aie signalé le conflit avec sa propre règle. Le poids lourd EST le sujet de la
//     référence : sans lui il ne reste qu'une liste. La levée s'arrête à ce fichier.
//   · « Serif 80 % pour les titres » (règle 80/15/5) — il tranche « et le sans en fait », conforme
//     à la référence, qui est une grotesque condensée. AnthropicSans, donc, à toutes les tailles.
import React from 'react'
import { readJson, saveJsonWithRetry } from '../lib/saveJson.js'
import { notify } from './Notifications.jsx'
import Icon from './Icon.jsx'

// Le fichier qui porte les citations et les images choisies, sur le drive comme les plans :
// Matthieu change de machine, ses citations le suivent. Les AXES, eux, restent en dur plus bas —
// ils changent une fois par an, et un fichier de configuration pour quatre lignes stables serait
// une pièce mobile de plus à tenir.
export const GOALS_PATH = 'pages/Goals/goals.json'

// LES QUATRE AXES, dans l'ordre que Matthieu a fixé. Le `pourquoi` est son texte, repris mot pour
// mot : c'est lui qui donne au classement sa force, pas la mise en forme. `images` nomme ce qu'il
// veut voir sous chaque axe ; les chemins réels vivent dans `goals.json` (clé `images[axe.cle]`),
// parce qu'une image tient à un fichier du drive, pas à une constante du code.
const AXES = [
  {
    cle: 'gamedev', nom: 'Game Dev',
    pourquoi: 'C’est ton moteur d’autonomie : finir, publier, gagner de l’argent, construire une réputation, une œuvre et une vie que tu contrôles.',
    // DEUX jaquettes, pas trois (choix de Matthieu le 2026-08-11) : Final Fantasy VII Remake est
    // retiré, le cadre se coupe donc en deux volets au lieu de trois.
    veut: ['The Witcher 3', 'Expedition 33'],
    // Servies depuis `public/goals/`, donc EMBARQUÉES avec le site : pas de lien vers un serveur
    // tiers (deux des trois premières trouvées ne se chargeaient pas — `http://` et hotlink bloqué,
    // mesuré le 2026-08-11), pas de dépendance à une clé d'API, rien à téléverser sur le drive.
    // Récupérées via la recherche d'images du site puis converties en AVIF CRF 25, le réglage
    // validé de Matthieu.
    visuels: ['/goals/witcher.avif', '/goals/exp33.avif'],
  },
  {
    cle: 'japonais', nom: 'Japonais',
    pourquoi: 'C’est ton multiplicateur Japon : amitiés, culture, réseau, dating, travail, sentiment d’appartenance. Gros bottleneck actuel.',
    veut: ['Hideo Kojima', 'Miyazaki', 'Ichiban'],
    visuels: ['/goals/kojima.avif', '/goals/miyazaki.avif', { src: '/goals/ichiban.avif', cadrage: '36% center' }],
  },
  {
    cle: 'sport', nom: 'Sport',
    pourquoi: 'Infrastructure biologique. Énergie, santé, physique, confiance. Important mais il n’a pas besoin de monopoliser ta journée.',
    veut: ['Geralt', 'Cloud'],
    visuels: [{ src: '/goals/geralt.avif', cadrage: 'center 18%' }, '/goals/cloud.avif'],
  },
  {
    cle: 'love', nom: 'Japan in love',
    pourquoi: 'À poursuivre activement, mais pas à mettre au centre du système, parce que le résultat dépend aussi d’une autre personne.',
    veut: ['Kasumi', 'Hikari'],
    visuels: ['/goals/kasumi.avif', '/goals/hikari.avif'],
  },
]

// Retire les guillemets que porte souvent le texte sélectionné, de tous types (« », " ", “ ”).
// Au DISPLAY seulement : le fichier garde ce qui a été enregistré, on ne réécrit rien rétroactivement.
const sansGuillemets = (txt) => String(txt || '').replace(/^[\s«"“”']+|[\s»"“”']+$/g, '')

// GRADIENT BLEU-VERT DES TITRES D'AXE (2026-08-12, remplace le rouge éditorial sur retour de
// Matthieu). Une seule chaîne, réutilisée pour l'axe actif ET les autres — le DÉLAVÉ de l'inactif
// n'est plus une couleur différente (l'ancien `color-mix` sur un hex) mais la MÊME image de fond à
// opacité réduite : un dégradé n'a pas d'équivalent `color-mix`, l'opacité est le seul levier qui
// l'éclaircit sans le désaturer bizarrement.
const GRADIENT_AXE = 'linear-gradient(120deg, #2f6fed 0%, #22c98a 100%)'

export default function GoalsView({ t }) {
  const [data, setData] = React.useState(null)      // null = pas encore lu
  const [actif, setActif] = React.useState(AXES[0].cle)
  const shaRef = React.useRef(null)

  React.useEffect(() => {
    let vivant = true
    readJson(GOALS_PATH).then(({ data: lu, sha }) => {
      if (!vivant) return
      shaRef.current = sha
      setData(lu && typeof lu === 'object' ? lu : { v: 1, quotes: [], images: {} })
    }).catch(() => { if (vivant) setData({ v: 1, quotes: [], images: {} }) })
    return () => { vivant = false }
  }, [])

  // Une citation ajoutée AILLEURS (clic droit dans un Markdown) doit apparaître ici sans recharger.
  // Même convention événementielle que le reste du dépôt (`zr:create-music`, `zr:page-float`).
  React.useEffect(() => {
    const surAjout = () => {
      readJson(GOALS_PATH).then(({ data: lu, sha }) => { shaRef.current = sha; if (lu) setData(lu) }).catch(() => {})
    }
    window.addEventListener('zr:goals-changed', surAjout)
    return () => window.removeEventListener('zr:goals-changed', surAjout)
  }, [])

  const retirerCitation = async (id) => {
    const suivant = { ...data, quotes: (data.quotes || []).filter((q) => q.id !== id) }
    setData(suivant)   // optimiste : le geste répond tout de suite, l'écriture suit
    const res = await saveJsonWithRetry(GOALS_PATH, (cur) => ({ ...(cur || {}), v: 1, quotes: (cur?.quotes || []).filter((q) => q.id !== id) }), { sha: shaRef.current, data })
    if (res.ok) shaRef.current = res.sha
    else notify({ kind: 'error', label: 'Goals', title: 'Suppression non enregistrée', body: 'La citation revient au prochain chargement.' })
  }

  const axeActif = AXES.find((a) => a.cle === actif) || AXES[0]
  const citations = (data?.quotes || [])
  // Les visuels EMBARQUÉS (`public/goals/`) d'abord ; `goals.json` peut les surcharger plus tard
  // sans toucher au code, quand Matthieu voudra ses propres images pour un axe.
  const visuelsActifs = (data?.images && data.images[actif]) || axeActif.visuels || []
  // Le nombre de volets SUIT le nombre d'images, il n'est jamais figé à trois : deux jaquettes
  // découpent le cadre en deux, trois en trois. Un axe sans image garde deux emplacements, pour
  // que la composition tienne malgré tout au premier rendu.
  const nbVolets = Math.max(2, visuelsActifs.length || axeActif.veut.length || 2)

  return (
    <div style={{ maxWidth: 1180, margin: '0 auto', padding: 'clamp(28px, 4vw, 44px) 0 clamp(40px, 5vw, 56px)', fontFamily: "var(--zr-police-sans)" }}>

      {/* ─── HAUT : le sélecteur à gauche, les images à droite ───────────────────────────────
          `minmax(0, …)` sur les deux colonnes : sans lui, un titre long pousse la grille au-delà de
          son conteneur au lieu de se replier (piège de grille déjà payé ailleurs dans ce dépôt). */}
      <div style={{ display: 'grid', gridTemplateColumns: 'minmax(0, 1fr) minmax(0, 1fr)', gap: 'clamp(20px, 3vw, 44px)', alignItems: 'start', minHeight: 340 }}>

        <div>

          {AXES.map((axe) => {
            const estActif = axe.cle === actif
            return (
              <button key={axe.cle} type="button" onClick={() => setActif(axe.cle)}
                aria-pressed={estActif}
                style={{
                  display: 'block', width: '100%', textAlign: 'left', padding: '9px 0',
                  border: 0, background: 'transparent', cursor: 'pointer',
                  // BLACK (900, correction du 2026-08-12 : Matthieu revient sur le Semibold, va au
                  // poids maximal de la fonte variable AnthropicSans) et une piste desserrée
                  // (-.015em au lieu de -.038em) : demande explicite de Matthieu, « plus d'espace »
                  // dans la police autant qu'entre les lignes.
                  font: `900 clamp(28px, 3.6vw, 50px)/1.2 var(--zr-police-titre)`,
                  letterSpacing: '-.015em', textTransform: 'uppercase',
                  backgroundImage: GRADIENT_AXE, WebkitBackgroundClip: 'text', backgroundClip: 'text',
                  color: 'transparent', WebkitTextFillColor: 'transparent',
                  opacity: estActif ? 1 : 0.3,
                  transition: 'opacity .18s ease',
                }}>
                {axe.nom}
              </button>
            )
          })}
        </div>

        {/* IMAGES · UN SEUL CADRE 16:9, découpé par un slash. Montage à la Photoshop : le
            séparateur fait ZÉRO pixel, les volets se touchent, aucun filet.
            `clip-path` plutôt que des conteneurs voisins : c'est le seul moyen d'obtenir une arête
            oblique NETTE et PARTAGÉE. Les polygones voisins réutilisent EXACTEMENT les mêmes
            abscisses, ce qui garantit le zéro pixel — un demi-point d'écart laisserait un liseré de
            fond visible entre deux volets.

            CHAQUE IMAGE EST CENTRÉE SUR SA PROPRE TRANCHE (correction du 2026-08-11). Avant, le
            fond couvrait tout le cadre et je le décalais à la main (38/50/58 %) : une valeur
            devinée, et surtout un cadrage calculé sur le rectangle ENTIER, donc jamais sur la
            tranche réellement visible. Désormais chaque volet porte un enfant dimensionné à la
            BOÎTE de sa tranche (obliques comprises), et l'image y est en `cover` centrée. C'est
            exactement « tu prends une ligne, tu la divises en N, tu redivises chaque part en deux »
            : le milieu de chaque part devient le centre de son image. */}
        <div style={{
          position: 'relative', width: '100%', aspectRatio: '16 / 9',
          borderRadius: 4, overflow: 'hidden',
          background: t.cardBg, border: visuelsActifs.length ? 'none' : `1px solid ${t.border}`,
          boxShadow: visuelsActifs.length ? '0 22px 50px -22px rgba(0,0,0,.5)' : 'none',
        }}>
          {Array.from({ length: nbVolets }).map((_, i) => {
            // Un visuel est soit un chemin, soit `{ src, cadrage }` quand son sujet n'est pas au
            // centre de l'image — le cadrage est alors la `background-position` de CE volet.
            // Ajouté le 2026-08-11 : le visage de Geralt était coupé en haut, celui d'Ichiban sur
            // le côté ; un `center center` uniforme ne pouvait pas les rattraper tous les deux.
            const brut = visuelsActifs[i] || null
            const src = typeof brut === 'string' ? brut : (brut && brut.src) || null
            const cadrage = (brut && brut.cadrage) || 'center center'
            const P = 7                        // pente du slash, en % de la largeur
            const pas = 100 / nbVolets
            const g = pas * i                  // frontière gauche, à mi-hauteur
            const d = pas * (i + 1)            // frontière droite, à mi-hauteur
            // Les volets extrêmes vont au bord du cadre ; seules les frontières INTERNES penchent.
            const hg = i === 0 ? 0 : g + P                 // haut-gauche
            const bg = i === 0 ? 0 : g - P                 // bas-gauche
            const hd = i === nbVolets - 1 ? 100 : d + P    // haut-droit
            const bd = i === nbVolets - 1 ? 100 : d - P    // bas-droit
            // Boîte englobante de la tranche : le polygone penche, donc son enveloppe déborde des
            // frontières à mi-hauteur de la pente, des deux côtés.
            const bLeft = Math.min(hg, bg)
            const bRight = Math.max(hd, bd)
            return (
              <div key={i} style={{
                position: 'absolute', inset: 0,
                clipPath: `polygon(${hg}% 0, ${hd}% 0, ${bd}% 100%, ${bg}% 100%)`,
                display: 'grid', placeItems: 'center',
              }}>
                {src ? (
                  <div style={{
                    position: 'absolute', top: 0, bottom: 0,
                    left: `${bLeft}%`, width: `${bRight - bLeft}%`,
                    background: `url(${src}) ${cadrage} / cover no-repeat`,
                  }} />
                ) : (
                  <span style={{ font: `400 11px/1.4 var(--zr-police-sans)`, color: t.textSecondary, textAlign: 'center', padding: 10 }}>
                    {axeActif.veut[i] || ''}
                  </span>
                )}
              </div>
            )
          })}
        </div>
      </div>

      {/* ─── BAS : le descriptif de l'axe choisi, puis les citations ─────────────────────────── */}
      <div style={{ marginTop: 'clamp(32px, 4vw, 56px)', borderTop: `1px solid ${t.border}`, paddingTop: 26 }}>

        {/* LE DESCRIPTIF, en h3 : c'est le titre de niveau du bloc bas, pas un paragraphe
            courant. Medium (500), le plafond de graisse du projet — la levée du « jamais de gras »
            vaut pour les TITRES d'axes en haut, pas pour ce texte-ci. */}
        <h3 style={{
          margin: '0 0 26px', maxWidth: '58ch',
          font: `500 clamp(14px, 1.35vw, 17px)/1.5 var(--zr-police-sans)`, color: t.textPrimary,
        }}>{axeActif.pourquoi}</h3>

        {/* LA SECTION CITATIONS EXISTE, MAIS NE S'ANNONCE PAS (2026-08-11, « tu n'écris pas
            citations »). Une citation se reconnaît sans étiquette ; le libellé, le compteur et la
            source datée ont été retirés dans le même mouvement de dépouillement. */}
        {data === null ? (
          <p style={{ font: `400 13px/1.5 var(--zr-police-sans)`, color: t.textSecondary, margin: 0 }}>lecture…</p>
        ) : citations.length === 0 ? (
          // L'état vide DIT le geste : sans lui, la fonctionnalité existe sans que rien ne l'annonce.
          <p style={{ font: `400 13px/1.6 var(--zr-police-sans)`, color: t.textSecondary, margin: 0, maxWidth: '60ch' }}>
            Sélectionne du texte dans une page Markdown, clic droit, « Envoyer vers Goals ».
          </p>
        ) : (
          <div style={{ display: 'grid', gap: 14 }}>
            {citations.map((q) => (
              <div key={q.id} style={{ display: 'flex', alignItems: 'flex-start', gap: 14 }}>
                {/* Serif gris, 16 px, regular : la citation se lit, elle ne crie pas. Les guillemets
                    ne sont PAS rajoutés — le texte sélectionné les porte souvent déjà, et les
                    doubler donnait « « … » ». `sansGuillemets` nettoie aussi l'existant, sans
                    toucher au fichier : ce qui est enregistré reste tel quel. */}
                <blockquote style={{
                  margin: 0, minWidth: 0, flex: 1,
                  font: `400 16px/1.5 var(--zr-police-serif)`, color: t.textSecondary,
                }}>
                  {sansGuillemets(q.text)}
                </blockquote>
                <button type="button" title="Retirer cette citation" aria-label="Retirer cette citation"
                  onClick={() => retirerCitation(q.id)}
                  style={{
                    flexShrink: 0, width: 26, height: 26, display: 'grid', placeItems: 'center',
                    border: 0, borderRadius: 999, background: 'transparent', color: t.textSecondary, cursor: 'pointer',
                  }}>
                  <Icon name="xmark" size={12} />
                </button>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  )
}

// AJOUT D'UNE CITATION, appelé depuis le menu contextuel de Create (sélection de texte dans un
// Markdown). Exporté ici plutôt qu'écrit dans App.jsx : le CHEMIN et la FORME d'une citation
// appartiennent à cette vue, et les dupliquer ailleurs créerait la seconde source de vérité que ce
// dépôt paie déjà cher quand elle apparaît.
export async function ajouterCitation(texte, source) {
  const propre = String(texte || '').replace(/\s+/g, ' ').trim()
  if (!propre) return false
  const citation = {
    id: `q-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`,
    text: propre, source: source || null, addedAt: new Date().toISOString(),
  }
  // `saveJsonWithRetry` sans `sha` connu : il lit l'état frais lui-même, puis ré-applique la mutation
  // sur conflit. C'est exactement le cas ici — l'appelant (un menu contextuel) n'a jamais lu le
  // fichier, et deux ajouts rapprochés ne doivent pas s'écraser.
  const res = await saveJsonWithRetry(GOALS_PATH, (cur) => ({
    ...(cur || {}), v: 1, quotes: [...((cur && cur.quotes) || []), citation],
  }))
  if (res.ok) {
    window.dispatchEvent(new CustomEvent('zr:goals-changed'))
    notify({ label: 'Goals', title: 'Citation ajoutée', body: propre.length > 70 ? `${propre.slice(0, 70)}…` : propre })
    return true
  }
  notify({ kind: 'error', label: 'Goals', title: 'Citation non enregistrée', body: String(res.error || 'échec de sauvegarde') })
  return false
}
