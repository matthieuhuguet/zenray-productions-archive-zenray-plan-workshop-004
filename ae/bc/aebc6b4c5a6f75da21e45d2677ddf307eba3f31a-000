// ═══ ZENRAY HOUDINI (2026-09-07) ═════════════════════════════════════════════════════════════
//
// Vue dediee au savoir procedural Houdini 22.0.368 et pont Unreal Engine 5.7.
// Respect strict de la regle I-08 : tout code est un HDA, tout reglage visuel sort en curseur.
// Zero tiret cadratin, zero demi-cadratin.

import React, { useState, useMemo } from 'react'
import Icon from '../components/Icon.jsx'
import { HOUDINI_DOMAINS, HOUDINI_CONCEPTS, HOUDINI_PIPELINE_STAGES } from './zenrayHoudiniData.js'
// Vocabulaire moissonne depuis l installation locale (5564 noeuds, 1132 fonctions VEX).
// Charge paresseusement : ses JSON pesent 1 Mio et ne concernent que son propre onglet.
const LazyVocabulary = React.lazy(() => import('./ZenRayHoudiniVocabulary.jsx'))
import './ZenRayHoudini.css'

export default function ZenRayHoudini({ t }) {
  const [view, setView] = useState('concepts') // 'concepts' | 'pipeline' | 'solutions'
  const [domain, setDomain] = useState('all')
  const [search, setSearch] = useState('')
  const [copiedId, setCopiedId] = useState(null)

  const copyText = (id, text) => {
    if (!text) return
    navigator.clipboard?.writeText(text).then(() => {
      setCopiedId(id)
      setTimeout(() => setCopiedId(null), 1800)
    }).catch(() => {})
  }

  // Filtrage reactif par domain et search
  const filteredConcepts = useMemo(() => {
    const q = search.trim().toLowerCase()
    return HOUDINI_CONCEPTS.filter((c) => {
      if (view === 'solutions' && c.domain !== 'hard_won') return false
      if (view === 'concepts' && domain !== 'all' && c.domain !== domain) return false
      if (!q) return true
      return (
        c.term.toLowerCase().includes(q) ||
        c.summary.toLowerCase().includes(q) ||
        c.explanation.toLowerCase().includes(q) ||
        (c.nodes && c.nodes.some((n) => n.toLowerCase().includes(q))) ||
        (c.attributes && c.attributes.some((a) => a.toLowerCase().includes(q))) ||
        (c.vexSnippet && c.vexSnippet.toLowerCase().includes(q))
      )
    })
  }, [view, domain, search])

  return (
    <div className="zhd-scene">
      {/* En-tete */}
      <header className="zhd-header">
        <div className="zhd-titre-bloc">
          <h2 className="zhd-titre">ZenRay <em>Houdini</em></h2>
          <p className="zhd-sub">Usine procedurale, vocabulaire technique & pont Unreal Engine 5.7</p>
        </div>
        <div className="zhd-badge-engine">
          <Icon name="cube" size={14} />
          <span>Houdini 22.0.368 + UE 5.7</span>
        </div>
      </header>

      {/* Barre de navigation interne */}
      <div className="zhd-nav-bar">
        <div className="zhd-tabs">
          <button
            type="button"
            className={`zhd-tab-btn ${view === 'concepts' ? 'active' : ''}`}
            onClick={() => setView('concepts')}
          >
            <Icon name="square.grid.2x2" size={14} />
            <span>Concepts & Vocabulaire ({HOUDINI_CONCEPTS.length})</span>
          </button>
          <button
            type="button"
            className={`zhd-tab-btn ${view === 'solutions' ? 'active' : ''}`}
            onClick={() => setView('solutions')}
          >
            <Icon name="checkmark.seal" size={14} />
            <span>Solutions Dures ({HOUDINI_CONCEPTS.filter((c) => c.domain === 'hard_won').length})</span>
          </button>
          <button
            type="button"
            className={`zhd-tab-btn ${view === 'pipeline' ? 'active' : ''}`}
            onClick={() => setView('pipeline')}
          >
            <Icon name="arrow.triangle.branch" size={14} />
            <span>Pipeline 2 Logiciels</span>
          </button>
          <button
            type="button"
            className={`zhd-tab-btn ${view === 'vocabulary' ? 'active' : ''}`}
            onClick={() => setView('vocabulary')}
          >
            <Icon name="text.book.closed" size={14} />
            <span>Vocabulaire complet</span>
          </button>
        </div>

        {view !== 'pipeline' && view !== 'vocabulary' && (
          <div className="zhd-search-box">
            <Icon name="magnifyingglass" size={14} className="zhd-search-icon" />
            <input
              type="text"
              className="zhd-search-input"
              placeholder="Rechercher un concept, node, VEX..."
              value={search}
              onChange={(e) => setSearch(e.target.value)}
            />
          </div>
        )}
      </div>

      {/* Filtres par domain en view concepts */}
      {view === 'concepts' && (
        <div className="zhd-domain-pills">
          {HOUDINI_DOMAINS.map((d) => (
            <button
              key={d.id}
              type="button"
              className={`zhd-domain-pill ${domain === d.id ? 'active' : ''}`}
              onClick={() => setDomain(d.id)}
            >
              {d.label}
            </button>
          ))}
        </div>
      )}

      {/* Vue Pipeline */}
      {view === 'pipeline' && (
        <div className="zhd-pipeline-container">
          {HOUDINI_PIPELINE_STAGES.map((s) => (
            <div key={s.step} className="zhd-pipeline-card">
              <div className="zhd-pipeline-step-num">{s.step}</div>
              <div className="zhd-pipeline-info">
                <h4>{s.title}</h4>
                <div className="zhd-pipeline-tool">{s.logiciel}</div>
                <p>{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      )}

      {/* Vue Grille de concepts ou solutions dures */}
      {view !== 'pipeline' && view !== 'vocabulary' && (
        <div className="zhd-cards-grid">
          {filteredConcepts.map((c) => (
            <article key={c.id} className="zhd-card">
              <div className="zhd-card-top">
                <h3 className="zhd-card-title">{c.term}</h3>
                <span className="zhd-card-domain-badge">{c.domain}</span>
              </div>

              <p className="zhd-card-summary">{c.summary}</p>

              {/* Badges de nodes et attributs */}
              <div className="zhd-card-meta">
                {c.nodes?.map((n) => (
                  <span key={n} className="zhd-node-badge" title="Node Houdini">{n}</span>
                ))}
                {c.attributes?.map((a) => (
                  <span key={a} className="zhd-attr-badge" title="Attribut manipule">{a}</span>
                ))}
              </div>

              {/* Cible Unreal */}
              {c.unrealTarget && (
                <div className="zhd-card-unreal">
                  <Icon name="arrow.right" size={12} />
                  <span>Cible UE 5.7 : <strong>{c.unrealTarget}</strong></span>
                </div>
              )}

              {/* Explication detaillee */}
              <div className="zhd-card-explanation">
                {c.explanation}
              </div>

              {/* Snippet VEX optionnel */}
              {c.vexSnippet && (
                <div className="zhd-card-code">
                  <button
                    type="button"
                    className="zhd-card-copy-btn"
                    onClick={() => copyText(c.id, c.vexSnippet)}
                  >
                    {copiedId === c.id ? 'Copie !' : 'Copier'}
                  </button>
                  <pre>{c.vexSnippet}</pre>
                </div>
              )}
            </article>
          ))}
          {filteredConcepts.length === 0 && (
            <div style={{ padding: 40, textAlign: 'center', gridColumn: '1 / -1', color: 'var(--g9-muted)' }}>
              Aucun concept ne correspond a la search « {search} ».
            </div>
          )}
        </div>
      )}

      {view === 'vocabulary' && (
        <React.Suspense fallback={<div className="zhd-voc-state">chargement du vocabulaire…</div>}>
          <LazyVocabulary />
        </React.Suspense>
      )}
    </div>
  )
}
