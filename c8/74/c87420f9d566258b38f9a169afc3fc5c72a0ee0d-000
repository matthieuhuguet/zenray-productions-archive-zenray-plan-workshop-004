// 14 October 2026: the palette is the app's single Cmd/Ctrl+K; destinations come first, files after, keyboard and mouse both work.
import React from 'react'
import { afterEach, describe, expect, it, vi } from 'vitest'
import { cleanup, fireEvent, render, screen } from '@testing-library/react'

vi.mock('../search/searchIndexClient.js', () => ({
  loadSearchIndex: async () => ({ paths: ['pages/Plan/Semaine 42.plan.json', 'pages/Photos/DJI/plan-de-vol.jpg.img.json'] }),
  scoreMatch: (np, nn, q) => (np.includes(q) ? 0 : -1),
  getNodeThumb: () => null,
}))
import SpotlightSearch from './SpotlightSearch.jsx'

const t = { cardBg: '#fff', border: '#ddd', accentSoft: '#eef', textPrimary: '#000', textSecondary: '#666', bg: '#fff', surface: '#fff' }
const destinations = [
  { key: 'pages', label: 'Create', zone: 'Create' },
  { key: 'assets', label: 'Assets', zone: 'Create' },
  { key: 'plan', label: 'Plan', zone: 'Create' },
  { key: 'freelance', label: 'Freelance', zone: 'Create' },
]
const open = () => fireEvent.keyDown(window, { key: 'k', metaKey: true })

afterEach(cleanup)

describe('SpotlightSearch as a global palette', () => {
  it('opens with Cmd+K and lists every destination before anything is typed', () => {
    render(<SpotlightSearch t={t} destinations={destinations} onGo={vi.fn()} onNavigate={vi.fn()} />)
    expect(screen.queryByPlaceholderText(/Aller à une vue/)).toBeNull()
    open()
    expect(screen.getByPlaceholderText(/Aller à une vue/)).toBeTruthy()
    const options = screen.getAllByRole('option')
    expect(options.map((option) => option.textContent.replace(/Create$/, ''))).toEqual(['Create', 'Assets', 'Plan', 'Freelance'])
  })

  it('filters destinations as you type and goes to the highlighted one with Enter', async () => {
    const onGo = vi.fn()
    render(<SpotlightSearch t={t} destinations={destinations} onGo={onGo} onNavigate={vi.fn()} />)
    open()
    const input = screen.getByPlaceholderText(/Aller à une vue/)
    fireEvent.change(input, { target: { value: 'free' } })
    expect(screen.getByText('Freelance')).toBeTruthy()
    expect(screen.queryByText('Assets')).toBeNull()
    fireEvent.keyDown(input, { key: 'Enter' })
    expect(onGo).toHaveBeenCalledWith('freelance')
  })

  it('lists matching destinations before files and sends a file to its folder', async () => {
    const onGo = vi.fn(), onNavigate = vi.fn()
    render(<SpotlightSearch t={t} destinations={destinations} onGo={onGo} onNavigate={onNavigate} />)
    open()
    const input = screen.getByPlaceholderText(/Aller à une vue/)
    fireEvent.change(input, { target: { value: 'plan' } })
    await vi.waitFor(() => expect(screen.getByText('Semaine 42.plan.json')).toBeTruthy())
    const options = screen.getAllByRole('option')
    expect(options[0].textContent).toContain('Plan')
    fireEvent.keyDown(input, { key: 'ArrowDown' })
    fireEvent.keyDown(input, { key: 'Enter' })
    expect(onNavigate).toHaveBeenCalledWith('pages/Photos/DJI') // first file hit in path order
    expect(onGo).not.toHaveBeenCalled()
  })

  it('stays a plain file search when no destination handler is given', () => {
    render(<SpotlightSearch t={t} onNavigate={vi.fn()} />)
    open()
    expect(screen.getByPlaceholderText('Rechercher sur tout le site…')).toBeTruthy()
  })
})
