import React, { useState } from 'react'
import RefBoard from '../ref/RefBoard.jsx'
import { typeOfPath } from '../create/node.js'
import { PALETTE } from '../theme.js'

// Renderer EXPLICITE d'un nœud `.canvas.json` (plan §6 Phase 0, §13 P0).
// Garde-fou central : un board Ref s'ouvre ICI, JAMAIS dans l'éditeur Markdown (PageEditorBN).
// Le type guard refuse tout chemin qui n'est pas un .canvas.json -> affichage "non supporté" lisible,
// donc même branché par erreur sur un autre type, ce composant ne corrompt rien.

const SANS = "var(--zr-police-sans)"

export default function CanvasNodeViewer({ t, path, title, theme = 'light' }) {
  const [status, setStatus] = useState('idle')
  const tt = t || { textSecondary: PALETTE.gray600, bg: '#FDFDFC' }

  if (typeOfPath(path) !== 'canvas') {
    return (
      <div style={{ padding: 24, fontFamily: SANS, fontSize: 'var(--zr-ui-md)', color: tt.textSecondary }}>
        Type de nœud non supporté par le board Ref ({String(path)}).
      </div>
    )
  }

  return (
    <div style={{ position: 'relative', width: '100%', height: '100%', minHeight: 0, background: tt.bg }}>
      <RefBoard path={path} theme={theme} onStatus={setStatus} />
      <SaveBadge status={status} t={tt} />
    </div>
  )
}

// Statut discret de sauvegarde (plan §6 Phase 1 : saved/saving/conflict/offline).
function SaveBadge({ status, t }) {
  const map = {
    idle: { label: '', color: t.textSecondary },
    saving: { label: 'Enregistrement…', color: t.textSecondary },
    saved: { label: 'Enregistré', color: PALETTE.green },
    conflict: { label: 'Fusion (autre onglet)…', color: PALETTE.orange },
    offline: { label: 'Hors ligne — réessai', color: PALETTE.orange },
    error: { label: 'Erreur de sauvegarde', color: PALETTE.red },
  }
  const s = map[status] || map.idle
  if (!s.label) return null
  return (
    <div style={{ position: 'absolute', bottom: 12, right: 12, zIndex: 1000, pointerEvents: 'none',
      fontFamily: SANS, fontSize: 'var(--zr-ui-xs)', fontWeight: 600, color: '#fff', background: s.color,
      padding: '4px 10px', borderRadius: 999, boxShadow: '0 2px 8px rgba(0,0,0,0.18)' }}>
      {s.label}
    </div>
  )
}
