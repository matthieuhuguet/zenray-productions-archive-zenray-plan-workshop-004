// 16 October 2026: THE entry point of the application loop ("ZenRay Apply"). One command, nothing to remember.
//   node scripts/Freelance/Apply.mjs 20          prepare the 20 best offers (forms only), pre-fill them, print the ready / blocked table
//   node scripts/Freelance/Apply.mjs 20 --open   same, then open the ready pages in a window to review and send yourself
//   node scripts/Freelance/Apply.mjs open        reopen the ready pages of the last run
//   node scripts/Freelance/Apply.mjs sent        record the last run as sent (after YOU sent them); --ids a,b for only some
//   node scripts/Freelance/Apply.mjs report      timings of the last run
// FR : le point d'entrée unique de la boucle de candidature. Rien n'est envoyé d'ici ; « sent » ne s'utilise qu'après ton envoi.
import path from 'node:path'
import { readdir } from 'node:fs/promises'
import { spawn } from 'node:child_process'
import { parseArgs } from './RecordEmail.mjs'
import { runDirectory } from './ApplyLoop.mjs'

const here = (name) => new URL(name, import.meta.url).pathname
const run = (script, args, { capture = false } = {}) => new Promise((resolve, reject) => {
  const child = spawn('node', [here(script), ...args], { stdio: capture ? ['ignore', 'pipe', 'inherit'] : 'inherit' })
  let out = ''; if (capture) child.stdout.on('data', (d) => { out += d })
  child.on('close', (code) => (code === 0 ? resolve(out) : reject(new Error(`${script} exited with ${code}`))))
})
const lastRun = async () => { const dirs = (await readdir(runDirectory()).catch(() => [])).filter((d) => /^\d{4}-/.test(d)).sort(); if (!dirs.length) throw new Error('No run yet: start with `Apply.mjs 20`'); return path.join(runDirectory(), dirs.at(-1)) }

const [first, ...rest] = process.argv.slice(2)
const args = parseArgs(rest)
if (/^\d+$/.test(first || '')) {
  const packed = JSON.parse(await run('ApplyLoop.mjs', ['pack', '--size', first, '--forms-only', ...(args.lang ? ['--lang', args.lang] : [])], { capture: true }))
  console.error(`queue of ${packed.count} offers ready in ${packed.packSeconds}s`)
  await run('ApplyRun.mjs', ['--run', packed.run, '--concurrency', String(args.concurrency || 6)])
  if (args.open) await run('ApplyRun.mjs', ['--run', packed.run, '--ready-only', '--headed', '--keep', '--concurrency', '8'])
} else if (first === 'open') await run('ApplyRun.mjs', ['--run', await lastRun(), '--ready-only', '--headed', '--keep', '--concurrency', '8'])
else if (first === 'sent') await run('ApplyLoop.mjs', ['mark-sent', '--run', await lastRun(), ...(args.ids ? ['--ids', args.ids] : ['--all'])])
else if (first === 'report') await run('ApplyLoop.mjs', ['report', '--run', await lastRun(), '--remaining', String(args.remaining || 0)])
else throw new Error('Usage: Apply.mjs <N> [--open] | open | sent [--ids a,b] | report')
