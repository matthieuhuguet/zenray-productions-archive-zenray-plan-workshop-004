// 5 October 2026: the daily batch. Out of hundreds of open vacancies, the few worth applying to today: best fit first, one per
// posting (the same role listed in several countries counts once), at most two per studio. Pure functions, nothing is written.
// FR : le lot du jour. Parmi des centaines d'annonces ouvertes, les quelques-unes qui valent une candidature aujourd'hui.
import { countryOf, isClosedStudio, kindOf, scoreOf } from './freelanceEngineModel.js'

// 6 October 2026, 02:47: a three-application batch leaves room for daily production.
// 14 October 2026: 10, 20 and 50 added for a prospecting session (open the whole batch as tabs); 8 and 12 retired.
export const BATCH = { sizes: [3, 5, 10, 20, 50], defaultSize: 3, perStudio: 2, minScore: 40 }

const squash = (text) => String(text || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\([^)]*\)|\[[^\]]*\]/g, ' ').replace(/[^a-z0-9]+/g, ' ').trim()
export const studioKeyOf = (studio) => squash(String(studio.name || '').replace(/\(.*?\)/g, ''))
/** One posting, however many locations it is published for: studio + role without prefix, location tail or fixed-term notes. */
export function postingKey(studio) {
  const role = String(studio.role || '').replace(/^Vivier de candidatures\s*:\s*/i, '').split('|')[0].replace(/\s-\s.*$/, '')
  return `${studioKeyOf(studio)}::${squash(role)}`
}

export const isCandidate = (studio, today, minScore = BATCH.minScore) =>
  studio.status === 'to_contact' && Boolean(studio.engine) && !isClosedStudio(studio, today) && kindOf(studio) !== 'prospect' && kindOf(studio) !== 'spontaneous' && (scoreOf(studio) ?? -1) >= minScore

/** { picked, waiting, duplicates }: `waiting` is what the batch leaves for the next days. */
// 15 October 2026: the sort ends on role then id. Without it, offers equal on score, country, freelance flag and name
// came out in the order the server returned them, so the day batch (3/5/10/20/50 tabs) changed between two refreshes.
// FR : le tri finit sur le rôle puis l'id, pour que le lot du jour ne change pas quand le serveur renvoie un autre ordre.
export function pickBatch(studios, { today, size = BATCH.defaultSize, perStudio = BATCH.perStudio, minScore = BATCH.minScore } = {}) {
  const ranked = studios.filter((studio) => isCandidate(studio, today, minScore))
    .sort((a, b) => (scoreOf(b) - scoreOf(a)) || (countryOf(a).priority - countryOf(b).priority) || (Number(Boolean(b.engine.freelance)) - Number(Boolean(a.engine.freelance))) || String(a.name).localeCompare(String(b.name)) || String(a.role || '').localeCompare(String(b.role || '')) || String(a.id).localeCompare(String(b.id)))
  const seen = new Map(); const unique = []; let duplicates = 0
  for (const studio of ranked) {
    const key = postingKey(studio)
    if (seen.has(key)) { seen.get(key).duplicates += 1; duplicates += 1; continue }
    const entry = { studio, duplicates: 0 }
    seen.set(key, entry); unique.push(entry)
  }
  const perName = new Map(); const picked = []; const waiting = []
  for (const entry of unique) {
    const name = studioKeyOf(entry.studio)
    if (picked.length < size && (perName.get(name) || 0) < perStudio) { picked.push(entry); perName.set(name, (perName.get(name) || 0) + 1) } else waiting.push(entry)
  }
  return { picked, waiting, duplicates }
}

/** How many applications were recorded today, from the messages themselves. */
export const doneToday = (studios, today) => studios.reduce((sum, studio) => sum + (studio.messages || []).filter((message) => String(message.at).slice(0, 10) === today).length, 0)
