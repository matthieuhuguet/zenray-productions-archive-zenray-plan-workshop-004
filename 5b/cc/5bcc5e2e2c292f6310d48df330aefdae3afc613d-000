import { describe, expect, it } from 'vitest'
import { canAdoptSourceHash, enrichStreamManifest, parseLatestGitChanges, sourceHashOfStreamManifest, sourceOfStreamManifest } from './stream-manifest.mjs'

const sha = 'a'.repeat(64)

describe('origine des manifestes streamables', () => {
  it('retrouve une image historique et son empreinte adressée par contenu', () => {
    expect(sourceOfStreamManifest('Photos/a.jpg.img.json', {
      type: 'image', cdnChunks: [`aa/bb/${sha}-000.bin`],
    })).toEqual({ rel: 'Photos/a.jpg', sha256: sha })
  })

  it('retrouve un ancien média malgré son suffixe aléatoire', () => {
    expect(sourceOfStreamManifest('Audio/a.mp3.x7k2ab.media.json', { type: 'chunked-media', name: 'a.mp3' }))
      .toEqual({ rel: 'Audio/a.mp3', sha256: null })
  })

  it('fait foi sur les champs source des nouveaux manifestes', () => {
    const blob = enrichStreamManifest({ path: 'x.media.json', content: JSON.stringify({ type: 'chunked-media' }) }, 'Audio/a.wav', sha)
    expect(sourceOfStreamManifest('nom-transformé.media.json', JSON.parse(blob.content)))
      .toEqual({ rel: 'Audio/a.wav', sha256: sha })
  })

  it('ne croit une empreinte vidéo que si le rail bit à bit la certifie', () => {
    expect(sourceHashOfStreamManifest({ type: 'video-raw', sourceSha256: sha })).toBeNull()
    expect(sourceHashOfStreamManifest({ type: 'video-raw', sourceSha256: sha, sourceExact: true })).toBe(sha)
  })

  it("ne migre un ancien média qu'après la dernière écriture de sa source", () => {
    expect(canAdoptSourceHash({ type: 'chunked-media', size: 12 }, 12, 1_000, 2_000)).toBe(true)
    expect(canAdoptSourceHash({ type: 'chunked-media', size: 12 }, 13, 1_000, 2_000)).toBe(false)
    expect(canAdoptSourceHash({ type: 'video-raw', size: 99 }, 12, 1_000, 2_000)).toBe(false)
    expect(canAdoptSourceHash({ type: 'video-raw', size: 99 }, 12, 3_000, 2_000)).toBe(false)
  })

  it('garde le commit le plus récent de chaque chemin dans un journal git', () => {
    const dates = parseLatestGitChanges('ZRC:20\na.media.json\n\nZRC:10\na.media.json\nb.media.json\n')
    expect(dates.get('a.media.json')).toBe(20_000)
    expect(dates.get('b.media.json')).toBe(10_000)
  })
})
