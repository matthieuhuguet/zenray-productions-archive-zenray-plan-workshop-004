// File kind -> shape family. One table, read everywhere.
const SHAPES = {
  image: 'image', 'image-lib': 'image',
  video: 'video',
  audio: 'audio',
  '3d-lib': '3d', houdini: '3d', bgeo: '3d', 'bgeo.sc': '3d',
  text: 'doc', pdf: 'doc', 'doc-lib': 'doc', 'sheet-lib': 'doc', 'slides-lib': 'doc', 'epub-lib': 'doc',
}
const SHAPE_ICONS = { image: 'photo', video: 'film', audio: 'music.note', '3d': 'square.grid.3x3', doc: 'doc.text', other: 'doc' }
export const shapeOf = (file) => SHAPES[file?.kind] || 'other'

// The source locations a file can live in. Technical names are the only view.
export const SOURCE_DEFS = [
  { id: 'tmp', label: 'tmp', plain: 'tmp', what: 'Travail en cours, essais et captures' },
  { id: 'memory', label: 'Memory', plain: 'Memory', what: 'Suivi, décisions et règles du projet' },
  { id: 'houdini', label: 'Houdini', plain: 'Houdini', what: 'Scènes, outils et rendus' },
  { id: 'unreal', label: 'Unreal', plain: 'Unreal', what: 'Projet et contenu du jeu' },
  { id: 'cloud', label: 'Cloud', plain: 'Cloud', what: 'Sauvegardé dans le cloud, absent des dossiers reliés' },
]
const SOURCE_BY_ID = Object.fromEntries(SOURCE_DEFS.map((definition) => [definition.id, definition]))
export const sourceIdOf = (file, sources = []) => {
  const source = sources.find((item) => item.id && item.id === file.sourceId)
  const id = source?.namespace || file.namespace
  return SOURCE_BY_ID[id] ? id : 'cloud'
}
const VIEW_KEY = 'assets.tubeView'
const readSetting = (key, allowed, fallback) => { try { const value = localStorage.getItem(key); return allowed.includes(value) ? value : fallback } catch { return fallback } }
const writeSetting = (key, value) => { try { localStorage.setItem(key, value) } catch { /* storage may be blocked */ } }

const number = new Intl.NumberFormat('fr-FR')
const shortDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short' })
const dateOf = (value) => { const time = typeof value === 'number' ? value : Date.parse(value); return Number.isFinite(time) ? shortDate.format(time) : null }
const hasThumbnail = (file) => Boolean(file && (file.thumbnailUrl || file.coverUrl || ((file.contentPath || file.cloudPath || file.present) && ['image', 'video'].includes(shapeOf(file)))))
const notInCloud = (file) => ['local-only', 'pending', 'modified', 'error'].includes(file?.status)
const isDownloadable = (file) => file.downloadable !== false && Boolean(file.contentPath || file.cloudPath)
const bytesOf = (files) => files.reduce((sum, file) => sum + (Number.isFinite(file.size) && file.size > 0 ? file.size : 0), 0)
const sizeText = (bytes, count = 1) => bytes > 0 ? readableSize(bytes) : count ? '-' : '0 Ko'
const naturalOrder = (a, b) => String(a).localeCompare(String(b), 'fr', { numeric: true })
// Source folders keep the sidebar order (Brouillons, Notes, Scènes Houdini, Jeu, Archive); other folders are alphabetical.
const sourceRank = (key) => { const index = SOURCE_DEFS.findIndex((definition) => definition.id === key); return index < 0 ? SOURCE_DEFS.length : index }
const rootOrder = (a, b) => sourceRank(a) - sourceRank(b) || naturalOrder(a, b)

// Apple-style spinner, painted UNDER the image: visible until the thumbnail paints over it, never an empty box.
export function TubeSpinner() {
  return <span className="tube-spinner" aria-hidden="true">{Array.from({ length: 12 }, (_, index) => <i key={index} style={{ transform: `rotate(${index * 30}deg)`, animationDelay: `${(index - 12) / 12}s` }} />)}</span>
}

// Stable pastel from a text, for projects that have no image at all.
const hueOf = (text) => { let hash = 0; for (const character of String(text)) hash = (hash * 31 + character.charCodeAt(0)) % 360; return hash }
const initialsOf = (name) => String(name || '?').split(/[\s_-]+/).filter(Boolean).slice(0, 2).map((word) => word[0].toUpperCase()).join('')

function Thumb({ file, shape, renderThumbnail, coverUrl, dot, size = 720, placeholder }) {
  // An image failing anywhere inside (404 from the Mac bridge, broken CDN link) turns the box into its type glyph.
  // Error events do not bubble, so they are caught in the capture phase on the wrapper.
  const [node, setNode] = useState(null)
  const [failed, setFailed] = useState(false)
  useEffect(() => { setFailed(false) }, [file?.id, coverUrl])
  useEffect(() => {
    if (!node) return undefined
    const onError = (event) => { if (event.target?.tagName === 'IMG') setFailed(true) }
    node.addEventListener('error', onError, true)
    return () => node.removeEventListener('error', onError, true)
  }, [node])
  // The shared renderer only mounts when the tile is near the viewport: 120 tiles must not fire 120 manifest reads.
  const [seen, setSeen] = useState(() => typeof IntersectionObserver === 'undefined')
  useEffect(() => {
    if (seen || !node) return undefined
    const observer = new IntersectionObserver((entries) => { if (entries.some((entry) => entry.isIntersecting)) { setSeen(true); observer.disconnect() } }, { rootMargin: '320px' })
    observer.observe(node)
    return () => observer.disconnect()
  }, [seen, node])
  const direct = coverUrl || file?.thumbnailUrl
  // An archived image can have no preview at all (raw file, no thumbnail in its manifest): after a short wait the
  // spinner gives way to the type glyph instead of turning forever. A late image still paints over the glyph.
  const [gaveUp, setGaveUp] = useState(false)
  useEffect(() => {
    if (!seen || direct || gaveUp || !node) return undefined
    const timer = setTimeout(() => {
      const painted = [...node.querySelectorAll('img, canvas')].some((element) => element.tagName === 'CANVAS' || element.naturalWidth > 0)
      if (!painted) setGaveUp(true)
    }, 3500)
    return () => clearTimeout(timer)
  }, [seen, direct, gaveUp, node])
  const loads = !failed && (Boolean(direct) || hasThumbnail(file))
  const extension = String(file?.name || '').includes('.') ? String(file.name).split('.').pop().slice(0, 5).toUpperCase() : ''
  return <span className="tube-thumb" data-shape={shape} data-placeholder={!loads && placeholder ? '' : undefined} ref={setNode} style={!loads && placeholder ? { '--tube-ph-hue': hueOf(placeholder) } : undefined}>
    {(!loads || gaveUp) && !placeholder && <span className="tube-glyph"><Icon name={SHAPE_ICONS[shape] || 'doc'} size={28} />{extension && shape !== 'cover' && <span className="tube-ext">{extension}</span>}</span>}
    {loads && !direct && !gaveUp && <TubeSpinner />}
    {direct && !failed ? <img src={direct} alt="" loading="lazy" decoding="async" /> : loads && seen && renderThumbnail ? renderThumbnail(file, { size, cover: true }) : null}
    {!loads && placeholder && <span className="tube-initials" aria-hidden="true">{initialsOf(placeholder)}</span>}
    {dot && <span className="tube-dot" title="Pas encore dans le cloud" />}
  </span>
}

function projectCount(project) {
  return Number(project.fileCount ?? project.inventory?.fileCount ?? project.counts?.files ?? project.files?.length ?? 0)
}

// ---------------------------------------------------------------- home

export function TubeHome({ projects, conversations = [], onSelect, onConversation, onLinkProject, onAdjustCover, renderThumbnail, loading }) {
  const [collection, setCollection] = useState('projects')
  const [search, setSearch] = useState('')
  const query = search.trim().toLocaleLowerCase('fr')
  const hasCover = (project) => Boolean(project.coverFile || project.coverUrl)
  const projectList = useMemo(() => projects.filter((project) => collection === 'nocover' ? project.category !== 'Conversations' : (project.category === 'Conversations') === (collection === 'conversations'))
    .filter((project) => collection !== 'nocover' || (project.category !== 'Conversations' && !(project.coverFile || project.coverUrl)))
    .filter((project) => !query || `${project.name} ${project.category || ''} ${project.summary || ''}`.toLocaleLowerCase('fr').includes(query))
    .sort(compareProjectsByDateDesc), [projects, collection, query])
  const conversationList = useMemo(() => collection !== 'conversations' ? [] : [...conversations]
    .filter((item) => !query || `${item.title} ${item.provider}`.toLowerCase().includes(query))
    .sort((a, b) => Date.parse(b.updatedAt) - Date.parse(a.updatedAt)), [conversations, collection, query])
  const bindings = useMemo(() => bindingsByProject(projects.filter((project) => project.category !== 'Conversations'), conversations), [projects, conversations])
  const counts = { projects: projects.filter((project) => project.category !== 'Conversations').length, conversations: conversations.length || projects.filter((project) => project.category === 'Conversations').length, nocover: projects.filter((project) => project.category !== 'Conversations' && !hasCover(project)).length, bindings: bindings.rows.length }
  return <section className="tube-home" aria-label="Projets">
    <div className="tube-bar">
      <label className="tube-search"><Icon name="magnifyingglass" size={16} /><input aria-label="Rechercher" value={search} onChange={(event) => setSearch(event.target.value)} placeholder={collection === 'conversations' ? 'Rechercher une conversation' : 'Rechercher un projet'} />{search && <button type="button" aria-label="Effacer" onClick={() => setSearch('')}><Icon name="xmark" size={13} /></button>}</label>
      {onLinkProject && <button type="button" className="tube-round" title="Relier un projet" aria-label="Relier un projet" onClick={onLinkProject}><Icon name="plus" size={16} /></button>}
    </div>
    <div className="tube-chips" role="group" aria-label="Collections">{[['projects', 'Projets'], ['conversations', 'Conversations'], ['bindings', 'Liens projets'], ...(counts.nocover ? [['nocover', 'Sans miniature']] : [])].map(([id, label]) => <button type="button" key={id} className="tube-chip" aria-pressed={collection === id} onClick={() => setCollection(id)}>{label} <span className="assets-number">{number.format(counts[id])}</span></button>)}</div>
    {collection === 'bindings' && <div className="tube-bindings" role="list" aria-label="Projets et conversations liées">
      {bindings.rows.filter((row) => !query || `${row.name} ${row.conversations.map((item) => item.title).join(' ')}`.toLocaleLowerCase('fr').includes(query)).map((row) => <details className="tube-binding" key={row.projectId} role="listitem">
        <summary>
          <span className="tube-binding-name">{row.known ? <button type="button" onClick={(event) => { event.preventDefault(); onSelect(row.projectId) }}>{row.name}</button> : <span title="Projet absent de la liste">{row.name}</span>}</span>
          <span className="tube-binding-providers">{Object.entries(row.providers).map(([provider, count]) => <span key={provider} className="tube-binding-provider"><ConversationBadge provider={provider} /><span className="assets-number">{count}</span></span>)}</span>
          <span className="tube-meta assets-number">{number.format(row.conversations.length)} · {dateOf(row.lastAt)}</span>
        </summary>
        <ul>{row.conversations.map((item) => <li key={item.id}><button type="button" onClick={() => onConversation?.(item)}><ConversationBadge provider={item.provider} /><span>{item.title}</span><span className="tube-meta assets-number">{dateOf(item.updatedAt)}</span></button></li>)}</ul>
      </details>)}
      <p className="tube-meta">{number.format(bindings.boundConversations)} conversations liées à {number.format(bindings.rows.length)} projets · {number.format(bindings.unbound)} sans projet</p>
    </div>}
    <div className="tube-grid">
      {projectList.map((project) => {
        const date = dateOf(projectActivityTime(project) || project.date || project.updatedAt)
        return <button type="button" className="tube-card" key={project.id} onClick={() => onSelect(project.id)} onContextMenu={(event) => { event.preventDefault(); onAdjustCover?.(project) }} title="Clic droit pour modifier la miniature">
          <Thumb file={project.coverFile} shape="cover" coverUrl={project.coverUrl || project.coverFile?.thumbnailUrl} renderThumbnail={renderThumbnail} dot={project.sync?.pendingCount > 0} placeholder={project.name} size={720} />
          <span className="tube-title">{project.name}</span>
          <span className="tube-meta"><span className="assets-number">{number.format(projectCount(project))}</span>{date && <> · <span className="assets-number">{date}</span></>}</span>
        </button>
      })}
      {conversationList.map((item) => <button type="button" className="tube-card tube-card-text" key={item.id} onClick={() => onConversation?.(item)}>
        <span className="tube-thumb" data-shape="cover"><span className="tube-glyph"><ConversationBadge provider={item.provider} /></span></span>
        <span className="tube-title">{item.title}</span>
        <span className="tube-meta assets-number">{dateOf(item.updatedAt)}</span>
      </button>)}
      {/* While the catalogue is still arriving, placeholder cards say "more is coming" instead of an empty end. */}
      {loading && Array.from({ length: projectList.length ? 4 : 8 }, (_, index) => <div className="tube-card" key={`loading-${index}`} aria-hidden="true"><span className="tube-thumb" data-shape="cover"><TubeSpinner /></span><span className="tube-skeleton" /></div>)}
    </div>
    {!loading && collection !== 'bindings' && !projectList.length && !conversationList.length && <p className="tube-empty">{projects.length ? 'Rien ne correspond.' : 'Votre premier projet apparaît ici.'}</p>}
  </section>
}

