// Right click on an image opens this small menu: it sets (or removes) the thumbnail of the project, or adjusts framing.
function CoverMenu({ menu, isCover, themeVars, onSet, onClear, onAdjust, onClose }) {
  useEffect(() => {
    const close = () => onClose()
    const key = (event) => { if (event.key === 'Escape') onClose() }
    window.addEventListener('keydown', key); window.addEventListener('blur', close); window.addEventListener('resize', close)
    return () => { window.removeEventListener('keydown', key); window.removeEventListener('blur', close); window.removeEventListener('resize', close) }
  }, [onClose])
  const left = Math.max(8, Math.min(menu.x, (typeof window === 'undefined' ? menu.x : window.innerWidth) - 270))
  const top = Math.max(8, Math.min(menu.y, (typeof window === 'undefined' ? menu.y : window.innerHeight) - 150))
  return createPortal(<div className="tube-menu-root" style={themeVars} onClick={onClose} onContextMenu={(event) => { event.preventDefault(); onClose() }}>
    <div className="tube-menu" style={{ left, top }} role="menu" aria-label={`Actions pour ${menu.file.name}`}>
      <button type="button" role="menuitem" onClick={() => onSet(menu.file)}><Icon name="photo" size={14} />Définir comme miniature du projet</button>
      {onAdjust && <button type="button" role="menuitem" onClick={() => onAdjust(menu.file)}><Icon name="slider.horizontal.3" size={14} />Ajuster le cadrage…</button>}
      {isCover && <button type="button" role="menuitem" onClick={onClear}><Icon name="xmark" size={14} />Retirer cette miniature</button>}
    </div>
  </div>, document.body)
}

