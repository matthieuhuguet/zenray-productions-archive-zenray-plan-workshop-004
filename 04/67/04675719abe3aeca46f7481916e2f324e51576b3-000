// Folder tree of a file list. `rootKey(file)` gives the top level; the rest comes from the relative path.
function treeOf(files, prefix) {
  const root = { name: '', folders: new Map(), files: [] }
  for (const file of files) {
    const parts = [...prefix(file), ...String(file.relativePath || file.name).split('/').filter(Boolean)]
    parts.pop()
    let node = root
    for (const part of parts) {
      if (!node.folders.has(part)) node.folders.set(part, { name: part, folders: new Map(), files: [] })
      node = node.folders.get(part)
    }
    node.files.push(file)
  }
  return root
}
const subtreeFiles = (node) => [...node.files, ...[...node.folders.values()].flatMap(subtreeFiles)]

function Columns({ tree, path, onPath, fileId, onFile, onOpen, nameOf, renderThumbnail }) {
  const nodes = [tree]
  for (const key of path) { const next = nodes[nodes.length - 1].folders.get(key); if (!next) break; nodes.push(next) }
  const last = nodes[nodes.length - 1]
  const chosen = last.files.find((file) => file.id === fileId)
  return <div className="tube-columns">
    {nodes.map((node, depth) => <div className="tube-col" key={depth}>
      {[...node.folders.keys()].sort(depth === 0 ? rootOrder : naturalOrder).map((key) => <button type="button" key={`d:${key}`} className="tube-ci" data-on={path[depth] === key} onClick={() => { onPath([...path.slice(0, depth), key]); onFile(null) }}><Icon name="folder" size={14} /><span>{depth === 0 ? nameOf(key) : key}</span><Icon name="chevron.right" size={11} /></button>)}
      {[...node.files].sort((a, b) => naturalOrder(a.name, b.name)).map((file) => <button type="button" key={file.id} className="tube-ci" data-on={depth === nodes.length - 1 && fileId === file.id} onClick={() => { onPath(path.slice(0, depth)); onFile(file.id) }}><span>{file.name}</span></button>)}
    </div>)}
    <div className="tube-col-preview">{chosen
      ? <><button type="button" className="tube-preview-thumb" onClick={() => onOpen(chosen)}><Thumb file={chosen} shape={shapeOf(chosen)} renderThumbnail={renderThumbnail} size={360} /></button><strong>{chosen.name}</strong><span className="assets-number">{Number.isFinite(chosen.size) ? sizeText(chosen.size) : '—'}</span></>
      : <span>Choisissez un fichier</span>}</div>
  </div>
}

// The filmstrip mounts only a window around the focused file: a project can hold thousands of files.
const STRIP_RADIUS = 30
function Gallery({ files, focusId, onFocus, onOpen, onMenu, renderThumbnail, srcOf, nameOf }) {
  const index = Math.max(0, files.findIndex((file) => file.id === focusId))
  const focus = files[index]
  const move = (delta) => { const next = files[Math.max(0, Math.min(files.length - 1, index + delta))]; if (next) onFocus(next.id) }
  if (!focus) return null
  return <div className="tube-gallery" tabIndex={0} onKeyDown={(event) => { if (event.key === 'ArrowRight') { event.preventDefault(); move(1) } else if (event.key === 'ArrowLeft') { event.preventDefault(); move(-1) } }}>
    <button type="button" className="tube-stage" onClick={() => onOpen(focus)} onContextMenu={(event) => onMenu?.(event, focus)} aria-label={`Aperçu de ${focus.name}`}><Thumb file={focus} shape={shapeOf(focus)} renderThumbnail={renderThumbnail} size={900} /></button>
    <div className="tube-stage-cap"><span>{focus.name}</span><span><i className="tube-src-dot" data-src={srcOf.get(focus.id)} /> {nameOf(srcOf.get(focus.id))} · <span className="assets-number">{Number.isFinite(focus.size) ? sizeText(focus.size) : '—'}</span></span></div>
    <div className="tube-strip">{files.slice(Math.max(0, index - STRIP_RADIUS), index + STRIP_RADIUS + 1).map((file) => <button type="button" key={file.id} data-on={file.id === focus.id} aria-label={file.name} title={file.name} onClick={() => onFocus(file.id)}><Thumb file={file} shape="image" renderThumbnail={renderThumbnail} size={96} /></button>)}</div>
  </div>
}

// The download sheet mirrors what the ZIP really contains: namespace / sourceId / relative path.
function SheetTree({ node, depth, nameOf }) {
  return <>
    {[...node.folders.entries()].sort(([a], [b]) => naturalOrder(a, b)).map(([key, child]) => {
      const inside = subtreeFiles(child)
      return <details className="tube-tr" key={key} open={depth < 1}>
        <summary><Icon name="folder" size={14} /><span className="tube-tr-name">{depth === 0 ? nameOf(key) : key}</span><span className="tube-tr-sz"><span className="assets-number">{number.format(inside.length)}</span> · <span className="assets-number">{sizeText(bytesOf(inside), inside.length)}</span></span></summary>
        <div className="tube-tr-kids"><SheetTree node={child} depth={depth + 1} nameOf={nameOf} /></div>
      </details>
    })}
    {[...node.files].sort((a, b) => naturalOrder(a.name, b.name)).map((file) => <div className="tube-tr-file" key={file.id}><span className="tube-tr-name">{file.name}</span><span className="tube-tr-sz assets-number">{Number.isFinite(file.size) ? sizeText(file.size) : '—'}</span></div>)}
  </>
}

function DownloadSheet({ project, files, selectionCount, nameOf, themeVars, onClose, onConfirm, disabled }) {
  useEffect(() => {
    const close = (event) => { if (event.key === 'Escape') onClose() }
    window.addEventListener('keydown', close)
    return () => window.removeEventListener('keydown', close)
  }, [onClose])
  const tree = useMemo(() => treeOf(files, (file) => [file.namespace || 'cloud', file.sourceId || 'archive']), [files])
  const folderName = `tmp-${project.id}`
  const top = [...tree.folders.entries()].sort(([a], [b]) => naturalOrder(a, b))
  return createPortal(<div className="tube-sheet-root" style={themeVars}>
    <div className="tube-sheet-back" onClick={onClose} />
    <section className="tube-sheet" role="dialog" aria-modal="true" aria-label="Télécharger le dossier">
      <button type="button" className="tube-sheet-close" onClick={onClose} aria-label="Fermer"><Icon name="xmark" size={14} /></button>
      <div className="tube-zip">
        <span className="tube-zip-icon" aria-hidden="true"><i /><i /><i /></span>
        <div>
          <h2 className="tube-zip-name">{folderName}</h2>
          <p className="tube-meta"><span className="assets-number">{number.format(files.length)}</span> {selectionCount ? 'fichiers sélectionnés' : 'fichiers'} · <span className="assets-number">{sizeText(bytesOf(files), files.length)}</span> · ZIP dans Téléchargements</p>
          <div className="tube-zip-subs">{top.map(([key, node]) => { const inside = subtreeFiles(node); return <span className="tube-zip-sub" key={key}><strong>{nameOf(key)}</strong><small><span className="assets-number">{number.format(inside.length)}</span> · <span className="assets-number">{sizeText(bytesOf(inside), inside.length)}</span></small></span> })}</div>
          <button type="button" className="tube-primary" disabled={disabled || !files.length} onClick={onConfirm}><Icon name="arrow.down" size={14} /> Télécharger le dossier</button>
        </div>
      </div>
      <div className="tube-tree" aria-label="Contenu du dossier"><div className="tube-tr-root"><Icon name="folder" size={15} /><span className="tube-tr-name">{folderName}</span></div><SheetTree node={tree} depth={0} nameOf={nameOf} /></div>
      <p className="tube-meta">Les noms affichés suivent votre choix « Noms » ; les dossiers du ZIP portent leur nom technique.</p>
    </section>
  </div>, document.body)
}

export function TubeProject({ project, files, visible, sources, selected, onToggle, onPreview, onDownload, offline, renderThumbnail, themeVars, coverId, onSetCover, onClearCover, onAdjustCover, search, onSearch, sort, direction, onSort }) {
  const [side, setSide] = useState('all')
  const [view, setViewState] = useState(() => readSetting(VIEW_KEY, VIEWS.map((item) => item.id), 'icons'))
  const [limit, setLimit] = useState(120)
  const [sheet, setSheet] = useState(false)
  const [colPath, setColPath] = useState([])
  const [colFile, setColFile] = useState(null)
  const [focusId, setFocusId] = useState(null)
  const [menu, setMenu] = useState(null)
  const [toast, setToast] = useState('')
  useEffect(() => { if (!toast) return undefined; const timer = setTimeout(() => setToast(''), 2800); return () => clearTimeout(timer) }, [toast])
  const openMenu = (event, file) => {
    if (!onSetCover || !isImageFile(file)) return
    event.preventDefault()
    setMenu({ x: event.clientX, y: event.clientY, file })
  }
  const setView = (value) => { setViewState(value); writeSetting(VIEW_KEY, value) }
  const nameOf = (id) => SOURCE_BY_ID[id]?.label || id
  useEffect(() => { setSide('all'); setLimit(120); setColPath([]); setColFile(null); setFocusId(null); setSheet(false) }, [project.id])
  useEffect(() => { setLimit(120) }, [side, search, view])

  const srcOf = useMemo(() => new Map(files.map((file) => [file.id, sourceIdOf(file, sources)])), [files, sources])
  const groups = useMemo(() => SOURCE_DEFS.map((definition) => {
    const list = files.filter((file) => srcOf.get(file.id) === definition.id)
    return { ...definition, files: list, bytes: bytesOf(list) }
  }).filter((group) => group.files.length), [files, srcOf])
  // Legacy registry projects list no per-file sizes but do carry per-source bytes: use them rather than showing nothing.
  const sourceBytes = sources.reduce((sum, source) => sum + (Number.isFinite(source.bytes) && source.bytes > 0 ? source.bytes : 0), 0)
  const fileBytes = groups.reduce((sum, group) => sum + group.bytes, 0)
  const borrowed = fileBytes === 0 && sourceBytes > 0 && groups.length === 1
  if (borrowed) groups[0] = { ...groups[0], bytes: sourceBytes }
  const total = borrowed ? sourceBytes : fileBytes
  useEffect(() => { if (side !== 'all' && !groups.some((group) => group.id === side)) setSide('all') }, [groups, side])
  const scoped = useMemo(() => side === 'all' ? visible : visible.filter((file) => srcOf.get(file.id) === side), [visible, side, srcOf])
  const shown = scoped.slice(0, limit)
  const tree = useMemo(() => view === 'columns' ? treeOf(scoped, (file) => [srcOf.get(file.id)]) : null, [view, scoped, srcOf])
  useEffect(() => { if (tree && !colPath.length && tree.folders.size) setColPath([[...tree.folders.keys()].sort(rootOrder)[0]]) }, [tree, colPath.length])
  const selection = files.filter((file) => selected.has(file.id))
  const scopeCandidates = selection.length ? selection : scoped
  const downloadFiles = scopeCandidates.filter(isDownloadable)
  const open = (file) => { setFocusId(file.id); onPreview?.(file) }
  const confirm = async () => { await onDownload?.(downloadFiles); setSheet(false) }

  return <section className="tube-project" aria-label="Fichiers du projet">
    <Storage groups={groups} total={total} count={files.length} side={side} onSide={setSide} nameOf={nameOf} />
    <div className="tube-split">
      <aside className="tube-side" aria-label="Emplacements">
        <div className="tube-side-label">Emplacements</div>
        <button type="button" data-on={side === 'all'} onClick={() => setSide('all')}><Icon name="externaldrive" size={14} />Tout<span className="assets-number">{number.format(files.length)}</span></button>
        {SOURCE_DEFS.filter((d) => d.id !== 'cloud').map((definition) => {
          const count = groups.find((group) => group.id === definition.id)?.files.length || 0
          return <button type="button" key={definition.id} data-on={side === definition.id} disabled={!count} title={`${definition.label} : ${definition.what}`} onClick={() => setSide(definition.id)}><i className="tube-src-dot" data-src={definition.id} />{nameOf(definition.id)}<span className="assets-number">{count ? number.format(count) : ''}</span></button>
        })}
      </aside>
      <div className="tube-main">
        <div className="tube-toolbar">
          <label className="tube-search"><Icon name="magnifyingglass" size={15} /><input aria-label="Rechercher un fichier" value={search} onChange={(event) => onSearch(event.target.value)} placeholder="Rechercher un fichier" />{search && <button type="button" aria-label="Effacer" onClick={() => onSearch('')}><Icon name="xmark" size={13} /></button>}</label>
          <div className="tube-seg" role="group" aria-label="Présentation des fichiers">{VIEWS.map((item) => <button type="button" key={item.id} aria-label={item.label} title={item.label} aria-pressed={view === item.id} onClick={() => setView(item.id)}><svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">{item.svg}</svg></button>)}</div>
          {project.folder && <button type="button" className="tube-download" title="Ouvre le dossier cloud de ce projet dans Create" onClick={() => window.dispatchEvent(new CustomEvent('zr:create-folder', { detail: { path: project.folder } }))}><Icon name="arrow.up.right" size={14} />Ouvrir dans Create</button>}
          {onDownload && <button type="button" className="tube-download" disabled={offline || !downloadFiles.length} onClick={() => setSheet(true)}><Icon name="arrow.down" size={14} />Télécharger{selection.length > 0 && <> <span className="assets-number">{number.format(selection.length)}</span></>}</button>}
        </div>
        {!scoped.length ? <p className="tube-empty">{files.length ? 'Aucun fichier ne correspond.' : 'Ce projet ne contient encore aucun fichier.'}</p>
          : view === 'list' ? <FileList files={shown} selected={selected} onToggle={onToggle} onOpen={open} onMenu={openMenu} coverId={coverId} renderThumbnail={renderThumbnail} srcOf={srcOf} nameOf={nameOf} sort={sort} direction={direction} onSort={onSort} />
          : view === 'columns' ? <Columns tree={tree} path={colPath} onPath={setColPath} fileId={colFile} onFile={setColFile} onOpen={open} nameOf={nameOf} renderThumbnail={renderThumbnail} />
          : view === 'gallery' ? <Gallery files={scoped} focusId={focusId} onFocus={setFocusId} onOpen={open} onMenu={openMenu} renderThumbnail={renderThumbnail} srcOf={srcOf} nameOf={nameOf} />
          : <div className="tube-file-grid">{shown.map((file) => <FileTile key={file.id} file={file} selected={selected.has(file.id)} onToggle={onToggle} onOpen={open} onMenu={openMenu} isCover={file.id === coverId} renderThumbnail={renderThumbnail} />)}</div>}
        {view !== 'columns' && view !== 'gallery' && shown.length < scoped.length && <button type="button" className="tube-more" onClick={() => setLimit(limit + 120)}>Afficher plus <span className="assets-number">{number.format(scoped.length - shown.length)}</span></button>}
      </div>
    </div>
    {menu && <CoverMenu menu={menu} isCover={menu.file.id === coverId} themeVars={themeVars} onClose={() => setMenu(null)}
      onSet={async (file) => { setMenu(null); setToast(`Miniature du projet : ${file.name}`); const result = await onSetCover?.(file); if (result && result.ok === false) setToast('Miniature gardée sur cet appareil, sauvegarde cloud impossible') }}
      onAdjust={(file) => { setMenu(null); onAdjustCover?.(file) }}
      onClear={async () => { setMenu(null); setToast('Miniature retirée'); await onClearCover?.() }} />}
    {toast && <div className="tube-toast" role="status">{toast}</div>}
    {sheet && <DownloadSheet project={project} files={downloadFiles} selectionCount={selection.length} nameOf={nameOf} themeVars={themeVars} onClose={() => setSheet(false)} onConfirm={confirm} disabled={offline} />}
  </section>
}

export function TubeLayoutSwitch({ layout, onChange }) {
  return <div className="tube-layout-switch" role="group" aria-label="Disposition">{[['classic', 'Classique'], ['tube', 'Tube']].map(([id, label]) => <button type="button" key={id} aria-pressed={layout === id} onClick={() => onChange(id)}>{label}</button>)}</div>
}

// 20 October 2026: interactive adjustment modal for project thumbnails.
// Allows real-time X/Y repositioning (mouse drag), zoom and dezoom (wheel and slider),
// black letterbox/pillarbox bands when dezoomed or contained, preset framing modes,
// and fluid one-click WebP saving at 720x406 Retina resolution.
export function CoverAdjustModal({ project, file, themeVars, onClose, onSave }) {
  const initialFile = file || project?.coverFile || (project?.coverUrl ? { thumbnailUrl: project.coverUrl, name: `${project.name} cover` } : null)
  const meta = initialFile?.adjustMeta || {}
  const [panX, setPanX] = useState(meta.panX || 0)
  const [panY, setPanY] = useState(meta.panY || 0)
  const [zoom, setZoom] = useState(meta.zoom || 1)
  const [fitMode, setFitMode] = useState(meta.fitMode || 'cover')
  const [loadedImage, setLoadedImage] = useState(null)
  const [imageLoading, setImageLoading] = useState(true)
  const [error, setError] = useState(null)
  const [saving, setSaving] = useState(false)
  const [isDragging, setIsDragging] = useState(false)

  const canvasRef = useRef(null)
  const dragStartRef = useRef({ mouseX: 0, mouseY: 0, panX: 0, panY: 0 })

  useEffect(() => {
    const key = (e) => { if (e.key === 'Escape') onClose() }
    window.addEventListener('keydown', key)
    return () => window.removeEventListener('keydown', key)
  }, [onClose])

  useEffect(() => {
    let cancelled = false
    let blobUrl = null
    ;(async () => {
      setImageLoading(true)
      setError(null)
      try {
        let src = initialFile?.thumbnailUrl || project?.coverUrl
        if (initialFile?.contentPath) {
          try {
            const entry = await resolveEntryBytes({ contentPath: initialFile.contentPath, name: initialFile.name })
            if (entry?.bytes && !cancelled) {
              const blob = new Blob([entry.bytes])
              blobUrl = URL.createObjectURL(blob)
              src = blobUrl
            }
          } catch { /* fallback to src */ }
        }
        if (!src && initialFile?.cloudPath) {
          src = initialFile.cloudPath
        }
        if (!src) throw new Error('Aucune image disponible à cadrer.')
        const img = new Image()
        img.crossOrigin = 'anonymous'
        img.onload = () => {
          if (!cancelled) {
            setLoadedImage(img)
            setImageLoading(false)
          }
        }
        img.onerror = () => {
          if (!cancelled) {
            setError('Impossible de charger l’image source')
            setImageLoading(false)
          }
        }
        img.src = src
      } catch (err) {
        if (!cancelled) {
          setError(err.message || 'Erreur de chargement')
          setImageLoading(false)
        }
      }
    })()
    return () => {
      cancelled = true
      if (blobUrl) URL.revokeObjectURL(blobUrl)
    }
  }, [initialFile, project])

  useEffect(() => {
    const canvas = canvasRef.current
    if (!canvas || !loadedImage) return
    drawCoverCanvas(canvas, loadedImage, { panX, panY, zoom, fitMode, width: 720, height: 406 })
  }, [loadedImage, panX, panY, zoom, fitMode])

  const handleMouseDown = (e) => {
    if (e.button !== 0) return
    e.preventDefault()
    setIsDragging(true)
    dragStartRef.current = {
      mouseX: e.clientX,
      mouseY: e.clientY,
      panX,
      panY,
    }
  }

  useEffect(() => {
    if (!isDragging) return
    const handleMouseMove = (e) => {
      const canvas = canvasRef.current
      if (!canvas) return
      const rect = canvas.getBoundingClientRect()
      const scaleFactor = 720 / (rect.width || 720)
      const dx = (e.clientX - dragStartRef.current.mouseX) * scaleFactor
      const dy = (e.clientY - dragStartRef.current.mouseY) * scaleFactor
      setPanX(Math.round(dragStartRef.current.panX + dx))
      setPanY(Math.round(dragStartRef.current.panY + dy))
    }
    const handleMouseUp = () => setIsDragging(false)
    window.addEventListener('mousemove', handleMouseMove)
    window.addEventListener('mouseup', handleMouseUp)
    return () => {
      window.removeEventListener('mousemove', handleMouseMove)
      window.removeEventListener('mouseup', handleMouseUp)
    }
  }, [isDragging])

  const handleWheel = (e) => {
    e.preventDefault()
    const factor = e.deltaY < 0 ? 1.08 : 0.92
    setZoom((current) => Math.max(0.1, Math.min(5, Number((current * factor).toFixed(3)))))
  }

  const handleSave = async () => {
    const canvas = canvasRef.current
    if (!canvas) return
    setSaving(true)
    try {
      const dataUri = canvas.toDataURL('image/webp', 0.85)
      await onSave?.(dataUri, { panX, panY, zoom, fitMode })
      onClose()
    } catch (err) {
      console.error('Save cover failed', err)
    } finally {
      setSaving(false)
    }
  }

  const resetAll = () => {
    setPanX(0)
    setPanY(0)
    setZoom(1)
    setFitMode('cover')
  }

  const containWithBlackBands = () => {
    setFitMode('contain')
    setZoom(1)
    setPanX(0)
    setPanY(0)
  }

  const fillCover = () => {
    setFitMode('cover')
    setZoom(1)
    setPanX(0)
    setPanY(0)
  }

  return createPortal(
    <div className="tube-adjust-overlay" style={themeVars} onClick={onClose}>
      <div className="tube-adjust-modal" onClick={(e) => e.stopPropagation()} role="dialog" aria-modal="true" aria-label="Ajuster la miniature">
        <header className="tube-adjust-header">
          <div className="tube-adjust-title-group">
            <h3>Cadrer la miniature</h3>
            <span className="tube-adjust-sub">{project?.name || initialFile?.name || 'Projet'}</span>
          </div>
          <button type="button" className="tube-adjust-close" aria-label="Fermer" onClick={onClose}>
            <Icon name="xmark" size={14} />
          </button>
        </header>

        <div className="tube-adjust-viewport-wrap">
          <div className="tube-adjust-viewport">
            {imageLoading && <div className="tube-adjust-loading"><TubeSpinner /><p>Chargement de l’image…</p></div>}
            {error && <div className="tube-adjust-error"><Icon name="xmark" size={20} /><p>{error}</p></div>}
            <canvas
              ref={canvasRef}
              width={720}
              height={406}
              className={`tube-adjust-canvas ${isDragging ? 'is-dragging' : ''}`}
              onMouseDown={handleMouseDown}
              onWheel={handleWheel}
              style={{ display: imageLoading || error ? 'none' : 'block' }}
            />
          </div>
          <div className="tube-adjust-hint">
            <span>Glissez pour déplacer (X/Y) · Molette pour zoomer / dézoomer · Bandes noires automatiques</span>
          </div>
        </div>

        <div className="tube-adjust-controls">
          <div className="tube-adjust-presets">
            <span className="tube-adjust-label">Modes rapides</span>
            <div className="tube-adjust-btn-group">
              <button type="button" className={`tube-chip ${fitMode === 'contain' ? 'is-active' : ''}`} onClick={containWithBlackBands}>
                Adapter (Bandes noires)
              </button>
              <button type="button" className={`tube-chip ${fitMode === 'cover' ? 'is-active' : ''}`} onClick={fillCover}>
                Remplir (Plein écran)
              </button>
              <button type="button" className="tube-chip" onClick={() => { setPanX(0); setPanY(0) }}>
                Centrer
              </button>
              <button type="button" className="tube-chip" onClick={resetAll} title="Réinitialiser tous les réglages">
                Réinitialiser
              </button>
            </div>
          </div>

          <div className="tube-adjust-sliders">
            <div className="tube-adjust-row">
              <span className="tube-adjust-slider-label">Zoom : <strong className="assets-number">{Math.round(zoom * 100)}%</strong></span>
              <button type="button" className="tube-adjust-step-btn" onClick={() => setZoom(z => Math.max(0.1, Number((z - 0.1).toFixed(2))))}>-</button>
              <input
                type="range"
                min="0.1"
                max="3"
                step="0.01"
                value={zoom}
                onChange={(e) => setZoom(Number(e.target.value))}
                aria-label="Zoom"
              />
              <button type="button" className="tube-adjust-step-btn" onClick={() => setZoom(z => Math.min(3, Number((z + 0.1).toFixed(2))))}>+</button>
            </div>

            <div className="tube-adjust-row">
              <span className="tube-adjust-slider-label">Position X : <strong className="assets-number">{panX}px</strong></span>
              <input
                type="range"
                min="-720"
                max="720"
                step="2"
                value={panX}
                onChange={(e) => setPanX(Number(e.target.value))}
                aria-label="Position horizontale"
              />
              <button type="button" className="tube-adjust-zero-btn" onClick={() => setPanX(0)}>0</button>
            </div>

            <div className="tube-adjust-row">
              <span className="tube-adjust-slider-label">Position Y : <strong className="assets-number">{panY}px</strong></span>
              <input
                type="range"
                min="-406"
                max="406"
                step="2"
                value={panY}
                onChange={(e) => setPanY(Number(e.target.value))}
                aria-label="Position verticale"
              />
              <button type="button" className="tube-adjust-zero-btn" onClick={() => setPanY(0)}>0</button>
            </div>
          </div>
        </div>

        <footer className="tube-adjust-footer">
          <button type="button" className="tube-adjust-cancel" onClick={onClose} disabled={saving}>
            Annuler
          </button>
          <button type="button" className="tube-adjust-save" onClick={handleSave} disabled={saving || imageLoading || Boolean(error)}>
            {saving ? 'Enregistrement…' : 'Enregistrer la miniature'}
          </button>
        </footer>
      </div>
    </div>,
    document.body
  )
}
