function Ring({ groups, total }) {
  let offset = 0
  return <svg className="tube-ring" viewBox="0 0 36 36" aria-hidden="true">
    <circle r="15.9" cx="18" cy="18" fill="none" strokeWidth="5" style={{ stroke: 'var(--assets-hover)' }} />
    {groups.map((group) => {
      const percent = total ? group.bytes / total * 100 : 0
      const dash = Math.max(percent - .8, 0)
      const segment = <circle key={group.id} r="15.9" cx="18" cy="18" fill="none" strokeWidth="5" pathLength="100" strokeDasharray={`${dash} ${100 - dash}`} strokeDashoffset={-offset} transform="rotate(-90 18 18)" style={{ stroke: `var(--tube-src-${group.id})` }} />
      offset += percent
      return segment
    })}
  </svg>
}

