    </div>
  )
}

// ── Section d'un status (titre + grille) = ZONE DE DÉPÔT pour le drag inter-status ──
// Glisser une carte ici lui donne ce status. La zone se surligne pendant le survol (compteur enter/leave
// robuste : pas de scintillement quand on passe d'une carte à l'autre). Gros espace entre sections (44px).
// Repli/dépli par section (2026-07-08, demande Matthieu) : chevron façon Notion, état persistant par
// catégorie+statut (localStorage) — replier « Done » dans Games ne replie pas « Done » dans Books.
const shelfCollapseKey = (cat, g) => `zr-shelf-collapse:${cat}:${g}`
function StatusSection({ g, gi, list, onOpen, t, drag, landscape, dragActive, cat }) {
  const [over, setOver] = useState(false)
  const depth = useRef(0)
  const s = st(g)
  const [shut, setShut] = useState(() => { try { return localStorage.getItem(shelfCollapseKey(cat, g)) === '1' } catch { return false } })
  const toggle = () => setShut((v) => { const n = !v; try { localStorage.setItem(shelfCollapseKey(cat, g), n ? '1' : '0') } catch {}; return n })
  const onEnter = () => { depth.current += 1; setOver(true) }
  const onLeave = () => { depth.current = Math.max(0, depth.current - 1); if (depth.current === 0) setOver(false) }
  const onDrop = (e) => { e.preventDefault(); depth.current = 0; setOver(false); drag.dropOn(null, g) }
  // Nettoyage GARANTI des tirets : dès que le drag se termine (dragActive -> false, posé par dropOn sur CHAQUE drop
  // ou par le dragend d'une annulation), on efface le surlignage. Robuste même quand la carte déposée change de
  // section et que sa carte source est démontée (cas où dragend/drop ne remontaient jamais jusqu'ici).
  useEffect(() => { if (!dragActive) { depth.current = 0; setOver(false) } }, [dragActive])
  return (
    // Le drop reste actif MÊME repliée (les handlers vivent sur cette <section>, jamais démontés par shut).
    <section onDragEnter={onEnter} onDragLeave={onLeave} onDragOver={(e) => e.preventDefault()} onDrop={onDrop}
      style={{ display: 'flex', flexDirection: 'column', gap: 12, marginTop: gi === 0 ? 6 : 44, padding: '10px 12px', marginLeft: -12, marginRight: -12, borderRadius: 16, background: over ? `${s.color}14` : 'transparent', outline: `2px dashed ${over ? `${s.color}88` : 'transparent'}`, transition: 'background .15s, outline-color .15s' }}>
      <button onClick={toggle} title={shut ? 'Déplier' : 'Replier'} style={{ display: 'flex', alignItems: 'center', gap: 9, background: 'transparent', border: 'none', cursor: 'pointer', padding: 0, textAlign: 'left' }}>
        <Icon name={shut ? 'chevron.right' : 'chevron.down'} size={12} color={(t && t.textSecondary) || '#8E8E93'} />
        <span style={{ width: 9, height: 9, borderRadius: 99, background: s.color, boxShadow: `0 0 8px ${s.color}66` }} />
        <h3 style={{ margin: 0, fontFamily: FONTS.serif, fontSize: 19, fontWeight: 500, color: (t && t.textPrimary) || '#ECECEA' }}>{s.label}</h3>
        <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: (t && t.textSecondary) || '#8E8E93' }}>{list.length}</span>
      </button>
      {!shut && (list.length > 0
        ? <PosterGrid items={list} onOpen={onOpen} t={t} drag={drag} landscape={landscape} cat={cat} />
        : <div style={{ border: `1.5px dashed ${(t && t.border) || '#3A3A38'}`, borderRadius: 12, padding: 18, textAlign: 'center', color: (t && t.textSecondary) || '#8E8E93', fontSize: 'var(--zr-ui-sm)' }}>Glisse une carte ici pour la passer en « {s.label} »</div>)}
    </section>
  )
}

// ── Image de poster LAZY + PROGRESSIVE ─────────────────────────────────────
// Réutilise le lazy de Create (useInView : un seul IntersectionObserver partagé, préchargement +400px avant
// l'entrée à l'écran). L'image n'est montée que lorsqu'elle approche du viewport, puis apparaît en fondu doux
// (blur-up léger : scale 1.04 -> 1 + opacité) une fois décodée. `priority` = les premières cartes chargent direct.
function PosterImg({ url, priority }) {
  const [seen, setSeen] = useState(!!priority)
  const [loaded, setLoaded] = useState(false)
  // Ordre d'essai figé par poster : [cache d'edge /api/shelf-poster, jsDelivr]. step = origine en cours.
  const [cands, setCands] = useState(() => posterCandidates(url))
  const [step, setStep] = useState(0)
  const onVis = useCallback(() => setSeen(true), [])
  const { ref } = useInView(onVis)
  useEffect(() => { setCands(posterCandidates(url)); setStep(0); setLoaded(false) }, [url])
  const next = () => { if (step === 0 && cands[1]) setStep(1) } // première origine muette ou en erreur -> la seconde
  // Anti-attente : une origine muette n'envoie ni load ni error. Délai puis seconde origine.
  useEffect(() => {
    if (!seen || loaded || step !== 0 || !cands[1]) return undefined
    const id = setTimeout(next, POSTER_POLICY.edgeFirstByteMs)
    return () => clearTimeout(id)
  }, [seen, loaded, step, cands, url]) // eslint-disable-line react-hooks/exhaustive-deps
  const src = cands[step] || cands[0]
  if (!url) return null
  return (
    <span ref={ref} aria-hidden style={{ position: 'absolute', inset: 0, display: 'block' }}>
      {seen && src && (
        <img src={src} alt="" decoding="async" fetchPriority={priority ? 'high' : 'auto'}
          onLoad={() => setLoaded(true)} onError={next}
          style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', objectFit: 'cover', opacity: loaded ? 1 : 0, transform: loaded ? 'scale(1)' : 'scale(1.04)', transition: 'opacity .35s ease, transform .45s ease' }} />
      )}
    </span>
  )
}

// ── Grille de posters auto-fill ───────────────────────────────────────────
function PosterGrid({ items, onOpen, t, drag, landscape, cat }) {
  return (
