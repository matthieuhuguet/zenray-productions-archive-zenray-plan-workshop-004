      {items.map((it, i) => <PosterCard key={it.id} item={it} onOpen={onOpen} t={t} drag={drag} idx={i} landscape={landscape} cat={cat} />)}
    </div>
  )
}

// ── Carte poster (portrait 2:3, hover zoom signature Apple TV) ─────────────
// Racine = <div role="button"> (et NON <button>) : un <button draggable> n'amorce pas le drag de façon fiable
// selon les navigateurs. Pendant le drag : la carte source s'atténue (opacity .45) et l'image fantôme est un
// vrai poster arrondi (dragApi.start). Survolée par un drag, elle s'entoure d'un liseré accent (cible d'insertion).
const PosterCard = React.memo(function PosterCard({ item, onOpen, t, drag, idx = 0, landscape, cat }) {
  const [hover, setHover] = useState(false)
  const [overSide, setOverSide] = useState(null) // 'left' | 'right' | null : côté où la carte glissée s'insérera
  const [dragging, setDragging] = useState(false)
  // Filet de sécurité : à la fin de TOUT drag (drop ou annulation, capté n'importe où) on efface la barre
  // d'insertion et l'atténuation de la carte source. Garantit qu'aucun marqueur ne reste collé après un déplacement.
  useEffect(() => {
    const clear = () => { setOverSide(null); setDragging(false) }
    window.addEventListener('dragend', clear); window.addEventListener('drop', clear)
    return () => { window.removeEventListener('dragend', clear); window.removeEventListener('drop', clear) }
  }, [])
  const url = posterUrl(item.image)
  const accent = (t && t.accent) || PALETTE.primary
  const open = (e) => onOpen(item.id, e.currentTarget.getBoundingClientRect())
  const sideOf = (e) => { const r = e.currentTarget.getBoundingClientRect(); return e.clientX > r.left + r.width / 2 ? 'right' : 'left' }
  return (
    <div role="button" tabIndex={0} className="zr-liquid-rim"
      onClick={open}
      onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(e) } }}
      onMouseEnter={() => setHover(true)} onMouseLeave={() => setHover(false)}
      title={item.name}
      draggable={!!drag}
      onDragStart={drag ? (e) => { setDragging(true); drag.start(item.id, e) } : undefined}
      onDragEnd={drag ? () => { setDragging(false); setOverSide(null) } : undefined}
      onDragOver={drag ? (e) => { e.preventDefault(); setOverSide(sideOf(e)) } : undefined}
      onDragLeave={drag ? () => setOverSide(null) : undefined}
      onDrop={drag ? (e) => { e.preventDefault(); e.stopPropagation(); const after = sideOf(e) === 'right'; setOverSide(null); drag.dropOn(item.id, item.status, after) } : undefined}
      style={{ position: 'relative', display: 'block', width: '100%', aspectRatio: landscape ? '3 / 2' : '2 / 3', border: 'none', padding: 0, cursor: drag ? 'grab' : 'pointer', borderRadius: 12, overflow: 'hidden', background: fallbackGrad(item.id), boxShadow: `inset 1.5px 1.5px 1px rgba(255,255,255,0.58), inset -1.5px -1.5px 1px rgba(0,0,0,0.22), ${hover ? '0 14px 36px -10px rgba(0,0,0,0.6)' : '0 4px 14px -6px rgba(0,0,0,0.45)'}`, transform: dragging ? 'scale(0.97)' : (hover ? 'scale(1.05)' : 'scale(1)'), opacity: dragging ? 0.45 : 1, transition: 'transform .22s cubic-bezier(0.25,1,0.5,1), box-shadow .22s, opacity .15s', zIndex: hover || overSide ? 3 : 1, fontFamily: 'inherit', textAlign: 'left', userSelect: 'none' }}>
      {/* Barre d'insertion lumineuse (bord gauche ou droit) montrant où la carte va se placer pendant un drag */}
      {overSide && <span aria-hidden style={{ position: 'absolute', top: 6, bottom: 6, [overSide]: 2, width: 4, borderRadius: 4, background: accent, boxShadow: `0 0 12px 1px ${accent}`, zIndex: 6 }} />}
      <PosterImg url={url} priority={idx < POSTER_POLICY.eagerCards} />

      {/* Vignette dégradée sombre en bas (lisibilité du titre) */}
      <div style={{ position: 'absolute', inset: 0, background: 'linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.42) 28%, rgba(0,0,0,0) 56%)' }} />

      {/* Score en haut-gauche (chiffre gras, pastille discrète) */}
      {(item.score === 0 || item.score) && (
        <div style={{ position: 'absolute', top: 8, left: 8, minWidth: 26, height: 24, padding: '0 7px', display: 'inline-flex', alignItems: 'center', justifyContent: 'center', borderRadius: 8, background: 'rgba(0,0,0,0.55)', backdropFilter: 'blur(6px)', WebkitBackdropFilter: 'blur(6px)', color: '#fff', fontFamily: FONTS.sans, fontWeight: 800, fontSize: 'var(--zr-ui-md)', lineHeight: 1, border: '0.5px solid rgba(255,255,255,0.18)' }}>{item.score}</div>
      )}

      {/* Bulle si une note/commentaire est écrit */}
      {item.notes && <span title="Note" style={{ position: 'absolute', top: 8, right: 8, width: 18, height: 18, borderRadius: 7, background: 'rgba(0,0,0,0.55)', backdropFilter: 'blur(6px)', WebkitBackdropFilter: 'blur(6px)', display: 'inline-flex', alignItems: 'center', justifyContent: 'center', border: '0.5px solid rgba(255,255,255,0.18)' }}><Icon name="text.bubble" size={11} color="#fff" /></span>}

      {/* TRACKER ÉPISODES (animes In Progress, opt-in) : pastille liquid glass top-centre = prochain épisode À VOIR. */}
      {cat === 'anime-manga' && item.status === 'in_progress' && (() => {
        const tk = item.extra && item.extra.tracker
        if (!tk || !tk.enabled || !Array.isArray(tk.unseen) || !tk.unseen.length) return null
        const next = Math.min(...tk.unseen)
        const pad = (n) => String(n).padStart(2, '0')
        return (
          <span title={`${tk.unseen.length} épisode(s) à voir`} onClick={open}
            style={{ position: 'absolute', top: 8, left: '50%', transform: 'translateX(-50%)', display: 'inline-flex', alignItems: 'center', gap: 4, padding: '3px 10px', borderRadius: 99, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', fontWeight: 600, color: '#fff', whiteSpace: 'nowrap', zIndex: 5, cursor: 'pointer',
              background: 'linear-gradient(150deg, rgba(10,132,255,0.42), rgba(10,132,255,0.24))', backdropFilter: 'blur(14px) saturate(180%)', WebkitBackdropFilter: 'blur(14px) saturate(180%)', border: '1px solid rgba(255,255,255,0.38)', boxShadow: 'inset 1px 1px 0.5px rgba(255,255,255,0.5), 0 4px 12px -4px rgba(0,0,0,0.5)' }}>
            S{pad(tk.season || 1)}E{pad(next)}{tk.unseen.length > 1 ? <span style={{ opacity: 0.85 }}>·{tk.unseen.length}</span> : null}
          </span>
        )
      })()}

      {/* Titre en bas-centre — Anthropic Sans medium, lisible sur la vignette */}
      <div style={{ position: 'absolute', left: 10, right: 10, bottom: 10, fontFamily: FONTS.sans, fontWeight: 500, fontSize: 'var(--zr-ui-md)', lineHeight: 1.25, color: '#fff', textAlign: 'center', textShadow: '0 1px 6px rgba(0,0,0,0.7)', display: '-webkit-box', WebkitLineClamp: 3, WebkitBoxOrient: 'vertical', overflow: 'hidden' }}>{item.name}</div>
    </div>
  )
}, (a, b) => a.item === b.item && a.idx === b.idx && a.landscape === b.landscape && a.t === b.t && a.cat === b.cat)

// ── Panneau détail (slide-over Notion-like) ───────────────────────────────
function DetailPanel({ item, t, cat, rect, onClose, onChange, onDelete }) {
  const [uploading, setUploading] = useState(false)
  const [picking, setPicking] = useState(false) // affiche/masque le picker de couverture (recherche auto)
  const [imgMenu, setImgMenu] = useState(false)  // menu centralisé des 4 fonctions image
  const [pasting, setPasting] = useState(false)
  const fileRef = useRef(null)
  const [notes, setNotes] = useState(item.notes || '')
  const [scoreDraft, setScoreDraft] = useState(item.score === 0 || item.score ? String(item.score) : '')
  const dirtyRef = useRef(false)

  // Re-synchronise si on ouvre une AUTRE œuvre sans avoir démonté le panneau.
  useEffect(() => { setNotes(item.notes || ''); setScoreDraft(item.score === 0 || item.score ? String(item.score) : ''); dirtyRef.current = false }, [item.id])

  const border = (t && t.border) || '#3A3A38'
  const textP = (t && t.textPrimary) || '#ECECEA'
  const textS = (t && t.textSecondary) || '#8E8E93'
  const accent = (t && t.accent) || PALETTE.primary

  const saveNotes = () => { if (notes !== (item.notes || '')) onChange({ notes: notes || null }) }
  const importImage = async (file) => {
    if (!file) return
    setUploading(true)
    // Fichier local -> webp -> ingestion (stockage public jsDelivr) au lieu de l'ancien /api/upload (repo assets
    // non configuré -> dataURL géant embarqué dans le JSON = commit qui échoue). Repli : dataURL si l'ingestion casse.
    try { const dataUrl = await fileToWebp(file); if (dataUrl) { const cdn = await ingestShelfImage({ dataUrl, name: item.name, cat }); onChange({ image: { kind: 'url', ref: cdn || dataUrl } }) } } catch {}
    setUploading(false)
  }
  // Coller une image depuis le presse-papier (ex : copiée depuis Google Images dans ton navigateur) -> ingestion.
  const pasteImage = async () => {
    setImgMenu(false); setPasting(true)
    try {
      const items = await navigator.clipboard.read()
      let blob = null
      for (const it of items) { const type = it.types.find((ty) => ty.startsWith('image/')); if (type) { blob = await it.getType(type); break } }
      if (!blob) { setPasting(false); notify({ kind: 'error', title: 'Presse-papier vide', body: 'Copie d\'abord une image (clic droit > Copier l\'image).' }); return }
      // COMPRESSION OBLIGATOIRE : une image du presse-papier (capture plein écran) fait souvent plusieurs Mo en
      // PNG -> l'ingestion brute échouait (payload trop gros) et la carte restait noire / non sauvée. fileToWebp
      // la réduit (webp, max 1600px) -> petit dataURL -> ingestion fiable -> URL jsDelivr stockée et persistée.
      const dataUrl = await fileToWebp(blob)
      if (!dataUrl) { setPasting(false); notify({ kind: 'error', title: 'Image illisible' }); return }
      const cdn = await ingestShelfImage({ dataUrl, name: item.name, cat })
      onChange({ image: { kind: 'url', ref: cdn || dataUrl } }) // cdn prioritaire ; dataURL webp (petit) en repli
    } catch (e) { notify({ kind: 'error', title: 'Collage impossible', body: `${(e && e.message) || e} (autorise l'accès au presse-papier si demandé)` }) }
    setPasting(false)
  }
  // Ouvre Google Images DANS TON navigateur (IP résidentielle = vrais résultats), sur le titre. Tu copies une
  // image (clic droit > Copier l'image), puis « Coller une image » ici. Contourne le blocage datacenter.
  const openGoogle = () => { setImgMenu(false); window.open(`https://www.google.com/search?tbm=isch&q=${encodeURIComponent(item.name)}`, '_blank', 'noopener') }
  const commitScore = () => {
    const raw = scoreDraft.trim()
    if (raw === '') { if (item.score != null) onChange({ score: null }); return }
    let n = parseInt(raw, 10)
    if (Number.isNaN(n)) { setScoreDraft(item.score === 0 || item.score ? String(item.score) : ''); return }
    n = Math.max(0, Math.min(100, n))
    if (n !== item.score) onChange({ score: n })
    setScoreDraft(String(n))
  }
  const url = posterUrl(item.image)
  // Liquid glass theme-aware : le panneau est portalisé vers <body> (hors du div .zr-dark) -> on ne peut pas
  // compter sur la variante CSS .zr-dark, on pose le fond translucide + backdrop-blur EN INLINE selon le thème.
  const dark = !!(t && t.textPrimary === PALETTE.textPrimaryDark)
  const liquidBg = dark ? 'rgba(31,31,30,0.52)' : 'rgba(253,253,252,0.62)'

  const field = { background: (t && t.bg) || '#1F1F1E', color: textP, border: `1px solid ${border}`, borderRadius: 8, padding: '8px 11px', fontSize: 'var(--zr-ui-md)', outline: 'none', fontFamily: FONTS.sans, width: '100%', boxSizing: 'border-box' }

  // POPOVER ancré à la carte : on MESURE le panneau (ref, useLayoutEffect = avant le 1er paint, zéro flash) puis on
  // le place À CÔTÉ de la carte cliquée — à droite si ça rentre, sinon à gauche, sinon centré dessus (overlap) —
  // aligné verticalement sur elle et clampé à l'écran. La mesure RÉELLE empêche l'effondrement au centre quand le
  // panneau est grand vs la fenêtre (le vrai bug du « 100 km »). transformOrigin pointe vers la carte.
  const MW = Math.min(440, (typeof window !== 'undefined' ? window.innerWidth : 1280) * 0.94)
  const panelRef = useRef(null)
  const [pos, setPos] = useState(null)
  useLayoutEffect(() => {
    const el = panelRef.current; if (!el || typeof window === 'undefined') return
    const vw = window.innerWidth, vh = window.innerHeight, M = 12
    const w = el.offsetWidth || MW, h = el.offsetHeight || 480
    const r = rect || { left: vw / 2, top: vh / 2, width: 0, height: 0 }
    const cx = r.left + r.width / 2, cy = r.top + r.height / 2        // centre de la carte cliquée
    const left = Math.max(M, Math.min(cx - w / 2, vw - w - M))        // panneau CENTRÉ sur la carte, clampé à l'écran
    const top = Math.max(M, Math.min(cy - h / 2, vh - h - M))
    setPos({ left, top, ox: Math.max(0, Math.min(cx - left, w)), oy: Math.max(0, Math.min(cy - top, h)) })
  }, [rect, item.id])

  // PORTAIL vers <body> : un ancêtre `.zr-stage` a `backdrop-filter`, ce qui fait que tout `position:fixed`
  // descendant se réfère à LUI (et non au viewport) -> mes coords viewport étaient décalées de l'offset de la
  // scène (le vrai « 100 km »). En portant le panneau dans body, `fixed` redevient relatif au viewport.
  return createPortal(
    <>
      <div onClick={() => { saveNotes(); onClose() }} style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.28)', zIndex: 80, backdropFilter: 'blur(3px)', WebkitBackdropFilter: 'blur(3px)' }} />
      <aside ref={panelRef} className="zr-liquid-rim" style={{ position: 'fixed', left: pos ? pos.left : -9999, top: pos ? pos.top : 0, visibility: pos ? 'visible' : 'hidden', transformOrigin: pos ? `${pos.ox}px ${pos.oy}px` : 'center', width: MW, maxHeight: 'min(560px, 90vh)', borderRadius: 18, overflow: 'hidden', zIndex: 81, display: 'flex', flexDirection: 'column', fontFamily: FONTS.sans, background: liquidBg, backdropFilter: 'blur(36px) saturate(195%) brightness(1.05)', WebkitBackdropFilter: 'blur(36px) saturate(195%) brightness(1.05)', animation: pos ? 'shelfCardPop .2s cubic-bezier(0.2,1,0.4,1)' : 'none' }}>
        {/* Bandeau poster */}
        <div style={{ position: 'relative', flex: '0 0 auto', height: 150, background: url ? '#15151f' : fallbackGrad(item.id), overflow: 'hidden' }}>
          {url && <img src={url} alt="" onError={(e) => { const raw = jsdelivrToRaw(e.currentTarget.src); if (raw && raw !== e.currentTarget.src) e.currentTarget.src = raw }} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', objectFit: 'cover', opacity: 0.85 }} />}
          <div style={{ position: 'absolute', inset: 0, background: 'linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.15) 42%, transparent 72%)' }} />
          <button onClick={() => { saveNotes(); onClose() }} title="Fermer" style={{ position: 'absolute', top: 12, right: 12, width: 32, height: 32, borderRadius: 99, border: 'none', cursor: 'pointer', background: 'rgba(0,0,0,0.5)', color: '#fff', display: 'inline-flex', alignItems: 'center', justifyContent: 'center', backdropFilter: 'blur(6px)' }}><Icon name="xmark" size={16} color="#fff" /></button>
          <div style={{ position: 'absolute', left: 18, right: 56, bottom: 12 }}>
            <input key={item.id} defaultValue={item.name} title="Clique pour renommer"
              onFocus={(e) => { e.currentTarget.style.borderBottomColor = 'rgba(255,255,255,0.55)' }}
              onKeyDown={(e) => { if (e.key === 'Enter') e.currentTarget.blur() }}
              onBlur={(e) => { e.currentTarget.style.borderBottomColor = 'transparent'; const v = e.target.value.trim(); if (v && v !== item.name) onChange({ name: v }); else if (!v) e.currentTarget.value = item.name }}
              style={{ width: '100%', background: 'transparent', border: 'none', borderBottom: '1px solid transparent', outline: 'none', padding: '0 0 2px', fontFamily: FONTS.serif, fontSize: 23, fontWeight: 700, color: '#fff', lineHeight: 1.2, textShadow: '0 1px 8px rgba(0,0,0,0.6)' }} />
          </div>
          {/* UN SEUL bouton « Image » (bas-droite) : ouvre le menu centralisé des 4 fonctions, affiché dans le corps. */}
          <button onClick={() => setImgMenu((m) => !m)} title="Image — changer la couverture"
            style={{ position: 'absolute', right: 14, bottom: 12, width: 34, height: 34, borderRadius: 9, border: 'none', cursor: 'pointer', background: imgMenu ? accent : 'rgba(0,0,0,0.5)', color: '#fff', display: 'inline-flex', alignItems: 'center', justifyContent: 'center', backdropFilter: 'blur(6px)', WebkitBackdropFilter: 'blur(6px)' }}>
            <Icon name={(uploading || pasting) ? 'arrow.clockwise' : 'photo'} size={16} color="#fff" />
          </button>
          <input ref={fileRef} type="file" accept="image/*" style={{ display: 'none' }}
            onChange={(e) => { const f = e.target.files && e.target.files[0]; e.target.value = ''; importImage(f) }} />
        </div>

        {/* Corps scrollable */}
        <div style={{ flex: 1, overflowY: 'auto', padding: '16px 18px 24px', display: 'flex', flexDirection: 'column', gap: 16 }}>
          {imgMenu && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
              <span style={{ fontSize: 'var(--zr-ui-xs)', textTransform: 'uppercase', letterSpacing: 0.8, color: textS }}>Image</span>
              {/* 4 fonctions centralisées, icônes + noms clairs. Grille 2x2. */}
              <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 8 }}>
                {[
                  { ic: 'square.and.arrow.down', lb: pasting ? 'Collage…' : 'Clipboard paste', fn: pasteImage, on: pasting },
                  { ic: 'magnifyingglass', lb: 'Google Images', fn: openGoogle },
                  { ic: 'sparkles', lb: 'Auto search', fn: () => setPicking((p) => !p), on: picking },
                  { ic: 'photo', lb: uploading ? 'Import…' : 'Import file', fn: () => fileRef.current && fileRef.current.click(), on: uploading },
                ].map((b) => (
                  <button key={b.lb} onClick={b.fn}
                    style={{ display: 'inline-flex', alignItems: 'center', gap: 8, padding: '9px 11px', borderRadius: 10, border: `1px solid ${b.on ? accent : border}`, background: b.on ? PALETTE.primarySoft : 'transparent', color: b.on ? accent : textP, cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', fontWeight: 600, textAlign: 'left' }}>
                    <Icon name={b.ic} size={15} color="currentColor" />{b.lb}
                  </button>
                ))}
              </div>
              <div style={{ fontSize: 'var(--zr-ui-xs)', color: textS, lineHeight: 1.4 }}>Astuce : « Google Images » ouvre la recherche dans ton navigateur → clic droit sur une image → « Copier l'image » → reviens ici et « Clipboard paste ».</div>
            </div>
          )}
          {picking && (
            <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
              <span style={{ fontSize: 'var(--zr-ui-xs)', textTransform: 'uppercase', letterSpacing: 0.8, color: textS }}>Changer la couverture (recherche auto)</span>
              <PosterPicker name={item.name} cat={cat} t={t} onPick={(u) => { onChange({ image: { kind: 'url', ref: u } }); setPicking(false) }} />
            </div>
          )}
          {/* Métadonnées : status + score */}
          <div style={{ display: 'flex', gap: 12, flexWrap: 'wrap' }}>
            <label style={{ flex: '1 1 140px', display: 'flex', flexDirection: 'column', gap: 5 }}>
              <span style={{ fontSize: 'var(--zr-ui-xs)', textTransform: 'uppercase', letterSpacing: 0.8, color: textS }}>Status</span>
              <div style={{ position: 'relative', display: 'flex', alignItems: 'center' }}>
                {/* La pastille vivait à côté du titre « Shelf » (2026-08-15) ; Matthieu l'a voulue ailleurs
                    (2026-08-20) : au contact du réglage qu'elle décrit, pas de la page entière. Purement
                    décorative, `pointer-events: none` pour ne jamais voler le clic au select en dessous. */}
                <span style={{ width: 8, height: 8, borderRadius: 99, background: st(item.status).color, position: 'absolute', left: 10, pointerEvents: 'none' }} />
                <select value={item.status} onChange={(e) => onChange({ status: e.target.value })} style={{ ...field, cursor: 'pointer', paddingLeft: 24, width: '100%' }}>
                  {STATUS_ORDER.map((s) => <option key={s} value={s}>{st(s).label}</option>)}
                </select>
              </div>
            </label>
            <label style={{ flex: '0 0 96px', display: 'flex', flexDirection: 'column', gap: 5 }}>
              <span style={{ fontSize: 'var(--zr-ui-xs)', textTransform: 'uppercase', letterSpacing: 0.8, color: textS }}>Score</span>
              <input value={scoreDraft} onChange={(e) => setScoreDraft(e.target.value)} onBlur={commitScore} onKeyDown={(e) => { if (e.key === 'Enter') e.currentTarget.blur() }} placeholder="" inputMode="numeric" style={field} />
            </label>
          </div>

          {/* TRACKER ÉPISODES — ANIMES uniquement (jeux/films ont une logique différente). Opt-in (désactivé par
              défaut). On stocke { enabled, season, total, unseen[] } dans item.extra.tracker. unseen = épisodes À VOIR. */}
          {cat === 'anime-manga' && (() => {
            const tk = (item.extra && item.extra.tracker) || null
            const enabled = !!(tk && tk.enabled)
            const total = (tk && tk.total) || 12
            const season = (tk && tk.season) || 1
            const unseen = (tk && Array.isArray(tk.unseen)) ? tk.unseen : []
            const textP = (t && t.textPrimary) || '#ECECEA'
            const setTracker = (patch) => onChange({ extra: { ...(item.extra || {}), tracker: { enabled, season, total, unseen, ...patch } } })
            return (
              <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
                <label style={{ display: 'flex', alignItems: 'center', gap: 9, fontSize: 'var(--zr-ui-md)', color: textP, cursor: 'pointer' }}>
                  <input type="checkbox" checked={enabled} onChange={(e) => setTracker({ enabled: e.target.checked })} />
                  Suivi des épisodes — pastille « à voir » sur la carte (In Progress)
                </label>
                {enabled && (
                  <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
                    <div style={{ display: 'flex', gap: 10, alignItems: 'flex-end', flexWrap: 'wrap' }}>
                      <label style={{ display: 'flex', flexDirection: 'column', gap: 5 }}>
                        <span style={{ fontSize: 'var(--zr-ui-xs)', textTransform: 'uppercase', letterSpacing: 0.8, color: textS }}>Saison</span>
                        <input value={season} onChange={(e) => setTracker({ season: Math.max(1, +e.target.value || 1) })} inputMode="numeric" style={{ ...field, width: 66 }} />
                      </label>
                      <label style={{ display: 'flex', flexDirection: 'column', gap: 5 }}>
                        <span style={{ fontSize: 'var(--zr-ui-xs)', textTransform: 'uppercase', letterSpacing: 0.8, color: textS }}>Épisodes</span>
                        <select value={[12, 24].includes(total) ? total : 'custom'} onChange={(e) => { const v = e.target.value; if (v === 'custom') { setTracker({ total: total === 12 || total === 24 ? total + 1 : total }) } else setTracker({ total: +v, unseen: unseen.filter((n) => n <= +v) }) }} style={{ ...field, cursor: 'pointer', width: 118 }}>
                          <option value={12}>12</option><option value={24}>24</option><option value="custom">Custom…</option>
                        </select>
                      </label>
                      {![12, 24].includes(total) && (
                        <label style={{ display: 'flex', flexDirection: 'column', gap: 5 }}>
                          <span style={{ fontSize: 'var(--zr-ui-xs)', textTransform: 'uppercase', letterSpacing: 0.8, color: textS }}>Total</span>
                          <input value={total} onChange={(e) => { const v = Math.max(1, +e.target.value || 1); setTracker({ total: v, unseen: unseen.filter((n) => n <= v) }) }} inputMode="numeric" style={{ ...field, width: 78 }} />
                        </label>
                      )}
                    </div>
                    <span style={{ fontSize: 'var(--zr-ui-xs)', color: textS }}>Sélectionne les épisodes <b>NON vus</b> (à voir) :</span>
                    <div style={{ display: 'flex', flexWrap: 'wrap', gap: 6 }}>
                      {Array.from({ length: Math.min(total, 200) }, (_, i) => i + 1).map((n) => {
                        const on = unseen.includes(n)
                        return <button key={n} onClick={() => setTracker({ unseen: on ? unseen.filter((x) => x !== n) : [...unseen, n].sort((a, b) => a - b) })}
                          style={{ minWidth: 32, height: 30, padding: '0 6px', borderRadius: 8, border: 'none', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', background: on ? accent : ((t && t.cardBg) || 'rgba(127,127,127,.14)'), color: on ? '#fff' : textP }}>{n}</button>
                      })}
                    </div>
                  </div>
                )}
              </div>
            )
          })()}

          {/* Notes (Markdown, édition simple) */}
          <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
            <span style={{ fontSize: 'var(--zr-ui-xs)', textTransform: 'uppercase', letterSpacing: 0.8, color: textS }}>Notes</span>
            <textarea value={notes} onChange={(e) => setNotes(e.target.value)} onBlur={saveNotes} placeholder=""
              style={{ ...field, minHeight: 200, resize: 'vertical', lineHeight: 1.55, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)' }} />
          </div>

          <button onClick={() => { if (window.confirm(`Retirer « ${item.name} » de l'étagère ?`)) onDelete() }}
            style={{ alignSelf: 'flex-start', display: 'inline-flex', alignItems: 'center', gap: 6, background: 'transparent', color: '#9B5A57', border: `1px solid ${border}`, borderRadius: 8, padding: '7px 13px', fontSize: 'var(--zr-ui-sm)', fontWeight: 600, cursor: 'pointer', fontFamily: FONTS.sans, marginTop: 4 }}>
            <Icon name="trash" size={14} color="currentColor" />Retirer
          </button>
        </div>

        <style>{`@keyframes shelfCardPop{from{opacity:0;transform:scale(0.92)}to{opacity:1;transform:scale(1)}}`}</style>
      </aside>
    </>,
    document.body,
  )
}

// ── Picker de poster (recherche d'images WEB type Google -> 3 tuiles -> pick -> ingestion jsDelivr) ──────
// « Chercher des images » fait une recherche d'images web (keyless, DuckDuckGo) sur le titre + catégorie et
// affiche les 3 PREMIERS résultats. « Autres » remplace par les 3 suivants (on défile le pool sans re-requête).
// Au clic sur une tuile : l'image est TÉLÉCHARGÉE et STOCKÉE en public (ingestShelfImage) -> URL jsDelivr stable.
function PosterPicker({ name, cat, t, onPick }) {
  const [pool, setPool] = useState(null) // null=jamais cherché, []=aucun, [...]=résultats web
  const [offset, setOffset] = useState(0) // index du trio courant dans le pool
  const [loading, setLoading] = useState(false)
  const [busyIdx, setBusyIdx] = useState(-1)
  const textS = (t && t.textSecondary) || '#8E8E93'
  const border = (t && t.border) || '#3A3A38'
  const accent = (t && t.accent) || PALETTE.primary
  const land = cat === 'games'
  const TRIO = 3

  const run = async () => {
    const q = (name || '').trim(); if (!q) return
    setLoading(true); setPool(null); setOffset(0)
    const r = await searchShelfPosters(q, cat) // mode combiné : API média (RAWG/TMDB/AniList) + images web
    setPool(r); setLoading(false)
  }
  // « Autres » : avance de 3 dans le pool (boucle au début quand on atteint la fin).
  const more = () => { if (pool && pool.length > TRIO) setOffset((o) => (o + TRIO) % pool.length) }
  const pick = async (cand, i) => {
    setBusyIdx(i)
    const cdn = await ingestShelfImage({ url: cand.image, name: name || cand.title, cat })
    setBusyIdx(-1)
    onPick(cdn || cand.image) // si l'ingestion échoue, on garde au moins l'URL d'origine (mieux que rien)
  }

  // Les 3 tuiles visibles (slice circulaire à partir de offset).
  const trio = pool && pool.length ? Array.from({ length: Math.min(TRIO, pool.length) }, (_, k) => pool[(offset + k) % pool.length]) : []

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
      <div style={{ display: 'flex', gap: 8, alignItems: 'center', flexWrap: 'wrap' }}>
        <button type="button" onClick={run} disabled={loading || !(name || '').trim()}
          style={{ display: 'inline-flex', alignItems: 'center', gap: 6, background: 'transparent', color: accent, border: `1px solid ${border}`, borderRadius: 99, padding: '6px 12px', fontSize: 'var(--zr-ui-sm)', fontWeight: 600, cursor: (name || '').trim() ? 'pointer' : 'default', fontFamily: FONTS.sans, opacity: (name || '').trim() ? 1 : 0.5 }}>
          <Icon name="sparkles" size={13} color={accent} />{loading ? 'Recherche…' : 'Chercher des images'}
        </button>
        {pool && pool.length > TRIO && (
          <button type="button" onClick={more} title="3 résultats suivants"
            style={{ display: 'inline-flex', alignItems: 'center', gap: 5, background: 'transparent', color: textS, border: `1px solid ${border}`, borderRadius: 99, padding: '6px 11px', fontSize: 'var(--zr-ui-sm)', fontWeight: 600, cursor: 'pointer', fontFamily: FONTS.sans }}>
            <Icon name="arrow.clockwise" size={12} color={textS} />Autres
          </button>
        )}
      </div>
      {pool && pool.length === 0 && <div style={{ fontSize: 'var(--zr-ui-sm)', color: textS }}>Aucune image trouvée. Saisis une URL ci-dessous, ou affine le titre.</div>}
      {trio.length > 0 && (
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: 8, padding: 2 }}>
          {trio.map((c, i) => (
            <button key={`${offset}-${i}-${c.image}`} type="button" onClick={() => pick(c, i)} title={`${c.title || ''} · ${c.source || 'web'}`}
              style={{ position: 'relative', padding: 0, border: `1px solid ${border}`, borderRadius: 8, overflow: 'hidden', cursor: 'pointer', background: '#15151f', aspectRatio: land ? '3 / 2' : '2 / 3' }}>
              <img src={c.image} alt="" loading="lazy" referrerPolicy="no-referrer" style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block', opacity: busyIdx === i ? 0.4 : 1 }} />
              {busyIdx === i && <div style={{ position: 'absolute', inset: 0, display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#fff', fontSize: 'var(--zr-ui-xs)', background: 'rgba(0,0,0,0.4)' }}>…</div>}
            </button>
          ))}
        </div>
      )}
    </div>
  )
}

// ── Modale d'ajout ────────────────────────────────────────────────────────
function AddModal({ t, cat, initialName, initialImage, onClose, onAdd }) {
  const [name, setName] = useState(initialName || '')
  const [status, setStatus] = useState('backlog')
  const [score, setScore] = useState('')
  const [image, setImage] = useState(initialImage || '') // deep link : URL externe -> ingérée à la soumission
  const [picked, setPicked] = useState(false) // image issue du picker = déjà jsDelivr -> pas de ré-ingestion
  const [busy, setBusy] = useState(false)

  const cardBg = (t && t.cardBg) || '#2A2A29'
  const border = (t && t.border) || '#3A3A38'
  const textP = (t && t.textPrimary) || '#ECECEA'
  const textS = (t && t.textSecondary) || '#8E8E93'
  const accent = (t && t.accent) || PALETTE.primary
  const field = { background: (t && t.bg) || '#1F1F1E', color: textP, border: `1px solid ${border}`, borderRadius: 8, padding: '9px 12px', fontSize: 'var(--zr-ui-md)', outline: 'none', fontFamily: FONTS.sans, width: '100%', boxSizing: 'border-box' }

  const submit = async () => {
    const nm = name.trim()
    if (!nm || busy) return
    const sc = score.trim() === '' ? null : Math.max(0, Math.min(100, parseInt(score, 10) || 0))
    let imageObj = null
    const raw = image.trim()
    if (raw) {
      // URL collée manuellement -> on l'ingère (download + stockage public jsDelivr). Image du picker = déjà cdn.
      let ref = raw
      if (!picked) { setBusy(true); const cdn = await ingestShelfImage({ url: raw, name: nm, cat: cat.key }); setBusy(false); ref = cdn || raw }
      imageObj = { kind: 'url', ref }
    }
    onAdd({ name: nm, score: sc, status, tags: [], extra: {}, image: imageObj, notes: null })
  }

  return createPortal(
    <>
      <div onClick={onClose} style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.5)', zIndex: 90, backdropFilter: 'blur(3px)' }} />
      <div role="dialog" style={{ position: 'fixed', top: '50%', left: '50%', transform: 'translate(-50%, -50%)', width: 'min(420px, 92vw)', background: cardBg, border: `1px solid ${border}`, borderRadius: RADII.lg, boxShadow: '0 30px 80px rgba(0,0,0,0.5)', zIndex: 91, padding: 22, display: 'flex', flexDirection: 'column', gap: 14, fontFamily: FONTS.sans }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
          <div style={{ fontFamily: FONTS.serif, fontSize: 20, fontWeight: 700, color: textP }}>Ajouter</div>
          <span style={{ fontSize: 'var(--zr-ui-sm)', color: textS }}>· {cat.label}</span>
          <button onClick={onClose} title="Fermer" style={{ marginLeft: 'auto', background: 'transparent', border: 'none', cursor: 'pointer', color: textS, padding: 2, display: 'inline-flex' }}><Icon name="xmark" size={18} color="currentColor" /></button>
        </div>

        <label style={{ display: 'flex', flexDirection: 'column', gap: 5 }}>
          <span style={{ fontSize: 'var(--zr-ui-xs)', textTransform: 'uppercase', letterSpacing: 0.8, color: textS }}>Titre</span>
          <input autoFocus value={name} onChange={(e) => setName(e.target.value)} onKeyDown={(e) => { if (e.key === 'Enter') submit() }} placeholder="Nom de l'œuvre" style={field} />
        </label>

        <div style={{ display: 'flex', gap: 12 }}>
          <label style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 5 }}>
            <span style={{ fontSize: 'var(--zr-ui-xs)', textTransform: 'uppercase', letterSpacing: 0.8, color: textS }}>Status</span>
            <select value={status} onChange={(e) => setStatus(e.target.value)} style={{ ...field, cursor: 'pointer' }}>
              {STATUS_ORDER.map((s) => <option key={s} value={s}>{st(s).label}</option>)}
            </select>
          </label>
          <label style={{ flex: '0 0 100px', display: 'flex', flexDirection: 'column', gap: 5 }}>
            <span style={{ fontSize: 'var(--zr-ui-xs)', textTransform: 'uppercase', letterSpacing: 0.8, color: textS }}>Score</span>
            <input value={score} onChange={(e) => setScore(e.target.value)} onKeyDown={(e) => { if (e.key === 'Enter') submit() }} placeholder="0–100" inputMode="numeric" style={field} />
          </label>
        </div>

        <label style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
          <span style={{ fontSize: 'var(--zr-ui-xs)', textTransform: 'uppercase', letterSpacing: 0.8, color: textS }}>Image du poster</span>
          {/* Picker : cherche par TITRE sur les API média, propose des tuiles, télécharge+stocke en public au pick. */}
          <PosterPicker name={name} cat={cat.key} t={t} onPick={(u) => { setImage(u); setPicked(true) }} />
          {image.trim() && (
            <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginTop: 2 }}>
              <img src={image.trim()} alt="" style={{ width: 34, height: 46, objectFit: 'cover', borderRadius: 6, border: `1px solid ${border}` }} />
              <span style={{ fontSize: 'var(--zr-ui-xs)', color: picked ? accent : textS }}>{picked ? 'Image stockée ✓' : 'URL personnalisée (sera téléchargée)'}</span>
              <button onClick={() => { setImage(''); setPicked(false) }} title="Retirer" style={{ marginLeft: 'auto', background: 'transparent', border: 'none', color: textS, cursor: 'pointer', display: 'inline-flex' }}><Icon name="xmark" size={14} color="currentColor" /></button>
            </div>
          )}
          <input value={picked ? '' : image} onChange={(e) => { setImage(e.target.value); setPicked(false) }} onKeyDown={(e) => { if (e.key === 'Enter') submit() }} placeholder="… ou colle une URL d'image" style={{ ...field, marginTop: 2 }} />
        </label>

        <div style={{ display: 'flex', gap: 10, justifyContent: 'flex-end', marginTop: 4 }}>
          <button onClick={onClose} style={{ background: 'transparent', color: textS, border: `1px solid ${border}`, borderRadius: 99, padding: '8px 16px', fontSize: 'var(--zr-ui-md)', fontWeight: 600, cursor: 'pointer', fontFamily: FONTS.sans }}>Annuler</button>
          <button onClick={submit} disabled={!name.trim() || busy} style={{ background: name.trim() ? accent : border, color: '#fff', border: 'none', borderRadius: 99, padding: '8px 18px', fontSize: 'var(--zr-ui-md)', fontWeight: 700, cursor: (name.trim() && !busy) ? 'pointer' : 'default', fontFamily: FONTS.sans, opacity: (name.trim() && !busy) ? 1 : 0.6 }}>{busy ? 'Ajout…' : 'Ajouter'}</button>
        </div>
      </div>
    </>,
    document.body,
  )
}
