// ════════════════════════════════════════════════════════════════════════
// SHELF — bibliothèque personnelle façon Apple TV (jeux · anime/manga · films/séries/docs).
// Greenfield. Monté par App.jsx dans la sidebar (zone Système). Export par défaut <Shelf t={...} />.
//
// Données : seed = public/shelf/<cat>.json (fetch direct). Écritures (notes/status/score/ajout/image)
// persistées via le MÊME mécanisme que SfxView (Audio.jsx) : saveJsonWithRetry('shelf/<cat>.json', mutate)
// (read-modify-write par identité, retry 409, append-compatible). Au chargement, on lit d'abord la version
// LIVE via /api/page?action=read ; si absente (jamais éditée), on retombe sur le seed public/.
//
// UI : grille auto-fill de POSTERS portrait 2:3, coins ~12px, gap ~18px, hover = léger zoom (signature
// Apple TV). Carte = image plein cadre + vignette dégradée sombre en bas, score en haut-gauche, titre en
// SERIF (AnthropicSerif) en bas, pastille de status. Sans image -> dégradé élégant + titre lisible.
// ════════════════════════════════════════════════════════════════════════

const FONTS = { sans: "var(--zr-police-sans)", serif: "var(--zr-police-serif)" }

const CATS = [
  { key: 'games', label: 'Games', path: 'shelf/games.json' },
  { key: 'anime-manga', label: 'Anime & Manga', path: 'shelf/anime-manga.json' },
  { key: 'movies', label: 'Movies, Series & Docs', path: 'shelf/movies.json' },
  // Books (2026-07-08, demande Matthieu) : seed initial = les 213 livres de son export Notion (Memory/
  // Culture/Culture1.md, section Livres), généré une fois par scripts/build-shelf-books.mjs — jamais
  // regénéré automatiquement (ce serait écraser les modifs faites depuis dans l'app). Portrait 2:3 comme
  // anime/movies (pas de mode paysage dédié, une couverture de livre est déjà portrait).
  { key: 'books', label: 'Books', path: 'shelf/books.json' },
]
const catByKey = (k) => CATS.find((c) => c.key === k) || CATS[0]

// Status : ordre canonique + couleur de pastille (in_progress=bleu, backlog=gris, done=vert, dropped=rouge fané).
const STATUS = {
  in_progress: { label: 'In Progress', color: PALETTE.primary, order: 0 },
  backlog: { label: 'Backlog', color: '#8E8E93', order: 1 },
  done: { label: 'Done', color: PALETTE.green, order: 2 },
  dropped: { label: 'Dropped', color: '#9B5A57', order: 3 },
}
const STATUS_ORDER = ['in_progress', 'backlog', 'done', 'dropped']
const st = (s) => STATUS[s] || STATUS.backlog

// Source d'une image stockée dans le drive (shard privé/public) — même résolveur que le reste de l'app.
const imgSrc = (p) => `/api/img?path=${encodeURIComponent(p)}`
// URL d'affichage d'un poster : kind 'url' = direct, kind 'shard' = via /api/img. null -> pas d'image.
const posterUrl = (image) => {
  if (!image) return null
  if (typeof image === 'string') return image // tolère un champ image = URL brute
  if (image.kind === 'url') return image.ref
  if (image.kind === 'shard') return imgSrc(image.ref)
  return null
}

// ANTI-IMAGE-NOIRE : jsDelivr peut mettre quelques minutes à mettre en cache un commit TOUT NEUF (404 transitoire
// -> carte noire alors que l'image EST bien sur GitHub). On bascule alors sur raw.githubusercontent.com, qui sert
// le même commit IMMÉDIATEMENT (repo public, pas de propagation CDN). Conversion d'URL équivalente, même sha :
//   https://cdn.jsdelivr.net/gh/<owner>/<repo>@<ref>/<path>  ->  https://raw.githubusercontent.com/<owner>/<repo>/<ref>/<path>
const jsdelivrToRaw = (u) => {
  const m = (u || '').match(/^https:\/\/cdn\.jsdelivr\.net\/gh\/([^/]+)\/([^@/]+)@([^/]+)\/(.+)$/)
  return m ? `https://raw.githubusercontent.com/${m[1]}/${m[2]}/${m[3]}/${m[4]}` : null
}

// Dégradé déterministe (carte sans poster) : la même œuvre garde toujours la même couleur. Hash simple du id.
const FALLBACK_GRADS = [
  ['#3a3a52', '#15151f'], ['#4a2f3a', '#1a0f14'], ['#2f4a45', '#0f1a18'], ['#42385a', '#16111f'],
  ['#5a4a2f', '#1f180f'], ['#2f3f5a', '#0f151f'], ['#503a4a', '#1c1118'], ['#3a5a4a', '#111f18'],
  ['#5a3a3a', '#1f1111'], ['#3a4a5a', '#11171f'],
]
const hashStr = (s) => { let h = 0; for (let i = 0; i < (s || '').length; i++) h = (h * 31 + s.charCodeAt(i)) | 0; return Math.abs(h) }
const fallbackGrad = (id) => { const [a, b] = FALLBACK_GRADS[hashStr(id) % FALLBACK_GRADS.length]; return `linear-gradient(160deg, ${a} 0%, ${b} 100%)` }

const fmtScore = (n) => (n === 0 || n ? String(n) : '—')
const nowIso = () => new Date().toISOString()

// ── Cache local durable (anti-perte au refresh immédiat) ──────────────────────
// Le commit GitHub est async (~1-3 s) et abortable par un F5. On écrit donc CHAQUE mutation en localStorage
// SYNCHRONEMENT (instantané, survit au refresh) avec un flag `pending`. Au rechargement, si le cache porte une
// écriture non confirmée, on la restaure ET on la re-commite. Confirmé (res.ok) -> pending:false. Zéro perte.
const LS_KEY = (path) => `zr-shelf-v1:${path}`
const lsRead = (path) => { try { return JSON.parse(localStorage.getItem(LS_KEY(path)) || 'null') } catch { return null } }
const lsWrite = (path, obj) => { try { localStorage.setItem(LS_KEY(path), JSON.stringify(obj)) } catch {} }
const slugify = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '').slice(0, 48) || 'item'
const newId = (name) => `${slugify(name)}-${Math.random().toString(16).slice(2, 6)}`

// ── Export client (CSV / Markdown / JSON) ─────────────────────────────────
const download = (filename, text, mime) => {
  const blob = new Blob([text], { type: mime })
  const url = URL.createObjectURL(blob)
  const a = document.createElement('a'); a.href = url; a.download = filename; document.body.appendChild(a); a.click(); a.remove()
  setTimeout(() => URL.revokeObjectURL(url), 1000)
}
const csvCell = (v) => { const s = v == null ? '' : String(v); return /[",\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s }
const exportCSV = (cat, items) => {
  const head = ['Name', 'Score', 'Status', 'Tags', 'Extra', 'Image', 'Notes']
  const rows = items.map((i) => [i.name, fmtScore(i.score), st(i.status).label, (i.tags || []).join('; '), JSON.stringify(i.extra || {}), posterUrl(i.image) || '', (i.notes || '').replace(/\n/g, '\\n')])
  download(`shelf-${cat.key}.csv`, [head, ...rows].map((r) => r.map(csvCell).join(',')).join('\n'), 'text/csv')
}
const exportJSON = (cat, items) => download(`shelf-${cat.key}.json`, JSON.stringify({ v: 1, category: cat.key, label: cat.label, items }, null, 2), 'application/json')
const exportMD = (cat, items) => {
  const lines = [`# ${cat.label}`, '']
  for (const g of STATUS_ORDER) {
    const sub = items.filter((i) => i.status === g)
    if (!sub.length) continue
    lines.push(`## ${st(g).label}`, '')
    for (const i of sub) {
      lines.push(`### ${i.name}${(i.score === 0 || i.score) ? ` — ${i.score}` : ''}`)
      if ((i.tags || []).length) lines.push(`*Tags:* ${i.tags.join(', ')}`)
      const ex = Object.entries(i.extra || {}).filter(([, v]) => v)
      for (const [k, v] of ex) lines.push(`*${k}:* ${v}`)
      if (i.notes) lines.push('', i.notes)
      lines.push('')
    }
  }
  download(`shelf-${cat.key}.md`, lines.join('\n'), 'text/markdown')
}

// ════════════════════════════════════════════════════════════════════════
export default function Shelf({ t }) {
  const [cat, setCat] = useState('games')
  // Sélecteur de catégorie « capsule repliée » (2026-07-08, demande Matthieu, précise la 1re tentative
  // qui grossissait juste la cellule active sans jamais cacher les autres) : au repos, SEULE la capsule
  // active est visible ; hover (desktop) ou clic (mobile, pas de hover tactile) déplie les autres à côté
  // pour choisir ; choisir une catégorie replie aussitôt sur la nouvelle capsule seule. Clic en dehors =
  // repli sans changer (même patron que Pop dans uiPrefs.jsx, mais inline dans la barre au lieu d'un menu
  // flottant en dessous — ces capsules restent DANS le flux de la barre, jamais un popover superposé).
  // LA PASTILLE SE MESURE, elle ne se devine pas. Aucune regle CSS ne connait la largeur d'un libelle :
  // « Movies, Series & Docs » et « Books » n'ont pas la meme, donc une pastille a largeur fixe serait
  // fausse trois fois sur quatre. On releve la geometrie de l'onglet actif et on la pose en variables sur
  // le conteneur, d'ou la transition part toute seule.
  const tabsRef = useRef(null)
  useLayoutEffect(() => {
    const placer = () => {
      const boite = tabsRef.current
      if (!boite) return
      const actif = boite.querySelector('.zr-shelf-tab[aria-pressed="true"]')
      if (!actif) return
      const b = boite.getBoundingClientRect()
      const a = actif.getBoundingClientRect()
      boite.style.setProperty('--pastille-x', `${Math.round(a.left - b.left)}px`)
      boite.style.setProperty('--pastille-l', `${Math.round(a.width)}px`)
      boite.style.setProperty('--pastille-h', `${Math.round(a.height)}px`)
    }
    placer()
    // Les polices arrivent apres le premier rendu : sans ce second passage, la pastille garde la largeur
    // du texte mesure en police de repli, donc quelques pixels de trop ou de moins.
    const id = setTimeout(placer, 350)
    window.addEventListener('resize', placer)
    if (document.fonts?.ready) document.fonts.ready.then(placer).catch(() => {})
    return () => { clearTimeout(id); window.removeEventListener('resize', placer) }
  }, [cat])
  const [q, setQ] = useState('')
  const [sel, setSel] = useState(null)       // id de l'œuvre ouverte dans le panneau détail
  const [selRect, setSelRect] = useState(null) // rect de la carte cliquée -> on ancre le modal DESSUS
  const openItem = (id, rect) => { setSel(id); setSelRect(rect || null) }
  const [adding, setAdding] = useState(false)
  const [addSeed, setAddSeed] = useState(null) // pré-remplissage (deep link Chrome/bookmarklet) : {name, image}
  const [exportOpen, setExportOpen] = useState(false)
  const [dragActive, setDragActive] = useState(false) // un drag est en cours ? pilote le nettoyage GARANTI du surlignage (tirets)

  // État par catégorie : { items, sha, loaded, live }. live = la version drive existait (vs seed public/).
  const [store, setStore] = useState({})
  const cur = store[cat] || { items: null, sha: null }

  // Chargement paresseux par catégorie : LIVE (drive) d'abord, sinon SEED (public/). Une seule fois par cat.
  useEffect(() => {
    if (store[cat]) return
    let alive = true
    const c = catByKey(cat)
    setStore((s) => ({ ...s, [cat]: { items: null, sha: null } }))
    ;(async () => {
      const live = await fetch(`/api/page?action=read&path=${encodeURIComponent(c.path)}`, { cache: 'no-store' }).then((r) => r.json()).catch(() => null)
      let items = null, sha = null, isLive = false
      if (live && live.markdown && !live.missing) {
        try { const j = JSON.parse(live.markdown); items = j.items || []; sha = live.sha || null; isLive = true } catch { items = null }
      }
      if (items === null) {
        const seed = await fetch(`/${c.path}`, { cache: 'no-store' }).then((r) => r.json()).catch(() => null)
        items = (seed && seed.items) || []
      }
      // RÉCONCILIATION : si le cache local porte une écriture NON confirmée (refresh juste après une modif,
      // commit jamais atterri), on restaure le local ET on re-commite vers le drive. Sinon, le drive fait foi.
      const cached = lsRead(c.path)
      if (cached && cached.pending && Array.isArray(cached.items)) {
        if (alive) setStore((s) => ({ ...s, [cat]: { items: cached.items, sha: sha ?? cached.sha ?? null, live: true } }))
        saveJsonWithRetry(c.path, (obj) => ({ v: 1, category: c.key, label: c.label, ...obj, items: cached.items }),
          { sha: sha ?? cached.sha ?? null, data: { v: 1, category: c.key, label: c.label, items } })
          .then((res) => {
            if (res.ok) { lsWrite(c.path, { items: res.data.items || cached.items, sha: res.sha, pending: false, savedAt: Date.now() }); if (alive) setStore((s) => ({ ...s, [cat]: { items: res.data.items || cached.items, sha: res.sha, live: true } })) }
          })
        return
      }
      if (alive) { setStore((s) => ({ ...s, [cat]: { items, sha, live: isLive } })); lsWrite(c.path, { items, sha, pending: false, savedAt: Date.now() }) }
    })()
    return () => { alive = false }
  }, [cat]) // eslint: store volontairement non-listé (garde init unique par cat)

  // DEEP LINK : App.jsx a déposé un payload {image,name,cat} (clic droit extension Chrome / bookmarklet).
  // On bascule sur la bonne catégorie et on ouvre la modale Ajouter pré-remplie. L'image (URL externe) sera
  // téléchargée + stockée en public à la soumission (déjà géré par AddModal.submit).
  useEffect(() => {
    let seed = null
    try { const raw = localStorage.getItem('zr:shelf:add'); if (raw) { seed = JSON.parse(raw); localStorage.removeItem('zr:shelf:add') } } catch {}
    if (!seed || !seed.image) return
    if (seed.cat && CATS.some((c) => c.key === seed.cat)) setCat(seed.cat)
    setAddSeed({ name: seed.name || '', image: seed.image }); setAdding(true)
  }, [])

  // Pile d'annulation par catégorie : avant CHAQUE mutation on empile l'état précédent (Ctrl/Cmd+Z restaure).
  const undoStacks = useRef({})

  // Persistance d'une mutation sur la catégorie courante. Optimiste + saveJsonWithRetry (retry 409).
  // Le manifeste écrit conserve TOUT le schéma seed ({v,category,label,items}) pour rester relisable.
  const persist = async (mutate, { snapshot = true } = {}) => {
    const c = catByKey(cat)
    const before = cur.items || []
    if (snapshot) { const stk = (undoStacks.current[cat] || (undoStacks.current[cat] = [])); stk.push(before); if (stk.length > 60) stk.shift() }
    const local = mutate(before)
    setStore((s) => ({ ...s, [cat]: { ...s[cat], items: local } }))
    lsWrite(c.path, { items: local, sha: cur.sha, pending: true, savedAt: Date.now() }) // durable AVANT le réseau
    const res = await saveJsonWithRetry(
      c.path,
      (obj) => ({ v: 1, category: c.key, label: c.label, ...obj, items: mutate(obj.items || (cur.items || [])) }),
      { sha: cur.sha, data: { v: 1, category: c.key, label: c.label, items: before } },
    )
    if (res.ok) { setStore((s) => ({ ...s, [cat]: { items: (res.data.items) || local, sha: res.sha, live: true } })); lsWrite(c.path, { items: res.data.items || local, sha: res.sha, pending: false, savedAt: Date.now() }) }
    // res.ok=false -> on laisse pending:true : la prochaine ouverture de la catégorie re-commitera tout seul.
    return res.ok
  }

  const items = cur.items
  const setItem = (id, patch) => persist((arr) => arr.map((x) => x.id === id ? { ...x, ...patch, updatedAt: nowIso() } : x))
  const addItem = (it) => persist((arr) => [{ ...it, id: newId(it.name), createdAt: nowIso(), updatedAt: nowIso() }, ...arr])
  const removeItem = (id) => persist((arr) => arr.filter((x) => x.id !== id))

  // Annulation (Ctrl/Cmd+Z) : restaure le dernier instantané de la catégorie courante et le persiste.
  // Ignoré quand le panneau détail est ouvert (on laisse l'annulation native du textarea de notes).
  const undo = useCallback(() => {
    const stk = undoStacks.current[cat]; if (!stk || !stk.length) return
    const prev = stk.pop()
    setStore((s) => ({ ...s, [cat]: { ...s[cat], items: prev } }))
    const c = catByKey(cat)
    lsWrite(c.path, { items: prev, sha: cur.sha, pending: true, savedAt: Date.now() })
    saveJsonWithRetry(c.path, (obj) => ({ v: 1, category: c.key, label: c.label, ...obj, items: prev }),
      { sha: cur.sha, data: { v: 1, category: c.key, label: c.label, items: cur.items || [] } })
      .then((res) => { if (res.ok) { setStore((s) => ({ ...s, [cat]: { items: res.data.items || prev, sha: res.sha, live: true } })); lsWrite(c.path, { items: res.data.items || prev, sha: res.sha, pending: false, savedAt: Date.now() }) } })
  }, [cat, cur.items, cur.sha])
  useEffect(() => {
    const onKey = (e) => { if ((e.metaKey || e.ctrlKey) && !e.shiftKey && (e.key === 'z' || e.key === 'Z')) { if (sel) return; e.preventDefault(); undo() } }
    window.addEventListener('keydown', onKey); return () => window.removeEventListener('keydown', onKey)
  }, [undo, sel])
  // Filet ultime pour un drag ANNULÉ (drop hors zone, Échap) : la carte source n'est PAS démontée -> son dragend
  // remonte jusqu'ici et remet dragActive à false. (Sur un drop réussi, dropOn l'a déjà fait, même quand la carte
  // change de section et que sa source est démontée — cas où dragend ne se déclenche jamais.)
  useEffect(() => { const off = () => setDragActive(false); window.addEventListener('dragend', off); return () => window.removeEventListener('dragend', off) }, [])
  // DRAG entre status : glisser une carte sur une autre SECTION (ou sur une carte) la déplace là ET lui donne le
  // status cible. Le tri par score range ensuite ; à score égal, l'ordre du tableau (placement manuel) tient car
  // le sort est stable. Image de drag = un vrai poster arrondi (pas le ghost plat du navigateur).
  const dragId = useRef(null)
  const dragApi = {
    start: (id, e) => {
      setDragActive(true)
      dragId.current = id
      const it = (items || []).find((x) => x.id === id); const u = it && posterUrl(it.image)
      const ls = cat === 'games'; const gw = ls ? 174 : 116, gh = ls ? 116 : 174 // image fantôme au bon format (paysage pour Games)
      const g = document.createElement('div')
      g.style.cssText = `position:fixed;top:-9999px;left:0;width:${gw}px;height:${gh}px;border-radius:12px;overflow:hidden;box-shadow:0 18px 44px -8px rgba(0,0,0,0.65);background:${u ? '#15151f' : '#2c2c30'}`
      if (u) { const im = document.createElement('img'); im.src = u; im.style.cssText = 'width:100%;height:100%;object-fit:cover'; g.appendChild(im) }
      document.body.appendChild(g)
      e.dataTransfer.effectAllowed = 'move'
      try { e.dataTransfer.setDragImage(g, gw / 2, gh / 2) } catch {}
      setTimeout(() => g.remove(), 0)
    },
    dropOn: (targetId, targetStatus, after = false) => {
      setDragActive(false) // efface le surlignage de TOUTES les sections — tourne sur CHAQUE drop (carte ou section)
      const from = dragId.current; dragId.current = null
      if (!from || from === targetId) return
      persist((arr) => {
        const a = [...arr]; const fi = a.findIndex((x) => x.id === from); if (fi < 0) return arr
        const moved = { ...a[fi], status: targetStatus, updatedAt: nowIso() }
        a.splice(fi, 1)
        const ti = targetId ? a.findIndex((x) => x.id === targetId) : -1
        // Insertion À GAUCHE (avant la cible) ou À DROITE (après) selon le côté du drop.
        if (ti >= 0) a.splice(after ? ti + 1 : ti, 0, moved); else a.push(moved)
        return a
      })
    },
  }

  // Filtre + tri. Score = décroissant (null en bas). Status = groupé dans l'ordre canonique, score décroissant dedans.
  const qn = q.trim().toLowerCase()
  const filtered = useMemo(() => {
    let a = items || []
    if (qn) a = a.filter((x) => `${x.name} ${(x.tags || []).join(' ')}`.toLowerCase().includes(qn))
    return a
  }, [items, qn])

  // Score décroissant ; à score ÉGAL, l'ordre du tableau est conservé (sort stable) = le placement manuel par drag.
  const byScore = (a, b) => (b.score ?? -1) - (a.score ?? -1)
  // Split par statut (+ tri du « Done » par score), memoïsé sur `filtered` : sinon les 4 listes sont re-filtrées
  // à CHAQUE render — y compris à chaque survol de section pendant un drag (coût inutile sur ~348 cartes).
  // eslint-disable-next-line react-hooks/exhaustive-deps
  const byStatus = useMemo(() => STATUS_ORDER.map((g) => {
    const list = filtered.filter((x) => x.status === g)
    return { g, list: g === 'done' ? [...list].sort(byScore) : list }
  }), [filtered])

  const selItem = useMemo(() => (items || []).find((x) => x.id === sel) || null, [items, sel])

  const accent = (t && t.accent) || PALETTE.primary
  const landscape = cat === 'games' // Games = cartes PAYSAGE 3:2 (art RAWG horizontal) ; anime & movies restent PORTRAIT 2:3

  return (
    <div style={{ fontFamily: FONTS.sans, color: '#ECECEA', display: 'flex', flexDirection: 'column', gap: 16 }}>
      {/* Pulse discret (2026-07-08, demande Matthieu, corrigé même jour : le pulse en boucle automatique ne
          répondait à aucune interaction réelle -> aucun signal quand on survolait. Le pulse se déclenche
          maintenant UNIQUEMENT au survol (:hover pur CSS, pas de JS) de la capsule repliée : 0,33 s (scale
          1 -> 1,05 -> 1) à chaque entrée de souris. S'arrête dès que la barre est dépliée (classe retirée). */}
      <style>{`@keyframes shelfTabHint{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}
        .shelf-tab-hint:hover{animation:shelfTabHint .33s ease-in-out}
        /* LA PASTILLE GLISSANTE. Posee sous les libelles, elle se deplace vers l'onglet actif au lieu
           d'apparaitre dessus : c'est le mouvement, et lui seul, qui fait comprendre qu'on change de
           section plutot qu'on allume un autre bouton. La courbe depasse legerement puis revient, ce
           qui donne le geste sur de lui plutot que le glissement mou. */
        .zr-shelf-pastille{position:absolute;left:4px;top:50%;pointer-events:none;border-radius:99px;
          width:var(--pastille-l,0);height:var(--pastille-h,0);
          transform:translate(var(--pastille-x,0),-50%);
          transition:transform .38s cubic-bezier(.34,1.56,.64,1),width .38s cubic-bezier(.34,1.56,.64,1)}
        .zr-shelf-tab{z-index:1}
        .zr-shelf-tab:hover{transform:translateY(-1px)}
        .zr-shelf-tab[aria-pressed="true"]:hover{transform:none}
        @media (prefers-reduced-motion: reduce){.zr-shelf-pastille{transition-duration:.01ms}}`}</style>
      {/* En-tête : titre + onglets catégories + recherche */}
