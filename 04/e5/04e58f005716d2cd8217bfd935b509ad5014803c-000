      ))}

      {selItem && (
        <DetailPanel item={selItem} t={t} cat={cat} rect={selRect} onClose={() => setSel(null)}
          onChange={(patch) => setItem(selItem.id, patch)}
          onDelete={() => { removeItem(selItem.id); setSel(null) }} />
      )}

      {adding && (
        <AddModal t={t} cat={catByKey(cat)} initialName={addSeed && addSeed.name} initialImage={addSeed && addSeed.image}
          onClose={() => { setAdding(false); setAddSeed(null) }}
          onAdd={(it) => { addItem(it); setAdding(false); setAddSeed(null) }} />
