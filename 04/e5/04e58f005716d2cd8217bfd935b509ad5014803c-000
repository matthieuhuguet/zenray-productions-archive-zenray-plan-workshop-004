        </div>
      </div>

      {/* Contenu : toujours groupé par statut. Dans « Done », tri auto par score décroissant (meilleur en haut) ;
          les autres sections gardent l'ordre manuel (drag & drop). */}
      {items === null && <div style={{ color: (t && t.textSecondary) || '#8E8E93', padding: 40, textAlign: 'center', fontSize: 'var(--zr-ui-lg)' }}>chargement…</div>}
      {items && filtered.length === 0 && (
        <div style={{ color: (t && t.textSecondary) || '#8E8E93', padding: 48, textAlign: 'center', lineHeight: 1.6 }}>
          {qn ? 'Aucune œuvre ne correspond.' : <><b style={{ color: (t && t.textPrimary) || '#ECECEA' }}>Étagère vide.</b><br />Clique sur « Ajouter » pour démarrer.</>}
        </div>
      )}

      {items && filtered.length > 0 && byStatus.map(({ g, list }, gi) => (
        <StatusSection key={g} g={g} gi={gi}
          list={list}
