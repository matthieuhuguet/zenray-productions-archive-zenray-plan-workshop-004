// Worker de vignettes : décode + réduit + encode en WebP HORS du thread UI.
// Pendant un import multi-images, ce travail (lourd : décodage pixel + réencodage) ne gèle plus
// le scroll ni les clics. Utilise OffscreenCanvas (équivalent worker de <canvas>) + createImageBitmap.
//
// Protocole : reçoit { id, blob, maxShort, quality } -> renvoie { id, blob } (WebP) ou { id, blob: null } si l'image
// est indécodable. Une exception est rattrapée et renvoyée comme { id, blob: null } : le thread principal
// la traite alors comme un "pas de vignette" (best-effort), JAMAIS comme un crash.
// Défauts = repli théorique seulement (thumbnailer.js poste TOUJOURS maxShort/quality explicites) ; importés
// de src/config/thumbnail.js pour qu'ils ne puissent jamais diverger silencieusement de la vraie config.
import { THUMB_MAX_SHORT, THUMB_QUALITY } from '../config/thumbnail.js'

self.onmessage = async (e) => {
  const { id, blob, maxShort = THUMB_MAX_SHORT, quality = THUMB_QUALITY } = e.data || {}
  try {
    const bmp = await createImageBitmap(blob)
    const w0 = bmp.width, h0 = bmp.height
    if (!w0 || !h0) { bmp.close && bmp.close(); self.postMessage({ id, blob: null }); return }
    const scale = Math.min(1, maxShort / Math.min(w0, h0))
    const w = Math.max(1, Math.round(w0 * scale))
    const h = Math.max(1, Math.round(h0 * scale))
    const canvas = new OffscreenCanvas(w, h)
    const ctx = canvas.getContext('2d')
    if (!ctx) { bmp.close && bmp.close(); self.postMessage({ id, blob: null }); return }
    ctx.drawImage(bmp, 0, 0, w, h)
    bmp.close && bmp.close()
    const out = await canvas.convertToBlob({ type: 'image/webp', quality })
    self.postMessage({ id, blob: out || null })
  } catch {
    self.postMessage({ id, blob: null })
  }
}
