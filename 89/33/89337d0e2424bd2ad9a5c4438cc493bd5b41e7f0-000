// LE PANNEAU DE TEXTE DU BOARD (demandé par Matthieu le 2026-08-07).
//
// Sa plainte, mot pour mot : « j'ai pas accès aux propriétés ni aux modifications du texte, en plus
// tu n'utilises pas mes textes par défaut, c'est soit AnthropicSerif soit AnthropicSans soit Mono,
// il n'y a que trois choix possibles, il devrait y avoir la taille et la graisse aussi, les
// paramètres ne sont pas affichés à droite ».
//
// Ce panneau REMPLACE le panneau de styles de tldraw (`components.StylePanel`) plutôt que de s'y
// ajouter : deux panneaux de propriétés concurrents pour le même objet seraient exactement la
// seconde source de vérité que ce rework supprime.
//
// CE QUI VIENT DE tldraw ET CE QUI VIENT DE NOUS :
//   · la POLICE et la TAILLE sont des styles natifs (`DefaultFontStyle`, `DefaultSizeStyle`) : on
//     les écrit par l'API de l'éditeur, donc l'annulation, la persistance et la sélection multiple
//     fonctionnent sans qu'on ait à les réécrire.
//   · la GRAISSE n'existe PAS comme style de shape dans tldraw : c'est une marque de texte riche
//     (TipTap). On l'applique donc en parcourant `props.richText` de chaque shape sélectionnée, ce
//     qui la rend disponible SANS entrer en édition — le geste que Matthieu attend d'un panneau.
import React from 'react'
import { useEditor, useValue, DefaultFontStyle, DefaultSizeStyle } from 'tldraw'

// TROIS choix, jamais quatre : la contrainte se tient ici, dans le sélecteur, pas dans le schéma
// (voir le commentaire des polices dans RefBoard.jsx — retirer `draw` du schéma casserait les
// boards qui le portent déjà).
const POLICES = [
  { valeur: 'sans', nom: 'Sans', pile: "var(--zr-police-sans)" },
  { valeur: 'serif', nom: 'Serif', pile: "var(--zr-police-serif)" },
  { valeur: 'mono', nom: 'Mono', pile: "var(--zr-police-mono)" },
]
// Les quatre tailles de tldraw, nommées en clair plutôt qu'en lettres : « s » ne dit rien, « Petit »
// se lit du premier coup.
const TAILLES = [
  { valeur: 's', nom: 'S' },
  { valeur: 'm', nom: 'M' },
  { valeur: 'l', nom: 'L' },
  { valeur: 'xl', nom: 'XL' },
]

// Les shapes qui PORTENT du texte. Une image sélectionnée n'a rien à faire de ce panneau.
const PORTE_DU_TEXTE = new Set(['text', 'note', 'geo', 'arrow', 'frame'])

// Parcourt un document TipTap et pose (ou retire) la marque `bold` sur CHAQUE nœud de texte.
// Pur, récursif, sans dépendance à TipTap lui-même : le document n'est que du JSON.
function appliquerGras(noeud, gras) {
  if (!noeud || typeof noeud !== 'object') return noeud
  if (noeud.type === 'text') {
    const marques = (noeud.marks || []).filter((m) => m && m.type !== 'bold')
    return { ...noeud, marks: gras ? [...marques, { type: 'bold' }] : marques }
  }
  if (Array.isArray(noeud.content)) {
    return { ...noeud, content: noeud.content.map((enfant) => appliquerGras(enfant, gras)) }
  }
  return noeud
}

// Le document porte-t-il DÉJÀ du gras partout ? Sert à afficher le bouton dans le bon état.
function estToutGras(noeud) {
  if (!noeud || typeof noeud !== 'object') return false
  if (noeud.type === 'text') return (noeud.marks || []).some((m) => m && m.type === 'bold')
  if (Array.isArray(noeud.content) && noeud.content.length) return noeud.content.every(estToutGras)
  return false
}

export default function RefTextPanel() {
  const editor = useEditor()

  // `useValue` réabonne le panneau à l'état réactif de tldraw : la sélection, et les styles
  // partagés par les shapes sélectionnées. Sans lui, le panneau afficherait un état figé.
  const selection = useValue('selection', () => editor.getSelectedShapes(), [editor])
  const styles = useValue('styles', () => editor.getSharedStyles(), [editor])

  const shapesTexte = selection.filter((s) => PORTE_DU_TEXTE.has(s.type))
  if (!shapesTexte.length) return null

  const valeurPartagee = (style) => {
    const v = styles.get(style)
    return v && v.type === 'shared' ? v.value : null
  }
  const policeCourante = valeurPartagee(DefaultFontStyle)
  const tailleCourante = valeurPartagee(DefaultSizeStyle)
  const grasCourant = shapesTexte.every((s) => estToutGras(s.props && s.props.richText))

  const poserStyle = (style, valeur) => {
    editor.markHistoryStoppingPoint('panneau texte')
    editor.setStyleForSelectedShapes(style, valeur)
    editor.setStyleForNextShapes(style, valeur)
  }

  const basculerGras = () => {
    const gras = !grasCourant
    editor.markHistoryStoppingPoint('graisse du texte')
    editor.updateShapes(shapesTexte
      .filter((s) => s.props && s.props.richText)
      .map((s) => ({ id: s.id, type: s.type, props: { richText: appliquerGras(s.props.richText, gras) } })))
  }

  const bouton = (actif, contenu, onClick, style) => (
    <button type="button" onClick={onClick} style={{
      flex: 1, minWidth: 0, padding: '7px 6px', cursor: 'pointer',
      border: `1px solid ${actif ? 'var(--color-selected)' : 'var(--color-muted-2)'}`,
      background: actif ? 'var(--color-selected)' : 'transparent',
      color: actif ? '#fff' : 'var(--color-text)',
      borderRadius: 7, font: `500 12px/1.2 var(--zr-police-sans)`,
      ...style,
    }}>{contenu}</button>
  )

  return (
    <div style={{
      position: 'relative', pointerEvents: 'all', width: 208, margin: 8,
      padding: 12, borderRadius: 12,
      background: 'var(--color-panel)', color: 'var(--color-text)',
      boxShadow: 'var(--shadow-2, 0 10px 30px -8px rgba(0,0,0,.35))',
      display: 'flex', flexDirection: 'column', gap: 12,
    }}>
      <div style={{ font: `600 10.5px/1 var(--zr-police-sans)`, letterSpacing: '.08em', textTransform: 'uppercase', opacity: .55 }}>
        Texte{shapesTexte.length > 1 ? ` · ${shapesTexte.length}` : ''}
      </div>

      <div style={{ display: 'flex', flexDirection: 'column', gap: 5 }}>
        <span style={{ font: `400 11px/1 var(--zr-police-sans)`, opacity: .6 }}>Police</span>
        <div style={{ display: 'flex', gap: 5 }}>
          {POLICES.map((p) => bouton(policeCourante === p.valeur, p.nom,
            () => poserStyle(DefaultFontStyle, p.valeur), { fontFamily: p.pile }))}
        </div>
      </div>

      <div style={{ display: 'flex', flexDirection: 'column', gap: 5 }}>
        <span style={{ font: `400 11px/1 var(--zr-police-sans)`, opacity: .6 }}>Taille</span>
        <div style={{ display: 'flex', gap: 5 }}>
          {TAILLES.map((s) => bouton(tailleCourante === s.valeur, s.nom, () => poserStyle(DefaultSizeStyle, s.valeur)))}
        </div>
      </div>

      <div style={{ display: 'flex', flexDirection: 'column', gap: 5 }}>
        <span style={{ font: `400 11px/1 var(--zr-police-sans)`, opacity: .6 }}>Graisse</span>
        {bouton(grasCourant, 'Gras', basculerGras, { fontWeight: 700 })}
      </div>
    </div>
  )
}
