// canonical-rel.test.mjs (12 October 2026)
import test from 'node:test'
import assert from 'node:assert/strict'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { canonicalRel } from './canonical-rel.mjs'

function fixture() {
  const clone = fs.mkdtempSync(path.join(os.tmpdir(), 'canonical-rel-'))
  const dir = path.join(clone, 'pages', 'House Of The Dragon')
  fs.mkdirSync(dir, { recursive: true })
  fs.writeFileSync(path.join(dir, 'x.media.json'), '{}')
  return { clone, dir }
}

test('a path already in the disk case is returned unchanged', () => {
  const { clone, dir } = fixture()
  assert.equal(canonicalRel(clone, path.join(dir, 'x.media.json')), 'pages/House Of The Dragon/x.media.json')
})

test('a folder spelled in another case takes the case of the disk (case-insensitive volumes only)', (t) => {
  const { clone, dir } = fixture()
  const other = path.join(clone, 'pages', 'House of the Dragon', 'x.media.json')
  if (!fs.existsSync(other)) { t.skip('case-sensitive volume: the two spellings are different paths'); return }
  assert.equal(canonicalRel(clone, other), 'pages/House Of The Dragon/x.media.json')
  assert.notEqual(canonicalRel(clone, other), 'pages/House of the Dragon/x.media.json')
})

test('a path outside the clone is refused', () => {
  const { clone } = fixture()
  const outside = fs.mkdtempSync(path.join(os.tmpdir(), 'canonical-outside-'))
  assert.throws(() => canonicalRel(clone, outside), /outside the clone/)
})
