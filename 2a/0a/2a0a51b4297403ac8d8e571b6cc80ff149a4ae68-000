// PublishStagedBatch.test.js (14 October 2026)
import { describe, it, expect } from 'vitest'
import { groupByBin } from './PublishStagedBatch.mjs'

const GiB = 1024 ** 3
describe('groupByBin', () => {
  it('fills a repository bin before opening the next one', () => {
    const items = [1.5, 1.5, 1.5, 1.5, 1.5].map((g, i) => ({ id: i, bytes: g * GiB }))
    const groups = groupByBin(items, 4.2 * GiB)
    expect(groups.map((g) => g.items.length)).toEqual([2, 2, 1])
  })
  it('never splits a film and never returns an empty group', () => {
    expect(groupByBin([], 4.2 * GiB)).toEqual([])
    const one = groupByBin([{ id: 0, bytes: 5 * GiB }], 4.2 * GiB)
    expect(one).toHaveLength(1)
    expect(one[0].items).toHaveLength(1)
  })
})
