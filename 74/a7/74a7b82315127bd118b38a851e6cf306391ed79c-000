import { describe, expect, it } from 'vitest'
import { bindingsByProject } from './assetsBindings.js'

const projects = [{ id: 'a', name: 'Alpha' }, { id: 'b', name: 'Beta' }]
const conversations = [
  { id: 'c1', provider: 'claude', projectId: 'a', updatedAt: '2026-10-18T10:00:00Z' },
  { id: 'c2', provider: 'codex', projectId: 'a', updatedAt: '2026-10-20T10:00:00Z' },
  { id: 'c3', provider: 'gemini', projectId: 'b', updatedAt: '2026-10-19T10:00:00Z' },
  { id: 'c4', provider: 'claude', projectId: null, updatedAt: '2026-10-20T11:00:00Z' },
  { id: 'c5', provider: 'claude', projectId: 'gone', updatedAt: '2026-10-01T10:00:00Z' },
]

describe('bindingsByProject', () => {
  const result = bindingsByProject(projects, conversations)
  it('groups conversations by project, most recent project first', () => {
    expect(result.rows.map((row) => row.projectId)).toEqual(['a', 'b', 'gone'])
    expect(result.rows[0].conversations.map((item) => item.id)).toEqual(['c2', 'c1'])
  })
  it('counts providers and keeps unknown projects visible by their id', () => {
    expect(result.rows[0].providers).toEqual({ claude: 1, codex: 1 })
    expect(result.rows[2]).toMatchObject({ name: 'gone', known: false })
  })
  it('counts unbound conversations without inventing a link', () => {
    expect(result.unbound).toBe(1)
    expect(result.boundConversations).toBe(4)
  })
  it('handles nothing', () => { expect(bindingsByProject()).toEqual({ rows: [], unbound: 0, boundConversations: 0 }) })
})
