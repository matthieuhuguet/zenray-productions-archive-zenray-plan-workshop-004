// 7 October 2026: what the index readers already looked at. A page fetched once and judged "not for me" must not be fetched again
// at every pass, which would be impolite to the site and slow for him. Entries are dated and pruned; a corrupt file is just empty.
// FR : ce que les lecteurs d'index ont deja regarde. Une page lue une fois et jugee « pas pour moi » n'est pas relue a chaque passe.
import { readFile, writeFile, mkdir, rename } from 'node:fs/promises'
import path from 'node:path'

export function createSeenCache({ file = null, maxAgeDays = 45, maxEntries = 30000, now = () => Date.now() } = {}) {
  let entries = null
  async function load() {
    if (entries) return entries
    entries = new Map()
    if (!file) return entries
    try {
      const data = JSON.parse(await readFile(file, 'utf8'))
      for (const [url, at] of Object.entries(data.seen || {})) if (Number.isFinite(at)) entries.set(url, at)
    } catch {}
    return entries
  }
  return {
    async has(url) { const map = await load(); const at = map.get(url); return Boolean(at) && now() - at < maxAgeDays * 86400000 },
    async add(url) { (await load()).set(url, now()) },
    async size() { return (await load()).size },
    /** Writes atomically (temp file then rename) so an interrupted pass never leaves half a file. */
    async save() {
      if (!file) return
      const map = await load()
      const cutoff = now() - maxAgeDays * 86400000
      const kept = [...map.entries()].filter(([, at]) => at >= cutoff).sort((a, b) => b[1] - a[1]).slice(0, maxEntries)
      await mkdir(path.dirname(file), { recursive: true })
      const temp = `${file}.tmp`
      await writeFile(temp, JSON.stringify({ v: 1, seen: Object.fromEntries(kept) }))
      await rename(temp, file)
    },
  }
}
