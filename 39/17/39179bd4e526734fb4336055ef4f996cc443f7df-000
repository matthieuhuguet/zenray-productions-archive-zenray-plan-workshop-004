// 07 October 2026: tests for EmailScanner module (auto-ack filtering and studio response matching).
import { describe, expect, it } from 'vitest'
import {
  MATTHIEU_EMAIL,
  scanStoreEmails,
  createEmailScanner,
} from './lib/EmailScanner.mjs'

const NOW = new Date('2026-10-07T12:00:00+02:00')

describe('EmailScanner', () => {
  it('exports Matthieu email address as matth.huguet@gmail.com', () => {
    expect(MATTHIEU_EMAIL).toBe('matth.huguet@gmail.com')
  })

  it('scans store emails and ignores automated application receipt acknowledgments', () => {
    const store = {
      v: 2,
      studios: [
        {
          id: 'job_dontnod_1',
          name: 'DON\'T NOD',
          role: 'Technical Artist Houdini',
          link: 'https://dont-nod.com/jobs/ta',
          status: 'contacted',
          contactedAt: '2026-10-05',
          messages: [{ at: '2026-10-05', channel: 'mail', text: 'Candidature envoyée' }],
          history: [],
        },
      ],
    }

    const emails = [
      {
        from: 'no-reply@dont-nod.com',
        subject: 'We received your application for Technical Artist',
        body: 'Thank you for your application. This is an automated confirmation that we received your submission.',
      },
      {
        from: 'jobs@greenhouse.io',
        subject: 'Candidature bien reçue',
        body: 'Nous accusons réception de votre dossier de candidature.',
      },
    ]

    const { store: nextStore, report } = scanStoreEmails(store, emails, { now: NOW })

    expect(report.processed).toBe(2)
    expect(report.ignoredAutoAcks).toBe(2)
    expect(report.matchedResponses).toBe(0)

    const studio = nextStore.studios[0]
    expect(studio.status).toBe('contacted')
    expect(studio.messages).toHaveLength(1)
  })

  it('detects a real interview reply and transitions studio status to interview', () => {
    const store = {
      v: 2,
      studios: [
        {
          id: 'job_sloclap_1',
          name: 'Sloclap',
          role: '3D Technical Artist',
          link: 'https://sloclap.com/jobs/ta',
          status: 'contacted',
          contactedAt: '2026-10-05',
          messages: [],
          history: [],
        },
      ],
    }

    const emails = [
      {
        from: 'recrutement@sloclap.com',
        subject: 'Votre candidature chez Sloclap : entretien',
        body: 'Bonjour Matthieu, nous avons bien regardé votre profil et vos projets. Seriez-vous disponible ce jeudi pour un premier échange en visio ? Cordialement.',
      },
    ]

    const { store: nextStore, report } = scanStoreEmails(store, emails, { now: NOW })

    expect(report.processed).toBe(1)
    expect(report.ignoredAutoAcks).toBe(0)
    expect(report.matchedResponses).toBe(1)

    const studio = nextStore.studios[0]
    expect(studio.status).toBe('interview')
    expect(studio.messages).toHaveLength(1)
    expect(studio.messages[0].channel).toBe('mail')
    expect(studio.messages[0].text).toContain('recrutement@sloclap.com')
    expect(studio.history.at(-1)).toMatchObject({ from: 'contacted', to: 'interview' })
  })

  it('runs periodic scanner instance and tracks execution status', async () => {
    const store = {
      v: 2,
      studios: [
        {
          id: 's1',
          name: 'Focus Entertainment',
          link: 'https://focus-ent.com',
          status: 'contacted',
          messages: [],
          history: [],
        },
      ],
    }

    const fetched = [
      {
        from: 'talent@focus-ent.com',
        subject: 'Retour suite à votre portfolio',
        body: 'Bonjour Matthieu, nous avons plusieurs questions techniques sur vos outils Houdini HDA.',
      },
    ]

    const logs = []
    const scanner = createEmailScanner({
      config: { emailScanner: { intervalHours: 6, email: 'matth.huguet@gmail.com' } },
      fetchEmails: async () => fetched,
      log: (msg) => logs.push(msg),
      now: () => NOW,
    })

    expect(scanner.emailAddress).toBe('matth.huguet@gmail.com')
    expect(scanner.intervalHours).toBe(6)

    const { store: updatedStore, report } = await scanner.runScan(store)
    expect(report.matchedResponses).toBe(1)
    expect(updatedStore.studios[0].status).toBe('replied')

    const status = scanner.getStatus()
    expect(status.email).toBe('matth.huguet@gmail.com')
    expect(status.lastScanAt).toBe(NOW.toISOString())
    expect(logs.some((l) => l.includes('1 matched'))).toBe(true)
  })
})
