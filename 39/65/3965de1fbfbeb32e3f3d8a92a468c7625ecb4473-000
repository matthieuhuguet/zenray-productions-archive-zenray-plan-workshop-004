// LA VOIE LEGO, DE BOUT EN BOUT — étape 0 du PLAN-V1.
//
// POURQUOI CE FICHIER EXISTE
// --------------------------
// `compile.js` porte DEUX voies de compilation : la voie article, couverte par
// `zenraymedia.test.js`, et la voie Lego (`composedPage`), qui n'avait aucun test. Le KANBAN citait
// pourtant un fichier de preuve, lequel n'existe pas. Or c'est la voie Lego qui porte l'éditeur
// entier : chaque pièce posée y devient un `<section data-zrm-instance>`, et c'est elle que les
// huit zones piloteront.
//
// Trois relectures adversariales indépendantes ont conclu le 2026-08-01 que l'absence de ce harnais
// était le premier risque du chantier, avant même la carte C1 : sans lui, on ne peut pas dire si C1
// est faite. Un critère de fini qui ne s'exécute pas n'est pas un critère.
//
// CE QUE CE FICHIER MESURE, ET NE CORRIGE PAS
// -------------------------------------------
// Le dernier bloc constate l'écart de C1 au lieu de le réparer : deux pièces du même composant
// rendent aujourd'hui exactement le même contenu, quelles que soient leurs `props`. Le test est
// écrit pour ÉCHOUER le jour où C1 passe, et son message dit quoi faire à ce moment-là. Mesurer
// avant de corriger, puis laisser la mesure dire quand la correction a pris.

import { describe, it, expect } from 'vitest'
import { getFormat, FORMATS } from './formats.js'
import { buildCut } from './cut.js'
import { compile } from './compile.js'
import { seedProject } from './store.js'
import theme from './themes/T-01-3-2.theme.js'
import {
  emptyComposition, normalizeComposition, addComponent, addImage,
  patchItem, countItems, removeItem, moveItem, duplicateItem,
} from './composition.js'

const webFormat = getFormat('F-web-article')

function fixture() {
  const { brief, notes } = seedProject()
  return { brief, cut: buildCut(brief, notes, theme) }
}

// Un composant réel porte son en-tête `<!--zrm …-->`, un `<style>` et un corps de gabarit. Le
// harnais reproduit les trois, sans quoi il ne testerait pas ce que `splitPart` fait vraiment.
const BUNDLE = {
  components: [
    { id: 'titre', html: '<!--zrm {"name":"Titre"}-->\n<style>.t{font-weight:600}</style>\n<h2 class="t">{{title}}</h2>' },
    { id: 'chapo', html: '<!--zrm {"name":"Chapô"}-->\n<style>.c{opacity:.8}</style>\n<p class="c">{{audience}}</p>' },
  ],
}

const compileLego = (composition, extra = {}) => {
  const { brief, cut } = fixture()
  return compile({ brief, cut, theme, format: webFormat, seed: 1, composition, componentBundle: BUNDLE, ...extra })
}

describe('voie Lego — le modèle', () => {
  it('une composition vide se normalise sans perdre son thème', () => {
    const c = normalizeComposition(emptyComposition(theme.id), theme.id)
    expect(c.rows).toEqual([])
    expect(countItems(c)).toBe(0)
  })

  it('poser, déplacer, dupliquer et retirer laissent le compte juste', () => {
    let c = emptyComposition(theme.id)
    c = addComponent(c, { id: 'titre' })
    c = addComponent(c, { id: 'chapo' })
    expect(countItems(c)).toBe(2)

    const premier = c.rows[0].items[0].id
    c = duplicateItem(c, premier)
    expect(countItems(c)).toBe(3)

    c = removeItem(c, premier)
    expect(countItems(c)).toBe(2)

    // Un déplacement ne crée ni ne détruit rien : c'est l'invariant que casse le plus souvent une
    // refonte du modèle, et il ne se voit pas à l'écran puisque la page reste plausible.
    const [a, b] = [c.rows[0].items[0].id, c.rows.at(-1).items.at(-1).id]
    c = moveItem(c, a, b, 'below')
    expect(countItems(c)).toBe(2)
  })

  it('un identifiant d’instance est unique, et survit à la normalisation', () => {
    let c = addComponent(addComponent(emptyComposition(theme.id), { id: 'titre' }), { id: 'titre' })
    const ids = c.rows.flatMap((r) => r.items.map((i) => i.id))
    expect(new Set(ids).size).toBe(ids.length)
    expect(normalizeComposition(c, theme.id).rows.flatMap((r) => r.items.map((i) => i.id))).toEqual(ids)
  })
})

describe('voie Lego — la compilation', () => {
  it('rend une page autonome, sans appel réseau', () => {
    const c = addComponent(emptyComposition(theme.id), { id: 'titre' })
    const { html } = compileLego(c)
    expect(html).toMatch(/^<!doctype html>/i)
    expect(html).not.toMatch(/<link[^>]+rel=["']stylesheet/i)
    expect(html).not.toMatch(/https?:\/\//)
  })

  it('marque chaque pièce posée d’un identifiant d’instance, et chaque rangée du sien', () => {
    // C'est le contrat dont dépend TOUTE l'interface : sans `data-zrm-instance` dans le rendu,
    // cliquer dans l'aperçu ne peut désigner aucune pièce, donc ni la sélection ni le panneau
    // Détails n'existent. Le vérifier ici évite de le découvrir en écrivant la zone 4.
    let c = addComponent(emptyComposition(theme.id), { id: 'titre' })
    c = addComponent(c, { id: 'chapo' })
    const { html } = compileLego(c)
    for (const item of c.rows.flatMap((r) => r.items)) expect(html).toContain(`data-zrm-instance="${item.id}"`)
    for (const row of c.rows) expect(html).toContain(`data-zrm-row="${row.id}"`)
    expect(html).toContain('data-zrm-component="titre"')
  })

  it('injecte le style du composant et retire son en-tête zrm', () => {
    const c = addComponent(emptyComposition(theme.id), { id: 'titre' })
    const { html } = compileLego(c)
    expect(html).toContain('.t{font-weight:600}')
    expect(html).not.toContain('<!--zrm')
  })

  it('remplit le gabarit depuis le brief', () => {
    const { brief } = fixture()
    const c = addComponent(emptyComposition(theme.id), { id: 'titre' })
    const { html } = compileLego(c)
    expect(html).toContain(brief.title)
    expect(html).not.toContain('{{title}}')
  })

  it('ignore une pièce masquée, et une pièce dont le composant est absent du bundle', () => {
    let c = addComponent(emptyComposition(theme.id), { id: 'titre' })
    const cache = c.rows[0].items[0].id
    c = patchItem(c, cache, { hidden: true })
    expect(compileLego(c).html).not.toContain(`data-zrm-instance="${cache}"`)

    const orphelin = addComponent(emptyComposition(theme.id), { id: 'composant-qui-n-existe-pas' })
    expect(() => compileLego(orphelin)).not.toThrow()
  })

  it('pose une image avec son ratio et son rayon, et échappe son URL', () => {
    // `item.props` est lu ICI, et nulle part ailleurs : c'est le seul endroit du produit où une
    // pièce consulte ses propres valeurs. Voir le dernier bloc de ce fichier.
    let c = addImage(emptyComposition(theme.id), { url: 'x.png', name: 'x' })
    const id = c.rows[0].items[0].id
    c = patchItem(c, id, { props: { ratio: '4 / 3', radius: 32 } })
    const { html } = compileLego(c)
    expect(html).toContain('--zrm-image-ratio:4 / 3')
    expect(html).toContain('--zrm-image-radius:32px')
  })

  it('n’injecte rien depuis un nom d’image', () => {
    let c = addImage(emptyComposition(theme.id), { url: 'x.png', name: '<script>alert(1)</script>' })
    const { html } = compileLego(c)
    expect(html).not.toContain('<script>alert(1)</script>')
  })

  it('produit deux fois la même page à graine égale', () => {
    const c = addComponent(emptyComposition(theme.id), { id: 'titre' })
    expect(compileLego(c).html).toBe(compileLego(c).html)
  })
})

describe('voie Lego — C1 : une pièce lit ses propres valeurs (étape 2)', () => {
  // AVANT le 2026-08-01, ce bloc CONSTATAIT l'écart au lieu de le corriger, et son commentaire
  // demandait de l'inverser le jour où C1 passerait plutôt que de le supprimer. C'est ce jour-là :
  // les deux premiers tests sont l'exact contraire de ce qu'ils affirmaient, et c'est cette
  // inversion, et elle seule, qui prouve que la correction a pris.
  const deuxTitres = () => {
    let c = addComponent(emptyComposition(theme.id), { id: 'titre' })
    c = addComponent(c, { id: 'titre' })
    const [a, b] = c.rows.flatMap((r) => r.items).map((i) => i.id)
    return { c, a, b }
  }
  const contenu = (html, id) => html.split(`data-zrm-instance="${id}"`)[1]?.split('</section>')[0]

  it('deux pièces du même composant portent des textes DIFFÉRENTS', () => {
    let { c, a, b } = deuxTitres()
    c = patchItem(c, a, { props: { title: 'PREMIER' } })
    c = patchItem(c, b, { props: { title: 'SECOND' } })
    const { html } = compileLego(c)
    expect(html).toContain('PREMIER')
    expect(html).toContain('SECOND')
    expect(contenu(html, a)).not.toBe(contenu(html, b))
  })

  it('une pièce sans valeur propre continue de lire le brief', () => {
    const { brief } = fixture()
    let { c, a, b } = deuxTitres()
    c = patchItem(c, a, { props: { title: 'SEULEMENT MOI' } })
    const { html } = compileLego(c)
    expect(contenu(html, a)).toContain('SEULEMENT MOI')
    expect(contenu(html, b)).toContain(brief.title)
  })

  it('PIÈGE 1 : une valeur vidée REVIENT au brief, elle ne l’efface pas', () => {
    // `{ ...data, ...item.props }`, la forme posée par le KANBAN, aurait fait gagner la chaîne vide
    // sur le brief : un champ touché puis effacé aurait cessé d'afficher quoi que ce soit au lieu
    // de revenir à sa valeur d'origine. Et comme `normalizeComposition` pose `props: {}` par
    // défaut, « jamais renseigné » et « renseigné puis vidé » sont indiscernables dans le modèle.
    const { brief } = fixture()
    let { c, a } = deuxTitres()
    c = patchItem(c, a, { props: { title: '' } })
    expect(contenu(compileLego(c).html, a)).toContain(brief.title)
  })

  it('PIÈGE 2 : un défaut de gabarit est résolu AVANT la fusion, jamais recraché en accolades', () => {
    // `renderScope` est à passe unique, délibérément : une valeur substituée n'est jamais
    // réinterprétée. Un `default: "{{title}}"` qui traverserait la fusion sortirait littéralement,
    // accolades comprises et échappées.
    const { brief } = fixture()
    const bundle = { components: [{ id: 'titre', html: '<h2>{{title}}</h2>', props: [{ key: 'title', default: '{{title}}' }] }] }
    const c = addComponent(emptyComposition(theme.id), { id: 'titre' })
    const { html } = compileLego(c, { componentBundle: bundle })
    expect(html).toContain(brief.title)
    expect(html).not.toContain('{{title}}')
    expect(html).not.toContain('&lbrace;')
  })

  it('la valeur de l’instance gagne sur le défaut déclaré', () => {
    const bundle = { components: [{ id: 'titre', html: '<h2>{{title}}</h2>', props: [{ key: 'title', default: 'DÉFAUT' }] }] }
    let c = addComponent(emptyComposition(theme.id), { id: 'titre' })
    const id = c.rows[0].items[0].id
    expect(compileLego(c, { componentBundle: bundle }).html).toContain('DÉFAUT')
    c = patchItem(c, id, { props: { title: 'INSTANCE' } })
    const { html } = compileLego(c, { componentBundle: bundle })
    expect(html).toContain('INSTANCE')
    expect(html).not.toContain('DÉFAUT')
  })
})

describe('voie Lego — le contrat préservant (étape 2)', () => {
  // `normalizeComposition` reconstruisait un littéral à quatre clefs, et elle est appelée en tête
  // de sept fonctions du modèle plus deux fois dans l'application. Toute clef inconnue mourait donc
  // au premier GESTE, en mémoire, sans rechargement. Le contrat s'ouvre une seule fois, ici.
  it('une clef inconnue survit à un geste, en mémoire', () => {
    let c = { ...emptyComposition(theme.id), timeline: { pistes: [] } }
    c = addComponent(c, { id: 'titre' })
    c = addComponent(c, { id: 'chapo' })
    const id = c.rows[0].items[0].id
    c = patchItem(c, id, { props: { title: 'x' } })
    c = duplicateItem(c, id)
    expect(c.timeline).toEqual({ pistes: [] })
  })

  it('une propriété posée sur une RANGÉE survit elle aussi', () => {
    let c = addComponent(emptyComposition(theme.id), { id: 'titre' })
    c = { ...c, rows: c.rows.map((r) => ({ ...r, layout: 'uniform-grid' })) }
    c = addComponent(c, { id: 'chapo' })
    expect(c.rows[0].layout).toBe('uniform-grid')
  })

  it('DANS L’AUTRE SENS : la permissivité ne laisse pas entrer n’importe quoi', () => {
    // La contrepartie de l'ouverture, et personne ne la garderait sans ce test. Un thème qui ne
    // correspond pas, ou des rangées qui n'en sont pas, repartent d'une composition vide.
    expect(normalizeComposition({ themeId: 'autre', rows: [], poison: 1 }, theme.id).poison).toBeUndefined()
    expect(normalizeComposition({ themeId: theme.id, rows: 'pas-un-tableau', poison: 1 }, theme.id).poison).toBeUndefined()
    // Et les clefs structurelles restent imposées, quoi que porte l'entrée.
    const c = normalizeComposition({ themeId: theme.id, rows: [], v: 99, serial: 'x' }, theme.id)
    expect(c.v).not.toBe(99)
    expect(c.serial).toBe(0)
  })
})

describe('voie Lego — le cadre de sortie (étape 1)', () => {
  // AVANT le 2026-08-01, cette voie ne connaissait du format que `max-width:1180px` ou `none` :
  // un carré 1080, un 9:16 et un A4 rendaient la même colonne qui coule. Six des sept formats
  // déclarés sont bornés, et aucun n'était servi. Ces tests sont le critère de fini de l'étape 1.
  const posee = () => addComponent(emptyComposition(theme.id), { id: 'titre' })

  it('chacun des sept formats déclarés rend le canevas qu’il annonce', () => {
    for (const f of FORMATS) {
      const { html } = compileLego(posee(), { format: f })
      if (f.canvas.h > 0) {
        expect(html, f.id).toContain(`width:${f.canvas.w}px;height:${f.canvas.h}px;overflow:hidden;`)
      } else {
        // Le format fluide garde sa mesure de lecture au lieu d'un plafond arbitraire : c'est sa
        // largeur DÉCLARÉE qui borne la ligne, non les 1180 px qui traînaient en dur.
        expect(html, f.id).toContain(`max-width:${f.canvas.w}px`)
        expect(html, f.id).not.toMatch(/height:\d+px;overflow:hidden/)
      }
    }
  })

  it('un format borné applique ses zones de sécurité, au pixel déclaré', () => {
    for (const f of FORMATS.filter((x) => x.canvas.h > 0)) {
      const { html } = compileLego(posee(), { format: f })
      expect(html, f.id).toContain(`padding:${f.safe.top}px ${f.safe.sides}px ${f.safe.bottom}px`)
    }
  })

  it('un format borné porte sa densité, sans quoi un A4 rendrait un timbre-poste', () => {
    // Densités réelles : 1,6 pour la vidéo, 1,7 pour les stills, 3,125 pour l'A4. Sur la voie à
    // jetons elles multiplient chaque valeur typographique ; ici elles passent par la taille de
    // police RACINE, seule prise disponible quand les composants apportent leur propre feuille.
    const a4 = getFormat('F-print-a4')
    expect(a4.density).toBeGreaterThan(3)
    expect(compileLego(posee(), { format: a4 }).html).toContain(`font-size:${Math.round(a4.density * 100)}%`)
  })

  it('la requête mobile n’écrase pas un canevas borné', () => {
    // Un canevas de 1080 px de large déclencherait la requête à 620 px dans un aperçu réduit, et
    // reformaterait la page qu'on est justement en train de cadrer.
    expect(compileLego(posee(), { format: getFormat('F-still-1080x1920') }).html).not.toContain('@media(max-width:620px)')
    expect(compileLego(posee(), { format: webFormat }).html).toContain('@media(max-width:620px)')
  })
})

describe('voie Lego — le pont de sélection (étape 4)', () => {
  const posee = () => addComponent(emptyComposition(theme.id), { id: 'titre' })

  it('l’export reste SANS script, c’est la promesse du document autonome', () => {
    expect(compileLego(posee()).html).not.toMatch(/<script/i)
  })

  it('l’aperçu porte le pont, et lui seul', () => {
    const { html } = compileLego(posee(), { interactive: true })
    expect(html).toMatch(/<script/i)
    expect(html).toContain("zrm:'select'")
    expect(html).toContain('data-zrm-instance')
  })

  it('le pont ne remonte qu’un identifiant, jamais du contenu', () => {
    // Le document DÉSIGNE, le parent DÉCIDE. Faire remonter le contenu ouvrirait une seconde
    // vérité sur ce qu'une pièce porte, alors que le modèle en est déjà la source.
    const { html } = compileLego(posee(), { interactive: true })
    const script = html.split('<script')[1].split('</')[0]
    expect(script).toContain('getAttribute')
    expect(script).not.toContain('innerHTML')
    expect(script).not.toContain('textContent')
  })

  it('la sélection descend par message et se pose en attribut, sans recompilation', () => {
    // La faire passer par le HTML rechargerait l'iframe à chaque clic, donc réinitialiserait le
    // défilement, et le debounce de 220 ms ajouterait un retard sur un geste qui doit être instantané.
    const { html } = compileLego(posee(), { interactive: true })
    expect(html).toContain("zrm!=='selected'")
    expect(html).toContain('data-zrm-on')
    expect(html).toContain('[data-zrm-on]{outline')
  })

  it('le curseur signale qu’une pièce est cliquable, en aperçu seulement', () => {
    expect(compileLego(posee(), { interactive: true }).html).toContain('.zrm-lego-item{cursor:pointer}')
    expect(compileLego(posee()).html).not.toContain('cursor:pointer')
  })
})
