#!/usr/bin/env node
// RefreshRecoveryReceipts.mjs (12 October 2026): upgrades receipts written before the recovery fingerprint existed.
// FR : ajoute manifestRecoverySha256 aux anciens recus. Le manifeste a legitimement change (poster, noms audio, sous-titres) ;
// on verifie que ce qui sert a restaurer (taille, parts) concorde avec le recu avant d'ecrire l'empreinte.
//   node scripts/RefreshRecoveryReceipts.mjs --receipts <dir> [--dry]
import fs from 'node:fs'
import path from 'node:path'
import { recoveryFingerprint } from './lib/video-cloud-recovery.mjs'

const argv = process.argv.slice(2)
const dir = path.resolve(argv[argv.indexOf('--receipts') + 1] || '')
const dry = argv.includes('--dry')
const force = argv.includes('--force') // recompute even when an older fingerprint is present
const cloneFlag = argv.indexOf('--clone')
const clone = cloneFlag >= 0 ? path.resolve(argv[cloneFlag + 1]) : '' // clone of zenray-data, used when the worker's ManifestClone has not pulled a rename yet
const MARK = `${path.sep}ManifestClone${path.sep}`
const locate = (manifestPath) => {
  if (fs.existsSync(manifestPath) || !clone) return manifestPath
  const at = String(manifestPath).indexOf(MARK)
  return at < 0 ? manifestPath : path.join(clone, manifestPath.slice(at + MARK.length))
}
const report = { refreshed: 0, alreadyFingerprinted: 0, refused: [] }
for (const name of fs.readdirSync(dir).filter((n) => n.endsWith('.recovery.json'))) {
  const file = path.join(dir, name)
  const receipt = JSON.parse(fs.readFileSync(file, 'utf8'))
  if (receipt.manifestRecoverySha256 && !force) { report.alreadyFingerprinted += 1; continue }
  let manifest
  try { manifest = JSON.parse(fs.readFileSync(locate(receipt.manifestPath), 'utf8')) } catch { report.refused.push({ name, reason: 'manifest_unreadable' }); continue }
  const consistent = manifest.type === 'video-raw' && manifest.enc === true && Array.isArray(manifest.parts) && manifest.parts.length > 0
    && manifest.size === receipt.bytes && Array.isArray(receipt.pinnedShards) && receipt.pinnedShards.length > 0
  if (!consistent) { report.refused.push({ name, reason: 'manifest_does_not_match_receipt' }); continue }
  receipt.manifestRecoverySha256 = recoveryFingerprint(manifest)
  receipt.recoveryFingerprintAddedAt = new Date().toISOString()
  if (!dry) { fs.writeFileSync(`${file}.tmp`, JSON.stringify(receipt, null, 2) + '\n'); fs.renameSync(`${file}.tmp`, file) }
  report.refreshed += 1
}
console.log(JSON.stringify({ dry, ...report }, null, 2))
