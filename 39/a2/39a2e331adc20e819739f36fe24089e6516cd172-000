// 13 October 2026, 09:30 CEST: exact archives retain searchable paths without thumbnail requests.
import { afterEach, beforeEach, expect, test, vi } from 'vitest'
import { mkdtempSync, writeFileSync, rmSync } from 'node:fs'
import { tmpdir } from 'node:os'
import path from 'node:path'
const mocks = vi.hoisted(() => ({ append: vi.fn(async () => true), thumbs: vi.fn(async () => ({})) }))
vi.mock('../server/page.js', () => ({ appendPublicDelta: mocks.append, thumbsForPaths: mocks.thumbs }))
let directory, previousArgs
beforeEach(() => {
  vi.resetModules(); vi.clearAllMocks()
  directory = mkdtempSync(path.join(tmpdir(), 'japanese-index-'))
  const list = path.join(directory, 'Paths.txt')
  writeFileSync(list, 'pages/one.file.json\npages/two.file.json\n')
  previousArgs = process.argv
  process.argv = ['node', 'index-add-paths.mjs', list]
  vi.stubEnv('GITHUB_TOKEN', 'synthetic-test-token')
  vi.spyOn(process, 'exit').mockImplementation(() => {})
  vi.spyOn(console, 'log').mockImplementation(() => {})
})
afterEach(() => { process.argv = previousArgs; vi.unstubAllEnvs(); vi.restoreAllMocks(); rmSync(directory, { recursive: true, force: true }) })
test('explicit paths-only mode skips network thumbnail lookup but indexes every path', async () => {
  vi.stubEnv('ZR_INDEX_SKIP_THUMBNAILS', '1')
  await import('./index-add-paths.mjs')
  expect(mocks.thumbs).not.toHaveBeenCalled()
  expect(mocks.append).toHaveBeenCalledWith('synthetic-test-token', ['pages/one.file.json', 'pages/two.file.json'], {})
  expect(process.exit).toHaveBeenCalledWith(0)
})
test('default behavior still resolves thumbnails', async () => {
  vi.stubEnv('ZR_INDEX_SKIP_THUMBNAILS', '0')
  await import('./index-add-paths.mjs')
  expect(mocks.thumbs).toHaveBeenCalledWith('synthetic-test-token', ['pages/one.file.json', 'pages/two.file.json'])
  expect(mocks.append).toHaveBeenCalledTimes(1)
})
