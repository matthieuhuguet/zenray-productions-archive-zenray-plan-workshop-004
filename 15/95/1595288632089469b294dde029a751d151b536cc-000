// 5 October 2026: own searches keep a history; a duplicate or an empty entry never gets in.
import { describe, it, expect } from 'vitest'
import { addSearch, removeSearch, activeSearches, normalizeSearches } from './freelanceSearches.js'

describe('own searches file', () => {
  it('adds an address and keywords, labels them, refuses duplicates and empties', () => {
    let file = null
    let r = addSearch(file, { input: 'https://boards.greenhouse.io/acme', at: '2026-10-05', id: 's1' }); file = r.file
    r = addSearch(file, { input: 'shader artist', label: 'Shaders', at: '2026-10-05', id: 's2' }); file = r.file
    expect(file.searches.map((s) => [s.kind, s.label])).toEqual([['link', 'boards.greenhouse.io/acme'], ['keywords', 'Shaders']])
    expect(addSearch(file, { input: 'SHADER ARTIST', at: 'x', id: 's3' }).error).toMatch(/existe déjà/)
    expect(addSearch(file, { input: 'https://boards.greenhouse.io/acme', at: 'x', id: 's4' }).error).toMatch(/existe déjà/)
    expect(addSearch(file, { input: '   ', at: 'x', id: 's5' }).error).toBeTruthy()
  })
  it('removal is dated, never an erasure, and a removed search can be added again', () => {
    const file = addSearch(null, { input: 'houdini', at: '2026-10-05', id: 's1' }).file
    const gone = removeSearch(file, 's1', '2026-10-06')
    expect(gone.searches[0].removedAt).toBe('2026-10-06'); expect(activeSearches(gone)).toEqual([])
    expect(addSearch(gone, { input: 'houdini', at: '2026-10-07', id: 's2' }).file.searches).toHaveLength(2)
  })
  it('survives a missing or malformed file', () => { expect(normalizeSearches(undefined).searches).toEqual([]); expect(normalizeSearches({ searches: 'x' }).searches).toEqual([]) })
})
