// 12 October 2026: the chosen thumbnail of each Assets project, kept in one small cloud file and mirrored in localStorage.
// choice: 'manual' (right click on an image) always beats 'auto' (a file named thumbnail, cover, poster...).
// FR : miniature choisie de chaque projet, dans un petit fichier cloud, recopiée dans localStorage pour l'affichage immédiat.
import { useCallback, useEffect, useRef, useState } from 'react'
import { readJson, saveJsonWithRetry } from './saveJson.js'
import { coverReference } from './assetsProjectCover.js'

export const COVERS_PATH = 'pages/.zr-assets-covers.json'
// 20 October 2026: bump cache key to v2 for high-DPI Retina covers.
const CACHE_KEY = 'assets.covers.v2'
const readCache = () => { try { const value = JSON.parse(localStorage.getItem(CACHE_KEY) || '{}'); return value && typeof value === 'object' ? value : {} } catch { return {} } }
const writeCache = (covers) => { try { localStorage.setItem(CACHE_KEY, JSON.stringify(covers)) } catch { /* storage may be blocked */ } }

export function useProjectCovers() {
  const [covers, setCovers] = useState(readCache)
  const alive = useRef(true)
  useEffect(() => {
    alive.current = true
    ;(async () => {
      try {
        const { data } = await readJson(COVERS_PATH)
        if (!alive.current || !data?.covers || typeof data.covers !== 'object') return
        setCovers((previous) => { const next = { ...previous, ...data.covers }; writeCache(next); return next })
      } catch { /* offline or no cloud file yet: the local copy stays */ }
    })()
    return () => { alive.current = false }
  }, [])

  const save = useCallback(async (projectId, entry) => {
    setCovers((previous) => {
      const next = { ...previous }
      if (entry) next[projectId] = entry; else delete next[projectId]
      writeCache(next)
      return next
    })
    try {
      const result = await saveJsonWithRetry(COVERS_PATH, (current) => {
        const covers = { ...(current?.covers || {}) }
        if (entry) covers[projectId] = entry; else delete covers[projectId]
        return { schemaVersion: 1, ...current, covers }
      })
      return result
    } catch (error) { return { ok: false, error: error.message } }
  }, [])

  const setCover = useCallback((projectId, file, choice = 'manual', reason) => save(projectId, { file: coverReference(file), choice, ...(reason ? { reason } : {}), at: new Date().toISOString() }), [save])
  // Shows the choice at once (local state and cache only); the saved version, with its fitted thumbnail, follows.
  const previewCover = useCallback((projectId, file, choice = 'manual') => {
    setCovers((previous) => { const next = { ...previous, [projectId]: { file: coverReference(file), choice, at: new Date().toISOString() } }; writeCache(next); return next })
  }, [])
  const clearCover = useCallback((projectId) => save(projectId, null), [save])
  return { covers, setCover, previewCover, clearCover }
}
