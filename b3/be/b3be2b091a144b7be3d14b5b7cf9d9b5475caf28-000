// Pure collision allocator shared by the batch endpoint and its 1/20/99/100+
// regression tests. `occupiedBases` models Create's merged node identity:
// `dragon.file.json` and a directory named `dragon` collide visually.
export function reserveEagleLeafTarget(requested, ext, files, occupiedBases) {
  const base = ext ? requested.slice(0, -ext.length) : requested
  let n = 1
  let candidateBase = base
  while (files.has(candidateBase + ext) || occupiedBases.has(candidateBase)) candidateBase = `${base} ${++n}`
  files.add(candidateBase + ext)
  occupiedBases.add(candidateBase)
  return candidateBase + ext
}

export function reserveEagleFolderTarget(requested, files, occupiedBases, marker = '.zreagle-folder.json') {
  let n = 1
  let candidate = requested
  while (occupiedBases.has(candidate) || [...files].some((path) => path.startsWith(candidate + '/'))) candidate = `${requested} ${++n}`
  occupiedBases.add(candidate)
  files.add(`${candidate}/${marker}`)
  return candidate
}
