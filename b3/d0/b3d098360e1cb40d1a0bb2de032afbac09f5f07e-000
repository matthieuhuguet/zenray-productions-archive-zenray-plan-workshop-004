// 16 October 2026: browser-side pre-filler. Runs in a studio's application page (paste or inject), fills the fields it recognises from the
// profile and the exact letter, and reports what it could not do. It NEVER clicks a button and never submits. Sensitive questions
// (salary, visa, gender, password, captcha...) are listed as `needsYou`, never answered.
// FR : pré-remplisseur côté navigateur. Il remplit ce qu'il reconnaît, ne clique jamais sur un bouton, n'envoie rien, et liste ce qui demande Matthieu.
// Usage: window.__zrFill(profile, letter, fieldMap) -> report object.
(function () {
  window.__zrFill = function (profile, letter, map) {
    const t0 = performance.now()
    const norm = (s) => String(s || '').toLowerCase()
    const labelOf = (el) => {
      const parts = []
      if (el.id) { const l = el.getRootNode().querySelector('label[for="' + CSS.escape(el.id) + '"]'); if (l) parts.push(l.innerText) }
      const wrap = el.closest('label'); if (wrap) parts.push(wrap.innerText)
      const lb = el.getAttribute('aria-labelledby'); if (lb) lb.split(/\s+/).forEach((id) => { const n = document.getElementById(id); if (n) parts.push(n.innerText) })
      const group = el.closest('.field, .form-group, .form-field, fieldset, [class*="field"], [class*="question"]'); if (group) parts.push((group.querySelector('label, legend') || {}).innerText || '')
      // 16 October 2026: Lever and similar forms name fields cards[uuid][field0]; the question text sits in the enclosing list item.
      const item = el.closest('li, [class*="application-question"]'); if (item && !parts.join('').trim()) parts.push(item.innerText.replace(/\s+/g, ' ').slice(0, 140))
      return parts.join(' ')
    }
    const describe = (el) => norm([el.name, el.id, el.placeholder, el.getAttribute('aria-label'), el.autocomplete, labelOf(el)].join(' | '))
    const setValue = (el, value) => {
      const proto = el instanceof HTMLTextAreaElement ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype
      Object.getOwnPropertyDescriptor(proto, 'value').set.call(el, value)
      el.dispatchEvent(new Event('input', { bubbles: true })); el.dispatchEvent(new Event('change', { bubbles: true })); el.dispatchEvent(new Event('blur', { bubbles: true }))
    }
    const never = new RegExp(map.neverTouch.join('|'), 'i')
    const filled = [], needsYou = [], files = []
    // 16 October 2026: modern application forms (SmartRecruiters, Workable...) live in open shadow roots; walk them too.
    const collect = (root, out) => { root.querySelectorAll('*').forEach((n) => { if (n.matches('input, textarea, select')) out.push(n); if (n.shadowRoot) collect(n.shadowRoot, out) }); return out }
    const els = collect(document, []).filter((el) => el.offsetParent !== null || el.type === 'file')
    for (const el of els) {
      const type = (el.type || '').toLowerCase()
      if (['hidden', 'submit', 'button', 'image', 'reset', 'checkbox', 'radio'].includes(type)) continue
      const text = describe(el)
      if (type === 'file') {
        // 16 October 2026: tag each file field so the runner can attach the right document (CV vs cover letter) without guessing again.
        const kind = /cover|lettre|motivation/.test(text) ? 'cover' : /resume|cv|curriculum/.test(text) ? 'resume' : 'other'
        el.setAttribute('data-zr-file', kind); files.push(kind + ': ' + text.slice(0, 70)); continue
      }
      if (type === 'password' || never.test(text)) { needsYou.push((labelOf(el) || el.name || el.id || type).trim().slice(0, 80)); continue }
      if (el.tagName === 'SELECT') { if (el.required && !el.value) needsYou.push((labelOf(el) || el.name || 'select').trim().slice(0, 80)); continue }
      if (el.value && el.value.trim()) continue
      const rule = map.fields.find((f) => (!f.types || f.types.includes(type || 'text')) && (!f.textareaOnly || el.tagName === 'TEXTAREA') && f.match.some((m) => new RegExp(m, 'i').test(text)) && !(f.exclude || []).some((m) => new RegExp(m, 'i').test(text)))
      const value = rule ? (rule.profile === '$letter' ? letter : profile[rule.profile]) : ''
      if (rule && value) {
        // 16 October 2026: a combobox / autocomplete wants a suggestion picked, typing alone is not enough: fill it and ask Matthieu to confirm.
        if (el.getAttribute('role') === 'combobox' || el.getAttribute('aria-autocomplete')) needsYou.push('check suggestion: ' + (labelOf(el) || rule.key).trim().slice(0, 50))
        setValue(el, String(value)); filled.push(rule.key)
      }
      else if (el.required || el.getAttribute('aria-required') === 'true') needsYou.push((labelOf(el) || el.name || el.id || 'field').trim().slice(0, 80))
    }
    const submit = [...document.querySelectorAll('button, input[type=submit]')].filter((b) => /submit|send|apply|postuler|envoyer|candidater/i.test(b.innerText || b.value || '')).map((b) => (b.innerText || b.value || '').trim().slice(0, 40))
    return { url: location.href, title: document.title.slice(0, 80), fields: els.length, filled, filledCount: filled.length, needsYou, filesToAttach: files, submitButtons: submit, ms: Math.round(performance.now() - t0) }
  }
  return typeof window.__zrFill
})()
