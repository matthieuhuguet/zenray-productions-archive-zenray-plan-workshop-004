// 4 October 2026: the service's private settings (the Claude token), kept in one file outside the repository, readable by Matthieu only.
// FR : les reglages prives du service (le jeton Claude), dans un fichier hors du depot, lisible par Matthieu seul.
import { readFile, stat } from 'node:fs/promises'
import path from 'node:path'

const ALLOWED = ['CLAUDE_CODE_OAUTH_TOKEN', 'ZENRAY_API_SECRET']

/** Reads KEY=VALUE lines for the allowed keys. A file other users can read is refused, so a token is never left exposed. */
export async function loadEnvFile(directory, { log = () => {} } = {}) {
  const file = path.join(directory, '.env')
  try {
    const info = await stat(file)
    if (info.mode & 0o077) { log(`${file} is readable by other users; ignoring it. Run: chmod 600 "${file}"`); return {} }
    const out = {}
    for (const line of (await readFile(file, 'utf8')).split('\n')) {
      const match = line.match(/^\s*([A-Z_]+)\s*=\s*(.*?)\s*$/)
      if (!match || !ALLOWED.includes(match[1])) continue
      const value = match[2].replace(/^["']|["']$/g, '')
      // A truncated token would override the CLI's own sign-in and make every call fail: a malformed one is ignored, out loud.
      if (match[1] === 'CLAUDE_CODE_OAUTH_TOKEN' && !/^sk-ant-oat01-[A-Za-z0-9_-]{60,}$/.test(value)) { log('CLAUDE_CODE_OAUTH_TOKEN in the settings file is not a complete token; ignoring it'); continue }
      out[match[1]] = value
    }
    return out
  } catch (error) { if (error.code !== 'ENOENT') log(`settings file unreadable: ${error.message}`); return {} }
}
