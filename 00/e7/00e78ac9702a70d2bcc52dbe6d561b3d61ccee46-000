// Cache LRU partagé pour /api/page?action=read, réutilisé par SharedFolderPage.jsx (galerie /folder) et
// QuickLookOverlay.jsx (aperçu Espace) — deux endroits qui pouvaient re-fetcher le MÊME manifeste (ex.
// ouvrir en Quick Look un fichier déjà affiché en carte) sans jamais se voir. Clé = URL exacte (déjà
// spécifique par appelant : share token inclus pour SharedFolderPage, absent pour QuickLookOverlay), donc
// aucun risque de collision entre un contexte public et un contexte authentifié.
//
// Retourne le body JSON BRUT ({markdown, sha, ...}), jamais pré-parsé : `markdown` est parfois du texte
// Notion brut (page), parfois un manifeste JSON à parser (media/file) selon l'appelant — même contrat que
// l'ancien fetch() direct qu'il remplace, juste mémoïsé.
import { createLruCache } from '../media/lruCache.js'

const CACHE = createLruCache({ maxEntries: 512 })
const inFlight = new Map()

// A « missing » answer is remembered for a few seconds only (2 October 2026): a file a guest has just added is missing on the CDN
// copy for a moment, and remembering that for the whole session left its tile blank until a reload.
const MISSING_MS = 8000
const missingUntil = new Map()

export async function readPageCached(url) {
  if (CACHE.has(url)) return CACHE.get(url)
  if (inFlight.has(url)) return inFlight.get(url)
  const until = missingUntil.get(url)
  if (until && until > Date.now()) return { markdown: '', sha: null, missing: true }
  const p = fetch(url, { cache: 'no-store' })
    .then((r) => (r.ok ? r.json() : null))
    .catch(() => null)
    .then((j) => {
      inFlight.delete(url)
      if (j != null && j.missing) { missingUntil.set(url, Date.now() + MISSING_MS); return j }
      if (j != null) CACHE.set(url, j)
      return j
    })
  inFlight.set(url, p)
  return p
}

export function clearPageReadCache() { CACHE.clear(); inFlight.clear() }
