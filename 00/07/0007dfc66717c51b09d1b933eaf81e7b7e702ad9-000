// Schéma BlockNote ÉTENDU : blocs par défaut + 2 custom blocks (zenrayEmbed, zenrayBookmark).
// P0 persistence : on conserve defaultBlockSpecs => les pages legacy (markdown only) chargent SANS régression.
// La source de vérité reste le .blocknote.json (relu en priorité) ; le .md dérivé est rendu lisible via
// la transformation clone-en-lien faite dans PageEditorBN.save() (les custom blocks ne passent jamais
// tels quels dans blocksToMarkdownLossy).
import { BlockNoteSchema, defaultBlockSpecs } from '@blocknote/core'
import { createReactBlockSpec } from '@blocknote/react'
import EmbedBlock from './EmbedBlock.jsx'
import BookmarkBlock from './BookmarkBlock.jsx'
import ImageRowBlock, { IMAGE_ROW_TYPE, PART_DEFAUT } from './ImageRowBlock.jsx'

// Thème courant partagé avec les renderers (useCreateBlockNote fige le schéma à la création,
// mais le thème peut changer ensuite ; le store évite de recréer l'éditeur).
const themeStore = { current: 'light' }
export const setBlockTheme = (t) => { themeStore.current = t === 'dark' ? 'dark' : 'light' }

const EmbedBlockSpec = createReactBlockSpec(
  {
    type: 'zenrayEmbed',
    propSchema: {
      url: { default: '' },
      provider: { default: 'youtube' },
      providerId: { default: '' },
      embedUrl: { default: '' },
      title: { default: '' },
      thumbnail: { default: '' },
    },
    content: 'none',
  },
  { render: ({ block }) => <EmbedBlock block={block} theme={themeStore.current} /> }
)

const BookmarkBlockSpec = createReactBlockSpec(
  {
    type: 'zenrayBookmark',
    propSchema: {
      url: { default: '' },
      title: { default: '' },
      description: { default: '' },
      image: { default: '' },
      favicon: { default: '' },
      siteName: { default: '' },
      loading: { default: false },
    },
    content: 'none',
  },
  { render: ({ block }) => <BookmarkBlock block={block} theme={themeStore.current} /> }
)

// RANGEE DE DEUX IMAGES (2026-08-28). Les props sont des CHAINES : le schema de BlockNote ne
// stocke que des valeurs simples, et `gauchePart` est donc lue puis bornee au rendu. Une seule
// fraction decrit la repartition, la droite prenant le reste, si bien que les deux colonnes ne
// peuvent jamais se contredire.
const ImageRowSpec = createReactBlockSpec(
  {
    type: IMAGE_ROW_TYPE,
    propSchema: {
      gauche: { default: '' },
      droite: { default: '' },
      legendeGauche: { default: '' },
      legendeDroite: { default: '' },
      gauchePart: { default: String(PART_DEFAUT) },
    },
    content: 'none',
  },
  { render: ({ block, editor }) => <ImageRowBlock block={block} editor={editor} theme={themeStore.current} /> }
)

// En BlockNote 0.51, createReactBlockSpec renvoie une FACTORY (options?) => BlockSpec.
// Il faut l'APPELER pour obtenir le spec ; passer la factory brute -> schema lit `.node` undefined -> crash.
export const bnSchema = BlockNoteSchema.create({
  blockSpecs: { ...defaultBlockSpecs, zenrayEmbed: EmbedBlockSpec(), zenrayBookmark: BookmarkBlockSpec(), [IMAGE_ROW_TYPE]: ImageRowSpec() },
})

// Pour la dérivation markdown : remplace chaque custom block par un block paragraph contenant un lien.
// On NE mute PAS editor.document ; on travaille sur un clone JSON passé à blocksToMarkdownLossy.
export function blocksForMarkdown(blocks) {
  return (blocks || []).flatMap((b) => {
    // Une rangee de deux images redevient DEUX images a la suite en markdown. Le markdown n'a pas
    // de colonnes ; perdre la mise en page est acceptable, perdre une image ne le serait pas. Le
    // .blocknote.json reste la source de verite et conserve la rangee telle quelle.
    if (b && b.type === 'zenrayImageRow') {
      const img = (url, legende) => ({ type: 'image', props: { url: url || '', caption: legende || '' } })
      return [b.props?.gauche && img(b.props.gauche, b.props.legendeGauche), b.props?.droite && img(b.props.droite, b.props.legendeDroite)].filter(Boolean)
    }
    if (b && (b.type === 'zenrayEmbed' || b.type === 'zenrayBookmark')) {
      const url = (b.props && b.props.url) || ''
      const label = (b.props && b.props.title) || url
      return { type: 'paragraph', content: url ? [{ type: 'link', href: url, content: label }] : [] }
    }
    return b
  })
}
