// ═══ AMENER QUELQUE CHOSE AU CENTRE, TOUJOURS DE LA MÊME FAÇON ═══════════════════════════════════
//
// « L'animation de transition doit être pareille que quand tu appuies sur une lettre dans le drive
// Create » (Matthieu, 2026-08-27). Cette animation existait, en un seul exemplaire, enfouie dans la
// navigation par lettre du Finder. La recopier dans le Plan aurait donné deux courbes qui se
// ressemblent aujourd'hui et divergent au premier réglage : c'est exactement ce que la loi HDA nomme,
// une définition et des instances, jamais un copier-coller pour changer une valeur.
//
// POURQUOI PAS `scrollIntoView({ behavior: 'smooth' })`, QUI TIENT EN UNE LIGNE. Parce qu'il ne laisse
// choisir NI la durée NI la courbe : le navigateur applique la sienne, elle change d'un navigateur à
// l'autre, et elle dure ce qu'elle veut selon la distance. Deux gestes de la même application se
// mettraient alors à ne plus se ressembler sans que personne ait rien décidé.
//
// LA COURBE EST UN EASeOutExpo EXACT, `1 - 2^(-10x)`, la formule d'easings.net et non une approximation
// par courbe de Bézier. Elle part très vite et s'arrête très doucement, ce qui est précisément ce qu'on
// veut d'un déplacement de point de vue : l'œil doit comprendre TOUT DE SUITE dans quel sens la page
// part, puis se poser sans à-coup. Une courbe symétrique donnerait un glissement d'ascenseur, joli et
// lent à lire.
export const DUREE_SCROLL = 300

/** Position de défilement qui amène `element` au CENTRE de `scroller`, bornée à ce qui existe. */
export function cibleCentree(scroller, element) {
  const sr = scroller.getBoundingClientRect()
  const tr = element.getBoundingClientRect()
  const brute = scroller.scrollTop + tr.top - sr.top - (scroller.clientHeight - tr.height) / 2
  return Math.max(0, Math.min(brute, scroller.scrollHeight - scroller.clientHeight))
}

/**
 * Anime `scroller.scrollTop` jusqu'à `cible`. `refRaf` est un objet `{ current }` qui porte l'animation
 * en cours : une nouvelle demande ANNULE la précédente au lieu de lutter contre elle, sans quoi deux
 * animations simultanées écriraient tour à tour dans la même propriété et le défilement tremblerait.
 */
export function scrollAnimeVers(scroller, cible, refRaf) {
  if (!scroller) return
  if (refRaf?.current) cancelAnimationFrame(refRaf.current)
  // `prefers-reduced-motion` : on arrive au même endroit, sans le trajet. Le juice n'est jamais une
  // raison de rendre une interface pénible à quelqu'un que le mouvement dérange.
  if (typeof window !== 'undefined' && window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    scroller.scrollTop = cible
    if (refRaf) refRaf.current = 0
    return
  }
  const depart = scroller.scrollTop
  const delta = cible - depart
  const debut = performance.now()
  const pas = (maintenant) => {
    const x = Math.min(1, (maintenant - debut) / DUREE_SCROLL)
    const adouci = x === 1 ? 1 : 1 - Math.pow(2, -10 * x)   // EaseOutExpo exact (easings.net)
    scroller.scrollTop = depart + delta * adouci
    if (x < 1) { if (refRaf) refRaf.current = requestAnimationFrame(pas) }
    else if (refRaf) refRaf.current = 0
  }
  if (refRaf) refRaf.current = requestAnimationFrame(pas)
}

/**
 * Remonte depuis `element` jusqu'au premier ancêtre qui défile réellement. Le conteneur défilant
 * appartient à l'application, pas au composant : le retrouver plutôt que le supposer fait survivre ce
 * code à un changement de mise en page au-dessus de lui.
 */
export function trouverScroller(element) {
  let n = element?.parentElement
  while (n && n !== document.body && getComputedStyle(n).overflowY !== 'auto') n = n.parentElement
  return n && n !== document.body ? n : null
}
