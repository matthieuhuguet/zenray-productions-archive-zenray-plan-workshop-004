.jpr { --jpr-gap: 16px; --jpr-card-min: 170px; --jpr-size: 17px; font-family: var(--zr-police-sans, 'InterVariable'), sans-serif; font-size: var(--jpr-size); padding: var(--jpr-gap); display: grid; gap: var(--jpr-gap); min-width: 0; }
.jpr h2,.jpr h3 { font-family: var(--zr-police-serif, 'AnthropicSerif'), serif; font-weight: 350; margin: 0; }
.jpr p { margin: 0; line-height: 1.6; }
.jpr nav,.jpr-filters,.jpr-detail header { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
.jpr button,.jpr input,.jpr select { font: inherit; color: inherit; background: transparent; border: 1px solid color-mix(in srgb, currentColor 22%, transparent); border-radius: 12px; padding: 10px 14px; max-width: 100%; }
.jpr button { cursor: pointer; text-align: left; }
.jpr button[aria-pressed=true] { background: color-mix(in srgb, var(--accent, #3b82f7) 14%, transparent); }
.jpr button:disabled { opacity: .4; cursor: default; }
.jpr-filters label { display: grid; gap: 6px; max-width: 100%; }
.jpr-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(min(100%,var(--jpr-card-min)),1fr)); gap: 12px; }
.jpr-grid button { display: grid; gap: 8px; align-content: start; overflow-wrap: anywhere; }
.jpr-grid button > span { font-size: 1.5em; }
.jpr-grid small { line-height: 1.5; }
.jpr-detail { display: grid; gap: var(--jpr-gap); padding: var(--jpr-gap); border: 1px solid color-mix(in srgb,currentColor 20%,transparent); border-radius: 18px; min-width: 0; overflow-wrap: anywhere; }
.jpr table { border-collapse: collapse; width: 100%; table-layout: fixed; }
.jpr td,.jpr th { text-align: left; vertical-align: top; padding: 12px 8px; font-weight: 400; border-bottom: 1px solid color-mix(in srgb,currentColor 15%,transparent); overflow-wrap: anywhere; }
.jpr-number { font-family: var(--zr-police-serif,'AnthropicSerif'),serif; font-weight: 400; }
