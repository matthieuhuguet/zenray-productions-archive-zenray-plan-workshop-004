// ═══ ATTENDRE UNE PREUVE, JAMAIS UN CHRONO ══════════════════════════════════════════════════════
//
// LE BESOIN, né du bug du 2026-08-30 (« 0/13 lien(s) créé(s) »). Créer un dossier sur ce drive
// revient à commiter sur GitHub. Entre ce commit et le moment où l'API le rend, il existe un
// instant pendant lequel le dossier n'existe pour personne d'autre que nous. Toute opération qui
// repart aussitôt vers un serveur — lequel relit GitHub — tombe dans cet instant et échoue.
//
// Matthieu a nommé le mécanisme le premier : « lancer un loader qui permet d'avoir un délai pour
// créer le folder puis envoyer les images dedans ».
//
// POURQUOI PAS UN DÉLAI FIXE, et c'est la seule décision de ce module. Un `setTimeout(800)` est un
// pari : trop court il rate sur un réseau lent, trop long il fait patienter pour rien, et dans les
// deux cas il ne dit JAMAIS s'il a suffi. On interroge donc jusqu'à obtenir une réponse, ce qui
// rend le succès observable au lieu d'être supposé.
//
// L'attente double à chaque essai plutôt que de rester constante : marteler un service qui n'a pas
// fini de répliquer ne le fait pas aller plus vite, cela ajoute seulement de la charge à un moment
// où il en a le moins besoin.

export const ATTENTES = { essais: 6, base: 120 }   // 120, 240, 480, 960, 1920 ms — paramètres, pas littéraux

// `sonde()` rend `true` quand la chose est là, `false` sinon, et ne lève jamais.
// `dormir` est injectable pour que les tests ne dorment pas réellement.
export async function attendreLaPreuve(sonde, { essais = ATTENTES.essais, base = ATTENTES.base, dormir } = {}) {
  const pause = dormir || ((ms) => new Promise((r) => setTimeout(r, ms)))
  for (let i = 0; i < essais; i++) {
    let vu = false
    try { vu = !!(await sonde()) } catch { vu = false }
    if (vu) return { ok: true, essais: i + 1 }
    if (i < essais - 1) await pause(base * (2 ** i))
  }
  return { ok: false, essais }
}
