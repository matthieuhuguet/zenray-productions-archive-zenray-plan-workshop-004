import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest'

// ═══ UN DOSSIER DE RACCOURCIS EAGLE DOIT POUVOIR SE DÉPLACER ════════════════════════════════════
//
// BUG CRITIQUE du 2026-08-31 : un dossier ne contenant QUE des raccourcis Eagle refusait de se
// déplacer (« 0 déplacé, 1 échec », retour en arrière). Cause : `move-tree` lisait le blob de CHAQUE
// raccourci pour mettre à jour son registre, plus le registre lui-même, plus un blob créé, soit trois
// sous-requêtes par raccourci. Vingt-et-un raccourcis faisaient ~69 sous-requêtes, au-delà de la
// limite de cinquante du Worker Cloudflare, qui mourait alors sans réponse.
//
// Le correctif : les raccourcis se déplacent par leur sha (git tree, zéro lecture), et leur registre
// se met à jour EN FOND, par lots séparés (action `sync-placements`). Le déplacement lui-même est
// donc cheap et ne dépend plus du nombre de raccourcis.

let appels, fetchOriginal

function installerFauxReseau(fichiersDuDossier) {
  appels = { total: 0, parUrl: [] }
  fetchOriginal = globalThis.fetch
  globalThis.fetch = async (url, opts) => {
    const u = String(url); appels.total++; appels.parUrl.push(u.replace(/https:\/\/[^/]+/, ''))
    const post = opts && opts.method && opts.method !== 'GET'
    // création git (POST/PATCH) : blob, tree, commit, ref
    if (u.includes('git/blobs') && post) return new Response(JSON.stringify({ sha: 'b' }), { status: 201 })
    if (u.includes('git/trees') && post) return new Response(JSON.stringify({ sha: 't' }), { status: 201 })
    if (u.includes('git/commits') && post) return new Response(JSON.stringify({ sha: 'c' }), { status: 201 })
    if (u.includes('git/refs/heads') && post) return new Response(JSON.stringify({}), { status: 200 })
    // lectures git (GET)
    if (u.includes('git/ref/heads')) return new Response(JSON.stringify({ object: { sha: 'p' } }), { status: 200 })
    if (u.includes('git/commits/')) return new Response(JSON.stringify({ tree: { sha: 'bt' } }), { status: 200 })
    if (u.includes('git/blobs/')) return new Response(JSON.stringify({ content: Buffer.from('{}').toString('base64') }), { status: 200 })
    // raw : marqueurs et registres (resolveEagleFolderDir, rawJsonAt) — un objet neutre
    if (u.includes('raw.githubusercontent')) return new Response(JSON.stringify({ resourceId: 'zr_x', placements: [] }), { status: 200 })
    // contents : soit un fichier précis (.json dedans), soit le listing du dossier
    if (u.includes('/contents/')) {
      if (u.includes('.json')) return new Response(JSON.stringify({ content: Buffer.from(JSON.stringify({ resourceId: 'zr_x', placements: [] })).toString('base64') }), { status: 200 })
      return new Response(JSON.stringify(fichiersDuDossier), { status: 200 })
    }
    return new Response('Not Found', { status: 404 })
  }
}

function fausseReponse() {
  const r = { code: 0, corps: null }
  r.status = (c) => { r.code = c; return r }
  r.json = (j) => { r.corps = j; return r }
  r.setHeader = () => r; r.end = (v) => { r.corps = v; return r }
  return r
}

// Un dossier de 21 raccourcis Eagle (.img.json), plus son marqueur de dossier.
const DOSSIER = [
  { type: 'file', path: 'pages/A/tri/streets5/.zrfolder.json', sha: 's0' },
  ...Array.from({ length: 21 }, (_, i) => ({ type: 'file', path: `pages/A/tri/streets5/IMG_${5800 + i}.jpeg.img.json`, sha: 's' + i })),
]

beforeEach(() => { process.env.GITHUB_TOKEN = 'faux' })
afterEach(() => { if (fetchOriginal) globalThis.fetch = fetchOriginal })

describe('déplacer un dossier de 21 raccourcis', () => {
  it('LE BUG : le déplacement tient LARGEMENT sous la limite de 50 sous-requêtes', async () => {
    installerFauxReseau(DOSSIER)
    const { default: handler } = await import('./page.js')
    const res = fausseReponse()
    await handler({ method: 'POST', query: {}, headers: { 'x-zr-auth': 'x' },
      body: { action: 'move-tree', from: 'pages/A/tri/streets5', to: 'pages/B/streets5' } }, res)

    expect(res.corps?.ok, `le déplacement doit réussir, réponse: ${JSON.stringify(res.corps)}`).toBe(true)
    // Le coeur du fix : PAS de lecture de blob par raccourci. Bien moins de 50.
    expect(appels.total, `${appels.total} sous-requêtes pour 21 raccourcis — le Worker meurt au-delà de 50`).toBeLessThan(45)
  })

  it('les 21 raccourcis sont bien renvoyés pour la synchro de fond', async () => {
    installerFauxReseau(DOSSIER)
    const { default: handler } = await import('./page.js')
    const res = fausseReponse()
    await handler({ method: 'POST', query: {}, headers: { 'x-zr-auth': 'x' },
      body: { action: 'move-tree', from: 'pages/A/tri/streets5', to: 'pages/B/streets5' } }, res)
    expect(Array.isArray(res.corps?.placementSync)).toBe(true)
    expect(res.corps.placementSync.length, 'les 21 raccourcis doivent être listés pour la synchro').toBe(21)
  })

  it('sync-placements traite un lot borné à 15', async () => {
    installerFauxReseau(DOSSIER)
    const { default: handler } = await import('./page.js')
    const res = fausseReponse()
    const links = Array.from({ length: 21 }, (_, i) => ({ from: `pages/A/tri/streets5/IMG_${5800 + i}.jpeg.img.json`, to: `pages/B/streets5/IMG_${5800 + i}.jpeg.img.json` }))
    await handler({ method: 'POST', query: {}, headers: { 'x-zr-auth': 'x' },
      body: { action: 'sync-placements', links } }, res)
    expect(res.corps?.ok).toBe(true)
    expect(res.corps.done, 'le lot est borné à 15').toBe(15)
    expect(appels.total, 'un lot de sync reste sous la limite').toBeLessThan(50)
  })
})
