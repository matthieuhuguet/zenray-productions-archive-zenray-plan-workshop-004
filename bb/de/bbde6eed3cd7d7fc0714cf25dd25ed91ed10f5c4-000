// push-policy-simulation.mjs (14 October 2026): an EXPECTED VALUE model to check that the push policy stays the fastest whatever the
// connection and the volume. It is a model, not a measurement: a push of S bytes on a line of B bytes/s lasts d = S/B + overhead, a line
// hiccup (mean time between hiccups = mtbfSeconds) kills a push in progress with probability 1 - exp(-d / mtbf), and a failed push wastes
// half of its duration plus a backoff. FR : modele en esperance pour verifier que la politique reste la plus rapide ; ce n'est pas une mesure.
export const SIMULATION = Object.freeze({
  overheadSeconds: 6, // fixed cost of one push (server queue, hash, spawn), measured 5.7 to 7.6 s on 14 October 2026
  backoffSeconds: 3,
  minTargetSeconds: 60,
  maxTargetSeconds: 600,
  partBytes: 95 * 1048576 + 16,
  minParts: 1,
  maxParts: 20,
})

export function expectedPushSeconds(sizeBytes, bytesPerSecond, mtbfSeconds, sim = SIMULATION) {
  const d = sizeBytes / bytesPerSecond + sim.overheadSeconds
  const pFail = mtbfSeconds > 0 ? 1 - Math.exp(-d / mtbfSeconds) : 0
  return d + (pFail / (1 - pFail)) * (d / 2 + sim.backoffSeconds)
}

/** Batch size of each strategy: fixed in MiB, or "adaptive" (the throughput sizing of push-batch-policy.mjs). */
/** The duration a push should aim for: the optimum of overhead against lost work, sqrt(2 x overhead x mean time between hiccups). */
export function targetSeconds(mtbfSeconds, sim = SIMULATION) {
  return Math.min(sim.maxTargetSeconds, Math.max(sim.minTargetSeconds, Math.sqrt(2 * sim.overheadSeconds * mtbfSeconds)))
}

export function batchBytes(strategy, bytesPerSecond, mtbfSeconds, sim = SIMULATION) {
  if (strategy === 'adaptive') {
    const bySpeed = Math.floor(bytesPerSecond * targetSeconds(mtbfSeconds, sim))
    return Math.min(sim.maxParts * sim.partBytes, Math.max(sim.minParts * sim.partBytes, bySpeed))
  }
  return Number(strategy) * 1048576
}

export function totalHours(volumeBytes, strategy, bytesPerSecond, mtbfSeconds, sim = SIMULATION) {
  const size = batchBytes(strategy, bytesPerSecond, mtbfSeconds, sim)
  const pushes = volumeBytes / size // continuous: the rounding of the last push is an artifact, not a property of the strategy
  return (pushes * expectedPushSeconds(size, bytesPerSecond, mtbfSeconds, sim)) / 3600
}
