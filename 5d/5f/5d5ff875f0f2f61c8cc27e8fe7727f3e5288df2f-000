// deliveryKind.js (14 October 2026): how a film reached the drive, read from its manifest only (no network call).
// FR : comment un film est arrive sur le drive, lu depuis son manifeste seul.
// 14 October 2026: how a film reached the drive. FR : comment le film est arrive sur le drive.
//   streaming = master/mpd only, archive = encrypted parts only, both = archive of the original AND a streaming copy.
export const DELIVERY_STYLE = {
  streaming: { label: 'modeStreaming', hint: 'modeStreamingHint', color: '#34c759' },
  both: { label: 'modeBoth', hint: 'modeBothHint', color: '#0a84ff' },
  archive: { label: 'modeArchive', hint: 'modeArchiveHint', color: '#ff9f0a' },
}
export function deliveryKind(manifest, isYoutube = false) {
  if (!manifest || isYoutube || manifest.type === 'youtube') return null
  const streams = Boolean(manifest.master || manifest.mpd)
  const archive = Array.isArray(manifest.parts) && manifest.parts.length > 0
  if (streams && archive) return 'both'
  if (streams) return 'streaming'
  if (archive) return 'archive'
  return null
}
const fmtBytes = (n) => (n >= 1073741824 ? `${(n / 1073741824).toFixed(2)} GiB` : `${Math.round(n / 1048576)} MiB`)
export function deliveryRows(m, kind, tr, fmt = (n) => String(n)) {
  const rows = [[tr('player.dKind'), tr(`player.${DELIVERY_STYLE[kind].label}`)]]
  if (m.codec) rows.push([tr('player.dCodec'), [m.codec, m.width && m.height ? `${m.width}×${m.height}` : ''].filter(Boolean).join(' · ')])
  if (m.duration) rows.push([tr('player.dDuration'), fmt(m.duration)])
  if (m.size) rows.push([tr('player.dSize'), fmtBytes(m.size)])
  if (m.cmafPackagingMode) rows.push([tr('player.dPackaging'), m.cmafPackagingMode])
  if (m.cmafSegmentCount) rows.push([tr('player.dSegments'), String(m.cmafSegmentCount)])
  if (Array.isArray(m.parts) && m.parts.length) rows.push([tr('player.dParts'), `${m.parts.length}${m.alg ? ` · ${m.alg}` : ''}`])
  if (Array.isArray(m.audio) && m.audio.length) rows.push([tr('player.dAudio'), m.audio.map((a) => a.label || a.lang).join(', ')])
  if (Array.isArray(m.subtitles) && m.subtitles.length) rows.push([tr('player.dSubtitles'), m.subtitles.map((s) => s.label || s.lang).join(', ')])
  if (m.publicRepo) rows.push([tr('player.dPublicRepo'), m.publicRepo])
  if (m.hlsDashVerified) rows.push([tr('player.dVerified'), 'HLS + DASH'])
  return rows
}
