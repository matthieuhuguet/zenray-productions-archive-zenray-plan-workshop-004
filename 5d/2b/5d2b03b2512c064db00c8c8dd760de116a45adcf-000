// LE GARDE-FOU DE LA DISPOSITION (2026-08-04).
//
// Une seule règle héritée d'une disposition morte, `.zrm-library { grid-column: 1 / -1 }`, a suffi
// à faire recouvrir les trois colonnes par la palette. Les symptômes rapportés étaient trois et
// paraissaient sans rapport : un panneau qui en recouvre un autre, un clic sur les propriétés qui
// atterrit dans la palette, et « je clique sur nouveau texte, ça crée un calque ». Une seule cause.
//
// Ce fichier interdit que cela se reproduise, en lisant la feuille de style comme du texte. C'est
// volontairement grossier : jsdom ne fait pas de mise en page, donc aucune assertion sur la
// géométrie réelle n'est possible ici, et une vérification approximative qui tient vaut mieux
// qu'une vérification exacte qui n'existe pas.

import { describe, it, expect } from 'vitest'
import fs from 'node:fs'
import path from 'node:path'

const css = fs.readFileSync(path.join(process.cwd(), 'src/zenraymedia/media.css'), 'utf8')

// Les règles qui ont LE DROIT de parler de colonnes : la grille elle-même et ses replis.
const AUTORISEES = /^\.zrm-shell/

function reglesQuiPlacent() {
  const out = []
  // Un balayage de bloc à bloc, sélecteur puis corps. Suffisant pour une feuille écrite à la main.
  for (const bloc of css.split('}')) {
    const i = bloc.lastIndexOf('{')
    if (i < 0) continue
    const selecteur = bloc.slice(0, i).split('\n').filter((l) => !l.trim().startsWith('/*')).join(' ').trim()
    const corps = bloc.slice(i + 1)
    if (!selecteur) continue
    if (/grid-column\s*:|grid-row\s*:/.test(corps)) out.push(selecteur)
  }
  return out
}

describe('la disposition en huit zones', () => {
  it('AUCUNE règle hors de la coque ne décide du placement en colonnes', () => {
    const fautives = reglesQuiPlacent().filter((s) => !AUTORISEES.test(s.trim()))
    expect(fautives).toEqual([])
  })

  it('les huit zones sont toutes déclarées, et une seule fois chacune', () => {
    for (const zone of ['menu', 'tools', 'palette', 'viewport', 'details', 'hier', 'anim', 'status']) {
      expect(css).toContain(`grid-area: ${zone} !important`)
      expect(css).toContain(`"zrm-zone-${zone}"`.replace(/"/g, '') ? `.zrm-zone-${zone}` : '')
    }
  })

  it('la grille nomme ses zones dans le même vocabulaire que les classes', () => {
    const zonesDeclarees = [...css.matchAll(/grid-area:\s*([a-z]+)\s*!important/g)].map((m) => m[1]).sort()
    expect(new Set(zonesDeclarees).size).toBe(8)
  })
})
