export function classifyRepoProbe(status, stdout = '', stderr = '', error = null) {
  const sortie = `${stdout}\n${stderr}`
  if (error) return { kind: 'error', message: error.message || String(error) }
  if (status === 0 && /"sha"\s*:/.test(stdout)) return { kind: 'content' }
  if (status !== 0 && /(?:HTTP\s*)?404|not found/i.test(sortie)) return { kind: 'missing' }
  if (status !== 0 && /(?:HTTP\s*)?409|repository is empty/i.test(sortie)) return { kind: 'empty' }
  return { kind: 'error', message: sortie.trim() || `sortie inattendue (code ${status})` }
}
