// 2026-09-23 19:55 : journal parsing, time zones and classification.
import { describe, it, expect } from 'vitest'
import { parseJournal, classify, buildTimeline, daySummary } from './journal.js'

const SAMPLE = `# PROGRESS global

<!-- legacy-id:aaaaaaaaaaaaaaaaaaaa -->
2026-05-19 00:46
- Agent : historique
- Projet : Memory global legacy
- Fait : Leçon de japonais, kanji du jour.

2026-09-23 20:31
- Agent : Antigravity
- Projet : Media
- Fait : Renommage des episodes
  sur deux lignes.

2026-09-23 18:36 +02:00
- Agent : Claude Code Desktop
- Projet : ZenRayProgress
- Fait : Relais du journal.
`

describe('parseJournal', () => {
  const e = parseJournal(SAMPLE)
  it('finds every entry and multi-line values', () => {
    expect(e).toHaveLength(3)
    expect(e[1].fait).toBe('Renommage des episodes\n  sur deux lignes.')
    expect(e[0].legacy).toBe(true)
  })
  it('reads an explicit offset exactly', () => {
    expect(new Date(e[2].at).toISOString()).toBe('2026-09-23T16:36:00.000Z')
  })
  it('reads offset-less script entries as Tokyo time', () => {
    expect(new Date(e[1].at).toISOString()).toBe('2026-09-23T11:31:00.000Z')
  })
  it('reads legacy entries before 2026-06-12 as Paris time', () => {
    expect(new Date(e[0].at).toISOString()).toBe('2026-05-18T22:46:00.000Z')
  })
})

describe('classify', () => {
  it('uses the project first, keywords for legacy entries', () => {
    const [a, b, c] = parseJournal(SAMPLE)
    expect(classify(a).id).toBe('japanese')
    expect(classify(b).id).toBe('media')
    expect(classify(c).id).toBe('progress')
  })
  it('does not match a keyword inside a longer word', () => {
    const [x] = parseJournal('2026-09-23 10:00 +02:00\n- Projet : legacy\n- Fait : fabrique un objet\n')
    expect(classify(x).id).not.toBe('studio')
  })
})

describe('timeline', () => {
  it('groups by local day and estimates sessions', () => {
    const { days } = buildTimeline('2026-09-23 10:00 +02:00\n- Projet : ZenRayProgress\n- Fait : a\n\n2026-09-23 10:30 +02:00\n- Projet : ZenRayProgress\n- Fait : b\n')
    const list = [...days.values()][0]
    const [s] = daySummary(list)
    expect(s.count).toBe(2)
    expect(s.minutes).toBe(45)
  })
})
