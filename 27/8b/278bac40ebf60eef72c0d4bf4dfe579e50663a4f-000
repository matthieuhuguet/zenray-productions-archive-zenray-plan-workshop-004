import React from 'react'
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
import { processGuestUpload, importMediaKey } from '../../server/guestUploadCore.js'
import { makeFakeGitHub } from '../../server/testing/fakeGithub.js'
import { unpackFrame } from '../lib/guestFrame.js'

// The sheet's uploader is wired to the REAL server logic over an in-memory GitHub (instead of XHR and canvas, which jsdom lacks).
const state = { gh: null, key: null, fail: 0 }
vi.mock('./browserAdapters.js', () => ({
  makeBrowserAdapters: () => ({
    readBlob: async (f, a, b) => f.bytes.subarray(a, b),
    hashBytes: async (u8) => Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', u8)), (x) => x.toString(16).padStart(2, '0')).join(''),
    makeThumb: async () => { const u = new Uint8Array(300).fill(5); u.set([0x52, 0x49, 0x46, 0x46, 1, 2, 3, 4, 0x57, 0x45, 0x42, 0x50], 0); return { bytes: u, mime: 'image/webp', w: 1920, h: 1080, thumbW: 1920, thumbH: 1080 } },
    send: async (frame) => {
      if (state.fail > 0) { state.fail--; throw new Error('network') }
      const { header, payload } = unpackFrame(frame)
      return processGuestUpload({ header, payload, gh: state.gh, key: state.key, secret: 's', sleep: async () => {}, resolveShare: async () => ({ kind: 'folder', path: 'pages/Photos/Mariage' }) })
    },
    sleep: async () => {}, isOnline: () => true,
  }),
}))
const { default: GuestUploadSheet } = await import('./GuestUploadSheet.jsx')
const { useGuestUploader } = await import('./useGuestUploader.js')

const jpeg = (n, seed) => { const u = new Uint8Array(n); for (let i = 0; i < n; i++) u[i] = (i * 7 + seed) & 255; u.set([0xff, 0xd8, 0xff, 0xe0, 0, 16, 0x4a, 0x46, 0x49, 0x46, 0, 1], 0); return u }
const photo = (name, seed) => { const bytes = jpeg(6000, seed); return Object.assign(new File([bytes], name, { type: 'image/jpeg' }), { bytes }) }
function Harness({ onView }) { const up = useGuestUploader({ token: 'zrs1.ui' }); return <GuestUploadSheet open onClose={() => {}} up={up} rootLabel="Mariage de Cléa" onView={onView} /> }
const pick = (files) => { const input = document.querySelector('input[type=file][accept]'); Object.defineProperty(input, 'files', { value: files, configurable: true }); fireEvent.change(input) }

beforeEach(async () => { localStorage.clear(); state.gh = makeFakeGitHub(); state.key = await importMediaKey(btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(32))))); state.fail = 0 })
afterEach(cleanup)

describe('la fenêtre « Ajouter mes photos »', () => {
  it('demande le prénom, puis Marie dépose deux photos et voit « Merci Marie ! 2 photos ajoutées »', async () => {
    const onView = vi.fn()
    render(<Harness onView={onView} />)
    expect(screen.getByText('Bienvenue')).toBeTruthy()
    fireEvent.change(screen.getByPlaceholderText('Votre prénom'), { target: { value: 'Marie' } })
    fireEvent.click(screen.getByText('Continuer'))
    expect(screen.getByText('Glissez vos photos ici')).toBeTruthy()
    await act(async () => { pick([photo('IMG_1.JPG', 1), photo('IMG_2.JPG', 2)]) })
    await waitFor(() => expect(screen.getByText(/Merci Marie/)).toBeTruthy(), { timeout: 4000 })
    expect(document.body.textContent).toContain('photos ajoutées')
    expect(state.gh.listPaths('zenray-data', 'pages/Photos/Mariage/Marie/').filter((p) => p.endsWith('.img.json'))).toHaveLength(2)
    fireEvent.click(screen.getByText('Voir mes photos'))
    expect(onView).toHaveBeenCalledWith('Marie', '')
  })

  it('un nom déjà donné lors d’une visite précédente est repris : on va droit aux photos', async () => {
    localStorage.setItem('zr-guest-name', 'Anne')
    render(<Harness />)
    expect(screen.queryByText('Bienvenue')).toBeNull()
    expect(screen.getByText('Choisir des photos')).toBeTruthy(); expect(screen.getByText('Choisir un dossier')).toBeTruthy()
    await act(async () => { pick([photo('a.jpg', 3)]) })
    await waitFor(() => expect(screen.getByText(/Merci Anne/)).toBeTruthy(), { timeout: 4000 })
  })

  it('une connexion qui flanche ne montre jamais d’erreur : l’envoi finit par aboutir', async () => {
    localStorage.setItem('zr-guest-name', 'Marie')
    state.fail = 3
    render(<Harness />)
    await act(async () => { pick([photo('a.jpg', 3)]) })
    await waitFor(() => expect(screen.getByText(/Merci Marie/)).toBeTruthy(), { timeout: 6000 })
    expect(document.body.textContent).not.toMatch(/erreur|échec|impossible/i)
  })

  it('un fichier qui n’est pas une photo est écarté avec une phrase polie', async () => {
    localStorage.setItem('zr-guest-name', 'Marie')
    render(<Harness />)
    await act(async () => { pick([Object.assign(new File(['x'], 'notes.pdf'), { bytes: new Uint8Array(1) }), photo('ok.jpg', 4)]) })
    await waitFor(() => expect(screen.getByText(/Merci Marie/)).toBeTruthy(), { timeout: 4000 })
    expect(document.body.textContent).toContain('seules les photos sont acceptées')
  })
})
