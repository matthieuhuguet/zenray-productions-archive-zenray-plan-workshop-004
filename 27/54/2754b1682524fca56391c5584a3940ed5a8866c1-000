import { describe, it, expect } from 'vitest'
import { isEagleLink } from './eagleLink.js'
import { mediaSourceSegments } from './mediaProvenance.js'

// ═══ LE MÊME BUG EST RESSORTI TROIS FOIS. CE TEST DIT POURQUOI ═══════════════════════════════════
//
// Un lien Eagle est un `.img.json` qui ne porte qu'un `resourceId`. Trois consommateurs l'ont lu
// comme un manifeste d'image et en ont tiré une conclusion fausse, chacun à son tour :
//   · la carte des vignettes de l'index, qui n'y trouvait pas de `thumb` ;
//   · la grille du dossier, qui lisait le manifeste au lieu de l'index ;
//   · l'auto-index en ligne, pour un lien créé après la dernière indexation.
//
// La leçon tient en une phrase : TOUT code qui lit un `.img.json` doit savoir qu'il peut tomber sur
// un lien. Ce fichier fixe la forme d'un lien et ce qu'on doit en déduire, pour qu'un quatrième
// consommateur ne redécouvre pas la même chose.

const LIEN = { v: 1, type: 'zenray-eagle-link/v1', resourceId: 'zr_abc', title: 'IMG.jpeg', createdAt: '2026-08-31T00:00:00Z' }
const CANONIQUE = { type: 'image', vis: 'public', cdnRepo: 'zenrayshards-img-x', cdnCommit: 'abc', cdnChunks: ['a'], thumb: 'https://cdn.jsdelivr.net/x.webp', thumbIv: 'iv', iv: 'iv', alg: 'AES-GCM' }

describe('la forme d’un lien, et ce qu’on ne doit PAS en déduire', () => {
  it('un lien se reconnaît à son type et son resourceId', () => {
    expect(isEagleLink(LIEN)).toBe(true)
    expect(isEagleLink(CANONIQUE)).toBe(false)
    expect(isEagleLink(null)).toBe(false)
    expect(isEagleLink({ type: 'zenray-eagle-link/v1' })).toBe(false)   // sans resourceId, ce n'est rien
  })

  it('un lien ne porte AUCUN des champs qu’un lecteur d’image attend', () => {
    // C'est la cause de fond des trois incidents : le lecteur trouve un objet valide, mais vide de
    // ce qui l'intéresse, et conclut « pas de vignette » au lieu de « ce n'est pas un manifeste ».
    for (const champ of ['vis', 'cdnRepo', 'cdnCommit', 'cdnChunks', 'cdnPath', 'thumb', 'w', 'h', 'size']) {
      expect(LIEN[champ], `un lien ne doit pas porter ${champ}`).toBeUndefined()
    }
  })

  it('la provenance d’un lien se TAIT, elle n’annonce pas un faux « proxy privé »', () => {
    expect(mediaSourceSegments(LIEN, 'image')).toEqual([])
  })

  it('le manifeste canonique, lui, rend bien sa vraie couleur', () => {
    const seg = mediaSourceSegments(CANONIQUE, 'image')
    expect(seg).toHaveLength(1)
    expect(seg[0].label).toContain('jsDelivr')
  })

  it('un lien de LIEN reste un lien : la chaîne peut avoir plus d’un maillon', () => {
    // Matthieu a trié une référence déjà triée. Le serveur remonte jusqu'au canonique en suivant le
    // registre ; côté client, `resolveEaglePath` fait le même travail. Rien ici ne doit supposer
    // qu'un lien pointe DIRECTEMENT vers un média.
    const lienDeLien = { ...LIEN, resourceId: 'zr_abc' }
    expect(isEagleLink(lienDeLien)).toBe(true)
    expect(lienDeLien.resourceId).toBe(LIEN.resourceId)   // même ressource, deux emplacements
  })
})
