// shelf-poster-url.js (15 October 2026): pure parser shared by the Worker route and the browser. NO process, NO Buffer, NO DOM.
// One optional sub folder level (posters/) is allowed, as in the seeded anime posters; never `..`.
// FR : parseur pur, importable cote navigateur ; la route serveur lui passe son proprietaire et ses depots depuis process.env.
const MIME = { jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', avif: 'image/avif', gif: 'image/gif' }
const URL_RE = /^https:\/\/cdn\.jsdelivr\.net\/gh\/([^/@]+)\/([^/@]+)@([0-9a-f]{7,40})\/((?:[A-Za-z0-9_-]+\/)?[A-Za-z0-9._-]+)\.(jpe?g|png|webp|avif|gif)$/i
export const SHELF_OWNER = 'matthieuhuguet'
export const SHELF_REPOS = ['zenrayshards-img-124ff562adad', 'zenray-shelf-img'] // the repo was renamed on 5 July 2026

/** {raw, mime} for an allowed Shelf poster URL, else null. / Url raw equivalente, ou null si non autorisee. */
export function parseShelfPosterUrl(input, owner = SHELF_OWNER, repos = SHELF_REPOS) {
  const m = URL_RE.exec(String(input || ''))
  if (!m) return null
  const [, o, repo, commit, name, ext] = m
  if (o !== owner || !repos.includes(repo)) return null
  return { raw: `https://raw.githubusercontent.com/${o}/${repo}/${commit}/${name}.${ext}`, mime: MIME[ext.toLowerCase()] }
}
