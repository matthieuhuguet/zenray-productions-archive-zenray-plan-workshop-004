// ShareVideoPage.jsx — PAGE PUBLIQUE « vidéo only » (lien de partage /watch?v=<token>).
//
// EN CLAIR : quand on ouvre un lien de partage, on n'affiche QUE le lecteur de cette vidéo — pas la sidebar,
// pas le drive, pas d'auth. Celui qui a le lien peut regarder ET télécharger, mais n'a accès à rien d'autre.
// Le token v1 est opaque, signé, expirant et révocable. Les anciens chemins encodés en base64url restent lus.
//
// Données : le manifeste .media.json (titre/mpd/master/poster) est lu via /api/page ; les segments sont déjà
// publics sur jsDelivr. Aucun secret requis (le streaming vidéo est public par conception).
import React, { useEffect, useState } from 'react'
import { PALETTE, THEMES } from '../theme.js'
import { useT } from '../i18n/useT.js'
import LanguageSwitcher from './LanguageSwitcher.jsx'
import { lazyRetry } from '../lib/lazyRetry.js'
import { appendShareCredential, decodeShare, encodeShare, resolveShareToken, SHARE_KIND } from '../lib/shareLinks.js'
const LazyVideoPlayer2 = lazyRetry(() => import('./VideoPlayer2.jsx'))

// Réexports historiques : App.jsx et quelques composants importent encore ces noms. Les nouveaux liens sont
// créés par createShareLink ; decodeShare reste uniquement la compatibilité des anciens liens base64.
export { encodeShare, decodeShare }

// La page partage NE PEINT PAS de fond : le wallpaper dégradé flouté du `body` (CSS index.html) reste visible,
// exactement comme dans Create. On masque seulement la sidebar/nav -> même esthétique, juste la vidéo. Thème
// CLAIR par défaut (le wallpaper clair). Le lecteur s'affiche sur une carte verre (zr-liquid), comme dans Create.
export default function ShareVideoPage() {
  const t = THEMES.light
  const i18nT = useT()
  const [path, setPath] = useState('')
  const [m, setM] = useState(null)
  const [err, setErr] = useState(null)

  useEffect(() => {
    const v = new URLSearchParams(window.location.search).get('v') || ''
    const controller = new AbortController()
    ;(async () => {
      try {
        const resolved = await resolveShareToken(v, SHARE_KIND.video, { signal: controller.signal })
        if (controller.signal.aborted) return
        setPath(resolved.path)
        const response = await fetch(appendShareCredential(`/api/page?action=read&path=${encodeURIComponent(resolved.path)}`, v), { cache: 'no-store', signal: controller.signal })
        if (!response.ok) throw new Error('manifest')
        const j = await response.json()
        let mm = {}; try { mm = JSON.parse(j.markdown) } catch {}
        // FMP4-SINGLE (14 October 2026): a manifest that only carries `download.parts` would need to be accepted here too. FR : accepter aussi un manifeste fMP4 unique.
        const ok = mm && (mm.mpd || mm.master || (mm.type === 'video-raw' && Array.isArray(mm.parts) && mm.parts.length) || (mm.type === 'youtube' && mm.videoId))
        if (ok) setM(mm); else setErr('share.videoNotFound')
      } catch (error) {
        if (!controller.signal.aborted) setErr(error && error.code ? 'share.invalidLink' : 'share.videoNotFound')
      }
    })()
    return () => controller.abort()
  }, [])

  return (
    <div style={{ minHeight: '100vh', background: 'transparent', color: t.textPrimary, fontFamily: "var(--zr-police-sans)", display: 'flex', flexDirection: 'column' }}>
      {/* en-tête minimal : logo ZenRay, sur le wallpaper (pas de barre opaque) */}
      <header style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '16px 22px' }}>
        <img src="/favicon.png" alt="ZenRay" style={{ width: 28, height: 28, borderRadius: 8 }} />
        <span style={{ fontFamily: "var(--zr-police-serif)", fontStyle: 'italic', fontSize: 'var(--zr-ui-3xl)', color: t.textPrimary }}>ZenRay</span>
        <span style={{ marginLeft: 'auto' }}><LanguageSwitcher t={t} /></span>
      </header>

      <main style={{ flex: 1, width: '100%', maxWidth: 1120, margin: '0 auto', padding: '12px 16px 60px', boxSizing: 'border-box' }}>
        {err && <div className="zr-liquid" style={{ color: PALETTE.red, fontSize: 'var(--zr-ui-lg)', padding: 40, textAlign: 'center', borderRadius: 18 }}>{i18nT(err)}</div>}
        {!err && !m && <div style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-lg)', padding: 40, textAlign: 'center' }}>{i18nT('share.loadingVideo')}</div>}
        {!err && m && (
          <div className="zr-liquid" style={{ borderRadius: 20, padding: 'clamp(12px,2vw,22px)' }}>
            <React.Suspense fallback={<div style={{ color: t.textSecondary, padding: 40, textAlign: 'center' }}>{i18nT('share.loadingPlayer')}</div>}>
              <LazyVideoPlayer2 t={t} path={path} manifest={m} shared />
            </React.Suspense>
          </div>
        )}
      </main>
    </div>
  )
}
