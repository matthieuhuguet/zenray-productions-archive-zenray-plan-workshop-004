// 9 October 2026, 23:14 CEST: a failed idle-sleep helper retries while a transfer remains active.
it('retries the macOS idle-sleep helper after an unexpected exit', async () => {
  vi.useFakeTimers()
  const makeChild = () => {
    const handlers = new Map()
    return { once: vi.fn((event, handler) => handlers.set(event, handler)), kill: vi.fn(), emit: (event, ...args) => handlers.get(event)?.(...args) }
  }
  const first = makeChild(), second = makeChild()
  const spawnProcess = vi.fn().mockReturnValueOnce(first).mockReturnValueOnce(second)
  const onFailure = vi.fn()
  const inhibitor = createIdleSleepInhibitor({ platform: 'darwin', spawnProcess, retryMs: 10 })
  try {
    inhibitor.start(onFailure)
    first.emit('exit', 1, null)
    expect(onFailure).toHaveBeenCalledOnce()
    await vi.advanceTimersByTimeAsync(10)
    expect(spawnProcess).toHaveBeenCalledTimes(2)
    inhibitor.stop()
    expect(second.kill).toHaveBeenCalledWith('SIGTERM')
  } finally { vi.useRealTimers() }
})

