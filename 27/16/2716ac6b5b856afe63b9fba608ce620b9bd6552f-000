// 2 October 2026, 15:30 CEST: an automatic bulk job yields to queued actions after each verified batch.
it('lets a queued action run between automatic backup batches', async () => {
  const { service, project, config, folder } = await fixture()
  config.storage.batchFiles = 1
  config.storage.progressPath = path.join(folder, 'missing-progress.md')
  await writeFile(path.join(folder, 'second.png'), 'second original')
  await service.register(project)
  const order = []
  const publishedCounts = []
  service.cloudPublisher = async (snapshot) => { publishedCounts.push(snapshot.sync.backedUpCount) }
  service.runProcess = async (script, args) => {
    if (script.endsWith('index-add-paths.mjs')) return { lastEvent: null }
    order.push('batch')
    const fiches = []
    for (const file of service.state(project.id).inventory.localFiles) {
      try { fiches.push({ rel: file.relativePath, taille: file.size, sha: await hashLocalFile(path.join(args[0], file.relativePath)), manifeste: `${file.relativePath}.file.json` }) }
      catch (error) { if (error.code !== 'ENOENT') throw error }
    }
    await writeFile(args.find((arg) => arg.startsWith('--index=')).slice(8), JSON.stringify({ dest: args[1], at: new Date().toISOString(), fiches }))
    return { lastEvent: { ev: 'done', skipped: [], verifyKo: 0 } }
  }
  service.state(project.id).watched = true
  service.scheduleBackup(project.id)
  service.enqueue(project.id, 'check', async () => { order.push('action') })
  for (let pass = 0; pass < 10; pass++) {
    await service.queue
    await Promise.resolve()
    if (!service.pending.size) break
  }
  expect(order).toEqual(['action', 'batch', 'batch'])
  expect(service.snapshot(project.id).sync.pendingCount).toBe(0)
  expect(publishedCounts).toEqual([1, 2])
})

