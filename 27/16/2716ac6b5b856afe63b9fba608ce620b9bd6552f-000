// 21 October 2026: GitHub refused every write on the index repository ("Repository is above its size quota"); the index step then failed at the head
// of every pass and nothing was archived for hours. The archive is the data, the index a convenience: it must never block the bytes.
it('archives the bytes when the search index is refused, keeps its paths, and pauses automatic retries', async () => {
  const { service, project, folder } = await fixture()
  await service.register(project)
  let indexCalls = 0, indexRefused = true
  service.runProcess = async (script, args) => {
    if (script.endsWith('index-add-paths.mjs')) {
      indexCalls++
      if (indexRefused) throw new Error('Repository is above its size quota')
      return { lastEvent: null }
    }
    const snapshot = service.state(project.id).inventory.localFiles
    const fiches = await Promise.all(snapshot.map(async (file) => ({ rel: file.relativePath, taille: file.size,
      sha: await hashLocalFile(path.join(args[0], file.relativePath)), manifeste: `${file.relativePath}.file.json` })).map((p) => p.catch(() => null)))
    const index = args.find((arg) => arg.startsWith('--index=')).slice(8)
    await writeFile(index, JSON.stringify({ dest: args[1], at: new Date().toISOString(), fiches: fiches.filter(Boolean) }))
    return { lastEvent: { ev: 'done', skipped: [], verifyKo: 0 } }
  }
  await service.inventory(project.id)
  service.state(project.id).pendingIndex = ['pages/ZenRayAssets/test-project/sources/tmp/workshop/old.file.json']
  const job = { id: 'automatic-1', background: true }
  await service.archiveNow(project.id, null, job, new AbortController().signal)
  // the bytes are archived and verified although the index was refused
  const backup = service.state(project.id).backups['workshop:scene.hiplc']
  expect(backup.sha256).toBe(await hashLocalFile(path.join(folder, 'scene.hiplc')))
  expect(job.indexError).toContain('size quota')
  expect(service.state(project.id).pendingIndex.length).toBeGreaterThan(0)
  // the pause is on disk: a restarted service reads it instead of paying one more refusal
  const pausedUntil = service.indexBlockedUntil
  expect(pausedUntil).toBeGreaterThan(Date.now())
  service.indexBlockedUntil = 0
  await service.loadIndexPause()
  expect(service.indexBlockedUntil).toBe(pausedUntil)
  expect(indexCalls).toBe(1)                    // one attempt for the whole pass, not one per index point
  // a second automatic pass inside the pause does not touch the refused repository again
  await writeFile(path.join(folder, 'second.txt'), 'second file')
  await service.archiveNow(project.id, null, { id: 'automatic-2', background: true }, new AbortController().signal)
  expect(indexCalls).toBe(1)
  expect(service.state(project.id).backups['workshop:second.txt']).toBeTruthy()
  // once the pause is over and the repository accepts writes, the durable paths are indexed and cleared
  indexRefused = false; service.indexBlockedUntil = 0
  await service.archiveNow(project.id, null, { id: 'automatic-3', background: true }, new AbortController().signal)
  expect(service.state(project.id).pendingIndex).toEqual([])
  await service.setIndexPause(0)
  await service.loadIndexPause()
  expect(service.indexBlockedUntil).toBe(0)
})
