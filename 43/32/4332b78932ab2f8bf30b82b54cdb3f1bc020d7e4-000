// /api/share-cover-tile?d=<token>&p=<path>&s=<size> — ONE decoded, cropped, shrunk tile of a share preview (2 October 2026).
// Internal building block of /api/share-cover: raw RGBA bytes (size x size x 4), so the composing invocation never decodes
// an image. Public like the rest of the share but strictly scoped: the token must be a valid folder share and the path a
// direct `.img.json` child of that folder.
import { resolveShareToken } from './share-token.js'
import { sousLaRacine } from './sansAccent.js'
import { renderTile } from './share-cover.js'

export default async function handler(req, res) {
  const token = process.env.GITHUB_TOKEN
  const rawToken = (req.query.d || '').toString()
  const path = (req.query.p || '').toString().normalize('NFC')
  const size = Number(req.query.s)
  if (process.env.ZR_COVER_DYNAMIC !== '1') return res.status(404).end('') // the tile route only exists with the dynamic composition
  if (!token || !rawToken || !path || ![298, 600].includes(size)) return res.status(404).end('')
  let dir
  try { dir = (await resolveShareToken(rawToken, { expectedKind: 'folder' })).path } catch { return res.status(404).end('') }
  if (!dir || !path.endsWith('.img.json') || !sousLaRacine(path, dir) || path.slice(dir.length + 1).includes('/')) return res.status(404).end('')
  try {
    const codecs = await import('./mosaicCodecs.workers.js').then((m) => m.codecs()).catch(() => null)
    if (!codecs) return res.status(404).end('')
    const tile = await renderTile({ token, path, size, codecs })
    if (!tile) return res.status(404).end('')
    res.setHeader('Content-Type', 'application/octet-stream')
    res.setHeader('Cache-Control', 'no-store')
    return res.status(200).end(Buffer.from(tile.buffer, tile.byteOffset, tile.byteLength))
  } catch { return res.status(404).end('') }
}
