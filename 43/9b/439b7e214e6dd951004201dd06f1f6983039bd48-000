import React, { useState } from 'react'
import { PALETTE, RADII } from '../../theme.js'
import { safeImg } from './safeUrl.js'

// Rendu du custom block `zenrayEmbed` (YouTube V1). REUTILISE la logique de EmbedNodeViewer :
// carte inactive (vignette i.ytimg.com) + iframe youtube-nocookie sandboxée montée SEULEMENT au clic Lire.
// On ne stocke que provider+id+url canonique dans les props du block : JAMAIS d'HTML brut.
const SANS = "var(--zr-police-sans)"
const youtubeNoCookieUrl = (value) => {
  try {
    const url = new URL(String(value || ''))
    return url.protocol === 'https:' && url.hostname === 'www.youtube-nocookie.com' && /^\/embed\/[\w-]{6,20}$/.test(url.pathname) ? url.toString() : null
  } catch { return null }
}

export default function EmbedBlock({ block, theme }) {
  const p = (block && block.props) || {}
  const [playing, setPlaying] = useState(false)
  const dark = theme === 'dark'
  const border = dark ? 'rgba(255,255,255,0.12)' : 'rgba(0,0,0,0.10)'
  const thumb = safeImg(p.thumbnail) || (p.provider === 'youtube' && /^[\w-]{6,20}$/.test(p.providerId || '') ? `https://i.ytimg.com/vi/${p.providerId}/hqdefault.jpg` : null)
  const heading = p.title || 'Vidéo'
  const embedUrl = youtubeNoCookieUrl(p.embedUrl)

  // editor-10 — robustesse : un bloc zenrayEmbed sans embedUrl (donnée corrompue / ancienne version)
  // ne doit PAS disparaître (return null le rendait invisible ET non sélectionnable -> impossible à
  // supprimer pour l'utilisateur, bloc fantôme). On rend un petit placeholder cliquable/sélectionnable.
  if (!embedUrl) {
    return (
      <div contentEditable={false} style={{ fontFamily: SANS, margin: '8px 0', maxWidth: 720, border: `1px dashed ${border}`, borderRadius: RADII.lg, padding: '10px 14px', color: PALETTE.gray600, fontSize: 'var(--zr-ui-md)' }}>
        Embed invalide{p.url ? <> · <a href={p.url} target="_blank" rel="noreferrer" style={{ color: PALETTE.primary, textDecoration: 'none' }}>{p.url}</a></> : null}
      </div>
    )
  }
  return (
    <div style={{ fontFamily: SANS, margin: '8px 0', maxWidth: 720 }} contentEditable={false}>
      <div style={{ background: dark ? '#1a1a1a' : '#FDFDFC', border: `1px solid ${border}`, borderRadius: RADII.lg, overflow: 'hidden' }}>
        <div style={{ position: 'relative', width: '100%', aspectRatio: '16 / 9', background: '#000' }}>
          {playing ? (
            <iframe
              src={embedUrl}
              title={heading}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerPolicy="strict-origin-when-cross-origin"
              sandbox="allow-scripts allow-presentation allow-popups"
              style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', border: 'none' }}
            />
          ) : (
            <button onClick={() => setPlaying(true)} aria-label="Lire la vidéo"
              style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', border: 'none', cursor: 'pointer', padding: 0, background: thumb ? `center/cover no-repeat url("${thumb}")` : '#000' }}>
              <span style={{ position: 'absolute', top: '50%', left: '50%', transform: 'translate(-50%,-50%)', width: 64, height: 64, borderRadius: 99, background: 'rgba(0,0,0,0.55)', display: 'grid', placeItems: 'center' }}>
                <span style={{ borderStyle: 'solid', borderWidth: '12px 0 12px 20px', borderColor: 'transparent transparent transparent #fff', marginLeft: 4 }} />
              </span>
            </button>
          )}
        </div>
        <div style={{ padding: '10px 14px' }}>
          <div style={{ fontSize: 'var(--zr-ui-lg)', fontWeight: 600, color: dark ? '#ECECEA' : '#1F1F1E' }}>{heading}</div>
          <div style={{ fontSize: 'var(--zr-ui-sm)', color: PALETTE.gray600, marginTop: 3 }}>
            {p.provider || 'youtube'} · <a href={p.url} target="_blank" rel="noreferrer" style={{ color: PALETTE.primary, textDecoration: 'none' }}>ouvrir la source</a>
          </div>
        </div>
      </div>
    </div>
  )
}
