// SPORT x PLAN : fonctions pures qui lisent et écrivent la carte « séance du jour » dans un board Plan.
// EN: pure functions only (no fetch, no React), so every rule is unit-tested. One Plan task per day holds the whole session.
// FR : une seule tâche par jour, `sport-<date>`, dont `sport.entries` est la liste structurée et `note` sa lecture humaine.
import { SPORT } from '../config/sport.js'

export const sessionId = (dateIso) => `${SPORT.plan.idPrefix}${dateIso}`
const isSession = (task) => !!(task && task.sport && Array.isArray(task.sport.entries))

export const findSession = (board, dateIso) => (board?.tasks || []).find((task) => task.id === sessionId(dateIso)) || null
export const entriesOf = (board, dateIso) => findSession(board, dateIso)?.sport.entries || []

/** « 4 × 15 · 6 kg » : the unit is always written when there is a weight. */
export const summary = (entry) => `${entry.sets} × ${entry.reps}${entry.kg ? ` · ${entry.kg} kg` : ''}`

/** Human reading of the session, stored in the Plan task note. */
export const renderNote = (entries) => entries.map((e) => `- ${e.at ? `${e.at} ` : ''}${e.name} : ${summary(e)}`).join('\n')

/** Same list for the day note, wrapped between the two markers so it can be rewritten in place. */
export function noteBlock(entries) {
  const { start, end, heading } = SPORT.note
  return `${start}\n${heading}\n${renderNote(entries)}\n${end}`
}

const earliest = (entries) => entries.map((e) => e.at).filter(Boolean).sort()[0] || null

function withEntries(board, dateIso, entries, nowIso) {
  const id = sessionId(dateIso)
  const rest = (board.tasks || []).filter((task) => task.id !== id)
  if (!entries.length) return { ...board, tasks: rest }
  const old = findSession(board, dateIso)
  const task = {
    id, title: SPORT.plan.title, date: dateIso, startTime: earliest(entries), durationMin: SPORT.plan.durationMin,
    status: 'done', note: renderNote(entries), images: old?.images || [], overdueSince: null,
    doneAt: old?.doneAt || nowIso, createdAt: old?.createdAt || nowIso,
    sport: { entries },
  }
  return { ...board, tasks: [...rest, task] }
}

/** Adds or replaces the entry of one exercise (matched by `ex`) in the session of `dateIso`. */
export function upsertEntry(board, dateIso, entry, nowIso = new Date().toISOString()) {
  const entries = entriesOf(board, dateIso)
  const at = entries.find((e) => e.ex === entry.ex)?.at || entry.at || nowIso.slice(11, 16)
  const next = { ...entry, at }
  const merged = entries.some((e) => e.ex === entry.ex) ? entries.map((e) => (e.ex === entry.ex ? next : e)) : [...entries, next]
  return withEntries(board, dateIso, merged, nowIso)
}

/** Removes one exercise; the whole card disappears when it was the last one. */
export function removeEntry(board, dateIso, ex, nowIso = new Date().toISOString()) {
  return withEntries(board, dateIso, entriesOf(board, dateIso).filter((e) => e.ex !== ex), nowIso)
}

/** Most recent performance of an exercise before `beforeIso` (exclusive), for the « last time » hint. */
export function lastPerformance(board, ex, beforeIso = '9999-12-31') {
  let best = null
  for (const task of board?.tasks || []) {
    if (!isSession(task) || task.date >= beforeIso) continue
    const found = task.sport.entries.find((e) => e.ex === ex)
    if (found && (!best || task.date > best.date)) best = { ...found, date: task.date }
  }
  return best
}

/** Active plan path: manual override, then the first pinned plan, then the cached list, then the fallback. */
export function resolvePlanPath({ override, pinned = [], cached = [] } = {}) {
  const ok = (p) => typeof p === 'string' && p.endsWith('.plan.json')
  return [override, ...pinned, ...cached].find(ok) || SPORT.plan.fallbackPath
}
