// Schéma du nœud Ref `.canvas.json` (board PureRef/Miro-like). Source : docs/ref/plan.md §4.3.
//
// Principe central (plan §4.1) : un board ne stocke JAMAIS de binaire, jamais de data URL, jamais de base64.
// Il ne stocke que des RÉFÉRENCES vers des nodes Create (.img.json / .media.json / .embed.json / pages),
// du layout, des annotations, des liens, des métadonnées légères. Les assets restent dans les shards.
//
// `items` est un OBJET indexé par id (PAS un tableau). Raison (plan §4.3) : le merge multi-onglets devient
// trivial — on fusionne item par item via `updatedAt`, sans réordonner ni écraser un tableau entier.

export const CANVAS_SCHEMA = 'zenray.ref.canvas.v1'

// Les types d'items reconnus sur un board (plan §4.3). image/media/audio/embed = références ; le reste = natif tldraw.
export const ITEM_KINDS = [
  'image-ref', 'media-ref', 'audio-ref', 'embed-ref', 'page-ref',
  'text', 'sticky', 'shape', 'arrow', 'frame', 'group', 'comment-pin',
]

// Identifiants courts, lisibles, sans collision pratique. Préfixe pour distinguer board/item/embed dans les logs.
export function newId(prefix = 'item') {
  const rnd = Math.random().toString(36).slice(2, 10)
  const t = Date.now().toString(36)
  return `${prefix}_${t}${rnd}`
}

export const nowIso = () => new Date().toISOString()

// Réglages par défaut d'un board neuf. background dérivé de l'off-white ZenRay (jamais de blanc pur, cf. CLAUDE.md).
export function defaultSettings() {
  return { background: '#FDFDFC', grid: false, snap: 8, unit: 'px' }
}

// Fabrique un board vide conforme au schéma. `projectPath` = chemin du .canvas.json dans zenray-data.
export function makeCanvas({ id, title = 'Board', projectPath = '' } = {}) {
  const t = nowIso()
  return {
    schema: CANVAS_SCHEMA,
    id: id || newId('canvas'),
    title,
    projectPath,
    createdAt: t,
    updatedAt: t,
    settings: defaultSettings(),
    items: {},      // objet indexé par id
    groups: {},
    frames: {},
    links: [],
    comments: {},
    schemaNotes: [],
    // tldraw : snapshot du store (formes natives). Optionnel ; absent sur un board vierge.
    // On conserve EN PLUS les items de référence (assets) dans `items`, qui est notre source de vérité d'assets.
    tldraw: null,
  }
}

// Garde-fou : valide la forme minimale d'un objet board. Renvoie un board normalisé (jamais d'exception).
// Tolérant : un board ancien / partiel est réparé plutôt que rejeté (append-only de la mémoire, on ne perd rien).
export function normalizeCanvas(raw, fallback = {}) {
  const base = makeCanvas(fallback)
  if (!raw || typeof raw !== 'object') return base
  const items = (raw.items && typeof raw.items === 'object' && !Array.isArray(raw.items)) ? raw.items : {}
  return {
    ...base,
    ...raw,
    schema: CANVAS_SCHEMA,
    id: raw.id || base.id,
    title: typeof raw.title === 'string' ? raw.title : base.title,
    projectPath: typeof raw.projectPath === 'string' ? raw.projectPath : base.projectPath,
    createdAt: raw.createdAt || base.createdAt,
    settings: { ...defaultSettings(), ...(raw.settings || {}) },
    items,
    groups: raw.groups && typeof raw.groups === 'object' ? raw.groups : {},
    frames: raw.frames && typeof raw.frames === 'object' ? raw.frames : {},
    links: Array.isArray(raw.links) ? raw.links : [],
    comments: raw.comments && typeof raw.comments === 'object' ? raw.comments : {},
    schemaNotes: Array.isArray(raw.schemaNotes) ? raw.schemaNotes : [],
    tldraw: raw.tldraw || null,
  }
}

// Fabrique un item de référence (image/media/audio/embed/page) avec position/taille/layout par défaut.
export function makeRefItem({ kind, ref, x = 0, y = 0, w = 320, h = 240, meta = {} } = {}) {
  const t = nowIso()
  return {
    id: newId('item'),
    kind,
    ref,
    x, y, w, h,
    rotation: 0,
    z: 0,
    locked: false,
    hidden: false,
    opacity: 1,
    fit: 'contain',
    crop: null,
    style: {},
    meta: { caption: '', tags: [], ...meta },
    updatedAt: t,
  }
}
