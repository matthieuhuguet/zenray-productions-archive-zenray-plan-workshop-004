// WHERE A SHARED IMAGE CAME FROM (2 October 2026). A shared gallery is made of LINKS placed inside the shared
// folder; the image a link stands for lives outside it. Once a link is resolved, every later request for that image
// (manifest, thumbnail, full size, zip) carries `via=<the link>` so the server can prove the visitor reached the
// image through a link that the owner placed inside the share. One map, filled at the single place links are
// resolved, read at the two places share URLs are built.
const viaByCanonical = new Map()

export function rememberSharePlacement(canonicalPath, placementPath) {
  if (canonicalPath && placementPath && canonicalPath !== placementPath) viaByCanonical.set(canonicalPath, placementPath)
}

export const shareViaParam = (canonicalPath) => {
  const via = viaByCanonical.get(canonicalPath)
  return via ? `&via=${encodeURIComponent(via)}` : ''
}

export function shareViaFromUrl(url) {
  const found = /[?&]path=([^&]+)/.exec(String(url))
  if (!found) return ''
  try { return shareViaParam(decodeURIComponent(found[1])) } catch { return '' }
}
