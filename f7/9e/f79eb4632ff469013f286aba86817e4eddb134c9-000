// Contrôles partagés entre les lecteurs vidéo (StreamVideo.jsx, StreamVideoMSE.jsx, VideoPlayer.jsx) :
// menu déroulant piste/qualité/vitesse, formatage de temps, paliers de vitesse. Étaient copiés-collés
// quasi à l'identique dans les 3 fichiers (seule la couleur d'accent variait, rouge legacy vs
// PALETTE.primary) — extraits ici pour n'exister qu'à un seul endroit.
//
// Version canonique retenue : celle de StreamVideoMSE.jsx (PALETTE.primary + Icon "checkmark", pas la
// variante rouge "legacy" ni le "✓" texte brut des deux autres) et le fmt() de VideoPlayer2.jsx (gère les
// heures : `h ? "1:30:15" : "30:15"`) — un vrai correctif pour StreamVideo/StreamVideoMSE/VideoPlayer qui
// affichaient auparavant "125:30" au lieu de "2:05:30" pour toute vidéo de plus d'une heure.
//
// NE COUVRE PAS VideoPlayer2.jsx : son menu de réglages (bouton "settings" unique, sous-menus qualité/
// vitesse dans le MÊME panneau) est une interaction différente, pas une simple variante de style — c'est
// justement ce que le Tick2/Tick3 recommandent de faire converger un jour (fusionner le moteur MSE DANS
// VideoPlayer2, Effort XL, hors périmètre d'un fix rapide).
import React from 'react'
import { PALETTE, RADII, SHADOWS, TRANSITIONS } from '../theme.js'
import Icon from '../components/Icon.jsx'

export const SPEEDS = [0.5, 0.75, 1, 1.25, 1.5, 2, 3]

export const fmt = (s) => {
  if (!isFinite(s) || !s) return '0:00'
  s = Math.max(0, Math.floor(s))
  const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), ss = s % 60
  return h ? `${h}:${String(m).padStart(2, '0')}:${String(ss).padStart(2, '0')}` : `${m}:${String(ss).padStart(2, '0')}`
}

// Crossfade play/pause 0.35s (matériau V9, section "Fast interaction range") partagé entre lecteurs
// vidéo ET players audio : les deux glyphes Apple restent montés, empilés (.zr-pp, fonts.css) ; seul
// opacité/échelle bouge — la taille rendue du bouton ne varie donc jamais entre lecture et pause.
// `playOffset` : décalage optique du triangle play (ex. 3px dans le mini-player vertical du design).
export function PlayPauseGlyph({ playing, size = 24, pauseSize, playOffset = 0 }) {
  return (
    <span className={`zr-pp${playing ? ' is-playing' : ''}`} aria-hidden="true">
      <span className="zr-pp-pause"><Icon name="pause" size={pauseSize ?? size} /></span>
      <span className="zr-pp-play" style={playOffset ? { marginLeft: playOffset } : undefined}><Icon name="play.fill" size={size} /></span>
    </span>
  )
}

export function Menu({ t, items, activeId, onPick }) {
  return (
    <div style={{ position: 'absolute', bottom: 52, right: 8, background: t.surface, border: `1px solid ${t.border}`, borderRadius: RADII.md, boxShadow: SHADOWS.lg, padding: 6, minWidth: 200, zIndex: 30 }}>
      {items.map((it) => { const on = activeId === it.id; return (
        <button key={it.id ?? 'off'} onClick={() => onPick(it.id)} style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', width: '100%', padding: '8px 10px', border: 'none', cursor: 'pointer', borderRadius: RADII.sm, fontSize: 'var(--zr-ui-md)', background: on ? PALETTE.primarySoft : 'transparent', color: on ? PALETTE.primary : t.textPrimary, transition: TRANSITIONS.base }}>
          <span>{it.label}</span>{on && <Icon name="checkmark" size={13} color={PALETTE.primary} />}
        </button>
      )})}
    </div>
  )
}
