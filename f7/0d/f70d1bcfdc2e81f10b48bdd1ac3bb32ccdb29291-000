import test from 'node:test'
import assert from 'node:assert/strict'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'

const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'push-token-'))
process.env.ZR_PUSH_TOKEN_DIR = path.join(dir, 'Token.lock')
const { acquirePushToken } = await import('./push-token.mjs')

test('a second token waits for the first to be released', async () => {
  const order = []
  const first = await acquirePushToken('first')
  const second = acquirePushToken('second').then(async (t) => { order.push('second'); await t.release() })
  await new Promise((r) => setTimeout(r, 600))
  assert.deepEqual(order, [])
  order.push('first')
  await first.release()
  await second
  assert.deepEqual(order, ['first', 'second'])
})

test('release is idempotent and the lock can be taken again', async () => {
  const t = await acquirePushToken('a')
  await t.release(); await t.release()
  const u = await acquirePushToken('b')
  await u.release()
})

test('ZR_PUSH_TOKEN=0 disables the token', async () => {
  process.env.ZR_PUSH_TOKEN = '0'
  const a = await acquirePushToken('x'); const b = await acquirePushToken('y')
  await a.release(); await b.release()
  delete process.env.ZR_PUSH_TOKEN
})
