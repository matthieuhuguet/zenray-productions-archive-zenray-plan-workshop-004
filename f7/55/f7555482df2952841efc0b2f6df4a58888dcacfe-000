import { describe, expect, it } from 'vitest'
import { belongsToPartition, partitionForPath } from './path-partition.mjs'

describe('répartition des chemins', () => {
  it('donne chaque chemin à une seule voie', () => {
    for (const rel of ['a.txt', 'Films/a.mkv', '日本/写真.jpg', 'repack [FitGirl].zip']) {
      const proprietaires = Array.from({ length: 6 }, (_, i) => belongsToPartition(rel, { i, n: 6 })).filter(Boolean)
      expect(proprietaires).toHaveLength(1)
    }
  })

  it('reste déterministe et refuse un nombre de voies invalide', () => {
    expect(partitionForPath('Films/a.mkv', 6)).toBe(partitionForPath('Films/a.mkv', 6))
    expect(() => partitionForPath('a', 0)).toThrow('nombre de tranches invalide')
  })
})
