// 3 October 2026, 15:09 CEST: alternate views retain exact file IDs and navigate source folders without touching disk.
import React, { useState } from 'react'
import Icon from '../Icon.jsx'
import FileLocations from './FileLocations.jsx'
import { assetsFolderFile } from '../../lib/assetsFileLocations.js'
import { readableSize } from '../../lib/assetsProjects.js'
import { extOf } from '../../lib/fileKinds.js'
import { fileDate, fileSizeLabel } from '../../lib/assetsFileQuery.js'

export const FILE_VIEWS = [{ id: 'icons', label: 'Icônes', icon: 'square.grid.2x2' }, { id: 'list', label: 'Liste', icon: 'list.bullet' }, { id: 'columns', label: 'Colonnes', icon: 'rectangle.split.3x1' }, { id: 'gallery', label: 'Galerie', icon: 'photo' }]
const columnKey = file => `${file.namespace || 'cloud'} · ${file.sourceId || 'archive'}`
const pathParts = file => [columnKey(file), ...file.relativePath.split('/').filter(Boolean)]

export default function FilePresentations({ view, files, project, connected, selected, focusedFile, onToggle, onFocus, onPreview, renderImage }) {
  const [trail, setTrail] = useState([])
  const [limit, setLimit] = useState(100)
  const chooseFolder = (depth, name) => { setTrail(previous => [...previous.slice(0, depth), name]); setLimit(100) }
  const tile = file => <div className="assets-file-tile" key={file.id} data-selected={selected.has(file.id)} onClick={event => { if (!event.target.closest('button,input')) onToggle(file, event) }} onDoubleClick={event => { if (!event.target.closest('button,input')) onPreview?.(file) }}>
    <label><input type="checkbox" aria-label={`Sélectionner ${file.name}`} checked={selected.has(file.id)} onChange={event => onToggle(file, event.nativeEvent)} /></label>
    <button type="button" className="assets-tile-image" aria-label={`Aperçu de ${file.name}`} onClick={() => { onFocus(file); onPreview?.(file) }}>{renderImage(file, true)}</button>
    <button type="button" className="assets-file-name-button" onClick={() => onToggle(file)} title={file.relativePath}>{file.name}</button>
    <FileLocations file={file} project={project} connected={connected} />
    <small>{extOf(file.name).toUpperCase() || file.kind} · <span className="assets-number">{Number.isFinite(file.size) ? readableSize(file.size) || '0 Ko' : 'Taille inconnue'}</span></small>
  </div>
  if (view === 'icons') return <div className="assets-icon-grid" aria-label="Vue Icônes">{files.map(tile)}</div>
  if (view === 'gallery') {
    const focus = focusedFile && files.some(file => file.id === focusedFile.id) ? focusedFile : files[0]
    return <section className="assets-gallery" aria-label="Vue Galerie">
      {focus && <div className="assets-gallery-focus"><button type="button" className="assets-gallery-image" aria-label={`Grand aperçu de ${focus.name}`} onClick={() => onPreview?.(focus)}>{renderImage(focus, true)}</button><div><h3>{focus.name}</h3><FileLocations file={focus} project={project} connected={connected} compact={false} /><p>{extOf(focus.name).toUpperCase() || focus.kind} · <span className="assets-number">{Number.isFinite(focus.size) ? readableSize(focus.size) || '0 Ko' : 'Taille inconnue'}</span></p><p className="assets-number">{fileDate(focus) !== null ? new Date(fileDate(focus)).toLocaleString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Date inconnue'}</p></div></div>}
      <div className="assets-gallery-strip">{files.map(tile)}</div>
    </section>
  }
  const currentTrail = []
  for (const folder of trail) {
    const proposed = [...currentTrail, folder]
    if (!files.some(file => proposed.every((part, i) => pathParts(file)[i] === part) && pathParts(file).length > proposed.length)) break
    currentTrail.push(folder)
  }
  return <section className="assets-columns" aria-label="Vue Colonnes">{Array.from({ length: currentTrail.length + 1 }, (_, depth) => {
    const prefix = currentTrail.slice(0, depth), entries = new Map()
    for (const file of files) {
      const parts = pathParts(file)
      if (!prefix.every((part, i) => parts[i] === part) || !parts[depth]) continue
      const folder = depth < parts.length - 1
      const key = folder ? `dir:${parts[depth]}` : file.id
      if (!entries.has(key)) entries.set(key, { name: parts[depth], folder, file, count: 0, files: [] })
      entries.get(key).count++; entries.get(key).files.push(file)
    }
    const list = [...entries.values()].sort((a, b) => Number(b.folder) - Number(a.folder))
    return <div className="assets-browser-column" key={prefix.join('/')}><h4>{depth ? currentTrail[depth - 1] : 'Sources'}</h4>{list.slice(0, limit).map(entry => entry.folder ? <div key={`folder:${entry.name}`}><button type="button" className="assets-column-entry" key={`dir:${entry.name}`} data-selected={currentTrail[depth] === entry.name} onClick={() => chooseFolder(depth, entry.name)}><Icon name="folder" size={17} /><span>{entry.name}</span><small className="assets-number">{entry.count} · {fileSizeLabel(entry.files)}</small><Icon name="chevron.right" size={12} /></button><FileLocations file={assetsFolderFile(entry.files, depth, entry.name)} project={project} connected={connected} /></div> : <div className="assets-column-entry" key={entry.file.id} data-selected={selected.has(entry.file.id)}><input type="checkbox" aria-label={`Sélectionner ${entry.file.name}`} checked={selected.has(entry.file.id)} onChange={event => onToggle(entry.file, event.nativeEvent)} /><button type="button" onClick={event => onToggle(entry.file, event)} onDoubleClick={() => onPreview?.(entry.file)} title={entry.file.relativePath}>{entry.file.name}</button><FileLocations file={entry.file} project={project} connected={connected} />{onPreview && <button type="button" className="assets-icon-button" aria-label={`Aperçu de ${entry.file.name}`} onClick={() => onPreview(entry.file)}><Icon name="eye" size={14} /></button>}</div>)}{list.length > limit && <button type="button" className="assets-button" onClick={() => setLimit(limit + 100)}>Afficher plus</button>}</div>
  })}</section>
}
