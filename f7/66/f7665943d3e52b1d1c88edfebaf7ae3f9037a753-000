import React, { useCallback, useEffect, useState } from 'react'
import Icon from './Icon.jsx'
import { ImgNodeThumb } from './ImageNodeViewer.jsx'
import { typeOfPath } from '../create/node.js'
import { RE_NOEUD } from '../../server/extensionsNoeuds.js'

// Panneau Create ANCRABLE à droite de l'écran (split-view) pour Ref / Audio / Article.
// But : parcourir le drive Create et GLISSER n'importe quel média (image, table, markdown, audio, vidéo)
// vers la vue active. Les items posent le MIME `application/zenray-page` {path,name} déjà compris par
// RefBoardHost (drag interne sans re-upload). Ouvrable/fermable, non invasif (composant autonome).

const SANS = "var(--zr-police-sans)"
// Retrait du suffixe aléatoire de nœud (-<rand>, 6 caractères) UNIQUEMENT s'il vient APRÈS une extension
// de nœud déjà ôtée : on borne à 6 caractères exactement pour ne PAS manger un vrai mot court final
// (ex. « mon-doc-final » garde « final » ; seul un vrai hash de 6 alphanum est retiré).
const pretty = (n) => String(n || '')
  // Source unique : voir server/extensionsNoeuds.js.
  .replace(RE_NOEUD, '')
  .replace(/\.md$/, '')
  .replace(/-[a-z0-9]{6}$/, '')

// Cache RAM léger des listings du dock (forme BRUTE {path,name,type} de /api/page?action=children),
// distinct du dirCache du Finder qui stocke des entries enrichies. But : ne plus afficher un écran vide
// à chaque navigation vers un dossier déjà visité (affichage immédiat de la dernière liste, revalidation en fond).
const _dockCache = new Map()
const DOCK_CACHE_TTL = 5 * 60 * 1000
const DOCK_CACHE_MAX = 64
const dockCacheGet = (dir) => {
  const hit = _dockCache.get(dir)
  if (!hit) return null
  if (Date.now() - hit.at > DOCK_CACHE_TTL) { _dockCache.delete(dir); return null }
  // Map insertion order = LRU order : reinsert a hit at the end.
  _dockCache.delete(dir)
  _dockCache.set(dir, hit)
  return hit.entries
}
const dockCacheSet = (dir, entries) => {
  _dockCache.delete(dir)
  _dockCache.set(dir, { at: Date.now(), entries })
  while (_dockCache.size > DOCK_CACHE_MAX) _dockCache.delete(_dockCache.keys().next().value)
}

export default function CreateDock({ t, open, onClose, onOpenPath }) {
  const tt = t || {}
  const [dir, setDir] = useState('pages')
  const [entries, setEntries] = useState(null)
  const requestSeq = React.useRef(0)
  const load = useCallback((d) => {
    // Stale-while-revalidate : si on connaît déjà ce dossier, on l'affiche tout de suite (pas de spinner) ;
    // sinon on garde null (premier chargement). Dans les deux cas on revalide en fond.
    const cached = dockCacheGet(d)
    setEntries(cached != null ? cached : null)
    const seq = ++requestSeq.current
    const controller = new AbortController()
    fetch(`/api/page?action=children&dir=${encodeURIComponent(d)}`, { cache: 'no-store', signal: controller.signal })
      .then((r) => r.json()).then((j) => {
        if (controller.signal.aborted || seq !== requestSeq.current) return
        const e = Array.isArray(j.entries) ? j.entries : []
        dockCacheSet(d, e)
        setEntries(e)
      })
      .catch((err) => {
        if (controller.signal.aborted || seq !== requestSeq.current) return
        if (!cached && (!err || err.name !== 'AbortError')) setEntries([])
      })
    return () => controller.abort()
  }, [])
  useEffect(() => {
    if (!open) { requestSeq.current += 1; return undefined }
    return load(dir)
  }, [open, dir, load])
  if (!open) return null

  const goUp = () => { if (dir !== 'pages') setDir(dir.split('/').slice(0, -1).join('/') || 'pages') }
  const isDir = (e) => e.type === 'dir'
  const onDragStart = (e, ev) => {
    const path = e.path
    ev.dataTransfer.setData('application/zenray-page', JSON.stringify({ path, name: e.name }))
    ev.dataTransfer.effectAllowed = 'copy'
  }

  return (
    <div style={{ position: 'fixed', top: 52, right: 0, bottom: 0, width: 320, zIndex: 60, background: tt.cardBg || '#fff', borderLeft: `1px solid ${tt.border || 'rgba(0,0,0,0.1)'}`, boxShadow: '-8px 0 30px rgba(0,0,0,0.10)', display: 'flex', flexDirection: 'column', fontFamily: SANS }}>
      <div style={{ display: 'flex', alignItems: 'center', gap: 8, padding: '10px 12px', borderBottom: `1px solid ${tt.border || 'rgba(0,0,0,0.08)'}` }}>
        <button onClick={goUp} disabled={dir === 'pages'} title="Remonter" style={{ background: 'transparent', border: 'none', cursor: dir === 'pages' ? 'default' : 'pointer', color: dir === 'pages' ? tt.textSecondary : tt.textPrimary, opacity: dir === 'pages' ? 0.4 : 1, padding: 2 }}><Icon name="chevron.left" size={15} weight={2} /></button>
        <div style={{ flex: 1, minWidth: 0, fontFamily: SANS, fontSize: 'var(--zr-ui-xs)', color: tt.textSecondary, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{dir.replace(/^pages\/?/, 'Create / ').replace(/\//g, ' / ') || 'Create'}</div>
        <span title="Glisse un média dans la vue" style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-3xs)', color: tt.textSecondary }}>glisser →</span>
        <button onClick={onClose} title="Fermer le panneau" style={{ background: 'transparent', border: 'none', cursor: 'pointer', color: tt.textSecondary, padding: 2 }}><Icon name="xmark" size={14} weight={2} /></button>
      </div>
      <div style={{ flex: 1, overflowY: 'auto', padding: 8 }}>
        {entries === null && <div style={{ color: tt.textSecondary, fontSize: 'var(--zr-ui-sm)', padding: 10 }}>chargement…</div>}
        {entries && entries.length === 0 && <div style={{ color: tt.textSecondary, fontSize: 'var(--zr-ui-sm)', padding: 10 }}>Dossier vide.</div>}
        {entries && entries.map((e) => {
          const folder = isDir(e)
          const ty = folder ? 'folder' : typeOfPath(e.path)
          const isImg = ty === 'image'
          return (
            <div key={e.path} draggable={!folder} onDragStart={folder ? undefined : (ev) => onDragStart(e, ev)}
              onDoubleClick={() => { if (folder) setDir(e.path); else if (onOpenPath) onOpenPath(e.path) }}
              onClick={() => { if (folder) setDir(e.path) }}
              className="zr-treeitem"
              style={{ display: 'flex', alignItems: 'center', gap: 9, padding: '6px 8px', borderRadius: 8, cursor: folder ? 'pointer' : 'grab', color: tt.textPrimary, fontSize: 'var(--zr-ui-md)' }}>
              <span style={{ flex: '0 0 28px', width: 28, height: 28, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
                {folder ? <Icon name="folder" size={20} color="#5E9EFF" /> : isImg ? <ImgNodeThumb path={e.path} size={28} radius={5} /> : <Icon name={ty === 'db' ? 'tablecells' : ty === 'media' ? 'film' : ty === 'canvas' ? 'square.grid.2x2' : ty === 'embed' ? 'play.rectangle' : 'doc.text'} size={18} color={tt.textSecondary} />}
              </span>
              <span style={{ flex: 1, minWidth: 0, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{pretty(e.name)}</span>
            </div>
          )
        })}
      </div>
    </div>
  )
}
