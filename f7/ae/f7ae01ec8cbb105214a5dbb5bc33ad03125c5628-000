import test from 'node:test'
import assert from 'node:assert/strict'
import { detectLanguage, lastCueEnd, timingFits } from './AttachSidecarSubtitles.mjs'

test('French and English text are told apart', () => {
  assert.equal(detectLanguage("Je ne sais pas ce que vous voulez, c'est dans la maison"), 'fre')
  assert.equal(detectLanguage('I do not know what you want, it is in the house and the garden'), 'eng')
})
test('the last cue end is read from an srt', () => {
  assert.equal(lastCueEnd('1\n00:00:01,000 --> 00:00:02,000\na\n\n2\n01:30:00,500 --> 01:30:03,250\nb\n'), 5403.25)
})
test('a subtitle of another release is refused by its timing', () => {
  assert.equal(timingFits(5400, 5460), true)
  assert.equal(timingFits(7200, 5460), false)
  assert.equal(timingFits(1200, 5460), false)
})
