// 7 October 2026: one posting, one key, whichever site relists it. Studio and role with decoration removed (a "Vivier de candidatures"
// prefix, a location tail after "|" or " - ", brackets), so the same job found on an index and on the studio's own board counts once.
// The same algorithm lives in src/lib/freelanceBatch.js for the page; the tests of both use the same cases.
// FR : une annonce, une cle, quel que soit le site qui la republie.
const squash = (text) => String(text || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\([^)]*\)|\[[^\]]*\]/g, ' ').replace(/[^a-z0-9]+/g, ' ').trim()
export const studioToken = (name) => squash(String(name || '').replace(/\(.*?\)/g, ''))
export function postingKey(name, role) {
  const cleaned = String(role || '').replace(/^Vivier de candidatures\s*:\s*/i, '').split('|')[0].replace(/\s-\s.*$/, '')
  return `${studioToken(name)}::${squash(cleaned)}`
}
