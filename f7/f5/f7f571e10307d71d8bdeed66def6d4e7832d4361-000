// 3 October 2026, 15:06 CEST: filters remain shared across every file presentation.
import React from 'react'
import { extOf } from '../../lib/fileKinds.js'
import { FILE_QUERY_DEFAULTS, FILE_KIND_LABELS } from '../../lib/assetsFileQuery.js'

export default function FileFilters({ files, query, onChange }) {
  const set = (key, value) => onChange({ ...query, [key]: value })
  const kinds = [...new Set(files.map(file => file.kind))].sort()
  const extensions = [...new Set(files.map(file => extOf(file.name).toLowerCase() || 'none'))].sort()
  return <div className="assets-query-controls" aria-label="Filtres et tri des fichiers">
    <label>Famille<select aria-label="Famille de fichiers" value={query.kind} onChange={event => set('kind', event.target.value)}><option value="all">Toutes les familles</option>{kinds.map(kind => <option key={kind} value={kind}>{FILE_KIND_LABELS[kind] || kind}</option>)}</select></label>
    <label>Extension<select aria-label="Extension de fichier" value={query.extension} onChange={event => set('extension', event.target.value)}><option value="all">Toutes les extensions</option>{extensions.map(extension => <option key={extension} value={extension}>{extension === 'none' ? 'Sans extension' : `.${extension}`}</option>)}</select></label>
    <label>Trier par<select aria-label="Trier par" value={query.sort} onChange={event => set('sort', event.target.value)}><option value="name">Nom</option><option value="kind">Type</option><option value="date">Date de modification</option><option value="size">Taille</option></select></label>
    <button type="button" className="assets-button" aria-label="Inverser le tri" onClick={() => set('direction', query.direction === 'asc' ? 'desc' : 'asc')}>{query.direction === 'asc' ? '↑ Croissant' : '↓ Décroissant'}</button>
    <details><summary>Filtres précis</summary><div className="assets-query-advanced">
      <label>Recherche<select aria-label="Champ de recherche" value={query.searchScope} onChange={event => set('searchScope', event.target.value)}><option value="all">Nom et chemins</option><option value="name">Nom seulement</option></select></label>
      <label>Modifié à partir du<input aria-label="Date minimale" type="datetime-local" value={query.dateFrom} onChange={event => set('dateFrom', event.target.value)} /></label>
      <label>Modifié jusqu’au<input aria-label="Date maximale" type="datetime-local" value={query.dateTo} onChange={event => set('dateTo', event.target.value)} /></label>
      <label>Taille minimale (octets)<input aria-label="Taille minimale en octets" type="number" min="0" value={query.sizeMin} onChange={event => set('sizeMin', event.target.value)} /></label>
      <label>Taille maximale (octets)<input aria-label="Taille maximale en octets" type="number" min="0" value={query.sizeMax} onChange={event => set('sizeMax', event.target.value)} /></label>
    </div><p className="assets-footnote">Les heures utilisent le fuseau de cet ordinateur. Les fichiers sans date ou taille connue sont exclus d’une plage précise.</p></details>
    <button type="button" className="assets-text-button" onClick={() => onChange({ ...FILE_QUERY_DEFAULTS })}>Réinitialiser le tri et les filtres précis</button>
  </div>
}
