// Pont client <-> /api/page pour les nœuds JSON de Ref (boards .canvas.json, manifests, pages projet).
//
// L'API /api/page accepte déjà n'importe quel `pages/**/*.json` en save/read (cf. server/page.js `safe()`),
// donc un .canvas.json passe SANS modification serveur. Le champ `markdown` transporte la string (ici du JSON).
// La sauvegarde est OPTIMISTE : on envoie le `sha` lu ; si GitHub renvoie 409 -> { error: 'conflict' }.

// Lit un fichier texte. Renvoie { text, sha, missing } (jamais d'exception). missing=true si 404.
export async function readRaw(path) {
  const r = await fetch(`/api/page?action=read&path=${encodeURIComponent(path)}`, { cache: 'no-store' })
    .then((x) => x.json()).catch(() => null)
  if (!r) return { text: '', sha: null, missing: true, error: 'network' }
  return { text: r.markdown || '', sha: r.sha || null, missing: !!r.missing }
}

// Lit un JSON. Renvoie { data, sha, missing }. data=null si absent ou parse impossible.
export async function readJson(path) {
  const { text, sha, missing, error } = await readRaw(path)
  if (missing || !text) return { data: null, sha, missing: true, error }
  try { return { data: JSON.parse(text), sha, missing: false } }
  catch { return { data: null, sha, missing: false, error: 'parse' } }
}

// Sauve un JSON. Renvoie { ok, sha, conflict, error }. Indenté 2 espaces (lisible dans GitHub).
export async function saveJson(path, data, sha) {
  const markdown = JSON.stringify(data, null, 2)
  const r = await fetch('/api/page', {
    method: 'POST', headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ action: 'save', path, markdown, sha: sha || undefined }),
  }).then((x) => x.json()).catch(() => null)
  if (!r) return { ok: false, error: 'network' }
  if (r.error === 'conflict') return { ok: false, conflict: true }
  if (r.error) return { ok: false, error: r.error, detail: r.detail }
  return { ok: true, sha: r.sha }
}

// Sauve un fichier markdown (page projet .md). Même contrat que saveJson.
export async function saveText(path, text, sha) {
  const r = await fetch('/api/page', {
    method: 'POST', headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ action: 'save', path, markdown: text || '', sha: sha || undefined }),
  }).then((x) => x.json()).catch(() => null)
  if (!r) return { ok: false, error: 'network' }
  if (r.error === 'conflict') return { ok: false, conflict: true }
  if (r.error) return { ok: false, error: r.error, detail: r.detail }
  return { ok: true, sha: r.sha }
}

// Enfants directs d'un dossier (Contents API, non récursif, scalable). Renvoie [{ name, path, type }].
export async function listChildren(dir) {
  const r = await fetch(`/api/page?action=children&dir=${encodeURIComponent(dir)}`, { cache: 'no-store' })
    .then((x) => x.json()).catch(() => null)
  return (r && Array.isArray(r.entries)) ? r.entries : []
}
