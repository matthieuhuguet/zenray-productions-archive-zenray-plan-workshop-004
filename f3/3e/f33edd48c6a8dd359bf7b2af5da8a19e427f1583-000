// Recherche catalogue Spotify pour la multi-recherche ZenRay Audio (retour Matthieu 2026-07-16 : "le plus
// important"). Grant "Client Credentials" (app-only, SPOTIFY_CLIENT_ID/SECRET déjà fournis par Matthieu) --
// AUCUNE connexion utilisateur requise, contrairement au flux PKCE navigateur (spotifyAuth.js/spotifyApi.js,
// qui sert lui à la LECTURE/import d'un compte). Un jeton app est mis en cache mémoire (durée de vie réelle
// du token, decompte via son propre `expires_in`) pour ne pas refaire un appel de token à chaque frappe.
const CLIENT_ID = process.env.SPOTIFY_CLIENT_ID || ''
const CLIENT_SECRET = process.env.SPOTIFY_CLIENT_SECRET || ''

let cachedToken = ''
let cachedUntil = 0

async function getAppToken() {
  if (cachedToken && Date.now() < cachedUntil) return cachedToken
  const body = new URLSearchParams({ grant_type: 'client_credentials' })
  const r = await fetch('https://accounts.spotify.com/api/token', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/x-www-form-urlencoded',
      Authorization: 'Basic ' + Buffer.from(`${CLIENT_ID}:${CLIENT_SECRET}`).toString('base64'),
    },
    body,
  })
  if (!r.ok) throw new Error(`spotify-token: HTTP ${r.status}`)
  const json = await r.json()
  cachedToken = json.access_token
  // Marge de 60s avant l'expiration réelle pour ne jamais présenter un jeton pile expiré.
  cachedUntil = Date.now() + Math.max(0, (json.expires_in || 0) - 60) * 1000
  return cachedToken
}

export default async function handler(req, res) {
  const q = ((req.query && req.query.q) || '').toString().trim()
  if (!q) return res.status(200).json({ ok: false, error: 'no-query', tracks: { items: [] } })
  if (!CLIENT_ID || !CLIENT_SECRET) {
    return res.status(200).json({ ok: false, error: 'not-configured', tracks: { items: [] } })
  }
  try {
    const token = await getAppToken()
    const r = await fetch(`https://api.spotify.com/v1/search?type=track&limit=20&q=${encodeURIComponent(q)}`, {
      headers: { Authorization: 'Bearer ' + token },
    })
    if (!r.ok) return res.status(200).json({ ok: false, error: `spotify-search-${r.status}`, tracks: { items: [] } })
    const json = await r.json()
    res.setHeader('Cache-Control', 'public, max-age=60')
    return res.status(200).json({ ok: true, tracks: json.tracks || { items: [] } })
  } catch (e) {
    return res.status(200).json({ ok: false, error: e && e.message, tracks: { items: [] } })
  }
}
