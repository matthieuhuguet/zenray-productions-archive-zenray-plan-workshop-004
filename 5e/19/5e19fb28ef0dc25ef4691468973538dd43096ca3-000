// Génère 2 sous-titres VTT LOREM IPSUM pour tester le sélecteur CC (OCR osef), les pousse dans zenray-content
// aux chemins déjà référencés par le manifeste d'Initial D, et relabellise les pistes.
// Usage : GITHUB_TOKEN=$(gh auth token) node scripts/dummy-subs.mjs
import { writeFile, mkdir, readFile } from 'node:fs/promises'
import { execFileSync } from 'node:child_process'
import path from 'node:path'

const OWNER = 'matthieuhuguet', TOKEN = process.env.GITHUB_TOKEN
const WORK = '/tmp/zr_dummysubs'
const MANIFEST = 'pages/Videos/Initial D S01E01.mp4.media.json'
const remote = `https://x-access-token:${TOKEN}@github.com/${OWNER}/zenray-content.git`
const git = (...a) => execFileSync('git', ['-C', WORK, ...a], { stdio: ['ignore', 'pipe', 'pipe'] })
const sec = (s) => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(Math.floor(s % 60)).padStart(2, '0')}.000`

const LOREM = ['Lorem ipsum dolor sit amet.', 'Consectetur adipiscing elit, sed do.', 'Eiusmod tempor incididunt ut labore.', 'Ut enim ad minim veniam.', 'Quis nostrud exercitation ullamco.', 'Duis aute irure dolor in reprehenderit.', 'Excepteur sint occaecat cupidatat.', 'Sunt in culpa qui officia deserunt.', 'Sed ut perspiciatis unde omnis.', 'Nemo enim ipsam voluptatem quia.']
function vtt(prefix, n = 120, step = 5) {
  let out = 'WEBVTT\n\n'
  for (let i = 0; i < n; i++) out += `${sec(i * step)} --> ${sec(i * step + step - 0.5)}\n${prefix} ${i + 1} — ${LOREM[i % LOREM.length]}\n\n`
  return out
}

execFileSync('rm', ['-rf', WORK]); await mkdir(WORK, { recursive: true })
execFileSync('git', ['clone', '--depth', '1', '--filter=blob:none', remote, WORK], { stdio: ['ignore', 'pipe', 'pipe'] })
git('config', 'user.email', 'test@zenray'); git('config', 'user.name', 'zenray-test')

const m = JSON.parse(await readFile(path.join(WORK, MANIFEST), 'utf8'))
const labels = ['Français (test)', 'English (test)']
for (let i = 0; i < m.probe.subs.length; i++) {
  const rel = m.probe.subs[i].path
  await mkdir(path.dirname(path.join(WORK, rel)), { recursive: true })
  await writeFile(path.join(WORK, rel), vtt(i === 0 ? 'FR' : 'EN'))
  m.probe.subs[i].label = labels[i] || `Sous-titres ${i + 1}`
  m.probe.subs[i].lang = i === 0 ? 'fre' : 'eng'
}
await writeFile(path.join(WORK, MANIFEST), JSON.stringify(m, null, 2))
git('add', '-A'); git('commit', '-q', '-m', 'subs lorem ipsum (test CC)'); git('push', '-q', 'origin', 'HEAD:main')
console.log('lorem VTT poussés + manifeste relabellisé:', m.probe.subs.map((s) => s.label).join(', '))
