    res = subprocess.run(cmd, cwd=REPO, env=env, capture_output=True, text=True)
    if res.returncode == 0:
        log(f"  ✓ Copie identique dechargee: {dup_path.name}")
    else:
        log(f"  ⚠ Echec unload copie identique {dup_path.name}: {(res.stderr or res.stdout).strip()[:240]}")


class WindowGate:
    """Admission of films that are not unloaded yet: bounded by a count AND by the bytes they hold on the local disk.
    A film always gets in when nothing else is in flight (a 19 GiB film must be able to run alone)."""

    def __init__(self, slots, budget_bytes):
        self.cv = threading.Condition()
        self.slots, self.budget, self.count, self.bytes = slots, budget_bytes, 0, 0

    def acquire(self, need, timeout=5):
        with self.cv:
            deadline = time.monotonic() + timeout
            while not (self.count < self.slots and (self.count == 0 or self.bytes + need <= self.budget)):
                left = deadline - time.monotonic()
                if left <= 0:
                    return False
                self.cv.wait(left)
            self.count += 1
            self.bytes += need
            return True

    def release(self, need):
        with self.cv:
            self.count -= 1
            self.bytes -= need
            self.cv.notify_all()


INDEX_SPOOL = Path(os.path.expanduser('~/.zr-archive-work-mapped/IndexAddSpool.txt'))
INDEX_FLUSH_LOCK = threading.Lock()


def flush_index_spool(env, minimum=1):
    """One index-add for every path spooled by the uploads (REST: a few content-creating requests instead of 4 per film).
    The spool is taken by an atomic rename: an upload appending meanwhile writes a fresh file, nothing is lost (12 October 2026).
    FR : le fichier d'attente est pris par un renommage atomique ; un envoi qui ajoute pendant ce temps ecrit un nouveau fichier."""
    with INDEX_FLUSH_LOCK:
        batch = INDEX_SPOOL.with_suffix('.flushing.txt')
        taken = INDEX_SPOOL.with_suffix('.taken.txt')
        try:
            if INDEX_SPOOL.exists() and not taken.exists():
                INDEX_SPOOL.replace(taken)
            if taken.exists():
                with batch.open('a', encoding='utf-8') as out:
                    out.write(taken.read_text())
                taken.unlink()
            lines = [line.strip() for line in batch.read_text().splitlines() if line.strip()] if batch.exists() else []
        except Exception:
            return
        unique = sorted(set(lines))
        if not unique or len(lines) < minimum:
            return
        listing = batch.with_suffix('.list.txt')
        listing.write_text('\n'.join(unique) + '\n')
        res = subprocess.run(['node', str(REPO / 'scripts/index-add-paths.mjs'), str(listing)], cwd=REPO, env=env, capture_output=True, text=True)
        listing.unlink(missing_ok=True)
        if res.returncode == 0:
            batch.unlink(missing_ok=True)
            log(f"  Index de recherche: {len(unique)} chemin(s) ajoute(s) en un seul lot")
        else:
            log(f"  ⚠ Index de recherche non mis a jour (sera retente): {(res.stderr or res.stdout).strip()[-160:]}")


def ensure_manifest_online(abs_manifest, name):
    """The local original is deleted only if the manifest that describes its cloud copy is ONLINE (origin/main), byte for byte.
    At 07:27 Black Panther 2018 was unloaded while its three manifest commits had never been pushed (12 October 2026).
    FR : l'original ne part que si son manifeste est en ligne, octet pour octet ; sinon on pousse, puis on leve une erreur."""
    rel = os.path.relpath(os.path.realpath(abs_manifest), os.path.realpath(CLONE))
    for attempt in range(1, 4):
        with clone_lock(f'manifest online check {name}'):
            subprocess.run(['git', '-C', str(CLONE), 'fetch', '-q', 'origin', 'main'], capture_output=True, text=True)
            remote = subprocess.run(['git', '-C', str(CLONE), 'rev-parse', f'origin/main:{rel}'], capture_output=True, text=True)
            local = subprocess.run(['git', '-C', str(CLONE), 'hash-object', str(abs_manifest)], capture_output=True, text=True)
            if remote.returncode == 0 and local.returncode == 0 and remote.stdout.strip() == local.stdout.strip():
                return
            subprocess.run(['git', '-C', str(CLONE), 'pull', '--rebase', '-q', 'origin', 'main'], capture_output=True, text=True)
            subprocess.run(['git', '-C', str(CLONE), 'push', '-q', 'origin', 'HEAD:main'], capture_output=True, text=True)
        time.sleep(5 * attempt)
    raise RuntimeError(f"manifest of {name} is not online (origin/main differs from the local file): the original stays on disk")


def throttle_pause(throttled, text=''):
    """Wait before retrying a throttled GitHub write: the ladder 60, 120, 240, 300 s (capped at 5 minutes, the blocks measured on
    12 October 2026 lasted 15 to 30 minutes) unless GitHub names a longer delay in retry-after. FR : echelle plafonnee a 5 minutes."""
    ladder = min(300, 60 * 2 ** (max(1, throttled) - 1))
    match = re.search(r'retry-after=(\d+)s', text or '')
    return max(ladder, int(match.group(1)) + 5) if match else ladder


def task_need(task):
    # worst case on the local disk while the film is in flight: the source, plus the filtered copy for the subtitle-filtered films
    return int(task.get('sizeBytes') or 0) * (2 if task.get('kind') == 'filtered' else 1)


