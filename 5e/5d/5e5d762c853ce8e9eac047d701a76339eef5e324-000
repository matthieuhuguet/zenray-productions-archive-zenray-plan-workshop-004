# 12 October 2026: ONE Git writer at a time on the shared manifest clone. The archive upload of film N+1 now runs while film N is
# packaged and its subtitles are committed, so every writer (Node scripts and this worker) takes the same directory lock
# <clone>.lock/owner.json that scripts/lib/clone-lock.mjs uses.
# FR : un seul ecrivain Git a la fois sur le clone ; meme protocole sur disque que le verrou Node.
import contextlib
import uuid


def _pid_alive(pid):
    try:
        os.kill(int(pid), 0)
    except (ProcessLookupError, ValueError, TypeError):
        return False
    except PermissionError:
        return True
    return True


@contextlib.contextmanager
def clone_lock(label, wait_s=3600, poll_s=0.25):
    lock_dir = os.path.realpath(str(CLONE)).rstrip('/') + '.lock'
    owner_path = os.path.join(lock_dir, 'owner.json')
    token = f'{os.getpid()}-{uuid.uuid4()}'
    started = time.monotonic()
    while True:
        try:
            os.mkdir(lock_dir)
            with open(owner_path, 'w') as handle:
                json.dump({'pid': os.getpid(), 'token': token, 'at': datetime.now().astimezone().isoformat(), 'label': label}, handle)
            break
        except FileExistsError:
            try:
                owner = json.load(open(owner_path))
                alive = _pid_alive(owner.get('pid'))
            except Exception:
                # directory exists but owner.json is not written yet (or is broken): give it 15 minutes
                try:
                    alive = (time.time() - os.path.getmtime(lock_dir)) < 900
                except FileNotFoundError:
                    continue
            if not alive:
                stale = f'{lock_dir}.stale-{token}'
                try:
                    os.rename(lock_dir, stale)
                    shutil.rmtree(stale, ignore_errors=True)
                except FileNotFoundError:
                    pass
                continue
            if time.monotonic() - started > wait_s:
                raise TimeoutError(f'{label}: clone lock held for more than {wait_s} s')
            time.sleep(poll_s)
    try:
        yield
    finally:
        try:
            if json.load(open(owner_path)).get('token') == token:
                shutil.rmtree(lock_dir, ignore_errors=True)
        except Exception:
            pass


# 12 October 2026: GitHub answers "403 You have exceeded a secondary rate limit ... temporarily blocked from content creation"
# when repos are created or pushed too fast (also by OTHER jobs of the same account). That is not a failure of the film: the
# worker must wait, with a growing pause, and retry the SAME film, instead of burning 4 attempts and abandoning the whole queue
# in a few minutes (what happened at 01:46 on 12 October 2026).
# FR : un 403 "secondary rate limit" n'est pas une erreur du film : on attend (pause croissante) et on reessaie le MEME film.
import re


class GitHubThrottled(Exception):
    pass


THROTTLE_PATTERN = re.compile(r'HTTP 403|secondary rate limit|temporarily blocked|abuse detection|HTTP 429')


def run_step(cmd, **kwargs):
    """subprocess.run(check=True) that recognises a GitHub throttle in the output and raises GitHubThrottled."""
    res = subprocess.run(cmd, capture_output=True, text=True, **kwargs)
    if res.stdout:
        sys.stdout.write(res.stdout[-6000:])
    if res.stderr:
        sys.stderr.write(res.stderr[-3000:])
    if res.returncode != 0:
        blob = (res.stdout or '') + '\n' + (res.stderr or '')
        if THROTTLE_PATTERN.search(blob):
            raise GitHubThrottled(blob.strip()[-400:])
        raise subprocess.CalledProcessError(res.returncode, cmd, res.stdout, res.stderr)
    return res


