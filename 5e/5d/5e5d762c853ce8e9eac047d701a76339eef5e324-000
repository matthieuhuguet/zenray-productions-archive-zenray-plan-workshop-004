def resolve_dest(name, declared=None):
    """Destination folder of a film, decided from the known-works table BEFORE any upload (14 October 2026).
    A declared destination already inside <base>/<Category> is kept. A legacy or flat declaration is replaced by the table.
    Returns None when the work is unknown: the caller must ask Matthieu, then add the work to WorkCategories.json.
    FR : dossier decide avant l'envoi depuis la table des oeuvres ; None = oeuvre inconnue, demander puis ajouter au JSON."""
    base = CATEGORY_TABLE['base']
    if declared and declared.startswith(base + '/'):
        head = declared[len(base) + 1:].split('/', 1)[0]
        if head in CATEGORY_TABLE['categories']:
            return declared
    return WORK_CATEGORIES.full_destination(name, CATEGORY_TABLE)


def canonical_dest(dest):
    """Folder case taken from the manifest clone. APFS ignores case and git does not: a destination spelled "House of the Dragon"
    next to the tracked "House Of The Dragon" broke the commit of film S03E07 and deleted its manifest (12 October 2026).
    FR : chaque dossier prend la casse du dossier deja present dans le clone des manifestes."""
    current = CLONE
    fixed = []
    for part in Path(dest).parts:
        match = part
        if current.is_dir():
            for entry in current.iterdir():
                if entry.is_dir() and entry.name.casefold() == part.casefold():
                    match = entry.name
                    break
        fixed.append(match)
        current = current / match
    return str(Path(*fixed))


def build_queues():
    # 14 October 2026: ZR_ONLY_PLAN=<plan.json> runs the FULL pipeline (archive, CMAF, subtitles, proof, unload) on that plan only,
    # without the historical inventory. FR : ZR_ONLY_PLAN lance le pipeline complet sur ce seul plan.
    only_plan = os.environ.get('ZR_ONLY_PLAN')
    if only_plan:
        inventory = {}
        ready_list = json.loads(Path(only_plan).read_text())
        filtered_list = []
        dup_list = []
    else:
        inventory = {x['source']: x for x in json.loads((BASE / 'Inventory.json').read_text())}
        ready_list = json.loads((BASE / 'ReadyUploadPlan.json').read_text())
        filtered_list = json.loads((BASE / 'FullFilteredQueue.json').read_text())
        dup_list = json.loads((BASE / 'DuplicateProof.json').read_text())

    ready_by_src = {x['src']: x for x in ready_list}
    filtered_by_src = {x['source']: x for x in filtered_list}

    duplicates_of = {}
    for item in dup_list:
        members = [item['source']] + item['identicalCopies']
        admitted = [p for p in members if p in ready_by_src or p in filtered_by_src]
        if len(admitted) == 1:
            adm = admitted[0]
            duplicates_of[adm] = [m for m in members if m != adm]

    tasks = []
    needs_category = []
    for src, item in ready_by_src.items():
        name = item['name']
        decided = resolve_dest(name, item.get('dest'))
        if decided is None:
            needs_category.append({'source': src, 'name': name, 'ask': NEEDS_CATEGORY_QUESTION})
            continue
        dest = canonical_dest(decided)
        rel_manifest = f"{dest}/{Path(name).stem}{Path(src).suffix.lower()}.media.json"
        abs_manifest = CLONE / rel_manifest
        size_bytes = int(inventory.get(src, {}).get('sizeBytes') or (Path(src).stat().st_size if Path(src).exists() else 0))
        tasks.append({
            'kind': 'ready',
            'source': src,
            'name': name,
            'dest': dest,
            'relManifest': rel_manifest,
            'absManifest': abs_manifest,
            'sizeBytes': size_bytes,
            'onDriveAlready': abs_manifest.exists(),
            'duplicates': duplicates_of.get(src, []),
            'languageMap': None,
            # 14 October 2026: "cmaf": false in the plan is an EXPLICIT choice of Matthieu (archive only, no streaming); the default is CMAF.
            # FR : "cmaf": false dans le plan est un choix explicite ; par defaut, CMAF.
            'cmaf': item.get('cmaf', True) is not False,
            # 14 October 2026 (policy streaming only): "mode" is "stream" (default) or "archive" (explicit, ONE of the two, never both by
            # default); "unload": false keeps the source on disk (tests). FR : mode "stream" par defaut ou "archive" explicite ; unload:false garde la source.
            'mode': item.get('mode'),
            'unload': item.get('unload', True) is not False,
        })

    for src, item in filtered_by_src.items():
        p = Path(src)
        name = p.name
        decided = resolve_dest(name)
        if decided is None:
            needs_category.append({'source': src, 'name': name, 'ask': NEEDS_CATEGORY_QUESTION})
            continue
        dest = canonical_dest(decided)
        rel_manifest = f"{dest}/{p.stem}{p.suffix.lower()}.media.json"
        abs_manifest = CLONE / rel_manifest
        size_bytes = int(inventory.get(src, {}).get('sizeBytes') or (p.stat().st_size if p.exists() else 0))
        tasks.append({
            'kind': 'filtered',
            'source': src,
            'name': name,
            'dest': dest,
            'relManifest': rel_manifest,
            'absManifest': abs_manifest,
            'sizeBytes': size_bytes,
            'onDriveAlready': abs_manifest.exists(),
            'duplicates': duplicates_of.get(src, []),
            'languageMap': item.get('languageMap'),
            'mode': None,
            'unload': True,
        })

    if needs_category:
        NEEDS_CATEGORY_FILE.write_text(json.dumps(needs_category, ensure_ascii=False, indent=2), encoding='utf-8')
        log(f'NEEDS CATEGORY AND MODE: {len(needs_category)} file(s) not uploaded, work unknown, ask Matthieu (see {NEEDS_CATEGORY_FILE}): '
            + ', '.join(x['name'] for x in needs_category))
    elif NEEDS_CATEGORY_FILE.exists():
        NEEDS_CATEGORY_FILE.unlink()

    # Priorite 1 : films deja presents sur le Drive (plus petits d'abord pour liberer vite), puis le reste par taille croissante (10 October 2026)
    # 12 October 2026: ZR_QUEUE_ORDER = small-first (default, frees disk quickly) or large-first. The film sent last carries its whole
    # packaging and read-back tail alone, so with a long queue of big films the largest ones go first and their tails sit under the
    # uploads of the others. Films whose archive is already on the Drive always come first (only packaging and proof are left).
    # FR : le dernier film envoye porte seul sa queue (empaquetage, relecture) ; les plus gros partent donc en premier.
    large_first = os.environ.get('ZR_QUEUE_ORDER', 'small-first') == 'large-first'
    tasks.sort(key=lambda t: (0 if t['onDriveAlready'] else 1,
                              -t['sizeBytes'] if (large_first and not t['onDriveAlready']) else t['sizeBytes'], t['name']))
    return tasks


def unload_duplicate_if_present(dup_path_str, base_receipt_path, abs_manifest, env):
    dup_path = Path(dup_path_str)
    if not dup_path.exists():
        return
    dup_hash_id = hashlib.sha1(dup_path_str.encode('utf-8')).hexdigest()[:12]
    dup_receipt_path = RECOVERY_DIR / f"{dup_path.name}.{dup_hash_id}.dup.recovery.json"
    base_receipt = json.loads(base_receipt_path.read_text())
    dup_receipt = dict(base_receipt)
    dup_receipt['source'] = str(dup_path.resolve())
    dup_receipt['sourceStat'] = stat_record(dup_path)
    dup_receipt['identicalToManifest'] = True
    if 'filteredSourceStat' in dup_receipt:
        dup_receipt['filteredSourceStat'] = stat_record(dup_path)
    dup_receipt_path.write_text(json.dumps(dup_receipt, indent=2) + '\n')

    cmd = [
        'node',
        str(REPO / 'scripts/UnloadVideoCloud.mjs'),
        str(dup_receipt_path),
        str(ROOT),
        str(UNLOAD_DIR),
