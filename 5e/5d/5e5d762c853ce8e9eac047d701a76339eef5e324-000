def sha256_file(path_obj):
    h = hashlib.sha256()
    with path_obj.open('rb') as f:
        while True:
            chunk = f.read(4 * 1024 * 1024)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


def stat_record(path_obj):
    st = path_obj.stat()
    return {
        'bytes': st.st_size,
        'mtimeMs': st.st_mtime * 1000.0,
        'inode': st.st_ino,
        'device': st.st_dev,
        'mode': st.st_mode,
    }


