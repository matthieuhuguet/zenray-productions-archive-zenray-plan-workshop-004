def restore_tracked_changes(clone):
    """Tracked files deleted or modified in the working tree go back to HEAD; untracked and staged files are left alone."""
    raw = subprocess.run(['git', '-C', str(clone), 'status', '--porcelain', '-z'], capture_output=True, text=True).stdout
    restored = []
    for entry in raw.split('\0'):
        if len(entry) > 3 and entry[0] == ' ' and entry[1] in ('D', 'M'):
            res = subprocess.run(['git', '-C', str(clone), 'checkout', '--', entry[3:]], capture_output=True, text=True)
            if res.returncode == 0:
                restored.append(entry[3:])
    return restored


