import { describe, expect, it } from 'vitest'
import { cleanMediaName, isCleanMediaName, parseMediaName, proposedFolder } from './clean-media-name.mjs'

describe('clean media names', () => {
  it('cleans the two examples of Matthieu', () => {
    expect(cleanMediaName('Under.the.Open.Sky.2020.FR.mkv')).toBe('Under The Open Sky.mkv')
    expect(cleanMediaName('Akane-banashi S01E12 VOSTFR 1080p WEB x264 AAC -Tsundere-Raws (ADN).mkv')).toBe('Akane Banashi S01E12.mkv')
  })
  it('drops groups, hashes, codecs and release tags', () => {
    expect(cleanMediaName('[DKB] Nippon Sangoku - S01E09 [1080p][HEVC x265 10bit][Dual-Audio][Multi-Subs][CF7B08E7].mkv')).toBe('Nippon Sangoku S01E09.mkv')
    expect(cleanMediaName('Witch Hat Atelier S01E09 MULTi AD 1080p CR WEB-DL AAC2.0 x264-Tsundere-Raws.mkv')).toBe('Witch Hat Atelier S01E09.mkv')
    expect(cleanMediaName('The Dark Knight (2008) 2160p HDR10.mkv')).toBe('The Dark Knight (2008).mkv')
  })
  it('keeps a parenthesis that says what the file is (an excerpt)', () => {
    expect(cleanMediaName('Hors Normes (2019) (Extrait 5 min).mp4')).toBe('Hors Normes (2019) (Extrait 5 min).mp4')
  })
  it('is stable on the (2) that the collision step adds', () => {
    expect(cleanMediaName('Bleach S17E43 (2).mkv')).toBe('Bleach S17E43 (2).mkv')
    expect(isCleanMediaName('Bleach S17E43 (2).mkv')).toBe(true)
  })
  it('keeps a bare episode number and flags it for review', () => {
    const parts = parseMediaName('Mushishi (2005) - 13 MULTI BDrip 1080p FLAC x265-GundamGuy.mkv')
    expect(cleanMediaName('Mushishi (2005) - 13 MULTI BDrip 1080p FLAC x265-GundamGuy.mkv')).toBe('Mushishi - 13.mkv')
    expect(parts.reasons).toContain('episode_without_season')
  })
  it('proposes Title/Saison NN for series and nothing for films', () => {
    expect(proposedFolder(parseMediaName('Akane-banashi S01E12 VOSTFR.mkv'))).toBe('Akane Banashi/Saison 01')
    expect(proposedFolder(parseMediaName('Under.the.Open.Sky.2020.FR.mkv'))).toBe('')
  })
  it('is idempotent: a clean name stays clean', () => {
    for (const name of ['Under The Open Sky.mkv', 'Under The Open Sky (2020).mkv', 'Akane Banashi S01E12.mkv', 'Hors Normes.mp4', 'Initial D S01E15.mkv']) {
      expect(cleanMediaName(name)).toBe(name)
      expect(isCleanMediaName(name)).toBe(true)
    }
    expect(isCleanMediaName('Under.the.Open.Sky.2020.FR.mkv')).toBe(false)
  })
})
