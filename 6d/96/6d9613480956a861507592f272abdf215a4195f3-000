import React, { useEffect, useState } from 'react'
import { usePlayer } from './PlayerContext.jsx'
import MiniPlayerCard from './MiniPlayerCard.jsx'
import { useSidebarRect } from '../lib/useSidebarRect.js'

// C65, mini-player GLOBAL flottant, visible sur tous les onglets SAUF ZenRay Audio (qui a son propre
// footer horizontal -- cf. body.zr-music-open dans ZenRayAudioWorkspace.css). Retour Matthieu 2026-07-18 :
// hors ZenRay Audio, le mini-player est TOUJOURS la carte verticale compacte -- jamais la barre horizontale
// large (un aller-retour horizontal/vertical avait été ajouté par erreur ici, source du bug "la barre
// horizontale apparaît hors ZenRay Audio", supprimé). Le rendu réel vit dans MiniPlayerCard.jsx, PARTAGÉ
// avec le footer de ZenRay Audio.
// Détecte le thème courant en observant la présence de .zr-dark dans le DOM (toggle géré par l'app).
function useIsDark() {
  const [dark, setDark] = useState(() => typeof document !== 'undefined' && !!document.querySelector('.zr-dark'))
  useEffect(() => {
    const update = () => setDark(!!document.querySelector('.zr-dark'))
    update()
    const obs = new MutationObserver(update)
    obs.observe(document.body, { attributes: true, subtree: true, attributeFilter: ['class'] })
    return () => obs.disconnect()
  }, [])
  return dark
}

// Ancrage : flush avec le bord gauche ET LA LARGEUR de la SIDEBAR, juste SOUS elle (retour Matthieu
// 2026-07-18/19, schéma fourni) -- jamais superposé à ses items de nav, jamais dans le vide entre
// sidebar et scène, jamais une largeur fixe qui désaligne le bord droit (pochette + carte doivent
// occuper EXACTEMENT le même x que la sidebar, dynamique, pas un 230px codé en dur).
// La MESURE de la barre est partie dans `useSidebarRect` le 2026-08-27, quand la pastille du minuteur
// s'est mise à en avoir besoin elle aussi. Le calcul d'ancrage, lui, reste ici : il est propre au
// lecteur, qui se pose sous la barre là où la pastille se pose à sa droite.
function useSidebarAnchor() {
  const r = useSidebarRect()
  return r ? { left: Math.max(8, r.left), top: r.bottom + 12, width: r.width } : null
}

export default function PlayerBar({ onOpenAudio, onOpenArtist }) {
  const p = usePlayer()
  const dark = useIsDark()
  const anchor = useSidebarAnchor()
  if (!p || !p.current) return null

  return (
    <div className="zr-global-player" style={{
      position: 'fixed',
      left: anchor?.left ?? 'max(16px, env(safe-area-inset-left))',
      top: anchor?.top ?? undefined,
      bottom: anchor ? 'auto' : 'max(16px, env(safe-area-inset-bottom))',
      zIndex: 120,
      width: anchor?.width ?? 230,
    }}>
      <MiniPlayerCard dark={dark} mode="vertical" width={anchor?.width ?? 230} onOpenAudio={onOpenAudio} onOpenArtist={onOpenArtist} />
    </div>
  )
}
