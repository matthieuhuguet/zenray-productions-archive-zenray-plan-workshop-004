// 5 October 2026: own searches turn into boards, keywords and links without touching the base config.
import { describe, it, expect } from 'vitest'
import { applySearches, classifySearch } from './lib/MySearches.mjs'
import config from './FreelanceConfig.json'

describe('own searches', () => {
  it('recognises the board families and leaves other addresses as links', () => {
    expect(classifySearch({ url: 'https://boards.greenhouse.io/acme/jobs/12' })).toMatchObject({ mode: 'board', type: 'greenhouse', board: 'acme' })
    expect(classifySearch({ url: 'https://jobs.lever.co/studio-x' })).toMatchObject({ mode: 'board', type: 'lever', board: 'studio-x' })
    expect(classifySearch({ url: 'https://acme.recruitee.com/' })).toMatchObject({ mode: 'board', type: 'recruitee', board: 'acme' })
    expect(classifySearch({ url: 'https://www.studio-x.com/careers' })).toMatchObject({ mode: 'index' })
    expect(classifySearch({ url: 'https://localhost/careers' })).toMatchObject({ mode: 'link' })
    expect(classifySearch({ url: 'https://10.0.0.5/jobs' })).toMatchObject({ mode: 'link' })
    expect(classifySearch({ kind: 'keywords', keywords: ' houdini ' })).toEqual({ mode: 'keywords', query: 'houdini' })
    expect(classifySearch({ url: 'javascript:alert(1)' }).mode).toBe('invalid')
    expect(classifySearch({ kind: 'keywords', keywords: '  ' }).mode).toBe('invalid')
  })
  it('adds them on top of a copy, skips removed ones, never mutates the base', () => {
    const before = JSON.stringify(config.sources)
    const out = applySearches(config, { searches: [
      { id: 'a', url: 'https://boards.greenhouse.io/acme', label: 'Acme' },
      { id: 'b', kind: 'keywords', keywords: 'shader artist' },
      { id: 'c', url: 'https://www.studio-x.com/careers', label: 'Example' },
      { id: 'd', url: 'https://jobs.lever.co/gone', removedAt: '2026-10-05' },
    ] })
    expect(out.config.sources.greenhouse.boards.acme).toBe('Acme')
    expect(out.config.sources.lever.boards.gone).toBeUndefined()
    expect(out.config.sources.gamesindustry.queries).toContain('shader artist')
    expect(out.links.map((l) => l.label)).toEqual(['shader artist (LinkedIn)', 'Example'])
    expect(out.status.map((s) => s.mode)).toEqual(['board', 'keywords', 'index'])
    expect(out.indexPages.map((p) => p.url)).toEqual(['https://www.studio-x.com/careers'])
    expect(JSON.stringify(config.sources)).toBe(before)
  })
  it('tolerates a missing or malformed file', () => {
    expect(applySearches(config, null).status).toEqual([])
    expect(applySearches(config, { searches: 'nope' }).status).toEqual([])
  })
})
