import React from 'react'
import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
import { afterEach, beforeEach, expect, it, vi } from 'vitest'

// The three network edges are replaced: the Plan read, the Plan write, the day note write and the notifications.
const state = { board: { type: 'plan', tasks: [] }, saved: null, notes: [], notified: [] }
vi.mock('../create/planCache.js', () => ({ readPlanState: async () => ({ status: 'ok', board: state.board }) }))
vi.mock('../lib/saveJson.js', () => ({ saveJsonWithRetry: async (path, mutate) => { const data = mutate(state.board); state.board = data; state.saved = { path, data }; return { ok: true, data } } }))
vi.mock('./dayNote.js', () => ({ writeDayNote: async (date, entries) => { state.notes.push({ date, entries }); return 'note.md' } }))
vi.mock('../components/Notifications.jsx', () => ({ notify: (n) => { state.notified.push(n.title) } }))
vi.mock('../lib/apiPost.js', () => ({ apiPost: async () => ({ ok: true }) }))
const { default: SportView } = await import('./SportView.jsx')

beforeEach(() => { state.board = { type: 'plan', tasks: [] }; state.saved = null; state.notes = []; state.notified = [] })
afterEach(cleanup)

const addFirstTile = async (name) => {
  fireEvent.click(await screen.findByRole('button', { name }))
  fireEvent.click(await screen.findByText('Ajouter à la séance'))
  await waitFor(() => expect(state.notes.length).toBeGreaterThan(0))
}

it('ajoute un exercice : UNE carte Plan, le bloc de la note du jour, deux notifications', async () => {
  render(<SportView />)
  await addFirstTile('Tractions lestées (prise pronation)')
  const cards = state.board.tasks.filter((t) => t.sport)
  expect(cards).toHaveLength(1)
  expect(cards[0].sport.entries[0]).toMatchObject({ ex: 'weighted-pullup', sets: 3, reps: 8, kg: 0 })
  expect(state.notified).toEqual(['Plan · séance mise à jour', 'Note du jour'])
})

it('un second exercice s’ajoute à la MÊME carte', async () => {
  render(<SportView />)
  await addFirstTile('Tractions lestées (prise pronation)')
  fireEvent.click(await screen.findByRole('button', { name: 'Développé incliné aux haltères' }))
  fireEvent.click(await screen.findByText('Ajouter à la séance'))
  await waitFor(() => expect(state.notes.length).toBe(2))
  expect(state.board.tasks.filter((t) => t.sport)).toHaveLength(1)
  expect(state.board.tasks.find((t) => t.sport).sport.entries.map((e) => e.ex)).toEqual(['weighted-pullup', 'incline-db'])
})

it('les valeurs cliquables : 4 séries et 6 reps sont enregistrés tels quels, la charge porte son unité', async () => {
  render(<SportView />)
  fireEvent.click(await screen.findByRole('button', { name: 'Dips lestés aux parallèles' }))
  const form = await screen.findByRole('dialog')
  fireEvent.click(form.querySelectorAll('.zrs-seg')[0].querySelectorAll('button')[1])   // 4 séries
  fireEvent.click(form.querySelectorAll('.zrs-seg')[1].querySelectorAll('button')[0])   // 6 reps
  fireEvent.click(form.querySelectorAll('.zrs-seg')[2].querySelectorAll('button')[1])   // + charge
  expect(form).toHaveTextContent('2.5 kg')
  fireEvent.click(screen.getByText('Ajouter à la séance'))
  await waitFor(() => expect(state.saved).not.toBeNull())
  expect(state.saved.data.tasks.find((t) => t.sport).sport.entries[0]).toMatchObject({ sets: 4, reps: 6, kg: 2.5 })
})

it('une séance passée : le jour choisi porte la carte, jamais aujourd’hui', async () => {
  const { container } = render(<SportView />)
  await screen.findByText('Sport')
  fireEvent.change(container.querySelector('.zrs-date input'), { target: { value: '2026-10-01' } })
  expect(await screen.findByText('séance passée')).toBeInTheDocument()
  await addFirstTile('Tractions lestées (prise pronation)')
  expect(state.board.tasks.find((t) => t.sport).date).toBe('2026-10-01')
  expect(state.notes[0].date).toBe('2026-10-01')
})

it('porte la feuille sur document.body via zrs-portal, gère Escape et restaure le défilement', async () => {
  const { container } = render(<SportView />)
  fireEvent.click(await screen.findByRole('button', { name: 'Tractions lestées (prise pronation)' }))
  const sheet = await screen.findByRole('dialog')
  expect(sheet).toBeInTheDocument()
  expect(container.contains(sheet)).toBe(false)
  expect(document.body.contains(sheet)).toBe(true)
  expect(sheet.closest('.zrs-portal')).not.toBeNull()
  expect(document.body.style.overflow).toBe('hidden')

  fireEvent.keyDown(window, { key: 'Escape' })
  await waitFor(() => expect(screen.queryByRole('dialog')).toBeNull())
  expect(document.body.style.overflow).toBe('')
})
