// 2026-09-11 Count how many paths under each folder the public search delta really holds (read through the API).
// FR : compte, par dossier, les chemins réellement présents dans le delta public de recherche.
// Usage: GITHUB_TOKEN=$(gh auth token) node scripts/verify-index-delta.mjs <folder> [<folder>...]
import { importMediaKeyCK } from '../server/page.js'
const token = process.env.GITHUB_TOKEN
const folders = process.argv.slice(2)
if (!token || !folders.length) { console.error('usage: GITHUB_TOKEN=.. node scripts/verify-index-delta.mjs <folder>...'); process.exit(2) }
const r = await fetch('https://api.github.com/repos/matthieuhuguet/zenray-index-public/contents/delta.json', { headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github.raw', 'User-Agent': 'zenray-progress' } })
if (!r.ok) { console.error(`delta read failed: ${r.status}`); process.exit(1) }
const blob = await r.json()
const key = await importMediaKeyCK()
const buf = await globalThis.crypto.subtle.decrypt({ name: 'AES-GCM', iv: Buffer.from(blob.iv, 'base64') }, key, Buffer.from(blob.ct, 'base64'))
const d = JSON.parse(new TextDecoder().decode(buf))
const rm = new Set(d.rm || [])
const out = folders.map((f) => ({ folder: f, count: d.paths.filter((p) => p.startsWith(f.replace(/\/+$/, '') + '/') && !rm.has(p)).length }))
console.log(JSON.stringify({ total: d.paths.length, folders: out }, null, 1))
