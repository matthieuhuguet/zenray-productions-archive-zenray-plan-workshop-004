import { RAW_THRESHOLD } from '../../src/config/chunkPolicy.js'

// 8 October 2026, 20:26 CEST: keep permanent archive retries on a stable fresh repository route.
export function normalizeArchiveRepoSuffix(value = '') {
  const suffix = String(value || '')
  if (!suffix) return ''
  if (!/^-r\d{2,}$/.test(suffix)) throw new Error('Invalid archive repository suffix')
  return suffix
}

export function nextArchiveRepoSuffix(value = '') {
  const current = normalizeArchiveRepoSuffix(value)
  return `-r${String(current ? Number(current.slice(2)) + 1 : 2).padStart(2, '0')}`
}

export function archiveRepoName(folderName, suffix = '') {
  const safeFolder = String(folderName || '').toLowerCase().replace(/[^a-z0-9._-]+/gi, '-').replace(/^-+|-+$/g, '')
  if (!safeFolder) throw new Error('Invalid archive folder name')
  const name = `zenray-productions-archive-${safeFolder}${normalizeArchiveRepoSuffix(suffix)}`
  if (name.length > 100) throw new Error('Archive repository name exceeds GitHub limit')
  return name
}

/** Le navigateur classe encore les vidéos sous `hls`; l'archive conserve désormais l'original exact. */
export function normaliserRailArchive(pipeline) {
  return pipeline === 'hls' ? 'video' : pipeline
}

/** Les rails image et média chiffrent aujourd'hui le fichier entier en mémoire. Au-delà de la limite commune,
 *  le rail chunk protège la sauvegarde en travaillant en flux. La vidéo brute possède déjà son flux borné. */
export function bornerRailMemoire(pipeline, size) {
  if (size > RAW_THRESHOLD && (pipeline === 'img' || pipeline === 'media')) return 'chunk'
  return pipeline
}

export function shouldFlushStreamBatch(pending, batchSize, lastFlushAt, now, maxDelayMs) {
  return pending > 0 && (pending >= batchSize || now - lastFlushAt >= maxDelayMs)
}

export function shouldFlushChunkBatch(pendingBytes, targetBytes) {
  return pendingBytes >= targetBytes
}

export function isPermanentPushRejection(message) {
  const normalized = String(message || '').toLowerCase().trim()
  return normalized.length > 20
    && /rule violation|exceeds|too large|quota|repository is over|size limit|gh0\d\d/.test(normalized)
}

// 8 October 2026, 20:57 CEST: keep secret values and raw server text out of permanent-rejection diagnostics.
export function classifyPermanentPushRejection(message) {
  const normalized = String(message || '').toLowerCase()
  if (/push protection|secret scanning|credential/.test(normalized)) return 'secret-protection'
  if (/repository rule|branch protection|gh013/.test(normalized)) return 'repository-rules'
  if (/large files detected|file too large|file size limit|gh001/.test(normalized)) return 'file-size'
  if (/repository is over|repository.{0,30}size limit|size limit/.test(normalized)) return 'repository-size'
  return 'other-permanent'
}
