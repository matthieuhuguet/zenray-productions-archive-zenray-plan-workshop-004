#!/usr/bin/env node
// WarmShelfPosters.mjs (15 October 2026): pre-fill the Cloudflare edge cache with every Shelf poster, so no visitor pays the
// first read on GitHub raw (0.4 to 2 s measured). Reads the LIVE shelf through /api/shelf-public, then asks /api/shelf-poster
// for each jsDelivr poster. Same bytes, one raw read per poster ever, nothing is stored in the repository.
// FR : prechauffe le cache d'edge avec tous les posters du Shelf (une lecture raw par poster, une fois).
// Usage: node scripts/WarmShelfPosters.mjs [--base https://zenray-progress.pages.dev] [--parallel 8]
const arg = (name, fallback) => { const i = process.argv.indexOf(`--${name}`); return i > 0 ? process.argv[i + 1] : fallback }
const BASE = arg('base', 'https://zenray-progress.pages.dev')
const PARALLEL = Math.max(1, Number(arg('parallel', 8)))
const CATS = ['games', 'anime-manga', 'movies', 'books']

const urls = new Set()
for (const cat of CATS) {
  const r = await fetch(`${BASE}/api/shelf-public?cat=${cat}`)
  if (!r.ok) { console.error(`shelf ${cat}: HTTP ${r.status}`); process.exitCode = 1; continue }
  const data = await r.json()
  for (const item of (Array.isArray(data) ? data : data.items) || []) {
    const image = item.image
    const u = typeof image === 'string' ? image : image && image.kind === 'url' ? image.ref : null
    if (u && /^https:\/\/cdn\.jsdelivr\.net\/gh\//.test(u)) urls.add(u)
  }
}
const list = [...urls]
const stats = { origin: 0, 'edge-cache': 0, refused: 0, failed: 0 }
let next = 0
async function worker() {
  while (next < list.length) {
    const u = list[next++]
    try {
      const r = await fetch(`${BASE}/api/shelf-poster?u=${encodeURIComponent(u)}`)
      await r.arrayBuffer()
      if (r.status === 400) stats.refused++
      else if (!r.ok) stats.failed++
      else stats[r.headers.get('x-poster-source') || 'origin']++
    } catch { stats.failed++ }
  }
}
await Promise.all(Array.from({ length: PARALLEL }, worker))
console.log(JSON.stringify({ posters: list.length, ...stats }))
if (stats.failed) process.exitCode = 1
