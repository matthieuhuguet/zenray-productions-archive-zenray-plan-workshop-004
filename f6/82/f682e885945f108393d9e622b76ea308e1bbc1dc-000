import React from 'react'
import { it,expect,vi,afterEach } from 'vitest'
import { render,screen,cleanup,fireEvent } from '@testing-library/react'
import ProjectArticle from './ProjectArticle.jsx'
afterEach(cleanup)
const project={id:'uv-match',name:'UV-Match Height',article:{title:'UV-Match Height'}}
const file={id:'workshop:Article/index.html',name:'index.html'}
it('renders an isolated real HTML document',async()=>{
  render(<ProjectArticle project={project} file={file} readArticle={vi.fn().mockResolvedValue('<h1>Relief</h1>')} />)
  const iframe=await screen.findByTitle('UV-Match Height')
  expect(iframe.getAttribute('srcdoc')).toContain('<h1>Relief</h1>')
  expect(iframe.getAttribute('sandbox')).not.toContain('allow-same-origin')
})
it('shows an unavailable article and lets a transient failure retry',async()=>{
  const read=vi.fn().mockRejectedValueOnce(new Error('Network failed')).mockResolvedValueOnce('<h1>Ready</h1>')
  render(<ProjectArticle project={project} file={file} readArticle={read} />)
  expect((await screen.findByRole('alert')).textContent).toContain('Network failed')
  fireEvent.click(screen.getByText('Réessayer la lecture'))
  expect((await screen.findByTitle('UV-Match Height')).getAttribute('srcdoc')).toContain('Ready')
})
it('does not show the previous project when its delayed read finishes',async()=>{
  let finish
  const read=vi.fn().mockImplementationOnce(()=>new Promise(resolve=>{finish=resolve})).mockResolvedValueOnce('<h1>Second project</h1>')
  const view=render(<ProjectArticle project={project} file={file} readArticle={read} />)
  view.rerender(<ProjectArticle project={{id:'second',name:'Second'}} file={{...file,id:'second:Article/index.html'}} readArticle={read} />)
  await screen.findByTitle('Article de Second')
  finish('<h1>Old project</h1>')
  expect(screen.getByTitle('Article de Second').getAttribute('srcdoc')).toContain('Second project')
})
