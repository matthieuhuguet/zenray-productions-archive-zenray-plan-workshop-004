import { expect, test } from 'vitest'
import { ATTACHMENT_POLICY, validateAttachment, validateAttachmentBatch } from './attachmentPolicy.js'
import { RAW_THRESHOLD, storageChunkFor, CDN_CHUNK_ENC } from './chunkPolicy.js'

// Limits are checked before upload and at their exact boundaries. (19 October 2026, 00:49 Paris)
test('the largest allowed attachment stays on the shared 19 MiB storage policy', () => {
  expect(ATTACHMENT_POLICY.maxFileBytes).toBe(RAW_THRESHOLD)
  expect(() => validateAttachment({ size: RAW_THRESHOLD, name: 'max.bin' })).not.toThrow()
  expect(storageChunkFor(RAW_THRESHOLD, { perChunkEncrypted: true })).toBe(CDN_CHUNK_ENC)
  expect(() => validateAttachment({ size: RAW_THRESHOLD + 1, name: 'large.bin' })).toThrow('95 MiB')
  expect(() => validateAttachment({ size: 0 })).toThrow('non-empty')
})
test('bulk imports are routed away from the browser REST loop', () => {
  const file = { size: 1, name: 'one.bin' }
  expect(() => validateAttachmentBatch(Array(99).fill(file))).not.toThrow()
  expect(() => validateAttachmentBatch(Array(100).fill(file))).toThrow('bulk transfer')
})
