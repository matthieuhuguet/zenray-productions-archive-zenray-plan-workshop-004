import { afterEach, describe, expect, it, vi } from 'vitest'
import { apiPost } from './apiPost.js'

describe('apiPost', () => {
  afterEach(() => { vi.restoreAllMocks() })

  it('POST vers /api/page avec l\'enveloppe { action, ...payload } et les bons en-têtes', async () => {
    const fetchMock = vi.spyOn(globalThis, 'fetch').mockResolvedValue({ ok: true, status: 200, json: async () => ({ ok: true, sha: 'abc' }) })
    const result = await apiPost('save', { path: 'pages/A.md', markdown: '# A' })

    expect(fetchMock).toHaveBeenCalledTimes(1)
    const [url, init] = fetchMock.mock.calls[0]
    expect(url).toBe('/api/page')
    expect(init.method).toBe('POST')
    expect(init.headers).toEqual({ 'content-type': 'application/json' })
    expect(JSON.parse(init.body)).toEqual({ action: 'save', path: 'pages/A.md', markdown: '# A' })
    expect(result).toEqual({ ok: true, sha: 'abc' })
  })

  it('fonctionne sans payload (action seule, ex. index-add appelé avec juste { paths })', async () => {
    vi.spyOn(globalThis, 'fetch').mockResolvedValue({ ok: true, status: 200, json: async () => ({ ok: true }) })
    const result = await apiPost('delete', undefined)
    expect(result).toEqual({ ok: true })
  })

  it('propage le rejet réseau (aucun catch interne) pour que l\'appelant garde sa propre gestion d\'erreur', async () => {
    vi.spyOn(globalThis, 'fetch').mockRejectedValue(new Error('network down'))
    await expect(apiPost('move', { from: 'a', to: 'b' })).rejects.toThrow('network down')
  })

  it('un corps illisible lève une erreur NOMMÉE, au lieu de rendre null', async () => {
    // Depuis le 2026-08-31 l'erreur brute du parseur est remplacée par une `ErreurApi` qui porte
    // l'action et le statut. Ce qui compte n'a pas changé : l'appel échoue, il ne rend pas un
    // succès vide sur lequel l'appelant construirait la suite.
    vi.spyOn(globalThis, 'fetch').mockResolvedValue({ ok: true, status: 200, json: async () => { throw new Error('bad json') } })
    await expect(apiPost('save', { path: 'x' })).rejects.toThrow(/illisible/)
  })
})
