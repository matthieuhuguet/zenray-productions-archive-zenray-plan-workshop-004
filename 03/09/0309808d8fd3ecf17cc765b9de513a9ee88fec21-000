// Seuil de transcodage HLS DANS LE NAVIGATEUR (ffmpeg.wasm).
//
// EN CLAIR : quand on dépose une vidéo, le site regarde sa TAILLE.
//   - PETITE (< seuil) : le navigateur la transcode lui-même en HLS chiffré (ffmpeg.wasm) et l'upload tout seul.
//   - GROSSE (>= seuil) : on garde le flux ACTUEL — une commande à coller dans le terminal pour un transcodage local.
//
// POURQUOI UN SEUIL BAS (pas 2 Go) : le moteur ffmpeg.wasm est 32 bits, son tas mémoire est PLAFONNÉ À 2 Go
// EN DUR. Ce plafond couvre TOUT (entrée + sortie + buffers de l'encodeur). Promettre 2 Go en navigateur est donc
// irréaliste : ffmpeg a besoin de plusieurs centaines de Mo de travail en plus du fichier. On reste prudent.
// L'entrée est lue en streaming via WORKERFS (pas chargée d'un bloc), et la sortie est évacuée segment par
// segment, ce qui repousse la limite — mais on ne dépasse pas un plafond dur raisonnable.

export const BROWSER_HLS_MAX_BYTES = 1024 * 1024 * 1024 // 1 Go : défaut.
// 1 Go en DUR : l'entrée est lue en streaming via WORKERFS (jamais copiée dans le tas) et la sortie est
// évacuée segment par segment, donc seuls les buffers de l'encodeur + 1 segment vivent dans le tas à un
// instant donné. 1 Go d'entrée tient ainsi sous le plafond heap wasm 2 Go EN DUR, avec marge pour ces buffers.
export const HARD_CAP = 1024 * 1024 * 1024              // 1 Go : plafond dur, jamais au-dessus.
const LS_KEY = 'zr:hls-browser-threshold'                // override en Mo, posé à la main dans le localStorage.

// Seuil effectif : override localStorage (en Mo) clampé à [1 Mo, HARD_CAP], sinon défaut.
export function browserHlsThreshold() {
  try {
    const raw = typeof localStorage !== 'undefined' ? localStorage.getItem(LS_KEY) : null
    if (raw != null) {
      const mb = Number(raw)
      if (Number.isFinite(mb) && mb > 0) return Math.min(HARD_CAP, Math.max(1024 * 1024, mb * 1024 * 1024))
    }
  } catch { /* localStorage indispo (SSR/sandbox) : on retombe sur le défaut */ }
  return BROWSER_HLS_MAX_BYTES
}

// Le navigateur sait-il transcoder ? ffmpeg.wasm (WebAssembly) + crypto.subtle (clé AES + SHA-256 des segments).
export function browserHlsSupported() {
  try {
    return typeof WebAssembly !== 'undefined'
      && typeof crypto !== 'undefined' && !!crypto.subtle
      && typeof Worker !== 'undefined'
  } catch { return false }
}
