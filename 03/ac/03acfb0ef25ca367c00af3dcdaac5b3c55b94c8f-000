// Ajoute les 12 jeux (présents dans le SEED public/shelf/games.json) à la version LIVE du Shelf
// (zenray-data shelf/games.json) que l'app affiche réellement. Idempotent : skip ceux déjà présents (par nom).
import { readFile } from 'node:fs/promises'
const TOKEN = process.env.GITHUB_TOKEN
const REPO = 'matthieuhuguet/zenray-data', BRANCH = 'main', PATH = 'shelf/games.json'
const NAMES = ['Resident Evil Veronica','Fable','Final Fantasy VII Rebellion','God of War Laufey','Control','Resonant','Stellar Blade Blood Rain','Persona 6 Resonance','A Plague Tale Legacy','Stranger Than Heaven','Persona 4 Revival','No Rest for the Wicked']
const gh = (p, init = {}) => fetch(`https://api.github.com/repos/${REPO}/${p}`, { ...init, headers: { Authorization: `Bearer ${TOKEN}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zr-merge', ...(init.headers || {}) } })

const seed = JSON.parse(await readFile('public/shelf/games.json', 'utf8'))
const want = NAMES.map((n) => seed.items.find((i) => i.name === n)).filter(Boolean)
console.log(`trouvés dans le seed : ${want.length}/${NAMES.length}`, want.length < NAMES.length ? '(manquants: ' + NAMES.filter((n) => !want.find((w) => w.name === n)).join(', ') + ')' : '')

// LIVE actuelle + sha
const meta = await gh(`contents/${encodeURI(PATH)}?ref=${BRANCH}`).then((r) => r.json())
const live = JSON.parse(Buffer.from(meta.content, 'base64').toString('utf8'))
const have = new Set(live.items.map((i) => i.name))
const toAdd = want.filter((w) => !have.has(w.name)).map((w) => ({ ...w, status: 'backlog' }))
console.log(`déjà en LIVE : ${want.length - toAdd.length} | à ajouter : ${toAdd.length}`)
if (!toAdd.length) { console.log('rien à faire'); process.exit(0) }

live.items = [...toAdd, ...live.items] // nouveaux en tête du backlog
const body = { message: `shelf: +${toAdd.length} jeux backlog (merge seed->live)`, content: Buffer.from(JSON.stringify(live)).toString('base64'), branch: BRANCH, sha: meta.sha }
const put = await gh(`contents/${encodeURI(PATH)}`, { method: 'PUT', body: JSON.stringify(body) })
const j = await put.json()
console.log(put.ok ? `OK : LIVE = ${live.items.length} items, commit ${j.commit?.sha?.slice(0,8)}` : 'ÉCHEC: ' + JSON.stringify(j).slice(0, 200))
