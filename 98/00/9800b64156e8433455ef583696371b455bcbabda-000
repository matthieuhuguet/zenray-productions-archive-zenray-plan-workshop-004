import { describe, it, expect } from 'vitest'
import { readFileSync } from 'node:fs'

// ═══ LES PARCOURS DE GROS VOLUME NE PAIENT PLUS LE QUOTA ════════════════════════════════════════
//
// Ce que la nuit du 2026-08-31 a coûté : le quota GitHub (5 000 requêtes par heure) est tombé à zéro
// DEUX FOIS, et le site est devenu inutilisable jusqu'au reset. La cause n'était pas une boucle
// folle, c'était l'usage normal — parcourir une galerie, ouvrir des téléchargements, préparer un zip.
//
// Chacune de ces vues lisait un manifeste PAR FICHIER via `action=read` sans `raw=1`, c'est-à-dire
// par l'API contents, qui compte. Le mode hors quota existait pourtant déjà côté serveur.
//
// Ce contrôle lit le code des vues concernées et rougit si l'une d'elles reprend une lecture
// coûteuse. Il vise les endroits où le nombre de lectures croît avec le nombre de fichiers, seuls
// capables de vider un quota de cinq mille.

// Les vues dont le volume de lecture est PROPORTIONNEL au nombre de fichiers affichés.
const PARCOURS_DE_VOLUME = [
  ['src/components/DownloadsView.jsx', 'un manifeste par fichier téléchargé, par lots de douze'],
  ['src/components/VideoPlayer2.jsx', 'tous les .media.json du dossier, pour les pistes sœurs'],
  ['src/lib/bulkZip.js', 'un manifeste par image de l’archive'],
  ['src/capture/folderVisibility.js', 'le marqueur de visibilité, un par dossier parcouru'],
  // Ajoutés le 2026-08-31, après le lien partagé qui rendait « Empty folder » : la galerie publique
  // lisait un manifeste PAR VIGNETTE, et le dossier réellement partagé en compte 833. Un seul
  // visiteur consommait donc 833 des 5000 requêtes horaires.
  ['src/components/SharedFolderPage.jsx', 'un manifeste par vignette de la galerie publique'],
  // 12 October 2026 : la galerie Motion Design lit un catalogue unique, puis la fiche et le manifeste du motion ouvert.
  ['src/motion/MotionPage.jsx', 'le catalogue, la fiche et le manifeste d’un motion'],
]

// `meta.js` porte les DEUX cas volontairement : `readProps` garde le sha pour pouvoir écrire, et
// `lirePropsAffichage` lit hors quota. On vérifie donc la séparation, pas l'absence.
const SEPARATION = [
  ['src/eagle/meta.js', 'lirePropsAffichage', 'urlLectureEdition'],
]

describe('aucun parcours de gros volume ne lit par l’API contents', () => {
  it.each(PARCOURS_DE_VOLUME)('%s — %s', (fichier) => {
    const src = readFileSync(fichier, 'utf8')
    // Une lecture écrite à la main, sans passer par la brique : c'est la forme exacte du défaut.
    const brutes = [...src.matchAll(/action=read(?![^`'"]*raw=1)/g)]
    expect(brutes.length, `${fichier} lit encore par l’API contents (${brutes.length} occurrence(s)) — le quota retombera à zéro`).toBe(0)
  })

  it('les quatre passent bien par la brique commune', () => {
    for (const [fichier] of PARCOURS_DE_VOLUME) {
      expect(readFileSync(fichier, 'utf8'), `${fichier} n’utilise pas urlLectureAffichage`).toContain('urlLectureAffichage')
    }
  })

  it('DÉTECTE vraiment le défaut : la ligne d’avant correction rougit', () => {
    // Un contrôle qui n'a jamais rougi n'a rien prouvé. On lui donne la ligne exacte d'origine.
    const avant = "fetch(`/api/page?action=read&path=${encodeURIComponent(p)}`, { cache: 'no-store' })"
    expect([...avant.matchAll(/action=read(?![^`'"]*raw=1)/g)].length).toBe(1)
  })
})

describe('lire pour afficher et lire pour écrire restent séparés', () => {
  it.each(SEPARATION)('%s expose les deux voies, et ne les confond pas', (fichier, affichage, edition) => {
    const src = readFileSync(fichier, 'utf8')
    expect(src, `${fichier} n’a pas de voie d’affichage`).toContain(affichage)
    expect(src, `${fichier} a perdu la lecture d’édition — les sauvegardes casseront`).toContain(edition)
  })

  it('le gros volume de meta.js passe par la voie SANS sha', () => {
    // `buildEagleIndex` lit un .props.json par page. Si cette boucle repassait par `readProps`,
    // ouvrir un dossier de deux cents pages consommerait de nouveau deux cents requêtes.
    const src = readFileSync('src/eagle/meta.js', 'utf8')
    const boucle = src.slice(src.indexOf('async function worker'))
    expect(boucle).toContain('lirePropsAffichage')
    expect(boucle.slice(0, boucle.indexOf('}'))).not.toContain('await readProps(')
  })
})
