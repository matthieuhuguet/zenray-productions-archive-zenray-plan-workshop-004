// 9 October 2026 09:22 CEST: Verify Eagle resolution stays on the existing media path.
import React from 'react'
import { afterEach, describe, expect, it, vi } from 'vitest'
import { cleanup, render, screen, waitFor } from '@testing-library/react'
import { resolveEaglePath } from '../lib/eagleLink.js'
import ResolvedUnifiedViewer from './ResolvedUnifiedViewer.jsx'

vi.mock('../lib/eagleLink.js', () => ({ resolveEaglePath: vi.fn(async (path) => ({ path, abouti: true })) }))

afterEach(() => {
  cleanup()
  vi.clearAllMocks()
})

describe('ResolvedUnifiedViewer', () => {
  it('does not resolve pages through the Eagle API', () => {
    render(<ResolvedUnifiedViewer path="pages/notes.md" context="create"
      renderers={{ page: ({ path }) => <span role="status">{path}</span> }} />)
    expect(resolveEaglePath).not.toHaveBeenCalled()
    expect(screen.getByRole('status').textContent).toBe('pages/notes.md')
  })

  it('resolves media paths before dispatching their renderer', async () => {
    render(<ResolvedUnifiedViewer path="pages/photo.img.json"
      renderers={{ image: ({ path }) => <span role="status">{path}</span> }} />)
    await waitFor(() => expect(screen.getByRole('status').textContent).toBe('pages/photo.img.json'))
    expect(resolveEaglePath).toHaveBeenCalledOnce()
  })
})
