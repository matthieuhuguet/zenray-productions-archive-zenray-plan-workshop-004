import React from 'react'
import { PALETTE, RADII } from '../../theme.js'
import { safeImg } from './safeUrl.js'

// Rendu du custom block `zenrayBookmark` : carte de lien riche (titre/description/domaine/favicon + image à droite).
// Clic ouvre l'URL dans un nouvel onglet. Skeleton tant que l'unfurl n'a pas répondu (props vides puis updateBlock).
const SANS = "var(--zr-police-sans)"

export default function BookmarkBlock({ block, theme }) {
  const p = (block && block.props) || {}
  const dark = theme === 'dark'
  const border = dark ? 'rgba(255,255,255,0.12)' : 'rgba(0,0,0,0.10)'
  const bg = dark ? '#252525' : '#FDFDFC'
  const muted = PALETTE.gray600
  const loading = !p.title && !p.description && p.loading
  const hostname = (() => { try { return new URL(p.url).hostname.replace(/^www\./, '') } catch { return p.siteName || '' } })()

  const open = () => { if (p.url) window.open(p.url, '_blank', 'noopener,noreferrer') }

  return (
    <div contentEditable={false} onClick={open}
      style={{ fontFamily: SANS, margin: '8px 0', maxWidth: 720, display: 'flex', border: `1px solid ${border}`, borderRadius: RADII.md, overflow: 'hidden', cursor: 'pointer', background: bg, transition: 'background .15s' }}
      onMouseEnter={(e) => { e.currentTarget.style.background = dark ? '#2d2d2d' : '#f6f6f4' }}
      onMouseLeave={(e) => { e.currentTarget.style.background = bg }}>
      <div style={{ flex: 1, minWidth: 0, padding: '12px 14px' }}>
        <div style={{ fontSize: 'var(--zr-ui-lg)', fontWeight: 600, color: dark ? '#ECECEA' : '#1F1F1E', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
          {loading ? 'Chargement…' : (p.title || p.url)}
        </div>
        {p.description && (
          <div style={{ fontSize: 'var(--zr-ui-sm)', color: muted, marginTop: 4, lineHeight: 1.4, maxHeight: 36, overflow: 'hidden' }}>{p.description}</div>
        )}
        <div style={{ fontSize: 'var(--zr-ui-sm)', color: muted, marginTop: 8, display: 'flex', alignItems: 'center', gap: 6 }}>
          {safeImg(p.favicon) && <img src={safeImg(p.favicon)} alt="" width={14} height={14} style={{ borderRadius: 3 }} onError={(e) => { e.currentTarget.style.display = 'none' }} />}
          <span style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{p.siteName || hostname}</span>
        </div>
      </div>
      {safeImg(p.image) && (
        <img src={safeImg(p.image)} alt="" style={{ width: 130, flexShrink: 0, objectFit: 'cover' }} onError={(e) => { e.currentTarget.style.display = 'none' }} />
      )}
    </div>
  )
}
