// 20 October 2026, 15:10 CEST: explicit, bounded project articles share one local/cloud reading contract.
export const PROJECT_ARTICLE_CONFIG = {
  maxBytes: 32 * 1024 * 1024,
  thumbnailMaxChars: 400000,
  titleMaxChars: 180,
  frameHeight: '78vh',
  sandbox: 'allow-popups allow-popups-to-escape-sandbox',
  contentSecurityPolicy: "default-src 'none'; img-src data:; font-src data:; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; connect-src 'none'",
}
export const isArticleName = name => /\.html?$/i.test(String(name || ''))
export function validateProjectArticle(article) {
  if (!article || typeof article.fileId !== 'string' || !/^[a-z0-9-]+:[^\\\x00-\x1f]+\.html?$/i.test(article.fileId)
    || article.fileId.split(':')[1].split('/').some(part => !part || part === '.' || part === '..')
    || typeof article.title !== 'string' || !article.title.trim() || article.title.length > PROJECT_ARTICLE_CONFIG.titleMaxChars
    || !/^[a-f0-9]{64}$/.test(article.sha256 || '') || !articleThumbnail({article})) throw new Error('Invalid project article reference')
  return {fileId:article.fileId,title:article.title.trim(),sha256:article.sha256,thumbnailUrl:article.thumbnailUrl}
}
export function articleThumbnail(project) {
  const url = project?.article?.thumbnailUrl
  return typeof url === 'string' && url.length <= PROJECT_ARTICLE_CONFIG.thumbnailMaxChars && /^data:image\/(?:png|webp|jpeg);base64,[a-zA-Z0-9+/=]+$/.test(url) ? url : null
}
export function projectArticleFile(project, files = project?.files || []) {
  return files.find(file => file.id === project?.article?.fileId && isArticleName(file.name || file.relativePath)) || null
}
// 21 October 2026 : the HTML file a link names (?article=<fileId>), when it is an inventoried HTML document of this project ; null otherwise (the declared
// article then opens). Only a file of the project's own inventory can be named, so a link cannot open anything else.
export function linkedArticleFile(project, files = project?.files || [], fileId = null) {
  if (!fileId || typeof fileId !== 'string') return null
  return files.find(file => file.id === fileId && isArticleName(file.name || file.relativePath)) || null
}
export async function loadProjectArticle(file, { connected, readLocal, readCloudBytes }) {
  if (!file || !isArticleName(file.name || file.relativePath)) throw new Error('Le fichier HTML déclaré pour cet article est absent.')
  if (file.size > PROJECT_ARTICLE_CONFIG.maxBytes) throw new Error('Cet article dépasse la limite de lecture de 32 Mio.')
  let text
  if (connected && file.present && file.sourceId) {
    try {
      const result = await readLocal(file)
      if (result.truncated) throw new Error('La lecture locale de cet article est tronquée.')
      if (typeof result.text !== 'string') throw new Error('Le Mac ne fournit pas le texte de l’article.')
      text = result.text
    } catch (error) { if (!file.contentPath && !file.cloudPath) throw error }
  }
  if (text === undefined) {
    if (!file.contentPath && !file.cloudPath) throw new Error('Article disponible sur le Mac : reconnectez-le ou sauvegardez ce fichier.')
    const result = await readCloudBytes({ ...file, contentPath: file.contentPath || file.cloudPath })
    if (!result?.bytes) throw new Error('Le cloud ne fournit pas les octets de l’article.')
    if (result.bytes.byteLength > PROJECT_ARTICLE_CONFIG.maxBytes) throw new Error('Cet article dépasse la limite de lecture de 32 Mio.')
    text = new TextDecoder('utf-8', { fatal: true }).decode(result.bytes)
  }
  if (!text.trim()) throw new Error('Cet article est vide.')
  if (new TextEncoder().encode(text).byteLength > PROJECT_ARTICLE_CONFIG.maxBytes) throw new Error('Cet article dépasse la limite de lecture de 32 Mio.')
  return text
}

// 20 October 2026, 15:10 CEST: imported HTML cannot execute code, load external resources or navigate the parent application.
export function projectArticleDocument(html) {
  const doc = new DOMParser().parseFromString(html, 'text/html')
  doc.querySelectorAll('script,base,iframe,object,embed,form,link,meta[http-equiv]').forEach(node => node.remove())
  for (const node of doc.querySelectorAll('*')) for (const attr of [...node.attributes]) {
    if (/^on/i.test(attr.name) || ['srcdoc','action','formaction','srcset','ping'].includes(attr.name.toLowerCase())) node.removeAttribute(attr.name)
    if (attr.name.toLowerCase() === 'src' && !/^data:image\/(?:png|jpeg|webp|gif|avif|svg\+xml);/i.test(attr.value)) node.removeAttribute(attr.name)
  }
  for (const anchor of doc.querySelectorAll('a[href]')) {
    const href = anchor.getAttribute('href').trim()
    // 20 October 2026, 18:32 CEST: srcdoc inherits its parent's base URL; an explicit fragment keeps navigation inside this article.
    if (href.startsWith('#')) { anchor.setAttribute('href', `about:srcdoc${href}`); anchor.removeAttribute('target'); continue }
    if (/^https:\/\//i.test(href)) { anchor.setAttribute('target','_blank'); anchor.setAttribute('rel','noopener noreferrer') }
    else anchor.removeAttribute('href')
  }
  const policy = doc.createElement('meta')
  policy.httpEquiv = 'Content-Security-Policy'
  policy.content = PROJECT_ARTICLE_CONFIG.contentSecurityPolicy
  doc.head.prepend(policy)
  return '<!doctype html>\n' + doc.documentElement.outerHTML
}
