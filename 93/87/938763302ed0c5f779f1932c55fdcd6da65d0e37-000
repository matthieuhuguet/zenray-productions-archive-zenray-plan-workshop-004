// 3 October 2026, 09:01 CEST: preparation chooses exact verified copies and lists missing identities without guessing paths.
import { describe, expect, it } from 'vitest'
import { buildScenePreparationPlan } from './scenePreparation.js'

const hash = 'a'.repeat(64)
const copy = (id, relativePath) => ({ id, relativePath, present: true, loadedCopy: true, status: 'verified', sha256: hash, localPath: `/copies/${relativePath}`, workingRoot: '/copies' })
const fixture = () => ({ projectId: 'tiles', sceneFileId: 'workshop:Scene.hiplc',
  projects: [{ id: 'tiles', files: [copy('workshop:Scene.hiplc', 'Scene.hiplc'), copy('workshop:Color.png', 'Color.png')] }, { id: 'library', files: [copy('definitions:Roof.hda', 'Roof.hda')] }],
  audit: { sceneSha256: hash, references: [{ resolvedPath: '/origin/Color.png', pathKind: 'absolute' }, { pathKind: 'absolute' }] },
  context: { projectId: 'tiles', sceneFileId: 'workshop:Scene.hiplc', sceneSha256: hash, state: 'current', dependencies: ['library'], references: [
    { referenceId: 0, role: 'input', parameterPath: '/obj/geo/file', type: 'relocation-required', targets: [{ projectId: 'tiles', fileId: 'workshop:Color.png' }] },
    { referenceId: 1, role: 'unknown', parameterPath: null, type: 'relocation-required', targets: [{ projectId: 'library', fileId: 'definitions:Roof.hda' }] },
  ] } })

describe('managed scene preparation plan', () => {
  it('joins exact resource and shared HDA identities to their verified loaded destinations', () => {
    const plan = buildScenePreparationPlan(fixture())
    expect(plan).toMatchObject({ ready: true, completeReferenceCoverage: true, scenePath: '/copies/Scene.hiplc', sceneRoot: '/copies', portabilityVerified: false })
    expect(plan.resources).toEqual([
      { kind: 'input', projectId: 'tiles', fileId: 'workshop:Color.png', targetPath: '/copies/Color.png', targetRoot: '/copies', sha256: hash, parameterPath: '/obj/geo/file', originalPath: '/origin/Color.png' },
      { kind: 'hda', projectId: 'library', fileId: 'definitions:Roof.hda', targetPath: '/copies/Roof.hda', targetRoot: '/copies', sha256: hash },
    ])
    expect(plan.loadRequirements).toEqual([])
  })
  it('lists exact files to load once and never substitutes originals or edited working copies', () => {
    const input = fixture()
    delete input.projects[0].files[0].loadedCopy
    input.projects[0].files[1].status = 'pending'
    input.context.references.push(input.context.references[0])
    const plan = buildScenePreparationPlan(input)
    expect(plan.ready).toBe(false)
    expect(JSON.parse(JSON.stringify(plan)).ready).toBe(false)
    expect(plan.loadRequirements).toEqual([{ projectId: 'tiles', fileId: 'workshop:Scene.hiplc', reason: 'scene-copy-required' }, { projectId: 'tiles', fileId: 'workshop:Color.png', reason: 'resource-archive-required' }])
    expect(plan.resources.map((entry) => entry.kind)).toEqual(['hda'])
  })
  it('accepts an edited managed copy after its current bytes have an exact archive proof', () => {
    const input = fixture()
    for (const file of input.projects[0].files) file.status = 'backed-up'
    expect(buildScenePreparationPlan(input).ready).toBe(true)
  })
  it('does not prepare outputs, dynamic references, ambiguities or undeclared project targets', () => {
    const input = fixture()
    input.context.dependencies = []
    input.context.references[0].type = 'dynamic'
    input.context.references.push({ referenceId: 2, type: 'output' }, { referenceId: 3, type: 'internal' }, { referenceId: 4, type: 'directory' }, { referenceId: 5, type: 'ambiguous', targets: [{ projectId: 'tiles', fileId: 'workshop:Color.png' }, { projectId: 'tiles', fileId: 'workshop:Color.png' }] })
    const plan = buildScenePreparationPlan(input)
    expect(plan.resources).toEqual([])
    expect(plan.unresolvedReferences.map((entry) => entry.referenceId)).toEqual([0, 1, 5])
    expect(plan.completeReferenceCoverage).toBe(false)
    expect(plan.portabilityVerified).toBe(false)
  })
  it('refuses stale or mismatched scene evidence and unrecognized scene identities', () => {
    for (const mutation of [(input) => { input.context.state = 'stale' }, (input) => { input.context.sceneSha256 = 'b'.repeat(64) }, (input) => { input.context.projectId = 'other' }]) {
      const input = fixture(); mutation(input)
      expect(() => buildScenePreparationPlan(input)).toThrow('Current scene resource audit')
    }
    const input = fixture(); input.sceneFileId = 'workshop:Missing.hiplc'
    expect(() => buildScenePreparationPlan(input)).toThrow('Inventoried Houdini scene')
  })
})
