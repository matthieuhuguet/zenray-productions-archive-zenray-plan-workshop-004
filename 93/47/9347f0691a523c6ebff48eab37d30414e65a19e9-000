// Pavé PIN (style Finder macOS / Notion) pour déverrouiller le drive ZenRay.
// Remplace le window.prompt de apiAuth.js : ce dernier appelle window.__zrRequestPin(hadSecret) qui renvoie une
// Promise résolue avec le code saisi (ou '' si annulé). Le code saisi devient le secret x-zr-auth (= ZENRAY_API_SECRET
// côté Vercel) -> il gate à la fois l'accès /api ET la clé de déchiffrement (/api/media-key). Une seule source de vérité.
import React, { useState, useEffect, useRef, useCallback } from 'react'
import Icon from './Icon.jsx'

const FONTS = { sans: "var(--zr-police-sans)", serif: "var(--zr-police-serif)" }

export default function PinGate({ t }) {
  const [show, setShow] = useState(false)
  const [pin, setPin] = useState('')
  const [retry, setRetry] = useState(false) // un secret était déjà posé et a échoué -> mauvais code
  const [shake, setShake] = useState(false)
  const resolveRef = useRef(null)

  const close = useCallback((val) => {
    setShow(false); setPin('')
    const r = resolveRef.current; resolveRef.current = null
    if (r) r(val)
  }, [])

  // Point d'entrée appelé par apiAuth.js sur 401.
  useEffect(() => {
    window.__zrRequestPin = (hadSecret) => new Promise((resolve) => {
      resolveRef.current = resolve; setPin(''); setRetry(!!hadSecret); setShow(true)
    })
    return () => { try { delete window.__zrRequestPin } catch {} }
  }, [])

  const submit = useCallback(() => {
    if (!pin) { setShake(true); setTimeout(() => setShake(false), 360); return }
    close(pin)
  }, [pin, close])

  // Clavier physique : chiffres, retour arrière, Entrée, Échap.
  useEffect(() => {
    if (!show) return
    const onKey = (e) => {
      if (e.key >= '0' && e.key <= '9') { setPin((p) => (p.length < 16 ? p + e.key : p)); setRetry(false) }
      else if (e.key === 'Backspace') setPin((p) => p.slice(0, -1))
      else if (e.key === 'Enter') submit()
      else if (e.key === 'Escape') close('')
    }
    window.addEventListener('keydown', onKey)
    return () => window.removeEventListener('keydown', onKey)
  }, [show, submit, close])

  if (!show) return null

  const accent = (t && t.accent) || '#0A84FF'
  const textP = (t && t.textPrimary) || '#1d1d1f'
  const textS = (t && t.textSecondary) || '#8a8a8e'
  const press = (d) => { setPin((p) => (p.length < 16 ? p + d : p)); setRetry(false) }

  const keyBtn = {
    width: 64, height: 64, borderRadius: 99, border: 'none', cursor: 'pointer',
    background: 'rgba(120,120,128,0.16)', color: textP, fontFamily: FONTS.sans, fontSize: 25, fontWeight: 400,
    display: 'inline-flex', alignItems: 'center', justifyContent: 'center', transition: 'transform .08s, background .12s',
  }

  return (
    <>
      <div onClick={() => close('')} style={{ position: 'fixed', inset: 0, zIndex: 2000, background: 'rgba(0,0,0,0.32)', backdropFilter: 'blur(3px)', WebkitBackdropFilter: 'blur(3px)' }} />
      <div className="zr-glass-thick" role="dialog" aria-modal="true"
        style={{ position: 'fixed', top: '50%', left: '50%', transform: 'translate(-50%,-50%)', zIndex: 2001, width: 'min(340px, 92vw)', borderRadius: 26, padding: '30px 26px 26px', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 18, fontFamily: FONTS.sans, animation: shake ? 'pinShake .36s' : 'pinPop .2s cubic-bezier(0.2,1,0.4,1)' }}>
        <div style={{ width: 52, height: 52, borderRadius: 99, background: 'rgba(120,120,128,0.16)', display: 'grid', placeItems: 'center' }}>
          <Icon name="lock" size={24} color={textP} />
        </div>
        <div style={{ textAlign: 'center' }}>
          <div style={{ fontFamily: FONTS.serif, fontWeight: 500, fontSize: 19, color: textP }}>Drive ZenRay</div>
          <div style={{ fontSize: 'var(--zr-ui-sm)', color: retry ? '#E2554E' : textS, marginTop: 3 }}>{retry ? 'Code incorrect — réessaie' : 'Entre ton code pour déverrouiller'}</div>
        </div>

        {/* Points du code */}
        <div style={{ display: 'flex', gap: 11, minHeight: 14, alignItems: 'center' }}>
          {Array.from({ length: Math.max(6, pin.length) }).map((_, i) => (
            <span key={i} style={{ width: 11, height: 11, borderRadius: 99, background: i < pin.length ? accent : 'transparent', border: `1.5px solid ${i < pin.length ? accent : 'rgba(120,120,128,0.45)'}`, transition: 'all .12s' }} />
          ))}
        </div>

        {/* Pavé numérique */}
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 64px)', gap: 14, justifyContent: 'center' }}>
          {['1', '2', '3', '4', '5', '6', '7', '8', '9'].map((d) => (
            <button key={d} onClick={() => press(d)} onMouseDown={(e) => e.preventDefault()} style={keyBtn}
              onMouseEnter={(e) => (e.currentTarget.style.background = 'rgba(120,120,128,0.26)')} onMouseLeave={(e) => (e.currentTarget.style.background = 'rgba(120,120,128,0.16)')}>{d}</button>
          ))}
          <span />
          <button onClick={() => press('0')} onMouseDown={(e) => e.preventDefault()} style={keyBtn}
            onMouseEnter={(e) => (e.currentTarget.style.background = 'rgba(120,120,128,0.26)')} onMouseLeave={(e) => (e.currentTarget.style.background = 'rgba(120,120,128,0.16)')}>0</button>
          <button onClick={() => setPin((p) => p.slice(0, -1))} onMouseDown={(e) => e.preventDefault()} title="Effacer" style={{ ...keyBtn, background: 'transparent', fontSize: 24, color: textS }}>⌫</button>
        </div>

        <button onClick={submit} disabled={!pin} style={{ width: '100%', padding: '13px', borderRadius: 14, border: 'none', cursor: pin ? 'pointer' : 'default', background: pin ? accent : 'rgba(120,120,128,0.18)', color: pin ? '#fff' : textS, fontFamily: FONTS.sans, fontWeight: 600, fontSize: 'var(--zr-ui-xl)', transition: 'background .15s' }}>
          Déverrouiller
        </button>

        <style>{`
          @keyframes pinPop{from{opacity:0;transform:translate(-50%,-48%) scale(0.96)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}
          @keyframes pinShake{10%,90%{transform:translate(calc(-50% - 1px),-50%)}30%,70%{transform:translate(calc(-50% + 6px),-50%)}50%{transform:translate(calc(-50% - 6px),-50%)}}
        `}</style>
      </div>
    </>
  )
}
