// CreateStreamManifest.mjs (14 October 2026): the base manifest of a film that is sent as STREAMING ONLY (policy of 14 October 2026).
//   node scripts/CreateStreamManifest.mjs --source <film.mkv> --manifest <clone>/pages/.../<Name>.mkv.media.json
// It carries no parts (no encrypted archive). AttachVideoCmafDashHls.mjs adds master, mpd, poster, audio and commits it.
// FR : manifeste de base d'un film envoye en STREAMING SEUL ; AttachVideoCmafDashHls.mjs y ajoute master, mpd, affiche et le commite.
import fs from 'node:fs'
import path from 'node:path'
import { probeSource } from './lib/fmp4-single.mjs'

const argv = process.argv.slice(2)
const value = (flag) => { const i = argv.indexOf(flag); return i >= 0 ? argv[i + 1] : '' }
const source = path.resolve(value('--source') || '')
const manifestPath = path.resolve(value('--manifest') || '')
if (!value('--source') || !fs.existsSync(source)) throw new Error('--source <file> is required and must exist')
if (!value('--manifest') || !manifestPath.endsWith('.media.json')) throw new Error('--manifest <path>.media.json is required')
if (fs.existsSync(manifestPath)) { console.log(JSON.stringify({ ok: true, existed: true, manifestPath })); process.exit(0) }

const probe = probeSource(source)
const manifest = {
  type: 'dash',
  v: 2,
  name: path.basename(manifestPath, '.media.json'),
  mime: 'application/dash+xml',
  // FR : le nom du manifeste est le nom du fichier ; la taille de la source sert seulement a l'affichage.
  size: fs.statSync(source).size,
  codec: probe.video?.codec_name || null,
  width: probe.video?.width || null,
  height: probe.video?.height || null,
  duration: Math.round(probe.duration * 100) / 100,
  streamOnly: true,
  policy: 'streaming-only (14 October 2026)',
}
fs.mkdirSync(path.dirname(manifestPath), { recursive: true })
fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2) + '\n')
console.log(JSON.stringify({ ok: true, existed: false, manifestPath }))
