{
  "_note": "16 October 2026: one entry per applicant detail. `match` are regular expressions tested (case-insensitive) on name, id, placeholder, aria-label, autocomplete and the label text of a field; first key that matches wins. Edit here, never in FillForm.js. FR : une entrée par coordonnée ; modifiable ici seulement.",
  "fields": [
    {
      "key": "email",
      "profile": "email",
      "match": [
        "e-?mail",
        "courriel",
        "mail"
      ],
      "types": [
        "email",
        "text"
      ]
    },
    {
      "key": "phone",
      "profile": "phoneInternational",
      "match": [
        "phone",
        "t[eé]l[eé]phone",
        "mobile",
        "portable",
        "tel\\b"
      ],
      "types": [
        "tel",
        "text"
      ],
      "exclude": [
        "country",
        "pays",
        "dial",
        "extension",
        "prefix",
        "indicatif"
      ]
    },
    {
      "key": "firstName",
      "profile": "firstName",
      "match": [
        "first.?name",
        "given.?name",
        "pr[eé]nom",
        "fname"
      ]
    },
    {
      "key": "lastName",
      "profile": "lastName",
      "match": [
        "last.?name",
        "family.?name",
        "surname",
        "nom de famille",
        "lname"
      ]
    },
    {
      "key": "fullName",
      "profile": "fullName",
      "match": [
        "full.?name",
        "your name",
        "^name$",
        "\\bnom\\b",
        "candidate.?name",
        "nom et pr[eé]nom"
      ]
    },
    {
      "key": "linkedin",
      "profile": "linkedin",
      "match": [
        "linkedin"
      ]
    },
    {
      "key": "github",
      "profile": "github",
      "match": [
        "github"
      ]
    },
    {
      "key": "website",
      "profile": "website",
      "match": [
        "portfolio",
        "website",
        "site.?web",
        "personal.?(site|url)",
        "\\burl\\b"
      ]
    },
    {
      "key": "city",
      "profile": "city",
      "match": [
        "\\bcity\\b",
        "\\bville\\b",
        "location"
      ]
    },
    {
      "key": "country",
      "profile": "country",
      "match": [
        "country",
        "pays"
      ]
    },
    {
      "key": "postalCode",
      "profile": "postalCode",
      "match": [
        "zip",
        "postal",
        "code postal"
      ]
    },
    {
      "key": "jobTitle",
      "profile": "jobTitle",
      "match": [
        "current.?(title|position)",
        "job.?title",
        "poste actuel"
      ]
    },
    {
      "key": "letter",
      "profile": "$letter",
      "match": [
        "cover.?letter",
        "lettre",
        "motivation",
        "message",
        "additional.?information",
        "tell us",
        "why"
      ],
      "textareaOnly": true
    }
  ],
  "neverTouch": [
    "password",
    "mot de passe",
    "captcha",
    "card",
    "iban",
    "ssn",
    "social.?security",
    "birth",
    "date de naissance",
    "gender",
    "genre",
    "ethnic",
    "veteran",
    "disability",
    "salary",
    "salaire",
    "remuneration",
    "visa",
    "sponsor",
    "authori[sz]ation"
  ]
}
