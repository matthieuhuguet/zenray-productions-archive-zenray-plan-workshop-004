import { useState } from 'react'

// Fabrique un state React persisté dans localStorage. Remplace le triplet dupliqué ~13 fois dans App.jsx :
// lecture initiale paresseuse (localStorage.getItem) + repli sur `defaultValue` si absent/invalide/quota
// dépassé + setter qui réécrit en retour — même best-effort silencieux (try/catch) que le code existant.
//
// Convention de (dé)sérialisation, identique à ce que faisait chaque site à la main :
//   - options.json: true  -> objets/tableaux, (dé)sérialisés en JSON.stringify/JSON.parse.
//   - options.json: false (défaut) -> primitive déduite de `defaultValue` :
//       boolean -> encodé '1'/'0' (lu comme raw === '1') ; number -> String(n) / Number(raw) ; string -> brut.
//   - options.validate(value): optionnel, sanitize toute valeur (persistée ou fraîche) avant de l'accepter ;
//     reproduit les gardes existantes (validView/validFolder) qui auto-réparent un localStorage corrompu
//     (ex. une vue "pages" persistée par erreur) au lieu de planter le rendu.
export function usePersistedState(key, defaultValue, options = {}) {
  const { json = false, validate } = options
  const kind = json ? 'json' : typeof defaultValue

  const decode = (raw) => {
    if (raw == null) return defaultValue
    if (kind === 'json') { try { const v = JSON.parse(raw); return v == null ? defaultValue : v } catch { return defaultValue } }
    if (kind === 'boolean') return raw === '1'
    if (kind === 'number') { const n = Number(raw); return Number.isFinite(n) ? n : defaultValue }
    return raw
  }
  const encode = (value) => (json ? JSON.stringify(value) : kind === 'boolean' ? (value ? '1' : '0') : String(value))

  const [state, setStateRaw] = useState(() => {
    let value = defaultValue
    try { value = decode(localStorage.getItem(key)) } catch { value = defaultValue }
    return validate ? validate(value) : value
  })

  const setState = (updater) => setStateRaw((prev) => {
    const raw = typeof updater === 'function' ? updater(prev) : updater
    const next = validate ? validate(raw) : raw
    try { localStorage.setItem(key, encode(next)) } catch {}
    return next
  })

  return [state, setState]
}
