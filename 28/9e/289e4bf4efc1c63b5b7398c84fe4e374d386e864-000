// 15 October 2026: a request made while Create is not on screen is posted for it (never lost, never an exception), and a request made while it is
// on screen goes straight to it as an event.
import React from 'react'
import { afterEach, describe, expect, it, vi } from 'vitest'
import { cleanup, render } from '@testing-library/react'

vi.mock('../search/searchIndexClient.js', async (importOriginal) => ({ ...(await importOriginal()), loadSearchIndex: async () => ({ paths: [] }) }))

describe('poserDemandePages', () => {
  afterEach(() => { cleanup(); vi.resetModules() })

  it('does not throw when Create is not mounted', async () => {
    const { poserDemandePages } = await import('./Pages.jsx')
    expect(() => poserDemandePages('zr:create-note')).not.toThrow()
    expect(() => poserDemandePages('zr:create-folder', { path: 'pages/Plan' })).not.toThrow()
  })

  it('is the function App.jsx uses (one mailbox, next to its variables)', async () => {
    const pages = await import('./Pages.jsx')
    expect(typeof pages.poserDemandePages).toBe('function')
  })
})
