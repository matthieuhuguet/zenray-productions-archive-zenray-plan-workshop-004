// 2 October 2026, 13:30 CEST: the daily bridge restarts at login without storing its GitHub credential.
import { spawn, execFile } from 'node:child_process'
import { promisify } from 'node:util'
import { mkdir, writeFile } from 'node:fs/promises'
import { fileURLToPath } from 'node:url'
import path from 'node:path'

const exec = promisify(execFile)
const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..')
const settings = { label: 'com.zenray.assets', port: 3100, home: process.env.HOME,
  node: process.execPath, runtime: path.join(process.env.HOME, 'Library/Application Support/ZenRayAssets') }
const xml = (value) => String(value).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;')
const action = process.argv[2] || 'serve'
if (action === 'install') {
  const plist = path.join(settings.home, 'Library/LaunchAgents', `${settings.label}.plist`)
  await mkdir(path.dirname(plist), { recursive: true }); await mkdir(settings.runtime, { recursive: true })
  const content = `<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd"><plist version="1.0"><dict><key>Label</key><string>${settings.label}</string><key>ProgramArguments</key><array><string>${xml(settings.node)}</string><string>${xml(fileURLToPath(import.meta.url))}</string><string>serve</string></array><key>WorkingDirectory</key><string>${xml(root)}</string><key>EnvironmentVariables</key><dict><key>PATH</key><string>${xml(process.env.PATH)}</string></dict><key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>20</integer><key>StandardOutPath</key><string>${xml(path.join(settings.runtime, 'Service.log'))}</string><key>StandardErrorPath</key><string>${xml(path.join(settings.runtime, 'Service.error.log'))}</string></dict></plist>`
  await writeFile(plist, content, { mode: 0o600 })
  await exec('plutil', ['-lint', plist])
  await exec('launchctl', ['bootstrap', `gui/${process.getuid()}`, plist])
  console.log(JSON.stringify({ installed: true, label: settings.label, port: settings.port }))
} else if (action === 'status') {
  const result = await exec('launchctl', ['print', `gui/${process.getuid()}/${settings.label}`])
  console.log(result.stdout.split('\n').filter((line) => /state =|pid =|last exit code =/.test(line)).join('\n'))
} else if (action === 'serve') {
  const credential = process.env.GITHUB_TOKEN || (await exec('gh', ['auth', 'token'])).stdout.trim()
  const child = spawn(settings.node, [path.join(root, 'scripts/local-server.mjs'), String(settings.port)], {
    cwd: root, env: { ...process.env, GITHUB_TOKEN: credential, ZENRAY_API_SECRET: '', ZR_PARENT_PID: String(process.pid) }, stdio: 'inherit',
  })
  process.on('SIGTERM', () => child.kill('SIGTERM'))
  process.on('SIGINT', () => child.kill('SIGINT'))
  child.on('error', () => { console.error('ZenRay Assets service failed to start'); process.exitCode = 1 })
  child.on('exit', (code) => { process.exitCode = code || 0 })
} else throw new Error('Unsupported daemon action')
