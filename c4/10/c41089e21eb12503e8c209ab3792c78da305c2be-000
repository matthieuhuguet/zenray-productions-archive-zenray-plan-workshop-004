// Lecture du manifest (.media.json est sous pages/ => via /api/page action read).
// raw=1 (2026-07-20) : lecture d'affichage sans sha -> raw.githubusercontent, HORS quota API REST
// (règle dure post-incident 403 -- une lecture qui n'écrira pas ne paie jamais le prix du sha).
export async function readManifest(manifestPath) {
  const j = await fetch(`/api/page?action=read&raw=1&path=${enc(manifestPath)}`, { cache: 'no-store' }).then((r) => r.json())
  if (!j || j.error || j.missing) throw new Error('manifest read')
  return JSON.parse(j.markdown)
}

// ── Récupération d'UNE part, schéma-aware (2026-07-20, LE correctif preview/download) ────────────
// BUG RÉEL corrigé : loadChunked/downloadChunkedToDisk fetchaient TOUTES les parts via
// `/api/img?path=media/<id>/NNN.bin` -- un chemin du repo de CONTENU qui n'existe QUE pour l'ancien
// schéma non chiffré. Or TOUT upload UI depuis le passage public+chiffré (universalCapture) pose ses
// parts sur le repo SHARD (cdnRepo, ex. zenrayshards-pdf-<hex12>), chiffrées AES-GCM (ivs[i]) :
// /api/img renvoyait une erreur -> preview ET retéléchargement cassés pour chaque nouveau fichier
// (PDF 31,5 Mo de Matthieu compris). Ici :
//   - schéma PUBLIC CHIFFRÉ (cdnRepo + cdnCommit + ivs) : part lue par le CDN jsDelivr (vert), avec
//     REPLI raw.githubusercontent (bleu) -- indispensable pour un commit tout frais que jsDelivr n'a
//     pas encore propagé (404 pendant quelques minutes) -- puis déchiffrée CÔTÉ CLIENT. ZÉRO Vercel.
//   - schéma LEGACY (pas de cdnRepo) : /api/img comme avant, inchangé (compat totale).
async function fetchPartDecrypted(m, i) {
  // SCHÉMA AUDIO V3 (2026-07-22, LE bug du download 0 Ko) : les manifestes audio portent `parts` = OBJETS
  // {url: jsDelivr…, start, end, size, iv} (buildAudioManifestV3), SANS cdnRepo/cdnCommit/ivs/dir au top-level.
  // fetchPartDecrypted ne reconnaissait que le schéma générique (cdnRepo+ivs) ou legacy (/api/img) -> il
  // tombait sur `/api/img?path=undefined/[object Object].bin` -> 404 -> download 0 Ko. Ici : fetch direct de
  // part.url (jsDelivr, VERT), repli raw.githubusercontent (BLEU, si commit trop frais non propagé), puis
  // déchiffrement AES-GCM avec l'IV DE LA PART. C'est la même voie de lecture que le Service Worker.
  const partObj = m.parts && m.parts[i]
  if (partObj && typeof partObj === 'object' && partObj.url) {
    let r = await fetch(partObj.url).catch(() => null)
    if (!r || !r.ok) {
      const raw = String(partObj.url)
        .replace('https://cdn.jsdelivr.net/gh/', 'https://raw.githubusercontent.com/')
        .replace(/@([^/]+)\//, '/$1/')
      r = await fetch(raw).catch(() => null)
    }
    if (!r || !r.ok) throw new Error('part ' + i + ' inaccessible (CDN et raw)')
    const cipher = await r.arrayBuffer()
    const { decryptBytes } = await import('../media/crypto.js')
    return new Uint8Array(await decryptBytes(cipher, partObj.iv))
  }
  const isEncryptedCdn = !!(m.cdnRepo && m.cdnCommit && Array.isArray(m.ivs))
  const binPath = `${m.dir}/${m.parts[i]}.bin`
  if (!isEncryptedCdn) {
    const buf = await fetch(`/api/img?path=${enc(binPath)}`).then((r) => { if (!r.ok) throw new Error('part ' + i); return r.arrayBuffer() })
    return new Uint8Array(buf)
  }
  // BUG RÉEL corrigé le 2026-07-21 ("déchiffrement infini" + download tronqué) : les URLs étaient
  // construites À LA MAIN avec `m.cdnRepo` -- or les manifestes stockent le repo SANS owner
  // ('zenray-pdf-public-01'), c'est buildJsDelivrUrl/buildRawUrl (shardNaming.js) qui préfixent
  // 'matthieuhuguet/'. Sans owner : gh/<repo>@<commit> est une URL jsDelivr INVALIDE et le raw 404
  // -> 100% des parts échouaient, silencieusement. TOUJOURS passer par les helpers officiels.
  // Parts > 20 Mo (chunks 95 Mo des gros fichiers) : jsDelivr refuse -> raw directement.
  const { buildJsDelivrUrl, buildRawUrl } = await import('../capture/shardNaming.js')
  const { servedByRaw } = await import('../config/chunkPolicy.js')
  const overCdnLimit = servedByRaw(m.chunkSize) // > 20 Mo (source unique chunkPolicy.js) -> raw.github
  let r = null
  if (!overCdnLimit) r = await fetch(buildJsDelivrUrl(m.cdnRepo, m.cdnCommit, binPath)).catch(() => null)
  if (!r || !r.ok) r = await fetch(buildRawUrl(m.cdnRepo, m.cdnCommit, binPath)).catch(() => null)
  if (!r || !r.ok) throw new Error('part ' + i + ' inaccessible (CDN et raw)')
  const cipher = await r.arrayBuffer()
  const { decryptBytes } = await import('../media/crypto.js')
  const clear = await decryptBytes(cipher, m.ivs[i])
  return new Uint8Array(clear)
}

// Réassemblage côté client : télécharge chaque part (proxy /api/img), recolle en Blob ordonné.
// concurrency bornée, ordre garanti par index. onProgress(0..1). Retourne un objectURL.
export async function loadChunked(manifestPath, onProgress, concurrency = 4) {
  const m = await readManifest(manifestPath)
  const out = new Array(m.count)
  let bytes = 0, next = 0
  const worker = async () => {
    while (next < m.count) {
      const idx = next++
      // fetchPartDecrypted : CDN jsDelivr + déchiffrement client pour le schéma public chiffré,
      // /api/img seulement pour le legacy (voir commentaire du helper -- correctif 2026-07-20).
      const buf = await fetchPartDecrypted(m, idx)
      out[idx] = buf
      bytes += buf.byteLength
      if (onProgress) onProgress(Math.min(1, bytes / m.size))
    }
  }
  await Promise.all(Array.from({ length: Math.min(concurrency, m.count) }, worker))
  const blob = new Blob(out, { type: m.mime })
  return { url: URL.createObjectURL(blob), manifest: m, blob }
}

// DOWNLOAD STREAMÉ (anti-OOM) : récupère chaque part via /api/img et l'écrit DIRECTEMENT sur disque (File
// System Access API) ou, à défaut, en Blob borné — au lieu de garder tout le fichier en RAM avant l'enregistrement.
// Sur un gros média mobile, c'est ce qui évite le crash de l'onglet. Réutilise fetchAsset.streamDownloadChunks.
export async function downloadChunkedToDisk(manifestPath, onProgress) {
  const m = await readManifest(manifestPath)
  const { streamDownloadChunks } = await import('../lib/fetchAsset.js')
  await streamDownloadChunks({
    count: m.count,
    name: m.name || 'fichier',
    mime: m.mime || 'application/octet-stream',
    onProgress,
    // Correctif 2026-07-20 (voir fetchPartDecrypted) : le download tirait /api/img sur des parts qui
    // n'y existent pas pour le schéma public chiffré -> "impossible de retélécharger mon fichier".
    getChunk: (i) => fetchPartDecrypted(m, i),
  })
}
