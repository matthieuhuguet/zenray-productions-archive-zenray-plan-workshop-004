// QuickLookAudioPlayer.jsx: lecteur audio Liquid Glass haute fidelite pour QuickLook.
// Concu le 06 October 2026 selon la direction artistique ZenRay (InterVariable + AnthropicSerif pour les chiffres).
// Lecture quasi instantanee, seek direct, Space = Play/Pause, fleches = precedent/suivant.

import React, { useEffect, useRef, useState, useCallback } from 'react'
import { PALETTE, RADII } from '../theme.js'
import Icon from './Icon.jsx'
import { PlayPauseGlyph } from '../media/playerControls.jsx'

function fmt(seconds) {
  if (!Number.isFinite(seconds) || seconds < 0) return '0:00'
  const m = Math.floor(seconds / 60)
  const s = Math.floor(seconds % 60)
  return `${m}:${String(s).padStart(2, '0')}`
}

function formatBytes(bytes) {
  if (!bytes || !Number.isFinite(bytes)) return ''
  if (bytes >= 1048576) return `${(bytes / 1048576).toFixed(1)} Mo`
  if (bytes >= 1024) return `${Math.round(bytes / 1024)} Ko`
  return `${bytes} o`
}

export default function QuickLookAudioPlayer({
  src,
  name,
  manifest,
  onPrev,
  onNext,
  onDownload = null,
  autoPlay = true,
}) {
  const audioRef = useRef(null)
  const [playing, setPlaying] = useState(false)
  const [currentTime, setCurrentTime] = useState(0)
  const [duration, setDuration] = useState(Number(manifest?.duration) || 0)
  const [volume, setVolume] = useState(1)
  const [muted, setMuted] = useState(false)
  const [seeking, setSeeking] = useState(false)
  const [loaded, setLoaded] = useState(false)

  // Synchronisation des metadonnees
  const title = manifest?.title || name?.replace(/\.[^.]+$/, '') || 'Piste audio'
  const subtitle = [
    manifest?.artist || manifest?.album || '',
    manifest?.mime?.replace('audio/', '').toUpperCase() || (name?.split('.').pop() || '').toUpperCase(),
    formatBytes(manifest?.size),
  ].filter(Boolean).join(' · ')

  const coverUrl = manifest?.cover || null

  const togglePlay = useCallback(() => {
    const el = audioRef.current
    if (!el) return
    if (el.paused) {
      el.play().catch(() => {})
    } else {
      el.pause()
    }
  }, [])

  // Raccourci Espace dedie au lecteur audio dans QuickLook
  useEffect(() => {
    const onKeyDown = (e) => {
      if (e.code === 'Space') {
        e.preventDefault()
        e.stopPropagation()
        togglePlay()
      }
    }
    window.addEventListener('keydown', onKeyDown, true)
    return () => window.removeEventListener('keydown', onKeyDown, true)
  }, [togglePlay])

  // Lancement automatique des le montage ou changement de src
  useEffect(() => {
    const el = audioRef.current
    if (!el || !src) return
    setCurrentTime(0)
    setLoaded(false)
    if (autoPlay) {
      el.play().catch(() => {})
    }
  }, [src, autoPlay])

  const onTimeUpdate = () => {
    if (seeking) return
    const el = audioRef.current
    if (el) {
      setCurrentTime(el.currentTime)
      if (Number.isFinite(el.duration) && el.duration > 0 && !duration) {
        setDuration(el.duration)
      }
    }
  }

  const onLoadedMetadata = () => {
    const el = audioRef.current
    if (el) {
      if (Number.isFinite(el.duration) && el.duration > 0) {
        setDuration(el.duration)
      }
      setLoaded(true)
    }
  }

  const onScrubChange = (e) => {
    const val = Number(e.target.value)
    setCurrentTime(val)
  }

  const onScrubStart = () => {
    setSeeking(true)
  }

  const onScrubEnd = (e) => {
    const val = Number(e.target.value)
    setSeeking(false)
    const el = audioRef.current
    if (el) {
      el.currentTime = val
      setCurrentTime(val)
      if (playing) el.play().catch(() => {})
    }
  }

  const toggleMute = () => {
    const el = audioRef.current
    if (!el) return
    const next = !muted
    el.muted = next
    setMuted(next)
  }

  const onVolumeChange = (e) => {
    const val = Number(e.target.value)
    setVolume(val)
    const el = audioRef.current
    if (el) {
      el.volume = val
      if (val === 0) {
        el.muted = true
        setMuted(true)
      } else if (muted) {
        el.muted = false
        setMuted(false)
      }
    }
  }

  const progressPercent = duration > 0 ? Math.min(100, Math.max(0, (currentTime / duration) * 100)) : 0

  return (
    <div
      onClick={(e) => e.stopPropagation()}
      style={{
        width: 'min(540px, 92vw)',
        borderRadius: 24,
        background: 'linear-gradient(135deg, rgba(28, 28, 34, 0.78), rgba(16, 16, 20, 0.92))',
        backdropFilter: 'blur(36px) saturate(180%)',
        WebkitBackdropFilter: 'blur(36px) saturate(180%)',
        boxShadow: 'inset 0 1px 0 rgba(255, 255, 255, 0.22), inset 0 -1px 0 rgba(255, 255, 255, 0.08), 0 30px 80px -15px rgba(0, 0, 0, 0.8)',
        border: '1px solid rgba(255, 255, 255, 0.10)',
        padding: '24px 28px',
        color: '#FFFFFF',
        fontFamily: 'var(--zr-police-sans)',
        display: 'flex',
        flexDirection: 'column',
        gap: 20,
        userSelect: 'none',
      }}
    >
      <audio
        ref={audioRef}
        src={src}
        preload="auto"
        onPlay={() => setPlaying(true)}
        onPause={() => setPlaying(false)}
        onEnded={() => {
          setPlaying(false)
          if (onNext) onNext()
        }}
        onTimeUpdate={onTimeUpdate}
        onLoadedMetadata={onLoadedMetadata}
      />

      {/* Rangée superieure : visuel artwork et informations de la piste */}
      <div style={{ display: 'flex', alignItems: 'center', gap: 20 }}>
        {/* Pochette ou icone son avec effet verre et waveform dynamique */}
        <div
          style={{
            position: 'relative',
            width: 100,
            height: 100,
            flexShrink: 0,
            borderRadius: 18,
            overflow: 'hidden',
            background: 'linear-gradient(135deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.04))',
            boxShadow: '0 12px 32px -8px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.3)',
            display: 'grid',
            placeItems: 'center',
          }}
        >
          {coverUrl ? (
            <img src={coverUrl} alt="" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
          ) : (
            <Icon name="music.note" size={40} color="#FFFFFF" />
          )}

          {/* Barres d'egaliseur animees lors de la lecture */}
          <div
            style={{
              position: 'absolute',
              bottom: 8,
              right: 8,
              display: 'flex',
              alignItems: 'flex-end',
              gap: 3,
              height: 18,
              padding: '2px 4px',
              borderRadius: 6,
              background: 'rgba(0, 0, 0, 0.45)',
              backdropFilter: 'blur(8px)',
            }}
          >
            {[0.4, 0.8, 0.5, 0.9, 0.3].map((heightRatio, i) => (
              <span
                key={i}
                style={{
                  width: 2.5,
                  height: playing ? `${Math.round(heightRatio * 14)}px` : '3px',
                  borderRadius: 2,
                  background: '#FFFFFF',
                  opacity: playing ? 0.95 : 0.45,
                  transition: 'height 180ms ease, opacity 180ms ease',
                }}
              />
            ))}
          </div>
        </div>

        {/* Textes descriptifs de la piste */}
        <div style={{ flex: 1, minWidth: 0, display: 'flex', flexDirection: 'column', gap: 4 }}>
          <div
            style={{
              fontSize: 'var(--zr-ui-lg)',
              fontWeight: 600,
              lineHeight: 1.3,
              color: '#FFFFFF',
              overflow: 'hidden',
              textOverflow: 'ellipsis',
              whiteSpace: 'nowrap',
            }}
            title={title}
          >
            {title}
          </div>
          <div
            style={{
              fontSize: 'var(--zr-ui-sm)',
              fontWeight: 400,
              color: 'rgba(255, 255, 255, 0.65)',
              overflow: 'hidden',
              textOverflow: 'ellipsis',
              whiteSpace: 'nowrap',
            }}
          >
            {subtitle || 'Fichier audio'}
          </div>
          {manifest?.vis === 'public' && (
            <div style={{ marginTop: 6, display: 'inline-flex', alignItems: 'center', gap: 6 }}>
              <span
                style={{
                  display: 'inline-block',
                  width: 6,
                  height: 6,
                  borderRadius: '50%',
                  background: '#34C759',
                  boxShadow: '0 0 8px #34C759',
                }}
              />
              <span style={{ fontSize: 'var(--zr-ui-xs)', color: 'rgba(255, 255, 255, 0.6)' }}>
                jsDelivr · stream direct
              </span>
            </div>
          )}
        </div>
      </div>

      {/* Barre de progression avec horodatages en police serif conforme a la regle des nombres */}
      <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
        <div
          style={{
            position: 'relative',
            width: '100%',
            height: 6,
            borderRadius: 999,
            background: 'rgba(255, 255, 255, 0.15)',
            cursor: 'pointer',
          }}
        >
          <div
            style={{
              position: 'absolute',
              top: 0,
              left: 0,
              height: '100%',
              width: `${progressPercent}%`,
              borderRadius: 999,
              background: '#FFFFFF',
              boxShadow: '0 0 10px rgba(255, 255, 255, 0.45)',
            }}
          />
          <input
            type="range"
            min={0}
            max={duration || 100}
            step={0.1}
            value={currentTime}
            onChange={onScrubChange}
            onMouseDown={onScrubStart}
            onTouchStart={onScrubStart}
            onMouseUp={onScrubEnd}
            onTouchEnd={onScrubEnd}
            style={{
              position: 'absolute',
              inset: 0,
              width: '100%',
              height: '100%',
              opacity: 0,
              cursor: 'pointer',
              margin: 0,
            }}
          />
        </div>

        {/* Chiffres en AnthropicSerif Regular 400 selon la doctrine typographique */}
        <div
          style={{
            display: 'flex',
            justifyContent: 'space-between',
            fontFamily: 'var(--zr-police-serif)',
            fontSize: 'var(--zr-ui-sm)',
            fontWeight: 400,
            color: 'rgba(255, 255, 255, 0.65)',
          }}
        >
          <span>{fmt(currentTime)}</span>
          <span>{duration > 0 ? fmt(duration) : (loaded ? '0:00' : '…')}</span>
        </div>
      </div>

      {/* Barre de transport principale : Precedent, Lecture/Pause, Suivant et Volume */}
      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', paddingTop: 2 }}>
        {/* Controle volume discret */}
        <div style={{ display: 'flex', alignItems: 'center', gap: 8, width: 110 }}>
          <button
            onClick={toggleMute}
            style={{
              background: 'transparent',
              border: 0,
              color: muted ? 'rgba(255, 255, 255, 0.4)' : '#FFFFFF',
              cursor: 'pointer',
              padding: 4,
              display: 'grid',
              placeItems: 'center',
            }}
            title={muted ? 'Activer le son' : 'Couper le son'}
          >
            <Icon name={muted ? 'speaker.slash' : volume > 0.5 ? 'speaker.wave.2' : 'speaker.wave.1'} size={18} />
          </button>
          <input
            type="range"
            min={0}
            max={1}
            step={0.05}
            value={muted ? 0 : volume}
            onChange={onVolumeChange}
            style={{
              width: 60,
              height: 4,
              accentColor: PALETTE.primary,
              cursor: 'pointer',
            }}
          />
        </div>

        {/* Boutons de transport centraux */}
        <div style={{ display: 'flex', alignItems: 'center', gap: 14 }}>
          <button
            onClick={(e) => {
              e.stopPropagation()
              if (onPrev) onPrev()
            }}
            style={{
              width: 38,
              height: 38,
              borderRadius: '50%',
              border: '1px solid rgba(255, 255, 255, 0.12)',
              background: 'rgba(255, 255, 255, 0.08)',
              color: '#FFFFFF',
              cursor: 'pointer',
              display: 'grid',
              placeItems: 'center',
              transition: 'background 140ms ease, transform 140ms ease',
            }}
            onMouseEnter={(e) => (e.currentTarget.style.background = 'rgba(255, 255, 255, 0.16)')}
            onMouseLeave={(e) => (e.currentTarget.style.background = 'rgba(255, 255, 255, 0.08)')}
            title="Piste precedente (Fleche Gauche)"
          >
            <Icon name="backward.fill" size={15} />
          </button>

          <button
            onClick={(e) => {
              e.stopPropagation()
              togglePlay()
            }}
            style={{
              width: 52,
              height: 52,
              borderRadius: '50%',
              border: 0,
              background: '#FFFFFF',
              color: '#000000',
              boxShadow: '0 8px 24px rgba(0, 0, 0, 0.35)',
              cursor: 'pointer',
              display: 'grid',
              placeItems: 'center',
              transition: 'transform 140ms ease, filter 140ms ease',
            }}
            onMouseEnter={(e) => (e.currentTarget.style.filter = 'brightness(1.12)')}
            onMouseLeave={(e) => (e.currentTarget.style.filter = 'none')}
            title="Lecture / Pause (Espace)"
          >
            <PlayPauseGlyph playing={playing} size={22} playOffset={2} />
          </button>

          <button
            onClick={(e) => {
              e.stopPropagation()
              if (onNext) onNext()
            }}
            style={{
              width: 38,
              height: 38,
              borderRadius: '50%',
              border: '1px solid rgba(255, 255, 255, 0.12)',
              background: 'rgba(255, 255, 255, 0.08)',
              color: '#FFFFFF',
              cursor: 'pointer',
              display: 'grid',
              placeItems: 'center',
              transition: 'background 140ms ease, transform 140ms ease',
            }}
            onMouseEnter={(e) => (e.currentTarget.style.background = 'rgba(255, 255, 255, 0.16)')}
            onMouseLeave={(e) => (e.currentTarget.style.background = 'rgba(255, 255, 255, 0.08)')}
            title="Piste suivante (Fleche Droite)"
          >
            <Icon name="forward.fill" size={15} />
          </button>
        </div>

        {/* Bouton de telechargement direct dans le lecteur audio */}
        <div style={{ width: 110, display: 'flex', alignItems: 'center', justifyContent: 'flex-end' }}>
          {onDownload ? (
            <button
              type="button"
              onClick={(e) => {
                e.stopPropagation()
                onDownload()
              }}
              style={{
                background: 'rgba(255, 255, 255, 0.12)',
                border: '1px solid rgba(255, 255, 255, 0.2)',
                color: '#FFFFFF',
                borderRadius: 8,
                padding: '4px 9px',
                cursor: 'pointer',
                display: 'inline-flex',
                alignItems: 'center',
                gap: 5,
                fontSize: 'var(--zr-ui-xs)',
                fontWeight: 500,
                transition: 'background 140ms ease',
              }}
              onMouseEnter={(e) => (e.currentTarget.style.background = 'rgba(255, 255, 255, 0.24)')}
              onMouseLeave={(e) => (e.currentTarget.style.background = 'rgba(255, 255, 255, 0.12)')}
              title="Télécharger ce fichier audio"
            >
              <Icon name="arrow.down.circle" size={13} color="#FFFFFF" />
              <span>Télécharger</span>
            </button>
          ) : (
            <span style={{ fontSize: 'var(--zr-ui-xs)', color: 'rgba(255, 255, 255, 0.45)' }}>
              Espace : ▶ / ⏸
            </span>
          )}
        </div>
      </div>
    </div>
  )
}
