// PublishMotions.test.js (12 October 2026, 11:45 CEST): the publisher end to end against LOCAL bare repositories (no
// network, no GitHub): one push writes neutral public paths and ONE private commit whose catalogue is green; a second
// run publishes nothing (versions are immutable); a motion without cleared rights is refused; the catalogue checker
// turns red on a broken catalogue. Both ways, so the checker is proven to look.
import { describe, expect, it } from 'vitest'
import { execFileSync, spawnSync } from 'node:child_process'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { checkCatalogue, assignPublicIds, versionPaths, isNeutralPublicPath, fidelityNumbers } from './MotionPublish.mjs'

const HERE = path.dirname(new URL(import.meta.url).pathname)
const SOURCE = '/Users/zenray/.claude/tmp/tmp-zenray-motion-design/motions/onekey-s02-caption-shine/V_008'
const git = (cwd, ...args) => execFileSync('git', ['-C', cwd, ...args], { encoding: 'utf8' })
const SHARD = 'zenrayshards-motion-aaaaaaaaaaaa'

function bareWith(root, name, files) {
  const bare = path.join(root, `${name}.git`)
  execFileSync('git', ['init', '--quiet', '--bare', '--initial-branch', 'main', bare])
  const seed = path.join(root, `${name}-seed`)
  execFileSync('git', ['clone', '--quiet', bare, seed])
  for (const [rel, text] of Object.entries(files)) { fs.mkdirSync(path.dirname(path.join(seed, rel)), { recursive: true }); fs.writeFileSync(path.join(seed, rel), text) }
  git(seed, 'add', '-A'); git(seed, '-c', 'user.name=t', '-c', 'user.email=t@t', 'commit', '--quiet', '-m', 'seed'); git(seed, 'push', '--quiet', 'origin', 'HEAD:main')
  return bare
}

function workshopWith(root, id, rights) {
  const v = path.join(root, 'workshop', 'motions', id, 'V_001')
  fs.mkdirSync(v, { recursive: true })
  for (const f of ['params.json', 'render.mp4', 'poster.jpg', 'fidelity.json']) fs.copyFileSync(path.join(SOURCE, f), path.join(v, f))
  fs.writeFileSync(path.join(v, 'version.json'), JSON.stringify({ version: 'V_001', parent: null, created: '12 October 2026', note: 'test' }))
  fs.writeFileSync(path.join(root, 'workshop', 'motions', id, 'motion.json'), JSON.stringify({ id, title: 'Self test', recipe: 'textcard', latest: 'V_001', tags: ['test'], ...(rights ? { rights: { cleared: true } } : {}) }))
}

const publish = (root, extra = []) => spawnSync('node', [path.join(HERE, 'PublishMotions.mjs'), '--workshop', path.join(root, 'workshop'), '--clone', path.join(root, 'clone'),
  '--work', path.join(root, 'work'), '--private-remote', path.join(root, 'data.git'), '--public-remote-template', path.join(root, '{repo}.git'), '--skip-cdn-check', ...extra], { encoding: 'utf8' })

describe('ZenRay Motion Design publisher', () => {
  it('publishes once, neutrally, in one private commit, and refuses uncleared content', () => {
    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'zrmd-publish-'))
    workshopWith(root, 'selftest-brandname', true)
    workshopWith(root, 'uncleared', false)
    bareWith(root, 'data', { 'README.md': 'data', 'pages/ZenRayMotionDesign/.zr-motion-shard.json': JSON.stringify({ active: SHARD, bytes: 0 }) })
    bareWith(root, SHARD, { 'README.md': 'public shard' })

    const first = publish(root, ['--motion', 'selftest-brandname', '--push'])
    const out = JSON.parse(first.stdout.trim().split('\n').at(-1))
    expect(out.ok, first.stdout + first.stderr).toBe(true)
    expect(out.published).toBe(1)
    expect(out.versions[0].public).toBe('zrmd-0001')

    const data = path.join(root, 'data-check'); execFileSync('git', ['clone', '--quiet', path.join(root, 'data.git'), data])
    expect(git(data, 'log', '--format=%s', '-1').trim()).toBe('motion catalogue')
    expect(git(data, 'show', '--name-only', '--format=', 'HEAD').trim().split('\n').length).toBeGreaterThanOrEqual(9)
    const catalogue = JSON.parse(fs.readFileSync(path.join(data, 'pages/ZenRayMotionDesign/catalogue.json'), 'utf8'))
    expect(checkCatalogue(catalogue, (rel) => fs.existsSync(path.join(data, rel)))).toEqual([])
    expect(JSON.stringify(catalogue)).not.toContain('brandname')
    const manifest = JSON.parse(fs.readFileSync(path.join(data, catalogue.motions[0].latest.media), 'utf8'))
    expect(manifest.type).toBe('hls')
    expect(manifest.poster).toMatch(new RegExp(`^https://cdn\\.jsdelivr\\.net/gh/matthieuhuguet/${SHARD}@[0-9a-f]{40}/zrmd-0001/v001-16x9/poster\\.jpg$`))
    expect(fs.readFileSync(path.join(data, manifest.master), 'utf8')).toContain('/api/hls?path=')

    const pub = path.join(root, 'pub-check'); execFileSync('git', ['clone', '--quiet', path.join(root, `${SHARD}.git`), pub])
    const files = git(pub, 'ls-files').trim().split('\n').filter((f) => f !== 'README.md')
    expect(files.length).toBeGreaterThan(2)
    expect(files.every((f) => isNeutralPublicPath(f))).toBe(true)
    expect(git(pub, 'log', '--format=%s', '-1').trim()).toBe('motion segments')

    const again = JSON.parse(publish(root, ['--motion', 'selftest-brandname', '--push']).stdout.trim().split('\n').at(-1))
    expect(again.ok).toBe(true)
    expect(again.published).toBe(0)

    const refused = publish(root, ['--motion', 'uncleared', '--push'])
    expect(refused.status).toBe(2)
    expect(JSON.parse(refused.stdout.trim()).code).toBe('refused')

    const check = spawnSync('node', [path.join(HERE, 'CheckCatalogue.mjs'), '--clone', data], { encoding: 'utf8' })
    expect(check.status).toBe(0)
    fs.rmSync(path.join(data, catalogue.motions[0].latest.media))
    const red = spawnSync('node', [path.join(HERE, 'CheckCatalogue.mjs'), '--clone', data], { encoding: 'utf8' })
    expect(red.status).toBe(1)
    expect(JSON.parse(red.stdout).problems.join(' ')).toContain('manifeste absent')
  }, 180000)

  it('checks the invariants both ways', () => {
    const good = { kind: 'zenray-motion-catalogue', motionCount: 1, motions: [{ id: 'zrmd-0001', zmotion: 'a', latest: { version: 'V_001', media: 'b',
      poster: 'https://cdn.jsdelivr.net/gh/matthieuhuguet/zenrayshards-motion-aaaaaaaaaaaa@0123456/zrmd-0001/v001-16x9/poster.jpg', durationSec: 1.35, width: 1920, height: 1080, fps: 60,
      fidelity: { overall: 0.96, image: 0.97, target: 0.99, weakest: 'animation', verdict: 'below-target', report: 'x' } } }] }
    expect(checkCatalogue(good, () => true)).toEqual([])
    const bad = JSON.parse(JSON.stringify(good))
    bad.motions[0].id = 'onekey-s02'
    bad.motions[0].latest.poster = '/api/raw-proxy?repo=x&path=poster.jpg'
    bad.motions[0].latest.fidelity.overall = 96
    bad.motionCount = 2
    const problems = checkCatalogue(bad, () => false).join(' | ')
    for (const word of ['non neutre', 'fiche absente', 'manifeste absent', 'jsDelivr', 'hors de 0..1', 'motionCount']) expect(problems).toContain(word)
  })

  it('assigns stable neutral ids and paths', () => {
    const a = assignPublicIds(null, ['b-motion', 'a-motion'])
    expect(a.ids).toEqual({ 'b-motion': 'zrmd-0001', 'a-motion': 'zrmd-0002' })
    expect(assignPublicIds(a, ['a-motion', 'c']).ids.c).toBe('zrmd-0003')
    const p = versionPaths('zrmd-0007', 'V_042', '9x16')
    expect(p.publicDir).toBe('zrmd-0007/v042-9x16')
    expect(isNeutralPublicPath('zrmd-0007/v042-9x16/chunk_0_00001.m4s')).toBe(true)
    expect(isNeutralPublicPath('onekey/v042/poster.jpg')).toBe(false)
    expect(fidelityNumbers({ score: 0.995, dimensions: { image: 0.99 } }).verdict).toBe('at-target')
  })
})
