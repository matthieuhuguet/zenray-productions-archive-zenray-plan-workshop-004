// Dossier « bibliothèque musicale » : marqueur `.zrmusic.json` posé DANS un dossier (même modèle que
// .zrfolder.json / .zrvis.json dans App.jsx et src/capture/folderVisibility.js — un fichier ENFANT du
// dossier, pas une entrée indexée séparément par chemin). Contrairement à un test de préfixe en dur
// ('pages/Music/'), ce marqueur VOYAGE avec le dossier lors d'un renommage/déplacement (move-tree copie
// tous les fichiers du sous-arbre, marqueur inclus) : un renommage du dossier musique ne casse plus
// silencieusement le routage vers le lecteur (audit 2026-07-15, App.jsx openEntry).
//
// Résolution 100% synchrone/en mémoire depuis `allPaths` (déjà chargé par le Finder, action=tree) : AUCUN
// fetch dédié, contrairement à folderVisibility.js qui doit interroger le serveur (la visibilité n'est pas
// déjà présente dans l'arbre global). Ici le marqueur, comme tout fichier, apparaît directement dans
// `paths` dès qu'il est commité.

export const MUSIC_FLAG_FILE = '.zrmusic.json'

// Construit l'ensemble des dossiers marqués à partir d'une liste de chemins plats (allPaths). O(n), pensé
// pour tourner dans un useMemo dépendant de `allPaths` (comme nonEmptyDirs dans App.jsx).
export function collectMusicFlagDirs(paths) {
  const s = new Set()
  const suffix = '/' + MUSIC_FLAG_FILE
  for (const p of paths || []) { if (p.endsWith(suffix)) s.add(p.slice(0, -suffix.length)) }
  return s
}

// Vrai si `contentPath` est sous un dossier marqué (remonte les ancêtres jusqu'à la racine).
export function isUnderMusicFolder(contentPath, flagDirs) {
  if (!contentPath || !flagDirs || !flagDirs.size) return false
  const slash0 = contentPath.lastIndexOf('/')
  if (slash0 < 0) return false
  let dir = contentPath.slice(0, slash0)
  while (dir) {
    if (flagDirs.has(dir)) return true
    const slash = dir.lastIndexOf('/')
    if (slash < 0) break
    dir = dir.slice(0, slash)
  }
  return false
}
