// 4 October 2026, 10:20 CEST: archived conversation identities remain visible after an original disappears.
export function conversationArchiveEntries(entries, files, { cloud = false } = {}) {
  return Object.entries(entries || {}).map(([id, entry]) => {
    const copies = (entry.copies || []).map(copy => files.find(file => file.relativePath === copy.relativePath)).filter(Boolean)
    const available = copies.filter(file => file.present && file.localPath)
    return { ...entry.summary, id, cloudPath: copies[0]?.cloudPath || null,
      backupState: copies.length > 0 && copies.every(file => ['backed-up', 'verified'].includes(file.status)) ? 'verified-copy' : 'staged',
      readable: available.length > 0, unavailableReason: 'archive-only', archiveCopy: true, dateBasis: 'archive',
      ...(!cloud ? { localPath: available[0]?.localPath || entry.copies?.[0]?.originalPath || null, transcriptPaths: available.map(file => file.localPath), originalPaths: (entry.copies || []).map(copy => copy.originalPath) } : {}) }
  })
}
