import { describe, expect, it } from 'vitest'
import { getIndexPaths, injectSearchIndexPaths, loadSearchIndex, rollbackSearchIndexPaths, subscribeSearchIndex } from './searchIndexClient.js'

describe('optimistic Eagle placement index', () => {
  it('rend le placement cherchable immédiatement et sait annuler un lot atomique', async () => {
    const paths = ['pages/Projet/dragon.hda.file.json', 'pages/Projet/music.media.json']
    injectSearchIndexPaths(paths)
    expect(getIndexPaths()).toEqual(expect.arrayContaining(paths))
    expect((await loadSearchIndex()).paths).toEqual(expect.arrayContaining(paths))

    rollbackSearchIndexPaths(paths)
    expect(getIndexPaths()).not.toEqual(expect.arrayContaining(paths))
  })

  it('notifie les vues ouvertes quand les chemins indexés changent', () => {
    const updates = []
    const unsubscribe = subscribeSearchIndex((index) => updates.push(index.paths))
    const path = 'pages/Projet/reference.png.file.json'

    injectSearchIndexPaths([path])
    expect(updates.at(-1)).toContain(path)

    rollbackSearchIndexPaths([path])
    expect(updates.at(-1)).not.toContain(path)
    unsubscribe()
  })
})
