    expect(await readFile(path.join(root, 'empty-tail.jsonl'), 'utf8')).toBe(original)
  } finally { await rm(home, { recursive: true, force: true }) }
})

// 9 October 2026, 14:46 CEST: a long Codex turn opens with its latest prompt and final answer together.
it('anchors the latest Codex answer to its prompt across tool-only windows', async () => {
  const home = await mkdtemp(path.join(os.tmpdir(), 'conversation-prompt-anchor-'))
  try {
    const root = path.join(home, '.codex/sessions'); await mkdir(root, { recursive: true })
    const turnId = 'prompt-anchor-turn', answer = 'Here is the readable answer.'
    const prompt = { type: 'response_item', timestamp: '2026-10-09T12:00:00.000Z', payload: { type: 'message', role: 'user', content: [{ type: 'input_text', text: 'Show the prompt linked to this answer.' }] } }
    const toolRecords = Array.from({ length: 5 }, (_, index) => ({ type: 'event_msg', timestamp: `2026-10-09T12:0${index + 1}:00.000Z`, payload: { type: 'tool_output', text: 'x'.repeat(1_200_000) } }))
    const final = { type: 'response_item', timestamp: '2026-10-09T12:10:00.000Z', metadata: { retained_source: { id: { turn_id: turnId, role: 'assistant' } } }, payload: { type: 'message', role: 'assistant', phase: 'final_answer', content: [{ type: 'output_text', text: answer }] } }
    const complete = { type: 'event_msg', timestamp: '2026-10-09T12:10:00.100Z', payload: { type: 'task_complete', turn_id: turnId, last_agent_message: answer, error: null } }
    const original = [{ type: 'session_meta', payload: { id: 'prompt-anchor-session' } }, prompt, ...toolRecords, final, complete].map(JSON.stringify).join('\n') + '\n'
    const filename = path.join(root, 'prompt-anchor.jsonl'); await writeFile(filename, original)
    const catalog = createConversationCatalog({ home, stateDir: home })
    const result = await catalog.read('codex:prompt-anchor-session')
    expect(result.messages.map(message => message.kind)).toEqual(['prompt', 'iteration'])
    expect(result.messages.map(message => message.text)).toEqual(['Show the prompt linked to this answer.', answer])
    expect(result.promptAnchorFound).toBe(true)
    expect(await readFile(filename, 'utf8')).toBe(original)
  } finally { await rm(home, { recursive: true, force: true }) }
})

// 6 October 2026, 21:05 CEST: a resumed Claude session begins with its ancestor's records; the file name stays its identity and the card joins it.
it('keeps the transcript file name as the identity of a resumed Claude session and its human card title', async () => {
  const home = await mkdtemp(path.join(os.tmpdir(), 'conversation-resumed-'))
  try {
    const transcripts = path.join(home, '.claude/projects/project'), cards = path.join(home, 'Library/Application Support/Claude/claude-code-sessions/account/workspace')
    await mkdir(transcripts, { recursive: true }); await mkdir(cards, { recursive: true })
    const parent = '11111111-1111-4111-8111-111111111111', child = '22222222-2222-4222-8222-222222222222'
    const row = (sessionId, timestamp, text) => JSON.stringify({ sessionId, type: 'user', timestamp, message: { role: 'user', content: text } }) + '\n'
    await writeFile(path.join(transcripts, parent + '.jsonl'), row(parent, '2026-09-15T10:00:00Z', 'Old project prompt'))
    await writeFile(path.join(transcripts, child + '.jsonl'), row(parent, '2026-09-15T10:00:00Z', 'Old project prompt') + row(child, '2026-10-06T10:00:00Z', 'Lily prompt'))
    await writeFile(path.join(cards, 'local_child.json'), JSON.stringify({ sessionId: 'local_child', cliSessionId: child, title: 'Vegetation materials', lastActivityAt: Date.parse('2026-10-06T09:00:00Z') }))
    const catalog = createConversationCatalog({ home, stateDir: home }), result = await catalog.list()
    const resumed = result.conversations.find(item => item.id === 'claude:' + child)
    expect(result.conversations.map(item => item.id).sort()).toEqual(['claude:' + parent, 'claude:' + child])
    expect(resumed).toMatchObject({ readable: true, title: 'Vegetation materials', ancestorSessionIds: [parent] })
    expect((await catalog.read(resumed.id)).messages.map(message => message.text)).toEqual(['Old project prompt', 'Lily prompt'])
    expect(result.conversations.find(item => item.id === 'claude:' + parent).ancestorSessionIds).toEqual([])
  } finally { await rm(home, { recursive: true, force: true }) }
})

// 9 October 2026, 16:22 CEST: keep the first Codex page anchored when the latest prompt is more than 72 windows back.
it('keeps a bounded buffer for a real prompt 92 windows behind the latest answer', async () => {
  const home = await mkdtemp(path.join(os.tmpdir(), 'conversation-measured-anchor-distance-'))
  const previousWindowBytes = CONVERSATION_LIMITS.windowBytes
  const previousPromptLimit = CONVERSATION_LIMITS.initialPromptScanLimit
  try {
    const root = path.join(home, '.codex/sessions'); await mkdir(root, { recursive: true })
    const makeLine = record => {
      const padded = { ...record, pad: '' }
      const base = JSON.stringify(padded)
      const paddingLength = 255 - base.length
      expect(paddingLength).toBeGreaterThanOrEqual(0)
      return JSON.stringify({ ...record, pad: 'x'.repeat(paddingLength) })
    }
    const noise = { type: 'event_msg', payload: { type: 'tool_output', text: 'ignored' } }
    const prompt = { type: 'response_item', timestamp: '2026-10-09T09:40:23.482Z', payload: { type: 'message', role: 'user', content: [{ type: 'input_text', text: 'Show this prompt with its answer.' }] } }
    const answer = { type: 'response_item', timestamp: '2026-10-09T13:54:26.012Z', payload: { type: 'message', role: 'assistant', phase: 'final_answer', content: [{ type: 'output_text', text: 'Here is the answer.' }] } }
    const rows = []
    for (let index = 0; index < 100; index++) {
      const first = index === 0 ? { type: 'session_meta', payload: { id: 'measured-anchor-session' } } : noise
      const second = index === 53 ? prompt : index === 99 ? answer : noise
      rows.push(makeLine(first), makeLine(second))
    }
    const original = rows.join('\n') + '\n'
    const filename = path.join(root, 'measured-anchor.jsonl'); await writeFile(filename, original)
    CONVERSATION_LIMITS.windowBytes = 512
    CONVERSATION_LIMITS.initialPromptScanLimit = 72
    const shortRead = await createConversationCatalog({ home, stateDir: home }).read('codex:measured-anchor-session')
    expect(shortRead.promptAnchorFound).toBe(false)
    expect(shortRead.messages.map(message => message.kind)).toEqual(['iteration'])
    CONVERSATION_LIMITS.initialPromptScanLimit = 128
    const bufferedRead = await createConversationCatalog({ home, stateDir: home }).read('codex:measured-anchor-session')
    expect(bufferedRead.promptAnchorFound).toBe(true)
    expect(bufferedRead.messages.map(message => message.text)).toEqual(['Show this prompt with its answer.', 'Here is the answer.'])
    expect(await readFile(filename, 'utf8')).toBe(original)
  } finally {
    CONVERSATION_LIMITS.windowBytes = previousWindowBytes
    CONVERSATION_LIMITS.initialPromptScanLimit = previousPromptLimit
    await rm(home, { recursive: true, force: true })
  }
})
