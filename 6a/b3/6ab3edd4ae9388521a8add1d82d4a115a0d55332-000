  } finally { await rm(home, { recursive: true, force: true }) }
})

// 5 October 2026, 13:32 CEST: a large image line still allows reaching the previous real prompt.
// 9 October 2026, 14:52 CEST: the initial page now reaches that prompt directly and ends pagination cleanly.
it('opens at the prompt before an oversized image line without a dead cursor', async () => {
  const home = await mkdtemp(path.join(os.tmpdir(), 'conversation-large-line-'))
  try {
    const root = path.join(home, '.codex/sessions'); await mkdir(root, { recursive: true })
    const rows = [
      { type: 'session_meta', payload: { id: 'large-session' } },
      { type: 'response_item', timestamp: '2026-10-05T10:00:00Z', payload: { role: 'user', content: [{ type: 'input_text', text: 'Previous actual prompt' }] } },
      { type: 'image', data: 'x'.repeat(CONVERSATION_LIMITS.windowBytes + 100) },
    ]
    const original = rows.map(JSON.stringify).join('\n') + '\n'
    const filename = path.join(root, 'large.jsonl'); await writeFile(filename, original)
    const catalog = createConversationCatalog({ home, stateDir: home })
    const first = await catalog.read('codex:large-session')
    expect(first.messages.some(message => message.text === 'Previous actual prompt')).toBe(true)
    expect(first.nextBefore).toBeNull()
    expect(await readFile(filename, 'utf8')).toBe(original)
  } finally { await rm(home, { recursive: true, force: true }) }
})

// 9 October 2026, 14:26 CEST: initial reads skip bounded tool-only windows to expose the latest message immediately.
