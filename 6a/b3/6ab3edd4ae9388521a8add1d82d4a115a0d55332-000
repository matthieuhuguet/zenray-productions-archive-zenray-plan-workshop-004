  const home = await mkdtemp(path.join(os.tmpdir(), 'conversation-empty-tail-'))
  try {
    const root = path.join(home, '.codex/sessions'); await mkdir(root, { recursive: true })
    const prompt = { type: 'response_item', timestamp: '2026-10-09T12:00:00Z', payload: { type: 'message', role: 'user', content: [{ type: 'input_text', text: 'Please show the latest user prompt.' }] } }
    const toolRecords = Array.from({ length: 5 }, (_, index) => ({ type: 'event_msg', timestamp: `2026-10-09T12:0${index + 1}:00Z`, payload: { type: 'tool_output', text: 'x'.repeat(1_200_000) } }))
    const rows = [{ type: 'session_meta', payload: { id: 'empty-tail-session' } }, prompt, ...toolRecords]
    const original = rows.map(JSON.stringify).join('\n') + '\n'
