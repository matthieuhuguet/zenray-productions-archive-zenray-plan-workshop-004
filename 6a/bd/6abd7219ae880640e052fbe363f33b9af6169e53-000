// SfxQuickListView.jsx: explorateur et ecoute rapide SFX multi-fichiers.
// Concu le 06 October 2026 pour ZenRayProgress.
// Interface minimale, epuree et reactive : support theme blanc et dark mode, sans ocre.

import React, { useEffect, useRef, useState, useMemo, useCallback } from 'react'
import { createPortal } from 'react-dom'
import { FONTS, PALETTE } from '../theme.js'
import Icon from './Icon.jsx'
import { downloadMedia } from './ImageNodeViewer.jsx'
import {
  isAudioEntry,
  readAudioManifestCached,
  resolveAudioUrlFast,
  prefetchAudioNeighbors,
  getCachedAudioManifest,
  getCachedAudioUrl,
} from '../audio/audioQuickCache.js'

function formatSeconds(sec) {
  if (!Number.isFinite(sec) || sec < 0) return '0:00'
  const m = Math.floor(sec / 60)
  const s = Math.floor(sec % 60)
  return `${m}:${String(s).padStart(2, '0')}`
}

function cleanTrackName(raw) {
  if (!raw) return 'Piste audio'
  return raw
    .replace(/\.(media|file)\.json$/i, '')
    .replace(/\.(mp3|wav|m4a|aac|flac|ogg|opus|aiff)$/i, '')
    .replace(/^pages\//, '')
}

function safePlay(el) {
  if (!el) return
  try {
    const p = el.play()
    if (p && typeof p.catch === 'function') p.catch(() => {})
  } catch {}
}

export default function SfxQuickListView({
  open = false,
  onClose,
  t,
  theme,
  entries = [],
  initialIndex = 0,
}) {
  const audioRef = useRef(null)
  const listRef = useRef(null)
  const activeRowRef = useRef(null)

  // Filtrage des entrees strictement audio
  const audioList = useMemo(() => {
    return (entries || []).filter((e) => isAudioEntry(e))
  }, [entries])

  const [filterQuery, setFilterQuery] = useState('')
  const [selectedIndex, setSelectedIndex] = useState(
    Math.max(0, Math.min(initialIndex, audioList.length - 1))
  )
  const [playing, setPlaying] = useState(false)
  const [currentTime, setCurrentTime] = useState(0)
  const [duration, setDuration] = useState(0)
  const [volume, setVolume] = useState(1)
  const [currentUrl, setCurrentUrl] = useState('')
  const [metaMap, setMetaMap] = useState({})
  const [seeking, setSeeking] = useState(false)

  // Detection du mode sombre vs clair (defaut sombre propre ou blanc selon theme)
  const isDark = theme === 'dark' || t?.textPrimary === PALETTE?.textPrimaryDark || (typeof document !== 'undefined' && document.body?.classList?.contains('zr-dark'))

  // Palette binaire epuree : blanc pur en mode clair, sombre pur en mode dark (zero ocre)
  const c = isDark ? {
    modalBg: 'rgba(20, 20, 22, 0.96)',
    modalBorder: '1px solid rgba(255, 255, 255, 0.12)',
    modalShadow: '0 24px 64px -12px rgba(0, 0, 0, 0.85)',
    text: '#FFFFFF',
    textMuted: 'rgba(255, 255, 255, 0.55)',
    textDim: 'rgba(255, 255, 255, 0.35)',
    headerBorder: '1px solid rgba(255, 255, 255, 0.08)',
    inputBg: 'rgba(255, 255, 255, 0.07)',
    inputBorder: '1px solid rgba(255, 255, 255, 0.12)',
    badgeBg: 'rgba(255, 255, 255, 0.08)',
    badgeText: 'rgba(255, 255, 255, 0.8)',
    rowHover: 'rgba(255, 255, 255, 0.05)',
    rowSelected: 'rgba(255, 255, 255, 0.12)',
    rowSelectedBorder: '1px solid rgba(255, 255, 255, 0.20)',
    playBtnBg: '#FFFFFF',
    playBtnIcon: '#000000',
    playBtnInactive: 'rgba(255, 255, 255, 0.10)',
    playBtnInactiveIcon: '#FFFFFF',
    footerBg: 'rgba(16, 16, 18, 0.98)',
    footerBorder: '1px solid rgba(255, 255, 255, 0.08)',
    trackBg: 'rgba(255, 255, 255, 0.15)',
    trackFill: '#FFFFFF',
    btnSecondaryBg: 'rgba(255, 255, 255, 0.08)',
    btnSecondaryBorder: '1px solid rgba(255, 255, 255, 0.12)',
    btnSecondaryColor: '#FFFFFF',
  } : {
    modalBg: 'rgba(255, 255, 255, 0.98)',
    modalBorder: '1px solid rgba(0, 0, 0, 0.10)',
    modalShadow: '0 24px 64px -12px rgba(0, 0, 0, 0.18)',
    text: '#111111',
    textMuted: 'rgba(0, 0, 0, 0.55)',
    textDim: 'rgba(0, 0, 0, 0.35)',
    headerBorder: '1px solid rgba(0, 0, 0, 0.08)',
    inputBg: 'rgba(0, 0, 0, 0.04)',
    inputBorder: '1px solid rgba(0, 0, 0, 0.10)',
    badgeBg: 'rgba(0, 0, 0, 0.05)',
    badgeText: 'rgba(0, 0, 0, 0.75)',
    rowHover: 'rgba(0, 0, 0, 0.03)',
    rowSelected: 'rgba(0, 0, 0, 0.07)',
    rowSelectedBorder: '1px solid rgba(0, 0, 0, 0.14)',
    playBtnBg: '#111111',
    playBtnIcon: '#FFFFFF',
    playBtnInactive: 'rgba(0, 0, 0, 0.06)',
    playBtnInactiveIcon: '#111111',
    footerBg: 'rgba(250, 250, 250, 0.98)',
    footerBorder: '1px solid rgba(0, 0, 0, 0.08)',
    trackBg: 'rgba(0, 0, 0, 0.10)',
    trackFill: '#111111',
    btnSecondaryBg: 'rgba(0, 0, 0, 0.05)',
    btnSecondaryBorder: '1px solid rgba(0, 0, 0, 0.10)',
    btnSecondaryColor: '#111111',
  }

  // Liste filtree par la recherche locale
  const filteredList = useMemo(() => {
    if (!filterQuery.trim()) return audioList
    const q = filterQuery.trim().toLowerCase()
    return audioList.filter((item) => {
      const name = (item.name || '').toLowerCase()
      const path = (item.contentPath || item.dir || '').toLowerCase()
      return name.includes(q) || path.includes(q)
    })
  }, [audioList, filterQuery])

  // Piste actuellement selectionnee
  const currentItem = filteredList[selectedIndex] || audioList[0] || null

  // Resolution de la piste active
  const loadTrack = useCallback(async (item, playImmediately = true) => {
    if (!item) return
    setCurrentTime(0)
    setDuration(0)

    const path = item.contentPath || item.dir
    // Tentative synchrone via cache RAM
    const cachedManifest = getCachedAudioManifest(path)
    const cachedUrl = getCachedAudioUrl(path)

    if (cachedManifest) {
      setMetaMap((prev) => ({ ...prev, [path]: cachedManifest }))
      if (cachedManifest.duration) setDuration(Number(cachedManifest.duration) || 0)
    }

    if (cachedUrl) {
      setCurrentUrl(cachedUrl)
      if (playImmediately && audioRef.current) {
        audioRef.current.src = cachedUrl
        safePlay(audioRef.current)
      }
      return
    }

    // Resolution asynchrone ultra rapide
    try {
      const manifest = cachedManifest || await readAudioManifestCached(path)
      if (manifest) {
        setMetaMap((prev) => ({ ...prev, [path]: manifest }))
        if (manifest.duration) setDuration(Number(manifest.duration) || 0)
      }
      const url = await resolveAudioUrlFast(item, manifest)
      if (url) {
        setCurrentUrl(url)
        if (playImmediately && audioRef.current) {
          audioRef.current.src = url
          safePlay(audioRef.current)
        }
      }
    } catch {}
  }, [])

  // Declenchement au changement d'element actif
  useEffect(() => {
    if (!open || !currentItem) return
    loadTrack(currentItem, true)

    // Prechauffage des pistes adjacentes en arriere-plan
    const idx = audioList.findIndex((x) => x.dir === currentItem.dir)
    if (idx >= 0) {
      prefetchAudioNeighbors(audioList, idx, 3)
    }
  }, [open, currentItem, loadTrack, audioList])

  // Scroll automatique vers la ligne active
  useEffect(() => {
    if (activeRowRef.current?.scrollIntoView) {
      activeRowRef.current.scrollIntoView({ block: 'nearest', behavior: 'smooth' })
    }
  }, [selectedIndex])

  // Raccourcis clavier (Haut / Bas = piste precedente / suivante, Espace = Play/Pause, Echap = fermer)
  useEffect(() => {
    if (!open) return
    const onKeyDown = (e) => {
      if (e.target && ['INPUT', 'TEXTAREA'].includes(e.target.tagName)) {
        if (e.code === 'Escape') {
          e.preventDefault()
          onClose?.()
        }
        return
      }

      if (e.code === 'Space') {
        e.preventDefault()
        const el = audioRef.current
        if (el) {
          if (el.paused) safePlay(el)
          else el.pause()
        }
      } else if (e.code === 'ArrowDown') {
        e.preventDefault()
        setSelectedIndex((idx) => Math.min(filteredList.length - 1, idx + 1))
      } else if (e.code === 'ArrowUp') {
        e.preventDefault()
        setSelectedIndex((idx) => Math.max(0, idx - 1))
      } else if (e.code === 'Escape') {
        e.preventDefault()
        onClose?.()
      }
    }

    window.addEventListener('keydown', onKeyDown)
    return () => window.removeEventListener('keydown', onKeyDown)
  }, [open, onClose, filteredList.length])

  if (!open) return null

  const activeTrack = currentItem
  const activeTitle = cleanTrackName(activeTrack?.name || '')
  const progressPercent = duration > 0 ? Math.min(100, Math.max(0, (currentTime / duration) * 100)) : 0

  return createPortal(
    <div
      style={{
        position: 'fixed',
        inset: 0,
        zIndex: 999999,
        background: 'rgba(0, 0, 0, 0.55)',
        backdropFilter: 'blur(10px)',
        display: 'grid',
        placeItems: 'center',
        padding: '16px',
        boxSizing: 'border-box',
      }}
      onClick={onClose}
    >
      <audio
        ref={audioRef}
        src={currentUrl || undefined}
        preload="auto"
        onPlay={() => setPlaying(true)}
        onPause={() => setPlaying(false)}
        onEnded={() => {
          setPlaying(false)
          if (selectedIndex < filteredList.length - 1) {
            setSelectedIndex((idx) => idx + 1)
          }
        }}
        onTimeUpdate={() => {
          if (seeking) return
          const el = audioRef.current
          if (el) {
            setCurrentTime(el.currentTime)
            if (el.duration && Number.isFinite(el.duration) && el.duration !== duration) {
              setDuration(el.duration)
            }
          }
        }}
        onLoadedMetadata={() => {
          const el = audioRef.current
          if (el && Number.isFinite(el.duration)) {
            setDuration(el.duration)
          }
        }}
      />

      <div
        onClick={(e) => e.stopPropagation()}
        style={{
          width: 'min(760px, 94vw)',
          height: 'min(620px, 86vh)',
          borderRadius: 18,
          background: c.modalBg,
          border: c.modalBorder,
          boxShadow: c.modalShadow,
          display: 'flex',
          flexDirection: 'column',
          overflow: 'hidden',
          fontFamily: FONTS.sans || 'var(--zr-police-sans)',
          color: c.text,
        }}
      >
        {/* En-tete simplifiee : titre, badge nombre et filtre rapide */}
        <div
          style={{
            padding: '12px 18px',
            borderBottom: c.headerBorder,
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            gap: 12,
          }}
        >
          <div style={{ display: 'flex', alignItems: 'center', gap: 10 }}>
            <span style={{ fontSize: 'var(--zr-ui-md)', fontWeight: 600, letterSpacing: '-0.01em', color: c.text }}>
              Écoute rapide SFX
            </span>
            <span
              style={{
                fontSize: '11px',
                fontFamily: 'var(--zr-police-mono)',
                background: c.badgeBg,
                color: c.badgeText,
                padding: '2px 8px',
                borderRadius: 999,
                fontWeight: 500,
              }}
            >
              {audioList.length} sons
            </span>
          </div>

          <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
            {/* Champ de recherche instantanee */}
            <div
              style={{
                position: 'relative',
                display: 'flex',
                alignItems: 'center',
                width: 200,
              }}
            >
              <span style={{ position: 'absolute', left: 10, color: c.textMuted, pointerEvents: 'none' }}>
                <Icon name="magnifyingglass" size={12} />
              </span>
              <input
                type="text"
                value={filterQuery}
                onChange={(e) => {
                  setFilterQuery(e.target.value)
                  setSelectedIndex(0)
                }}
                placeholder="Filtrer les sons…"
                style={{
                  width: '100%',
                  padding: '6px 10px 6px 28px',
                  borderRadius: 999,
                  background: c.inputBg,
                  border: c.inputBorder,
                  color: c.text,
                  fontSize: 'var(--zr-ui-xs)',
                  fontFamily: FONTS.sans || 'var(--zr-police-sans)',
                  outline: 'none',
                }}
              />
              {filterQuery && (
                <button
                  onClick={() => setFilterQuery('')}
                  style={{
                    position: 'absolute',
                    right: 8,
                    background: 'transparent',
                    border: 0,
                    color: c.textMuted,
                    cursor: 'pointer',
                    padding: 2,
                  }}
                  title="Effacer le filtre"
                >
                  <Icon name="xmark" size={11} />
                </button>
              )}
            </div>

            {/* Bouton de fermeture */}
            <button
              onClick={onClose}
              style={{
                width: 28,
                height: 28,
                borderRadius: 999,
                background: c.btnSecondaryBg,
                border: c.btnSecondaryBorder,
                color: c.btnSecondaryColor,
                cursor: 'pointer',
                display: 'grid',
                placeItems: 'center',
              }}
              title="Fermer (Échap)"
            >
              <Icon name="xmark" size={13} />
            </button>
          </div>
        </div>

        {/* Corps central : liste epuree des sons */}
        <div
          ref={listRef}
          style={{
            flex: 1,
            overflowY: 'auto',
            padding: '6px 10px',
            display: 'flex',
            flexDirection: 'column',
            gap: 2,
          }}
        >
          {filteredList.length === 0 ? (
            <div style={{ padding: '60px 20px', textAlign: 'center', color: c.textMuted, fontSize: 'var(--zr-ui-sm)' }}>
              Aucun fichier sonore ne correspond au filtre.
            </div>
          ) : (
            filteredList.map((item, index) => {
              const isSelected = index === selectedIndex
              const isCurrentPlaying = isSelected && playing
              const path = item.contentPath || item.dir
              const meta = metaMap[path] || null
              const name = cleanTrackName(item.name || meta?.title || '')
              const dur = Number(meta?.duration) || 0

              return (
                <div
                  key={item.dir || item.contentPath || index}
                  ref={isSelected ? activeRowRef : null}
                  onClick={() => {
                    setSelectedIndex(index)
                    loadTrack(item, true)
                  }}
                  style={{
                    display: 'flex',
                    alignItems: 'center',
                    gap: 12,
                    padding: '7px 10px',
                    borderRadius: 8,
                    cursor: 'pointer',
                    background: isSelected ? c.rowSelected : 'transparent',
                    border: isSelected ? c.rowSelectedBorder : '1px solid transparent',
                    transition: 'background 120ms ease',
                  }}
                  onMouseEnter={(e) => {
                    if (!isSelected) e.currentTarget.style.background = c.rowHover
                  }}
                  onMouseLeave={(e) => {
                    if (!isSelected) e.currentTarget.style.background = 'transparent'
                  }}
                >
                  {/* Play icon pastille */}
                  <span
                    style={{
                      width: 24,
                      height: 24,
                      borderRadius: 999,
                      background: isSelected ? c.playBtnBg : c.playBtnInactive,
                      color: isSelected ? c.playBtnIcon : c.playBtnInactiveIcon,
                      display: 'grid',
                      placeItems: 'center',
                      flexShrink: 0,
                    }}
                  >
                    {isCurrentPlaying ? (
                      <Icon name="pause.fill" size={9} />
                    ) : (
                      <Icon name="play.fill" size={9} />
                    )}
                  </span>

                  {/* Titre epure */}
                  <span
                    style={{
                      flex: 1,
                      minWidth: 0,
                      fontSize: 'var(--zr-ui-sm)',
                      fontWeight: isSelected ? 600 : 400,
                      color: isSelected ? c.text : c.textMuted,
                      overflow: 'hidden',
                      textOverflow: 'ellipsis',
                      whiteSpace: 'nowrap',
                    }}
                    title={item.name}
                  >
                    {name}
                  </span>

                  {/* Bouton telecharger par ligne */}
                  {item.contentPath && (
                    <span
                      role="button"
                      tabIndex={-1}
                      onClick={(ev) => {
                        ev.stopPropagation()
                        ev.preventDefault()
                        downloadMedia(item.contentPath, item.name).catch(() => {})
                      }}
                      title="Télécharger ce son"
                      style={{
                        width: 22,
                        height: 22,
                        borderRadius: 4,
                        display: 'grid',
                        placeItems: 'center',
                        cursor: 'pointer',
                        color: isSelected ? c.text : c.textDim,
                        opacity: 0.7,
                        flexShrink: 0,
                        transition: 'opacity 120ms ease',
                      }}
                      onMouseEnter={(ev) => (ev.currentTarget.style.opacity = '1')}
                      onMouseLeave={(ev) => (ev.currentTarget.style.opacity = '0.7')}
                    >
                      <Icon name="arrow.down.circle" size={13} />
                    </span>
                  )}

                  {/* Duree */}
                  <span
                    style={{
                      fontSize: '11px',
                      fontFamily: 'var(--zr-police-mono)',
                      color: isSelected ? c.text : c.textDim,
                      flexShrink: 0,
                    }}
                  >
                    {dur > 0 ? formatSeconds(dur) : (isSelected && duration > 0 ? formatSeconds(duration) : '')}
                  </span>
                </div>
              )
            })
          )}
        </div>

        {/* Barre de controle inferieure epuree sur une seule ligne */}
        <div
          style={{
            padding: '10px 16px',
            borderTop: c.footerBorder,
            background: c.footerBg,
            display: 'flex',
            alignItems: 'center',
            gap: 12,
          }}
        >
          {/* Commandes transport */}
          <div style={{ display: 'flex', alignItems: 'center', gap: 4, flexShrink: 0 }}>
            <button
              onClick={() => setSelectedIndex((idx) => Math.max(0, idx - 1))}
              disabled={selectedIndex <= 0}
              style={{
                background: 'transparent',
                border: 0,
                color: selectedIndex <= 0 ? c.textDim : c.text,
                cursor: selectedIndex <= 0 ? 'default' : 'pointer',
                padding: 6,
                display: 'grid',
                placeItems: 'center',
              }}
              title="Piste précédente (Flèche haut)"
            >
              <Icon name="backward.fill" size={12} />
            </button>

            <button
              onClick={() => {
                const el = audioRef.current
                if (el) {
                  if (el.paused) safePlay(el)
                  else el.pause()
                }
              }}
              style={{
                width: 32,
                height: 32,
                borderRadius: 999,
                background: c.playBtnBg,
                border: 0,
                color: c.playBtnIcon,
                cursor: 'pointer',
                display: 'grid',
                placeItems: 'center',
              }}
              title="Lecture / Pause (Espace)"
            >
              {playing ? <Icon name="pause.fill" size={13} /> : <Icon name="play.fill" size={13} />}
            </button>

            <button
              onClick={() => setSelectedIndex((idx) => Math.min(filteredList.length - 1, idx + 1))}
              disabled={selectedIndex >= filteredList.length - 1}
              style={{
                background: 'transparent',
                border: 0,
                color: selectedIndex >= filteredList.length - 1 ? c.textDim : c.text,
                cursor: selectedIndex >= filteredList.length - 1 ? 'default' : 'pointer',
                padding: 6,
                display: 'grid',
                placeItems: 'center',
              }}
              title="Piste suivante (Flèche bas)"
            >
              <Icon name="forward.fill" size={12} />
            </button>
          </div>

          {/* Titre de la piste active */}
          <div
            style={{
              maxWidth: 200,
              minWidth: 60,
              fontSize: 'var(--zr-ui-xs)',
              fontWeight: 600,
              color: c.text,
              overflow: 'hidden',
              textOverflow: 'ellipsis',
              whiteSpace: 'nowrap',
              flexShrink: 0,
            }}
          >
            {activeTitle}
          </div>

          {/* Scrubber temporel minimal */}
          <div style={{ flex: 1, display: 'flex', alignItems: 'center', gap: 8, minWidth: 100 }}>
            <span
              style={{
                fontSize: '11px',
                fontFamily: 'var(--zr-police-mono)',
                color: c.textMuted,
                minWidth: 26,
                textAlign: 'right',
              }}
            >
              {formatSeconds(currentTime)}
            </span>

            <div
              style={{
                position: 'relative',
                flex: 1,
                height: 4,
                borderRadius: 999,
                background: c.trackBg,
                cursor: 'pointer',
              }}
            >
              <div
                style={{
                  position: 'absolute',
                  top: 0,
                  left: 0,
                  height: '100%',
                  width: `${progressPercent}%`,
                  borderRadius: 999,
                  background: c.trackFill,
                }}
              />
              <input
                type="range"
                min={0}
                max={duration || 100}
                step={0.05}
                value={currentTime}
                onChange={(e) => setCurrentTime(Number(e.target.value))}
                onMouseDown={() => setSeeking(true)}
                onTouchStart={() => setSeeking(true)}
                onMouseUp={(e) => {
                  setSeeking(false)
                  const val = Number(e.target.value)
                  if (audioRef.current) {
                    audioRef.current.currentTime = val
                    if (playing) safePlay(audioRef.current)
                  }
                }}
                onTouchEnd={(e) => {
                  setSeeking(false)
                  const val = Number(e.target.value)
                  if (audioRef.current) {
                    audioRef.current.currentTime = val
                    if (playing) safePlay(audioRef.current)
                  }
                }}
                style={{
                  position: 'absolute',
                  inset: 0,
                  width: '100%',
                  height: '100%',
                  opacity: 0,
                  cursor: 'pointer',
                  margin: 0,
                }}
              />
            </div>

            <span
              style={{
                fontSize: '11px',
                fontFamily: 'var(--zr-police-mono)',
                color: c.textMuted,
                minWidth: 26,
              }}
            >
              {formatSeconds(duration)}
            </span>
          </div>

          {/* Volume */}
          <div style={{ display: 'flex', alignItems: 'center', gap: 6, flexShrink: 0 }}>
            <span style={{ color: c.textMuted }}>
              <Icon name={volume === 0 ? 'speaker.slash' : 'speaker.wave.2'} size={12} />
            </span>
            <input
              type="range"
              min={0}
              max={1}
              step={0.05}
              value={volume}
              onChange={(e) => {
                const val = Number(e.target.value)
                setVolume(val)
                if (audioRef.current) audioRef.current.volume = val
              }}
              style={{ width: 60, accentColor: c.trackFill, cursor: 'pointer' }}
              title="Volume"
            />
          </div>

          {/* Bouton telecharger la piste active */}
          {currentItem?.contentPath && (
            <button
              onClick={() => downloadMedia(currentItem.contentPath, currentItem.name).catch(() => {})}
              style={{
                background: isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.05)',
                border: isDark ? '1px solid rgba(255, 255, 255, 0.12)' : '1px solid rgba(0, 0, 0, 0.08)',
                color: c.text,
                cursor: 'pointer',
                padding: '4px 8px',
                display: 'inline-flex',
                alignItems: 'center',
                gap: 5,
                fontSize: 'var(--zr-ui-xs)',
                fontWeight: 500,
                borderRadius: 6,
                flexShrink: 0,
                transition: 'background 120ms ease',
              }}
              title="Télécharger la piste active"
            >
              <Icon name="arrow.down.circle" size={13} />
              <span>Télécharger</span>
            </button>
          )}
        </div>
      </div>
    </div>,
    document.body
  )
}
