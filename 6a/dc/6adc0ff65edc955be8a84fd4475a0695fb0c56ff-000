// Quick Look ne déplace pas le scroll de la grille : calcule sa propre fenêtre circulaire de
// 96 images avant + 96 après, en sautant dossiers/vidéos et sans doublons dans les petits dossiers.
function quickLookNeighborImagePaths(list, index, radius = 96) {
  if (!Array.isArray(list) || index < 0 || list.length < 2) return []
  const out = []
  const seen = new Set([list[index] && list[index].contentPath])
  let before = 0, after = 0
  const add = (entry, side) => {
    const path = entry && entry.contentPath
    const image = entry && (entry.type === 'image' || entry.isImage || (path && path.endsWith('.img.json')))
    if (!image || !path || seen.has(path)) return
    seen.add(path); out.push(path)
    if (side === 'before') before++; else after++
  }
  for (let distance = 1; distance < list.length && (before < radius || after < radius); distance++) {
    if (after < radius) add(list[(index + distance) % list.length], 'after')
    if (before < radius) add(list[(index - distance + list.length) % list.length], 'before')
  }
  return out
}

