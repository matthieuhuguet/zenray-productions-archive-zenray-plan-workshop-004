  // nœud -> sans ça, le tag pointait sur un chemin mort (point de couleur perdu + tag fantôme compté dans le
  // filtre). On remappe la clé tags[from] -> tags[to] sur succès d'un move/rename. Pour un dossier (move-tree),
  // on remappe TOUTES les clés préfixées par fromBase + '/' (sous-arbre entier). Persisté dans .zr-tags.json.
  const remapTags = (fromPath, toPath, isFolder) => {
    // 2 October 2026 The glyph map moves with the colours (same keys, same file), and a pure folder's own key moves too.
    const nextIcons = remapKeys(folderIconsRef.current, fromPath, toPath, isFolder)
    const iconsChanged = nextIcons !== folderIconsRef.current
    if (iconsChanged) { folderIconsRef.current = nextIcons; setFolderIcons(nextIcons) }
    setTags((prev) => {
      const next = remapKeys(prev, fromPath, toPath, isFolder)
      if (next !== prev || iconsChanged) saveTags(next)
      return next
    })
  }

  // `\p{L}` garde les lettres ACCENTUÉES : sans `sansAccent`, les cinq créations qui passent par
  // ici (base, board, média, playlist, plan) réintroduiraient exactement ce que la règle interdit.
  const slugify = (s) => sansAccent(s).replace(/[/\\]+/g, '-').replace(/[^\p{L}\p{N} ._-]+/gu, '').replace(/\s+/g, ' ').trim().replace(/^[-.\s]+|[-.\s]+$/g, '')
  // newPage / addChild / newDatabase : au lieu du window.prompt moche, on OUVRE le widget NamePrompt (liquid glass).
  // Sa callback reçoit le titre saisi et exécute la création (logique inchangée).
  const newPage = () => setNamePrompt({ icon: 'doc.text', label: 'Nouvelle page', placeholder: 'Titre de la page', value: '', cta: 'Créer', onOk: (title) => createPage('pages', title, 'créée ✓') })
  const addChild = (folderPath) => setNamePrompt({ icon: 'doc.text', label: 'Nouvelle sous-page', placeholder: 'Titre de la sous-page', value: '', cta: 'Créer', onOk: (title) => createPage(folderPath, title, 'sous-page créée ✓') })
  const newDatabase = (folderPath) => setNamePrompt({ icon: 'tablecells', label: 'Nouvelle table', placeholder: 'Nom de la table', value: '', cta: 'Créer', onOk: (title) => {
    const slug = slugify(title) || 'base'
    const path = `${folderPath}/${slug}-${Date.now().toString(36).slice(-4)}.db.json`
    const seed = { name: title, columns: [{ id: 'c' + Date.now().toString(36), name: 'Nom', type: 'text', w: 220 }], rows: [], views: [] }
    apiPost('save', { path, markdown: JSON.stringify(seed) })
      .then((j) => { if (j.ok) { setCur({ path }); setStatus('table créée ✓'); loadTree() } else setStatus('erreur ' + (j.error || '')) })
  } })
  // Board ZenRay Ref (2026-07-19) : créé directement dans le dossier courant (pas de sous-arborescence
  // pages/Ref/<projet>/Boards/ imposée), ouvert aussitôt comme n'importe quel nœud Create (double-clic
  // futur = même route, typeOfPath('.ref.json') === 'canvas' -> CanvasNodeViewer/RefBoard).
  const newRefBoard = (folderPath) => setNamePrompt({ icon: 'square.grid.2x2', label: 'Nouveau board Ref', placeholder: 'Nom du board', value: '', cta: 'Créer', onOk: (title) => {
    const slug = slugify(title) || 'board'
    const path = `${folderPath}/${slug}-${Date.now().toString(36).slice(-4)}.ref.json`
    const seed = makeCanvas({ projectPath: path, title })
    apiPost('save', { path, markdown: JSON.stringify(seed) })
      .then((j) => { if (j.ok) { setCur({ path }); setStatus('board Ref créé ✓'); loadTree() } else setStatus('erreur ' + (j.error || '')) })
  } })
  // Document ZenRayMedia (2026-07-25) : créé dans le dossier courant, comme un board Ref. On écrit
  // une source MINIMALE valide (aucun rendu stocké : il se recompile) puis on bascule sur la vue
  // Media, qui devient propriétaire de l'édition.
  const newMediaDoc = (folderPath) => setNamePrompt({ icon: 'doc.richtext', label: 'Nouveau document Media', placeholder: 'Titre du document', value: '', cta: 'Créer', onOk: (title) => {
    const slug = slugify(title) || 'media'
    const path = `${folderPath}/${slug}-${Date.now().toString(36).slice(-4)}.zmedia.json`
    const seed = {
