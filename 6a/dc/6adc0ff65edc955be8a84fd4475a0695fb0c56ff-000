// (batch refactor structurel 2026-07-16, source unique partagée avec les composants extraits).
// Vignette Finder : lit la 1re image embarquée dans une page (markdown), sinon icône document. Cache module-level pour éviter de refetch.
const _thumbCache = {}

function PageThumb({ path, size = 54, fallback, cover = false }) {
  const [url, setUrl] = useState(_thumbCache[path])
  useEffect(() => {
    if (_thumbCache[path] !== undefined) { setUrl(_thumbCache[path]); return }
    let alive = true
    fetch(`/api/page?action=read&raw=1&path=${encodeURIComponent(path)}`, { cache: 'no-store' }).then((r) => r.json()).then((j) => {
      let u = null
      if (j && j.markdown) { const m = j.markdown.match(/!\[[^\]]*\]\(([^)\s]+)\)/) || j.markdown.match(/<img[^>]+src=["']([^"']+)["']/); if (m) u = m[1] }
      _thumbCache[path] = u; if (alive) setUrl(u)
    }).catch(() => { _thumbCache[path] = null; if (alive) setUrl(null) })
    return () => { alive = false }
  }, [path])
  if (url) return <img src={url} alt="" loading="lazy" style={cover ? { position: 'absolute', inset: 0, width: '100%', height: '100%', objectFit: 'cover', objectPosition: 'center', display: 'block' } : { width: size, height: size, objectFit: 'cover', borderRadius: 7, display: 'block', background: 'rgba(128,128,128,0.12)' }} />
  return fallback
}

// Label d'une tuile/ligne de page : affiche le TITRE éditable (props.title) s'il existe, sinon le nom de fichier joli.
// Le titre vit dans le jumeau .props.json (on ne renomme pas le fichier) -> sans ça les tuiles montrent l'ancien nom.
// Lazy + cache module-level (partagé avec PropertiesBlock qui l'écrit à chaque changement de titre).
const _labelCache = {}

function PageLabel({ path, name }) {
  const fallback = pgPretty(name)
  const [label, setLabel] = useState(_labelCache[path])
  useEffect(() => {
    if (!path || !path.endsWith('.md')) return
    if (_labelCache[path] !== undefined) { setLabel(_labelCache[path]); return }
    let alive = true
    fetch(`/api/page?action=read&raw=1&path=${encodeURIComponent(path.replace(/\.md$/, '.props.json'))}`, { cache: 'no-store' })
      .then((r) => r.json())
      .then((j) => { let tt = null; if (j && j.markdown && !j.missing) { try { tt = (JSON.parse(j.markdown).title || '').trim() || null } catch {} } _labelCache[path] = tt; if (alive) setLabel(tt) })
      .catch(() => { _labelCache[path] = null; if (alive) setLabel(null) })
    return () => { alive = false }
  }, [path])
  return <>{label || fallback}</>
}

// Compteur de commentaires d'une page (lazy + cache module-level). Affiche la bulle SF Symbols + l'entier
// SEULEMENT s'il y a au moins 1 commentaire ; sinon rien (ni bulle ni nombre). Lecture du jumeau .comments.json.
const _commentCountCache = {}

function CommentBadge({ path, color }) {
  const [n, setN] = useState(_commentCountCache[path])
  useEffect(() => {
    if (!path || !path.endsWith('.md')) return
    if (_commentCountCache[path] !== undefined) { setN(_commentCountCache[path]); return }
    let alive = true
    fetch(`/api/page?action=read&raw=1&path=${encodeURIComponent(path.replace(/\.md$/, '.comments.json'))}`, { cache: 'no-store' })
      .then((r) => r.json())
      .then((j) => { let c = 0; if (j && j.markdown && !j.missing) { try { c = (JSON.parse(j.markdown).comments || []).length } catch {} } _commentCountCache[path] = c; if (alive) setN(c) })
      .catch(() => { _commentCountCache[path] = 0; if (alive) setN(0) })
    return () => { alive = false }
  }, [path])
  if (!n) return null // 0 ou inconnu -> rien (ni bulle ni nombre)
  return (
    <span style={{ display: 'inline-flex', alignItems: 'center', gap: 4, color: color || '#9A9A9F' }}>
      <Icon name="bubble.left" size={12.5} color="currentColor" weight={1.6} />
      <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', fontWeight: 500 }}>{n}</span>
    </span>
  )
}

// buildTree est désormais importé de ./create/buildNodes.js (type-aware, sur-ensemble). Phase 1 OS.
// pathDescend : la page ouverte est-elle ce nœud ou un de ses descendants ? (auto-expand des ancêtres)
function nodeHasPath(node, target) {
  if (!target) return false
  if (node.contentPath === target) return true
  return Object.values(node.children).some((c) => nodeHasPath(c, target))
}

function TreeItem({ node, depth, curPath, onOpen, t, prefix, onAddChild, onMovePage }) {
  const kids = Object.keys(node.children).sort((a, b) => a.localeCompare(b))
  const hasKids = kids.length > 0
  const myPath = (prefix ? prefix + '/' : '') + node.name
  const onPathInside = hasKids && nodeHasPath(node, curPath)
  const [open, setOpen] = useState(onPathInside)
  const [hover, setHover] = useState(false)
  const [dragOver, setDragOver] = useState(false)
  useEffect(() => { if (onPathInside) setOpen(true) }, [onPathInside])
  const on = !!node.contentPath && curPath === node.contentPath
  const handleName = () => { if (node.contentPath) onOpen(node.contentPath); else if (hasKids) setOpen((v) => !v) }
  return (
    <div>
      <div className="zr-treeitem" onMouseEnter={() => setHover(true)} onMouseLeave={() => setHover(false)}
        onDragOver={(e) => { if (e.dataTransfer.types.includes('application/zenray-page')) { e.preventDefault(); setDragOver(true) } }}
        // FIX (bug trouvé 2026-07-01, jamais couvert par le fix pointer-events de la grille IconTile) : ce
        // conteneur a PLUSIEURS enfants interactifs (flèche + bouton nom + bouton "+"), donc pointer-events:none
        // casserait leur clic. Fix robuste à la place : dragleave ne compte QUE si la souris quitte VRAIMENT ce
        // conteneur (relatedTarget hors de son sous-arbre) — sinon un survol d'enfant pendant le drag scintillait
        // le highlight en boucle (dragleave/dragover parasites, même bug HTML5 que la grille).
        onDragLeave={(e) => { if (e.currentTarget.contains(e.relatedTarget)) return; setDragOver(false) }}
        onDrop={(e) => {
          setDragOver(false)
          const d = e.dataTransfer.getData('application/zenray-page'); if (!d || !onMovePage) return
          e.preventDefault(); e.stopPropagation()
          try {
            const p = JSON.parse(d); setOpen(true)
            const list = p.items ? p.items.map((it) => it.path) : (p.path ? [p.path] : [])
            // BUG CRITIQUE trouvé 2026-07-01 : list.forEach(pp => onMovePage(pp, myPath)) tirait TOUS les
            // déplacements en parallèle SANS AUCUNE limite de concurrence ni attente (forEach + callback async
            // = fire-and-forget), contrairement à moveMany (grille) qui borne à 4 en concurrence. Un drag
            // multi-sélection vers la sidebar pouvait donc saturer l'API GitHub (rafale de 409) -> "beaucoup
            // d'erreurs". Fix : un SEUL appel batché, même chemin que le drop en grille (moveMany).
            onMovePage(list, myPath)
          } catch {}
        }}
        style={{ display: 'flex', alignItems: 'center', width: '100%', paddingLeft: 8 + depth * 12, paddingRight: 4, borderRadius: RADII.sm, background: dragOver ? PALETTE.primarySoft : (on ? PALETTE.primarySoft : 'transparent'), outline: dragOver ? `1px dashed ${PALETTE.primary}` : 'none' }}>
        <span onClick={(e) => { e.stopPropagation(); if (hasKids) setOpen((v) => !v) }}
          style={{ flex: '0 0 14px', width: 14, textAlign: 'center', cursor: hasKids ? 'pointer' : 'default', color: t.textSecondary, fontSize: 'var(--zr-ui-2xs)', userSelect: 'none' }}>
          {hasKids ? (open ? '▾' : '▸') : ''}
        </span>
        <button onClick={handleName} title={node.contentPath || node.name}
          draggable={!!node.contentPath}
          onDragStart={node.contentPath ? (e) => { e.dataTransfer.setData('application/zenray-page', JSON.stringify({ path: node.contentPath, name: node.name })); e.dataTransfer.effectAllowed = 'copy' } : undefined}
          style={{ flex: 1, textAlign: 'left', padding: '5px 4px', background: 'transparent', border: 'none', cursor: 'pointer',
            color: on ? PALETTE.primary : (node.contentPath ? t.textPrimary : t.textSecondary), fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)',
            fontWeight: on ? 600 : (!node.contentPath && hasKids ? 600 : 400), whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>
          {pgPretty(node.name)}{hasKids ? <span style={{ color: t.textSecondary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', marginLeft: 6 }}>{kids.length}</span> : null}
        </button>
        <button onClick={(e) => { e.stopPropagation(); setOpen(true); onAddChild && onAddChild(myPath) }} title="Ajouter une sous-page" className="zr-hover-action"
          style={{ flex: '0 0 auto', visibility: hover ? 'visible' : 'hidden', background: 'transparent', border: 'none', cursor: 'pointer', color: t.textSecondary, fontSize: 'var(--zr-ui-xl)', lineHeight: 1, padding: '0 4px' }}>+</button>
      </div>
      {open && hasKids && kids.map((k) => (
        <TreeItem key={k} node={node.children[k]} depth={depth + 1} curPath={curPath} onOpen={onOpen} t={t} prefix={myPath} onAddChild={onAddChild} onMovePage={onMovePage} />
      ))}
    </div>
  )
}

function TreeNode({ node, depth, curPath, onOpen, t, prefix, onAddChild, onMovePage }) {
  return (
    <>
      {Object.keys(node.children).sort((a, b) => a.localeCompare(b)).map((k) => (
        <TreeItem key={k} node={node.children[k]} depth={depth} curPath={curPath} onOpen={onOpen} t={t} prefix={prefix} onAddChild={onAddChild} onMovePage={onMovePage} />
      ))}
    </>
  )
}

