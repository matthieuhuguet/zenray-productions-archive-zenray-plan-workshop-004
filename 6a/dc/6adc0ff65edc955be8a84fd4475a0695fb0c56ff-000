        ].filter(Boolean)
        return <ActionColumnPopover t={t} open anchor={anchor} onClose={() => setCtx(null)} ariaLabel="Menu contextuel" columnWidth={238} maxHeight={440} nodes={nodes} initialChain={filmEntries.length ? ['delivery'] : null} />
      })()}

      {/* C17 — barre d'actions de sélection (widget flottant bas-centre) RETIRÉE : les tags couleur et la corbeille passent par le clic droit (macOS). */}

      {/* C24 — Quick Look */}
      {quick && (() => {
        const list = shownEntries
        const i = list.findIndex((x) => x.dir === quick.dir)
        const step = (d) => { if (i < 0 || !list.length) return; const n = (i + d + list.length) % list.length; setQuick(list[n]); setSelected(new Set([list[n].dir])) }
        // LE TRI PASSE PAR UNE SEULE PROP, et c'est la loi HDA : le Quick Look ne sait pas ce
        // qu'est un espace de tri ni comment on écrit un lien Eagle, il reçoit une liste et un
        // geste. Le jour où l'on trie des vidéos, seul ce calcul change ; le composant, jamais.
        return <QuickLookOverlay t={t} item={quick} prefetchImagePaths={quickLookNeighborImagePaths(list, i)} neighborEntries={list} prettyName={pgPretty}
          tri={triQuickLook}
          onPrev={() => step(-1)} onNext={() => step(1)} onClose={() => setQuick(null)}
          onOpen={() => { const e = quick; setQuick(null); openEntry(e) }} />
      })()}

      {/* 14 October 2026 : le Spotlight (Cmd/Ctrl+K) est monte a la RACINE de l'app (App.jsx), il ne vit plus dans Create. */}


      {/* « Déplacer vers… » — picker d'arborescence (clic droit), 2026-07-12. Le déplacement passe par
          moveMany (le même chemin fiable que le drag-and-drop : optimiste + retry + notifications). */}
      {/* MENU DE SÉLECTION (2026-08-11) : une seule action, donc un seul bouton — pas un menu
