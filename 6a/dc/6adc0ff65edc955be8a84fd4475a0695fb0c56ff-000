            multi && imagePaths.length ? { id: 'download-images', disabled: zipBusy, label: `Télécharger ${imagePaths.length} image${imagePaths.length > 1 ? 's' : ''}`, icon: <Icon name="photo" size={14} />, action: () => downloadFolderZip() } : null,
            mdPaths.length ? { id: 'download-md', label: mdPaths.length > 1 ? `Télécharger ${mdPaths.length} pages (.zip)` : 'Télécharger la page (.md)', icon: <Icon name="doc.text" size={14} />, action: () => downloadMarkdown(mdPaths, pgPretty(entry.hasKids ? entry.name : (multi ? folder.split('/').pop() : entry.name))) } : null,
            showShareImage ? { id: 'share-image', label: 'Partager cette image', icon: <Icon name="arrow.up.right" size={14} />, action: async () => {
              try {
                const { url } = await createShareLink(SHARE_KIND.image, entry.contentPath)
                await navigator.clipboard.writeText(url)
                notify({ icon: 'arrow.up.right', tint: PALETTE.primary, label: 'Lien copié', title: 'Image partagée', body: `Lien signé de « ${entry.name} » copié.` })
