            { id: 'tag-clear', label: 'Retirer les tags', icon: <Icon name="xmark" size={14} />, action: () => tagSelected(null, contextEntries) },
          ] } : null,
          { id: 'organize', label: 'Organiser', icon: <Icon name="checklist" size={14} />, children: [
            { id: 'eagle-link', label: `Afficher aussi dans…${multi ? ` (${contextEntries.length})` : ''}`, icon: <Icon name="arrow.triangle.branch" size={14} />, disabled: !contextEntries.some((item) => (!item.contentPath || item.hasKids) || (item.contentPath && /\.(img|media|file|canvas|embed|db)\.json$/.test(item.contentPath))), action: () => setLinkDlg({ entries: contextEntries }) },
            { id: 'eagle-copy-ref', label: `Copier comme référence${multi ? ` (${contextEntries.length})` : ''}`, icon: <Icon name="link" size={14} />, disabled: !contextEntries.some((item) => (!item.contentPath || item.hasKids) || (item.contentPath && /\.(img|media|file|canvas|embed|db)\.json$/.test(item.contentPath))), action: () => markClip('link', contextEntries) },
            { id: 'eagle-locations', label: 'Voir les emplacements', icon: <Icon name="square.stack.3d.up" size={14} />, disabled: multi, action: () => showEagleLocations(entry) },
            // ÉPINGLER À PLAN (2026-08-07) : seulement sur un `.plan.json`, jamais visible ailleurs —
            // « indexer directement à Plan » de la consigne. Épingler rend CE plan cliquable dès le
            // premier rendu de la vue Plan, sans attendre l'index ni l'arbre complet (voir `planEntries`).
            (!multi && /\.plan\.json$/.test(entry.contentPath || '')) ? { id: 'pin-plan', label: isPinnedPlan(entry.contentPath) ? 'Désépingler de Plan' : 'Épingler à Plan', icon: <Icon name="mappin" size={14} />, action: () => togglePinnedPlan(entry.contentPath) } : null,
            { id: 'reveal', label: 'Aller au dossier', icon: <Icon name="folder" size={14} />, disabled: multi, action: () => revealInFolder(entry) },
