  // comme harajuku-scam-story.pdf s'afficherait en texte brut illisible -- non traité, hors scope de cette passe).
  const buildMemoryEntries = (entries, dir) => (entries || [])
    .map((x) => (x.type === 'dir'
      ? { name: x.name, contentPath: null, hasKids: true, dir: x.path, type: 'folder', ...legacyFlags('folder') }
      : { name: x.name, contentPath: x.path, hasKids: false, dir: x.path, type: 'page', ...legacyFlags('page') }))
    .sort((a, b) => a.name.localeCompare(b.name))
  // LECTURES RÉSILIENTES (bug critique : un burst d'écritures GitHub — ex move-tree d'un dossier, upload —
  // peut déclencher un rate-limit secondaire ; un échec transitoire NE DOIT JAMAIS vider/casser l'arborescence).
  // -> retry avec backoff, et on N'ÉCRASE JAMAIS un listing déjà valide sur un échec passager.
  // `cacheMode` : `no-store` par défaut (comportement historique de tous les appels). L'arbre, lui,
  // passe en `no-cache` pour que le navigateur garde de quoi REVALIDER et puisse envoyer
  // `If-None-Match` — sans cela, le 304 posé côté serveur ne peut jamais se déclencher.
  // 14 October 2026: `etagRef` ({ current }) lets a poll skip downloading AND parsing a body whose ETag has not moved. The tree is 3 MB of
  // JSON, re-read every 25 s; with 'no-cache' the browser revalidates for free (304) but the old code still parsed and compared 44 000
  // strings each time. Returns { unchanged: true } in that case.
  const fetchJSONRetry = async (url, tries = 6, cacheMode = 'no-store', etagRef = null) => {
    for (let i = 0; i < tries; i++) {
      try {
        const r = await fetch(url, { cache: cacheMode })
        if (r.ok) {
          const tag = etagRef ? r.headers.get('etag') : null
          if (tag && etagRef.current === tag) return { unchanged: true }
          const j = await r.json()
          if (etagRef && tag && j && !j.rateLimited && !j.error) etagRef.current = tag
          // D — 403 GRACIEUX : le serveur renvoie 200 avec { rateLimited:true, resetAt } quand le quota
          // GitHub est épuisé. On NE relance PAS la boucle (sinon 6 appels gâchés sur un quota à zéro + 12 s
          // de spinner). On note l'heure de reset (bandeau + re-fetch programmé) et on s'arrête net : le
          // cache déjà servi par loadDir reste affiché.
          if (j && j.rateLimited) { markRateLimited(j.resetAt); return null }
          if (j && !j.error) return j
        }
      } catch {}
      await new Promise((res) => setTimeout(res, Math.min(4000, 350 * (i + 1))))
    }
    return null
  }
  const dirReqId = useRef(0)
  // P5 — single-flight par dossier (voir le wrapper loadDir plus bas) : refs de coalescence des revalidations.
  const dirInflight = useRef(new Map()) // dossier -> Promise de revalidation actuellement en vol
  const dirRerun = useRef(new Set())    // dossiers à re-revalider UNE fois la promesse en vol terminée
  // loadDirOnce = SWR (stale-while-revalidate) : on AFFICHE d'abord le cache (instantané, zéro réseau),
  // puis on REVALIDE en arrière-plan via fetch et on réécrit le cache. Anti-race conservé via dirReqId :
  // si un autre dossier a été ouvert entre-temps, on n'écrase pas son listing.
  const loadDirOnce = async (f) => {
    const my = ++dirReqId.current
    setFolderEagleSource(folderEagleSourceCache.current.get(f) || null)
    if (my === dirReqId.current) setDirError(false) // finder-core-5 : on repart d'un état neutre (pas l'erreur du dossier précédent)
    // CHEMIN PRINCIPAL = action=children (API contents, listing d'UN dossier). C'est la SEULE énumération
    // FIABLE : l'API git tree récursive (action=tree) TRONQUE au-delà d'une certaine taille (truncated:true sur
    // ce repo, ~30k entrées) -> liste partielle ET variable d'un appel à l'autre, d'où des dossiers qui
    // « disparaissaient » au refresh. children liste un dossier précis sans cette troncature (dossiers vides
    // inclus, renvoyés comme type:'dir'). SWR : cache affiché instantanément, revalidation derrière.
    const cached = readDirCache(f)
    if (cached && my === dirReqId.current) setDirEntries(cached) // stale immédiat
    const j = await fetchJSONRetry(`/api/page?action=children&dir=${encodeURIComponent(f)}`)
    if (my !== dirReqId.current) return // un autre chargement de dossier a démarré entre-temps
    if (j && Array.isArray(j.entries)) {
      if (j.eagleSource) folderEagleSourceCache.current.set(f, j.eagleSource)
      else folderEagleSourceCache.current.delete(f)
      setFolderEagleSource(j.eagleSource || null)
      const built = (f === 'Memory' || f.startsWith('Memory/')) ? buildMemoryEntries(j.entries, f) : buildDirEntries(j.entries, f)
      // Racine Create : tuile synthétique "Memory" (dossier live, repo distinct) -- accessible en NAVIGUANT
      // Create normalement, pas seulement via le raccourci sidebar "Skills" qui saute directement dans Memory/Skills.
      if (f === 'pages') built.unshift({ name: 'Memory', contentPath: null, hasKids: true, dir: 'Memory', type: 'folder', ...legacyFlags('folder') })
      writeDirCache(f, built)
      setDirEntries(built); setDirError(false) // le serveur a répondu : vide légitime si built.length===0
    } else if (!cached) {
      setDirEntries((prev) => (prev && prev.length ? prev : [])) // pas de cache + échec -> garde l'état valide, jamais d'écran cassé
      setDirError((prev) => prev || true) // finder-core-5 : échec réseau SANS cache -> vrai état d'erreur (pas "dossier vide")
    } else { setDirError(false) } // cache servi : on ne signale pas d'erreur
  }
  // P5 — loadDir public = loadDirOnce protégé par single-flight PAR DOSSIER. En rafale d'opérations
  // (déplacements, renommages, suppressions enchaînés), chacune lance loadTree() -> loadDir(folder) en
  // fire-and-forget : sans garde, N revalidations réseau IDENTIQUES du même dossier s'empilent. Ici, si
  // une revalidation de ce dossier est déjà en vol, on NE la double PAS : on note qu'un changement est
  // arrivé (dirRerun) et on renvoie la même promesse. À la fin, UNE seule reprise rattrape l'état final.
  // Résultat : une op isolée = exactement 1 fetch (zéro latence ajoutée, l'écran reste piloté par
  // l'optimisticDir) ; une rafale = au plus 2 fetch (le vol en cours + 1 reprise), au lieu de N.
  const loadDir = (f) => {
    if (dirInflight.current.has(f)) { dirRerun.current.add(f); return dirInflight.current.get(f) }
    const p = (async () => {
      try { await loadDirOnce(f) } finally {
        dirInflight.current.delete(f)
        if (dirRerun.current.has(f)) { dirRerun.current.delete(f); loadDir(f) } // 1 seule reprise pour l'état final
      }
    })()
    dirInflight.current.set(f, p)
    return p
  }
  // PRÉCHARGEMENT AU SURVOL (2026-07-06, perf dossiers) : survoler une tuile-dossier ~150 ms lance le fetch
  // de SON listing en fond -> le double-clic qui suit trouve le cache déjà chaud (ouverture 0,1 s même pour
  // un dossier jamais visité). Ne touche PAS l'écran (writeDirCache seulement), dédupliqué (1 fetch par
  // dossier max), et sauté si un cache existe déjà (le SWR normal suffit alors).
  const prefetched = useRef(new Set())
  const prefetchTimer = useRef(null)
  const prefetchDir = (e) => {
    if (!e || !(e.hasKids || !e.contentPath)) return // seuls les dossiers se préchargent
    const f = e.dir
    if (!f || prefetched.current.has(f) || readDirCache(f)) return
    if (prefetchTimer.current) clearTimeout(prefetchTimer.current)
    prefetchTimer.current = setTimeout(async () => {
      if (prefetched.current.has(f) || readDirCache(f)) return
      prefetched.current.add(f)
      const j = await fetch(`/api/page?action=children&dir=${encodeURIComponent(f)}`).then((r) => r.json()).catch(() => null)
      if (j && Array.isArray(j.entries)) writeDirCache(f, (f === 'Memory' || f.startsWith('Memory/')) ? buildMemoryEntries(j.entries, f) : buildDirEntries(j.entries, f))
      else prefetched.current.delete(f) // échec -> re-tentable au prochain survol
    }, 150)
  }
  const treeEtag = useRef(null)
  // `poll` = the 25 s background refresh only. An explicit refresh (after a write, a failed write, a cache purge) always parses, because it
  // must reconcile optimistic local changes with the server even when the server's tree did not move.
  const loadPaths = async ({ poll = false } = {}) => {
    const j = await fetchJSONRetry('/api/page?action=tree', 6, 'no-cache', poll ? treeEtag : null)
    if (j && j.unchanged) return
    if (j && Array.isArray(j.paths)) {
      // PERF : le poll 25 s (ci-dessous) rappelle ceci en continu même quand l'arbre n'a pas bougé. Si le
      // contenu est identique à ce qu'on a déjà, on garde l'ancienne RÉFÉRENCE `paths` (pas de setPaths) ->
      // pathNorms/nonEmptyDirs (useMemo dépendants de `paths`/`allPaths`) ne recalculent pas pour rien.
      // pathsRef reste à jour dans tous les cas (miroir synchrone utilisé par les écritures optimistes).
      const changed = !sameStringArray(pathsRef.current, j.paths)
      pathsRef.current = j.paths
      if (changed) { pathsMemo = j.paths; setPaths(j.paths) }
    }
    else setPaths((prev) => (prev && prev.length ? prev : []))
  }
  // loadPaths est le VRAI tueur de latence (arbre git récursif ~10 Mo). On le SORT du chemin critique :
  // après une écriture, on rafraîchit le dossier courant tout de suite (rapide), mais l'arbre global n'est
  // ré-aspiré qu'après 800 ms d'inactivité (debounce). Plusieurs ops rapprochées = 1 seul gros fetch.
  const loadPathsTimer = useRef(null)
  const loadPathsDebounced = () => {
    if (loadPathsTimer.current) clearTimeout(loadPathsTimer.current)
    loadPathsTimer.current = setTimeout(() => { loadPathsTimer.current = null; loadPaths() }, 800)
  }
  // loadTree() = rafraîchit le dossier courant (rapide, non bloquant) + l'index global (debounce, secondaire).
  const loadTree = () => { loadDir(folder); loadPathsDebounced() }
  // Vide TOUS les caches Create. À lancer APRÈS une migration média (les manifests changent d'URL/visibilité,
  // sinon l'app sert les anciennes URLs en cache). Purge : listings (RAM+sessionStorage), manifests image,
  // cache image persistant IndexedDB, index de recherche, et les caches de couverture/titre/commentaire des tuiles.
  const clearCreateCaches = async () => {
    setStatus('vidage du cache…')
    clearAllDirCache(); clearManifestCache(); clearPageReadCache(); invalidateSearchIndex()
    for (const cache of [_thumbCache, _labelCache, _commentCountCache]) {
      for (const key of Object.keys(cache)) delete cache[key]
    }
    // _mediaMimeMem/_mediaPosterMem/_mediaDurMem/_fileThumbMem/_videoCardMem sont des createLruCache (pas des
    // objets bruts) depuis leur passage en LRU borné : purge via leur propre .clear(), pas Object.keys/delete.
    for (const cache of [_mediaMimeMem, _mediaPosterMem, _mediaDurMem, _fileThumbMem, _videoCardMem]) cache.clear()
    try {
      const prefixes = ['zrmime:', 'zrposter2:', 'zrdur:', 'zrfthumb2:', 'zrvcard6:']
      for (let i = localStorage.length - 1; i >= 0; i -= 1) {
        const key = localStorage.key(i)
        if (key && prefixes.some((prefix) => key.startsWith(prefix))) localStorage.removeItem(key)
      }
    } catch {}
    try { await clearImageCacheIDB() } catch {}
    setDirEntries(null); await loadDir(folder); loadPaths()
    setStatus('cache vidé ✓')
    notify({ kind: 'success', label: 'Cache vidé', title: 'Caches Create purgés', body: 'Listings, manifests, images et index de recherche rechargés depuis le drive.' })
  }
  // AUTO-REFRESH DE L'ARBRE : l'index global (paths) n'est lu qu'au montage + après une action locale. Pendant
  // un gros upload en arrière-plan (bulk DJI : images/vidéos qui arrivent une par une), les nouveaux nœuds
  // n'apparaissaient qu'au Cmd+R manuel. On re-fetch l'arbre toutes les 25 s -> chaque fichier uploadé (vidéo
  // confirmée en ligne, image) apparaît tout seul. Léger (1 GET ~3 Mo, hors chemin critique). Coupé au démontage.
  // LE SONDAGE NE TOURNE QUE SI L'ONGLET EST REGARDÉ.
  //
  // Il existe pour refléter un changement fait ailleurs (autre machine, synchronisation
  // automatique), ce qui n'a aucun sens quand personne ne regarde. Or c'est précisément le cas le
  // plus long : un onglet laissé ouvert en arrière-plan sondait toute la journée. À 3,02 Mo par
  // appel et un appel toutes les 25 secondes, huit heures d'onglet oublié coûtaient 3,5 Go.
  //
  // Au retour sur l'onglet, on recharge une fois immédiatement : c'est le moment précis où
  // l'information a le plus de chances d'être périmée, et c'est le seul où quelqu'un la regarde.
  useEffect(() => {
    loadPaths()
    let id = null
    const marche = () => { if (id === null) id = setInterval(() => loadPaths({ poll: true }), 25000) }
    const arret = () => { if (id !== null) { clearInterval(id); id = null } }
    const surVisibilite = () => { if (document.visibilityState === 'visible') { loadPaths({ poll: true }); marche() } else arret() }
    if (document.visibilityState === 'visible') marche()
    document.addEventListener('visibilitychange', surVisibilite)
    return () => { arret(); document.removeEventListener('visibilitychange', surVisibilite) }
  }, [])
  useEffect(() => { loadDir(folder) }, [folder]) // changement de dossier = SWR (cache instantané puis revalidation, plus de flash vide)
  // `paths` = index GLOBAL (action=tree, best-effort, peut être TRONQUÉ sur gros repo) -> sert UNIQUEMENT à la
  // recherche et aux fonctions annexes (dossiers non vides, sous-pages…). Il NE pilote PLUS le listing du dossier
  // (c'est loadDir/children, fiable). On garde juste le miroir synchrone pathsRef à jour.
  useEffect(() => { pathsRef.current = paths || [] }, [paths])
  // Mutation OPTIMISTE du dossier courant : applique `fn` à la fois à l'écran (setDirEntries) ET au cache
  // SWR (mutateDirCache), pour que l'effet persiste après un remontage/reload. Le serveur reste la vérité :
  // loadDir() revalidera derrière. Sur échec d'op, l'appelant fait dropDirCache(folder)+loadDir(folder).
  const optimisticDir = (fn) => { mutateDirCache(folder, fn); setDirEntries((es) => fn((es || []).slice())) }

  // ═══ LE TICK : CE QUI VIENT D'ÊTRE ÉCRIT DOIT APPARAÎTRE, SANS RECHARGER LA PAGE ══════════════
  //
  // Ses mots, 2026-08-31 : « une fois que le dossier est fait, sans refresh la page, fais un coup de
  // refresh de l'app ou un tick à envoyer post-création pour faire apparaître le dossier. Cette
  // logique de tick devrait être intégrée dans énormément d'autres aspects, sinon c'est chiant. »
  //
  // LE BUG DE FAMILLE. Cinq endroits de ce fichier gardaient leur rafraîchissement par
  // `if (dest === folder)`. Créer DANS le dossier affiché marchait ; créer dans un SOUS-dossier ne
  // rafraîchissait rien, et le dossier neuf restait invisible jusqu'au rechargement. Le tri vers
  // `tmp-img-selection1` tombait exactement là.
  //
  // La décision — quoi invalider, quoi recharger — vit dans `lib/rafraichirApres.js`, en fonction
  // pure testée : elle distingue quatre positions du chemin créé par rapport à la vue, qui se
  // ressemblent et ne se comportent pas pareil. Ici on ne fait qu'exécuter cette décision.
  //
  // À APPELER APRÈS TOUTE ÉCRITURE qui fait apparaître ou disparaître un nœud : création, import,
  // déplacement, suppression, lot de liens. L'appeler pour rien ne coûte rien — sans chemin touchant
  // la vue, il n'y a aucun appel réseau.
  // ═══ CE QUI TOURNE DOIT CORRESPONDRE À CE QUI TRAVAILLE ══════════════════════════════════════
  //
  // Signalé à 02h22 : « le spinner tourne dans le vide après la notif d'échec ». C'était ma faute, et
  // la faute était de DEVINER : je testais le TEXTE de `status` à la recherche d'une coche ou du mot
  // « erreur ». Un message comme « 0/13 lien(s) créé(s) » ne contient ni l'un ni l'autre, donc le
  // spinner continuait de tourner sur une action terminée depuis longtemps.
  //
  // Un indicateur d'activité doit suivre l'ACTIVITÉ, jamais une chaîne de caractères. `setOccupe`
  // encadre l'action ; le texte reste libre de dire ce qu'il veut.
  const [occupe, setOccupe] = useState(false)
  // COMPTEUR plutôt que booléen : un déplacement en lot appelle le déplacement simple à l'intérieur.
  // Avec un booléen, le `finally` de l'appel interne coupait le spinner alors que le lot tournait
  // encore. Le compteur ne s'éteint qu'au tout dernier `finally`. `avecOccupe` encadre n'importe
  // quelle action ; le spinner suit donc l'ACTIVITÉ réelle, jamais une chaîne de caractères.
  const _occupeRef = useRef(0)
  const debutOccupe = useCallback(() => { _occupeRef.current += 1; setOccupe(true) }, [])
  const finOccupe = useCallback(() => { _occupeRef.current = Math.max(0, _occupeRef.current - 1); if (_occupeRef.current === 0) setOccupe(false) }, [])
  const avecOccupe = useCallback(async (fn) => { debutOccupe(); try { return await fn() } finally { finOccupe() } }, [debutOccupe, finOccupe])

  const tick = useCallback((chemins) => {
    const { aInvalider, aRecharger } = decidesRafraichissement(chemins, folder)
    for (const d of aInvalider) dropDirCache(d)
    if (aRecharger) loadDir(aRecharger)
    // L'arbre de la barre latérale porte les dossiers : un dossier neuf doit y apparaître aussi.
    if (aInvalider.length) { try { loadTree() } catch {} }
  }, [folder])
  useEffect(() => { fetch(`/api/page?action=read&path=${TAGS_PATH}`, { cache: 'no-store' }).then((r) => r.json()).then((j) => { if (j && j.markdown && !j.missing) { tagSha.current = j.sha; try { const split = splitStyleFile(JSON.parse(j.markdown)); setTags(split.colors); folderIconsRef.current = split.icons; setFolderIcons(split.icons) } catch {} } }).catch(() => {}) }, [])
  const saveTags = (next, nextIcons = folderIconsRef.current) => apiPost('save', { path: TAGS_PATH, markdown: JSON.stringify(joinStyleFile(next, nextIcons)), sha: tagSha.current }).then((j) => { if (j && j.ok) tagSha.current = j.sha; else notify({ kind: 'error', label: 'Tags', title: 'Enregistrement refusé', body: 'Les couleurs et icônes de dossiers n’ont pas été enregistrées. Réessaie.' }) }).catch(() => { notify({ kind: 'error', label: 'Tags', title: 'Enregistrement impossible', body: 'Les couleurs et icônes de dossiers n’ont pas été enregistrées. Réessaie.' }) })
  // 2 October 2026 Apply the dialog choice: colour and glyph go through the same tags file and the same saveTags.
  const applyFolderStyle = (key, color, icon) => {
    const nextColors = { ...tags }; if (color) nextColors[key] = color; else delete nextColors[key]
    const nextIcons = { ...folderIconsRef.current }; if (icon) nextIcons[key] = icon; else delete nextIcons[key]
    folderIconsRef.current = nextIcons; setFolderIcons(nextIcons); setTags(nextColors)
    saveTags(nextColors, nextIcons)
  }
  const setTag = (pagePath, color) => {
    const next = { ...tags }; if (!color || next[pagePath] === color) delete next[pagePath]; else next[pagePath] = color
    setTags(next)
    saveTags(next)
  }
