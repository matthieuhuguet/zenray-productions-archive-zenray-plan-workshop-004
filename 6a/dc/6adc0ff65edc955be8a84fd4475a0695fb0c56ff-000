  // qu'elles avaient une solution commune.
  //
  // 1. L'APERÇU DOIT S'OUVRIR EN MOINS DE CENT MILLISECONDES. Il s'appuie sur le cache des
  //    manifestes ; si la grille ne le remplit pas, il paie un aller-retour de 150 à 250 ms.
  // 2. LA GRILLE NE DOIT PAS LIRE SEPT CENT QUARANTE-HUIT MANIFESTES. Chacun passe par `raw`, hors
  //    quota — jusqu'à ce que `raw` sature. Le serveur retombe alors sur l'API REST, et un seul
  //    dossier brûle les cinq mille requêtes horaires. Mesuré le 2026-08-31 à 03h10 : quota rétabli
  //    à 4990, vidé à zéro en quarante secondes.
  //
  // J'ai d'abord sacrifié la seconde pour la première, ce qui a tué le quota. La solution ne demande
  // pas d'arbitrer : la grille prend ses vignettes dans l'INDEX, déjà chargé et sans le moindre appel,
  // et seule l'image RÉELLEMENT VISÉE voit son manifeste préchauffé — une lecture au lieu de 748.
  const entreesAvecVignette = useMemo(() => {
    const liste = dirEntries || []
    if (!liste.length) return liste
    return liste.map((e) => {
      if (e.thumbUrl || !e.contentPath || !/\.img\.json$/.test(e.contentPath)) return e
      const v = indexThumbFor(e.contentPath)
      return v ? { ...e, ...v } : e
    })
  }, [dirEntries])

  // PRÉCHAUFFAGE CIBLÉ : le manifeste de l'image sélectionnée, et d'elle seule. C'est celle sur
  // laquelle Espace sera pressé. Une lecture, hors quota, au moment où l'utilisateur a déjà choisi —
  // là où lire tout le dossier revenait à parier sur 748 images pour en servir une.
  useEffect(() => {
    if (quick) return                      // l'aperçu est déjà ouvert : rien à anticiper
    const seul = selected && selected.size === 1 ? [...selected][0] : null
    if (!seul) return
    const e = (dirEntries || []).find((x) => x.dir === seul)
    const p = e && e.contentPath
    if (!p) return
    if (/\.img\.json$/.test(p)) {
      let vivant = true
      const t = setTimeout(() => { if (vivant) readImgManifestCached(p).catch(() => {}) }, 120)
      return () => { vivant = false; clearTimeout(t) }
    }
    if (isAudioEntry(e)) {
      let vivant = true
      const t = setTimeout(() => {
        if (vivant) {
          readAudioManifestCached(p).then((m) => {
            if (vivant && m) resolveAudioUrlFast(e, m).catch(() => {})
          }).catch(() => {})
          const idx = (dirEntries || []).findIndex((x) => x.dir === seul)
          if (idx >= 0) prefetchAudioNeighbors(dirEntries, idx, 3)
        }
      }, 50)
      return () => { vivant = false; clearTimeout(t) }
    }
  }, [selected, dirEntries, quick])

  // ═══ UNE PROP RECRÉÉE À CHAQUE RENDU REND UN COMPOSANT LOURD INUTILISABLE ═════════════════════
  //
  // RÉGRESSION SIGNALÉE le 2026-08-31 à 02h45 : « input lag énorme de une à deux secondes lorsque
  // j'appuie sur espace, et pareil sur flèche gauche ou droite ». Le Quick Look sert précisément à
  // parcourir des images vite.
  //
  // MA FAUTE. J'avais passé `tri={{ espaces, defaut, trier }}` en objet littéral, construit dans le
  // corps du rendu. Un objet littéral a une identité NEUVE à chaque rendu d'App : le Quick Look
  // recevait donc une prop différente à chaque frappe et se rerendait entièrement — ce qui relance
  // ses résolutions d'image, déchiffrement AES-GCM compris. Le calcul lui-même parcourait en plus
  // les 748 entrées du dossier à chaque fois.
  //
  // La leçon est générale et vaut au-delà d'ici : un composant coûteux ne doit jamais recevoir un
  // objet ou une fonction fabriqués dans le rendu de son parent.
  const triQuickLook = useMemo(() => {
    const espaces = espacesDeTri(dirEntries || [], folder)
    return { espaces, defaut: espaceParDefaut(espaces), trier: (items, espace) => trierVersEspace(items, espace) }
  }, [dirEntries, folder])

  const browseEntries = qDebounced ? searchEntries : entreesAvecVignette
  // P3 (perf) : toute la dérivation filtre+tri est mémoïsée sur ses VRAIES entrées (browseEntries, tags,
  // tagFilter, vue Eagle, critère de tri). AVANT, le sort + copie du tableau se rejouait à CHAQUE render —
  // chaque mousemove pendant une sélection rectangle, chaque tick d'upload, chaque poll de quota — sur
  // potentiellement des milliers d'entrées. MAINTENANT il ne se recalcule QUE si une de ces entrées change.
  // (shownRaw / keepRelevanceOrder / sortFn étaient locaux à ce bloc : repliés ici sans changer le comportement.)
  // Comptage par catégorie de type sur les entrées du dossier courant (badges du filtre).
  const typeCounts = useMemo(() => {
    const c = {}; for (const e of browseEntries) { const k = entryTypeCat(e); c[k] = (c[k] || 0) + 1 }; return c
  }, [browseEntries])
  const shownEntries = useMemo(() => {
    let raw = tagFilter ? browseEntries.filter((e) => styleKeyOf(e) && tags[styleKeyOf(e)] === tagFilter) : browseEntries
    if (typeFilter && typeFilter.size) raw = raw.filter((e) => typeFilter.has(entryTypeCat(e)))
    if (eagleView && eagleIdx) { // C211h : filtre/ordre par vue système Eagle (sur l'index du dossier)
      const order = systemView(eagleIdx, eagleView); const rank = new Map(order.map((x, i) => [x.path, i]))
      raw = browseEntries.filter((e) => rank.has(e.contentPath)).sort((a, b) => rank.get(a.contentPath) - rank.get(b.contentPath))
    }
    // T6 : en recherche AU TRI PAR DÉFAUT (name/asc), on garde l'ordre de pertinence (score) de raw —
    // un tri alpha noierait les matchs exacts. Dès que l'utilisateur choisit un autre tri (ou inverse l'ordre),
    // on respecte son choix. Hors recherche : tri Finder normal comme avant.
    if (!!qDebounced && sort.key === 'name' && sort.dir === 'asc') return raw
    const tagRank = (e) => { const k = styleKeyOf(e) && tags[styleKeyOf(e)]; const i = TAG_COLORS.findIndex((c) => c[0] === k); return i < 0 ? 99 : i }
    return [...raw].sort((a, b) => {
      let r
      if (sort.key === 'numeric') r = a.name.localeCompare(b.name, undefined, { numeric: true })
      else if (sort.key === 'tag') r = tagRank(a) - tagRank(b) || a.name.localeCompare(b.name)
      else if (sort.key === 'kind') r = (Number(!!a.hasKids) - Number(!!b.hasKids)) * -1 || a.name.localeCompare(b.name)
      else r = a.name.localeCompare(b.name)
      return sort.dir === 'desc' ? -r : r
    })
  }, [browseEntries, tagFilter, typeFilter, tags, eagleView, eagleIdx, qDebounced, sort.key, sort.dir])

  // Partition des entrees (06 October 2026) : fil de commentaires en haut, medias en bas
  const isCommentOrNote = useCallback((e) => {
    if (!e || e.hasKids) return false
    if (e.type === 'comment') return true
    const p = e.contentPath || e.dir || ''
    const n = e.name || ''
    return p.endsWith('.comment.json') || n.endsWith('.comment.json')
  }, [])

  const commentEntries = useMemo(() => shownEntries.filter(isCommentOrNote), [shownEntries, isCommentOrNote])
  const mediaEntries = useMemo(() => shownEntries.filter((e) => !isCommentOrNote(e)), [shownEntries, isCommentOrNote])

  // Perf Eagle-like : précharger les VRAIES images (AVIF pleines) dans le cache navigateur -> défilement / QuickLook
  // instantanés. F : AVANT, l'effet mappait TOUTES les images du dossier (_imgPaths) et planifiait un requestIdleCallback
  // + lecture de manifeste par chemin -> sur 100k-1M, des centaines de milliers de callbacks noyaient la file commune
  // (concurrence 6) en concurrence avec les vignettes visibles. MAINTENANT : on précharge UNIQUEMENT les images de la
  // FENÊTRE rendue (remontée par VirtualIconGrid via onWindow), bornée à un petit nombre, en priorité BASSE (jamais
  // devant les vignettes visibles). La fenêtre bouge -> on annule et on relance sur la nouvelle tranche.
  const PREFETCH_CAP = 24 // au plus ~2-3 rangées de pleines images d'avance ; borne dure à toute échelle
  const [winPaths, setWinPaths] = useState([]) // chemins .img.json de la tranche visible+overscan (grille virtuelle)
  // Hors grille virtuelle (petits dossiers, < threshold), pas de onWindow : on retombe sur les entrées affichées (bornées).
  const _visImgPaths = (winPaths.length ? winPaths : shownEntries.map((e) => e.contentPath || ''))
    .filter((p) => p && p.endsWith('.img.json'))
    .slice(0, PREFETCH_CAP)
  const _imgKey = _visImgPaths.join('|')
  useEffect(() => {
    if (!_visImgPaths.length) return
    if (qDebounced) return // EN RECHERCHE : on ne précharge PAS les images pleines (lourd) ; priorité aux vignettes visibles.
    const ctrl = new AbortController()
    const id = setTimeout(() => prefetchFullImages(_visImgPaths, ctrl.signal, PREFETCH_CAP), 400) // laisse les vignettes se poser
    return () => { ctrl.abort(); clearTimeout(id) }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [_imgKey, qDebounced])

  // Capture universelle : route n'importe quels fichiers (image, vidéo, audio, pdf, texte) vers le bon stockage
  // via src/capture/universalCapture.js, dans le dossier Finder courant, puis rafraîchit l'arbre.
  // targetFolder : dossier de destination. Par défaut le dossier Finder courant ; surchargé quand on
  // dépose des fichiers DIRECTEMENT sur une tuile de dossier (le drop choisit alors ce dossier-là).
  // Libellé lisible du dossier de destination à partir d'un nodePath (ex pages/Build/x.img.json -> "Create › Build").
  const folderLabelOf = (np) => {
    const rel = String(np || '').replace(/^pages\/?/, '').replace(/\/[^/]+$/, '')
    return rel ? 'Create › ' + rel.replace(/\//g, ' › ') : 'Create (racine)'
  }
  // Notifie où chaque fichier capturé a atterri (commit + push GitHub + chemin Create). Résumé si >3.
  const notifyCaptured = (results, destF) => {
    const ok = results.filter((r) => r && r.ok !== false && r.nodePath)
    const fail = results.filter((r) => r && r.ok === false)
    const where = folderLabelOf((ok[0] && ok[0].nodePath) || (destF ? destF + '/x' : ''))
    if (ok.length > 3) {
      notify({ kind: 'drive', label: 'GitHub · Create', title: `${ok.length} fichiers importés`, body: `Commités et poussés sur GitHub · rangés dans ${where}` })
    } else {
      ok.forEach((r) => {
        const kind = r.type === 'image' ? 'image' : (r.type === 'video' || r.type === 'video-queued') ? 'video' : r.type === 'page' ? 'page' : 'media'
        const body = r.type === 'video-queued'
          ? `Placeholder créé dans ${folderLabelOf(r.nodePath)} · en file de transcodage local`
          : `Commité et poussé sur GitHub · rangé dans ${folderLabelOf(r.nodePath)}`
        notify({ kind, label: 'GitHub · Create', title: r.name || 'fichier', body })
      })
    }
    // Message RÉEL (r.error) au lieu du générique "réessaie" (2026-07-02) : sans ça, un échec rate-limit,
    // réseau ou fichier trop gros affichaient tous le même texte inutile pour diagnostiquer.
    fail.forEach((r) => notify({ kind: 'info', tint: '#d97757', icon: 'xmark', label: 'Échec', title: r.name || 'fichier', body: (r.error && String(r.error).slice(0, 160)) || 'Import échoué — réessaie' }))
  }

  const runCapture = async (files, targetFolder = folder, visOverride = null) => {
    debutOccupe()
    try { return await runCaptureInterne(files, targetFolder, visOverride) }
    finally { finOccupe() }
  }

  const runCaptureInterne = async (files, targetFolder = folder, visOverride = null) => {
    const list = [...(files || [])].filter(Boolean)
    if (!list.length) return
    const dest = targetFolder || folder || 'pages'
    if ((folderEagleSource && (dest === folder || dest.startsWith(folder + '/'))) || [...folderEagleSourceCache.current.keys()].some((root) => dest === root || dest.startsWith(root + '/'))) {
      notify({ kind: 'info', label: 'Dossier lié', title: 'Import protégé', body: 'Importe dans la source du bundle : le nouveau média apparaîtra dans tous ses emplacements.' })
      return
    }

    // VISIBILITÉ DE LA CAPTURE IMAGE — TOUT-PUBLIC PAR DÉFAUT (CDN jsDelivr, hors quota API).
    //  - visOverride explicite -> on l'utilise tel quel.
    //  - sinon : visibilité EFFECTIVE du dossier de destination (.zrvis.json hérité, DÉFAUT 'public').
    // Plus de MODALE de choix sur un lot : zéro friction, tout part en public sauf si un dossier est
    // EXPLICITEMENT marqué privé (toggle par-dossier conservé pour ce cas rare).
    let vis = visOverride
    if (!vis) vis = await resolveFolderVis(dest)

    // VIDÉO : on NE court-circuite PLUS vers la commande locale. Tout (vidéos comprises) passe par
    // captureFiles -> routeFile, qui AIGUILLE PAR TAILLE : < seuil + navigateur capable = transcodage
    // HLS chiffré DANS LE NAVIGATEUR (ffmpeg.wasm) + upload auto au bon dossier ; sinon flux local
    // (placeholder + worker + commande à coller). C'est là que vit le `if` de taille.
    const captureList = list
    try {
      setUploadProgress(0)
      // mode = choix UI (toggle bouton Upload) : 'wasm' (navigateur) | 'cmd' (commande terminal) | 'auto'.
      // vis = public/privé pour les IMAGES (propagé jusqu'à captureImage). Sans effet sur vidéo/audio/pdf.
      const results = await captureFiles(captureList, { folder: dest, vis, onProgress: (r) => setUploadProgress(r) })
      setUploadProgress(null)
      // Vidéo non web-native : universalCapture a déjà créé un nœud placeholder + mis la vidéo
      // Vidéo : chemin Terminal unique (type 'video-cmd'). Pas de placeholder ; la notif d'onboarding (2 étapes
      // + commande copiée) est déjà affichée par captureVideoLocalCmd. On pose juste un petit toast de rappel.
      const need = (results || []).filter((r) => r && (r.type === 'video-cmd' || r.type === 'video-queued' || r.type === 'video-needs-transcode'))
      const fail = (results || []).filter((r) => r && r.ok === false)
      if (need.length) { setCaptureToast(need.length > 1 ? `${need.length} vidéos : voir la commande (Terminal)` : 'Vidéo : place-la dans ~/Downloads + colle la commande'); setTimeout(() => setCaptureToast(''), 4500) }
      else if (fail.length) setStatus('import partiel — ' + fail.length + ' échec(s)')
      else setStatus('importé ✓')
      // Notifications macOS : montrer OÙ chaque fichier a atterri (commit + push GitHub + chemin dans Create).
      notifyCaptured(results || [], dest)
      // AFFICHAGE OPTIMISTE : on met à jour l'index global `paths` (recherche) ET on injecte les nouveaux nœuds
      // dans le listing du dossier courant (optimisticDir = écran + cache SWR) -> le fichier importé APPARAÎT
      // immédiatement. La vérité reste le drive : loadTree() (children) revalide juste derrière.
      const newPaths = (results || []).map((r) => r && r.ok && r.nodePath).filter(Boolean)
      if (newPaths.length) {
        const merged = Array.from(new Set([...(pathsRef.current || []), ...newPaths]))
        pathsRef.current = merged
        setPaths(merged)
        if (dest === folder) {
          const fresh = entriesOfNodes(newPaths, dest).filter((e) => e.contentPath)
          if (fresh.length) optimisticDir((es) => { const have = new Set(es.map((x) => x.name)); return [...es, ...fresh.filter((x) => !have.has(x.name))] })
        }
        // L'affichage optimiste ci-dessus ne couvre QUE l'import dans le dossier regardé. Importer
        // vers un sous-dossier — ou depuis un glisser sur une tuile de dossier — ne montrait rien
        // jusqu'au rechargement. Le tick voit les chemins réels et tranche lui-même.
        tick(newPaths)
      }
      loadTree()
    } catch (err) { setUploadProgress(null); setStatus('erreur import : ' + (err && err.message || err)) }
  }

  // TÉLÉCHARGEMENT ZIP (bouton toolbar, 2026-07-02, étendu 2026-07-02 avec sélection) : bulk-download NON
  // RÉCURSIF. Reprend la CONVENTION déjà établie ailleurs dans ce Finder (trashSelected, moveMany…) : si une
  // sélection est active (`selected` non vide — Cmd/Shift-clic, ou même un simple clic sur une tuile), le ZIP
  // ne porte QUE sur la sélection ; sinon il porte sur tout le dossier affiché (shownEntries). Comportement
  // "clique les médias voulus puis clique ZIP" demandé par Matthieu, sans réinventer un mode dédié : le Finder
  // sait déjà sélectionner, on branche juste le bouton dessus. Images + fichiers bruts zippés (déchiffrement
  // réutilisé de ImageNodeViewer.jsx, aucune nouvelle crypto) ; vidéos streamées hors ZIP (téléchargements
  // natifs échelonnés, cf. bulkZip.js).
  const downloadFolderZip = async () => {
    const isZippableEntry = (e) => e.contentPath && (e.contentPath.endsWith('.img.json') || e.contentPath.endsWith('.file.json') || e.contentPath.endsWith('.media.json'))
    const pool = selected.size ? shownEntries.filter((e) => selected.has(e.dir)) : shownEntries
    const targets = pool.filter(isZippableEntry)
    const usingSelection = selected.size > 0
    if (!targets.length) { notify({ icon: 'xmark', tint: '#8E8E93', label: 'ZIP', title: 'Rien à télécharger', body: usingSelection ? 'Aucun média zippable dans la sélection.' : 'Ce dossier ne contient aucune image, vidéo ou fichier.' }); return }
    const zipFileName = pgPretty((folder || 'dossier').split('/').pop())
    await runZipDownload(targets, zipFileName)
  }

  // LIENS YOUTUBE / YOUTUBE AUDIO / GOOGLE MAPS (2026-07-02 → 2026-07-04) : crée un nœud .media.json par
  // lien collé, dans le dossier courant. Batch (un lien par ligne) — même geste que runCapture (index de
  // recherche, insertion optimiste dans la vue si on est déjà dans le bon dossier) mais sans passer par le
  // pipeline binaire (rien à uploader). Les 3 modales partageaient LE MÊME quintuplet useState + LA MÊME
  // fonction submit async (seul le batch creator appelé et le texte de notify() changeaient) — portés
  // maintenant par useLinkImportModal ; chaque instance ne garde que ce qui lui est propre : quel batch
  // creator appeler et quelle notify() construire une fois l'import terminé.
  const ytVideoImport = useLinkImportModal(createYoutubeLinkNodesBatch, {
    folder, pathsRef, setPaths, dropDirCache, loadDir,
    onImported: (okList, failList) => notify({
      big: true, icon: 'film', tint: '#d97757', label: 'Liens YouTube',
      title: okList.length ? `${okList.length} vidéo(s) ajoutée(s)` : 'Échec',
      body: failList.length ? `${failList.length} lien(s) non reconnu(s) ou en échec.` : (okList.length ? `Rangées dans ${folderLabelOf(okList[0].nodePath)}` : 'Aucun lien YouTube valide trouvé.'),
    }),
  })
  const ytAudioImport = useLinkImportModal((text, dest, onProgress) => createYoutubeLinkNodesBatch(text, dest, onProgress, { audioOnly: true }), {
    folder, pathsRef, setPaths, dropDirCache, loadDir,
    onImported: (okList, failList) => notify({
      big: true, icon: 'music.note', tint: '#d97757', label: 'Liens audio YouTube',
      title: okList.length ? `${okList.length} piste(s) ajoutée(s)` : 'Échec',
      body: failList.length ? `${failList.length} lien(s) non reconnu(s) ou en échec.` : (okList.length ? `Rangées dans ${folderLabelOf(okList[0].nodePath)}` : 'Aucun lien YouTube valide trouvé.'),
    }),
  })
  const gmapsImport = useLinkImportModal(createGmapsLinkNodesBatch, {
    folder, pathsRef, setPaths, dropDirCache, loadDir,
    onImported: (okList, failList) => notify({
      big: true, icon: 'mappin', tint: '#34a853', label: 'Liens Google Maps',
      title: okList.length ? `${okList.length} lieu(x) ajouté(s)` : 'Échec',
      body: failList.length ? `${failList.length} lien(s) non reconnu(s) ou en échec.` : (okList.length ? `Rangées dans ${folderLabelOf(okList[0].nodePath)}` : 'Aucun lien Google Maps valide trouvé.'),
    }),
  })

  // VISIBILITÉ DU DOSSIER COURANT (toolbar + défaut modale). On la re-résout au changement de dossier
  // ou après un toggle (visNonce). resolveFolderVis remonte l'arbre (héritage) et met en cache.
  useEffect(() => {
    let alive = true
    resolveFolderVis(folder).then((v) => { if (alive) setFolderVis_(v) })
    return () => { alive = false }
  }, [folder, visNonce])

  // Bascule public/privé d'un dossier (réutilisé par le bouton toolbar ET le menu clic droit).
  // Écrit le marqueur .zrvis.json, invalide le cache, force la re-résolution + repeint les badges.
  const toggleFolderVis = async (dir, label) => {
    const cur = await resolveFolderVis(dir)
    const next = cur === 'public' ? 'private' : 'public'
    const ok = await setFolderVis(dir, next)
    setVisNonce((n) => n + 1) // invalide le cache visuel + relance les résolutions (toolbar + tuiles)
    notify(ok
      ? { kind: 'info', tint: '#d97757', icon: next === 'public' ? 'link' : 'archivebox', label: 'Visibilité dossier', title: label || pgPretty((dir || '').split('/').pop()), body: next === 'public' ? 'Public — nouvelles images servies par le CDN jsDelivr.' : 'Privé — nouvelles images servies par le proxy.' }
      : { kind: 'info', tint: '#d97757', icon: 'xmark', label: 'Visibilité dossier', title: label || pgPretty((dir || '').split('/').pop()), body: 'Échec de la bascule — réessaie.' })
    return ok ? next : null
  }

  // BADGE PUBLIC sur les tuiles : on pré-résout (best-effort) la visibilité des dossiers visibles pour
  // remplir le cache module. Le rendu lit ensuite peekFolderVis() de façon synchrone. visNonce repeint
  // après un toggle. Borné aux dossiers (pas les pages), donc peu de fetchs ; chaque résultat est caché.
  useEffect(() => {
    let alive = true
    const dirs = (shownEntries || []).filter((e) => !e.contentPath || e.hasKids).map((e) => e.dir)
    const todo = dirs.filter((d) => peekFolderVis(d) === undefined) // ne refait pas ce qui est déjà caché
    if (!todo.length) return
    // PERF (anti-tempête) : sur un gros dossier (ex. 261 sous-dossiers), résoudre la visibilité de TOUS d'un coup
    // saturait le pool de connexions du navigateur et figeait la navigation. On PLAFONNE (les badges des tuiles
    // hors écran sont cosmétiques) et on BORNE la concurrence à 6. Les markers sont cachés (folderVisibility.js),
    // donc les ancêtres partagés ne sont lus qu'une fois.
    const capped = todo.slice(0, 80)
    let i = 0
    const worker = async () => { while (alive && i < capped.length) { const d = capped[i++]; try { await resolveFolderVis(d) } catch {} } }
    Promise.all(Array.from({ length: 6 }, worker)).then(() => { if (alive) setVisTick((n) => n + 1) }) // cache rempli -> repeint
    return () => { alive = false }
  }, [shownEntries, visNonce])

  // C57/C58 — presse-papiers dans Create : coller une image crée une page image dans le dossier courant ; Cmd+C copie la page ouverte comme référence.
  useClipboardTarget('create', {
    onPasteImage: async (files) => {
      // Même politique que le drop : la visibilité effective du dossier est résolue dans runCapture.
      // Un collage dans un dossier privé ne doit jamais publier l'image sur le CDN public.
      await runCapture(files, folder)
    },
    onPasteInternal: async () => {
      if (clip.current && clip.current.items.length) await pasteClip()
    },
    onCopy: (e, showToast) => {
      if (!cur) return
      const name = baseName(cur.path)
      e.preventDefault()
      e.clipboardData.setData('text/plain', `[[${name}]]`)
      e.clipboardData.setData('application/zenray-page+json', JSON.stringify({ path: cur.path, name }))
      showToast(`Page « ${pgPretty(name)} » copiée`)
    },
  }, true)

  // PONT GALERIES-POINTEUR -> CREATE (2026-08-21, clic droit « Déplacer dans Create » / « Supprimer de
  // Create » ajouté à GalleryView.jsx). Ce composant est chargé séparément (lazy), sans accès aux
  // fermetures d'ici — `trashPath` (move + sidecar + retry) et `runCapture` (tout le pipeline
  // d'ingestion) sont délicats, on ne les DUPLIQUE jamais : on les rappelle via deux événements, même
