  // binaire (contentHash), le drive porteur (zenray-media-NN / zenray-vid-NN) et la taille. Ces infos servent
  // à (a) l'Undo (restaurer au chemin d'origine) et (b) la suppression définitive plus tard (refcount serveur).
  const sidecarFor = (contentPath, descriptorText) => {
    const ty = typeOfPath(contentPath)
    let originalRepo = null, originalDrive = null, contentHash = null, fileSize = null
    try {
      const m = descriptorText ? JSON.parse(descriptorText) : null
      if (m) {
        if (m.repo) {
          originalRepo = m.repo
          // Famille générique zenray-<kind>-<vis>-NN + legacy (zenray-media = img/private, zenray-vid = vid/public).
          const gm = /^(zenray-(?:img|vid|audio|doc|table|markdown)-(?:public|private))-\d{2,}$/.exec(m.repo)
