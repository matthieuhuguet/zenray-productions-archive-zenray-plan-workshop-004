  const [createSearchOpen, setCreateSearchOpen] = usePersistedState('zr:create:searchOpen', true)
  // Dossier courant du Finder, PERSISTÉ (localStorage) comme `view`/`cur` : après un reload, on reste
  // dans le dossier où on était, donc un drop/Ctrl-V juste après un reload atterrit au bon endroit (pas à la racine).
  // GARDE (2026-07-14, bug production trouvé par Matthieu) : `folder` doit TOUJOURS être sous l'arbre "pages"
