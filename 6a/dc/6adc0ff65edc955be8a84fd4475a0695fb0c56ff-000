  // skill (ou restait dans Memory/Skills) au lieu de la vue dossier normale. Chaque vue de la sidebar
  // repart désormais sur sa présentation racine, et Create garde SA navigation intacte.
  const isOverlayView = !!forceFolder || !!planLibrary
  const [persistedCur, setPersistedCur] = useState(() => { try { const p = localStorage.getItem('zr:create:cur'); return (p && (p === 'pages' || p.startsWith('pages/'))) ? { path: p } : null } catch { return null } })
  const [localCur, setLocalCur] = useState(null)
