        </div>
      )}
    </div>
  )
}

function QuickLook({ t, path, name, onOpen }) {
  const [md, setMd] = useState(null)
  useEffect(() => { setMd(null); fetch(`/api/page?action=read&path=${encodeURIComponent(path)}`, { cache: 'no-store' }).then((r) => r.json()).then((j) => setMd(j.markdown || '')).catch(() => setMd('')) }, [path])
  return (
    <div>
      <div style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '14px 18px', borderBottom: `1px solid ${t.border}`, position: 'sticky', top: 0, background: t.cardBg }}>
        <span style={{ fontFamily: "var(--zr-police-sans)", fontSize: 'var(--zr-ui-3xl)', fontWeight: 700 }}>{pgPretty(name)}</span>
        <button onClick={onOpen} style={{ ...btn(t), marginLeft: 'auto', color: PALETTE.primary, borderColor: PALETTE.primary }}>Ouvrir</button>
      </div>
      <div style={{ padding: '12px 18px 26px' }}>
        {md === null ? <div style={{ color: t.textSecondary }}>chargement…</div> : md.trim() ? <Markdown t={t} md={md.length > 4000 ? md.slice(0, 4000) + '\n\n…' : md} /> : <div style={{ color: t.textSecondary }}>Page vide.</div>}
      </div>
    </div>
  )
}

/* ───────── Menu du fil d'Ariane façon Finder macOS (2026-07-14, demande Matthieu) ─────────
   Navigation en COLONNES : chaque colonne liste les dossiers d'un niveau ; seul un clic ouvre
   ses enfants. Un second clic sur la ligne sélectionnée navigue et ferme. La cascade s'ouvre PRÉ-POSITIONNÉE
   sur le chemin courant (on voit immédiatement où on est, coche incluse).

   POURQUOI UN PORTAL (le « problème fondamental de crop » des tentatives précédentes) : la pilule du
   fil d'Ariane a `overflow:hidden` (anti-débordement des segments) — tout panneau en position:absolute
   À L'INTÉRIEUR est fatalement rogné par elle. Règle transverse §8 de Design1.md : un panneau flottant
   sous un ancêtre à overflow/backdrop-filter/transform se rend via createPortal(document.body) en
   position:fixed, coordonnées mesurées sur le déclencheur -> AUCUN ancêtre ne peut plus le couper. */
// PANNEAU CONTRÔLÉ (état d'ouverture porté par Pages, comme MoveToDialog) — PIÈGE ÉVITÉ, déjà payé une
// fois sur le sous-menu du clic droit : `Crumbs` est une fonction recréée à CHAQUE render de Pages, donc
// tout composant à état monté dessous est démonté/remonté au moindre re-render (notifications, chargements)
// -> un menu qui porte son propre `open` s'y referme tout seul, instantanément. Ici le déclencheur (dans
// Crumbs) ne fait que remonter {top,right,dir,onPick} à Pages ; le panneau vit à un endroit STABLE.
function FinderPathPanel({ t, paths, currentFolder, anchor, onPick, onClose }) {
  // Cascade pré-ouverte sur le chemin courant : pages/A/B/C -> colonnes racine, A, B (C visible et coché).
  const [chain, setChain] = useState(() => {
    const segs = (currentFolder || 'pages').split('/')
    const pre = []
    for (let i = 2; i <= segs.length; i++) pre.push(segs.slice(0, i).join('/'))
    return pre
  })
  const [indexPaths, setIndexPaths] = useState(null)

  // `action=tree` peut être tronqué par GitHub au-delà de ~100k nœuds. L'index CDN est exhaustif : son union
  // avec `paths` garantit que le menu montre réellement TOUS les dossiers, y compris les ajouts tout récents.
  useEffect(() => {
    let live = true
    loadSearchIndex().then((idx) => { if (live && idx && Array.isArray(idx.paths)) setIndexPaths(idx.paths) }).catch(() => {})
    return () => { live = false }
  }, [])

  // Parent -> sous-dossiers directs, dérivé de l'arbre global déjà en mémoire (zéro réseau).
  const kidsOf = useMemo(() => {
    const dirSet = new Set(['pages'])
    const source = indexPaths ? [...new Set([...(paths || []), ...indexPaths])] : (paths || [])
    for (const p of source) {
      if (!p.startsWith('pages/')) continue
      const parts = p.split('/')
      for (let i = 2; i < parts.length; i++) dirSet.add(parts.slice(0, i).join('/'))
    }
    const m = new Map()
    for (const d of dirSet) {
      if (d === 'pages') continue
      const parent = d.slice(0, d.lastIndexOf('/'))
      if (!m.has(parent)) m.set(parent, [])
      m.get(parent).push(d)
    }
    for (const list of m.values()) list.sort((a, b) => a.localeCompare(b, 'fr', { numeric: true, sensitivity: 'base' }))
    return m
  }, [paths, indexPaths])

  const COL_W = 238
  const columns = [['pages', kidsOf.get('pages') || []], ...chain.map((d) => [d, kidsOf.get(d) || []])]
    .filter(([, kids]) => kids.length > 0)

  // Une ligne de colonne, fidèle au Finder : dossier bleu, nom, chevron ">" si enfants, coche si dossier
  // COURANT, surlignage bleu système plein (texte blanc) pour le fil de la cascade. Le hover reste
  // purement visuel : clic 1 = ouvre les enfants, clic 2 sur la même ligne = navigue et ferme.
  const Row = ({ d, colIdx }) => {
    const kids = kidsOf.get(d)
    const inChain = chain[colIdx] === d
    const isCurrent = d === currentFolder
    const selected = inChain || isCurrent
    return (
      <ColumnMenuItem
        t={t}
        onClick={() => {
          // Finder macOS : le hover ne change jamais la navigation. Un clic sur un dossier ouvre sa
          // colonne suivante ; un clic sur une feuille navigue et ferme le panneau.
          if (kids && kids.length && !inChain) { setChain((c) => { const n = c.slice(0, colIdx); n.push(d); return n }); return }
          onClose(); onPick(d)
        }}
        selected={selected}
        current={isCurrent}
        icon={<FolderIcon s={17} empty={false} />}
        trailing={kids && kids.length > 0 ? <Icon name="chevron.right" size={10} weight={2} /> : null}
      >
        {d.split('/').pop()}
      </ColumnMenuItem>
    )
  }

  return (
    <ColumnMenuShell
      t={t}
      anchor={anchor}
      onClose={onClose}
      ariaLabel="Tous les dossiers"
      columnWidth={COL_W}
      triggerSelector="[data-zr-pathmenu-trigger]"
      columns={columns.map(([parent, kids], colIdx) => (
        <ColumnMenuColumn key={parent} t={t} width={COL_W} index={colIdx} label={parent.split('/').pop()}>
          {kids.map((d) => <Row key={d} d={d} colIdx={colIdx} />)}
        </ColumnMenuColumn>
      ))}
    />
  )
}

/* ───────── « Déplacer vers… » : picker d'arborescence (2026-07-12, demande Matthieu) ─────────
   Alternative propre au drag-and-drop pour déplacer une sélection : arbre des dossiers du drive
   (dérivé de `paths`, replié par défaut -> seuls les nœuds visibles sont rendus, fluide même avec
   des dizaines de milliers de chemins), création de dossier à la volée (marqueur .zrfolder.json,
   NOM EXACT, collision -> sélectionne l'existant), checkboxes par élément (tout coché par défaut),
   bouton Valider. Le déplacement réel est fait par le PARENT via moveMany (chemin éprouvé du
   drag-and-drop : retrait optimiste, écritures séquentielles retryées, notifications, resynchro). */
function MoveToDialog({ t, items, paths, currentFolder, onClose, onCreateFolder, onConfirm }) {
  const [checked, setChecked] = useState(() => new Set(items.map((i) => i.key)))
  const [dest, setDest] = useState(null)
  const [extraDirs, setExtraDirs] = useState([]) // dossiers créés depuis le dialogue (pas encore revenus par loadPaths)
  const [creating, setCreating] = useState(false)
  const [newName, setNewName] = useState('')
  const [busy, setBusy] = useState(false)
  const [createErr, setCreateErr] = useState(null)
  // 2e source de chemins : l'index de recherche v2 (CDN, ~127k chemins). Nécessaire parce que l'arbre git
  // (`paths`, action=tree) est TRONQUÉ par GitHub sur un gros repo (truncated:true observé en réel) : les
  // chemins en fin d'arbre manquent, donc des dossiers entiers manqueraient au picker. L'union des deux
  // sources couvre : index = exhaustif mais en retard de réindexation ; tree = frais mais tronqué.
  const [idxPaths, setIdxPaths] = useState(null)
  useEffect(() => {
    let live = true
    loadSearchIndex().then((ix) => { if (live && ix && Array.isArray(ix.paths)) setIdxPaths(ix.paths) }).catch(() => {})
    return () => { live = false }
  }, [])
  // Dossiers = tous les préfixes de répertoires des chemins sous pages/ (un « dossier » du Finder n'existe
  // qu'à travers ses descendants ou son marqueur .zrfolder.json, qui est lui-même un chemin descendant).
  const dirs = useMemo(() => {
    const s = new Set(['pages'])
    const scan = (list) => {
      for (const p of (list || [])) {
        if (!p.startsWith('pages/')) continue
        const parts = p.split('/')
        for (let i = 2; i < parts.length; i++) s.add(parts.slice(0, i).join('/'))
      }
    }
    scan(paths); scan(idxPaths)
    for (const d of extraDirs) s.add(d)
    return s
  }, [paths, idxPaths, extraDirs])
  const kidsOf = useMemo(() => {
    const m = new Map()
    for (const d of dirs) {
      if (d === 'pages') continue
      const parent = d.split('/').slice(0, -1).join('/')
      if (!m.has(parent)) m.set(parent, [])
      m.get(parent).push(d)
    }
    for (const arr of m.values()) arr.sort((a, b) => a.split('/').pop().localeCompare(b.split('/').pop(), 'fr', { numeric: true, sensitivity: 'base' }))
    return m
  }, [dirs])
  // Déplié par défaut : la racine + les ancêtres du dossier courant (oriente tout de suite l'utilisateur).
  const [expanded, setExpanded] = useState(() => {
    const s = new Set(['pages'])
    let p = currentFolder
    while (p && p !== 'pages') { s.add(p); p = p.split('/').slice(0, -1).join('/') }
    return s
  })
  // Destinations interdites : le dossier ACTUEL (no-op) et, pour chaque élément-dossier déplacé, lui-même
  // + tout son sous-arbre (un dossier ne peut pas entrer dans lui-même — même règle que moveMany/serveur).
  const forbiddenBases = useMemo(() => items.filter((i) => i.hasKids).map((i) => i.base), [items])
  const isForbidden = (d) => d === currentFolder || forbiddenBases.some((b) => d === b || d.startsWith(b + '/'))
  const toggleChecked = (k) => setChecked((s) => { const n = new Set(s); if (n.has(k)) n.delete(k); else n.add(k); return n })
  const pickDest = (d) => { if (isForbidden(d)) return; setDest(d); setExpanded((s) => new Set([...s, d])) }
  const createNow = async () => {
    const nm = newName.replace(/\//g, '-').trim()
    if (!nm || nm === '.' || nm === '..') { setCreateErr('Nom invalide.'); return }
    const parent = dest || 'pages'
    const d = `${parent}/${nm}`
    if (dirs.has(d)) { pickDest(d); setCreating(false); setNewName(''); setCreateErr(null); return } // existe déjà -> on le sélectionne
    setBusy(true); setCreateErr(null)
    const ok = await onCreateFolder(d)
    setBusy(false)
    if (!ok) { setCreateErr('Création impossible — réessaie.'); return }
    setExtraDirs((x) => [...x, d])
    setExpanded((s) => new Set([...s, parent, d]))
    setDest(d)
    setCreating(false); setNewName('')
  }
  useEffect(() => {
    const h = (ev) => { if (ev.key === 'Escape') { ev.stopPropagation(); onClose() } }
    window.addEventListener('keydown', h, true)
    return () => window.removeEventListener('keydown', h, true)
  }, [onClose])
  // Rendu récursif d'un nœud (seuls les nœuds sous un parent déplié sont rendus).
  const Row = ({ d, depth }) => {
    const kids = kidsOf.get(d) || []
    const isOpen = expanded.has(d)
    const disabled = isForbidden(d)
    const isDest = dest === d
    const label = d === 'pages' ? 'Create' : pgPretty(d.split('/').pop())
    return (
      <React.Fragment>
        <div onClick={() => !disabled && pickDest(d)}
          style={{ display: 'flex', alignItems: 'center', gap: 7, padding: '5px 9px', paddingLeft: 9 + depth * 16, borderRadius: 8, cursor: disabled ? 'default' : 'pointer', background: isDest ? PALETTE.primarySoft : 'transparent', boxShadow: isDest ? `inset 0 0 0 1.5px ${PALETTE.primary}` : 'none', opacity: disabled ? 0.42 : 1, userSelect: 'none' }}>
          <span onClick={(ev) => { ev.stopPropagation(); if (kids.length) setExpanded((s) => { const n = new Set(s); if (n.has(d)) n.delete(d); else n.add(d); return n }) }}
            style={{ width: 14, display: 'inline-flex', justifyContent: 'center', flexShrink: 0, cursor: kids.length ? 'pointer' : 'default', transform: isOpen ? 'rotate(90deg)' : 'none', transition: 'transform .12s ease', opacity: kids.length ? 0.65 : 0 }}>
            <Icon name="chevron.right" size={11} weight={2.2} color={t.textSecondary} />
          </span>
          <Icon name="folder" size={15} color={isDest ? PALETTE.primary : '#0a84ff'} weight={1.6} />
          <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', color: t.textPrimary, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis', flex: 1 }}>{label}</span>
          {d === currentFolder && <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-3xs)', textTransform: 'uppercase', letterSpacing: 0.8, color: t.textSecondary, flexShrink: 0 }}>actuel</span>}
        </div>
        {isOpen && kids.map((k) => <Row key={k} d={k} depth={depth + 1} />)}
      </React.Fragment>
    )
  }
  const nChecked = checked.size
  const canGo = dest && !isForbidden(dest) && nChecked > 0 && !busy
  const crumb = dest ? (dest === 'pages' ? 'Create' : 'Create › ' + dest.slice('pages/'.length).split('/').map(pgPretty).join(' › ')) : 'Choisis un dossier de destination'
  return (
    <div onClick={onClose} style={{ position: 'fixed', inset: 0, zIndex: 9980, background: 'rgba(0,0,0,0.45)', display: 'grid', placeItems: 'center', padding: 16 }}>
      <div onClick={(ev) => ev.stopPropagation()} style={{ width: 'min(620px, 94vw)', maxHeight: '78vh', display: 'flex', flexDirection: 'column', background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: RADII.lg, boxShadow: SHADOWS.lg, overflow: 'hidden' }}>
        {/* en-tête */}
        <div style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '15px 18px 12px' }}>
          <Icon name="folder" size={19} grad weight={1.6} />
          <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xl)', fontWeight: 600, color: t.textPrimary, flex: 1 }}>Déplacer {items.length > 1 ? `${items.length} éléments` : `« ${items[0].name} »`}</span>
          <button onClick={onClose} aria-label="Fermer" style={{ background: 'transparent', border: 'none', cursor: 'pointer', padding: 4, display: 'inline-flex', opacity: 0.6 }}><Icon name="xmark" size={14} weight={2} color={t.textPrimary} /></button>
        </div>
        {/* éléments à déplacer (checkboxes) */}
        <div style={{ padding: '0 18px 10px' }}>
          <div style={{ display: 'flex', alignItems: 'center', marginBottom: 5 }}>
            <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-3xs)', textTransform: 'uppercase', letterSpacing: 1, color: t.textSecondary, flex: 1 }}>Éléments · {nChecked}/{items.length}</span>
            <button onClick={() => setChecked(nChecked === items.length ? new Set() : new Set(items.map((i) => i.key)))}
              style={{ background: 'transparent', border: 'none', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: PALETTE.primary, padding: 0 }}>{nChecked === items.length ? 'Tout décocher' : 'Tout cocher'}</button>
          </div>
          <div style={{ maxHeight: 132, overflowY: 'auto', border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: 4 }}>
            {items.map((it) => (
              <label key={it.key} style={{ display: 'flex', alignItems: 'center', gap: 8, padding: '4px 7px', borderRadius: 7, cursor: 'pointer', opacity: checked.has(it.key) ? 1 : 0.5 }}>
                <input type="checkbox" checked={checked.has(it.key)} onChange={() => toggleChecked(it.key)} style={{ accentColor: PALETTE.primary, width: 14, height: 14, cursor: 'pointer', flexShrink: 0 }} />
                {it.hasKids && <Icon name="folder" size={13} color="#0a84ff" weight={1.6} />}
                <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', color: t.textPrimary, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{it.name}</span>
              </label>
            ))}
          </div>
        </div>
        {/* arbre de destination */}
        <div style={{ padding: '0 18px', display: 'flex', flexDirection: 'column', minHeight: 0, flex: 1 }}>
          <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-3xs)', textTransform: 'uppercase', letterSpacing: 1, color: t.textSecondary, marginBottom: 5 }}>Destination</span>
          <div style={{ flex: 1, minHeight: 170, overflowY: 'auto', border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: 5 }}>
            <Row d="pages" depth={0} />
          </div>
          {/* création de dossier à la volée, sous la destination sélectionnée (ou la racine) */}
          <div style={{ padding: '7px 0 2px' }}>
            {creating ? (
              <div style={{ display: 'flex', alignItems: 'center', gap: 7 }}>
                <Icon name="folder" size={14} color="#0a84ff" weight={1.6} />
                <input autoFocus value={newName} onChange={(ev) => setNewName(ev.target.value)} placeholder={`Nouveau dossier dans ${dest ? pgPretty(dest.split('/').pop()) : 'Create'}`}
                  onKeyDown={(ev) => { ev.stopPropagation(); if (ev.key === 'Enter') createNow(); if (ev.key === 'Escape') { setCreating(false); setNewName(''); setCreateErr(null) } }}
                  style={{ flex: 1, background: 'transparent', border: `1px solid ${t.border}`, borderRadius: RADII.sm, outline: 'none', padding: '5px 9px', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', color: t.textPrimary }} />
                <button onClick={createNow} disabled={busy} style={{ background: PALETTE.primary, color: '#fff', border: 'none', borderRadius: RADII.sm, padding: '5px 12px', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', fontWeight: 600, opacity: busy ? 0.6 : 1 }}>{busy ? '…' : 'Créer'}</button>
                <button onClick={() => { setCreating(false); setNewName(''); setCreateErr(null) }} style={{ background: 'transparent', border: 'none', cursor: 'pointer', padding: 4, display: 'inline-flex', opacity: 0.6 }}><Icon name="xmark" size={12} weight={2} color={t.textPrimary} /></button>
              </div>
            ) : (
              <button onClick={() => setCreating(true)} style={{ background: 'transparent', border: 'none', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary, padding: '2px 0' }}>+ Nouveau dossier{dest ? ` dans ${pgPretty(dest.split('/').pop()) || 'Create'}` : ''}</button>
            )}
            {createErr && <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: '#FF3B30', marginTop: 3 }}>{createErr}</div>}
          </div>
        </div>
        {/* pied : destination résumée + actions */}
        <div style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '10px 18px 14px', borderTop: `1px solid ${t.border}`, marginTop: 8 }}>
          <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: dest ? t.textPrimary : t.textSecondary, flex: 1, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>{crumb}</span>
          <button onClick={onClose} style={{ background: 'transparent', border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: '6px 14px', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', fontWeight: 500, color: t.textPrimary }}>Annuler</button>
          <button onClick={() => canGo && onConfirm(items.filter((i) => checked.has(i.key)).map((i) => i.key), dest)} disabled={!canGo}
            style={{ background: canGo ? PALETTE.gradient : t.surface, color: canGo ? '#fff' : t.textSecondary, border: 'none', borderRadius: RADII.sm, padding: '6px 18px', cursor: canGo ? 'pointer' : 'default', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', fontWeight: 600 }}>
            Déplacer{nChecked > 1 ? ` ${nChecked} éléments` : nChecked === 1 ? ' 1 élément' : ''}
          </button>
        </div>
      </div>
    </div>
  )
}

/* ───────── Bloc propriétés en tête de page (façon Notion) ───────── */
// Icône de page = SF Symbols (plus d'emoji). Liste importée de Icon.jsx (SYMBOLS).
const PAGE_ICONS = SYMBOLS

// Masqué par défaut (2026-07-12, demande Matthieu — design plus minimaliste). Code intact, juste caché :
// remettre à true pour réafficher l'icône de page + les contrôles +/− Icône sans rien réécrire.
const SHOW_PAGE_ICON_CONTROLS = false

function PropertiesBlock({ t, path, paths, onOpen, title, onTitle }) {
  const PROPS_PATH = path.replace(/\.md$/, '.props.json')
  const [props, setProps] = useState(null) // { date, place, custom: [{id,name,value}] }
  const sha = useRef(null)
  const saveTimer = useRef(null)
  const pending = useRef(null) // dernière valeur à persister, en attente du débounce (pour flush au démontage)
  const lastTitle = useRef(undefined) // dernier titre PERSISTÉ (pour notifier uniquement les vrais changements)
  const [pick, setPick] = useState(false)
  const [addOpen, setAddOpen] = useState(false)
  const uploadCover = async (file) => { const webp = await fileToWebp(file).catch(() => null); if (!webp) return; const j = await fetch('/api/img', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ dataUrl: webp }) }).then((r) => r.json()).catch(() => null); if (j && j.url) save({ ...props, cover: j.url }) }
  useEffect(() => {
    sha.current = null; setProps(null); pending.current = null
    fetch(`/api/page?action=read&path=${encodeURIComponent(PROPS_PATH)}`, { cache: 'no-store' }).then((r) => r.json())
      .then((j) => {
        let parsed = {}
        if (j && j.markdown && !j.missing) { sha.current = j.sha; try { parsed = JSON.parse(j.markdown) } catch { parsed = {} } }
        setProps(parsed)
        lastTitle.current = parsed.title || ''
        if (onTitle) onTitle(parsed.title || '') // synchronise le breadcrumb avec le vrai titre
      })
      .catch(() => { setProps({}); lastTitle.current = ''; if (onTitle) onTitle('') })
    // FLUSH au changement de page / démontage : si une sauvegarde de propriété/titre est encore en attente
    // dans le débounce de 800 ms, on la persiste AVANT de partir (parité avec le flush du corps dans
    // PageEditorBN). Sans ça, taper un titre puis naviguer/fermer dans la fenêtre de 800 ms perdait la modif.
    return () => {
      if (saveTimer.current) { clearTimeout(saveTimer.current); saveTimer.current = null }
      if (pending.current) { const n = pending.current; pending.current = null; persist(n) }
    }
  }, [path])
  // Persiste réellement la valeur des propriétés (PUT du jumeau .props.json) + effets de bord titre.
  // Extrait de `save` pour être réutilisable par le débounce ET par le flush au démontage.
  const persist = (next) => {
    apiPost('save', { path: PROPS_PATH, markdown: JSON.stringify(next), sha: sha.current })
      .then((j) => {
        if (j && j.ok) {
          sha.current = j.sha
          // Titre changé : on met à jour le cache d'affichage + notif macOS (débounce naturel = 800 ms).
          // NB (editor-4) : on NE réindexe PAS la recherche ici. Renommer le titre ne renomme pas le
          // fichier (le chemin reste identique) et la recherche ne score QUE sur le chemin/nom de
          // fichier (scoreMatch), jamais sur props.title. L'ancien appel index-add était donc un
          // round-trip réseau sans effet (côté serveur : 0 chemin ajouté -> 0 commit) et la notif
          // « réindexé pour la recherche » était trompeuse. Le titre cherchable viendra d'un rebuild
          // d'index complet, pas d'un renommage de titre.
          const newTitle = (next.title || '').trim()
          if (newTitle !== (lastTitle.current || '')) {
            lastTitle.current = newTitle
            _labelCache[path] = newTitle || null // les tuiles/listes Finder afficheront le nouveau titre sans refetch
            notify({ kind: 'page', label: 'Titre · Manifeste', title: newTitle || 'Sans titre', body: 'Titre enregistré dans le manifeste de la page' })
          }
        }
      }).catch(() => {})
  }
  const save = (next) => {
    setProps(next)
    if (onTitle) onTitle(next.title || '') // breadcrumb suit en direct
    pending.current = next // mémorise la dernière valeur pour un éventuel flush au démontage
    if (saveTimer.current) clearTimeout(saveTimer.current)
    saveTimer.current = setTimeout(() => { saveTimer.current = null; const n = pending.current; pending.current = null; if (n) persist(n) }, 800)
  }
  if (!props) return null
  const base = path.replace(/\.md$/, '')
  const parentDir = base.split('/').slice(0, -1).join('/')
  const parentMd = parentDir + '.md'
  const hasParent = parentDir !== 'pages' && paths.includes(parentMd)
  const subItems = paths.filter((p) => { const b = p.replace(/\.md$/, ''); return b.startsWith(base + '/') && b.slice(base.length + 1).indexOf('/') === -1 })
  const custom = props.custom || []
  const Row = ({ icon, label, children }) => (
    <div style={{ display: 'flex', alignItems: 'flex-start', gap: 10, padding: '4px 0', minHeight: 30 }}>
      <div style={{ flex: '0 0 160px', display: 'flex', alignItems: 'center', gap: 8, color: t.textSecondary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-lg)' }}><span style={{ opacity: 0.7 }}>{icon}</span>{label}</div>
      <div style={{ flex: 1, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', color: t.textPrimary }}>{children}</div>
    </div>
  )
  const empty = { color: t.textSecondary, opacity: 0.6 }
  return (
    <>
      {/* C42 — cover */}
      {props.cover && (
        <div style={{ position: 'relative', margin: '0 -54px 12px', height: '26vh', minHeight: 140, borderRadius: 10, overflow: 'hidden', background: t.surface }}>
          <img src={props.cover} alt="" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
          <div style={{ position: 'absolute', top: 8, right: 10, display: 'flex', gap: 6 }}>
            <label style={{ background: 'rgba(0,0,0,0.55)', color: '#fff', borderRadius: 6, padding: '3px 9px', fontSize: 'var(--zr-ui-xs)', cursor: 'pointer' }}>Changer<input type="file" accept="image/*" style={{ display: 'none' }} onChange={(e) => e.target.files[0] && uploadCover(e.target.files[0])} /></label>
            <button onClick={() => save({ ...props, cover: '' })} style={{ background: 'rgba(0,0,0,0.55)', color: '#fff', border: 'none', borderRadius: 6, padding: '3px 9px', fontSize: 'var(--zr-ui-xs)', cursor: 'pointer' }}>Retirer</button>
          </div>
        </div>
      )}
      {/* C41 — icône + titre */}
      <div style={{ position: 'relative', marginBottom: 8 }}>
        {SHOW_PAGE_ICON_CONTROLS && props.icon && <button onClick={() => setPick((v) => !v)} title="Icône" style={{ display: 'block', background: 'transparent', border: 'none', cursor: 'pointer', fontSize: 46, lineHeight: 1, padding: 0, marginBottom: 6 }}>{isSymbol(props.icon) ? <Icon name={props.icon} size={44} grad weight={1.5} /> : props.icon}</button>}
        <input value={props.title ?? title} onChange={(e) => save({ ...props, title: e.target.value })} placeholder={title} spellCheck={false}
          onKeyDown={(e) => { if (e.key === 'Enter') { e.preventDefault(); focusPageBody(path) } }}
          style={{ fontFamily: "var(--zr-police-serif)", fontSize: 40, fontWeight: 400, lineHeight: 1.3, letterSpacing: '-0.01em', color: t.textPrimary, background: 'transparent', border: 'none', outline: 'none', width: '100%', padding: '0 0 6px', display: 'block', height: 'auto', boxSizing: 'content-box' }} />
        <div style={{ display: 'flex', gap: 12, marginTop: 6 }}>
          {!props.cover && <label style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-sm)', cursor: 'pointer' }}>+ Cover<input type="file" accept="image/*" style={{ display: 'none' }} onChange={(e) => e.target.files[0] && uploadCover(e.target.files[0])} /></label>}
          {SHOW_PAGE_ICON_CONTROLS && (props.icon
            ? <button onClick={() => save({ ...props, icon: '' })} style={{ background: 'transparent', border: 'none', color: t.textSecondary, fontSize: 'var(--zr-ui-sm)', cursor: 'pointer', padding: 0 }}>− Icône</button>
            : <button onClick={() => setPick((v) => !v)} style={{ background: 'transparent', border: 'none', color: t.textSecondary, fontSize: 'var(--zr-ui-sm)', cursor: 'pointer', padding: 0 }}>+ Icône</button>)}
        </div>
        {pick && (
          <div className="zr-menu" style={{ position: 'absolute', top: 50, left: 0, zIndex: 30, width: 286 }}>
            {props.icon && <button onClick={() => { save({ ...props, icon: '' }); setPick(false) }} style={{ display: 'flex', alignItems: 'center', gap: 6, width: '100%', background: 'transparent', border: 'none', borderBottom: `1px solid ${t.border}`, color: t.textSecondary, cursor: 'pointer', padding: '6px 7px 8px', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)' }}><Icon name="xmark" size={13} weight={2} />Retirer l'icône</button>}
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7,1fr)', gap: 2, marginTop: props.icon ? 6 : 0 }}>
              {PAGE_ICONS.map((sym) => <button key={sym} onClick={() => { save({ ...props, icon: sym }); setPick(false) }} title={sym} style={{ background: props.icon === sym ? PALETTE.primarySoft : 'transparent', border: 'none', cursor: 'pointer', padding: 7, borderRadius: 8, display: 'grid', placeItems: 'center' }}><Icon name={sym} size={22} grad weight={1.5} /></button>)}
            </div>
          </div>
        )}
      </div>
    <div style={{ borderBottom: `1px solid ${t.border}`, paddingBottom: 10, marginBottom: 8 }}>
      {/* Propriétés CONDITIONNELLES : une note de base n'en affiche AUCUNE. Date/Place n'apparaissent que si
          renseignées ou ajoutées via "+ Add a property" (et sont retirables). Parent/Sub-items sont DÉRIVÉS de
          l'arborescence : affichés seulement s'ils existent réellement. */}
      {(!!props.date || (props.shown || []).includes('date')) && (
        <Row icon={<Icon name="calendar" size={15} color="#8E8E93" weight={1.5} />} label="Date">
          <span style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
            <input type="date" value={props.date || ''} onChange={(e) => save({ ...props, date: e.target.value })}
              style={{ background: 'transparent', border: 'none', color: props.date ? t.textPrimary : t.textSecondary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', outline: 'none', cursor: 'pointer' }} />
            <button onClick={() => save({ ...props, date: '', shown: (props.shown || []).filter((x) => x !== 'date') })} title="Retirer cette propriété" style={{ background: 'transparent', border: 'none', color: t.textSecondary, cursor: 'pointer', opacity: 0.5, display: 'inline-flex' }}><Icon name="trash" size={13} weight={1.7} /></button>
          </span>
        </Row>
      )}
      {hasParent && (
        <Row icon={<Icon name="arrow.up.right" size={15} color="#8E8E93" weight={1.7} />} label="Parent item">
          <button onClick={() => onOpen(parentMd)} style={{ background: 'transparent', border: 'none', color: PALETTE.primary, cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', padding: 0 }}>▦ {pgPretty(parentDir.split('/').pop())}</button>
        </Row>
      )}
      {(!!props.place || (props.shown || []).includes('place')) && (
        <Row icon={<Icon name="mappin" size={15} color="#8E8E93" weight={1.5} />} label="Place">
          <span style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
            <input value={props.place || ''} onChange={(e) => save({ ...props, place: e.target.value })} placeholder="Empty" autoFocus={!props.place && (props.shown || []).includes('place')}
              style={{ background: 'transparent', border: 'none', color: t.textPrimary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', outline: 'none', flex: 1 }} />
            <button onClick={() => save({ ...props, place: '', shown: (props.shown || []).filter((x) => x !== 'place') })} title="Retirer cette propriété" style={{ background: 'transparent', border: 'none', color: t.textSecondary, cursor: 'pointer', opacity: 0.5, display: 'inline-flex' }}><Icon name="trash" size={13} weight={1.7} /></button>
          </span>
        </Row>
      )}
      {subItems.length > 0 && (
        <Row icon={<Icon name="arrow.down.right" size={15} color="#8E8E93" weight={1.7} />} label="Sub-items">
          <span style={{ display: 'inline-flex', gap: 6, flexWrap: 'wrap' }}>{subItems.map((p) => <button key={p} onClick={() => onOpen(p)} style={{ background: t.surface, border: `1px solid ${t.border}`, borderRadius: 99, padding: '1px 9px', cursor: 'pointer', color: t.textPrimary, fontSize: 'var(--zr-ui-sm)' }}>{pgPretty(p.split('/').pop().replace(/\.md$/, ''))}</button>)}</span>
        </Row>
      )}
      {custom.map((c) => {
        const upd = (fields) => save({ ...props, custom: custom.map((x) => x.id === c.id ? { ...x, ...fields } : x) })
        // Changer de type ne casse plus la valeur : multi/relation repartent d'un tableau vide, les autres d'une chaîne vide.
        const changeType = (nt) => upd({ type: nt, value: (nt === 'multi' || nt === 'relation') ? [] : '' })
        const del = () => save({ ...props, custom: custom.filter((x) => x.id !== c.id) })
        return (
          <Row key={c.id} icon="•" label={
            <span style={{ display: 'flex', alignItems: 'center', gap: 4, minWidth: 0, width: '100%' }}>
              <input value={c.name} onChange={(e) => upd({ name: e.target.value })} placeholder="Nom"
                onKeyDown={(e) => { if (e.key === 'Enter') { e.preventDefault(); e.target.blur() } }}
                style={{ background: 'transparent', border: 'none', color: t.textSecondary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', outline: 'none', flex: 1, minWidth: 0 }} />
              <select value={c.type || 'text'} onChange={(e) => changeType(e.target.value)} title="Type de propriété" style={{ background: 'transparent', border: 'none', color: t.textSecondary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', cursor: 'pointer', opacity: 0.7, flex: '0 0 auto' }}>{PROP_TYPES.map(([v, l]) => <option key={v} value={v}>{l}</option>)}</select>
              <button onClick={del} title="Supprimer cette propriété" style={{ background: 'transparent', border: 'none', color: t.textSecondary, cursor: 'pointer', padding: '0 2px', flex: '0 0 auto', display: 'flex', alignItems: 'center', opacity: 0.55 }}><Icon name="trash" size={13} weight={1.7} /></button>
            </span>
          }>
            <div style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
              <TypedCell t={t} type={c.type || 'text'} value={c.value} options={c.options || []} onChange={(v) => upd({ value: v })}
                pages={c.type === 'relation' ? paths.filter((p) => p.endsWith('.md') && p !== path).map((p) => ({ path: p, name: pgPretty(p.split('/').pop().replace(/\.md$/, '')) })) : []}
                onOpenPage={onOpen} />
              {(c.type === 'select' || c.type === 'multi') && <input value={(c.options || []).join(', ')} onChange={(e) => upd({ options: e.target.value.split(',').map((s) => s.trim()).filter(Boolean) })} placeholder="options : a, b, c" style={{ background: 'transparent', border: `1px solid ${t.border}`, borderRadius: RADII.sm, color: t.textSecondary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', outline: 'none', padding: '2px 6px', maxWidth: 280 }} />}
            </div>
          </Row>
        )
      })}
      <div style={{ position: 'relative', display: 'inline-block' }}>
        <button onClick={() => setAddOpen((v) => !v)}
          style={{ background: 'transparent', border: 'none', color: t.textSecondary, cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', padding: '4px 0', marginTop: 2 }}>+ Add a property</button>
        {addOpen && (
          <div className="zr-menu" style={{ position: 'absolute', top: 30, left: 0, zIndex: 30, minWidth: 200, background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: RADII.sm, boxShadow: SHADOWS.lg, padding: 5 }}>
            {!(!!props.date || (props.shown || []).includes('date')) && <button onClick={() => { save({ ...props, shown: [...new Set([...(props.shown || []), 'date'])] }); setAddOpen(false) }} className="zr-treeitem" style={{ display: 'flex', alignItems: 'center', gap: 8, width: '100%', background: 'transparent', border: 'none', cursor: 'pointer', padding: '6px 8px', borderRadius: 6, color: t.textPrimary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)' }}><Icon name="calendar" size={14} color="#8E8E93" weight={1.5} />Date</button>}
            {!(!!props.place || (props.shown || []).includes('place')) && <button onClick={() => { save({ ...props, shown: [...new Set([...(props.shown || []), 'place'])] }); setAddOpen(false) }} className="zr-treeitem" style={{ display: 'flex', alignItems: 'center', gap: 8, width: '100%', background: 'transparent', border: 'none', cursor: 'pointer', padding: '6px 8px', borderRadius: 6, color: t.textPrimary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)' }}><Icon name="mappin" size={14} color="#8E8E93" weight={1.5} />Place</button>}
            <button onClick={() => { save({ ...props, custom: [...custom, { id: 'p' + Date.now() + Math.random().toString(36).slice(2, 6), name: '', type: 'text', value: '' }] }); setAddOpen(false) }} className="zr-treeitem" style={{ display: 'flex', alignItems: 'center', gap: 8, width: '100%', background: 'transparent', border: 'none', cursor: 'pointer', padding: '6px 8px', borderRadius: 6, color: t.textPrimary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)' }}><Icon name="plus" size={14} color="#8E8E93" weight={2} />Propriété personnalisée</button>
          </div>
        )}
      </div>
    </div>
    </>
  )
}

/* ───────── Documents (lecture live du repo Memory) ───────── */
function Markdown({ t, md }) {
  // lien entre pages facon Notion : [[slug]] -> lien #page:slug
  const pre = (md || '').replace(/\[\[([^\]\n]+)\]\]/g, (_, s) => `[▦ ${s.trim()}](#page:${encodeURIComponent(s.trim())})`)
  return <div className="md-body" style={{ '--fg': t.textPrimary, '--muted': t.textSecondary, '--acc': PALETTE.primary, '--border': t.border, '--code': t.bg }} dangerouslySetInnerHTML={{ __html: safeMarkedParse(pre) }} />
}

/* ───────── Repo Commands ─────────
   Panneau latéral (lecture seule) qui affiche le journal des écritures GitHub : repo, dossier (anonymisé),
   commande HTTP lisible, statut coloré, détail. Poll /api/cmdlog toutes les 2 s tant qu'il est ouvert.
   Boutons Copy command (1 ligne) et Copy full log (toute l'entrée en JSON). Aucun nom média humain n'y
   transite : le serveur (cmdlog.js) anonymise par construction. */
function RepoCommandsPanel({ t, onClose }) {
  const [entries, setEntries] = useState([])
  const [err, setErr] = useState(false)
  useEffect(() => {
    let alive = true
    const tick = async () => {
      try {
        const r = await fetch('/api/cmdlog')
        const j = await r.json()
        if (alive) { setEntries(Array.isArray(j.entries) ? j.entries : []); setErr(false) }
      } catch { if (alive) setErr(true) }
    }
    tick()
    const id = setInterval(tick, 2000)
    return () => { alive = false; clearInterval(id) }
  }, [])
  const COLOR = { success: '#30D158', failed: '#FF453A', pending: '#FF9F0A' }
  const copy = (txt) => { try { navigator.clipboard.writeText(txt) } catch {} }
  const fullLog = (e) => JSON.stringify({ ts: new Date(e.ts).toISOString(), repo: e.repo, dir: e.dir, action: e.action, command: e.command, status: e.status, httpStatus: e.httpStatus, detail: e.detail }, null, 2)
  return (
    <>
      <div onClick={onClose} style={{ position: 'fixed', inset: 0, zIndex: 9990, background: 'rgba(0,0,0,.22)' }} />
      <div style={{ position: 'fixed', top: 0, right: 0, bottom: 0, width: 'min(440px, 92vw)', zIndex: 9991, background: t.cardBg, borderLeft: `1px solid ${t.border}`, boxShadow: SHADOWS.lg, display: 'flex', flexDirection: 'column', fontFamily: FONTS.sans }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 8, padding: '14px 16px', borderBottom: `1px solid ${t.border}` }}>
          <Icon name="rectangle.grid.1x2" size={16} grad />
          <span style={{ fontWeight: 700, fontSize: 'var(--zr-ui-lg)', color: t.textPrimary }}>Repo Commands</span>
          <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: t.textSecondary }}>{entries.length} op.</span>
          <button onClick={() => copy(entries.map(fullLog).join('\n\n'))} title="Copier tout le journal" style={{ marginLeft: 'auto', ...btn(t), padding: '4px 10px', fontSize: 'var(--zr-ui-xs)' }}>Copy full log</button>
          <button onClick={onClose} style={{ background: 'transparent', border: 'none', cursor: 'pointer', color: t.textSecondary, display: 'inline-flex' }}><Icon name="xmark" size={16} /></button>
        </div>
        <div className="zr-scroll-noblur" style={{ flex: 1, overflowY: 'auto', padding: 12 }}>
          {err && <div style={{ color: '#FF453A', fontSize: 'var(--zr-ui-sm)', padding: 10 }}>Journal injoignable (/api/cmdlog).</div>}
          {!err && entries.length === 0 && <div style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-sm)', padding: 10 }}>Aucune opération encore. Crée, déplace, uploade ou supprime un nœud pour voir le journal se remplir.</div>}
          {entries.map((e) => (
            <div key={e.id} style={{ border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: '8px 10px', marginBottom: 8, background: t.surface }}>
              <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
                <span style={{ width: 8, height: 8, borderRadius: 99, flexShrink: 0, background: COLOR[e.status] || t.textSecondary }} />
                <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', color: t.textPrimary, fontWeight: 600, wordBreak: 'break-all' }}>{e.command || e.action}</span>
                <span style={{ marginLeft: 'auto', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: COLOR[e.status] || t.textSecondary }}>{e.status}{e.httpStatus ? ` ${e.httpStatus}` : ''}</span>
              </div>
              <div style={{ display: 'flex', flexWrap: 'wrap', gap: 8, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: t.textSecondary, marginTop: 4 }}>
                {e.repo && <span>repo: {e.repo}</span>}
                {e.dir && <span style={{ wordBreak: 'break-all' }}>dir: {e.dir}</span>}
                <span>{new Date(e.ts).toLocaleTimeString()}</span>
              </div>
              {e.detail && <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: '#FF453A', marginTop: 4, wordBreak: 'break-all', whiteSpace: 'pre-wrap' }}>{e.detail}</div>}
              <div style={{ display: 'flex', gap: 6, marginTop: 6 }}>
                <button onClick={() => copy(e.command || '')} style={{ ...btnGhost(t), border: `1px solid ${t.border}`, padding: '3px 9px', fontSize: 'var(--zr-ui-xs)' }}>Copy command</button>
                <button onClick={() => copy(fullLog(e))} style={{ ...btnGhost(t), border: `1px solid ${t.border}`, padding: '3px 9px', fontSize: 'var(--zr-ui-xs)' }}>Copy full</button>
              </div>
            </div>
          ))}
        </div>
      </div>
    </>
  )
}

