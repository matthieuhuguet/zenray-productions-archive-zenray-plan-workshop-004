  useEffect(() => { document.body.classList.toggle('zr-music-open', musicOpen); return () => document.body.classList.remove('zr-music-open') }, [musicOpen])
  // Sidebar YouTube -> Create (retour Matthieu 2026-07-17) : même patron que zr:create-music -- un
  // événement DOM global, pas un appel de fonction direct. Nécessaire : <Sidebar> est monté par `App`
  // (ligne ~132), alors que ce state vit dans `Pages` (composant frère, pas parent/enfant) -- un appel
  // direct comme avant (openYoutubeVideo(id) référencé depuis App) plantait en ReferenceError silencieuse
  // au clic (bug découvert 2026-07-18, jamais catché car le handler n'était jamais exécuté avant le
