      )}

      {/* C50 — panneau Peek (aperçu latéral, Alt+clic) */}
      {peek && (
        <div style={{ position: 'fixed', top: 0, right: 0, height: '100vh', width: 'min(480px,92vw)', zIndex: 88, background: t.cardBg, borderLeft: `1px solid ${t.border}`, boxShadow: '-8px 0 28px rgba(0,0,0,0.18)', display: 'flex', flexDirection: 'column' }}>
