  }
  // Restaure un nœud depuis trash/ vers son chemin d'origine (utilisé par l'Undo de la grosse notification).
  // Recopie le descripteur + ses jumeaux vers pages/, supprime les copies de trash/ ET le sidecar.
  const restoreFromTrash = async (contentPath) => {
    const trashRoot = 'trash/' + contentPath.replace(/^pages\//, '')
    const twins = nodeFilesForPath(trashRoot)
    for (const src of twins) {
