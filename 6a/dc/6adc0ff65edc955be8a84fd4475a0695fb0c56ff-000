              icon: <Icon name="tray.full" size={14} />,
              children: espaces.map((esp) => ({
                id: `trier-${esp.n}`,
                label: esp.neuf ? `${esp.nom}  ·  nouveau` : esp.nom,
                action: () => trierVersEspace(eligibles, esp),
              })),
            }]
          })(),
          { id: 'copy', label: `Copier${multi ? ` (${contextEntries.length})` : ''}`, icon: <Icon name="doc.text" size={14} />, action: () => markClip('copy', contextEntries) },
          { id: 'cut', label: `Couper${multi ? ` (${contextEntries.length})` : ''}`, icon: <Icon name="scissors" size={14} />, disabled: !!folderEagleSource, action: () => markClip('cut', contextEntries) },
          clip.current?.items?.length ? { id: 'paste', label: `Coller ${clip.current.items.length} ici`, icon: <Icon name="doc.text" size={14} />, action: pasteClip } : null,
