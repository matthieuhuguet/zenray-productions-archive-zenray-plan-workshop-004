          } : null,
          { id: 'open', label: 'Ouvrir', icon: <Icon name="arrow.up.right" size={14} />, disabled: multi, action: () => openEntry(entry) },
          (!multi && entry.contentPath && (/\.(img|media|file)\.json$/.test(entry.contentPath) || isAudioEntry(entry))) ? {
            id: 'download-direct',
            label: 'Télécharger',
            icon: <Icon name="arrow.down.circle" size={14} />,
            action: () => downloadMedia(entry.contentPath, entry.name).catch(() => {}),
          } : null,
          { id: 'rename', label: 'Renommer', icon: <Icon name="doc.text" size={14} />, disabled: multi || !!folderEagleSource, action: () => startRename(entry) },
          { id: 'move', label: `Déplacer vers…${multi ? ` (${contextEntries.length})` : ''}`, icon: <Icon name="folder" size={14} />, disabled: moveItems.length === 0 || !!folderEagleSource, action: () => setMoveDlg({ items: moveItems }) },
          // ═══ TRIER VERS UN ESPACE, SANS DÉPLACER NI DUPLIQUER L'IMAGE (2026-08-30) ═══════════
          //
          // Sa demande : « trier rapidement plusieurs espaces d'images sans perdre l'image
          // originale et son espace initial — il n'y a que des références qui sont déplacées ».
          //
          // CE QUI PART DANS L'ESPACE DE TRI est un lien Eagle : environ cent cinquante octets de
          // JSON qui portent un `resourceId`, et rien d'autre. Zéro octet de photo, donc zéro
          // espace consommé sur le drive, et l'image d'origine ne bouge pas d'un pouce. Le lien
          // se résout ensuite vers la ressource canonique (`resolveEaglePath`), si bien que
          // l'aperçu, le plein format et le téléchargement fonctionnent depuis la référence
          // exactement comme depuis l'original.
          //
          // ON NE RÉÉCRIT RIEN : `createEagleLinks` fait déjà le lot ATOMIQUE, la résolution des
          // collisions de nom, la mise à jour optimiste de la vue et de l'index de recherche, et
          // le retour arrière si le serveur refuse. Ce menu ne fait que lui désigner la cible.
          //
          // Le dossier de destination n'a pas à être créé : sur ce dépôt, écrire `dossier/x.json`
          // fait exister le dossier. Une création préalable serait une requête de plus pour rien,
          // et une occasion de plus de laisser un dossier vide derrière un échec.
          ...(() => {
            // TOUT TYPE CONFONDU : photo, vidéo, son, archive, board, embed, table, et dossier
            // entier. Le filtre vient de `dossiersDeTri`, source unique partagée avec le Quick Look.
            const eligibles = triables(contextEntries)
            if (!eligibles.length) return []
            const espaces = espacesDeTri(dirEntries || [], folder)
            return [{
