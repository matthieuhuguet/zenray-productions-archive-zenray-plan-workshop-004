              }
            } } : null,
            { id: 'share-folder', label: 'Partager ce dossier', icon: <Icon name="arrow.up.right" size={14} />, disabled: multi, action: async () => {
              const targetFolder = (!entry.contentPath || entry.hasKids) ? entry.dir : folder
              try {
                const { url } = await createShareLink(SHARE_KIND.folder, targetFolder)
                await navigator.clipboard.writeText(url)
                notify({ icon: 'arrow.up.right', tint: PALETTE.primary, label: 'Lien copié', title: 'Galerie partagée', body: `Lien signé de « ${targetFolder.split('/').pop()} » copié.` })
              } catch (error) {
                notify({ icon: 'exclamationmark.triangle', tint: PALETTE.red, label: 'Partage impossible', title: 'Le lien n’a pas été créé', body: String(error?.message || error) })
              }
            } },
            { id: 'copy-path', label: `Copier le${multi ? 's' : ''} chemin${multi ? 's' : ''}`, icon: <Icon name="doc.text" size={14} />, action: () => copyPathsToClipboard(contextEntries) },
          ].filter(Boolean) },
          ...deliveryNodes,
          { id: 'information', label: 'Informations', icon: <Icon name="number" size={14} />, children: [
            showStorage ? { id: 'storage', label: 'Stockage (Index)', icon: <Icon name="archivebox" size={14} />, action: storageInfo } : null,
            { id: 'info', label: `Obtenir les infos${multi ? ` (${contextEntries.length})` : ''}`, icon: <Icon name="doc.text" size={14} />, action: showInfo },
            { id: 'size', label: `Obtenir la taille${multi ? ` (${contextEntries.length})` : ''}`, icon: <Icon name="number" size={14} />, action: computeSize },
          ].filter(Boolean) },
