              '',
              storage.repos.length ? 'Dépôts GitHub :' : 'Aucun octet stocké chez nous (lien externe).',
              ...storage.repos.map((repo) => `  ${repo.repo} — ${repo.parts} part${repo.parts > 1 ? 's' : ''}${repo.bytes ? ` · ${fmtBytes(repo.bytes)}` : ''}`),
            ].filter((line) => line !== null)
            window.alert(`${pgPretty(entry.name)}\n\n${lines.join('\n')}`)
          } catch { window.alert('Manifeste illisible pour ce fichier.') }
        }
        const showInfo = () => window.alert(contextEntries.map((item) => `${pgPretty(item.name)}\n  ${item.contentPath || item.dir}\n  ${item.hasKids ? 'Dossier' : (item.isImage ? 'Image' : item.isMedia ? 'Média' : item.isDb ? 'Table' : 'Page')}`).join('\n\n') + (multi ? `\n\n${contextEntries.length} éléments sélectionnés` : ''))
        const computeSize = async () => {
          const leaves = []
          for (const item of contextEntries) {
            if (item.contentPath) leaves.push(item.contentPath)
            if (item.hasKids) allPaths.filter((path) => stripLeafExt(path).startsWith(item.dir + '/')).forEach((path) => leaves.push(path))
          }
          const unique = [...new Set(leaves)].slice(0, 800)
          notify({ kind: 'info', label: 'Taille', title: 'Calcul…', body: `${unique.length} nœud(s) analysés.`, ttl: 3000 })
          let bytes = 0; let media = 0
          for (const path of unique) {
            if (!/\.(img|media)\.json$/.test(path)) continue
            const response = await fetch(`/api/page?action=read&raw=1&path=${encodeURIComponent(path)}`, { cache: 'no-store' }).then((value) => value.json()).catch(() => null)
            if (!response?.markdown) continue
            try { const manifest = JSON.parse(response.markdown); if (manifest.size) { bytes += manifest.size; media++ } } catch {}
          }
          notify({ kind: 'info', label: 'Taille', title: `${(bytes / 1048576).toFixed(1)} Mo`, body: `${media} média(s) sur ${unique.length} nœud(s).`, ttl: 9000 })
        }
        const currentTag = !multi && styleKeyOf(entry) ? tags[styleKeyOf(entry)] : null
        // PRIORISATION FINDER (2026-08-11, demande Matthieu) : les gestes les plus fréquents
        // (ouvrir, renommer, déplacer, copier/couper/coller, favori) étaient enterrés à un clic
        // de plus, dans le sous-menu « Organiser », au même rang que des actions rares (Eagle,
        // réindexation, visibilité). Comme dans Finder, ils remontent au premier niveau ; « Organiser »
        // ne garde que le reste — Eagle, épinglage Plan, aller au dossier, réindexer, création de
        // nouveaux nœuds, visibilité — moins utilisé, donc un cran plus loin, jamais supprimé.
        const audioContextItems = contextEntries.filter(isAudioEntry)
        const nodes = [
          audioContextItems.length > 0 ? {
            id: 'sfx-quick-view',
            label: audioContextItems.length > 1 ? `Lancer l'écoute rapide (${audioContextItems.length})` : "Lancer l'écoute rapide SFX",
