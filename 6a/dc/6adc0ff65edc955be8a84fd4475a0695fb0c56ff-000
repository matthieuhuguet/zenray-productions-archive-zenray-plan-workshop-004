    }
    let n = 0
    try {
      const md = await fetch(urlLectureAffichage(mdPath), { cache: 'no-store' }).then((r) => r.json()).catch(() => null)
      if (md && md.markdown && !md.missing) { dl(md.markdown, 'md', 'text/markdown'); n++ }
