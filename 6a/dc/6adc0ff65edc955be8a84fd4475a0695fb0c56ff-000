  const [status, setStatus] = useState('')
  const [chargeNote, setChargeNote] = useState(false) // voile de chargement pendant l'ouverture/création de la note du jour
  const [q, setQ] = useState('')
  // Le chemin détaillé du dossier reste disponible sans prendre une rangée permanente : un petit chevron
  // l'affiche à la demande, conformément au chrome compact de Create.
