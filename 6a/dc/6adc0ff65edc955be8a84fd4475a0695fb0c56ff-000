    } : null
    const response = await postEagleLinksBatch(bodyBatch, { apiPost, causeApi, dejaCree, tentatives: leafOnly ? 4 : 1 })
    if (!response?.ok) {
      rollbackSearchIndexPaths(optimisticIndexPaths)
      // Le tick voit les chemins RÉELLEMENT écrits, donc il rafraîchit aussi quand la destination
    // est un sous-dossier de la vue — cas que l'ancien garde `dest === folder` laissait passer.
    tick([...optimisticPaths, dest])
      setStatus(`0/${plan.length} lien(s) créé(s)`)
      // ═══ DIRE LAQUELLE DES SEPT CAUSES, ET SUR QUEL FICHIER (2026-08-30) ═══════════════════════
      //
      // LE DÉFAUT QUE CE CODE AVAIT. Le serveur SAIT exactement pourquoi il refuse : il rend un
      // `error` de famille et un `results[].error` par élément, avec sept valeurs distinctes qui
      // appellent sept correctifs différents — `bad-path`, `invalid-source`, `missing-source`,
      // `orphan-link`, `virtual-target-readonly`, `target-tree`, `commit`. Cette notification les
      // écrasait toutes sous une phrase unique, « une source ou une collision a échoué », qui ne
      // permet ni de savoir laquelle, ni sur quel fichier.
      //
      // C'est le même défaut que le board gris de ce soir, et il coûte la même chose : trois
      // allers-retours pour deviner ce que la réponse contenait déjà. La règle du dépôt le dit,
      // un échec muet sur sa CAUSE est un échec muet.
      const cause = (() => {
        // PAS DE RÉPONSE DU TOUT n'est pas une cause « inconnue » : c'est une cause précise, et
        // c'est même la plus instructive. `apiPost(...).catch(causeApi)` rend `null` quand la
        // requête n'aboutit pas — réseau coupé, ou Worker tué avant d'avoir répondu.
        //
        // Le 2026-08-31 à 03h39, « inconnu » voulait dire exactement cela : ma retente dans
        // `rawJsonAt` doublait les sous-requêtes, un Worker en a cinquante, et il mourait avant de
        // rendre le moindre octet. Un message qui dit « je ne sais pas » quand la réponse est
        // ABSENTE fait chercher au mauvais endroit.
        if (!response) return { code: 'aucune-reponse', nom: null }
        const rs = Array.isArray(response.results) ? response.results : []
        const premier = rs.find((x) => x && x.error && x.error !== 'batch-aborted')
        const code = causeOf(response).code
        const quoi = premier && plan[premier.index]
        const nom = quoi ? (quoi.kind === 'folder' ? quoi.targetDir : quoi.targetPath).split('/').pop() : null
        return { code, nom }
      })()
      const EXPLICATIONS = {
        'bad-path': 'un chemin refusé (extension ou dossier hors périmètre)',
        'bad-dir': 'un dossier source ou cible refusé',
        'bad-kind': 'un type d’élément non reconnu',
        'invalid-source': 'un manifeste source illisible ou absent',
        'missing-source': 'la source d’un lien n’existe plus',
        'orphan-link': 'un lien dont la ressource d’origine a disparu',
        'virtual-target-readonly': 'le dossier de destination est lui-même un lien : on n’y écrit pas',
        'orphan-folder-link': 'un dossier-lien dont la ressource d’origine a disparu',
        'target-tree': 'le dossier de destination n’a pas pu être lu',
        'commit': 'le commit a été refusé par GitHub',
        'aucune-reponse': 'le serveur n’a rien renvoyé — requête coupée, ou trop d’éléments dans le lot',
        'reponse-sans-code': 'le serveur a répondu sans dire pourquoi (voir la console)',
        // Ajouté le 2026-08-31 : le serveur refuse désormais AVANT d'avoir rien touché quand un
        // dossier dépasse ce qu'une seule opération peut réécrire. Le message précis vient du
        // serveur (champ `message`) ; celui-ci n'est que le repli.
        'trop-de-fichiers': 'ce dossier contient trop de fichiers pour une seule opération — rien n’a été déplacé, procède par sous-dossiers',
        'unauthorized': 'le code du drive n’est pas reconnu',
        'fetch': 'le serveur a rencontré une exception (souvent le plafond de sous-requêtes GitHub) : réessaie dans un instant',
        'github': 'GitHub a refusé ou n’a pas répondu : réessaie dans un instant',
        'http': 'le serveur a répondu par une erreur HTTP (voir la console)',
        'reponse-vide': 'le serveur n’a rien renvoyé après plusieurs essais',
      }
      console.error('[eagle-links] refus', { erreur: response?.error, detail: response?.detail, results: response?.results })
      notify({
        icon: 'exclamationmark.triangle', tint: '#FF3B30', label: 'Liens Eagle annulés',
        title: `Aucun élément créé · ${cause.code}`,
        body: `${cause.message || EXPLICATIONS[cause.code] || 'cause non répertoriée'}${cause.code === 'http' && response?.detail ? ` [${response.detail}]` : ''}${cause.nom ? ` — sur « ${cause.nom} »` : ''}${response?.tentatives > 1 ? ` (${response.tentatives} essais)` : ''}. Le lot est atomique : rien n’a été laissé à moitié.`,
      })
      return false
    }
    const durableIndexPaths = Array.isArray(response.indexedPaths) ? response.indexedPaths : optimisticIndexPaths
    injectSearchIndexPaths(durableIndexPaths)
    let indexed = !!response.indexed
    // Deferred index (leaf-only batches): serialized in the background so the next sort never waits for it.
    const deferred = Array.isArray(response.indexPairs) && response.indexPairs.length > 0
    if (deferred) {
      indexerLiens(response.indexPairs).then((ok) => { if (!ok) notify({ icon: 'exclamationmark.triangle', tint: '#FF9F0A', label: 'Liens créés', title: 'Recherche à resynchroniser', body: 'Les liens sont intacts et ouvrables ; leur entrée de recherche sera retentée.' }) })
      indexed = true
    } else if (!indexed && durableIndexPaths.length) indexed = !!(await apiPost('index-add', { paths: durableIndexPaths }).catch(causeApi))?.delta
    // A server-side collision may have allocated "Name 2". The authoritative
    // reload replaces the temporary optimistic name without flicker or ghosts.
    // Le tick voit les chemins RÉELLEMENT écrits, donc il rafraîchit aussi quand la destination
    // est un sous-dossier de la vue — cas que l'ancien garde `dest === folder` laissait passer.
    tick([...optimisticPaths, dest])
    setStatus(indexed ? `${response.created} lien(s) créé(s) et indexé(s) ✓` : `${response.created} lien(s) créé(s), index à resynchroniser`)
    if (!deferred) notify(indexed
      ? { kind: 'success', label: 'Liens Eagle créés', title: `${response.created} emplacement(s)`, body: `Un commit, index immédiat, aucun upload vers ${dest}.` }
      : { icon: 'exclamationmark.triangle', tint: '#FF9F0A', label: 'Liens créés', title: `${response.created} emplacement(s)`, body: 'Les liens sont intacts et ouvrables ; la confirmation distante de l’index sera retentée au prochain rafraîchissement.' })
    loadPathsDebounced()
    return true
  }

  // ── Playlist par drag & drop (2026-07-19, feature miniplayer) ─────────────────────────────────────
  // Un morceau (mini-player en lecture OU tuile média existante) déposé sur une tuile PLAYLIST doit
  // l'y ajouter -- jamais déclencher le comportement "grouper en dossier" déjà en place pour deux
  // feuilles quelconques (dropLeaf/createFolderFromDrop, inchangé pour tout le reste).
  // (trackFromManifestData est désormais définie au niveau module, avant VideoMediaTile qui l'utilise
  // aussi pour la lecture directe depuis le badge play -- 2026-07-20.)
  // Écrit les nouveaux titres dans la playlist cible (read-modify-write anti-conflit, cf. saveJson.js) puis
  // prévient la tuile concernée pour un rafraîchissement immédiat du compte/pochette (elle vit dans un AUTRE
  // composant, VideoMediaTile, qui écoute cet événement -- pas de state levé/partagé pour cette seule feature).
  const appendTracksToPlaylist = async (playlistPath, tracks) => {
    const result = await saveJsonWithRetry(playlistPath, (cur) => {
      const base = cur && cur.type === 'playlist' ? cur : { type: 'playlist', v: 1, mime: 'audio/x-zenray-playlist', name: playlistPath.split('/').pop(), items: [] }
      const items = [...(base.items || []), ...tracks]
      const cover = base.cover || tracks.find((track) => track.cover)?.cover || ''
      return { ...base, items, cover }
    })
    if (result.ok) {
      window.dispatchEvent(new CustomEvent('zr:media-tile-updated', { detail: { path: playlistPath, patch: { count: result.data.items.length, cover: result.data.cover } } }))
      invalidateSearchIndex?.(playlistPath)
      notify({ kind: 'success', label: 'Playlist', title: `${tracks.length} titre${tracks.length > 1 ? 's' : ''} ajouté${tracks.length > 1 ? 's' : ''}`, body: pgPretty(playlistPath.split('/').pop()) })
    }
    return result
  }
  // dropLeaf (tileH) appelle ceci pour DÉCIDER entre "grouper en dossier" (comportement existant, deux
  // feuilles quelconques) et "ajouter à la playlist" (nouveau, cible = manifeste type playlist). Un SEUL
  // GET sur la cible tranche -- rien à précharger globalement, l'action est rare (un geste utilisateur).
  const dropTrackOnEntry = async (entry, dataTransfer) => {
    const targetPath = entry.contentPath; if (!targetPath) return false
    // getData() DOIT être lu de façon synchrone, avant tout await : passé le premier `await`, certains
    // navigateurs invalident déjà le DataTransfer (fin de l'opération de drag), et getData() renvoie alors
    // une chaîne vide silencieusement -- lire trackRaw/pageRaw ICI, jamais après readJson.
    const trackRaw = dataTransfer.getData('application/zenray-track')
    const pageRaw = dataTransfer.getData('application/zenray-page')
    const { data: targetManifest } = await readJson(targetPath)
    if (!targetManifest || targetManifest.type !== 'playlist') return false
    if (trackRaw) {
      try { const track = JSON.parse(trackRaw); await appendTracksToPlaylist(targetPath, [track]); return true } catch { return false }
    }
    if (pageRaw) {
      try {
        const p = JSON.parse(pageRaw)
        const paths = p.items ? p.items.map((it) => it.path) : (p.path ? [p.path] : [])
        const sourcePaths = paths.filter((sp) => sp && sp !== targetPath && /\.media\.json$/.test(sp))
        if (!sourcePaths.length) return false
        const tracks = []
        for (const sourcePath of sourcePaths) {
          const { data: sourceManifest } = await readJson(sourcePath)
          if (sourceManifest && sourceManifest.type !== 'playlist' && (sourceManifest.mime || '').startsWith('audio/') || sourceManifest?.type === 'spotify' || sourceManifest?.type === 'youtube') {
            tracks.push(trackFromManifestData(sourcePath, sourceManifest))
          }
        }
        if (!tracks.length) return false
        await appendTracksToPlaylist(targetPath, tracks)
        return true
      } catch { return false }
    }
    return false
  }
  // Drop du morceau en lecture (mini-player) sur un espace VIDE de Create (pas sur une tuile) : crée le
  // média correspondant, forme identique selon la source (Spotify/YouTube), jamais de duplication pour
  // un fichier LOCAL (déjà un vrai nœud Create) -- un lien Eagle référence l'original à la place.
  const dropTrackOnEmptySpace = async (track, destDir) => {
    if (track.source === 'local' && track.manifestPath) {
      await createEagleLinks([{ contentPath: track.manifestPath, dir: track.manifestPath, hasKids: false, name: track.title || 'Titre' }], destDir)
      return
    }
    const name = clean1(track.title || 'Titre')
    const path = `${destDir}/${name}.${Date.now().toString(36)}.media.json`
    const data = track.source === 'youtube'
      ? { type: 'youtube', v: 1, audioOnly: true, mediaKind: 'audio', videoId: track.videoId, url: track.uri, title: track.title, author: track.artist || 'YouTube', poster: track.cover || '', addedAt: new Date().toISOString() }
      : { type: 'spotify', v: 1, mime: 'audio/x-spotify', uri: track.uri, contextUri: track.contextUri || '', title: track.title, artist: track.artist || 'Spotify', cover: track.cover || '', duration: track.dur || 0, addedAt: new Date().toISOString() }
    const result = await saveJsonWithRetry(path, () => data)
    if (result.ok) { injectSearchIndexPaths([path]); tick([path]); notify({ kind: 'success', label: 'Média créé', title: track.title, body: pgPretty(destDir.split('/').pop() || destDir) }) }
  }
  const clean1 = (value) => String(value || 'Titre').replace(/[\\/:*?"<>|]/g, '-').trim().slice(0, 100) || 'Titre'

  const pasteClip = async () => {
    const c = clip.current; if (!c || !c.items.length) return
    const dest = folder
    if (c.mode === 'link') { await createEagleLinks(c.items, dest); return }
    // COUPER / COLLER (déplacement) : marche pour TOUS les types — feuilles (image / vidéo / audio / markdown /
    // table / canvas / embed) ET dossiers (sous-arbre entier). movePage route automatiquement feuille -> move /
    // dossier -> move-tree, et le serveur RÉINDEXE (delta public : nouveau chemin ajouté, ancien marqué rm).
    // Aucun type n'est ignoré au collage. Concurrence séquentielle volontaire (commits GitHub ordonnés, sûrs).
    if (c.mode === 'cut') {
      // finder-core-8 : on agrège succès/échecs. Le presse-papier n'est vidé QUE si tout passe ; sinon on
      // garde les éléments NON déplacés pour pouvoir recoller. Notif honnête (jamais un faux "déplacé ✓").
      // Les écritures GitHub partagent la même branche : même règle que moveMany, ordre séquentiel fiable.
      setStatus('déplacement…')
      const failed = []
      for (const it of c.items) {
        const ok = await movePage(it.contentPath || it.dir, dest, { batch: true })
        if (!ok) failed.push(it)
      }
      const done = c.items.length - failed.length
      clip.current = failed.length ? { mode: 'cut', items: failed } : null
      setStatus(failed.length ? `${done} déplacé(s), ${failed.length} échec(s)` : 'déplacé ✓'); setSelected(new Set()); loadTree(); loadPathsDebounced()
      notify(failed.length
        ? { icon: 'exclamationmark.triangle', tint: '#FF9F0A', label: 'Déplacement partiel', title: `${done} déplacé(s), ${failed.length} échec(s)`, body: `Les éléments restants sont conservés dans le presse-papier (⌘V pour réessayer).` }
        : { kind: 'success', label: 'Déplacé', title: `${c.items.length} élément(s)`, body: `Dans ${dest}.` })
      return
    }
    // COPIE : un dossier (sous-arbre) n'est pas encore dupliquable -> on ne copie que les feuilles (le COUPER, lui,
    // gère déjà les dossiers ci-dessus). Les médias/images copiés pointent sur le même binaire haché (zéro octet en +).
    const leaves = c.items.filter((it) => it.contentPath && !it.hasKids)
    const folders = c.items.filter((it) => it.hasKids)
    if (folders.length) notify({ kind: 'info', label: 'Copier', title: 'Dossiers non copiés', body: `${folders.length} dossier(s) ignoré(s) à la COPIE (le COUPER les déplace déjà). Duplication de sous-arbre à venir.` })
    if (!leaves.length) return
    // COPIE : 0,1 s ressenti. On calcule les chemins cibles, on INSÈRE les tuiles immédiatement (optimiste),
    // puis on lance les copies réseau EN PARALLÈLE et EN ARRIÈRE-PLAN (aucune attente bloquante).
    // Nommage façon Finder : "X copie", puis "X copie 2", "X copie 3"… On DÉDUPLIQUE contre les noms déjà
    // présents (et on retire un éventuel suffixe " copie"/" copie N" pour ne PAS empiler les suffixes au re-collage).
    const taken = new Set((dirEntries || []).map((e) => (e.name || '').toLowerCase()))
    const nextName = (raw) => {
      const root = raw.replace(/ copie( \d+)?$/i, '').trim() || 'copie'
      let cand = `${root} copie`, n = 1
      while (taken.has(cand.toLowerCase())) { n++; cand = `${root} copie ${n}` }
      taken.add(cand.toLowerCase())
      return cand
    }
    const plan = leaves.map((it) => {
      const cp = it.contentPath
      const leaf = leafExtension(cp)
      const baseName = cp.split('/').pop().slice(0, -leaf.length) || 'copie'
      const newBase = `${dest}/${nextName(baseName)}`
      return { src: cp, leaf, newPath: newBase + leaf, newBase, isImg: leaf === '.img.json' }
    })
    // VIGNETTE INSTANTANÉE : une copie d'image pointe sur le MÊME binaire haché que la source -> même vignette.
    // On résout la thumbUrl de la source (manifest déjà en cache si la tuile source a été affichée -> 0 fetch)
    // et on l'attache à la tuile optimiste. Plus d'attente, plus de gris, plus de course de cache.
    // Vignette source réutilisée (même hash) + MÉMORISÉE par dir cible : elle survivra à la revalidation
    // du dossier (loadDir reconstruit sans thumbUrl) -> jamais de re-lecture, jamais de regénération, jamais gris.
    // CHIFFRÉ : resolveThumbUrl renvoie un objectURL du CLAIR déchiffré (jamais le ciphertext) ; sinon URL directe.
    await Promise.all(plan.map(async (p) => { if (!p.isImg) return; try { const m = await readImgManifestCached(p.src); p.thumbUrl = (await resolveThumbUrl(m)) || null; if (p.thumbUrl) copiedThumbRef.current[stripLeafExt(p.newPath)] = p.thumbUrl } catch {} }))
    const byDir = new Map(plan.map((p) => [stripLeafExt(p.newPath), p]))
    optimisticDir((es) => {
      const add = entriesOfNodes(plan.map((p) => p.newPath), dest).map((x) => { const p = byDir.get(x.dir); return (p && p.thumbUrl) ? { ...x, thumbUrl: p.thumbUrl } : x })
      const have = new Set(es.map((x) => x.dir))
      return es.concat(add.filter((x) => !have.has(x.dir)))
    })
    setSelected(new Set())
    // ANIMATION de copie dans la notif : barre qui avance à chaque fichier écrit, puis « Copié ✓ ».
    // Écritures BORNÉES (concurrence 4) : 100 copies = 100 commits GitHub ; tout lancer d'un coup sature et
    // fait échouer des écritures (manifests manquants au reload). On pompe par lots de 4.
    const prog = notifyProgress({ icon: 'doc.text', tint: PALETTE.primary, label: 'Copie', title: `${leaves.length} élément(s)`, body: `Vers ${dest}…` })
    let doneN = 0
    const queue = plan.slice()
    const worker = async () => {
      while (queue.length) {
        const p = queue.shift()
        try { await copyNode(p) } catch {}
        doneN++; prog.set({ progress: doneN / plan.length, body: `${doneN}/${plan.length} copié(s) vers ${dest}` })
        invalidateManifest(p.newPath); window.dispatchEvent(new CustomEvent('zr-manifest-refresh', { detail: { path: p.newPath } }))
      }
    }
    Promise.all(Array.from({ length: Math.min(4, plan.length) }, worker)).then(() => { prog.done({ title: 'Copié ✓', body: `${plan.length} élément(s) dans ${dest}` }); setStatus('copié ✓'); loadPathsDebounced() })
  }
  shownRef.current = shownEntries

  // Navigation Finder par lettre : une frappe alphabétique sélectionne le PREMIER dossier/média dont le
  // nom commence par cette lettre et l'amène au centre de la vue. Le scroll natif `behavior:smooth` ne permet
  // ni de fixer 300 ms ni la courbe : animation rAF exacte EaseOutExpo, valable en icônes/listes/galerie et
  // même quand la tuile cible n'est pas encore montée par la grille virtuelle.
  useEffect(() => () => { if (letterScrollRaf.current) cancelAnimationFrame(letterScrollRaf.current) }, [])
  useEffect(() => {
    const normalizeInitial = (s) => String(s || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLocaleLowerCase('fr')
    const animateTo = (index, dir) => {
      const scroller = gridScrollRef.current
      if (!scroller) return
      const finish = () => {
        const safeDir = (window.CSS && CSS.escape) ? CSS.escape(dir) : dir.replace(/"/g, '\\"')
        const mounted = scroller.querySelector(`[data-zr-dir="${safeDir}"]`)
        let target
        if (mounted) {
          const sr = scroller.getBoundingClientRect(), tr = mounted.getBoundingClientRect()
          target = scroller.scrollTop + tr.top - sr.top - (scroller.clientHeight - tr.height) / 2
        } else if (view === 'icons') {
          const virtualGrid = scroller.querySelector('[data-zr-virtual-grid]')
          const usableW = Math.max(1, scroller.clientWidth - 32)
          const cols = Math.max(1, Math.floor((usableW + TILE_GAP) / (zoom + TILE_GAP)))
          const rowTop = (virtualGrid ? virtualGrid.offsetTop : 0) + Math.floor(index / cols) * (tileRowH(zoom) + TILE_GAP)
          target = rowTop - (scroller.clientHeight - tileRowH(zoom)) / 2
        } else if (view === 'list') {
          // Vue liste VIRTUALISÉE (2026-07-16) : la ligne cible n'est pas forcément montée (fenêtrage,
          // comme la grille ci-dessus) -> on calcule sa position depuis l'index plutôt que de forcer son
          // rendu. L'ancien hack (setListShow + 2 frames d'attente avant de re-chercher le DOM) a disparu
          // avec le rendu incrémental : VirtualList réagit seule au nouveau scrollTop qu'on pose ici.
          const virtualList = scroller.querySelector('[data-zr-virtual-list]')
          const rowTop = (virtualList ? virtualList.offsetTop : 0) + index * LIST_ROW_H
          target = rowTop - (scroller.clientHeight - LIST_ROW_H) / 2
        } else {
          // La galerie monte toutes ses cartes ; ce fallback ne devrait donc jamais être emprunté en pratique.
          target = index * 42 - scroller.clientHeight / 2
        }
        target = Math.max(0, Math.min(target, scroller.scrollHeight - scroller.clientHeight))
        // La courbe et la durée sont sorties dans `lib/scrollAnime.js` le 2026-08-27, quand le retour au
        // jour courant du Plan a dû se déplacer EXACTEMENT de la même façon. Rien n'a bougé ici, ni le
        // EaseOutExpo ni les 300 ms : seul l'endroit où ils sont écrits a changé, pour qu'il n'y en ait
        // toujours qu'un.
        scrollAnimeVers(scroller, target, letterScrollRaf)
      }
      requestAnimationFrame(finish)
    }
    const h = (ev) => {
      if (cur || quick || pathMenu || ctx || moveDlg || ev.metaKey || ev.ctrlKey || ev.altKey || ev.shiftKey || ev.repeat) return
      const active = document.activeElement
      if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA' || active.tagName === 'SELECT' || active.isContentEditable)) return
      if (ev.key.length !== 1 || !/^\p{L}$/u.test(ev.key)) return
      const initial = normalizeInitial(ev.key)
      const index = shownRef.current.findIndex((entry) => normalizeInitial(pgPretty(entry.name)).startsWith(initial))
      if (index < 0) return
      ev.preventDefault()
      const entry = shownRef.current[index]
      setSelected(new Set([entry.dir])); lastSel.current = entry.dir
      animateTo(index, entry.dir)
    }
    window.addEventListener('keydown', h)
    return () => window.removeEventListener('keydown', h)
  }, [cur, quick, pathMenu, ctx, moveDlg, view, zoom])

  // Scroll vers l'élément révélé par « Aller au dossier » une fois le dossier cible affiché (hors recherche).
  useEffect(() => {
    const target = revealRef.current
    if (!target || qDebounced) return
    if (!shownEntries.some((x) => x.dir === target)) return // pas encore chargé
    revealRef.current = null
    const id = setTimeout(() => {
      const el = gridScrollRef.current && gridScrollRef.current.querySelector(`[data-zr-dir="${(window.CSS && CSS.escape) ? CSS.escape(target) : target}"]`)
      if (el && el.scrollIntoView) el.scrollIntoView({ block: 'center', behavior: 'smooth' })
    }, 60)
    return () => clearTimeout(id)
  }, [shownEntries, qDebounced])
  useEffect(() => { // C24 Quick Look (barre Espace)
    const h = (ev) => {
      // The Quick Look overlay handles Esc/Space/arrows itself (capture phase) and calls preventDefault: React
      // re-subscribes this handler between phases, so without this guard Space closed then REOPENED the view.
      if (ev.defaultPrevented) return
      if (ev.key === 'Escape') { setQuick(null); return }
      if (ev.code === 'Space' && selected.size === 1 && !cur && !quick) {
        const el = document.activeElement
        if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable)) return
        ev.preventDefault()
        const e = shownRef.current.find((x) => x.dir === [...selected][0]); if (e) setQuick(e)
      }
    }
    window.addEventListener('keydown', h); return () => window.removeEventListener('keydown', h)
  }, [selected, cur, quick])
  useEffect(() => { // C25 raccourcis clavier Finder
    const h = (ev) => {
      // Same guard: arrows pressed inside the Quick Look already moved the selection once (step); moving it again
