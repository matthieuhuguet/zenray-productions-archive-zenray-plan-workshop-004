          onClose={() => setFolderStyleDlg(null)}
          onApply={({ color, icon }) => { const key = styleKeyOf(folderStyleDlg.entry); setFolderStyleDlg(null); applyFolderStyle(key, color, icon) }} />
      )}

      {moveDlg && (
        <MoveToDialog t={t} items={moveDlg.items} paths={paths} currentFolder={folder}
          onClose={() => setMoveDlg(null)}
          onCreateFolder={createFolderAt}
          onConfirm={(list, destDir) => { setMoveDlg(null); moveMany(list, destDir) }} />
      )}

      {linkDlg && (
        <MoveToDialog t={t} items={linkDlg.entries.map((entry) => ({ key: entry.contentPath || entry.dir, name: pgPretty(entry.name), base: entry.dir, hasKids: !!entry.hasKids || !entry.contentPath }))} paths={paths} currentFolder={folder}
          onClose={() => setLinkDlg(null)}
          onCreateFolder={createFolderAt}
          onConfirm={(_list, destDir) => { const entries = linkDlg.entries; setLinkDlg(null); createEagleLinks(entries, destDir) }} />
      )}

      {/* Explorateur et ecoute rapide SFX multi-fichiers (06 October 2026) */}
      {sfxQuickViewOpen && (
        <SfxQuickListView
          open={sfxQuickViewOpen}
          onClose={() => setSfxQuickViewOpen(false)}
          t={t}
          theme={state.theme}
          entries={sfxQuickViewEntries}
          initialIndex={sfxQuickViewIndex}
        />
      )}

      {/* Menu Finder du fil d'Ariane (2026-07-14) — rendu ICI (endroit stable de Pages) et non dans Crumbs :
