const CACHE_PREFIX = 'zr:plan:cache:v1:'

export const PLAN_REFRESH_MS = 30_000

const storageOf = (storage) => storage || (typeof localStorage !== 'undefined' ? localStorage : null)
const cacheKey = (path) => `${CACHE_PREFIX}${encodeURIComponent(path)}`

export const isPlanBoard = (value) => !!(value && value.type === 'plan' && Array.isArray(value.tasks))

export function readCachedPlan(path, storage) {
  try {
    const raw = storageOf(storage)?.getItem(cacheKey(path))
    if (!raw) return null
    const board = JSON.parse(raw)
    return isPlanBoard(board) ? board : null
  } catch { return null }
}

export function writeCachedPlan(path, board, storage) {
  if (!isPlanBoard(board)) return false
  try { storageOf(storage)?.setItem(cacheKey(path), JSON.stringify(board)); return true } catch { return false }
}

export function shouldAdoptPlan(current, incoming) {
  if (!isPlanBoard(incoming)) return false
  if (!isPlanBoard(current)) return true
  return JSON.stringify(current) !== JSON.stringify(incoming)
}

// LIRE L'ÉTAT, PAS SEULEMENT LE CONTENU (2026-08-12, correctif d'un bug de PERTE D'AFFICHAGE).
//
// `readPlanFresh` rendait `null` dans DEUX situations qui n'ont rien à voir : le fichier n'existe pas,
// et la lecture a échoué (réseau coupé, API en erreur, JSON tronqué). L'appelant ne pouvait donc pas
// les distinguer, et `PlanBoard` traitait les deux comme « ce plan est vide » : un simple hoquet
// réseau au premier chargement, sans cache local, affichait un calendrier VIDE à la place du plan.
// C'est le « parfois mon plan ne s'affiche pas » signalé par Matthieu.
//
// Trois états, donc, et l'appelant décide : `ok` on adopte, `missing` on peut créer un board vide,
// `error` on ne touche À RIEN et on garde ce qui est déjà à l'écran.
export async function readPlanState(path, fetchImpl = fetch) {
  const url = `/api/page?action=read&raw=1&fresh=1&path=${encodeURIComponent(path)}`
  const response = await fetchImpl(url, { cache: 'no-store' }).catch(() => null)
  if (!response?.ok) return { status: 'error' }
  const json = await response.json().catch(() => null)
  if (!json) return { status: 'error' }
  // `missing` est la réponse EXPLICITE du serveur pour un 404 : c'est la seule preuve qu'un fichier
  // n'existe pas. Une réponse en erreur (`json.error`) reste une erreur, jamais une absence.
  if (json.missing) return { status: 'missing' }
  if (json.error || json.markdown == null) return { status: 'error' }
  try {
    const board = JSON.parse(json.markdown)
    // Un JSON valide qui n'est pas un board (fichier corrompu, écriture partielle) n'est PAS une
    // absence : l'écraser par un board vide détruirait le fichier. On refuse de conclure.
    return isPlanBoard(board) ? { status: 'ok', board } : { status: 'error' }
  } catch { return { status: 'error' } }
}

// Compatibilité : les appelants qui n'ont pas besoin de la nuance (la vignette de la bibliothèque de
// plans, App.jsx) gardent la forme « board ou null », qu'ils traitent déjà de façon tolérante.
export async function readPlanFresh(path, fetchImpl = fetch) {
  const { status, board } = await readPlanState(path, fetchImpl)
  return status === 'ok' ? board : null
}
