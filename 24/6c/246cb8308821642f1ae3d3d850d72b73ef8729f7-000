// 4 October 2026: command line client of the local freelance bridge (agents and Matthieu use the same door as the page).
// FR : client en ligne de commande du pont local (agents et Matthieu passent par la meme porte que la page).
import { readFile } from 'node:fs/promises'

const config = JSON.parse(await readFile(new URL('./FreelanceConfig.json', import.meta.url), 'utf8'))
const [action = 'status', ...rest] = process.argv.slice(2)
const payload = action === 'letter' ? { studioId: rest[0], lang: rest[1] || undefined } : action === 'run' && rest.length ? { only: rest } : {}
try {
  const response = await fetch(`http://127.0.0.1:${config.service.port}${config.service.path}`, {
    method: 'POST', headers: { 'content-type': 'application/json', 'x-zr-freelance-client': '1', ...(process.env.ZENRAY_API_SECRET ? { 'x-zr-auth': process.env.ZENRAY_API_SECRET } : {}) },
    body: JSON.stringify({ action, ...payload }), signal: AbortSignal.timeout(180000),
  })
  const result = await response.json()
  if (!response.ok || result.error) throw new Error(result.error || `Freelance bridge returned ${response.status}`)
  console.log(JSON.stringify(result, null, 2))
} catch (error) {
  console.error(`Freelance bridge failed: ${error.message}. Check the ${config.service.label} service.`)
  process.exitCode = 1
}
