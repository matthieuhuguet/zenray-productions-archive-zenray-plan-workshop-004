#!/usr/bin/env node
// Point d'entrée local stable pour déposer des pistes dans Music.
// Le navigateur utilise captureFiles(File[]); un chemin Mac doit passer par ce runner,
// qui délègue au pipeline Git/chunks AES-GCM canonique sans dupliquer sa logique.

import { existsSync } from 'node:fs'
import { spawnSync } from 'node:child_process'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const argv = process.argv.slice(2)
let dest = 'pages/Music'
let cover = ''
let dryRun = false
const files = []
for (let i = 0; i < argv.length; i++) {
  if (argv[i] === '--dest') dest = argv[++i] || ''
  else if (argv[i] === '--cover') cover = argv[++i] || ''
  else if (argv[i] === '--dry-run') dryRun = true
  else files.push(path.resolve(argv[i]))
}

if (!dest.startsWith('pages/Music') || !files.length || files.some((f) => !existsSync(f))) {
  console.error('usage: GITHUB_TOKEN=… node scripts/music-ingest.mjs [--dest "pages/Music/Album"] [--cover cover.jpg] <audio...> [--dry-run]')
  process.exit(2)
}

const childArgs = [path.join(ROOT, 'scripts/upload-audio-list-git.mjs'), dest, ...files]
if (cover) childArgs.push('--cover', path.resolve(cover))
if (dryRun) childArgs.push('--dry-run')
const run = spawnSync(process.execPath, childArgs, { cwd: ROOT, env: process.env, stdio: 'inherit' })
process.exit(run.status ?? 1)
