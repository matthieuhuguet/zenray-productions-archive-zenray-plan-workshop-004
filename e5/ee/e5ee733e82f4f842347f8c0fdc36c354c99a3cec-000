// 2 October 2026: one repeatable command prepares a watched project and binds its actual agent session.
import { requestAssets } from './BridgeClient.mjs'

const [id, ...options] = process.argv.slice(2)
const allowed = ['name', 'session-id', 'category']
const parameters = Object.fromEntries(options.map((option) => {
  const match = option.match(/^--([^=]+)=(.+)$/)
  if (!match || !allowed.includes(match[1])) throw new Error('Use <project-id> --name=<name> [--session-id=<actual-id>] [--category=<category>]')
  return [match[1], match[2]]
}))
if (!id) throw new Error('Project id required')
const sessionId = parameters['session-id'] || process.env.CODEX_SESSION_ID || process.env.CODEX_THREAD_ID || process.env.CLAUDE_SESSION_ID
try {
  const result = await requestAssets({ action: 'start', id, name: parameters.name, category: parameters.category, sessionId })
  console.log(JSON.stringify({ projectId: result.project.id, name: result.project.name, ...result.setup }, null, 2))
} catch (error) {
  console.error(`Project initialization failed: ${error.message}. Check the local com.zenray.assets service; existing files remain available.`)
  process.exitCode = 1
}
