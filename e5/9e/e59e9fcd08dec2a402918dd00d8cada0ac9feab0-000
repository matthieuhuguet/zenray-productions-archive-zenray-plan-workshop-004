import { describe, expect, it } from 'vitest'
import { mergeTreeAndIndexPaths } from './mergeTreeAndIndexPaths.js'

describe('mergeTreeAndIndexPaths', () => {
  // 9 October 2026 08:16 CEST: Prove the complete index fills the tail omitted by a truncated GitHub tree.
  it('keeps fresh tree nodes and restores missing nodes from the complete index', () => {
    expect(mergeTreeAndIndexPaths(
      ['pages/fresh.md', 'pages/shared.md'],
      ['pages/shared.md', 'pages/omitted-from-truncated-tree.comment.json'],
    )).toEqual([
      'pages/fresh.md', 'pages/shared.md', 'pages/omitted-from-truncated-tree.comment.json',
    ])
  })

  it('keeps the fresh tree available while the index is still loading', () => {
    const treePaths = ['pages/fresh.md']
    expect(mergeTreeAndIndexPaths(treePaths, null)).toBe(treePaths)
  })
})
