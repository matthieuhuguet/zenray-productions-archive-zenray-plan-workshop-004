const PARAMETER_BY_KEY = new Map(PUSH_POLICY_PARAMETERS.map((parameter) => [parameter.key, parameter]))

function fail(parameter, message) {
  return new Error(`push policy parameter ${parameter.key} (${parameter.env}) ${message}`)
}

function parseValue(parameter, raw) {
  const text = String(raw).trim()
  if (parameter.type === 'string') return text
  if (parameter.type === 'bool') {
    if (/^(1|true|on|yes)$/i.test(text)) return true
    if (/^(0|false|off|no)$/i.test(text)) return false
    throw fail(parameter, `must be 0 or 1, got "${text}"`)
  }
  if (parameter.type === 'ints') {
    const list = text.split(',').map((item) => Number(item.trim()))
    if (!list.length || list.some((item) => !Number.isInteger(item) || item < parameter.min)) {
      throw fail(parameter, `must be a comma separated list of integers >= ${parameter.min}, got "${text}"`)
    }
    return list
  }
  const value = Number(text)
  if (!Number.isFinite(value)) throw fail(parameter, `must be a number, got "${text}"`)
  if (parameter.type === 'int' && !Number.isInteger(value)) throw fail(parameter, `must be an integer, got "${text}"`)
  return value
}

function checkBounds(parameter, value) {
  if (parameter.type === 'number' || parameter.type === 'int') {
    if (parameter.min !== undefined && value < parameter.min) throw fail(parameter, `must be >= ${parameter.min}, got ${value}`)
    if (parameter.max !== undefined && value > parameter.max) throw fail(parameter, `must be <= ${parameter.max}, got ${value}`)
  }
}

/**
 * Builds the frozen configuration. `env` supplies the environment overrides, `overrides` the programmatic ones (tests, callers).
 * FR : construit la configuration figee ; une valeur invalide leve une erreur qui nomme le parametre.
 */
export function loadPushPolicyConfig(env = process.env, overrides = {}) {
  for (const key of Object.keys(overrides)) {
    if (!PARAMETER_BY_KEY.has(key)) throw new Error(`push policy: unknown parameter ${key}`)
  }
  const values = {}
  const sources = {}
  for (const parameter of PUSH_POLICY_PARAMETERS) {
    let value = parameter.defaultValue
    let source = 'default'
    // `lenient` parameters keep the behaviour of the code they replace: an unreadable or non positive value of the legacy
    // variables (Number(x) || default, parseInt(x) || default) means "not set", it is never an error.
    // FR : un parametre `lenient` garde le comportement du code remplace : valeur illisible ou nulle = variable non definie.
    const legacy = (parameter.legacy || []).find((entry) => env[entry.env] !== undefined && String(env[entry.env]).trim() !== '')
    if (legacy) {
      const parsed = Number(String(env[legacy.env]).trim())
      if (Number.isFinite(parsed) && parsed > 0) {
        value = parsed * legacy.scale
        source = `env:${legacy.env}`
      } else if (!parameter.lenient) {
        throw new Error(`push policy parameter ${parameter.key} (${legacy.env}) must be a positive number, got "${env[legacy.env]}"`)
      }
    }
    if (env[parameter.env] !== undefined && String(env[parameter.env]).trim() !== '') {
      let parsed
      try {
        parsed = parseValue(parameter, env[parameter.env])
        if (parameter.lenient && parsed <= 0) parsed = undefined
      } catch (error) {
        if (!parameter.lenient) throw error
      }
      if (parsed !== undefined) {
        value = parsed
        source = `env:${parameter.env}`
      }
    }
    if (Object.prototype.hasOwnProperty.call(overrides, parameter.key)) {
      value = overrides[parameter.key]
      source = 'override'
    }
    if (parameter.type === 'ints') {
      if (!Array.isArray(value)) throw fail(parameter, 'must be an array of integers')
      if (value.some((item) => !Number.isInteger(item) || item < parameter.min)) throw fail(parameter, `must hold integers >= ${parameter.min}`)
    } else if (parameter.type === 'bool') {
      if (typeof value !== 'boolean') throw fail(parameter, 'must be a boolean')
    } else if (parameter.type === 'string') {
      if (typeof value !== 'string') throw fail(parameter, 'must be a string')
    } else {
      if (typeof value !== 'number' || !Number.isFinite(value)) throw fail(parameter, 'must be a finite number')
      if (parameter.type === 'int' && !Number.isInteger(value)) throw fail(parameter, 'must be an integer')
      checkBounds(parameter, value)
    }
    values[parameter.key] = value
    sources[parameter.key] = source
  }

  const partBytes = Math.round(values.partMiB * MiB) + values.gcmTagBytes
  const topParts = Math.min(values.maxParts, Math.floor(values.targetMiB / values.partMiB + 1e-9))
  if (topParts < 1) throw new Error(`push policy: targetMiB (${values.targetMiB}) is smaller than one part (partMiB ${values.partMiB})`)
  const ladder = [...new Set(values.ladder)].sort((left, right) => left - right).filter((parts) => parts <= topParts)
  if (!ladder.length) throw new Error(`push policy parameter ladder (ZR_PUSH_LADDER) has no level <= ${topParts} parts`)
  if (!ladder.includes(values.rampStartParts)) throw new Error(`push policy parameter rampStartParts (ZR_PUSH_RAMP_START_PARTS) = ${values.rampStartParts} is not a level of the ladder [${ladder.join(', ')}]`)
  if (!ladder.includes(values.fallbackParts)) throw new Error(`push policy parameter fallbackParts (ZR_PUSH_FALLBACK_PARTS) = ${values.fallbackParts} is not a level of the ladder [${ladder.join(', ')}]`)

  return Object.freeze({
    ...values,
    ladder: Object.freeze(ladder),
    fixed: values.fixedBatchMiB > 0,
    partBytes,
    topParts,
    hardLimitBytes: Math.round(values.hardLimitMiB * MiB),
    safeLimitBytes: Math.floor(values.hardLimitMiB * MiB * (1 - values.safetyMarginPct / 100)),
    packFixedOverheadBytes: Math.round(values.packFixedOverheadKiB * 1024),
    sources: Object.freeze(sources),
  })
}

// ---------------------------------------------------------------------------------------------------------------------------
// Pure planning functions
// ---------------------------------------------------------------------------------------------------------------------------

/** Bytes of a push of `parts` full archive parts. / FR : octets d'une poussee de `parts` parts pleines. */
export const levelBytes = (config, parts) => parts * config.partBytes

/** Cap of one archive repository in bytes. kind 'film' (D2, 4 096 MiB), 'folder' (2 048 MiB) or 'legacy' (2 048 MiB, films laid out before D2). */
export function repoCapBytes(config, kind = 'film') {
  const capMiB = { film: config.repoCapMiB, folder: config.folderRepoCapMiB, legacy: config.legacyFilmRepoCapMiB }[kind]
  if (capMiB === undefined) throw new Error(`push policy: unknown repository kind ${kind}`)
  return Math.round(capMiB * MiB)
}

/** Parts per repository, floor(cap / (part + tag)). 4 096 MiB gives 43, 2 048 MiB gives 21. */
export function partsPerRepo(config, kind = 'film') {
  return Math.max(1, Math.floor(repoCapBytes(config, kind) / config.partBytes))
}

/**
 * Timeout of one push attempt carrying `payloadBytes`: never below pushTimeoutMs, and long enough for the slowest accepted line.
 * FR : delai d'une poussee ; jamais sous pushTimeoutMs, assez long pour la ligne la plus lente acceptee (un lot de 1 900 Mio ne
 * tient pas en 30 min sous 1,06 Mio/s).
 */
export function pushTimeoutMsFor(config, payloadBytes) {
  const byRate = Math.ceil((Math.max(0, payloadBytes) / (config.pushMinThroughputKiBps * 1024)) * 1000)
  return Math.max(config.pushTimeoutMs, byRate)
}

/**
 * True when the remote branch tip already is `commit` (a previous attempt landed late: killed or cut after the server accepted the pack).
 * `readTip` is async () => sha | null, the caller owns the git command. A read failure answers false (the safe, old behaviour).
 * FR : vrai si le sommet distant est deja `commit` (une tentative precedente est arrivee en retard).
 */
export async function remoteTipIs(readTip, commit) {
  if (!commit) return false
  try { return (await readTip()) === commit } catch { return false }
}

/** Estimated pack size of a push of `payloadBytes`, before any push. */
export function estimatePackBytes(config, payloadBytes, ratio = config.packOverheadRatio) {
  return Math.ceil(payloadBytes * Math.max(ratio, config.packOverheadRatio)) + config.packFixedOverheadBytes
}

/**
 * Greedy fill: how many leading items fit in `budgetBytes`. Always at least one item when the list is not empty (an item larger
 * than the budget travels alone). `maxCount` caps the number of items.
 * FR : combien d'elements de tete tiennent dans le budget ; au moins un.
 */
export function planBatch(sizes, budgetBytes, maxCount = Infinity) {
  let count = 0
  let bytes = 0
  for (const size of sizes) {
    if (count >= maxCount) break
    if (count > 0 && bytes + size > budgetBytes) break
    count += 1
    bytes += size
  }
  return { count, bytes }
}

/** Splits a whole list into consecutive batches of one budget. / FR : decoupe une liste entiere en lots. */
export function planAllBatches(sizes, budgetBytes) {
  const batches = []
  let start = 0
  while (start < sizes.length) {
    const { count, bytes } = planBatch(sizes.slice(start), budgetBytes)
    batches.push({ start, count, bytes })
    start += count
  }
  return batches
}

const UNIT_BYTES = { bytes: 1, byte: 1, B: 1, KiB: 1024, MiB: 1024 ** 2, GiB: 1024 ** 3, TiB: 1024 ** 4 }

/**
 * Reads the pack size from the output of `git push --progress`: the last "Writing objects: 100% (N/N), X MiB | Y MiB/s" line.
 * Returns { objects, bytes } or null (a push of a few objects can omit the size, or the output was cut).
 * FR : lit la taille reelle du pack dans la sortie de git push --progress.
 */
export function parsePushPackBytes(text) {
  const source = String(text || '')
  const pattern = /Writing objects:\s*100%\s*\((\d+)\/(\d+)\),\s*([\d.]+)\s*(bytes|byte|B|KiB|MiB|GiB|TiB)/g
  let last = null
  for (const match of source.matchAll(pattern)) last = match
  if (!last) return null
  return { objects: Number(last[2]), bytes: Math.round(Number(last[3]) * UNIT_BYTES[last[4]]) }
}

const TIMEOUT_PATTERN = /push timed out|timed out after|etimedout|operation timed out/i
const PACK_SIZE_PATTERN = /pack exceeds maximum allowed size|exceeds the maximum allowed size|http(?:\s+error)?\s+413|\b413\b.{0,40}(?:entity|payload|too large)|request entity too large|payload too large|push is too large|pack is too large/i

/**
 * 'pack-size': the push itself was too big (reduce the batch, nothing is lost); 'permanent': GitHub refuses this repository or
 * this object for good (the caller moves to a new repository); 'timeout': our own kill after the push timeout (the line is too slow
 * for this size); 'transient': everything else (network, server).
 * A pack-size failure is tested FIRST because the permanent test also matches the word "exceeds".
 * FR : un echec de taille se teste en premier car le test permanent reconnait aussi le mot "exceeds".
 */
export function classifyPushFailure(message) {
  const text = String(message || '')
  if (PACK_SIZE_PATTERN.test(text)) return 'pack-size'
  if (isPermanentPushRejection(text)) return 'permanent'
  if (TIMEOUT_PATTERN.test(text)) return 'timeout'
  return 'transient'
}

