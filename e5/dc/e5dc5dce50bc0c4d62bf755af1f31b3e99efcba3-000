export function createPushMetrics(config, { now = Date.now } = {}) {
  const totals = {
    batches: 0, attempts: 0, failedAttempts: 0, sizeFailures: 0, fallbacks: 0, stepUps: 0,
    payloadBytes: 0, packBytes: 0, packSampledPayloadBytes: 0, successMs: 0, failedMs: 0, waitMs: 0, maxPackRatio: 0,
  }
  let firstAt = null
  let lastAt = null
  const write = (record) => {
    if (!config.metricsFile) return
    try { appendFileSync(config.metricsFile, `${JSON.stringify(record)}\n`) } catch { /* metrics never break a push */ }
  }
  return {
    recordAttempt({ ok, count = 0, bytes = 0, packBytes = null, durationMs = 0, waitMs = 0, attempt = 1, level = null, mode = null, kind = null }) {
      const at = now()
      firstAt = firstAt ?? at - durationMs - waitMs
      lastAt = at
      totals.attempts += 1
      totals.waitMs += waitMs
      if (ok) {
        totals.batches += 1
        totals.payloadBytes += bytes
        totals.successMs += durationMs
        if (packBytes !== null) {
          totals.packBytes += packBytes
          if (bytes >= config.ratioSampleMinMiB * MiB) {
            totals.packSampledPayloadBytes += bytes
            totals.maxPackRatio = Math.max(totals.maxPackRatio, packBytes / bytes)
          }
        }
      } else {
        totals.failedAttempts += 1
        totals.failedMs += durationMs
        if (kind === 'pack-size') totals.sizeFailures += 1
      }
      write({ at: new Date(at).toISOString(), type: 'attempt', ok, count, bytes, packBytes, durationMs, waitMs, attempt, level, mode, kind,
        throughputBps: ok && durationMs > 0 ? Math.round(bytes / (durationMs / 1000)) : null })
    },
    recordEvent(type, data = {}) {
      if (type === 'fallback') totals.fallbacks += 1
      if (type === 'step-up') totals.stepUps += 1
      write({ at: new Date(now()).toISOString(), type, ...data })
    },
    summary() {
      const wallMs = firstAt === null ? 0 : Math.max(0, lastAt - firstAt)
      const sampled = totals.packSampledPayloadBytes
      return {
        ...totals,
        packRatio: sampled > 0 ? Number((totals.maxPackRatio).toFixed(5)) : null,
        averageThroughputBps: totals.successMs > 0 ? Math.round(totals.payloadBytes / (totals.successMs / 1000)) : 0,
        effectiveThroughputBps: totals.successMs + totals.failedMs > 0
          ? Math.round(totals.payloadBytes / ((totals.successMs + totals.failedMs) / 1000)) : 0,
        wallMs,
      }
    },
  }
}

// ---------------------------------------------------------------------------------------------------------------------------
// Controller: the adaptive state machine
// ---------------------------------------------------------------------------------------------------------------------------

/**
 * State: a level of the ladder (parts per push), a count of consecutive successes, a failure count PER BATCH, a size ceiling
 * learned from a size refusal and the largest pack ratio seen.
 *   success            : +1 consecutive success; at recoverAfterSuccesses the level steps up one rung (never above the top).
 *   transient failure  : counted for THIS batch; failures 1 and 2 retry the batch unchanged; failure 3 falls back to
 *                        fallbackParts and the count of that batch restarts.
 *   pack-size failure  : deterministic, so no unchanged retry: the level drops below the attempted size and a ceiling is set.
 * In fixed mode (ZR_SHARD_PUSH_BATCH_MB > 0) nothing adapts: the batch is the fixed size and every failure retries unchanged.
 * FR : machine a etats ; echecs comptes PAR LOT ; 1 et 2 rejouent le meme lot, le 3e retombe a 2 parts, remontee apres 3 succes.
 */
export function createPushController(config, { log = () => {}, now = Date.now } = {}) {
  const ladder = config.ladder
  const fallbackIndex = ladder.indexOf(config.fallbackParts)
  const startIndex = ladder.indexOf(config.rampStartParts)
  let levelIndex = config.fixed ? ladder.length - 1 : startIndex
  let consecutiveSuccesses = 0
  let sizeCeilingBytes = Infinity
  let maxObservedRatio = 0
  let throughputBps = 0 // average of the measured throughput of successful pushes (bytes per second), 0 = not measured yet
  let transferSeconds = 0 // seconds spent transferring (successes and failures), the denominator of the hiccup rate
  let hiccups = 0 // transient failures and timeouts seen (the line, not GitHub's size rules)
  let fellBack = false
  let timeoutHoldIndex = -1      // level index that timed out: climbing back to it is slower (F1)
  let lastSavedAt = 0
  const failuresByBatch = new Map()
  const metrics = createPushMetrics(config, { now })

  // Optional state shared between processes (stateFile). Best effort on both sides: an unreadable or stale file means a fresh ramp.
  // FR : etat optionnel partage entre processus ; un fichier illisible ou perime = nouvelle montee en charge.
  const readSavedState = () => {
    try {
      const saved = JSON.parse(readFileSync(config.stateFile, 'utf8'))
      const fresh = saved?.version === 1 && Number.isFinite(saved.savedAt) && now() - saved.savedAt <= config.stateMaxAgeMin * 60000
      const index = ladder.indexOf(saved?.level)
      return fresh && index >= 0 ? { saved, index } : null
    } catch { return null }
  }
  // Two upload lanes (archive and packaging) save to the same file from two processes. The save is a CONSERVATIVE merge, never last
  // writer wins: when the file was written by someone else since our last save, a lower level, a fallback flag, a smaller size
  // ceiling and a larger ratio survive, and our memory adopts a lower level at once (F5, 12 October 2026).
  // FR : deux processus ecrivent le meme fichier ; la fusion est prudente, un repli ou un plafond d'un autre processus survit.
  const saveState = () => {
    if (!config.stateFile || config.fixed) return
    try {
      const other = readSavedState()
      if (other && other.saved.savedAt > lastSavedAt) {
        if (other.index < levelIndex) { levelIndex = other.index; consecutiveSuccesses = 0 }
        if (other.saved.fellBack === true) fellBack = true
        if (Number.isFinite(other.saved.sizeCeilingBytes) && other.saved.sizeCeilingBytes > 0) sizeCeilingBytes = Math.min(sizeCeilingBytes, other.saved.sizeCeilingBytes)
        if (Number.isFinite(other.saved.maxObservedRatio) && other.saved.maxObservedRatio >= 1) maxObservedRatio = Math.max(maxObservedRatio, other.saved.maxObservedRatio)
        if (!throughputBps && Number.isFinite(other.saved.throughputBps) && other.saved.throughputBps > 0) throughputBps = other.saved.throughputBps
        if (Number.isFinite(other.saved.transferSeconds)) transferSeconds = Math.max(transferSeconds, other.saved.transferSeconds)
        if (Number.isFinite(other.saved.hiccups)) hiccups = Math.max(hiccups, other.saved.hiccups)
      }
      mkdirSync(path.dirname(config.stateFile), { recursive: true })
      const temporary = `${config.stateFile}.${process.pid}.tmp`
      lastSavedAt = Math.max(now(), lastSavedAt + 1)
      writeFileSync(temporary, JSON.stringify({
        version: 1, savedAt: lastSavedAt, level: ladder[levelIndex], consecutiveSuccesses, fellBack,
        sizeCeilingBytes: Number.isFinite(sizeCeilingBytes) ? sizeCeilingBytes : null, maxObservedRatio, throughputBps, transferSeconds, hiccups,
      }))
      renameSync(temporary, config.stateFile)
    } catch { /* the state is an optimisation, never a reason to fail a push */ }
  }
  if (config.stateFile && !config.fixed) {
    try {
      const loaded = readSavedState()
      if (loaded) {
        const { saved, index } = loaded
        lastSavedAt = saved.savedAt
        levelIndex = index
        consecutiveSuccesses = Math.max(0, Math.min(config.recoverAfterSuccesses - 1, Number(saved.consecutiveSuccesses) || 0))
        fellBack = saved.fellBack === true
        if (Number.isFinite(saved.sizeCeilingBytes) && saved.sizeCeilingBytes > 0) sizeCeilingBytes = saved.sizeCeilingBytes
        if (Number.isFinite(saved.maxObservedRatio) && saved.maxObservedRatio >= 1) maxObservedRatio = saved.maxObservedRatio
        if (Number.isFinite(saved.throughputBps) && saved.throughputBps > 0) throughputBps = saved.throughputBps
        if (Number.isFinite(saved.transferSeconds)) transferSeconds = saved.transferSeconds
        if (Number.isFinite(saved.hiccups)) hiccups = saved.hiccups
      }
    } catch { /* no state yet */ }
  }

  const effectiveRatio = () => Math.max(config.packOverheadRatio, maxObservedRatio)
  const mode = () => {
    if (config.fixed) return 'fixed'
    if (fellBack && levelIndex <= fallbackIndex) return 'fallback'
    if (levelIndex === ladder.length - 1) return 'steady'
    return 'ramp'
  }

  /** Mean time between hiccups, learned: (observed transfer time + prior) / (hiccups + 1). */
  const meanTimeBetweenHiccups = () => (transferSeconds + config.hiccupPriorMtbfSeconds) / (hiccups + 1)
  /** The duration a push should aim for: sqrt(2 x overhead x MTBF), or the explicit override. */
  const targetSeconds = () => config.targetPushSeconds > 0 ? config.targetPushSeconds
    : Math.min(config.maxTargetSeconds, Math.max(config.minTargetSeconds, Math.sqrt(2 * config.fixedPushOverheadSeconds * meanTimeBetweenHiccups())))

  function budgetBytes() {
    if (config.fixed) return Math.max(config.partBytes, Math.floor(config.fixedBatchMiB * MiB))
    const byLevel = levelBytes(config, ladder[levelIndex])
    const bySafety = Math.floor((config.safeLimitBytes - config.packFixedOverheadBytes) / effectiveRatio())
    // the learned ceiling wins over the one part floor: a refused size must never be planned again
    // FR : le plafond appris l'emporte sur le plancher d'une part
    // 14 October 2026: size the push by the MEASURED line, not by a constant. A push should last about targetPushSeconds: at 11 MB/s
    // that is 2.6 GB (the full 1 900 MiB applies), at 1 MB/s it is 240 MB. Never below the old rule (fallbackParts), never above the level.
    // FR : on dimensionne le push par la ligne MESUREE : une duree visee (240 s), jamais sous l'ancienne regle, jamais au-dessus du niveau.
    const byThroughput = config.throughputSizing && throughputBps > 0
      ? Math.max(config.throughputMinParts * config.partBytes, Math.floor(throughputBps * targetSeconds())) : Infinity
    return Math.min(sizeCeilingBytes, Math.max(config.partBytes, Math.min(byLevel, bySafety, byThroughput)))
  }

  /**
   * The next batch out of the pending sizes. `maxCount` keeps a retried batch from growing when more items arrived.
   * FR : le prochain lot ; maxCount empeche un lot rejoue de grossir.
   */
  function plan(sizes, headId = '', { maxCount = Infinity } = {}) {
    const budget = budgetBytes()
    const { count, bytes } = planBatch(sizes, budget, maxCount)
    return {
      headId, count, bytes, budgetBytes: budget, parts: Number((bytes / config.partBytes).toFixed(2)),
      level: ladder[levelIndex], mode: mode(), estimatePackBytes: estimatePackBytes(config, bytes, effectiveRatio()),
      timeoutMs: pushTimeoutMsFor(config, bytes),
    }
  }

  function recordSuccess({ headId = '', count, bytes, packBytes = null, durationMs = 0, waitMs = 0, attempt = 1 }) {
    failuresByBatch.delete(headId)
    metrics.recordAttempt({ ok: true, count, bytes, packBytes, durationMs, waitMs, attempt, level: ladder[levelIndex], mode: mode() })
    if (packBytes !== null && bytes >= config.ratioSampleMinMiB * MiB) maxObservedRatio = Math.max(maxObservedRatio, packBytes / bytes)
    if (durationMs > 0) transferSeconds += durationMs / 1000
    if (durationMs > 0 && bytes >= config.throughputSampleMinMiB * MiB) {
      const measured = bytes / (durationMs / 1000)
      throughputBps = throughputBps > 0 ? throughputBps * (1 - config.throughputAlpha) + measured * config.throughputAlpha : measured
    }
    if (config.fixed) return { action: 'none' }
    if (timeoutHoldIndex >= 0 && levelIndex >= timeoutHoldIndex) timeoutHoldIndex = -1 // the line carried that level again
    // A success counts toward a step up only when it filled the budget of the current level: the tail drain (1 or 2 parts) and the
    // poster at the end of a film say nothing about the line's ability to carry a 1 900 MiB push (F3, 12 October 2026).
    // FR : un succes ne compte pour la montee que s'il a rempli le budget du niveau courant ; les queues de film ne comptent pas.
    const filled = bytes >= levelBytes(config, ladder[levelIndex]) * (config.stepUpMinFillPct / 100) - 1
    if (filled) consecutiveSuccesses += 1
    const needed = timeoutHoldIndex >= 0 && levelIndex + 1 >= timeoutHoldIndex
      ? config.recoverAfterSuccesses * config.timeoutHoldFactor : config.recoverAfterSuccesses
    if (consecutiveSuccesses >= needed && levelIndex < ladder.length - 1) {
      levelIndex += 1
      consecutiveSuccesses = 0
      if (levelIndex > fallbackIndex) fellBack = false
      metrics.recordEvent('step-up', { level: ladder[levelIndex] })
      log(`  push policy: ${config.recoverAfterSuccesses} successes in a row, level up to ${ladder[levelIndex]} parts`)
      saveState()
      return { action: 'step-up', level: ladder[levelIndex] }
    }
    saveState()
    return { action: 'none' }
  }

  /** A transient failure of the batch headed by `headId`. / FR : echec transitoire du lot de tete `headId`. */
  function recordFailure(headId, details = {}, kind = 'transient') {
    metrics.recordAttempt({ ok: false, ...details, level: ladder[levelIndex], mode: mode(), kind })
    if (kind === 'transient' || kind === 'timeout') { hiccups += 1; if (details.durationMs > 0) transferSeconds += details.durationMs / 1000 }
    if (config.fixed) return { action: 'retry', failures: (failuresByBatch.get(headId) || 0) + 1 }
    consecutiveSuccesses = 0
    const failures = (failuresByBatch.get(headId) || 0) + 1
    if (failures >= config.failuresBeforeFallback) {
      failuresByBatch.delete(headId)
      const from = ladder[levelIndex]
      levelIndex = Math.min(levelIndex, fallbackIndex)
      fellBack = true
      metrics.recordEvent('fallback', { from, to: ladder[levelIndex], failures })
      log(`  push policy: ${failures} failures of the same batch, falling back to ${ladder[levelIndex]} parts`)
      saveState()
      return { action: 'fallback', level: ladder[levelIndex], failures }
    }
    failuresByBatch.set(headId, failures)
    return { action: 'retry', failures }
  }

  /**
   * Our own timeout killed the push: the line cannot carry this size in the allowed time. Retrying the same batch would burn the
   * same time again, so the level drops below the attempted size at once (no permanent ceiling: the line may recover) and the climb
   * back to the level that timed out is slower. At the lowest level it is a plain transient failure (F1, 12 October 2026).
   * FR : notre delai a tue la poussee : le niveau descend sous la taille tentee, la remontee jusqu'a ce niveau est plus lente.
   */
  function recordTimeout(headId, details = {}) {
    const bytes = details.bytes || 0
    let next = -1
    for (let index = 0; index < ladder.length; index += 1) if (levelBytes(config, ladder[index]) < bytes) next = index
    if (config.fixed || next < 0 || next >= levelIndex) {
      return recordFailure(headId, details, 'timeout')
    }
    metrics.recordAttempt({ ok: false, ...details, level: ladder[levelIndex], mode: mode(), kind: 'timeout' })
    consecutiveSuccesses = 0
    failuresByBatch.delete(headId)
    const from = ladder[levelIndex]
    timeoutHoldIndex = Math.max(timeoutHoldIndex, levelIndex)
    levelIndex = Math.min(levelIndex, next)
    metrics.recordEvent('timeout-shrink', { from, to: ladder[levelIndex], attemptedBytes: bytes })
    log(`  push policy: a push of ${Math.round(bytes / MiB)} MiB timed out, level down to ${ladder[levelIndex]} parts`)
    saveState()
    return { action: 'shrink-timeout', level: ladder[levelIndex] }
  }

  /**
   * GitHub refused the push because of its size. `count` items totalling `bytes` were attempted.
   * Returns { action: 'shrink' } when a smaller batch can be tried, { action: 'giveup' } when one item alone was refused.
   * FR : GitHub a refuse la poussee pour sa taille ; on reduit sans rien perdre, ou on abandonne si un seul element est refuse.
   */
  function recordSizeFailure({ count, bytes, durationMs = 0, waitMs = 0, attempt = 1, headId = '' }) {
    metrics.recordAttempt({ ok: false, count, bytes, durationMs, waitMs, attempt, level: ladder[levelIndex], mode: mode(), kind: 'pack-size' })
    if (config.fixed || count <= 1) return { action: 'giveup' }
    consecutiveSuccesses = 0
    failuresByBatch.delete(headId)
    sizeCeilingBytes = Math.min(sizeCeilingBytes, bytes - 1)
    let next = 0
    for (let index = 0; index < ladder.length; index += 1) if (levelBytes(config, ladder[index]) < bytes) next = index
    levelIndex = Math.min(levelIndex, next)
    metrics.recordEvent('size-shrink', { attemptedBytes: bytes, ceilingBytes: sizeCeilingBytes, level: ladder[levelIndex] })
    log(`  push policy: a push of ${Math.round(bytes / MiB)} MiB was refused for its size, batch reduced to at most ${Math.round(sizeCeilingBytes / MiB)} MiB`)
    saveState()
    return { action: 'shrink', level: ladder[levelIndex], ceilingBytes: sizeCeilingBytes }
  }

  const backoffMs = (attempt) => Math.min(config.backoffMaxMs, config.backoffBaseMs * attempt)

  return {
    config, metrics, plan, budgetBytes, recordSuccess, recordFailure, recordTimeout, recordSizeFailure, backoffMs,
    get fixed() { return config.fixed },
    state: () => ({
      mode: mode(), level: ladder[levelIndex], levelIndex, consecutiveSuccesses, sizeCeilingBytes,
      maxObservedRatio, pendingFailures: Object.fromEntries(failuresByBatch), budgetBytes: budgetBytes(), throughputBps, transferSeconds, hiccups, targetSeconds: targetSeconds(),
    }),
  }
}

// ---------------------------------------------------------------------------------------------------------------------------
// Engine: one batch, until it is confirmed
// ---------------------------------------------------------------------------------------------------------------------------

export class PushPermanentRejection extends Error {
  constructor(message, label = '') {
    super(`push permanently refused${label ? ` for ${label}` : ''}: ${String(message).slice(-400)}`)
    this.name = 'PushPermanentRejection'
    this.detail = String(message || '')
    this.label = label
  }
}

export class PushExhausted extends Error {
  constructor(label, attempts, lastMessage) {
    super(`push exhausted for ${label} after ${attempts} attempts: ${String(lastMessage || '').slice(-200)}`)
    this.name = 'PushExhausted'
    this.attempts = attempts
    this.lastMessage = String(lastMessage || '')
  }
}

const defaultSleep = (milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds))

/**
 * Drives ONE batch to a confirmed push.
 *   sizes   : sizes in bytes of the pending items, head first (the head decides the batch identity)
 *   headId  : stable identity of the head item (failures are counted per batch, never per file)
 *   attempt : async ({ count, bytes, parts, attemptNumber, estimatePackBytes, ... }) => { status, stdout, stderr, packBytes?,
 *             durationMs?, waitMs? }; status 0 means the push is confirmed. It must be safe to call again (same commit).
 * Returns { count, bytes, attempts, packBytes }. Throws PushPermanentRejection or PushExhausted; the data is never dropped,
 * the caller still owns the items.
 * FR : mene UN lot jusqu'a la confirmation ; ne perd jamais de donnees, l'appelant garde ses elements.
 */
export async function runPushBatch({ controller, sizes, headId, attempt, sleep = defaultSleep, log = () => {}, label = 'push' }) {
  if (!Array.isArray(sizes) || !sizes.length) throw new Error('runPushBatch: no pending item')
  if (typeof attempt !== 'function') throw new Error('runPushBatch: the attempt function is missing')
  const { config } = controller
  let attempts = 0
  let lastMessage = ''
  let lockedCount = Infinity
  while (attempts < config.maxAttempts) {
    const plan = controller.plan(sizes, headId, { maxCount: lockedCount })
    attempts += 1
    log(`  push ${label}: attempt ${attempts}, ${plan.count} item(s), ${(plan.bytes / MiB).toFixed(1)} MiB (${plan.parts} parts), `
      + `estimated pack ${(plan.estimatePackBytes / MiB).toFixed(1)} MiB, mode ${plan.mode}`)
    const started = Date.now()
    const result = await attempt({ ...plan, attemptNumber: attempts })
    const durationMs = Number.isFinite(result?.durationMs) ? result.durationMs : Date.now() - started
    const waitMs = Number.isFinite(result?.waitMs) ? result.waitMs : 0
    const output = `${result?.stderr || ''}\n${result?.stdout || ''}`
    if (result && result.status === 0) {
      const packBytes = Number.isFinite(result.packBytes) ? result.packBytes : (parsePushPackBytes(output)?.bytes ?? null)
      controller.recordSuccess({ headId, count: plan.count, bytes: plan.bytes, packBytes, durationMs, waitMs, attempt: attempts })
      return { count: plan.count, bytes: plan.bytes, attempts, packBytes }
    }
    lastMessage = output.trim()
    const kind = classifyPushFailure(lastMessage)
    if (kind === 'permanent' || (kind === 'pack-size' && controller.fixed)) {
      controller.metrics.recordAttempt({ ok: false, count: plan.count, bytes: plan.bytes, durationMs, waitMs, attempt: attempts, kind: 'permanent' })
      throw new PushPermanentRejection(lastMessage, label)
    }
    if (kind === 'pack-size') {
      const decision = controller.recordSizeFailure({ count: plan.count, bytes: plan.bytes, durationMs, waitMs, attempt: attempts, headId })
      if (decision.action === 'giveup') throw new PushPermanentRejection(lastMessage, label)
      lockedCount = Infinity // the smaller budget decides the next count
      continue
    }
    if (kind === 'timeout') {
      const timeoutDecision = controller.recordTimeout(headId, { count: plan.count, bytes: plan.bytes, durationMs, waitMs, attempt: attempts })
      if (timeoutDecision.action === 'shrink-timeout') {
        lockedCount = Infinity // the smaller level decides the next count
        log(`  push ${label}: attempt ${attempts} timed out, batch reduced`)
        if (attempts < config.maxAttempts) await sleep(controller.backoffMs(attempts))
        continue
      }
      lockedCount = timeoutDecision.action === 'fallback' ? Infinity : plan.count
      log(`  push ${label}: attempt ${attempts} failed (${timeoutDecision.action}) ${lastMessage.slice(-120)}`)
      if (attempts < config.maxAttempts) await sleep(controller.backoffMs(attempts))
      continue
    }
    const decision = controller.recordFailure(headId, { count: plan.count, bytes: plan.bytes, durationMs, waitMs, attempt: attempts })
    lockedCount = decision.action === 'fallback' ? Infinity : plan.count
    log(`  push ${label}: attempt ${attempts} failed (${decision.action}) ${lastMessage.slice(-120)}`)
    if (attempts < config.maxAttempts) await sleep(controller.backoffMs(attempts))
  }
  throw new PushExhausted(label, attempts, lastMessage)
}

// ---------------------------------------------------------------------------------------------------------------------------
// One controller per process, so that the archive push and the CMAF push of a film share the same ramp state.
// ---------------------------------------------------------------------------------------------------------------------------
let sharedController = null

export function sharedPushController({ env = process.env, log } = {}) {
  if (!sharedController) sharedController = createPushController(loadPushPolicyConfig(env), { log })
  return sharedController
}

export function resetSharedPushController() { sharedController = null }

/**
 * For the scripts that keep their own synchronous push loop (folder archives, image shards, audio, the cold backup): they ask the
 * shared controller how big a push may be (the measured line, never above 1 900 MiB), how long to wait for it, and they report each
 * outcome so the controller keeps learning the line. Fixed values were written in each of them (150, 400, 900 MiB); they now follow.
 * FR : pour les scripts qui gardent leur boucle de push synchrone : taille permise, delai, et compte rendu de chaque resultat.
 */
export function sharedBatchAdapter({ env = process.env, log, controller = null } = {}) {
  const shared = controller || sharedPushController({ env, log })
  let sequence = 0
  return {
    controller: shared,
    /** Bytes a push may carry now. ZR_SHARD_PUSH_BATCH_MB above 0 still means a fixed batch. */
    budgetBytes: () => shared.budgetBytes(),
    /** Timeout of one push attempt carrying `bytes`: never below the configured minimum, long enough for the slowest accepted line. */
    timeoutMs: (bytes) => pushTimeoutMsFor(shared.config, bytes),
    /** One batch: call ok() or fail() after EACH attempt; the batch keeps one identity, so repeated failures are counted per batch. */
    track(bytes, count = 1) {
      sequence += 1
      const headId = `adapter-${sequence}`
      return {
        ok: (durationMs) => shared.recordSuccess({ headId, count, bytes, durationMs }),
        fail: (durationMs, message = '') => {
          const kind = classifyPushFailure(message)
          // a permanent refusal is not a line hiccup (the caller moves to a new repository); a size refusal reduces the batch
          if (kind === 'permanent') return { action: 'ignored' }
          if (kind === 'pack-size') return shared.recordSizeFailure({ count, bytes, durationMs, headId })
          return shared.recordFailure(headId, { count, bytes, durationMs }, kind)
        },
      }
    },
  }
}
