import React from 'react'
import { lazyRetry } from '../lib/lazyRetry.js'
import { VIDEO_ENGINE } from '../media/mediaViewerRoute.js'

const LazyUnifiedVideo = lazyRetry(() => import('./VideoPlayer2.jsx'))
const LazyMseVideo = lazyRetry(() => import('./StreamVideoMSE.jsx'))
const LazyNativeVideo = lazyRetry(() => import('./StreamVideo.jsx'))
const LazyLegacyVideo = lazyRetry(() => import('./VideoPlayer.jsx'))

// Point de montage unique des moteurs vidéo. La sélection du moteur est faite par mediaViewerRoute.js ; ce
// composant ne devine rien à partir du MIME et garantit qu'un seul import paresseux est monté par manifeste.
export default function VideoViewerAdapter({ engine, t, path, manifest, onSaveMeta, onUnsupported }) {
  let Viewer = null
  let props = { t, path, manifest }
  if (engine === VIDEO_ENGINE.unified) {
    Viewer = LazyUnifiedVideo
    props = { ...props, onSaveMeta }
  } else if (engine === VIDEO_ENGINE.mse) {
    Viewer = LazyMseVideo
  } else if (engine === VIDEO_ENGINE.native) {
    Viewer = LazyNativeVideo
  } else if (engine === VIDEO_ENGINE.legacyWasm) {
    Viewer = LazyLegacyVideo
    props = { ...props, onUnsupported }
  }
  if (!Viewer) return null
  return (
    <React.Suspense fallback={<div style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-md)' }}>Chargement du lecteur…</div>}>
      <Viewer {...props} />
    </React.Suspense>
  )
}
