// 10 October 2026, 23:27 CEST: add reference links to a gallery the way the gallery link card does: preview, image upload, then a save that retries on conflict.
// FR : ajoute des liens à une galerie comme la carte de lien : aperçu, envoi de l'image, puis sauvegarde qui réessaie en cas de conflit.
// The drive code comes from ZENRAY_DRIVE_CODE, typed by the person who runs the script. It is never printed.
// FR : le code du drive vient de ZENRAY_DRIVE_CODE, saisi par la personne qui lance le script. Il n'est jamais affiché.
const DEFAULT_BASE = 'https://zenray-progress.pages.dev'
const SAVE_ATTEMPTS = 5
const GALLERY_PATH = /^pages\/[\w-]+\/[\w.-]+\.json$/

const args = process.argv.slice(2)
const dryRun = args.includes('--dry-run')
const [galleryPath, ...urls] = args.filter((arg) => arg !== '--dry-run')

function fail(message, status = 1) {
  console.error(message)
  process.exit(status)
}

if (!galleryPath || urls.length === 0) fail('usage : AddDesignLinks.mjs [--dry-run] pages/<Galerie>/<nom>.json <url> [url...]', 2)
if (!GALLERY_PATH.test(galleryPath)) fail(`chemin refusé : ${galleryPath} (seul pages/<Galerie>/<nom>.json est accepté)`, 2)
for (const url of urls) if (!/^https?:\/\//i.test(url)) fail(`URL invalide : ${url}`, 2)

const base = (process.env.ZENRAY_BASE_URL || DEFAULT_BASE).replace(/\/$/, '')
const driveCode = process.env.ZENRAY_DRIVE_CODE || ''
if (!dryRun && !driveCode) fail('ZENRAY_DRIVE_CODE est vide. Lance : read -s "?Code du drive : " ZENRAY_DRIVE_CODE && export ZENRAY_DRIVE_CODE', 2)

// Only the drive routes receive the code. The link preview stays public, as it is in the app.
// FR : seules les routes du drive reçoivent le code ; l'aperçu reste public, comme dans l'application.
async function request(route, { method = 'GET', body, auth = false } = {}) {
  const headers = {}
  if (body !== undefined) headers['content-type'] = 'application/json'
  if (auth) headers['x-zr-auth'] = driveCode
  const response = await fetch(`${base}${route}`, { method, headers, body })
  return { status: response.status, data: await response.json().catch(() => ({})) }
}

function parseGallery(text) {
  try {
    const parsed = JSON.parse(text)
    return parsed && typeof parsed === 'object' ? parsed : null
  } catch {
    return null
  }
}

async function readGallery() {
  const { status, data } = await request(`/api/page?action=read&path=${encodeURIComponent(galleryPath)}`, { auth: true })
  if (status === 401) fail('code refusé par le drive (401) : rien n\'a été écrit')
  return { sha: data.sha || null, gallery: parseGallery(data.markdown) || { v: 1, items: [] } }
}

// Same fallback as the link card: a page that does not answer still gives a title from its host, and no image.
// FR : même repli que la carte de lien : une page muette donne un titre tiré de son domaine, sans image.
async function preview(url) {
  const { data } = await request(`/api/unfurl?url=${encodeURIComponent(url)}`)
  if (data.error || !data.title) return { title: new URL(url).hostname.replace(/^www\./, ''), description: '', image: null }
  return { title: data.title, description: data.description || '', image: data.image || null }
}

// The server downloads the picture and keeps it in the drive, as the link card does.
// FR : le serveur télécharge l'image et la garde dans le drive, comme la carte de lien.
async function storeImage(imageUrl) {
  const { data } = await request('/api/img', { method: 'POST', body: JSON.stringify({ url: imageUrl, dir: 'uploads' }), auth: true })
  return data.path ? { path: data.path, source: 'téléversée' } : { path: imageUrl, source: 'lien distant' }
}

// Same shape as the item the link card writes (ajouterReference in GalleryView.jsx).
// FR : même forme que l'élément écrit par la carte de lien (ajouterReference dans GalleryView.jsx).
function toItem({ url, title, description, image }) {
  return {
    id: `g-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 6)}`,
    kind: 'image',
    path: image.path,
    name: title,
    title,
    url,
    note: description,
    w: 16,
    h: 9,
    addedAt: new Date().toISOString(),
  }
}

async function main() {
  let { sha, gallery } = dryRun ? { sha: null, gallery: { v: 1, items: [] } } : await readGallery()
  const prepared = []
  for (const url of urls) {
    if ((gallery.items || []).some((item) => item.url === url)) {
      console.log(`déjà présent : ${url}`)
      continue
    }
    const info = await preview(url)
    let image = { path: '', source: 'aucune image' }
    if (info.image && dryRun) image = { path: info.image, source: 'lien distant (simulation)' }
    else if (info.image) image = await storeImage(info.image)
    prepared.push({ url, ...info, image })
  }

  if (dryRun) {
    for (const entry of prepared) console.log(`à ajouter : ${entry.url} (${entry.title}, ${entry.image.source})`)
    return
  }

  for (let attempt = 1; ; attempt += 1) {
    const known = new Set((gallery.items || []).map((item) => item.url))
    const additions = prepared.filter((entry) => !known.has(entry.url))
    const next = { ...gallery, v: 1, items: [...additions.map(toItem), ...(gallery.items || [])] }
    const { data } = await request('/api/page', {
      method: 'POST',
      body: JSON.stringify({ action: 'save', path: galleryPath, markdown: JSON.stringify(next), sha }),
      auth: true,
    })
    if (data.ok) {
      for (const entry of additions) console.log(`ajouté : ${entry.url} (${entry.title}, ${entry.image.source})`)
      console.log(`${additions.length} ajout(s), ${next.items.length} élément(s) dans ${galleryPath}`)
      return
    }
    if (!data.conflict || attempt >= SAVE_ATTEMPTS) fail(data.error || 'sauvegarde refusée')
    // Someone else saved first: take their version, apply the links again, and retry.
    // FR : un autre a sauvegardé avant : on reprend sa version, on rejoue les ajouts, puis on réessaie.
    const fresh = data.markdown != null ? parseGallery(data.markdown) : null
    if (fresh) {
      sha = data.sha || null
      gallery = fresh
    } else {
      ({ sha, gallery } = await readGallery())
    }
  }
}

main().catch((error) => fail(error.message))
