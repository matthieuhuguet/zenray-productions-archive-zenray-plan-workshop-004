// 3 October 2026, 15:10 CEST: identity is a readable projection of the registry, never another editable mapping.
import React, { useMemo } from 'react'
import { buildGlobalProjectIndex, renderProjectContext } from '../../lib/projectContextIndex.js'

export default function ProjectIdentity({ project, projects, connected }) {
  const markdown = useMemo(() => {
    try {
      const all = [...projects.filter((entry) => entry.id !== project.id && entry.folder), project]
      return renderProjectContext(buildGlobalProjectIndex(all, { cloud: !connected }), project.id)
    } catch (error) {
      return `# ${project.name}\n\nProject ID: ${project.id}\n\nMapping unavailable: ${error.message}. Link this collection to a valid project before using its mapping.\n`
    }
  }, [project, projects, connected])
  const download = () => {
    const url = URL.createObjectURL(new Blob([markdown], { type: 'text/markdown;charset=utf-8' }))
    const link = document.createElement('a')
    link.href = url; link.download = `${project.id}.md`; link.click()
    setTimeout(() => URL.revokeObjectURL(url), 1000)
  }
  return <section className="assets-identity" aria-label="Identité du projet">
    <div className="assets-section-heading"><div><h3>Identité du projet</h3><p>Un identifiant relie tous les fichiers, emplacements et discussions.</p></div><button type="button" className="assets-button" onClick={download}>Télécharger la fiche .md</button></div>
    <dl><div><dt>Projet</dt><dd><code>{project.id}</code></dd></div><div><dt>Dossier cloud</dt><dd><code>{project.folder || 'Non défini'}</code></dd></div><div><dt>Feedback</dt><dd><code>{project.feedbackPath || 'Non relié'}</code></dd></div></dl>
    <details><summary>Lire la fiche et le mapping</summary><p className="assets-footnote">Cette fiche est générée depuis le registre et actualisée avec le projet. Le feedback conserve la discussion ; la fiche explique où retrouver ses fichiers et sa mémoire.</p><pre className="assets-text-preview">{markdown}</pre></details>
  </section>
}
