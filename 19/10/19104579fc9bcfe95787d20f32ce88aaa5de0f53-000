import React from 'react'
import { act, cleanup, render, screen } from '@testing-library/react'
import { afterEach, expect, it, vi } from 'vitest'
import { NotificationHost, notify, notifyProgress, dismiss } from './Notifications.jsx'
import { THEMES } from '../theme.js'

// 2026-09-11 08:44: toast cards expire in five seconds, while active progress cards remain visible.
afterEach(() => { cleanup(); vi.useRealTimers() })
it.each(['done', 'fail'])('met à jour la progression avant %s', (finish) => {
  vi.useFakeTimers()
  render(<NotificationHost t={THEMES.dark} />)
  let progress
  act(() => { progress = notifyProgress({ title: 'photos.zip', label: 'Téléchargement', body: 'Préparation…' }) })
  act(() => { vi.advanceTimersByTime(20000); progress.set({ progress: 0.4, body: 'Lecture 2/5 : photo.jpg' }) })
  expect(screen.getByText('photos.zip')).toBeInTheDocument()
  expect(screen.getByRole('img', { name: 'En cours…' })).toBeInTheDocument()
  expect(screen.getByRole('progressbar')).toHaveAttribute('aria-valuenow', '40')
  expect(screen.getByRole('status')).toHaveTextContent('Lecture 2/5 : photo.jpg')
  act(() => { progress[finish]({ body: finish === 'done' ? 'Terminé' : 'Disque plein' }) })
  expect(screen.queryByRole('img', { name: 'En cours…' })).not.toBeInTheDocument()
  act(() => { dismiss(progress.id); vi.advanceTimersByTime(300) })
})

it('ferme une notification avec actions après cinq secondes et la fait disparaître en fondu', () => {
  vi.useFakeTimers()
  render(<NotificationHost t={THEMES.light} />)
  act(() => { notify({ title: 'Décision', actions: [{ label: 'Ouvrir', onClick: () => {} }], ttl: 30000 }) })
  expect(screen.getByText('Décision')).toBeInTheDocument()

  act(() => { vi.advanceTimersByTime(4999) })
  expect(screen.getByText('Décision')).toBeInTheDocument()

  act(() => { vi.advanceTimersByTime(1) })
  const card = screen.getByText('Décision').closest('.zr-notif')
  expect(card).toHaveClass('zr-notif-out')
  expect(card).toHaveStyle({ opacity: '0' })

  act(() => { vi.advanceTimersByTime(300) })
  expect(screen.queryByText('Décision')).not.toBeInTheDocument()
})

it('conserve le téléchargement quand quatre autres notifications arrivent', () => {
  vi.useFakeTimers()
  render(<NotificationHost t={THEMES.light} />)
  const ids = []
  act(() => {
    ids.push(notifyProgress({ title: 'archive active.zip' }).id)
    for (let i = 0; i < 4; i++) ids.push(notify({ title: `Message ${i}` }))
  })
  expect(screen.getByText('archive active.zip')).toBeInTheDocument()
  expect(screen.getByRole('progressbar')).toBeInTheDocument()
  act(() => { ids.forEach(dismiss); vi.advanceTimersByTime(300) })
})

// 2 October 2026: a job with unknown progress shows a sliding capsule, never a fake percentage.
it('une carte indéterminée affiche le spinner et une capsule sans pourcentage, puis finit en vert', () => {
  vi.useFakeTimers()
  render(<NotificationHost t={THEMES.dark} />)
  let carte
  act(() => { carte = notifyProgress({ title: 'IMG_7655.JPG', label: 'Tri', body: 'Vers tmp-img-selection1…', indeterminate: true }) })
  expect(screen.getByText('IMG_7655.JPG')).toBeInTheDocument()
  expect(screen.getByRole('img', { name: 'En cours…' })).toBeInTheDocument()
  expect(screen.getByRole('progressbar')).not.toHaveAttribute('aria-valuenow')
  expect(screen.queryByText('0%')).not.toBeInTheDocument()
  act(() => { carte.done({ label: 'Tri · fait', body: '→ tmp-img-selection1' }) })
  expect(screen.getByRole('status')).toHaveTextContent('→ tmp-img-selection1')
  act(() => { dismiss(carte.id); vi.advanceTimersByTime(300) })
})
