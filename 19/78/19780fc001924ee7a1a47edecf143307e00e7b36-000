// 16 October 2026 14:15 Europe/Paris: no sense leakage across spelling/reading restrictions or level memberships.
import { describe, expect, it } from 'vitest'
import { createReferenceClient, filterReferences, vocabularyForms } from './japaneseReferenceModel.js'
const word = { id: 'word-1', level: 'N5', memberships: ['N5','N2'], kanji: [{text:'生'}], kana: [{text:'なま'},{text:'せい'}], senses: [{gloss:[{text:'cru',lang:'fre'}]},{gloss:[{text:'vie',lang:'fre'}]}], bindings:[[0,0,[0]],[0,1,[1]]] }
describe('reference browsing', () => {
  it('keeps each French meaning tied to its compatible reading', () => {
    expect(vocabularyForms(word)).toEqual([{spelling:'生',reading:'なま',senses:[word.senses[0]]},{spelling:'生',reading:'せい',senses:[word.senses[1]]}])
  })
  it('finds overlapping level memberships and French text without changing levels', () => {
    expect(filterReferences([word],{kind:'vocabulary',level:'N2',query:'vie'})).toEqual([word])
    expect(filterReferences([word],{kind:'vocabulary',level:'unclassified'})).toEqual([])
  })
  it('does not cache transient read failures or invalid data', async () => {
    let tries = 0
    const client = createReferenceClient(async () => ++tries === 1 ? null : {schemaVersion:1,entries:[]})
    await expect(client.load('kana')).rejects.toThrow()
    await expect(client.load('kana')).resolves.toMatchObject({entries:[]})
  })
  it('rejects missing dictionary entries before presenting a complete vocabulary', async () => {
    const client = createReferenceClient(async path => path.endsWith('catalogue.json') ? {schemaVersion:1,files:[{path:'N5.json',count:2}],totalEntries:2} : {schemaVersion:1,entries:[word]})
    await expect(client.load('vocabulary')).rejects.toThrow()
  })
})

it('rejects out-of-range senses before caching and can read a corrected shard',async()=>{
  let broken=true, shardReads=0
  const client=createReferenceClient(async path=>path.endsWith('catalogue.json') ? {schemaVersion:1,files:[{path:'N5.json',count:1}],totalEntries:1} : (++shardReads,{schemaVersion:1,entries:[broken?{...word,bindings:[[0,0,[99]]]}:word]}))
  await expect(client.load('vocabulary')).rejects.toThrow()
  broken=false
  await expect(client.load('vocabulary')).resolves.toMatchObject({entries:[word]})
  expect(shardReads).toBe(2)
})
