import { describe, it, expect } from 'vitest'
import { aUnAccent, sansAccent, cheminSansAccent } from './sansAccent.js'

describe('sansAccent — retirer les accents, et RIEN d’autre', () => {
  it('retire les accents français les plus courants', () => {
    expect(sansAccent('29 Août 2026')).toBe('29 Aout 2026')
    expect(sansAccent('Réflexions sur le projet')).toBe('Reflexions sur le projet')
    expect(sansAccent('Activités')).toBe('Activites')
    expect(sansAccent('Héros Figure de modèle')).toBe('Heros Figure de modele')
    expect(sansAccent('Créateurs Intéressants')).toBe('Createurs Interessants')
    expect(sansAccent('Décembre 2025')).toBe('Decembre 2025')
    expect(sansAccent('Février')).toBe('Fevrier')
  })

  it('NE TOUCHE À RIEN D’AUTRE : ni casse, ni espaces, ni ponctuation, ni chiffres', () => {
    // C'est ce qui distingue cette fonction d'un slug. Un slug rendrait les noms méconnaissables.
    expect(sansAccent('IMG_5447.jpeg')).toBe('IMG_5447.jpeg')
    expect(sansAccent('Le Monde.fr - Actualités & Infos')).toBe('Le Monde.fr - Actualites & Infos')
    expect(sansAccent('a b   c')).toBe('a b   c')
  })

  it('NE TOUCHE PAS AU JAPONAIS : casser un nom japonais serait la faute même qu’on évite', () => {
    expect(sansAccent('日本語')).toBe('日本語')
    expect(sansAccent('ひらがな カタカナ')).toBe('ひらがな カタカナ')
    expect(sansAccent('東京 2026 été')).toBe('東京 2026 ete')
  })

  it('traite les deux formes Unicode : macOS écrit décomposé, GitHub rend composé', () => {
    const compose = 'Août'                       // « û » en un seul point de code
    const decompose = 'Août'               // « u » + accent circonflexe combinant
    expect(compose).not.toBe(decompose)          // ce ne sont PAS la même chaîne d'octets
    expect(sansAccent(compose)).toBe('Aout')
    expect(sansAccent(decompose)).toBe('Aout')   // et pourtant elles rendent le même résultat
  })

  it('aUnAccent détecte dans les deux formes, et ne se trompe pas sur le reste', () => {
    expect(aUnAccent('Août')).toBe(true)
    expect(aUnAccent('Août')).toBe(true)
    expect(aUnAccent('Aout')).toBe(false)
    expect(aUnAccent('IMG_5447.jpeg')).toBe(false)
    expect(aUnAccent('日本語')).toBe(false)
    expect(aUnAccent('')).toBe(false)
    expect(aUnAccent(null)).toBe(false)
  })

  it('un chemin garde sa forme, seuls ses segments changent', () => {
    expect(cheminSansAccent('pages/Photos/DJI/29 Août 2026/IMG_5447.jpeg.img.json'))
      .toBe('pages/Photos/DJI/29 Aout 2026/IMG_5447.jpeg.img.json')
    expect(cheminSansAccent('pages/Été/Décembre/a.md')).toBe('pages/Ete/Decembre/a.md')
  })

  it('est idempotent : réappliquer ne change plus rien', () => {
    const une = sansAccent('Réflexions Août')
    expect(sansAccent(une)).toBe(une)
  })
})
