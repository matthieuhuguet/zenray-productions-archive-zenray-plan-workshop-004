    func mixedLabel(_ value: String, size: CGFloat, color: NSColor = .secondaryLabelColor) -> NSTextField {
        let baseFont = NSFont(name:settings.fontName,size:size) ?? NSFont.systemFont(ofSize:size)
        let numberFont = NSFont(name:settings.serifFontName,size:size) ?? baseFont
        let styled = NSMutableAttributedString(string:value,attributes:[.font:baseFont,.foregroundColor:color])
        if let pattern = try? NSRegularExpression(pattern:#"\d+(?:[.,:]\d+)*"#) {
            let range = NSRange(value.startIndex...,in:value)
            for match in pattern.matches(in:value,range:range) { styled.addAttribute(.font,value:numberFont,range:match.range) }
        }
        let field = NSTextField(labelWithAttributedString:styled)
        field.lineBreakMode = .byTruncatingTail; field.maximumNumberOfLines = 2
        field.setContentCompressionResistancePriority(.defaultLow,for:.horizontal)
        return field
    }
