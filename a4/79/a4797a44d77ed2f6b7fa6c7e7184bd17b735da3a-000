                if !errors.isEmpty {
                    var reasons: [String] = []
                    for error in errors {
                        let reason = errorLabel(error)
                        if reason != "Problème à vérifier" && !reasons.contains(reason) { reasons.append(reason) }
                    }
                    let visibleReasons = reasons.isEmpty ? ["Problème à vérifier"] : reasons
                    attention.append((project.name,visibleReasons))
                    issueTooltips.append("\(project.name) · \(visibleReasons.joined(separator:", "))")
                }
            }
            tooltipDiagnostics += issueTooltips
        }
        var statusParts: [String] = []
        if running.count > 1 { statusParts.append("\(running.count) opérations en cours") }
        if !queued.isEmpty { statusParts.append(queued.count == 1 ? "1 opération en attente" : "\(queued.count) opérations en attente") }
        if !attention.isEmpty { statusParts.append(attention.count == 1 ? "1 projet à vérifier" : "\(attention.count) projets à vérifier") }
        if let current = running.first {
            let action: String
            switch current.job.type ?? "" {
            case "archive": action = "Sauvegarde de"
            case "restore", "recover": action = "Chargement de"
            case "unload": action = "Libération de"
            default: action = "Opération sur"
            }
            let headline = "\(action) \(current.projectName)"
            visibleText += headline + "\n"
            panelStack.addArrangedSubview(statusLine(headline,color:.systemBlue,size:13))
            if !current.job.detail.isEmpty {
                let phase = phaseLabel(current.job.detail)
                visibleText += phase + "\n"
                panelStack.addArrangedSubview(mixedLabel(phase,size:11))
            }
            if !statusParts.isEmpty {
                let summary = statusParts.joined(separator:" · ")
                visibleText += summary + "\n"
                panelStack.addArrangedSubview(statusLine(summary,color:attention.isEmpty ? .systemOrange : .systemRed,size:11))
            }
        } else if !statusParts.isEmpty {
            let summary = statusParts.joined(separator:" · ")
            visibleText += summary + "\n"
            panelStack.addArrangedSubview(statusLine(summary,color:attention.isEmpty ? .systemOrange : .systemRed,size:13))
            if !attention.isEmpty {
                var issueCounts: [String:Int] = [:]
                for item in attention {
                    for reason in Set(item.reasons) { issueCounts[reason,default:0] += 1 }
                }
                let orderedIssues = issueCounts.sorted { left,right in left.value == right.value ? left.key.localizedStandardCompare(right.key) == .orderedAscending : left.value > right.value }
                let preview = orderedIssues.prefix(2).map { $0.value > 1 ? "\($0.key) (\($0.value))" : $0.key }
                let remainingIssues = orderedIssues.count - preview.count
                let others = remainingIssues == 1 ? " · 1 autre problème" : remainingIssues > 1 ? " · \(remainingIssues) autres problèmes" : ""
                let detail = preview.joined(separator:" · ") + others
                if !detail.isEmpty {
                    visibleText += detail + "\n"
                    panelStack.addArrangedSubview(mixedLabel(detail,size:11))
                }
            }
        } else if connected {
            visibleText += "Tout est à jour\n"
            panelStack.addArrangedSubview(mixedLabel("Tout est à jour",size:13,color:.labelColor))
        }
        if let value = snapshot {
            let counted = value.projects.compactMap(\.stats)
            let totalFiles = counted.reduce(0) { $0 + $1.fileCount }
            let summary = counted.count == value.projects.count
                ? "\(value.projects.count) projets · \(totalFiles) fichiers"
                : "\(value.projects.count) projets · \(totalFiles) fichiers comptés · \(value.projects.count - counted.count) inventaires en attente"
            visibleText += summary + "\n"
            panelStack.addArrangedSubview(mixedLabel(summary,size:14,color:.labelColor))
            let rates = value.transferRates ?? TransferRates(uploadBytesPerSecond:0,downloadBytesPerSecond:0)
            let transferSummary = "Upload ↑ \(formatRate(rates.uploadBytesPerSecond))    Download ↓ \(formatRate(rates.downloadBytesPerSecond))"
            visibleText += transferSummary + "\n"
            panelStack.addArrangedSubview(mixedLabel(transferSummary,size:11))
            let scope = NSSegmentedControl(labels:["Tout","Mac","Cloud"],trackingMode:.selectOne,target:self,action:#selector(changeScope(_:)))
            scope.selectedSegment = selectedScope; scope.segmentStyle = .rounded
            scope.widthAnchor.constraint(equalToConstant:CGFloat(settings.width - 32)).isActive = true
            panelStack.addArrangedSubview(scope)
            visibleText += "Vue : \(["Tout","Mac","Cloud"][selectedScope])\n"
            let visibleProjects = value.projects.filter { project in
                guard let stats = project.stats else { return selectedScope == 0 }
                if selectedScope == 1 { return stats.macFileCount > 0 || project.workspace == "loaded" }
                if selectedScope == 2 { return stats.cloudFileCount > 0 }
                return true
            }
            if !visibleProjects.contains(where: { $0.id == selectedProjectId }) { selectedProjectId = visibleProjects.first?.id }
            for project in visibleProjects {
                panelStack.addArrangedSubview(projectTile(project))
                visibleText += "Brique : \(project.name), Mac \(project.stats.map { String($0.macFileCount) } ?? "?"), Cloud \(project.stats.map { String($0.cloudFileCount) } ?? "?")\n"
            }
        }
        item.button?.toolTip = tooltipDiagnostics.joined(separator:"\n")
        panelStack.layoutSubtreeIfNeeded()
        let fittingHeight = ceil(panelStack.fittingSize.height)
        let visibleHeight = min(CGFloat(settings.height),max(CGFloat(settings.minimumHeight),fittingHeight))
        let documentHeight = max(visibleHeight,fittingHeight)
        panelStack.setFrameSize(NSSize(width:settings.width,height:documentHeight))
        // 8 October 2026, 14:39 CEST: resize the native content view so short states do not leave a blank panel.
        let popoverSize = NSSize(width:settings.width,height:visibleHeight)
        popover.contentSize = popoverSize
        if let contentView = popover.contentViewController?.view {
            contentView.setFrameSize(popoverSize)
            scroll.setFrameSize(contentView.bounds.size)
        }
        let clip = scroll.contentView
        clip.scroll(to:NSPoint(x:0,y:documentHeight - visibleHeight))
        scroll.reflectScrolledClipView(clip)
    }
    func receive(_ result: Result<Snapshot,Error>) {
        var connected = true
        var diagnostics: [String] = []
        switch result {
        case .success(let value): snapshot = value
        case .failure(let error): diagnostics.append(error.localizedDescription); connected = false
        }
        diagnostics += snapshot?.projects.flatMap { $0.errors + $0.jobs.compactMap { $0.error } } ?? []
        // 8 October 2026, 18:38 CEST: preserve the named menu control after each dashboard refresh.
        item.button?.title = "Assets"
        // 9 October 2026, 01:08 CEST: keep the compact symbol compact after each dashboard refresh.
        if item.button?.image != nil { item.button?.title = ""; item.length = 18 }
        rebuildPanel(connected:connected,diagnostics:diagnostics)
        let active = snapshot?.projects.contains { $0.jobs.contains { ["running","queued"].contains($0.state) } } ?? false
        if !proofWritten, let path = proofPath {
            if CommandLine.arguments.contains("--show"), !popover.isShown { schedule(active); return }
            let contentSize = popover.contentViewController?.view.frame.size ?? .zero
            let proofStats = snapshot?.projects.compactMap(\.stats) ?? []
            let proofFileCount = proofStats.reduce(0) { $0 + $1.fileCount }
            // 9 October 2026, 11:43 CEST: expose the rendered tile contrast to light and dark fixtures.
            let tileBackgroundLuminance = projectTileButtons.compactMap { button -> Double? in
                guard let background = button.layer?.backgroundColor,
                      let resolved = NSColor(cgColor:background)?.usingColorSpace(.deviceRGB),
                      let components = resolved.cgColor.components,
                      components.count >= 3 else { return nil }
                return Double(0.2126 * components[0] + 0.7152 * components[1] + 0.0722 * components[2])
            }
            let proof: [String:Any] = [
                "pid":ProcessInfo.processInfo.processIdentifier,
                "fontAvailable":fontAvailable,
                "fontName":interfaceFont?.fontName ?? "",
                "serifFontName":serifFont?.fontName ?? "",
                "appearance":NSApp.effectiveAppearance.name.rawValue,
                "contentAppearance":popover.contentViewController?.view.effectiveAppearance.name.rawValue ?? "",
                "tileAppearances":projectTileButtons.map { $0.effectiveAppearance.name.rawValue },
                "tileBackgroundLuminance":tileBackgroundLuminance,
                "statusItem":item.button != nil,
                "statusItemVisible":item.isVisible,
                "statusItemAutosaveName":item.autosaveName ?? "",
                "statusItemHasImage":item.button?.image != nil,
                "statusButtonLabel":item.button?.accessibilityLabel() ?? "",
                "statusButtonTitle":item.button?.title ?? "",
                "statusButtonWidth":item.button?.frame.width ?? 0,
                "statusItemLength":item.length,
                "statusButtonFrame":NSStringFromRect(item.button?.window?.frame ?? .zero),
                "popoverShown":popover.isShown,
                "popoverWindowVisible":popover.contentViewController?.view.window?.isVisible ?? false,
                "popoverWidth":popover.contentSize.width,
                "popoverHeight":popover.contentSize.height,
                "contentWidth":contentSize.width,
                "contentHeight":contentSize.height,
                "contentOpaque":popover.contentViewController?.view.isOpaque ?? false,
                "connected":connected,
                "checkedAt":snapshot?.checkedAt ?? "",
                "projectCount":snapshot?.projects.count ?? 0,
                "countedProjectCount":proofStats.count,
                "fileCount":proofFileCount,
                "transferRates":snapshot?.transferRates.map { ["uploadBytesPerSecond":$0.uploadBytesPerSecond,"downloadBytesPerSecond":$0.downloadBytesPerSecond] } ?? [:],
                "text":visibleText,
                "diagnostics":diagnostics,
                "tooltip":item.button?.toolTip ?? ""
            ]
            if let bytes = try? JSONSerialization.data(withJSONObject:proof,options:[.prettyPrinted,.sortedKeys]) { try? bytes.write(to:URL(fileURLWithPath:path),options:.atomic) }
        }
        if !proofWritten, let path = proofPath, (!CommandLine.arguments.contains("--show") || popover.isShown), let view = popover.contentViewController?.view, let bitmap = view.bitmapImageRepForCachingDisplay(in:view.bounds) {
            view.cacheDisplay(in:view.bounds,to:bitmap)
            if let png = bitmap.representation(using:.png,properties:[:]) { try? png.write(to:URL(fileURLWithPath:path + ".png")) }
        }
        if !CommandLine.arguments.contains("--show") || popover.isShown { proofWritten = true }
        // 9 October 2026, 01:10 CEST: let the live dashboard probe exit after its visible proof.
        if CommandLine.arguments.contains("--verify-live"), proofWritten { NSApp.terminate(nil); return }
        if CommandLine.arguments.contains(where: { $0.hasPrefix("--verify-fixture=") }) && (!CommandLine.arguments.contains("--show") || popover.isShown) { NSApp.terminate(nil); return }
        schedule(active)
    }
}
