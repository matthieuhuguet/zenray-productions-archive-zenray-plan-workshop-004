// 9 October 2026, 11:42 CEST: keep layer-backed tiles matched to the light or dark appearance.
final class AdaptiveLayerView: NSView {
    var fillColor: NSColor? { didSet { updateFillColor() } }
    var fillCornerRadius: CGFloat = 0 { didSet { layer?.cornerRadius = fillCornerRadius } }
    override func viewDidChangeEffectiveAppearance() {
        super.viewDidChangeEffectiveAppearance()
        updateFillColor()
    }
    private func updateFillColor() {
        guard let fillColor else { layer?.backgroundColor = nil; return }
        effectiveAppearance.performAsCurrentDrawingAppearance {
            layer?.backgroundColor = fillColor.cgColor
            layer?.cornerRadius = fillCornerRadius
