// 23 October 2026: stores the Anthropic API key for ZenRay Knowledge from the clipboard, checks it with one tiny Haiku call,
// writes it to a settings file only Matthieu can read, then empties the clipboard. The key never appears on screen.
// Usage: copy the key on platform.claude.com, then: node scripts/Knowledge/SetApiKey.mjs
// FR : range la clé API depuis le presse-papiers, la teste, l'écrit dans un fichier lisible par Matthieu seul, puis vide le presse-papiers.
import { execFile } from 'node:child_process'
import { promisify } from 'node:util'
import { mkdir, readFile, rename, writeFile } from 'node:fs/promises'
import path from 'node:path'
import Anthropic from '@anthropic-ai/sdk'
import { envFile } from './lib/Model.mjs'

const run = promisify(execFile)
const config = JSON.parse(await readFile(new URL('./KnowledgeConfig.json', import.meta.url), 'utf8'))
const fail = (message) => { console.error(message); process.exit(1) }

const key = (await run('pbpaste')).stdout.replace(/\s+/g, '')
if (!/^sk-ant-(api\d{2}|usr)-[A-Za-z0-9_-]{40,}$/.test(key)) fail('Aucune clé API dans le presse-papiers (elle commence par sk-ant-api). Copie-la sur platform.claude.com, puis relance. Rien n’a été écrit.')

try {
  const message = await new Anthropic({ apiKey: key }).messages.create({ model: config.extract.apiModel, max_tokens: 64, messages: [{ role: 'user', content: 'Reply with the single word OK.' }] })
  const text = message.content.filter((b) => b.type === 'text').map((b) => b.text).join('').trim()
  console.log(`Clé valide : ${config.extract.apiModel} répond « ${text.slice(0, 20)} ».`)
} catch (error) {
  fail(`La clé a été refusée (${error.status || ''} ${String(error.message).slice(0, 160)}). Rien n’a été écrit.`)
}

const file = envFile()
await mkdir(path.dirname(file), { recursive: true })
let others = ''
try { others = (await readFile(file, 'utf8')).split('\n').filter((l) => l.trim() && !/^\s*ANTHROPIC_API_KEY\s*=/.test(l)).join('\n') } catch {}
await writeFile(`${file}.tmp`, `${others ? `${others}\n` : ''}ANTHROPIC_API_KEY=${key}\n`, { mode: 0o600 })
await rename(`${file}.tmp`, file)
await run('osascript', ['-e', 'set the clipboard to ""']).catch(() => {})
console.log(`Rangée dans ${file} (lisible par toi seul), presse-papiers vidé. Le service la prend à sa prochaine lecture, sans redémarrage.`)
