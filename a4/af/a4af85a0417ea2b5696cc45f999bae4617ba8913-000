// ═══ PHOTOGRAPHIER L'APPLICATION RÉELLE, DONNÉES NEUTRALISÉES ════════════════════════════════════
//
// « Utiliser des assets recréés au pixel, pas des copies. Mais tu peux faire des copies pour aller plus
// vite, ne réécris pas le code, il faut juste le convertir en asset » (Matthieu, 2026-08-27).
//
// La contradiction apparente se lève en une phrase : on ne REDESSINE pas l'interface, on la
// PHOTOGRAPHIE, et l'on remplace son contenu juste avant le déclic. Le résultat est au pixel près par
// construction, puisque c'est la vraie application qui pose ses propres polices, ses ombres et ses
// espacements, et il ne montre rien de personnel puisque le texte a été remplacé.
//
// AUCUN CHEMIN NI AUCUNE ÉTAPE DANS CE FICHIER : tout ce qui varie d'une planche à l'autre vit dans
// `plan.json`. Ajouter une planche est une ligne de JSON, jamais une ligne de code. C'est la loi HDA
// appliquée à une campagne de captures : une définition, autant d'instances qu'on veut.
import { chromium } from 'playwright'
import { readFileSync, mkdirSync, writeFileSync } from 'node:fs'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'

const ICI = dirname(fileURLToPath(import.meta.url))
const PLAN = JSON.parse(readFileSync(join(ICI, 'plan.json'), 'utf8'))
const NEUTRALISEUR = readFileSync(join(ICI, 'neutraliser.js'), 'utf8')
const SORTIE = process.env.ZR_SORTIE || '/Users/zenray/Create/Share/tmp-zenray-progress-article-01/assets'

const seul = process.argv[2] || null
const brut = process.argv.includes('--brut')   // sans neutralisation, pour comparer et vérifier

mkdirSync(SORTIE, { recursive: true })

const navigateur = await chromium.launch()
const contexte = await navigateur.newContext({
  viewport: { width: PLAN.viewport.width, height: PLAN.viewport.height },
  deviceScaleFactor: PLAN.viewport.scale,
})
const page = await contexte.newPage()
const journal = []

// LA BARRE PORTE DEUX BOUTONS « CREATE », et c'est ce qui a fait rater les deux premières planches.
// L'un est l'EN-TÊTE de la section, l'autre l'item de NAVIGATION. Un `find` sur le texte tombait sur le
// premier, donc il REPLIAIT la section au lieu de naviguer, et la capture partait sur le tableau de bord
// sans qu'aucune erreur ne se lève. Le défaut était silencieux : la planche existait, elle montrait
// simplement autre chose. On vise donc la classe de l'item de nav, qui ne désigne qu'une seule chose.
const cliquerNav = async (libelle) => {
  const ok = await page.evaluate((l) => {
    const b = [...document.querySelectorAll('aside button.zr-navitem')].find((x) => (x.textContent || '').trim() === l)
    if (!b) return false
    b.click(); return true
  }, libelle)
  if (!ok) throw new Error(`item de nav « ${libelle} » introuvable`)
}

// LA PLANCHE DOIT PROUVER QU'ELLE MONTRE LA BONNE VUE. Sans ce contrôle, une navigation ratée rend une
// image parfaitement nette de l'écran précédent, et rien ne le dit.
const vueCourante = () => page.evaluate(() => localStorage.getItem('zr:view'))

for (const p of PLAN.planches) {
  if (seul && !p.id.includes(seul)) continue
  try {
    await page.goto(PLAN.base, { waitUntil: 'domcontentloaded' })
    await page.waitForTimeout(2200)
    await cliquerNav(p.nav)
    await page.waitForTimeout(p.pause || 2400)
    const vue = await vueCourante()
    if (p.vue && vue !== p.vue) throw new Error(`vue « ${vue} » au lieu de « ${p.vue} »`)
    if (p.js) { await page.evaluate(p.js); await page.waitForTimeout(p.apres || 900) }
    if (!brut) {
      await page.addScriptTag({ content: NEUTRALISEUR })
      await page.evaluate(() => window.__neutraliser())
      await page.waitForTimeout(220)
    }
    const fichier = join(SORTIE, `${p.id}${brut ? '-brut' : ''}.png`)
    await page.screenshot({ path: fichier })
    journal.push({ id: p.id, titre: p.titre, ok: true, fichier })
    console.log(`✓ ${p.id}  ${p.titre}`)
  } catch (e) {
    journal.push({ id: p.id, titre: p.titre, ok: false, erreur: String(e.message || e) })
    console.log(`× ${p.id}  ${String(e.message || e).slice(0, 80)}`)
  }
}

await navigateur.close()
// LE JOURNAL EST LE VÉRIFICATEUR. Une planche ratée doit se voir sans relire dix-huit images : le
// fichier dit lesquelles existent et lesquelles ont échoué, avec la cause.
writeFileSync(join(SORTIE, '_journal.json'), JSON.stringify(journal, null, 2))
const ko = journal.filter((j) => !j.ok)
console.log(`\n${journal.length - ko.length}/${journal.length} planches capturées`)
if (ko.length) { console.log('échecs :', ko.map((k) => k.id).join(', ')); process.exit(1) }
