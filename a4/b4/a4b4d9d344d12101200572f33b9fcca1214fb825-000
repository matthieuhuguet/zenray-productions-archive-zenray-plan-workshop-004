import { describe, expect, it } from 'vitest'
import { emptyComposition, addComponent, addImage, moveItem, removeItem, duplicateItem, countItems } from './composition.js'

const themeId = 'T-01-1-3'
const title = { id: '11-headline', name: 'Titre', group: 'Éditorial' }
const quote = { id: '22-pullquote', name: 'Citation', group: 'Article' }

describe('composition Lego', () => {
  it('pose au-dessus, dessous, à gauche et à droite sans limite fixe', () => {
    let value = addComponent(emptyComposition(themeId), title)
    const first = value.rows[0].items[0].id
    value = addComponent(value, quote, first, 'right')
    expect(value.rows).toHaveLength(1)
    expect(value.rows[0].items.map((item) => item.name)).toEqual(['Titre', 'Citation'])

    value = addComponent(value, title, first, 'above')
    value = addImage(value, { path: 'images/a.img.json', name: 'A', url: 'https://cdn/a' }, first, 'below')
    expect(value.rows).toHaveLength(3)
    expect(countItems(value)).toBe(4)
  })

  it('déplace puis retire une ligne devenue vide', () => {
    let value = addComponent(emptyComposition(themeId), title)
    const first = value.rows[0].items[0].id
    value = addComponent(value, quote, first, 'below')
    const second = value.rows[1].items[0].id
    value = moveItem(value, second, first, 'left')
    expect(value.rows).toHaveLength(1)
    expect(value.rows[0].items[0].id).toBe(second)
    expect(removeItem(value, first).rows[0].items[0].id).toBe(second)
  })

  it('duplique avec un identifiant stable et distinct', () => {
    let value = addComponent(emptyComposition(themeId), title)
    const first = value.rows[0].items[0].id
    value = duplicateItem(value, first)
    expect(countItems(value)).toBe(2)
    expect(value.rows[0].items[0].id).not.toBe(value.rows[1].items[0].id)
  })
})
