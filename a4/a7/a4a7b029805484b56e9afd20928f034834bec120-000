#!/usr/bin/env node
// ÉCHANTILLONNER UNE PALETTE DEPUIS UNE CAPTURE, AU LIEU DE LA DEVINER À L'ŒIL.
//
//   node scripts/echantillonner-palette.mjs <image.png>
//
// POURQUOI CE SCRIPT EXISTE
// -------------------------
// Le 2026-07-31, Matthieu a fourni une capture des sept couleurs d'étiquettes macOS et demandé de
// les reprendre exactement. Une estimation visuelle aurait donné sept valeurs plausibles et fausses,
// et rien dans le code n'aurait ensuite signalé l'écart : une couleur approximative ne casse aucun
// test, elle se contente d'être un peu à côté pour toujours.
//
// Il mesure aussi le DIAMÈTRE des pastilles et la HAUTEUR DE CAPITALE du texte à côté, parce que le
// rapport entre les deux est la vraie spécification. « La pastille fait la hauteur du texte » est
// une phrase ; « 20 px de pastille pour 20 px de capitale, soit un rapport de 1,00 » est une mesure
// qu'on peut reproduire dans le CSS.
//
// Aucune dépendance : lecture PNG déléguée à `sips` (macOS) puis à un décodeur brut par canvas
// serait fragile, donc on passe par Python et PIL, présents sur ce poste et vérifiés.

import { execFileSync } from 'node:child_process'
import { existsSync } from 'node:fs'

const image = process.argv[2]
if (!image || !existsSync(image)) {
  console.error('usage : node scripts/echantillonner-palette.mjs <image.png>')
  process.exit(1)
}

// Le travail pixel vit en Python : PIL fait en trois lignes ce qui demanderait un décodeur PNG ici.
const py = `
import sys
from PIL import Image
im = Image.open(sys.argv[1]).convert('RGB')
W, H = im.size
px = im.load()

fond = px[W - 2, H // 2]
def loin(c, seuil=28):
    return max(abs(c[i] - fond[i]) for i in range(3)) > seuil

# ── 1. LOCALISER LA COLONNE DES PASTILLES ───────────────────────────────────────────────────────
# Deux essais rates avant celui-ci, et la lecon tient en une phrase : on ne peut pas separer les
# pastilles du texte par la COULEUR, puisque le gris est desature comme le fond, ni par une largeur
# fixe, puisqu'un recadrage la change. On les separe par la GEOMETRIE. Les pastilles forment la
# premiere colonne d'objets, le texte la seconde ; il suffit donc de trouver le premier trou vertical
# franc dans les colonnes occupees, et de ne garder que ce qui est a sa gauche.
occupees = sorted({x for y in range(H) for x in range(W) if loin(px[x, y])})
if not occupees:
    print('IMAGE VIDE'); sys.exit(1)
fin_col1 = occupees[0]
for a, b in zip(occupees, occupees[1:]):
    if b - a > 4: break
    fin_col1 = b

# ── 2. DECOUPER EN BANDES ET ECHANTILLONNER AU CENTRE ───────────────────────────────────────────
lignes = {}
for y in range(H):
    xs = [x for x in range(occupees[0], fin_col1 + 1) if loin(px[x, y])]
    if xs: lignes[y] = xs

bandes, courante, prec = [], [], None
for y in sorted(lignes):
    if prec is not None and y - prec > 3:
        bandes.append(courante); courante = []
    courante.append(y); prec = y
if courante: bandes.append(courante)
bandes = [b for b in bandes if len(b) > 6]   # ecarte les artefacts d'un ou deux pixels

print('colonne des pastilles : x = %d a %d' % (occupees[0], fin_col1))
print('pastilles trouvees    : %d' % len(bandes))
print('')
diam = []
for b in bandes:
    ymid = b[len(b) // 2]
    xs = lignes[ymid]
    # Le CENTRE, jamais le bord : l'anticrenelage melange la pastille au fond sur deux pixels.
    c = px[(xs[0] + xs[-1]) // 2, ymid]
    d = xs[-1] - xs[0] + 1
    diam.append(d)
    print('  %s  rgb%-18s  diametre %d x %d' % ('#%02x%02x%02x' % c, str(c), d, len(b)))

# ── 3. LE RAPPORT AVEC LA FONTE ─────────────────────────────────────────────────────────────────
# On mesure l'etendue verticale du TEXTE sur la bande la plus haute, ascendantes et descendantes
# comprises : c'est ce que l'oeil compare a la pastille, pas la hauteur de capitale seule.
x0 = fin_col1 + 5
for i, b in enumerate(bandes[:2]):
    yt = [y for y in range(max(0, b[0] - 14), min(H, b[-1] + 14))
          if any(min(px[x, y]) > 140 for x in range(x0, W))]
    if yt:
        print('')
        print('  texte ligne %d : %d px de haut (y=%d a %d)' % (i + 1, yt[-1] - yt[0] + 1, yt[0], yt[-1]))
        print('  pastille      : %d px   ->  RAPPORT %.2f' % (diam[i], diam[i] / (yt[-1] - yt[0] + 1)))
`

const sortie = execFileSync('python3', ['-c', py, image], { encoding: 'utf8' })
console.log(sortie)
