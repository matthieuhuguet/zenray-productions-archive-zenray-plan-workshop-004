import { createContext, useContext } from 'react'

// Contexte UI du board ZenRay Ref : partage l'état du picker d'images entre le wrapper RefBoard
// (qui rend le panneau) et RefToolbar (montée DANS <Tldraw> via components.Toolbar — le contexte
// React traverse, aucun event global nécessaire pour ce toggle).
export const RefUiContext = createContext({ pickerOpen: false, setPickerOpen: () => {}, boardPath: null })
export const useRefUi = () => useContext(RefUiContext)
