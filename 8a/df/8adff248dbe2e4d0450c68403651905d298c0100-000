// gradient bleu Apple partagé (sidebar / sélecteur). Appliqué via stroke ou fill = url(#zrBlueGrad).
const BLUE_GRAD = '<defs><linearGradient id="zrBlueGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5AAEFF"/><stop offset="1" stop-color="#0A74F0"/></linearGradient></defs>'

// Liste des symboles disponibles (pour le picker d'icône de page — remplace les emoji).
export const SYMBOLS = ['doc.text', 'doc.richtext', 'folder', 'star', 'tag', 'checklist', 'book', 'briefcase', 'archivebox', 'person', 'house', 'music.note', 'film', 'photo', 'play.rectangle', 'tablecells', 'square.grid.2x2', 'gearshape', 'gear', 'magnifyingglass', 'externaldrive', 'trash', 'paperclip']
export const isSymbol = (n) => Object.prototype.hasOwnProperty.call(P, n)

export default function Icon({ name, size = 18, color = 'currentColor', weight = 1.7, grad = false, style }) {
  const def = P[name] || P['doc']
  const filled = def.fill
  const paint = grad ? 'url(#zrBlueGrad)' : color
  const fill = def.raw ? 'none' : (filled ? paint : 'none')
  const stroke = def.raw ? 'none' : (filled ? 'none' : paint)
  return (
    // color:paint (2026-07-05, bug réel) : certains glyphes (speaker.*) posent fill="currentColor" sur UN
    // sous-path précis (forme pleine mélangée à des traits). currentColor lit la propriété CSS `color`, PAS
    // l'attribut `fill` du <svg> — dans un <button>, la feuille de style par défaut du navigateur impose son
    // propre `color` (souvent noir), qui gagne sur l'héritage CSS venu d'un parent. Fixer `color` ICI, sur le
    // <svg> lui-même, rend currentColor fiable quel que soit le conteneur (bouton ou non).
    <svg width={size} height={size} viewBox={def.vb || '0 0 24 24'} fill={fill} stroke={stroke}
      strokeWidth={weight} strokeLinecap="round" strokeLinejoin="round" style={{ display: 'block', flexShrink: 0, color: paint, ...style }}
      dangerouslySetInnerHTML={{ __html: (grad ? BLUE_GRAD : '') + def.s }} />
  )
}
