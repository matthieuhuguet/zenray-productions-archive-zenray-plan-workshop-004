// Geometry shared by image thumbnails: preserve the source aspect ratio while
// fitting it inside the square slot reserved by the virtual Finder grid.
// Keeping the outer slot square is intentional: it avoids changing row heights,
// virtualization math, labels, selection, and marquee hit targets.
export function fitAspectWithinSquare(size, width, height) {
  const side = Math.max(1, Number(size) || 1)
  const w = Number(width)
  const h = Number(height)
  if (!(w > 0 && h > 0)) return { width: side, height: side }

  const ratio = w / h
  if (!Number.isFinite(ratio) || ratio <= 0) return { width: side, height: side }
  return ratio >= 1
    ? { width: side, height: Math.max(1, Math.round(side / ratio)) }
    : { width: Math.max(1, Math.round(side * ratio)), height: side }
}
