describe('the real remote: a local bare repository, blobless fetch, trees without blobs', () => {
  const git = (directory, args) => execFileSync('git', ['-C', directory, ...args], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).trim()
  function pushFilm(f) {
    const bare = path.join(temp('identity-bare'), 'remote.git')
    execFileSync('git', ['init', '-q', '--bare', '--initial-branch=main', bare])
    git(bare, ['config', 'uploadpack.allowFilter', 'true'])
    git(bare, ['config', 'uploadpack.allowAnySHA1InWant', 'true'])
    const work = temp('identity-work')
    git(work, ['init', '-q', '--initial-branch=main'])
    git(work, ['config', 'user.email', 'test@example.invalid']); git(work, ['config', 'user.name', 'test'])
    for (const [blobPath, bytes] of f.blobs) {
      fs.mkdirSync(path.dirname(path.join(work, blobPath)), { recursive: true })
      fs.writeFileSync(path.join(work, blobPath), bytes)
    }
    git(work, ['add', '-A']); git(work, ['commit', '-q', '-m', 'parts'])
    git(work, ['remote', 'add', 'origin', `file://${bare}`]); git(work, ['push', '-q', 'origin', 'main'])
    return { bare, commit: git(work, ['rev-parse', 'HEAD']) }
  }
  const repin = (f, commit) => {
    for (const part of f.manifest.parts) part.url = part.url.replace(f.commit, commit)
    f.commit = commit
    f.manifestBytes = Buffer.from(JSON.stringify(f.manifest))
    f.remoteManifest = f.manifestBytes
  }

  it('proves a film through real Git objects, downloading exactly one blob', async () => {
    const f = makeFilm({ commit: 'b'.repeat(40) })
    const { bare, commit } = pushFilm(f)
    repin(f, commit)
    const scratch = temp('identity-scratch')
    const remote = createGitRemote({ token: 'unused', config: config(), scratchParent: scratch, env: { ...process.env, GIT_TERMINAL_PROMPT: '0' },
      remoteUrlFor: () => `file://${bare}` })
    try {
      const readBlob = vi.spyOn(remote, 'readBlob')
      const result = await prove(f, { remote })
      expect(result.ok).toBe(true)
      expect(result.counters.remoteIdOk).toBe(3)
      expect(result.counters.partBlobIds).toEqual([...f.tree.values()])
      expect(readBlob).toHaveBeenCalledTimes(1)          // ONE real part
      // the cost claim: listing the tree downloaded NO blob except that one (the scratch repository holds exactly one)
      const [directory] = fs.readdirSync(scratch)
      const objects = git(path.join(scratch, directory), ['cat-file', '--batch-all-objects', '--batch-check=%(objecttype)']).split('\n')
      expect(objects.filter((type) => type === 'blob')).toHaveLength(1)
    } finally { await remote.close() }
    expect(fs.readdirSync(scratch)).toEqual([])        // scratch repositories are removed
  })

  it('is RED when the pushed bytes differ from what the source derives', async () => {
    const f = makeFilm({ commit: 'c'.repeat(40) })
    const blobPath = [...f.blobs.keys()][0]
    f.blobs.set(blobPath, flip(f.blobs.get(blobPath), 2))     // what reached GitHub is not the derived ciphertext
    const { bare, commit } = pushFilm(f)
    repin(f, commit)
    const remote = createGitRemote({ token: 'unused', config: config(), scratchParent: temp('identity-scratch'), env: { ...process.env, GIT_TERMINAL_PROMPT: '0' },
      remoteUrlFor: () => `file://${bare}` })
    try {
      const result = await prove(f, { remote })
      expect(result.ok).toBe(false)
      expect(result.failure).toMatchObject({ class: 'remote', code: 'remote-id-mismatch', partIndex: 0 })
    } finally { await remote.close() }
  })

  it('is RED (remote class) when the pinned commit does not exist', async () => {
    const f = makeFilm({ commit: 'd'.repeat(40) })
    const { bare } = pushFilm(f)
    const remote = createGitRemote({ token: 'unused', config: config({ gitAttempts: 1 }), scratchParent: temp('identity-scratch'),
      env: { ...process.env, GIT_TERMINAL_PROMPT: '0' }, remoteUrlFor: () => `file://${bare}` })
    try {
      const result = await prove(f, { remote })
      expect(result.ok).toBe(false)
      expect(result.failure).toMatchObject({ class: 'remote', code: 'remote-tree-unavailable' })
    } finally { await remote.close() }
  })

  it('finds the manifest path from Git and refuses a clone of another repository', () => {
    const clone = temp('identity-clone')
    git(clone, ['init', '-q'])
    git(clone, ['remote', 'add', 'origin', 'https://github.com/matthieuhuguet/zenray-data.git'])
    fs.mkdirSync(path.join(clone, 'pages', 'Movies'), { recursive: true })
    const manifest = path.join(clone, 'pages', 'Movies', 'Film.media.json')
    fs.writeFileSync(manifest, '{}')
    expect(locateManifestInClone(manifest, { config: config() })).toBe('pages/Movies/Film.media.json')
    git(clone, ['remote', 'set-url', 'origin', 'https://github.com/matthieuhuguet/another-repository.git'])
    expect(() => locateManifestInClone(manifest, { config: config() })).toThrow('zenray-data')
    expect(() => locateManifestInClone(path.join(temp('not-a-clone'), 'x.json'), { config: config() })).toThrow()
  })

  it('reads the manifest through the contents API (raw media type), retries a 503 and does not retry a 404', async () => {
    const answers = [{ ok: false, status: 503 }, { ok: true, status: 200, arrayBuffer: async () => Buffer.from('{"a":1}') }]
    const seen = []
    const fetchImpl = vi.fn(async (url, init) => { seen.push({ url, accept: init.headers.Accept }); return answers.shift() })
    const bytes = await readRemoteManifestBytes({ token: 'T', config: config(), repoPath: 'pages/Mo vies/é.media.json', fetchImpl, sleep: async () => {} })
    expect(bytes.toString()).toBe('{"a":1}')
    expect(seen).toHaveLength(2)
    expect(seen[0].url).toBe('https://api.github.com/repos/matthieuhuguet/zenray-data/contents/pages/Mo%20vies/%C3%A9.media.json?ref=main')
    expect(seen[0].accept).toBe('application/vnd.github.raw')
    const notFound = vi.fn(async () => ({ ok: false, status: 404 }))
    await expect(readRemoteManifestBytes({ token: 'T', config: config(), repoPath: 'x', fetchImpl: notFound, sleep: async () => {} })).rejects.toThrow('HTTP 404')
    expect(notFound).toHaveBeenCalledTimes(1)
  })
})
