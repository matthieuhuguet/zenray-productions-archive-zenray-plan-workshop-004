describe('index sources in a pass (7 October 2026)', () => {
  it('hands the readers the links already stored and his own index pages, and reports the best new finds for the notifier', async () => {
    const cloud = memoryCloud({ [config.cloud.storePath]: initialStore(), [config.cloud.searchesPath]: JSON.stringify({ v: 1, searches: [{ id: 's1', kind: 'link', label: 'Studio X', url: 'https://www.studio-x.com/careers' }] }) })
    cloud.sync = async () => {}
    let context = null
    const engine = createEngine({ config, cloud, gh: {}, http: {}, collect: async ({ context: c }) => { context = c; return [board([listing(1), listing(2)])] }, cvLoader: async () => cv(), now: () => new Date('2026-10-07T10:00:00Z') })
    const report = await engine.run({ trigger: 'test' })
    expect(context.known.has('https://lnkd.in/x')).toBe(true)
    expect(context.extraPages.map((p) => p.url)).toEqual(['https://www.studio-x.com/careers'])
    expect(typeof context.seen.has).toBe('function')
    expect(report.addedSummary.length).toBe(2)
    expect(report.addedSummary[0]).toMatchObject({ lane: 'games', source: 'A' })
    expect(report.addedSummary[0].score).toBeGreaterThanOrEqual(report.addedSummary[1].score)
    // the summary goes to the notifier, never into the published engine file
    expect(cloud.files.get(config.cloud.enginePath)).not.toContain('addedSummary')
  })
})
