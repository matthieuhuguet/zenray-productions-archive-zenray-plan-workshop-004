import { laneOf as laneOfStudio, kindOf as kindOfStudio, kindLabel as kindLabelOf } from './freelanceEngineModel.js'
describe('lanes', () => {
  it('games unless the engine says other; a tender has its own kind', () => {
    expect(laneOfStudio({ engine: { lane: 'other' } })).toBe('other')
    expect(laneOfStudio({ engine: {} })).toBe('games')
    expect(laneOfStudio({})).toBe('games')
    expect(kindOfStudio({ engine: { kind: 'tender' } })).toBe('tender')
    expect(kindLabelOf({ engine: { kind: 'tender' } })).toBe('Appel d’offres')
  })
})
