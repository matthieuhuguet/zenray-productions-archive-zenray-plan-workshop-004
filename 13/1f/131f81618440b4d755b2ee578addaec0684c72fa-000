// 4 October 2026: the page reads the engine's data the way the engine wrote it, and the letter archive only ever grows.
import { describe, expect, it } from 'vitest'
import {
  DEFAULT_FILTERS, acceptSuggestion, addUserVersion, copyBundle, countryOf, countryOptions, currentVersion, dismissSuggestion, engineStatusLine, isClosedStudio, isNewStudio, kindLabel, kindOf,
  mailtoUrl, matchesFilters, relativeTime, scoreOf, sortStudios, sourceOptions, sourceProblems, untilLabel,
} from './freelanceEngineModel.js'

const TODAY = '2026-10-04'
const studio = (id, engine, extra = {}) => ({ id, name: id, role: 'Technical Artist', status: 'to_contact', createdAt: '2026-09-30', messages: [], history: [], notes: '', ...(engine === undefined ? {} : { engine }), ...extra })

describe('kinds, closure and novelty', () => {
  it('names what a studio is', () => {
    expect(kindOf(studio('a'))).toBe('prospect')
    expect(kindOf(studio('a', { kind: 'offer' }))).toBe('offer')
    expect(kindOf(studio('a', { freelance: true }))).toBe('freelance')
    expect(kindOf(studio('a', { kind: 'internship' }))).toBe('internship')
    expect(kindOf(studio('a', { kind: 'offer' }, { role: 'Vivier de candidatures : X' }))).toBe('spontaneous')
    expect(kindLabel(studio('a', { kind: 'offer' }))).toBe('Offre')
  })
  it('treats a vacancy as closed once flagged or past its validity date', () => {
    expect(isClosedStudio(studio('a', { closedAt: '2026-10-03' }), TODAY)).toBe(true)
    expect(isClosedStudio(studio('a', { validThrough: '2026-10-03' }), TODAY)).toBe(true)
    expect(isClosedStudio(studio('a', { validThrough: '2026-10-04' }), TODAY)).toBe(false)
    expect(isClosedStudio(studio('a'), TODAY)).toBe(false)
  })
  it('calls a vacancy new for three days, never an earlier record, never a contacted one', () => {
    expect(isNewStudio(studio('a', { firstSeenAt: '2026-10-02' }), TODAY)).toBe(true)
    expect(isNewStudio(studio('a', { firstSeenAt: '2026-10-01' }), TODAY)).toBe(false)
    expect(isNewStudio(studio('a', { firstSeenAt: '2026-10-04', legacy: true }), TODAY)).toBe(false)
    expect(isNewStudio(studio('a', { firstSeenAt: '2026-10-04' }, { status: 'contacted' }), TODAY)).toBe(false)
  })
})

describe('filters and sorting', () => {
  const list = [
    studio('top', { tier: 'high', score: 90, sourceLabel: 'AFJV', kind: 'offer', firstSeenAt: '2026-10-04' }),
    studio('mid', { tier: 'medium', score: 50, sourceLabel: 'Epic Games', kind: 'offer', firstSeenAt: '2026-09-30' }),
    studio('low', { tier: 'low', score: 10, sourceLabel: 'AFJV', freelance: true, firstSeenAt: '2026-09-30' }),
    studio('gone', { tier: 'high', score: 95, sourceLabel: 'AFJV', closedAt: '2026-10-03', firstSeenAt: '2026-09-30' }),
    studio('crm'),
  ]
  const apply = (filters) => sortStudios(list.filter((s) => matchesFilters(s, { ...DEFAULT_FILTERS, ...filters }, TODAY)), filters.sort).map((s) => s.id)
  it('hides closed vacancies by default and sorts by score, unscored last', () => {
    expect(apply({})).toEqual(['top', 'mid', 'low', 'crm'])
    expect(apply({ showClosed: true })).toEqual(['gone', 'top', 'mid', 'low', 'crm'])
  })
  it('filters by tier, kind, source and novelty', () => {
    expect(apply({ tier: 'high' })).toEqual(['top'])
    expect(apply({ tier: 'medium' })).toEqual(['top', 'mid'])
    expect(apply({ kind: 'freelance' })).toEqual(['low'])
    expect(apply({ source: 'Epic Games' })).toEqual(['mid'])
    expect(apply({ onlyNew: true })).toEqual(['top'])
  })
  it('sorts by discovery date when asked', () => {
    expect(apply({ sort: 'recent' })[0]).toBe('top')
  })
  it('lists the sources present', () => { expect(sourceOptions(list)).toEqual(['AFJV', 'Epic Games']) })

  it('normalizes countries and detects priority countries', () => {
    expect(countryOf({ engine: { country: 'FR' }, city: 'Paris (75)' })).toMatchObject({ code: 'FR', label: 'France', priority: 1 })
    expect(countryOf({ engine: { country: 'JP' }, city: 'Tokyo' })).toMatchObject({ code: 'JP', label: 'Japon', priority: 2 })
    expect(countryOf({ engine: { country: 'GB' }, city: 'London' })).toMatchObject({ code: 'GB', label: 'Royaume-Uni', priority: 3 })
    expect(countryOf({ engine: { country: 'US' }, city: 'Santa Monica, CA' })).toMatchObject({ code: 'US', label: 'États-Unis', priority: 4 })
    expect(countryOf({ city: 'Argentina' })).toMatchObject({ code: 'AR', label: 'Argentine', priority: 30 })
    expect(countryOf({ city: 'Malaysia' })).toMatchObject({ code: 'MY', label: 'Malaisie', priority: 31 })
  })

  it('rewards France with higher priority score than distant regions', () => {
    const frenchStudio = { name: 'Studio FR', city: 'Lyon (69)', engine: { score: 68 } }
    const argStudio = { name: 'Studio AR', city: 'Argentina', engine: { score: 70 } }
    expect(scoreOf(frenchStudio)).toBeGreaterThan(scoreOf(argStudio))
  })

  it('lists only present countries partitioned into priority and others, never absent ones', () => {
    const sample = [
      { name: 'S1', city: 'Rennes (35)', engine: { country: 'FR' } },
      { name: 'S2', city: 'Tokyo', engine: { country: 'JP' } },
      { name: 'S3', city: 'Montreal', engine: { country: 'CA' } },
    ]
    const options = countryOptions(sample)
    expect(options.priorityCountries.map((c) => c.code)).toEqual(['FR', 'JP'])
    expect(options.otherCountries.map((c) => c.code)).toEqual(['CA'])
    // Absent countries like Burkina Faso or US are NEVER present
    expect(options.all.some((c) => c.code === 'BF')).toBe(false)
    expect(options.all.some((c) => c.code === 'US')).toBe(false)
  })

  it('filters vacancies by country', () => {
    const sample = [
      studio('fr_1', { score: 80 }, { city: 'Paris (75)' }),
      studio('us_1', { score: 85 }, { city: 'Los Angeles, US' }),
    ]
    const frOnly = sample.filter((s) => matchesFilters(s, { ...DEFAULT_FILTERS, country: 'FR' }, TODAY))
    expect(frOnly.map((s) => s.id)).toEqual(['fr_1'])
    const usOnly = sample.filter((s) => matchesFilters(s, { ...DEFAULT_FILTERS, country: 'US' }, TODAY))
    expect(usOnly.map((s) => s.id)).toEqual(['us_1'])
  })
})

describe('time labels and links', () => {
  const now = new Date('2026-10-04T12:00:00Z')
  it('says things coarsely in French', () => {
    expect(relativeTime('2026-10-04T11:59:40Z', now)).toBe('à l’instant')
    expect(relativeTime('2026-10-04T11:30:00Z', now)).toBe('il y a 30 min')
    expect(relativeTime('2026-10-04T08:00:00Z', now)).toBe('il y a 4 h')
    expect(relativeTime('2026-10-03T08:00:00Z', now)).toBe('hier')
    expect(relativeTime('', now)).toBe('jamais')
    expect(untilLabel('2026-10-04T18:00:00Z', now)).toBe('dans 6 h')
    expect(untilLabel('2026-10-04T11:00:00Z', now)).toBe('dès que le Mac est disponible')
  })
  it('builds a mail link only when an address is known, and caps the body', () => {
    expect(mailtoUrl({ to: '', subject: 's', body: 'b' })).toBe('')
    const link = mailtoUrl({ to: 'jobs@studio.fr', subject: 'Candidature : A', body: 'Bonjour\nà vous' })
    expect(link.startsWith('mailto:jobs@studio.fr?subject=Candidature%20%3A%20A&body=')).toBe(true)
    expect(decodeURIComponent(link.split('body=')[1])).toBe('Bonjour\nà vous')
    expect(decodeURIComponent(mailtoUrl({ to: 'a@b.c', body: 'x'.repeat(3000) }).split('body=')[1]).length).toBe(1801)
  })
  it('writes the status sentence and finds the sources that need a look', () => {
    const engine = { lastRun: { finishedAt: '2026-10-04T08:00:00Z', added: 3 }, nextRunDue: '2026-10-04T14:00:00Z', sources: [{ key: 'a', complete: true, errors: [] }, { key: 'b', complete: false, partial: false, errors: ['404'] }, { key: 'c', complete: false, partial: true, errors: [] }] }
    expect(engineStatusLine({ engine, service: null, now })).toBe('dernière recherche il y a 4 h · 3 nouvelles annonces · prochaine dans 2 h (16 h)')
    expect(engineStatusLine({ engine, service: { running: { stage: 'collecte' } }, now })).toBe('recherche en cours : collecte')
    expect(sourceProblems(engine).map((s) => s.key)).toEqual(['b'])
  })
})

describe('letter archive', () => {
  const archive = { v: 1, studioId: 's', versions: [{ at: 'a', by: 'engine', subject: 'Objet', text: 'Auto', lang: 'fr', kind: 'offer' }], suggested: { at: 'b', by: 'engine', subject: 'Objet', text: 'Nouvelle auto', lang: 'fr' } }
  it('appends his edit as a new version and never mutates', () => {
    const frozen = JSON.stringify(archive)
    const next = addUserVersion(archive, { text: 'Ma version', subject: 'Objet', at: 'c' })
    expect(next.versions.map((v) => v.by)).toEqual(['engine', 'matthieu'])
    expect(currentVersion(next).text).toBe('Ma version')
    expect(JSON.stringify(archive)).toBe(frozen)
    expect(addUserVersion(next, { text: 'Ma version', subject: 'Objet', at: 'd' })).toBe(next)
    expect(addUserVersion(archive, { text: '   ', at: 'e' })).toBe(archive)
  })
  it('accepts or dismisses the waiting suggestion', () => {
    const accepted = acceptSuggestion(archive, 'z')
    expect(accepted.suggested).toBeUndefined()
    expect(currentVersion(accepted)).toMatchObject({ text: 'Nouvelle auto', reason: 'accepted-suggestion', at: 'z' })
    expect(dismissSuggestion(archive).suggested).toBeUndefined()
    expect(acceptSuggestion({ versions: [] }, 'z')).toEqual({ versions: [] })
  })
  it('copies subject and letter together', () => { expect(copyBundle({ subject: 'S', text: 'T' })).toBe('Objet : S\n\nT') })
})

