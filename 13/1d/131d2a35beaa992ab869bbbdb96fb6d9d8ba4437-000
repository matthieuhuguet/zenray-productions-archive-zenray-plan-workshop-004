// 3 October 2026, 12:34 : Overview: counters, what waits for you (handoff targets), what needs attention, the queue and the system state.
import React, { useState } from 'react'
import { POSTKIT } from './postkitConfig.js'
import { useAction } from './usePostKit.js'
import { Badge, Btn, Card, Empty, ErrorLine, PlatformDot, StatusBadge, Tile, Verification, ago, when } from './ui.jsx'

// A handoff target is finished by a person: show the package, then record the URL of the published result. (3 October 2026)
export function HandoffCard({ post, target, client, onDone }) {
  const [url, setUrl] = useState('')
  const act = useAction(onDone)
  const h = target.handoff || {}
  return (
    <div className="zr-pk-handoff">
      <div className="zr-pk-row"><PlatformDot platform={target.platform} /><strong>{h.title || post.title || post.content}</strong><Badge tone="warn">waiting for you</Badge></div>
      {h.kind === 'artstation' && <p className="zr-pk-meta">{(h.tags || []).map((x) => `#${x}`).join(' ')} · {(h.software || []).join(', ')} · {(h.images || []).length} image(s) prepared</p>}
      {h.kind === 'website' && <p className="zr-pk-meta">Branch <code>{h.branch}</code> staged · will live at <code>{h.liveUrl}</code></p>}
      <ol className="zr-pk-steps">{(h.steps || []).map((s, i) => <li key={i}>{s}</li>)}</ol>
      {h.openUrl && <a className="zr-pk-link" href={h.openUrl} target="_blank" rel="noreferrer">Open {target.platform}</a>}
      <div className="zr-pk-inline">
        <input value={url} onChange={(e) => setUrl(e.target.value)} placeholder="URL of the published result" aria-label="Published URL" />
        <Btn tone="primary" busy={act.busy} disabled={!url} onClick={() => act.run(() => client.post(`/v1/posts/${post.id}/targets/${target.accountId}/complete`, { platformPostUrl: url }))}>Mark as published</Btn>
      </div>
      <ErrorLine error={act.error} />
    </div>
  )
}

function PostLine({ post, extra }) {
  return (
    <li className="zr-pk-li">
      <div className="zr-pk-row"><StatusBadge status={post.status} /><span className="zr-pk-excerpt">{post.title || post.content || '(no text)'}</span><span className="zr-pk-when">{post.scheduledFor ? when(post.scheduledFor) : post.publishedAt ? ago(post.publishedAt) : ''}</span></div>
      <div className="zr-pk-chips">{post.targets.map((t) => <span key={t.accountId} className="zr-pk-chip"><PlatformDot platform={t.platform} /><StatusBadge status={t.status} />{t.platformPostUrl && <a className="zr-pk-link" href={t.platformPostUrl} target="_blank" rel="noreferrer">open</a>}{t.error && <span className="zr-pk-bad" title={t.error}>{t.error.slice(0, 70)}</span>}</span>)}</div>
      {extra}
    </li>
  )
}

export default function OverviewPanel({ client, overview, reload, goTo }) {
  const d = overview.data
  const c = d.counts
  const retry = useAction(reload)
  const attention = (c.posts.failed || 0) + (c.posts.partial || 0)
  const waiting = d.queue.awaitingManual.length
  const tick = d.system.scheduler
  const byLevel = d.platforms.reduce((m, p) => ({ ...m, [p.verification]: (m[p.verification] || 0) + 1 }), {})
  return (
    <>
      <div className="zr-pk-tiles">
        <Tile label="Connected accounts" value={c.accounts.connected} sub={c.accounts.needsReconnection ? `${c.accounts.needsReconnection} need reconnecting` : c.accounts.expiringSoon ? `${c.accounts.expiringSoon} token(s) expire soon` : 'all healthy'} tone={c.accounts.needsReconnection ? 'warn' : undefined} />
        <Tile label="Scheduled" value={c.posts.scheduled || 0} sub={`${c.posts.draft || 0} draft`} />
        <Tile label="Waiting for you" value={waiting} sub="manual last step" tone={waiting ? 'warn' : undefined} />
        <Tile label="Needs attention" value={attention} sub="failed or partial" tone={attention ? 'bad' : undefined} />
        <Tile label="Comments to answer" value={c.pendingEngagement} />
        <Tile label="Unread DMs" value={c.unreadConversations} />
        <Tile label="Webhooks failing" value={c.webhooks.failedDeliveries} sub={`${c.webhooks.pendingDeliveries} pending`} tone={c.webhooks.failedDeliveries ? 'bad' : undefined} />
        <Tile label="Metered spend" value={`$${d.usage.total_usd}`} sub={`cap $${d.usage.cap_usd} this month`} />
      </div>

      {waiting > 0 && (
        <Card title="Waiting for your step" aside={<Badge tone="warn">{waiting}</Badge>}>
          {d.queue.awaitingManual.flatMap((p) => p.targets.filter((t) => t.status === 'awaiting_manual').map((t) => <HandoffCard key={`${p.id}${t.accountId}`} post={p} target={t} client={client} onDone={reload} />))}
        </Card>
      )}

      <div className="zr-pk-grid2">
        <Card title="Needs attention" aside={attention ? <Badge tone="bad">{attention}</Badge> : null}>
          {d.queue.attention.length === 0 ? <Empty>Nothing failed. Good.</Empty> : <ul className="zr-pk-list">{d.queue.attention.map((p) => <PostLine key={p.id} post={p} extra={<Btn busy={retry.busy} onClick={() => retry.run(() => client.post(`/v1/posts/${p.id}/publish`))}>Retry failed targets</Btn>} />)}</ul>}
          <ErrorLine error={retry.error} />
        </Card>
        <Card title="Next scheduled" aside={<Btn onClick={() => goTo('posts')}>Compose</Btn>}>
          {d.queue.scheduled.length === 0 ? <Empty>No post is scheduled.</Empty> : <ul className="zr-pk-list">{d.queue.scheduled.map((p) => <PostLine key={p.id} post={p} />)}</ul>}
        </Card>
      </div>

      <div className="zr-pk-grid2">
        <Card title="Recently published">
          {d.recent.length === 0 ? <Empty>Nothing published yet.</Empty> : <ul className="zr-pk-list">{d.recent.map((p) => <PostLine key={p.id} post={p} />)}</ul>}
        </Card>
        <Card title="System">
          <dl className="zr-pk-dl">
            <dt>Scheduler</dt><dd>{tick.running ? 'running' : 'not running'}{tick.lastTickAt ? `, last tick ${ago(tick.lastTickAt)}` : ''} (every {Math.round(tick.tickMs / 1000)} s)</dd>
            <dt>Tracked posts</dt><dd>{c.trackedPosts}</dd>
            <dt>Automations</dt><dd>{c.automations.active} active · {c.sequences.active} sequences · {c.broadcasts.sending} broadcast(s) running</dd>
            <dt>API keys</dt><dd>{c.apiKeys.active} active</dd>
            <dt>Connectors</dt><dd className="zr-pk-chips">{Object.entries(byLevel).map(([lvl, n]) => <span key={lvl} className="zr-pk-chip"><Verification level={lvl} /> ×{n}</span>)}</dd>
          </dl>
          <p className="zr-pk-meta">No connector is Live until a real account has been connected: Mock means the code follows the official documentation but no live call has happened.</p>
        </Card>
      </div>
    </>
  )
}
