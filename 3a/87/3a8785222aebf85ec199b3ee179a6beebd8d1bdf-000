// WHICH IMAGES STAND FOR A GALLERY IN ITS SHARE PREVIEW (2 October 2026). One definition, used by the Worker (dynamic
// composition), the offline builder script and the in-app builder, so the three can never disagree.
//
// `spread` = evenly spaced over the sorted list: a 119-photo gallery shows four different moments instead of the first four
// shots of the same minute. `first` = the first ones. Deterministic either way.
export const COVER_PICK = 'spread'
export function pickCandidates(names, count, mode = COVER_PICK) {
  const list = [...names]
  if (list.length <= count) return list
  if (mode === 'first') return list.slice(0, count)
  const out = []
  for (let i = 0; i < count; i++) out.push(list[Math.min(list.length - 1, Math.floor((i * list.length) / count + list.length / (2 * count)))])
  return [...new Set(out)]
}
