// 4 October 2026: "Rechercher maintenant" and the sentence that says what the engine did last and when it runs next.
// The automatic search runs every six hours on the Mac; this bar only asks the local service to run now and follows its progress.
// FR : « Rechercher maintenant » et la phrase qui dit ce que le moteur a fait et quand il repasse. La recherche automatique tourne
// toutes les six heures sur le Mac ; cette barre demande seulement une passe immediate et suit son avancement.
import React, { useCallback, useEffect, useRef, useState } from 'react'
import { notify } from '../Notifications.jsx'
import { engineStatusLine, relativeTime, untilLabel } from '../../lib/freelanceEngineModel.js'
import { Button, P } from './ui.jsx'

const POLL_MS = 2000
const IDLE_CHECK_MS = 60000

export default function FreelanceEngineBar({ t, engine, bridge, onFinished, sourcesOpen, onToggleSources, problems = 0 }) {
  const [service, setService] = useState(null)
  const [offline, setOffline] = useState(false)
  const [asking, setAsking] = useState(false)
  const wasRunning = useRef(false)
  const alive = useRef(true)
  const timer = useRef(null)
  const schedule = useRef(() => {})

  const refresh = useCallback(async () => {
    try {
      const status = await bridge.status()
      if (!alive.current) return null
      setService(status); setOffline(false)
      if (wasRunning.current && !status.running) {
        const report = status.lastReport
        notify(status.lastOk
          ? { title: 'Recherche terminée', body: report ? `${report.added} nouvelle${report.added > 1 ? 's' : ''} annonce${report.added > 1 ? 's' : ''}, ${report.letters} lettre${report.letters > 1 ? 's' : ''} préparée${report.letters > 1 ? 's' : ''}.` : 'Les offres sont à jour.' }
          : { title: 'Recherche interrompue', body: status.lastError || 'Une source a échoué, le détail est dans Sources.' })
        onFinished && onFinished()
      }
      wasRunning.current = Boolean(status.running)
      return status
    } catch (error) {
      if (alive.current) { setOffline(true); setService(null) }
      return null
    }
  }, [bridge, onFinished])

  useEffect(() => {
    alive.current = true
    const loop = async () => {
      const status = await refresh()
      if (!alive.current) return
      schedule.current(status && status.running ? POLL_MS : IDLE_CHECK_MS)
    }
    schedule.current = (delay) => { clearTimeout(timer.current); timer.current = setTimeout(loop, delay) }
    loop()
    return () => { alive.current = false; clearTimeout(timer.current) }
  }, [refresh])

  const run = async () => {
    setAsking(true)
    try {
      const answer = await bridge.run()
      if (!answer.started && answer.reason !== 'already-running') notify({ title: 'Recherche non lancée', body: 'Le service est occupé, réessaie dans un instant.' })
      wasRunning.current = true
      setService(answer)
      schedule.current(POLL_MS)
    } catch (error) {
      setOffline(true); notify({ title: 'Service local indisponible', body: 'La recherche automatique tourne quand le Mac est allumé et que le service ZenRay Freelance est lancé.' })
    } finally { setAsking(false) }
  }

  const running = Boolean(service && service.running)
  const line = engineStatusLine({ engine, service })
  return (
    <div style={{ margin: '4px 0 20px' }}>
      <div style={{ display: 'flex', alignItems: 'center', gap: 12, flexWrap: 'wrap' }}>
        <Button t={t} primary onClick={run} disabled={running || asking || offline} title={offline ? 'Service local injoignable' : 'Parcourt toutes les sources maintenant'}>
          {running ? `Recherche en cours : ${service.running.stage}…` : 'Rechercher maintenant'}
        </Button>
        <span role="status" style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>{line}</span>
        <span
          title="matth.huguet@gmail.com scanné toutes les 6 heures pour les réponses studios (accusés automatiques d'enregistrement filtrés)"
          style={{
            display: 'inline-flex',
            alignItems: 'center',
            gap: 5,
            padding: '3px 8px',
            borderRadius: 6,
            background: 'rgba(255, 255, 255, 0.04)',
            border: `1px solid ${t.border}`,
            fontFamily: P.sans,
            fontSize: 12,
            color: t.textSecondary,
          }}
        >
          <span>✉</span>
          <span>matth.huguet@gmail.com</span>
          <span style={{ opacity: 0.6 }}>· 6 h</span>
          <span style={{ color: '#30D158', fontSize: 11 }}>accusés filtrés</span>
        </span>
        <span style={{ flex: 1 }} />
        <button type="button" onClick={onToggleSources} aria-expanded={sourcesOpen}
          style={{ background: 'none', border: 'none', cursor: 'pointer', color: problems ? '#eb584f' : t.textSecondary, fontFamily: P.sans, fontSize: 12.5 }}>
          Sources et CV {problems ? `· ${problems} à vérifier` : ''} {sourcesOpen ? '▾' : '▸'}
        </button>
      </div>
      {offline && (
        <p role="alert" style={{ margin: '10px 0 0', fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, lineHeight: 1.5 }}>
          Le service local ne répond pas : la recherche automatique ne tourne que Mac allumé.
          {engine && engine.lastRun ? ` La dernière passe date de ${relativeTime(engine.lastRun.finishedAt)}.` : ''}
        </p>
      )}
      {service && service.lastOk === false && !running && (
        <p role="alert" style={{ margin: '10px 0 0', fontFamily: P.sans, fontSize: 12.5, color: '#eb584f', lineHeight: 1.5 }}>
          La dernière recherche a échoué : {service.lastError}. Nouvel essai automatique {untilLabel(service.nextRunDue) || 'bientôt'}.
        </p>
      )}
    </div>
  )
}
