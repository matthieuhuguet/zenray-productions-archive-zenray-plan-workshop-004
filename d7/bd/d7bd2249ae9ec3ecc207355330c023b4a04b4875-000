// 2026-09-23 20:25 : the view renders the verified journal and its day.
import { describe, it, expect, vi } from 'vitest'
import { render, screen, waitFor } from '@testing-library/react'
import ProgressView from './ProgressView.jsx'
import { sha256Hex } from './journalSource.js'

describe('ProgressView', () => {
  it('shows the entries of the last day with the verified hash', async () => {
    const now = new Date()
    const p = (n) => String(n).padStart(2, '0')
    const stamp = `${now.getFullYear()}-${p(now.getMonth() + 1)}-${p(now.getDate())} 09:05 +02:00`
    const text = `# PROGRESS\n\n${stamp}\n- Agent : Claude\n- Projet : ZenRayProgress\n- Fait : Vue Progress en ligne.\n- Vérifié : tests verts\n`
    const bytes = new TextEncoder().encode(text)
    const sha = await sha256Hex(bytes)
    vi.stubGlobal('fetch', vi.fn(async (url) => {
      if (String(url).startsWith('http://127.0.0.1')) throw new Error('no relay')
      if (String(url).includes('meta=1')) return new Response(JSON.stringify({ commit: 'c1', size: bytes.length, sha256: sha }), { status: 200 })
      return new Response(bytes, { status: 200, headers: { 'X-Journal-Size': String(bytes.length), 'X-Journal-Sha256': sha, 'X-Journal-Commit': 'c1', 'X-Journal-From': '0' } })
    }))
    render(<ProgressView t={{}} />)
    await waitFor(() => expect(screen.getByText('Vue Progress en ligne.')).toBeTruthy())
    expect(screen.getAllByText(/ZenRay Progress/).length).toBeGreaterThan(0)
    expect(screen.getByText(/✓/)).toBeTruthy()
    vi.unstubAllGlobals()
  })

  it('shows fresh uploads with measured progress and hides stale work', async () => {
    const fresh = new Date().toISOString()
    const stale = new Date(Date.now() - 25 * 60 * 60 * 1000).toISOString()
    const text = '# PROGRESS\n'
    const bytes = new TextEncoder().encode(text)
    const sha = await sha256Hex(bytes)
    vi.stubGlobal('fetch', vi.fn(async (url) => {
      if (String(url).endsWith('/activity')) return new Response(JSON.stringify({
        active: [
          { id: 'movie-upload', title: 'Film en cours', phase: 'uploading', completedBytes: 50, totalBytes: 100, currentItem: '/Movies/Film.mkv', updatedAt: fresh },
          { id: 'old-push', title: 'Ancien envoi', phase: 'pushing', completedUnits: 1, totalUnits: 2, updatedAt: stale },
          { id: 'unknown-progress', title: 'Copie en cours', phase: 'copying', currentItem: 'Scene.exr', updatedAt: fresh },
        ],
        recentFiles: [
          { name: '/Movies/Film.mkv', updatedAt: fresh },
          { name: '/Movies/Old.mkv', updatedAt: stale },
        ],
      }), { status: 200 })
      if (String(url).startsWith('http://127.0.0.1')) throw new Error('no relay')
      if (String(url).includes('meta=1')) return new Response(JSON.stringify({ commit: 'c1', size: bytes.length, sha256: sha }), { status: 200 })
      return new Response(bytes, { status: 200, headers: { 'X-Journal-Size': String(bytes.length), 'X-Journal-Sha256': sha, 'X-Journal-Commit': 'c1', 'X-Journal-From': '0' } })
    }))
    render(<ProgressView t={{}} />)
    await waitFor(() => expect(screen.getByText('Film en cours')).toBeTruthy())
    expect(screen.getByRole('progressbar', { name: 'Progression : Film en cours' }).getAttribute('aria-valuenow')).toBe('50')
    expect(screen.getByRole('progressbar', { name: 'Progression : Copie en cours' }).hasAttribute('aria-valuenow')).toBe(false)
    expect(screen.queryByText('Ancien envoi')).toBeNull()
    expect(screen.getAllByText('Film.mkv').length).toBe(2)
    expect(screen.queryByText('Old.mkv')).toBeNull()
    vi.unstubAllGlobals()
  })
})
