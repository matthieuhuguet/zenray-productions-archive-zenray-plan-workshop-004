// ZenRayMedia — taxonomie du catalogue (docs/zenraymedia/05-THEMES-1024-A..D.md).
// Sert à résoudre un identifiant `T-FF-S-V` en libellés lisibles SANS charger le thème :
// c'est ce qui permet d'afficher 1024 entrées dans le Deck à coût nul.

export const FAMILIES = {
  '01': 'Presse & éditorial',
  '02': 'Télévision & broadcast',
  '03': 'Cinéma & trailer',
  '04': 'Jeu vidéo',
  '05': 'Publicité & retail',
  '06': 'Luxe & mode',
  '07': 'Social vertical',
  '08': 'Créateur & YouTube',
  '09': 'Musique & sound',
  '10': 'Tech & produit',
  '11': 'Corporate & institution',
  '12': 'Science & pédagogie',
  '13': 'Sport & compétition',
  '14': 'Événement & affiche',
  '15': 'Architecture, design & art',
  '16': 'Japon & Asie',
}

// Registre dominant par famille — pilote la suggestion de thèmes depuis le brief (ZM-L2-11).
export const FAMILY_REGISTER = {
  '01': 'presse', '02': 'presse', '03': 'divertissement', '04': 'divertissement',
  '05': 'promotionnel', '06': 'luxe', '07': 'créateur', '08': 'créateur',
  '09': 'divertissement', '10': 'technique', '11': 'institutionnel', '12': 'pédagogique',
  '13': 'divertissement', '14': 'promotionnel', '15': 'luxe', '16': 'divertissement',
}

export const THEME_ID_RE = /^T-(\d{2})-([1-8])-([1-8])$/

export function parseThemeId(id) {
  const m = THEME_ID_RE.exec(String(id || ''))
  if (!m) return null
  return { id, family: m[1], sub: Number(m[2]), variant: Number(m[3]), familyLabel: FAMILIES[m[1]] || 'Famille inconnue' }
}

export function isThemeId(id) { return THEME_ID_RE.test(String(id || '')) }

// `T-01-3-2--lecture-pure` -> { id, slug: 'lecture-pure', name: 'Lecture pure' }
export function parseThemeFileName(fileName) {
  const base = String(fileName).replace(/^.*\//, '').replace(/\.(html|theme\.js)$/i, '')
  const [rawId, ...rest] = base.split('--')
  const parsed = parseThemeId(rawId)
  if (!parsed) return null
  const slug = rest.join('--')
  const name = slug ? slug.replace(/[-_]+/g, ' ').replace(/^./, (c) => c.toUpperCase()) : `Thème ${rawId}`
  return { ...parsed, slug, name }
}
