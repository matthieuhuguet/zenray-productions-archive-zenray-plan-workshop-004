// Réunit les fichiers hébergés dans Create/Books (pages/Books/) et le catalogue /shelf/books.json (213 livres).
// Uniquement AnthropicSerif Medium (500) et InterVariable Medium (500), zéro Light.

import React, { useEffect, useMemo, useRef, useState } from 'react'
import { captureFiles } from '../capture/universalCapture.js'
import { notify } from '../components/Notifications.jsx'
import { downloadUrls, effectiveManifest } from '../lib/archiveChunks.js'
import { streamDownload } from '../lib/fetchAsset.js'
