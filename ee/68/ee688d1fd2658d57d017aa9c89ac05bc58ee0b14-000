    author: 'Sayaka Murata',
    cloudPath: 'pages/Books/Convenience Store Woman - Sayaka Murata.pdf.file.json',
    textJson: '/books/convenience-store-woman.json',
    totalPages: 103,
    coverColor: '#263E33',
    defaultStatus: 'in_progress',
    defaultScore: 92,
  },
  {
    id: 'japanese-society',
    name: 'An Introduction to Japanese Society (5th Edition)',
    author: 'Yoshio Sugimoto',
    cloudPath: 'pages/Books/An Introduction to Japanese Society (5th Edition) - Yoshio Sugimoto.pdf.file.json',
    textJson: '/books/japanese-society.json',
    totalPages: 352,
    coverColor: '#4E2825',
    defaultStatus: 'in_progress',
