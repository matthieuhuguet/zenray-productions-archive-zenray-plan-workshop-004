import { urlLectureAffichage } from '../lib/urlLecture.js'
import './books.css'

const LS_PROGRESS_KEY = 'zr:books:progress:v1'
const LS_PREFS_KEY = 'zr:books:prefs:v1'
const LS_CUSTOM_BOOKS_KEY = 'zr:books:custom:v1'
const CLOUD_PROGRESS_PATH = 'pages/Books/reading-progress.json'

// Les 5 livres initialement présents dans Create/Books (pages/Books/) avec leurs JSON de pages extraites
export const CLOUD_BOOKS_SEED = [
  {
    id: 'win-without-pitching',
    name: 'The Win Without Pitching Manifesto',
    author: 'Blair Enns',
    cloudPath: 'pages/Books/The Win Without Pitching Manifesto - Blair Enns.pdf.file.json',
    textJson: '/books/win-without-pitching.json',
    totalPages: 82,
    coverColor: '#1D222B',
    defaultStatus: 'in_progress',
    defaultScore: 97,
  },
  {
    id: 'convenience-store-woman',
