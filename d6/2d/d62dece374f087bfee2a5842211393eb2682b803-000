// GmapsViewer.jsx — lecteur pour un nœud .media.json {type:'gmaps'}. Même famille que VideoPlayer2 (carte
// arrondie, titre éditable, actions Éditer/Partager/Ouvrir). 2026-07-04, demande explicite de Matthieu :
// intégration Google Maps EXACTEMENT comme les liens YouTube (Space/Quick Look, double-clic, inline, jamais
// de sortie du site).
//
// CLÉ API (vérifié en test réel) : le vieux truc `maps.google.com/maps?q=...&output=embed` SANS clé est MORT
// (Google renvoie 404 dessus depuis quelque temps). La seule intégration Google Maps qui fonctionne encore est
// l'Embed API officielle (`google.com/maps/embed/v1/place?key=...`) — GRATUITE et non facturée (contrairement
// aux autres API Maps), mais elle exige une clé. Sans clé configurée (VITE_GMAPS_EMBED_KEY), on affiche un
// message clair + le lien externe plutôt qu'un iframe muet/cassé.
import React, { useEffect, useState } from 'react'
import Icon from './Icon.jsx'
import { useT } from '../i18n/useT.js'

const ACCENT = '#cc7c5e'
const chip = (bg, color, border) => ({ display: 'inline-flex', alignItems: 'center', gap: 6, padding: '8px 14px', borderRadius: 99, background: bg, color, border: border ? `1px solid ${border}` : 'none', cursor: 'pointer', fontFamily: "var(--zr-police-sans)", fontSize: 'var(--zr-ui-md)', fontWeight: 500, textDecoration: 'none' })

// Construit l'URL d'intégration à partir des composants BRUTS du manifeste (query/lat/lng/zoom), au RENDU —
// pas au moment de la création du nœud. Conséquence utile : un lieu créé AVANT que la clé soit configurée
// affichera automatiquement la vraie carte dès que VITE_GMAPS_EMBED_KEY est ajoutée, sans rien recréer.
function buildEmbedSrc(manifest, key) {
  if (!key || !manifest) return null
  const q = manifest.query || (manifest.lat ? `${manifest.lat},${manifest.lng}` : null)
  if (!q) return null
  const params = new URLSearchParams({ key, q })
  if (manifest.zoom) params.set('zoom', String(manifest.zoom))
  return `https://www.google.com/maps/embed/v1/place?${params.toString()}`
}

export default function GmapsViewer({ t, path, manifest, onSaveMeta, shared = false }) {
  const tr = useT()
  const baseTitle = (manifest && (manifest.title || manifest.name)) || 'Lieu'
  const [title, setTitle] = useState(baseTitle)
  const [editing, setEditing] = useState(false)
  // Le composant peut rester monté en changeant de nœud (navigation dans le même viewer) : sans ce resync,
  // `title` resterait figé sur le PREMIER manifeste jamais vu. Jamais pendant une édition en cours.
  useEffect(() => { if (!editing) setTitle(baseTitle) }, [baseTitle, editing])
  const saveMeta = () => { setEditing(false); if (onSaveMeta && title !== baseTitle) onSaveMeta({ title, author: (manifest && manifest.author) || '' }) }

  // PAS DE PARTAGE PUBLIC en v1 (2026-07-04) : le mécanisme /watch (encodeShare + share-og) est câblé
  // spécifiquement pour les vidéos ; l'étendre aux cartes est un chantier à part, pas demandé ici. Éditer +
  // Ouvrir dans Google Maps suffisent pour l'intégration inline demandée par Matthieu.

  const embedKey = import.meta.env.VITE_GMAPS_EMBED_KEY || ''
  const embedSrc = buildEmbedSrc(manifest, embedKey)

  return (
    <div style={{ width: '100%', maxWidth: 1100, margin: '0 auto' }}>
      {/* Carte 4:3 (une carte se lit mieux un peu plus carrée qu'une vidéo 16:9) — même cadre arrondi que le
          reste des médias du site. */}
      <div style={{ width: '100%', aspectRatio: '4 / 3', background: '#e8e8e6', borderRadius: 14, overflow: 'hidden' }}>
        {embedSrc
          ? <iframe title={title} src={embedSrc} style={{ width: '100%', height: '100%', border: 'none' }} loading="lazy" />
          : (
            <div style={{ width: '100%', height: '100%', display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 10, padding: 24, textAlign: 'center' }}>
              <Icon name="mappin" size={32} color={t.textSecondary} weight={1.4} />
              <div style={{ fontFamily: "var(--zr-police-sans)", fontSize: 'var(--zr-ui-md)', color: t.textSecondary, maxWidth: 380, lineHeight: 1.5 }}>
                Aperçu de carte indisponible : une clé Maps Embed API (gratuite) doit être ajoutée dans <code>.env.local</code> (variable <code>VITE_GMAPS_EMBED_KEY</code>). En attendant, ouvre le lieu directement sur Google Maps.
              </div>
            </div>
          )}
      </div>

      <div style={{ marginTop: 14 }}>
        {editing
          ? <input value={title} onChange={(e) => setTitle(e.target.value)} autoFocus onKeyDown={(e) => e.key === 'Enter' && saveMeta()}
              style={{ width: '100%', fontFamily: "var(--zr-police-sans)", fontSize: 21, fontWeight: 600, color: t.textPrimary, background: 'transparent', border: `1px solid ${t.border}`, borderRadius: 8, padding: '4px 8px', outline: 'none' }} />
          : <div style={{ fontFamily: "var(--zr-police-sans)", fontSize: 21, fontWeight: 600, lineHeight: 1.25, color: t.textPrimary }}>{title}</div>}
      </div>

      <div style={{ marginTop: 12, display: 'flex', alignItems: 'center', justifyContent: 'flex-end', gap: 8, flexWrap: 'wrap' }}>
        {!shared && (editing
          ? <button onClick={saveMeta} style={chip(ACCENT, '#fff')}><Icon name="checkmark" size={14} color="#fff" weight={2} /> {tr('player.save')}</button>
          : <button onClick={() => setEditing(true)} style={chip('transparent', t.textPrimary, t.border)}>{tr('player.edit')}</button>)}
        <a href={(manifest && manifest.url) || '#'} target="_blank" rel="noreferrer" style={chip('transparent', t.textPrimary, t.border)}>
          <Icon name="mappin" size={14} weight={1.8} /> Ouvrir dans Google Maps
        </a>
      </div>
    </div>
  )
}
