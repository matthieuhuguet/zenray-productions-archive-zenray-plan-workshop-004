// FOLDER ART (2 October 2026). One drawing of a folder, shared by the icon grid, the list row and the
// customisation dialog preview, so the three can never disagree.
// FR : un seul dessin de dossier pour la grille, la liste et l'apercu du dialogue.
//
// Colour: an overlay masked by the folder drawing, blended with `color`, keeps the lightness of the
// artwork (shadows, white sheet) and only takes hue and saturation. Glyph: a stored SVG used as a mask
// over the front panel, in a darker shade of the chosen colour with a light edge below, like Finder.
// Geometry and shading numbers live in src/config/colors.js (FOLDER_ART).
import React from 'react'
import { FOLDER_ART, UI } from '../config/colors.js'
import { svgMaskUrl } from '../lib/folderStyle.js'

const maskBase = { maskRepeat: 'no-repeat', WebkitMaskRepeat: 'no-repeat' }

export default function FolderArt({ width, empty = false, color = null, glyph = null }) {
  const src = empty ? '/icons/folder-empty.svg' : '/icons/folder-full.svg'
  const glyphBase = color || UI.blue
  return (
    <div style={{ position: 'relative', isolation: 'isolate', width, aspectRatio: String(FOLDER_ART.aspect), display: 'block', pointerEvents: 'none', flexShrink: 0 }}>
      <img src={src} alt="" draggable={false} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%', display: 'block' }} />
      {color && (
        <div style={{
          position: 'absolute', inset: 0, background: color, mixBlendMode: FOLDER_ART.tintBlend,
          maskImage: `url(${src})`, WebkitMaskImage: `url(${src})`, maskSize: '100% 100%', WebkitMaskSize: '100% 100%', ...maskBase,
        }} />
      )}
      {glyph && glyph.svg && (
        <div style={{
          position: 'absolute', width: `${FOLDER_ART.glyphSize * 100}%`, aspectRatio: '1',
          left: `${FOLDER_ART.glyphCenterX * 100}%`, top: `${FOLDER_ART.glyphCenterY * 100}%`, transform: 'translate(-50%, -50%)',
          background: `color-mix(in srgb, ${glyphBase} ${100 - FOLDER_ART.glyphDarkenPct}%, #000)`,
          maskImage: svgMaskUrl(glyph.svg), WebkitMaskImage: svgMaskUrl(glyph.svg),
          maskSize: 'contain', WebkitMaskSize: 'contain', maskPosition: 'center', WebkitMaskPosition: 'center', ...maskBase,
          filter: `drop-shadow(0 1px 0 ${FOLDER_ART.glyphHighlight})`,
        }} />
      )}
    </div>
  )
}
