    return { code: c.toUpperCase(), label: c.toUpperCase(), flag: '🌐', priority: 40, bonus: 0 }
  }
  return { code: 'OTHER', label: 'Non précisé / Télétravail', flag: '🌐', priority: 99, bonus: 0 }
