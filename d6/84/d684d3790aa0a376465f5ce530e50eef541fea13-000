]
/** The lane a studio belongs to: games unless the engine tagged it as another industry. */
export const laneOf = (studio) => (studio && studio.engine && studio.engine.lane === 'other' ? 'other' : 'games')

export const engineOf = (studio) => (studio && studio.engine) || null

/** The kind of a studio as the page shows it: a studio without any engine block is a prospect Matthieu added by hand. */
export function kindOf(studio) {
  const engine = engineOf(studio)
  if (!engine) return 'prospect'
  if (engine.kind === 'tender') return 'tender'
  if (/^Vivier de candidatures/i.test(studio.role || '') || engine.kind === 'spontaneous') return 'spontaneous'
  if (engine.freelance) return 'freelance'
  if (engine.kind === 'internship' || engine.trainee) return 'internship'
  return 'offer'
}
export const kindLabel = (studio) => ({ prospect: 'Studio à démarcher', spontaneous: 'Vivier ou spontanée', tender: 'Appel d’offres', freelance: 'Freelance', internship: 'Stage', offer: 'Offre' }[kindOf(studio)])

export function isClosedStudio(studio, today) {
  const engine = engineOf(studio)
  if (!engine) return false
  return Boolean(engine.closedAt) || Boolean(engine.validThrough && String(engine.validThrough).slice(0, 10) < today)
}

const dayNumber = (iso) => Math.floor(new Date(`${String(iso).slice(0, 10)}T00:00:00Z`).getTime() / 86400000)
export function isNewStudio(studio, today, days = 3) {
  const engine = engineOf(studio)
  if (!engine || engine.legacy || !engine.firstSeenAt || studio.status !== 'to_contact') return false
  return dayNumber(today) - dayNumber(engine.firstSeenAt) < days
}

export const tierOf = (studio) => engineOf(studio)?.tier || null
export const sourceLabelOf = (studio) => engineOf(studio)?.sourceLabel || ''

// 08 October 2026: Country normalization and prioritization (France > Japan > UK > US > Others)
export function countryOf(studio) {
  if (!studio) return { code: 'OTHER', label: 'Non précisé', flag: '🌐', priority: 99, bonus: 0 }
  const c = String(studio.engine?.country || '').trim()
  const city = String(studio.city || '').trim()
  const raw = `${c} ${city}`.toLowerCase()

  // 1. France (FR) : Priorité maximale
  if (/\b(fr|france|paris|rennes|lyon|bordeaux|la rochelle|nantes|toulouse|montpellier|lille|strasbourg|marseille|grenoble|angouleme|angoulême|tourcoing|metz|nanterre|montreuil|clichy|rouen|nancy|dijon|orleans|orléans|brest|tours|reims|nice|cannes)\b/i.test(raw) || /\(\d{2}\)/.test(city)) {
    return { code: 'FR', label: 'France', flag: '🇫🇷', priority: 1, bonus: 20 }
  }

  // 2. Japon (JP) : Cap 2027 et priorité internationale
  if (/\b(jp|japan|japon|tokyo|osaka|kyoto|yokohama|fukuoka|nagoya|sapporo|kobe|sendai)\b/i.test(raw)) {
    return { code: 'JP', label: 'Japon', flag: '🇯🇵', priority: 2, bonus: 15 }
  }

  // 3. Royaume-Uni / Angleterre (GB) : Marché anglophone européen
  if (/\b(gb|uk|united kingdom|royaume-uni|angleterre|england|london|brighton|leamington|edinburgh|scotland|manchester|bristol|cambridge|guildford|oxford|newcastle|sheffield|leeds|birmingham|glasgow|wales|belfast)\b/i.test(raw)) {
    return { code: 'GB', label: 'Royaume-Uni', flag: '🇬🇧', priority: 3, bonus: 10 }
  }

  // 4. États-Unis (US) : Marché majeur
  if (/\b(us|usa|united states|etats-unis|états-unis|california|los angeles|san francisco|santa monica|seattle|austin|texas|new york|carolina|redmond|boston|chicago|bellevue|irvine|san diego|burbank|culver city|san jose|atlanta|dallas|miami|denver|portland)\b/i.test(raw)) {
    return { code: 'US', label: 'États-Unis', flag: '🇺🇸', priority: 4, bonus: 8 }
  }

  // Pays partenaires occidentaux et UE
  if (/\b(ca|canada|montreal|montréal|quebec|québec|vancouver|toronto|ottawa|calgary|edmonton)\b/i.test(raw)) {
    return { code: 'CA', label: 'Canada', flag: '🇨🇦', priority: 10, bonus: 4 }
  }
  if (/\b(de|germany|allemagne|berlin|munich|frankfurt|hamburg|cologne|köln|dusseldorf|karlsruhe)\b/i.test(raw)) {
    return { code: 'DE', label: 'Allemagne', flag: '🇩🇪', priority: 11, bonus: 4 }
  }
  if (/\b(es|spain|espagne|barcelona|madrid|valencia|seville|malaga)\b/i.test(raw)) {
    return { code: 'ES', label: 'Espagne', flag: '🇪🇸', priority: 12, bonus: 4 }
  }
  if (/\b(se|sweden|suede|suède|stockholm|malmo|malmö|gothenburg|uppsala)\b/i.test(raw)) {
    return { code: 'SE', label: 'Suède', flag: '🇸🇪', priority: 13, bonus: 4 }
  }
  if (/\b(pl|poland|pologne|warsaw|varsovie|krakow|cracovie|wroclaw|gdansk)\b/i.test(raw)) {
    return { code: 'PL', label: 'Pologne', flag: '🇵🇱', priority: 14, bonus: 4 }
  }
  if (/\b(be|belgium|belgique|brussels|bruxelles|gent|liege|antwerp)\b/i.test(raw)) {
    return { code: 'BE', label: 'Belgique', flag: '🇧🇪', priority: 15, bonus: 4 }
  }
  if (/\b(ch|switzerland|suisse|geneva|genève|zurich|zürich|lausanne|basel)\b/i.test(raw)) {
    return { code: 'CH', label: 'Suisse', flag: '🇨🇭', priority: 16, bonus: 4 }
