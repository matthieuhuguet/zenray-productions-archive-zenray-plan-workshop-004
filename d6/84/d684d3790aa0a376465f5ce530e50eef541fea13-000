// 08 October 2026: Geographic priority bonus applied to raw score
export function scoreOf(studio) {
  const engine = engineOf(studio)
  if (!engine || engine.score === undefined || engine.score === null) return null
  const base = Number(engine.score)
  if (engine.countryPriorityApplied) return base
  const country = countryOf(studio)
  const hadOldBonus = country.bonus > 0 || Boolean(studio.city && /remote|télétravail/i.test(studio.city))
  const delta = country.code === 'FR' ? (hadOldBonus ? 14 : 20)
    : country.code === 'JP' ? (hadOldBonus ? 9 : 15)
    : country.code === 'GB' ? (hadOldBonus ? 4 : 10)
    : country.code === 'US' ? (hadOldBonus ? 2 : 8)
    : (country.bonus > 0 ? (hadOldBonus ? -2 : 4) : (hadOldBonus ? -6 : 0))
  return Math.max(0, Math.min(100, base + delta))
}

export const DEFAULT_FILTERS = { tier: 'all', kind: 'all', source: 'all', country: 'all', onlyNew: false, showClosed: false, sort: 'score' }

export function matchesFilters(studio, filters, today) {
  if (!filters.showClosed && isClosedStudio(studio, today)) return false
  if (filters.onlyNew && !isNewStudio(studio, today)) return false
  if (filters.tier === 'high' && tierOf(studio) !== 'high') return false
  if (filters.tier === 'medium' && !['high', 'medium'].includes(tierOf(studio))) return false
  if (filters.kind !== 'all' && kindOf(studio) !== filters.kind) return false
  if (filters.source !== 'all' && sourceLabelOf(studio) !== filters.source) return false
  if (filters.country && filters.country !== 'all' && countryOf(studio).code !== filters.country) return false
  return true
}

export function sortStudios(list, sort = 'score') {
  const copy = [...list]
  if (sort === 'recent') return copy.sort((a, b) => String(engineOf(b)?.firstSeenAt || b.createdAt).localeCompare(String(engineOf(a)?.firstSeenAt || a.createdAt)) || (scoreOf(b) ?? -1) - (scoreOf(a) ?? -1))
  return copy.sort((a, b) => (scoreOf(b) ?? -1) - (scoreOf(a) ?? -1) || (countryOf(a).priority - countryOf(b).priority) || String(a.name).localeCompare(String(b.name)))
}

export const sourceOptions = (studios) => [...new Set(studios.map(sourceLabelOf).filter(Boolean))].sort((a, b) => a.localeCompare(b))

// 08 October 2026: Returns ONLY countries present in the current vacancy list,
// partitioned into priority countries (France, Japan, UK, US) and other present countries.
export function countryOptions(studios) {
  const counts = new Map()
  const infoMap = new Map()
  for (const studio of studios || []) {
    const info = countryOf(studio)
    counts.set(info.code, (counts.get(info.code) || 0) + 1)
    if (!infoMap.has(info.code)) infoMap.set(info.code, info)
  }

  const PRIORITY_CODES = ['FR', 'JP', 'GB', 'US']
  const priorityCountries = []
  const otherCountries = []

  for (const code of PRIORITY_CODES) {
    if (counts.has(code) && counts.get(code) > 0) {
      const info = infoMap.get(code)
      priorityCountries.push({ ...info, count: counts.get(code) })
    }
  }

  for (const [code, count] of counts.entries()) {
    if (!PRIORITY_CODES.includes(code) && count > 0) {
      const info = infoMap.get(code)
      otherCountries.push({ ...info, count })
    }
  }
  otherCountries.sort((a, b) => b.count - a.count || a.label.localeCompare(b.label))

  return {
    priorityCountries,
    otherCountries,
    all: [...priorityCountries, ...otherCountries],
  }
}

/** "il y a 2 h" from an ISO time; coarse on purpose, the exact time is one hover away. */
export function relativeTime(iso, now = new Date()) {
  if (!iso) return 'jamais'
  const minutes = Math.round((new Date(now).getTime() - new Date(iso).getTime()) / 60000)
  if (Number.isNaN(minutes)) return ''
  if (minutes < 1) return 'à l’instant'
  if (minutes < 60) return `il y a ${minutes} min`
  const hours = Math.round(minutes / 60)
  if (hours < 24) return `il y a ${hours} h`
  const days = Math.round(hours / 24)
  return days === 1 ? 'hier' : `il y a ${days} jours`
}

/** In how long the next automatic search runs, from the service's own due time. */
export function untilLabel(iso, now = new Date()) {
  if (!iso) return ''
  const minutes = Math.round((new Date(iso).getTime() - new Date(now).getTime()) / 60000)
  if (minutes <= 0) return 'dès que le Mac est disponible'
  if (minutes < 60) return `dans ${minutes} min`
  return `dans ${Math.round(minutes / 60)} h`
}

/** "12 h" or "18 h 30": the clock time in Paris, the zone of the fixed search slots (00:00, 06:00, 12:00, 18:00). */
export function clockLabel(iso) {
  const date = new Date(iso)
  if (Number.isNaN(date.getTime())) return ''
  const parts = Object.fromEntries(new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', hour: 'numeric', minute: '2-digit', hourCycle: 'h23' }).formatToParts(date).map((part) => [part.type, part.value]))
  return parts.minute === '00' ? `${parts.hour} h` : `${parts.hour} h ${parts.minute}`
}

/** The mail link: only when a recruiter address is known; the body is capped, the page copies the whole letter anyway. */
export function mailtoUrl({ to, subject, body, limit = 1800 }) {
  if (!to) return ''
  const text = String(body || '')
  const cut = text.length > limit ? `${text.slice(0, limit)}…` : text
  return `mailto:${encodeURIComponent(to).replace(/%40/g, '@')}?subject=${encodeURIComponent(subject || '')}&body=${encodeURIComponent(cut)}`
}

// ─── Letter archive: versions only ever grow ──────────────────────────────────────────────────────────

export const versionsOf = (archive) => (archive && Array.isArray(archive.versions) ? archive.versions : [])
export const currentVersion = (archive) => versionsOf(archive).at(-1) || null
export const suggestionOf = (archive) => (archive && archive.suggested) || null

/** Matthieu's own edit: a new version by him, never an overwrite. Returns the same archive when nothing changed. */
export function addUserVersion(archive, { text, subject, lang, at, reason = 'edit' }) {
  const body = String(text || '').trim()
  const current = currentVersion(archive)
  if (!body || (current && current.text === body && current.subject === subject)) return archive
  const base = archive && Array.isArray(archive.versions) ? archive : { v: 1, studioId: archive?.studioId || '', versions: [] }
  return { ...base, versions: [...base.versions, { at, by: 'matthieu', subject: subject ?? current?.subject ?? '', text: body, lang: lang || current?.lang || 'fr', kind: current?.kind || '', reason, fingerprint: `matthieu|${at}|${body.length}` }] }
}

/** Accepting the automatic suggestion appends it as a normal version and clears the waiting slot. */
export function acceptSuggestion(archive, at) {
  const suggestion = suggestionOf(archive)
  if (!suggestion) return archive
  const { suggested, ...rest } = archive
  return { ...rest, versions: [...rest.versions, { ...suggestion, at, reason: 'accepted-suggestion' }] }
}

export const dismissSuggestion = (archive) => { if (!archive || !archive.suggested) return archive; const { suggested, ...rest } = archive; return rest }

/** The bundle copied to the clipboard in one click. */
export const copyBundle = (version) => (version ? `Objet : ${version.subject}\n\n${version.text}` : '')

// ─── Engine file and service status, as one sentence ──────────────────────────────────────────────────

export function engineStatusLine({ engine, service, now = new Date() }) {
  const last = engine?.lastRun
  const parts = []
  if (service?.running) parts.push(`recherche en cours : ${service.running.stage}`)
  else if (last) parts.push(`dernière recherche ${relativeTime(last.finishedAt, now)}`)
  else parts.push('aucune recherche pour l’instant')
  if (!service?.running && last) parts.push(last.added ? `${last.added} nouvelle${last.added > 1 ? 's' : ''} annonce${last.added > 1 ? 's' : ''}` : 'rien de nouveau')
  if (!service?.running && engine?.nextRunDue) parts.push(`prochaine ${untilLabel(engine.nextRunDue, now)} (${clockLabel(engine.nextRunDue)})`)
  return parts.join(' · ')
}

/** Sources that need a look: a board that answered with an error, or could not be read in full. */
export const sourceProblems = (engine) => (engine?.sources || []).filter((source) => (!source.complete && !source.partial) || (source.errors && source.errors.length))
