// ═══ LA ROUE CYBERNÉTIQUE, HUD DE FINAL FANTASY VII, EN DIX-HUIT ÉLÉMENTS ════════════════════════
//
// Référence donnée par Matthieu le 2026-08-27 : la capture d'un cercle de matéria, anneaux concentriques
// turquoise, l'un gradué comme une règle, les autres brisés en arcs qui tournent à des vitesses
// différentes. Sa consigne tient en trois mots, « classe et douce », et c'est elle qui a écarté la
// version évidente.
//
// CE QUI FAIT QU'UN HUD RESSEMBLE À UN HUD, ET CE N'EST PAS LA COULEUR. Ce sont les vitesses
// DIFFÉRENTES. Un anneau qui tourne seul se lit comme un chargement ; trois anneaux qui tournent à des
// cadences sans rapport entre elles se lisent comme une machine qui calcule, parce que l'œil cherche la
// relation et ne la trouve pas. Les périodes sont donc délibérément premières entre elles, et l'un des
// anneaux tourne à l'envers : elles ne se réalignent jamais, il n'y a pas de boucle à repérer.
//
// LA DOUCEUR EST UNE AFFAIRE D'OPACITÉ, PAS DE LENTEUR. Un HUD de jeu brille parce qu'il doit se voir à
// travers une bataille ; posé dans un coin d'interface, le même dessin agresse. Toutes les valeurs sont
// donc descendues sous 0,5 sauf l'arc de progression, seul élément qui porte une information et seul
// autorisé à être franc. Le reste est une texture.
//
// LOI HDA : rien ne s'écrit en dur dans le rendu, tout descend de `ROUE` ci-dessous. La roue sert
// aujourd'hui la pastille flottante ; elle est dimensionnée par sa seule propriété `taille`, donc la
// poser ailleurs, plus grande, ne demandera pas une seconde copie.
import React, { useMemo } from 'react'
import './RoueCyber.css'

export const ROUE = {
  // Rayons et épaisseurs dans un repère de 100 unités, CALIBRÉS POUR UN RENDU AUTOUR DE 54 PIXELS, qui
  // est la taille de la pastille. Ce n'est pas un détail de réglage, c'est la première version qui a été
  // ratée : dessiner « joliment » dans un repère abstrait puis réduire au dixième produit une roue vide.
  //
  // LE CALCUL QUI A CORRIGÉ LES DEUX ERREURS. À 54 pixels, une unité du repère vaut 0,54 pixel réel :
  // les traits de 0,8 tombaient donc à 0,43 pixel, sous le seuil où un écran dessine encore une ligne, et
  // l'antialiasing les rendait en gris pâle indistinct. Et 72 graduations sur une circonférence de
  // 152 pixels en mettaient une toutes les deux pixels, ce qui ne se lit plus comme des traits mais comme
  // une bande grise. Quarante traits épais valent mieux que soixante-douze invisibles.
  //
  // Poser cette roue nettement plus grande demanderait donc d'AFFINER ces épaisseurs, pas de les garder :
  // une roue est un dessin de trait, et un trait ne se met pas à l'échelle comme une forme.
  //
  // LES QUATRE BANDES NE SE TOUCHENT JAMAIS, et c'est la seconde erreur corrigée. La pointe intérieure
  // des graduations tombait d'abord à quatre dixièmes d'unité de l'arc turquoise : les deux se lisaient
  // alors comme un seul anneau brouillon. Deux unités de vide au minimum séparent désormais chaque bande,
  // parce que c'est le vide qui fait qu'on compte quatre anneaux au lieu d'en voir un épais.
  vue: 100,
  graduations: { r: 46, n: 40, court: 3, long: 6, tousLes: 5, trait: 1.8, tour: 96 },
  arcExterne:  { r: 36.5, arcs: 3, ouverture: 74, trait: 2.1, tour: -27 },
  progression: { r: 29.5, trait: 3.4 },
  pisteFine:   { r: 29.5, trait: 3.4 },
  arcInterne:  { r: 23, arcs: 2, ouverture: 104, trait: 1.5, tour: 15 },
  equerres:    { r1: 48.5, r2: 51, trait: 2.1, angles: [45, 135, 225, 315] },
  // LA RESPIRATION. Une amplitude de 3,5 % : en dessous on ne la voit pas, au-dessus la pastille
  // « pompe » et attire l'œil au lieu de le laisser tranquille. Quatre secondes et demie, soit le
  // rythme d'une respiration calme, parce que c'est celui que le corps reconnaît sans y penser.
  respiration: { amplitude: 0.035, duree: 4.6 },
}

// Un point du cercle, angle compté depuis le HAUT dans le sens horaire (le sens d'un cadran).
const pt = (r, deg) => {
  const a = ((deg - 90) * Math.PI) / 180
  return [50 + r * Math.cos(a), 50 + r * Math.sin(a)]
}
// Un arc pur, sans retour au centre : c'est ce qui distingue un anneau brisé d'une part de camembert.
const arc = (r, d, f) => {
  const [x1, y1] = pt(r, d); const [x2, y2] = pt(r, f)
  return `M ${x1} ${y1} A ${r} ${r} 0 ${f - d > 180 ? 1 : 0} 1 ${x2} ${y2}`
}

export default function RoueCyber({ taille = 56, avance = 0, urgent = false, className = '' }) {
  const { graduations: g, arcExterne: ae, progression: pr, pisteFine: pf, arcInterne: ai, equerres: eq } = ROUE

  // Les graduations se calculent une fois pour toutes : elles ne dépendent que des paramètres, jamais
  // de l'avancement, donc les recalculer à chaque seconde serait soixante fois trop.
  const traits = useMemo(() => Array.from({ length: g.n }, (_, i) => {
    const deg = (360 / g.n) * i
    const fort = i % g.tousLes === 0
    const [x1, y1] = pt(g.r - (fort ? g.long : g.court), deg)
    const [x2, y2] = pt(g.r, deg)
    return { x1, y1, x2, y2, fort }
  }), [g])

  const arcsExternes = useMemo(() => Array.from({ length: ae.arcs }, (_, i) => {
    const d = (360 / ae.arcs) * i
    return arc(ae.r, d, d + ae.ouverture)
  }), [ae])

  const arcsInternes = useMemo(() => Array.from({ length: ai.arcs }, (_, i) => {
    const d = (360 / ai.arcs) * i + 22
    return arc(ai.r, d, d + ai.ouverture)
  }), [ai])

  const circ = 2 * Math.PI * pr.r
  const k = Math.max(0, Math.min(1, avance))

  return (
    <svg className={`rc${urgent ? ' rc-urgent' : ''} ${className}`.trim()} width={taille} height={taille}
      viewBox={`0 0 ${ROUE.vue} ${ROUE.vue}`} aria-hidden="true" focusable="false"
      style={{ '--rc-respire': `${ROUE.respiration.duree}s`, '--rc-ampli': 1 + ROUE.respiration.amplitude }}>
      <defs>
        {/* Le dégradé va du turquoise de la référence au bleu du site : la roue cite Final Fantasy sans
            introduire une couleur qui n'appartiendrait à personne ici. */}
        <linearGradient id="rc-degrade" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" className="rc-stop-a" /><stop offset="100%" className="rc-stop-b" />
        </linearGradient>
      </defs>

      {/* LA RESPIRATION PORTE SUR UN GROUPE, jamais sur le `<svg>` : mettre l'échelle sur l'élément
          racine ferait respirer la boîte de mise en page elle-même, et tout ce qui l'entoure bougerait
          au même rythme. Ici la boîte ne bouge pas, seul son contenu vit. */}
      <g className="rc-souffle">
        {/* Le halo respire en OPPOSITION du dessin : quand la roue se resserre, la lueur s'ouvre. Deux
            choses qui grandissent ensemble se lisent comme un zoom ; en opposition, on lit une pulsation. */}
        <circle className="rc-halo" cx="50" cy="50" r={pr.r} />

        <g className="rc-graduations">
          {traits.map((t, i) => (
            <line key={i} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2}
              className={t.fort ? 'rc-grad rc-grad-fort' : 'rc-grad'} strokeWidth={g.trait} />
          ))}
        </g>

        <g className="rc-arcs-ext">
          {arcsExternes.map((d, i) => <path key={i} d={d} strokeWidth={ae.trait} fill="none" strokeLinecap="round" />)}
        </g>

        {/* La piste et l'arc partagent le MÊME rayon et la MÊME épaisseur : c'est ce qui donne
            l'impression que l'arc remplit une rainure creusée à l'avance, et non qu'il flotte devant. */}
        <circle className="rc-piste" cx="50" cy="50" r={pf.r} strokeWidth={pf.trait} fill="none" />
        <circle className="rc-progres" cx="50" cy="50" r={pr.r} strokeWidth={pr.trait} fill="none" strokeLinecap="round"
          transform="rotate(-90 50 50)" strokeDasharray={`${circ * k} ${circ}`} />

        <g className="rc-arcs-int">
          {arcsInternes.map((d, i) => <path key={i} d={d} strokeWidth={ai.trait} fill="none" strokeLinecap="round" />)}
        </g>

        {/* Les quatre équerres sont ce qui fait « viseur » plutôt que « chargement ». Elles ne tournent
            pas : il faut un repère fixe, sinon rien ne donne la mesure de ce qui tourne. */}
        <g className="rc-equerres">
          {eq.angles.map((a) => {
            const [x1, y1] = pt(eq.r1, a); const [x2, y2] = pt(eq.r2, a)
            return <line key={a} x1={x1} y1={y1} x2={x2} y2={y2} strokeWidth={eq.trait} strokeLinecap="round" />
          })}
        </g>
      </g>
    </svg>
  )
}
