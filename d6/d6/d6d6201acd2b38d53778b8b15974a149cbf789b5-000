function Docs({ t }) {
  const [path, setPath] = useState(PINNED_DOCS[0].path)
  const [md, setMd] = useState('')
  const [loading, setLoading] = useState(true)
  const [err, setErr] = useState(null)
  const [tree, setTree] = useState(null)
  const [browse, setBrowse] = useState(false)
  const [nonce, setNonce] = useState(0)
  const [repo, setRepo] = useState('memory') // C998 : repo consultable read-only ('memory' | 'claude')

  useEffect(() => {
    if (!path) { setMd(''); setErr(null); setLoading(false); return }
    let alive = true; setLoading(true); setErr(null)
    fetch(`/api/doc?path=${encodeURIComponent(path)}&repo=${repo}`, { cache: 'no-store' })
      .then((r) => r.json())
      .then((j) => { if (!alive) return; if (j.markdown != null) { setMd(j.markdown); setErr(null) } else { setMd(''); setErr(j.error || 'erreur') } })
      .catch(() => alive && setErr('réseau'))
      .finally(() => alive && setLoading(false))
    return () => { alive = false }
  }, [path, nonce, repo])

  const loadTree = (force) => {
    setBrowse(true)
    if (tree && !force) return
    fetch(`/api/tree?repo=${repo}`, { cache: 'no-store' }).then((r) => r.json()).then((j) => setTree(j.files || [])).catch(() => setTree([]))
  }
  // C998 : bascule de repo consultable (read-only strict). Memory garde ses épinglés ; .claude ouvre direct le navigateur.
  const switchRepo = (r) => {
    if (r === repo) return
    setRepo(r); setTree(null)
    if (r === 'memory') { setBrowse(false); setPath(PINNED_DOCS[0].path) }
    else { setPath(''); setBrowse(true); fetch(`/api/tree?repo=${r}`, { cache: 'no-store' }).then((x) => x.json()).then((j) => setTree(j.files || [])).catch(() => setTree([])) }
  }
  const fileName = (p) => p.split('/').pop().replace(/\.md$/, '')

  const item = (p, label) => (
    <button key={p} onClick={() => setPath(p)} title={p}
      style={{ display: 'block', width: '100%', textAlign: 'left', padding: '7px 10px', borderRadius: RADII.sm, cursor: 'pointer', marginBottom: 3,
        background: path === p ? PALETTE.primarySoft : 'transparent', color: path === p ? PALETTE.primary : t.textPrimary,
        border: `1px solid ${path === p ? PALETTE.primary : 'transparent'}`, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', fontWeight: path === p ? 600 : 500, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>
      {label || fileName(p)}
    </button>
  )

  // groupe le tree par dossier racine
  const groups = {}
  if (tree) tree.forEach((p) => { const top = p.includes('/') ? p.split('/')[0] : '·'; (groups[top] = groups[top] || []).push(p) })

  return (
    <>
      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 12, flexWrap: 'wrap' }}>
        <SectionLabel t={t} color={t.textSecondary} nomargin>Documents <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', opacity: 0.6 }}>· lecture live read-only · {repo === 'memory' ? 'repo Memory' : 'repo .claude'}</span></SectionLabel>
        <div style={{ display: 'inline-flex', gap: 3, border: `1px solid ${t.border}`, borderRadius: RADII.md, padding: 3, background: t.surface }}>
          {[['memory', 'Memory'], ['claude', '.claude']].map(([k, lbl]) => (
            <button key={k} onClick={() => switchRepo(k)} style={{ padding: '5px 12px', borderRadius: RADII.sm, border: 'none', cursor: 'pointer', background: repo === k ? PALETTE.primarySoft : 'transparent', color: repo === k ? PALETTE.primary : t.textSecondary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', fontWeight: repo === k ? 600 : 500 }}>{lbl}</button>
          ))}
        </div>
      </div>
      <div style={{ display: 'flex', gap: 18, marginTop: 14, alignItems: 'flex-start', flexWrap: 'wrap' }}>
        <div style={{ flex: '0 0 240px', maxWidth: 240 }}>
          {repo === 'memory' && <>
            <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: t.textSecondary, textTransform: 'uppercase', letterSpacing: 1, margin: '0 0 6px 2px' }}>Épinglés</div>
            {PINNED_DOCS.map((d) => item(d.path, d.label))}
          </>}
          <button onClick={() => loadTree(true)} style={{ ...btnGhost(t), width: '100%', padding: '7px 10px', marginTop: 8, fontSize: 'var(--zr-ui-sm)', color: PALETTE.primary, borderColor: PALETTE.primary }}>
            {browse ? 'Tout le repo ▾' : '+ parcourir tout le repo'}
          </button>
          {browse && (
            <div style={{ marginTop: 8, maxHeight: '60vh', overflowY: 'auto', borderTop: `1px solid ${t.border}`, paddingTop: 8 }}>
              {tree === null && <div style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-sm)', padding: '6px 2px' }}>chargement…</div>}
              {tree && tree.length === 0 && <div style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-sm)', padding: '6px 2px' }}>vide / non activé</div>}
              {Object.keys(groups).sort().map((g) => (
                <div key={g} style={{ marginBottom: 8 }}>
                  <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: t.textSecondary, textTransform: 'uppercase', letterSpacing: 1, margin: '4px 0 2px 2px' }}>{g}</div>
                  {groups[g].map((p) => item(p))}
                </div>
              ))}
            </div>
          )}
        </div>
        <div style={{ ...card(t), flex: 1, minWidth: 280 }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 14, gap: 10 }}>
            <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary }}>{path || (repo === 'claude' ? '.claude — choisis un fichier à gauche' : '')}</span>
            <button style={{ ...btn(t), padding: '5px 12px' }} onClick={() => setNonce((n) => n + 1)}>↻ rafraîchir</button>
          </div>
          {!path && <div style={{ color: t.textSecondary, lineHeight: 1.6 }}>Repo <b>{repo === 'memory' ? 'Memory' : '.claude'}</b> en lecture seule. Choisis un fichier <code style={{ fontFamily: FONTS.sans }}>.md</code> dans le navigateur à gauche.</div>}
          {path && loading && <div style={{ color: t.textSecondary }}>Lecture en direct depuis GitHub…</div>}
          {!loading && err === 'no-token' && (
            <div style={{ lineHeight: 1.6 }}>
              <b>Lecture des documents non activée.</b>
              <div style={{ color: t.textSecondary, marginTop: 8 }}>Le repo Memory est privé. Pour lire tes fichiers en direct ici, ajoute dans Vercel (projet → Settings → Environment Variables) une variable <code style={{ fontFamily: FONTS.sans }}>GITHUB_TOKEN</code> (jeton en lecture seule sur le repo Memory), puis redéploie. Source unique conservée : rien n'est copié, tout est lu en live.</div>
            </div>
          )}
          {!loading && err === 'token-expired' && (
            <div style={{ lineHeight: 1.6 }}>
              <b>Jeton GitHub expiré ou invalide.</b>
              <div style={{ color: t.textSecondary, marginTop: 8 }}>Régénère un PAT (lecture seule sur le repo Memory) sur GitHub, puis remplace la variable <code style={{ fontFamily: FONTS.sans }}>GITHUB_TOKEN</code> dans Vercel (projet → Settings → Environment Variables) et redéploie. Le reste du site fonctionne normalement.</div>
            </div>
          )}
          {path && !loading && err && err !== 'no-token' && err !== 'token-expired' && <div style={{ color: PALETTE.red }}>Erreur : {err} sur {path}</div>}
          {path && !loading && !err && <Markdown t={t} md={md} />}
        </div>
      </div>
    </>
  )
}
