/* ───────── Archive (cartes par mois) ───────── */
function Archive({ t, cards, onOpen }) {
  const [view, setView] = useState('gallery')
  const sorted = [...cards].sort((a, b) => (a.date < b.date ? 1 : -1))
  const groups = {}
  sorted.forEach((c) => { const k = monthKey(c.date); (groups[k] = groups[k] || []).push(c) })
  const keys = Object.keys(groups)
  const toItem = (c) => ({ id: c.id, title: c.title, subtitle: c.domain, image: c.images && c.images[0], color: PALETTE.primarySoft, badge: fmtLong(c.date), onOpen: () => onOpen(c.id) })
  return (
    <>
      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 12, flexWrap: 'wrap' }}>
        <SectionLabel t={t} color={t.textSecondary} nomargin>Archive — {cards.length} cartes</SectionLabel>
        {keys.length > 0 && <ViewSwitch t={t} view={view} onChange={setView} options={['list', 'gallery', 'page']} />}
      </div>
      {keys.length === 0 && <div style={{ ...card(t), marginTop: 16, color: t.textSecondary }}>Aucune carte pour l'instant. Glisse des objectifs dans la semaine ou clique « Fait ➜ agenda ».</div>}
      {keys.map((k) => (
        <div key={k} style={{ marginTop: 22 }}>
          <div style={{ fontFamily: FONTS.serif, fontSize: 'var(--zr-ui-3xl)', fontWeight: 600, marginBottom: 10, color: PALETTE.primary }}>{k}</div>
          <DataView t={t} view={view} items={groups[k].map(toItem)} />
        </div>
      ))}
    </>
  )
}

// Date d'upload « façon YouTube » : relatif si récent, sinon date courte FR. Tolère une ISO absente.
const _MOIS_FR = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.']
const fmtAgo = (iso) => {
  if (!iso) return ''
  const d = new Date(iso); if (isNaN(d)) return ''
  const sec = Math.max(0, (Date.now() - d.getTime()) / 1000)
  if (sec < 60) return "à l'instant"
  if (sec < 3600) return `il y a ${Math.floor(sec / 60)} min`
  if (sec < 86400) return `il y a ${Math.floor(sec / 3600)} h`
  if (sec < 7 * 86400) return `il y a ${Math.floor(sec / 86400)} j`
  return `${d.getDate()} ${_MOIS_FR[d.getMonth()]} ${d.getFullYear()}`
}

