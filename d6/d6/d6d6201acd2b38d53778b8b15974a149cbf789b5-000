    <PlayerProvider>
    <TimerProvider>
    <div className={`${state.theme === 'dark' ? 'zr-dark' : ''} ${view === 'assets' ? `zr-fusion${navOpen && !navOverlay && !tableImmersive ? ' zr-fusion-docked' : ''}` : ''}`.trim()} style={{ display: 'flex', height: '100vh', overflow: 'hidden', background: 'transparent', color: t.textPrimary, fontFamily: FONTS.sans, transition: TRANSITIONS.smooth }}>
      {/* Mode immersif table : on masque la sidebar (focus tableau). */}
      {!tableImmersive && navOpen && navOverlay && <div className="zr-sidebar-backdrop" onClick={() => setNavOpen(false)} />}
      {!tableImmersive && (navOpen
        ? <Sidebar t={t} view={view} setView={setView} overlay={navOverlay} onCollapse={() => setNavOpen(false)} theme={state.theme} setTheme={setTheme} onPick={() => { if (navOverlay) setNavOpen(false) }}
            onOpenYoutubeVideo={(id) => { setView('pages'); poserDemandePages('zr:create-youtube', { videoId: id }) }}
