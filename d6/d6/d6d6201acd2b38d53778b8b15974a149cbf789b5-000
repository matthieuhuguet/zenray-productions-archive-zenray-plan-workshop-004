/* ════════════ APP ════════════ */
export default function App() {
  const [state, setState] = useState(EMPTY)
  const [loaded, setLoaded] = useState(false)
  const [store, setStore] = useState('local')
  // Appui long = clic droit (mobile, 2026-07-06) : écouteur global unique, tous les onContextMenu existants
  // (tuiles Finder, fond de grille, favoris, tableur) marchent sur iPhone sans modification par site.
  useEffect(() => { installLongPressContextMenu() }, [])
  // Mode immersif d'une table (focus in-place) : App masque la sidebar quand une table le signale.
  // (Pages a son propre tableImmersive pour son en-tête ; ici c'est l'instance App-level, même event source.)
  const [tableImmersive, setTableImmersive] = useState(false)
  useEffect(() => { const h = (e) => setTableImmersive(!!(e && e.detail)); window.addEventListener('zr:table-immersive', h); return () => window.removeEventListener('zr:table-immersive', h) }, [])
  // Vue courante (Dashboard/Create/Tables/…), persistée + restaurée au reload. L'ancienne UI multi-onglets
  // (plusieurs onglets, chacun avec sa propre vue) est retirée : elle était masquée en dur ({false ? ... })
  // depuis longtemps, redondante avec la sidebar. Migration/persistance testées dans viewPersistence.js
  // (régression 2026-07-16 corrigée : zr:tabs doit être supprimé après lecture, sinon il écrase zr:view
  // à chaque reload et bloque tout futur changement de vue).
  // 2 October 2026, 12:51: A project link opens Assets directly without changing other saved views.
  // 12 October 2026: deep links accepted from a white list only (?view=motion&motion=<id>&v=V_008 opens a motion).
  const [view, setView] = useState(() => { const v = new URLSearchParams(window.location.search).get('view'); return isDeepLinkView(v) ? v : resolveInitialView(localStorage) })
  // ═══ LE NOM DE L ONGLET SUIT LA SECTION COURANTE (2026-08-31) ═════════════════════════════
  // Avec une dizaine d onglets ouverts, le navigateur ne montre que le debut du titre : tous les
  // onglets ZenRayProgress se ressemblaient. Le titre porte desormais la section, ce qui est
  // justement ce qui les distingue. Le libelle vient de la sidebar (source unique), jamais d une
  // copie qui divergerait au premier ajout de section.
  useEffect(() => {
    const libelle = libelleDeVue(view)
    document.title = titreOnglet(libelle)
  }, [view])
  useEffect(() => { persistView(localStorage, view) }, [view])
  const [sel, setSel] = useState(null) // selected card id (Notion panel)
  const [navOpen, setNavOpen] = useState(typeof window !== 'undefined' ? window.innerWidth >= 860 : true) // barre latérale repliable
  const [navOverlay, setNavOverlay] = useState(typeof window !== 'undefined' ? window.innerWidth < 860 : false) // C217 — sous 860px, la sidebar flotte (overlay) au lieu de pousser le contenu
  // Reveal au SURVOL (façon Claude Code) : quand la barre est repliée, survoler le bouton la révèle en flottant.
  // On peut entrer dedans et cliquer un élément sans l'ancrer ; cliquer le bouton (ou « Ancrer ») l'ancre vraiment.
  const [navHover, setNavHover] = useState(false)
  const [createDock, setCreateDock] = useState(false) // split-view : panneau Create ancré à droite (Ref/Audio/Article)
  const navHoverTimer = useRef(null)
  const revealNav = () => { if (navHoverTimer.current) { clearTimeout(navHoverTimer.current); navHoverTimer.current = null } setNavHover(true) }
  const hideNavSoon = () => { if (navHoverTimer.current) clearTimeout(navHoverTimer.current); navHoverTimer.current = setTimeout(() => setNavHover(false), 160) }
  // Le plan annonce son ouverture, la barre laterale se retire. Le REPLI est ici et non dans le
  // plan : c'est App qui possede `navOpen`, et une vue qui irait modifier l'etat d'une autre finirait
  // par se contredire avec le responsive juste en dessous.
  useEffect(() => {
    const surPlan = () => setNavOpen(false)
    window.addEventListener('zr:plan-ouvert', surPlan)
    return () => window.removeEventListener('zr:plan-ouvert', surPlan)
  }, [])

  const prevNarrowRef = useRef(typeof window !== 'undefined' ? window.innerWidth < 860 : false)
  useEffect(() => { // C216/C217 — responsive : sous 860px la sidebar passe en overlay et se replie auto
    // P8 — on ne force navOpen QU'AU franchissement du seuil 860px, pas à chaque resize.
    // Sinon replier la sidebar en desktop puis bouger la fenêtre d'1px la rouvrait de force.
    const onResize = () => {
      const narrow = window.innerWidth < 860
      setNavOverlay(narrow)
      if (narrow !== prevNarrowRef.current) { setNavOpen(!narrow); prevNarrowRef.current = narrow }
    }
    window.addEventListener('resize', onResize); return () => window.removeEventListener('resize', onResize)
  }, [])
  useEffect(() => { // C214d — Tab masque/affiche la sidebar (fullscreen app, focus contenu)
    const h = (e) => {
      if (e.key !== 'Tab') return
      const el = document.activeElement
      if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable)) return
      e.preventDefault(); setNavOpen((v) => !v)
    }
    window.addEventListener('keydown', h); return () => window.removeEventListener('keydown', h)
  }, [])
  useEffect(() => { // Navigation découplée : un bouton de notification (ex « Ouvrir la corbeille ») émet zr:navigate.
    const h = (e) => { const v = e && e.detail; if (typeof v === 'string') setView(v) }
    window.addEventListener('zr:navigate', h); return () => window.removeEventListener('zr:navigate', h)
  }, [])
  useEffect(() => { // C71 retour OAuth Spotify
    if (typeof window !== 'undefined' && window.location.pathname === '/spotify-callback') {
      const callbackParams = new URLSearchParams(window.location.search)
      const code = callbackParams.get('code')
      const oauthState = callbackParams.get('state')
      // Reprise du lien Spotify collé AVANT le login (bug réel 2026-07-16) : login() navigue la page
      // entière vers accounts.spotify.com, ce qui efface tout le state React de ZenRayAudioPanel --
      // l'URL tapée était perdue au retour, l'utilisateur devait la recoller une 2e fois sans le savoir.
      // sessionStorage survit à cette navigation ; on ne relaie l'URL en attente QUE si le login a réussi.
      const done = () => {
        window.history.replaceState({}, '', '/'); setView('pages')
        const pendingSpotifyUrl = sessionStorage.getItem('zr:spotify:pendingImport') || ''
        sessionStorage.removeItem('zr:spotify:pendingImport')
        poserDemandePages('zr:create-music', (pendingSpotifyUrl && isSpotifyLoggedIn()) ? { spotifyUrl: pendingSpotifyUrl } : undefined)
      }
      if (code) exchangeCode(code, oauthState).finally(done); else done()
    }
  }, [])
  useEffect(() => { // Cmd/Ctrl+Shift+S -> bibliothèque ZenRay Audio intégrée à Create.
    const h = (e) => { if ((e.metaKey || e.ctrlKey) && e.shiftKey && (e.key === 's' || e.key === 'S')) { e.preventDefault(); setView('pages'); poserDemandePages('zr:create-music') } }
    window.addEventListener('keydown', h); return () => window.removeEventListener('keydown', h)
  }, [])
  useEffect(() => { // ZenRayMedia (2026-07-25) : URL publique d'un article publié -> `?page=<chemin>`.
    // C'est ce qui donne une ADRESSE à un article : sans elle, « publier » ne produirait qu'un
    // fichier de plus, invisible à qui n'ouvre pas le bon dossier. Le paramètre est retiré de la
    // barre d'adresse après ouverture (replaceState) : recharger ne doit pas re-piloter la vue.
    if (typeof window === 'undefined') return
    const wanted = new URLSearchParams(window.location.search).get('page')
    if (!wanted || !wanted.startsWith('pages/')) return
    setView('pages')
    const emit = () => window.dispatchEvent(new CustomEvent('zr:open-page', { detail: { path: wanted } }))
    const timer = setTimeout(emit, 60) // laisse Create se monter avant de lui demander d'ouvrir
    try { window.history.replaceState({}, '', window.location.pathname) } catch { /* sans effet */ }
    return () => clearTimeout(timer)
  }, [])
  useEffect(() => { // bascule sur Create quand une page est demandée en cours de session
    const h = () => setView('pages')
    window.addEventListener('zr:open-page', h); return () => window.removeEventListener('zr:open-page', h)
  }, [])
  // 15 October 2026 : les liens « Ouvrir dans Create » des AUTRES vues (fiche Freelance, Media, Progress) emettent un evenement que seule `Pages`
  // ecoute ; hors de Create personne n'etait la, et le clic ne faisait rien (ou changeait de vue en perdant la demande). Quand Create n'est pas
  // monte, la demande est deposee dans sa boite aux lettres et la vue bascule ; quand il l'est, il la traite lui-meme (aucune boucle).
  // EN : cross-view « open in Create » links used to be lost; with Create not mounted the request goes to its mailbox and the view switches.
  useEffect(() => {
    const forward = (event) => {
      if (pagesMonte > 0) return
      setView('pages')
      poserDemandePages(event.type, event.detail)
    }
    const types = ['zr:create-folder', 'zr:open-ref-board', 'zr:open-page', 'zr:open-folder']
    for (const type of types) window.addEventListener(type, forward)
    return () => { for (const type of types) window.removeEventListener(type, forward) }
  }, [])
  useEffect(() => { // ZenRay Assets (2026-09-10) : `?folder=<chemin>` ouvre Create sur un DOSSIER, jamais
    // une page. Jumeau exact de l'effet `?page=` ci-dessus : `zr:open-page` appelle toujours `openPage`,
    // qui traite le chemin comme une page à charger dans l'éditeur et créerait une page VIDE sur un
    // dossier d'archive (payé une fois, corrigé ici plutôt que contourné). `zr:open-folder` cible le
    // même geste que `pickCrumb` dans Create : `setFolder` + `setCur(null)`.
    if (typeof window === 'undefined') return
    const wanted = new URLSearchParams(window.location.search).get('folder')
    if (!wanted || !wanted.startsWith('pages/')) return
    setView('pages')
    const emit = () => window.dispatchEvent(new CustomEvent('zr:open-folder', { detail: { path: wanted } }))
    const timer = setTimeout(emit, 60)
    try { window.history.replaceState({}, '', window.location.pathname) } catch { /* sans effet */ }
    return () => clearTimeout(timer)
  }, [])
  useEffect(() => { // ZenRayMedia (2026-07-25) : ouvrir un .zmedia.json depuis Create bascule sur la vue
    // Media. MediaApp écoute le MÊME événement pour charger le document -- un seul signal, deux
    // auditeurs, aucun couplage direct entre les deux composants (patron de `zr:create-music`).
    const h = () => setView('media')
    window.addEventListener('zr:media-open', h); return () => window.removeEventListener('zr:media-open', h)
  }, [])
  useEffect(() => { // DEEP LINK Shelf (extension Chrome / bookmarklet) : ?shelfAdd=<imgUrl>&shelfName=&shelfCat=
    if (typeof window === 'undefined') return // -> bascule sur Shelf et ouvre la modale Ajouter pré-remplie (l'app,
    const p = new URLSearchParams(window.location.search) //    déjà déverrouillée, fait l'ingestion publique).
    const img = p.get('shelfAdd')
    if (!img) return
    try { localStorage.setItem('zr:shelf:add', JSON.stringify({ image: img, name: p.get('shelfName') || '', cat: p.get('shelfCat') || '' })) } catch {}
    window.history.replaceState({}, '', '/'); setView('shelf')
  }, [])

  useEffect(() => { loadState().then(({ state, store }) => { setState({ ...EMPTY, ...state }); setStore(store); setLoaded(true) }) }, [])
  const pendingStateRef = useRef(state)
  useEffect(() => { pendingStateRef.current = state }, [state])
  useEffect(() => {
    if (!loaded) return undefined
    const timer = setTimeout(() => saveState(state), 700)
    return () => clearTimeout(timer)
  }, [state, loaded])
  useEffect(() => () => { if (loaded) saveState(pendingStateRef.current) }, [loaded])

  const t = THEMES[state.theme === 'dark' ? 'dark' : 'light']
  const toggleStep = (objId, i) => setState((prev) => {
    const key = `${objId}|${i}`
    const steps = { ...prev.steps }
    if (steps[key]) delete steps[key]; else steps[key] = true
    return { ...prev, steps }
  })
  const addCard = (obj, domain, date) => {
    const id = uid()
    const card = { id, title: obj ? obj.title : 'Nouvelle carte', note: '', date, objId: obj ? obj.id : null, domain: domain || '', done: !!obj, images: [] }
    setState((prev) => ({ ...prev, cards: [...prev.cards, card] }))
    return id
  }
  const moveCard = (cardId, date) => setState((prev) => ({ ...prev, cards: prev.cards.map((card) => card.id === cardId ? { ...card, date } : card) }))
  // Chemin chaud (textarea note) : mise à jour immuable ciblée, sans structuredClone de tout LifeOS à chaque frappe.
  const editCard = (cardId, fields) => setState((prev) => ({ ...prev, cards: prev.cards.map((card) => card.id === cardId ? { ...card, ...fields } : card) }))
  const delCard = (cardId) => { setState((prev) => ({ ...prev, cards: prev.cards.filter((card) => card.id !== cardId) })); if (sel === cardId) setSel(null) }
  const setTheme = (theme) => setState((prev) => ({ ...prev, theme }))
  const addImages = async (cardId, files) => {
    const urls = []
    for (const f of files) {
      if (!f.type || !f.type.startsWith('image/')) continue
      const webp = await fileToWebp(f); if (!webp) continue
      const hosted = await uploadImage(webp, f.name).catch(() => null)
      urls.push(hosted || webp)
    }
    if (urls.length) setState((prev) => ({
      ...prev,
      cards: prev.cards.map((card) => card.id === cardId ? { ...card, images: [...(card.images || []), ...urls] } : card),
    }))
  }
  const removeImage = (cardId, idx) => setState((prev) => ({
    ...prev,
    cards: prev.cards.map((card) => card.id === cardId ? { ...card, images: (card.images || []).filter((_, imageIndex) => imageIndex !== idx) } : card),
  }))

  const todayY = ymd(new Date())
  const selectedCard = state.cards.find((c) => c.id === sel) || null

  return (
