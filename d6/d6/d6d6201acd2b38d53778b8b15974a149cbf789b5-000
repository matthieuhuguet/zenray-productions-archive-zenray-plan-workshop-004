/* ───────── Trash (corbeille des pages, restaurable) ───────── */
function Trash({ t }) {
  const [paths, setPaths] = useState(null)
  const [status, setStatus] = useState('')
  const load = () => fetch('/api/page?action=tree&dir=trash', { cache: 'no-store' }).then((r) => r.json()).then((j) => setPaths(j.paths || [])).catch(() => setPaths([]))
  useEffect(() => { load() }, [])
  // Fichiers d'un nœud en corbeille, selon son type. Une page = .md + 3 jumeaux ; image/média/base = descripteur seul.
  const variants = (p) => nodeFilesForPath(p)
  // COPIER PUIS SUPPRIMER, DANS CET ORDRE, ET JAMAIS SUPPRIMER SI LA COPIE A ÉCHOUÉ.
  // `apiPost` levait autrefois zéro erreur sur un 500 ou un quota épuisé : la copie échouait en
  // silence et la suppression s'exécutait quand même, ce qui détruisait la page qu'on restaurait.
  // Elle lève désormais (voir src/lib/apiPost.js) ; le `await` suffit donc à barrer la suppression,
  // et ce commentaire est là pour que personne ne réintroduise un `.catch(() => {})` sur le save.
  const move = async (src, dst, del) => {
    const r = await fetch(`/api/page?action=read&path=${encodeURIComponent(src)}`, { cache: 'no-store' }).then((x) => x.json()).catch(() => null)
    if (!r || !r.sha || r.missing) return
    if (dst) await apiPost('save', { path: dst, markdown: r.markdown })
    if (del) await apiPost('delete', { path: src, sha: r.sha })
  }
  const restore = async (p) => {
    setStatus('restauration…')
    try {
      for (const src of variants(p)) await move(src, 'pages/' + src.replace(/^trash\//, ''), true)
      await delTrashFile(p + '.zrtrash.json')
      setStatus('restaurée ✓')
    } catch (e) {
      // L'échec se DIT. Sans ce catch, le statut restait sur « restauration… » indéfiniment et
      // Matthieu croyait l'opération en cours alors qu'elle était morte.
      setStatus('restauration impossible : ' + (e && e.message ? e.message : 'cause inconnue') + ' — rien n a été supprimé')
    }
    load()
  }
  // Lit le descripteur (depuis trash/) d'un nœud à purger. Renvoie l'objet manifeste parsé, ou null.
  const readManifestFromTrash = async (p) => {
    const r = await fetch(`/api/page?action=read&path=${encodeURIComponent(p)}`, { cache: 'no-store' }).then((x) => x.json()).catch(() => null)
    if (!r || r.missing || !r.markdown) return null
    try { return JSON.parse(r.markdown) } catch { return null }
  }
  // Supprime un fichier de trash/ par son chemin (lit le sha puis delete). Sert au sidecar + aux fichiers HLS.
  // Rend `true` quand le fichier a REELLEMENT ete retire (ou qu'il n'existait deja plus), `false`
  // quand la suppression a echoue. Le `.catch(() => {})` d'origine avalait l'echec, si bien que la
  // notification de fin annoncait un succes que personne n'avait verifie.
  const delTrashFile = async (path) => {
    const r = await fetch(`/api/page?action=read&path=${encodeURIComponent(path)}`, { cache: 'no-store' }).then((x) => x.json()).catch(() => null)
    if (!r || !r.sha || r.missing) return true          // rien a supprimer : ce n'est pas un echec
    try { await apiPost('delete', { path, sha: r.sha }); return true } catch { return false }
  }
  // Suppression DÉFINITIVE depuis la corbeille.
  //  - Retire le descripteur + ses jumeaux + le sidecar du drive PRIVÉ zenray-data.
  //  - chunked-media : l'action delete serveur purge déjà les parts media/<id>/*.bin (dossier UNIQUE, jamais partagé).
  //  - image : le binaire ab/cd/<sha>.<ext> (+ vignette .webp) sur zenray-media-NN n'est supprimé QUE si plus aucun
  //    autre nœud .img.json vivant ne référence l'empreinte (refcount serveur) -> ne casse jamais un média partagé.
  //  - hls : on retire master/playlists/clé AES du privé ; les segments PUBLICS (jsDelivr, adressés par contenu)
  //    restent et sont balayés plus tard (refcount inter-vidéos non fait à la volée).
  const purge = async (p) => {
    const expected = stripLeafExt(p).split('/').pop()
    const typed = window.prompt(`Suppression DÉFINITIVE et irréversible.\nRetape exactement « ${expected} » pour confirmer.`)
    if (typed !== expected) return
    setStatus('suppression…')
    const kind = trashKind(p)
    const man = await readManifestFromTrash(p) // descripteur lu AVANT suppression (besoin du repo/hash/segments)
    // SIDECAR = source de vérité pour repo/hash/drive/taille (figés au moment du trash par sidecarFor).
    // On le lit en priorité ; on retombe sur le manifeste seulement si le sidecar manque (ancien nœud,
    // ou trash hors flux App). Une seule vérité : si le manifeste a changé après le trash, le sidecar prime.
    const side = await readManifestFromTrash(p + '.zrtrash.json')
    let driveLabel = 'zenray-data'
    let binaryNote = ''

    // 1) IMAGE : tenter de retirer le binaire du shard avec garde de refcount.
    if (kind === 'image' && man && man.repo && typeof man.path === 'string') {
      const repo = (side && side.originalRepo) || man.repo
      const hash = (side && side.contentHash) || (man.path.match(/([0-9a-f]{16,64})\.[A-Za-z0-9]+$/) || [])[1]
      const ext = (man.path.match(/\.([A-Za-z0-9]+)$/) || [])[1]
      const decBytes = (side && typeof side.fileSize === 'number' ? side.fileSize : null) ?? man.size ?? 0
      if (hash) {
        const paths = [man.path]
        if (ext && ext !== 'webp') paths.push(man.path.replace(/\.[A-Za-z0-9]+$/, '.webp')) // vignette dérivée
        const r = await fetch('/api/upload-shard', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'purge-binary', repo, hash, paths, decBytes }) }).then((x) => x.json()).catch(() => null)
        driveLabel = repo
        if (r && r.ok && Array.isArray(r.deleted) && r.deleted.length) binaryNote = `Le binaire a été supprimé définitivement du drive ${repo}.`
        else if (r && r.refs > 0) binaryNote = `Le binaire reste sur ${repo} : il est encore partagé par ${r.refs} autre(s) contenu(s).`
        else binaryNote = `Le binaire reste sur ${repo} (adressé par contenu) et sera nettoyé lors d'un balayage.`
      }
    }
    // 2) HLS : retirer les fichiers auxiliaires (master, playlists, clé AES) du privé. Segments publics balayés plus tard.
    if (kind === 'média' && man && man.type === 'hls') {
      // master + clé AES sont des fichiers .m3u8 / clé (PAS des types de nœud) : trashTwins ne les déplace
      // donc pas dans trash/, ils restent à leur emplacement d'origine sous pages/ (chemins portés par le
      // manifeste : man.master, man.keyPath). On les supprime ICI directement à leur emplacement réel.
      // La clé AES (privée) est l'élément sensible : on s'assure de la retirer QUELLE QUE SOIT la voie de
      // mise en corbeille. Selon le chemin (fichier seul vs dossier via move-tree), master/keyPath peuvent
      // pointer sous pages/ (emplacement d'origine, non déplacé) OU sous trash/ (réécrit par move-tree). On
      // accepte les DEUX préfixes pour garantir la purge de la clé AES privée.
      const aux = new Set()
      for (const rel of [man.master, man.keyPath].filter((x) => typeof x === 'string' && (x.startsWith('pages/') || x.startsWith('trash/')))) aux.add(rel)
      for (const a of aux) await delTrashFile(a)
      // Drive réel dérivé du manifeste (jamais codé en dur) : cdnRepo (segments publics jsDelivr) sinon repo.
      driveLabel = man.cdnRepo || man.repo || 'zenray-vid-NN'
      binaryNote = `Les segments publics (jsDelivr, adressés par contenu) restent sur ${driveLabel} et seront nettoyés lors d'un balayage.`
    }

    // 3) Retirer le descripteur + jumeaux (chunked-media : delete serveur purge aussi les parts) + le sidecar.
    // On COMPTE les echecs au lieu de supposer le succes. Une suppression definitive qui n'a pas eu
    // lieu et qui s'annonce comme faite est pire qu'une erreur : Matthieu croit le fichier parti du
    // drive alors qu'il y est encore.
    let echecs = 0
    for (const src of variants(p)) {
      const r = await fetch(`/api/page?action=read&path=${encodeURIComponent(src)}`, { cache: 'no-store' }).then((x) => x.json()).catch(() => null)
      if (!r || !r.sha || r.missing) continue
      try { await apiPost('delete', { path: src, sha: r.sha }) } catch { echecs++ }
    }
    if (!(await delTrashFile(p + '.zrtrash.json'))) echecs++
    if (kind === 'média' && man && man.type !== 'hls') { driveLabel = (side && side.originalRepo) || man.repo || 'zenray-media-NN'; binaryNote = `Les morceaux du média ont été supprimés définitivement du drive ${driveLabel}.` }

    setStatus(''); load()
    if (echecs) {
      notify({ big: true, icon: 'exclamationmark.triangle', tint: '#FF9500', label: 'Drive · suppression incomplète',
        title: `La suppression n'a PAS abouti (${echecs} fichier${echecs > 1 ? 's' : ''} restant${echecs > 1 ? 's' : ''})`,
        body: `« ${trashLabel(p)} » est encore sur le drive. Le quota GitHub est peut-être épuisé : réessaie plus tard, rien n'est perdu.`, ttl: 11000 })
      return
    }
    notify({ big: true, icon: 'externaldrive', tint: '#FF3B30', label: 'Drive · suppression définitive', title: 'Le contenu a bien été supprimé définitivement du drive ' + driveLabel, body: `« ${trashLabel(p)} » (${kind}) retiré du drive. ${binaryNote}`.trim(), ttl: 11000 })
  }
  // SOURCE UNIQUE (2026-08-31) : cette liste ne connaissait que db, media et img. Un plan, un board
  // Ref, une archive ou un document ZenRayMedia s affichaient donc dans la corbeille avec leur
  // extension technique, « Agenda.plan.json » au lieu d « Agenda ».
  const trashLabel = (p) => sansExtensionNoeud(p.replace(/^trash\//, ''))
  // 9 October 2026 08:07 CEST: Show the real type for every registered node in Trash.
  const TRASH_KIND_LABELS = { page: 'page', image: 'image', media: 'média', db: 'table', canvas: 'board', embed: 'lien', file: 'fichier', plan: 'calendrier', zmedia: 'document média', comment: 'commentaire' }
  const trashKind = (p) => TRASH_KIND_LABELS[typeOfPath(p)] || 'fichier'
  return (
    <>
      <SectionLabel t={t} color={t.textSecondary} nomargin>Trash <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', opacity: 0.6 }}>· {paths ? paths.length : 0} · {status}</span></SectionLabel>
      <div style={{ marginTop: 14, display: 'grid', gap: 6 }}>
        {paths === null && <div style={{ color: t.textSecondary }}>chargement…</div>}
        {paths && paths.length === 0 && <div style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-md)' }}>Corbeille vide.</div>}
        {paths && paths.map((p) => (
          <div key={p} style={{ ...card(t), padding: '10px 14px', display: 'flex', alignItems: 'center', gap: 10 }}>
            <span style={{ flex: 1, fontFamily: FONTS.serif, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{trashLabel(p)}</span>
            <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: t.textSecondary, textTransform: 'uppercase', letterSpacing: 0.5, flex: '0 0 auto' }}>{trashKind(p)}</span>
            <button onClick={() => restore(p)} style={{ ...btn(t) }}>Restaurer</button>
            <button onClick={() => purge(p)} style={{ ...btn(t), color: PALETTE.red, borderColor: PALETTE.red }}>Supprimer définitivement</button>
          </div>
        ))}
      </div>
    </>
  )
}

