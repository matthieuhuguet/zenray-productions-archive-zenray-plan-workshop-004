// 10 October 2026, 13:46 CEST: Expose only audio tracks that the active playback engine can actually switch.
const LANGUAGE_LABELS = { fr: 'Français', fre: 'Français', fra: 'Français', en: 'English', eng: 'English', ja: '日本語', jpn: '日本語' }
const trackLabel = (track, index) => {
  const name = track.name || track.label || track.labels?.[0]?.text
  const language = track.lang || track.language
  return (name && !/^audio[_-]?\d+$/i.test(name) ? name : null) || LANGUAGE_LABELS[language] || language || name || `Audio ${index + 1}`
}

// 11 October 2026: the manifest lists every audio track of the film (manifest.audio, or probe.audio on older ones).
// FR : la liste du manifeste sert de repli quand le moteur n'expose aucune piste, pour que l'option Audio soit toujours visible.
export function manifestAudioTracks(manifest) {
  const list = Array.isArray(manifest?.audio) && manifest.audio.length ? manifest.audio
    : (Array.isArray(manifest?.probe?.audio) ? manifest.probe.audio : [])
  return list.map((track, index) => ({
    index, selected: index === 0, fixed: true,
    label: trackLabel({ name: track.label && track.label !== track.lang ? track.label : null, lang: track.lang }, index),
  }))
}

// 11 October 2026: what the Audio menu shows: the engine's tracks when it has any, otherwise the manifest's list.
// 12 October 2026: an engine label that says nothing ("audio_1") is replaced by the manifest's language label.
// FR : un libelle moteur vide de sens ("audio_1") est remplace par le libelle de langue du manifeste.
const GENERIC_AUDIO_LABEL = /^audio[_-]?\d+$/i
export function menuAudioTracks(engineTracks, manifest) {
  if (!engineTracks.length) return manifestAudioTracks(manifest)
  const named = manifestAudioTracks(manifest)
  return engineTracks.map((track, i) => (GENERIC_AUDIO_LABEL.test(String(track.label || '')) && named[i] ? { ...track, label: named[i].label } : track))
}

export function readAudioTracks(engine, video) {
  let tracks = [], selected = -1
  if (engine?.kind === 'hls') {
    tracks = engine.api.audioTracks || []
    selected = engine.api.audioTrack
  } else if (engine?.kind === 'dash') {
    tracks = engine.api.getTracksFor('audio') || []
    const current = engine.api.getCurrentTrackFor('audio')
    selected = tracks.findIndex((track) => track === current || (current && track.index === current.index && track.lang === current.lang))
  } else if (video?.audioTracks) {
    tracks = Array.from(video.audioTracks)
    selected = tracks.findIndex((track) => track.enabled)
  }
  return tracks.map((track, index) => ({ index, label: trackLabel(track, index), selected: index === selected }))
}

export function selectAudioTrack(engine, video, index) {
  const tracks = readAudioTracks(engine, video)
  if (!Number.isInteger(index) || index < 0 || index >= tracks.length) throw new Error('Audio track is unavailable')
  if (engine?.kind === 'hls') engine.api.audioTrack = index
  else if (engine?.kind === 'dash') engine.api.setCurrentTrack(engine.api.getTracksFor('audio')[index])
  else {
    for (let i = 0; i < video.audioTracks.length; i++) video.audioTracks[i].enabled = i === index
  }
}
