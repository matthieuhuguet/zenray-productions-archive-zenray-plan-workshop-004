function mockApi({ overview = OVERVIEW, status = 200, extra = {} } = {}) {
  const calls = []
  const f = vi.fn(async (url, init = {}) => {
    const u = new URL(String(url)); const path = u.pathname + u.search; const method = init.method || 'GET'
    calls.push({ method, path, body: init.body ? JSON.parse(init.body) : null })
    for (const [k, v] of Object.entries(extra)) { const [m, p] = k.split(' '); if (m === method && path.startsWith(p)) return new Response(JSON.stringify(typeof v === 'function' ? v(init) : v), { status: 200 }) }
    if (u.pathname === '/v1/dashboard') return new Response(JSON.stringify(overview), { status })
    if (u.pathname === '/v1/analytics/summary') return new Response(JSON.stringify(SUMMARY), { status: 200 })
    if (u.pathname.startsWith('/v1/')) return new Response(JSON.stringify({ posts: [], accounts: [], series: [], cells: [], buckets: [], webhooks: [], apiKeys: [], apps: [], docs: [], conversations: [], engagements: [] }), { status: 200 })
    return new Response('{}', { status: 404 })
  })
  vi.stubGlobal('fetch', f)
  return { calls, f }
}

const connected = () => localStorage.setItem(POSTKIT.storageKey, JSON.stringify({ baseUrl: 'http://127.0.0.1:8787', key: 'pk_test' }))

