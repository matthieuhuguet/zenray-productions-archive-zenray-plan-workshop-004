// 14 October 2026: refreshing the index must never download the 22 MB delta just to compare its date.
import { describe, expect, it } from 'vitest'
import { peekDeltaBuiltAt } from './searchIndexClient.js'

const streamOf = (text, size = 40) => new ReadableStream({
  start(controller) { const bytes = new TextEncoder().encode(text); for (let i = 0; i < bytes.length; i += size) controller.enqueue(bytes.slice(i, i + size)); controller.close() },
})
const response = (body, init = {}) => ({ ok: init.status ? init.status < 400 : true, status: init.status || 200, body: typeof body === 'string' ? streamOf(body) : body, text: async () => String(body) })

describe('peekDeltaBuiltAt', () => {
  it('reads builtAt from the first bytes and stops reading the rest', async () => {
    let pulled = 0
    const huge = new ReadableStream({ pull(controller) { pulled += 1; controller.enqueue(new TextEncoder().encode(pulled === 1 ? '{"v":1,"builtAt":"2026-10-14T21:56:36.618Z","iv":"abc","ct":"' : 'x'.repeat(4096))); if (pulled > 5000) controller.close() } })
    const at = await peekDeltaBuiltAt(async (url, options) => { expect(options.headers.Range).toMatch(/^bytes=0-/); return response(huge) })
    expect(at).toBe('2026-10-14T21:56:36.618Z')
    expect(pulled).toBeLessThan(10)
  })
  it('treats a missing or empty delta as an empty date, like the full download did', async () => {
    expect(await peekDeltaBuiltAt(async () => response('', { status: 404 }))).toBe('')
    expect(await peekDeltaBuiltAt(async () => response('{"v":1,"builtAt":"2026-10-14T00:00:00.000Z"}'))).toBe('')
  })
  it('answers null when it cannot read, so the caller keeps the index it has', async () => {
    expect(await peekDeltaBuiltAt(async () => { throw new Error('offline') })).toBeNull()
    expect(await peekDeltaBuiltAt(async () => response('', { status: 503 }))).toBeNull()
  })
})
