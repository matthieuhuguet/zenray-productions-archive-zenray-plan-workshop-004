// fileKinds.js — SINGLE SOURCE extension -> MIME -> preview category. Isomorphic (no browser
// dependency), imported BOTH by the UPLOAD side (scripts/video-raw-lib.mjs mimeOf) AND by the
// VIEWER (QuickLook). One truth: a future upload and its preview can NEVER diverge on type.
// Extend HERE = cover upload + playback in one move.

// MIME by extension (lowercase, no dot). Exhaustive on popular formats.
export const MIME_BY_EXT = {
  // audio
  wav: 'audio/wav', mp3: 'audio/mpeg', m4a: 'audio/mp4', flac: 'audio/flac', ogg: 'audio/ogg', oga: 'audio/ogg',
  aac: 'audio/aac', aiff: 'audio/aiff', aif: 'audio/aiff', opus: 'audio/opus', wma: 'audio/x-ms-wma', weba: 'audio/webm',
  // video
  mp4: 'video/mp4', m4v: 'video/mp4', mov: 'video/quicktime', webm: 'video/webm', mkv: 'video/x-matroska',
  avi: 'video/x-msvideo', flv: 'video/x-flv', wmv: 'video/x-ms-wmv', mpg: 'video/mpeg', mpeg: 'video/mpeg', '3gp': 'video/3gpp',
  // image
  jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', gif: 'image/gif', webp: 'image/webp', avif: 'image/avif',
  bmp: 'image/bmp', svg: 'image/svg+xml', ico: 'image/x-icon', jfif: 'image/jpeg', heic: 'image/heic', heif: 'image/heif',
  tif: 'image/tiff', tiff: 'image/tiff', dng: 'image/x-adobe-dng', psd: 'image/vnd.adobe.photoshop',
  // documents
  pdf: 'application/pdf', epub: 'application/epub+zip', rtf: 'application/rtf',
  doc: 'application/msword', docx: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
  xls: 'application/vnd.ms-excel', xlsx: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
  ppt: 'application/vnd.ms-powerpoint', pptx: 'application/vnd.openxmlformats-officedocument.presentationml.presentation',
  // text
  txt: 'text/plain', md: 'text/markdown', markdown: 'text/markdown', csv: 'text/csv', tsv: 'text/tab-separated-values',
  log: 'text/plain',
  // code (served as text/plain for <pre> preview, language kept separately)
  js: 'text/javascript', mjs: 'text/javascript', cjs: 'text/javascript', ts: 'text/plain', tsx: 'text/plain', jsx: 'text/plain',
  py: 'text/x-python', rb: 'text/x-ruby', php: 'text/x-php', java: 'text/x-java', c: 'text/x-c', h: 'text/x-c',
  cpp: 'text/x-c++', cc: 'text/x-c++', hpp: 'text/x-c++', cs: 'text/x-csharp', go: 'text/x-go', rs: 'text/x-rust',
  swift: 'text/x-swift', kt: 'text/x-kotlin', scala: 'text/x-scala', sh: 'text/x-sh', bash: 'text/x-sh', zsh: 'text/x-sh',
  lua: 'text/x-lua', r: 'text/x-r', sql: 'text/x-sql', html: 'text/html', htm: 'text/html', css: 'text/css',
  scss: 'text/x-scss', json: 'application/json', yaml: 'text/yaml', yml: 'text/yaml', toml: 'text/x-toml',
  xml: 'text/xml', ini: 'text/plain', env: 'text/plain', conf: 'text/plain', cube: 'text/plain', vue: 'text/plain', svelte: 'text/plain',
  dart: 'text/x-dart', graphql: 'text/plain', gql: 'text/plain', dockerfile: 'text/plain', gitignore: 'text/plain',
  // archives / 3D / binary
  zip: 'application/zip', tar: 'application/x-tar', gz: 'application/gzip', '7z': 'application/x-7z-compressed', rar: 'application/x-rar',
  glb: 'model/gltf-binary', gltf: 'model/gltf+json', obj: 'model/obj', stl: 'model/stl', fbx: 'model/fbx',
}

// Extensions treated as CODE/TEXT even when the mime is not text/* (<pre> preview).
const TEXTUAL_EXT = new Set(['md', 'markdown', 'txt', 'csv', 'tsv', 'log', 'json', 'yaml', 'yml', 'toml', 'xml', 'html', 'htm', 'css', 'scss',
  'js', 'mjs', 'cjs', 'ts', 'tsx', 'jsx', 'py', 'rb', 'php', 'java', 'c', 'h', 'cpp', 'cc', 'hpp', 'cs', 'go', 'rs', 'swift', 'kt',
  'scala', 'sh', 'bash', 'zsh', 'lua', 'r', 'sql', 'ini', 'env', 'conf', 'cube', 'vue', 'svelte', 'dart', 'graphql', 'gql', 'dockerfile', 'gitignore'])

export const extOf = (name) => (String(name || '').match(/\.([a-z0-9]+)$/i) || [, ''])[1].toLowerCase()
export const mimeForName = (name) => MIME_BY_EXT[extOf(name)] || 'application/octet-stream'

// Preview category — drives viewer rendering. 'lib' = needs a dynamic (lazy) decoder.
export function kindForName(name) {
  const e = extOf(name)
  const mime = MIME_BY_EXT[e] || ''
  if (mime.startsWith('audio/')) return 'audio'
  if (mime.startsWith('video/')) return 'video'
  // PSD deliberately excluded: LibFilePreview routes image-lib to the TIFF decoder (UTIF), and a
  // PSD (a proper Adobe format, never TIFF) would ALWAYS fail decoding -> better the immediate
  // "no preview" message (default 'binary' category) than a decode attempt doomed to fail. DNG
  // stays image-lib: many DNGs are TIFF/EP-based and genuinely decode via UTIF.
  if (e === 'heic' || e === 'heif' || e === 'tif' || e === 'tiff' || e === 'dng') return 'image-lib'
  if (mime.startsWith('image/')) return 'image'
  if (e === 'pdf') return 'pdf'
  if (TEXTUAL_EXT.has(e)) return 'text'
  if (e === 'docx' || e === 'doc' || e === 'rtf') return 'doc-lib'
  if (e === 'xlsx' || e === 'xls') return 'sheet-lib'
  if (e === 'pptx' || e === 'ppt') return 'slides-lib'
  if (e === 'epub') return 'epub-lib'
  if (e === 'glb' || e === 'gltf' || e === 'obj' || e === 'stl' || e === 'fbx') return '3d-lib'
  if (e === 'zip' || e === 'tar' || e === 'gz' || e === '7z' || e === 'rar') return 'archive'
  return 'binary'
}

// NATIVE preview possible (no dependency)?
export const isNativePreview = (name) => ['audio', 'video', 'image', 'pdf', 'text'].includes(kindForName(name))
