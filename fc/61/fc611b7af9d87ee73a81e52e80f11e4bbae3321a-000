// PHOTOS WAITING TO BE SENT SURVIVE A RELOAD (2 October 2026). A phone kills background tabs without warning: when the guest comes back, the
// page reloads and anything still in the queue would be lost. The queue is kept in IndexedDB (the photos themselves, as Blobs) and picked up
// again by the same share link. Best-effort and bounded (BUDGET_BYTES): a failure here only means the guest re-selects the photos, and the
// ones already sent are recognised by their hash and not sent twice.
const DB = 'zr-guest-upload'
const STORE = 'pending'
export const BUDGET_BYTES = 200 * 1024 * 1024

const open = () => new Promise((resolve, reject) => {
  if (typeof indexedDB === 'undefined') return reject(new Error('no-idb'))
  const r = indexedDB.open(DB, 1)
  r.onupgradeneeded = () => r.result.createObjectStore(STORE, { keyPath: 'key' })
  r.onsuccess = () => resolve(r.result)
  r.onerror = () => reject(r.error)
})
const tx = async (mode, fn) => {
  const db = await open()
  return new Promise((resolve, reject) => {
    const t = db.transaction(STORE, mode); const s = t.objectStore(STORE)
    let out; try { out = fn(s) } catch (e) { reject(e); return }
    t.oncomplete = () => { db.close(); resolve(out && out.result !== undefined ? out.result : undefined) }
    t.onerror = () => { db.close(); reject(t.error) }
  })
}
export const tokenKey = (token) => String(token).slice(-24)

// The bytes already kept are counted in memory (and filled from the database once), so adding hundreds of photos never re-reads the store.
const sizes = new Map()            // `${tokenId}|${tag}` -> bytes
let primed = false
const sumFor = (token) => { let n = 0; for (const [k, v] of sizes) if (k.startsWith(`${tokenKey(token)}|`)) n += v; return n }
export async function listPending(token) {
  try {
    const all = await tx('readonly', (s) => s.getAll())
    const mine = (all || []).filter((r) => r.tokenId === tokenKey(token))
    for (const r of mine) sizes.set(r.key, r.size || 0)
    primed = true
    return mine
  } catch { return [] }
}
/** Stores one photo for later; resolves false (never throws) when it does not fit or storage is unavailable. */
export async function savePending(token, tag, file, { rel = '', sub = '' } = {}) {
  try {
    if (!primed) await listPending(token)
    if (sumFor(token) + (file.size || 0) > BUDGET_BYTES) return false
    const key = `${tokenKey(token)}|${tag}`
    sizes.set(key, file.size || 0)
    await tx('readwrite', (s) => s.put({ key, tokenId: tokenKey(token), tag, name: file.name, size: file.size, lastModified: file.lastModified || 0, rel, sub, blob: file }))
    return true
  } catch { return false }
}
export async function removePending(token, tag) {
  sizes.delete(`${tokenKey(token)}|${tag}`)
  try { await tx('readwrite', (s) => s.delete(`${tokenKey(token)}|${tag}`)) } catch { /* nothing to clean */ }
}
