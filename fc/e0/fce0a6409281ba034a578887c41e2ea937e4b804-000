import React from 'react'
import { fireEvent, render, screen } from '@testing-library/react'
import { describe, expect, it, vi } from 'vitest'
import { nextAvailableSlot, STANDARD_SLOTS } from './planSlots.js'

describe('Plan Time Picker & Slotting UI (20 October 2026)', () => {
  it('identifies next 90m slot when previous tasks exist', () => {
    const tasks = [
      { id: '1', title: 'Work', date: '2026-10-22', startTime: '09:00', durationMin: 90, status: 'planned' },
    ]
    expect(nextAvailableSlot(tasks, '2026-10-22')).toBe('10:30')
  })

  it('standard slots contain 9:00, 10:30, 12:00 etc', () => {
    expect(STANDARD_SLOTS).toContain('09:00')
    expect(STANDARD_SLOTS).toContain('10:30')
    expect(STANDARD_SLOTS).toContain('12:00')
    expect(STANDARD_SLOTS).toContain('13:30')
  })
})
