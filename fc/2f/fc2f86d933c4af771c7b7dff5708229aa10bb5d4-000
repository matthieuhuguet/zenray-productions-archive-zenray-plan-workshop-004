/* 14 October 2026: trio typography (InterVariable 400 for the interface, AnthropicSerif 400 for every visible number); the card uses
   the sidebar glass (.zr-liquid, rim included) with the sidebar's 30 px radius family. FR : trio typographique, verre de la sidebar. */
.zr-upload-timing { display: grid; grid-template-columns: 1fr auto; gap: 8px 12px; align-items: center; margin: 0 0 12px; padding: var(--zr-upload-pad, 14px 18px); border-radius: var(--zr-upload-radius, 22px); font-family: var(--zr-police-sans); font-weight: var(--zr-poids-sans, 400); font-size: var(--zr-upload-size, 14px); color: var(--zr-upload-ink, inherit); }
.zr-upload-timing-message { grid-column: 1; margin: 0; }
.zr-upload-timing-toggle { grid-column: 2; grid-row: 1; justify-self: end; border: 0; background: transparent; color: inherit; font: inherit; opacity: 0.65; cursor: pointer; padding: 2px 8px; border-radius: 99px; }
.zr-upload-timing-toggle:hover { opacity: 1; background: rgba(127, 127, 127, 0.14); }
.zr-upload-timing-track { height: var(--zr-upload-bar, 6px); border-radius: 999px; background: var(--zr-upload-track, rgba(127, 127, 127, 0.2)); overflow: hidden; }
.zr-upload-timing-fill { height: 100%; border-radius: 999px; background: var(--zr-upload-accent, #cc7c5e); transition: width 0.4s ease; }
.zr-upload-timing[data-done='true'] .zr-upload-timing-fill, .zr-upload-timing-pill[data-done='true'] { --zr-upload-accent: var(--zr-upload-done, #4a9a6a); }
.zr-upload-timing[data-done='true'] .zr-upload-timing-fill { background: var(--zr-upload-done, #4a9a6a); }
.zr-upload-timing-percent { font-family: var(--zr-police-serif); font-weight: var(--zr-poids-nombres, 400); }
.zr-upload-timing[data-held='true'] { opacity: 0.7; }
.zr-upload-timing-pill { display: inline-flex; gap: 8px; align-items: center; margin: 0 0 12px; padding: 6px 14px; border: 0; border-radius: 99px; font-family: var(--zr-police-sans); font-size: var(--zr-upload-size, 14px); color: inherit; cursor: pointer; }
.zr-upload-timing-files { grid-column: 1 / -1; margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; max-height: 220px; overflow-y: auto; }
.zr-upload-timing-files li { display: flex; justify-content: space-between; gap: 12px; font-size: calc(var(--zr-upload-size, 14px) * 0.93); }
.zr-upload-timing-file { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zr-upload-timing-stage { flex: none; opacity: 0.75; text-align: right; }
.zr-upload-timing-detail { display: block; font-size: 0.85em; opacity: 0.8; }
.zr-upload-timing-files li[data-stage='done'] .zr-upload-timing-stage { color: var(--zr-upload-done, #4a9a6a); opacity: 1; }
.zr-upload-timing-files li[data-stage='failed'] .zr-upload-timing-stage { color: #c0563f; opacity: 1; }
.zr-upload-timing-files li[data-stage='waiting'] { opacity: 0.55; }
