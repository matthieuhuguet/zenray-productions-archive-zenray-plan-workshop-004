// 30 September 2026, 19:45 Europe/Paris: Display the archived source text when a vacancy is opened.
import React, { useEffect, useState } from 'react'
import { urlLectureAffichage } from '../lib/urlLecture.js'

const CONFIG = { cacheMs: 5 * 60 * 1000, textSize: 16, lineHeight: 1.65, gap: 18, radius: 8 }
const cache = new Map()

// 30 September 2026, 20:03 Europe/Paris: Retain the system's regular serif weight for source numerals.
function SourceContent({ text }) {
  return text.split(/(\d+)/).map((part, index) => /^\d+$/.test(part) ? <span key={index} style={{ fontWeight: 400 }}>{part}</span> : part)
}

export default function FreelanceOfferDetails({ path, t }) {
  const [state, setState] = useState({ loading: true })
  const [attempt, setAttempt] = useState(0)
  useEffect(() => {
    if (!path) return
    let alive = true
    setState({ loading: true })
    const cached = cache.get(path)
    async function load() {
      try {
        let data = cached && Date.now() - cached.at < CONFIG.cacheMs ? cached.data : null
        if (!data) {
          const response = await fetch(urlLectureAffichage(path), { cache: 'no-cache' })
          if (!response.ok) throw new Error('La source ne se charge pas pour le moment.')
          const result = await response.json()
          if (result.missing || typeof result.markdown !== 'string') throw new Error('Le détail de cette offre est indisponible.')
          data = JSON.parse(result.markdown)
          if (!Array.isArray(data.sections) || !data.sections.length || data.sections.some((section) => typeof section.text !== 'string' || typeof section.heading !== 'string')) {
            throw new Error('Le détail de cette offre ne peut pas être lu.')
          }
          cache.set(path, { at: Date.now(), data })
        }
        if (alive) setState({ data })
      } catch (error) {
        if (alive) setState({ error: error.message })
      }
    }
    load()
    return () => { alive = false }
  }, [path, attempt])
  if (!path) return null
  const data = state.data
  return (
    <details open style={{ border: `1px solid ${t.border}`, borderRadius: CONFIG.radius, background: t.surface, padding: '16px 18px', marginBottom: 24 }}>
      <summary style={{ cursor: 'pointer', fontFamily: 'var(--zr-police-serif)', fontWeight: 350, fontSize: 22 }}>Offre complète</summary>
      {state.loading && <p style={{ fontFamily: 'var(--zr-police-sans)', color: t.textSecondary }}>Chargement de l’annonce…</p>}
      {state.error && <div role="alert" style={{ marginTop: 14, fontFamily: 'var(--zr-police-sans)' }}>
        <p>{state.error}</p>
        <button type="button" onClick={() => setAttempt((value) => value + 1)} style={{ background: 'transparent', border: `1px solid ${t.border}`, borderRadius: CONFIG.radius, color: t.textPrimary, cursor: 'pointer', padding: '8px 12px', font: 'inherit' }}>Réessayer</button>
      </div>}
      {data && <>
        <p style={{ color: t.textSecondary, fontFamily: 'var(--zr-police-sans)', fontSize: 12.5, margin: '12px 0 20px' }}>
          Texte de l’annonce conservé le <span style={{ fontFamily: 'var(--zr-police-serif)', fontWeight: 400 }}>{data.capturedAt}</span> · <a href={data.sourceUrl} target="_blank" rel="noreferrer" style={{ color: 'inherit' }}>Voir la source ↗</a>
        </p>
        <div style={{ display: 'grid', gap: CONFIG.gap }}>
          {data.sections.map((section, index) => <section key={index}>
            {section.heading && <h4 style={{ fontFamily: 'var(--zr-police-serif)', fontWeight: 350, fontSize: 19, margin: '0 0 8px' }}><SourceContent text={section.heading} /></h4>}
            <div style={{ fontFamily: 'var(--zr-police-serif)', fontWeight: 350, fontSize: CONFIG.textSize, lineHeight: CONFIG.lineHeight, whiteSpace: 'pre-wrap', overflowWrap: 'anywhere' }}><SourceContent text={section.text} /></div>
          </section>)}
        </div>
      </>}
    </details>
  )
}
