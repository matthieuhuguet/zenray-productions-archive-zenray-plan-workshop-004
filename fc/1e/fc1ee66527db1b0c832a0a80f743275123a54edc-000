// Recherche YouTube SANS clé Google Cloud (retour Matthieu 2026-07-17 : "pourquoi il faut l'API google...
// trouve une solution"). Utilise l'endpoint "innertube" que youtube.com sert à SON PROPRE lecteur web --
// la clé ci-dessous n'est PAS un secret : c'est une constante publique, identique pour tous les visiteurs
// de youtube.com, visible en clair dans le JS livré par YouTube et déjà réutilisée par de nombreux projets
// open-source (ytmusicapi, invidious, youtube-search-api...). Ce n'est PAS la clé "YouTube Data API v3" de
// Google Cloud (celle-là reste un vrai identifiant par compte/quota, jamais nécessaire ici).
// Honnêteté (même principe que Spotify) : endpoint non officiel, non garanti par Google, peut casser si
// YouTube change son format interne -- si ça échoue, on renvoie un tableau vide, jamais un résultat inventé.
const INNERTUBE_KEY = 'AIzaSyAO_FJ2SlqU8Q4STEHLGCilw_Y9_11qcW8'
const CONTEXT = { client: { clientName: 'WEB', clientVersion: '2.20240101.00.00' } }

function extractVideos(json) {
  try {
    const contents = json?.contents?.twoColumnSearchResultsRenderer?.primaryContents
      ?.sectionListRenderer?.contents || []
    const items = contents.flatMap((section) => section?.itemSectionRenderer?.contents || [])
    return items
      .map((item) => item.videoRenderer)
      .filter(Boolean)
      .map((v) => ({
        videoId: v.videoId,
        title: (v.title?.runs || []).map((r) => r.text).join('') || v.title?.simpleText || '',
        channel: (v.ownerText?.runs || []).map((r) => r.text).join('') || v.longBylineText?.runs?.[0]?.text || '',
        thumbnail: v.thumbnail?.thumbnails?.slice(-1)?.[0]?.url || '',
      }))
      .filter((v) => v.videoId && v.title)
  } catch { return [] }
}

export default async function handler(req, res) {
  const q = ((req.query && req.query.q) || '').toString().trim()
  if (!q) return res.status(200).json({ ok: false, error: 'no-query', results: [] })
  try {
    const r = await fetch(`https://www.youtube.com/youtubei/v1/search?key=${INNERTUBE_KEY}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ context: CONTEXT, query: q }),
    })
    if (!r.ok) return res.status(200).json({ ok: false, error: `youtube-${r.status}`, results: [] })
    const json = await r.json()
    const results = extractVideos(json).slice(0, 8)
    res.setHeader('Cache-Control', 'public, max-age=60')
    return res.status(200).json({ ok: true, results })
  } catch (e) {
    return res.status(200).json({ ok: false, error: e && e.message, results: [] })
  }
}
