// UploadTimingBanner.jsx (14 October 2026): the comment, progress bar and per-file list of an upload, in a glass card with the same
// border as the left sidebar (class zr-liquid), with a toggle to hide it. FR : carte de verre comme la sidebar, avec un bouton pour la masquer.
import './UploadTimingBanner.css'

/** report = UploadTiming.json or a queue report: { label, done, message, summary: { progress }, queue? }. */
export default function UploadTimingBanner({ report, held = false, collapsed = false, onToggle = null }) {
  if (!report || !report.message) return null
  const progress = report.done ? 1 : report.summary && Number.isFinite(report.summary.progress) ? report.summary.progress : null
  const percent = progress === null ? null : Math.round(progress * 100)
  if (collapsed) {
    return (
      <button type="button" className="zr-liquid zr-upload-timing-pill" onClick={onToggle} aria-label="Afficher l'envoi en cours" data-done={report.done ? 'true' : 'false'}>
        <span>Envoi</span>
        {percent !== null && <span className="zr-upload-timing-percent">{percent} %</span>}
      </button>
    )
  }
  return (
    <div className="zr-liquid zr-upload-timing" data-done={report.done ? 'true' : 'false'} data-held={held ? 'true' : 'false'}>
      <p className="zr-upload-timing-message">{report.message}</p>
      {onToggle && <button type="button" className="zr-upload-timing-toggle" onClick={onToggle} aria-label="Masquer l'envoi en cours" aria-pressed="true">Masquer</button>}
      <div className="zr-upload-timing-track" role="progressbar" aria-label={report.label} aria-valuemin={0} aria-valuemax={100} aria-valuenow={percent === null ? undefined : percent}>
        <div className="zr-upload-timing-fill" style={{ width: `${percent === null ? 0 : percent}%` }} />
      </div>
      {percent !== null && <span className="zr-upload-timing-percent">{percent} %</span>}
      {Array.isArray(report.queue) && report.queue.length > 0 && (
        <ul className="zr-upload-timing-files" aria-label="Fichiers de la file d'envoi">
          {report.queue.map((file) => (
            <li key={file.name} data-stage={file.stage}><span className="zr-upload-timing-file">{file.name}</span><span className="zr-upload-timing-stage">{file.label}{file.detail ? <small className="zr-upload-timing-detail">{file.detail}</small> : null}</span></li>
          ))}
        </ul>
      )}
    </div>
  )
}
