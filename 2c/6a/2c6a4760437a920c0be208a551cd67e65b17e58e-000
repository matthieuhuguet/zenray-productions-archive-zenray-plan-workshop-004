// Télécharge en local tous les posters référencés (prep self-host). Sortie: Scripts/shelf-posters/<id>.<ext>
import { readFile, writeFile, mkdir } from 'node:fs/promises'
const ROOT = new URL('../public/shelf/', import.meta.url)
const OUT = new URL('./shelf-posters/', import.meta.url)
await mkdir(OUT, { recursive: true })
const jobs = []
for (const file of ['games.json', 'anime-manga.json', 'movies.json']) {
  const data = JSON.parse(await readFile(new URL(file, ROOT), 'utf8'))
  for (const it of data.items) {
    const url = it.image && (it.image.ref || (typeof it.image === 'string' ? it.image : null))
    if (url) jobs.push({ id: it.id, url })
  }
}
let i = 0, ok = 0, fail = 0
const map = {}
async function worker() {
  while (i < jobs.length) {
    const { id, url } = jobs[i++]
    try {
      const r = await fetch(url); if (!r.ok) { fail++; continue }
      const ext = /\.png(\?|$)/i.test(url) ? 'png' : 'jpg'
      await writeFile(new URL(`${id}.${ext}`, OUT), Buffer.from(await r.arrayBuffer())); ok++; map[id] = `${id}.${ext}`
    } catch { fail++ }
  }
}
await Promise.all(Array.from({ length: 16 }, worker))
await writeFile(new URL('_map.json', OUT), JSON.stringify(map, null, 2))
console.log(`Téléchargés ${ok}/${jobs.length} (échecs ${fail})`)
