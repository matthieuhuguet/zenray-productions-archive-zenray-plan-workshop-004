import { transcodeDash, pushDash } from './video-dash-lib.mjs'
import { execSync } from 'node:child_process'
import { categoryFolder } from './lib/film-categories.mjs'

const TOKEN = execSync('gh auth token').toString().trim()
const SRC = '/Users/zenray/Downloads/Hors Normes (2019).mkv'
const DEST = `${categoryFolder('Movies')}/Hors Normes`
const BASE = 'Hors Normes (2019) (Extrait 5 min)'

const log = (...a) => console.log(...a)

log('--- Étape 1 : Transcodage DASH/HLS H.264 multi-débit (5 minutes) ---')
const r = await transcodeDash(SRC, {
  workDir: '/tmp/zr_dash_movie',
  base: BASE,
  dest: DEST,
  sampleSec: 300,
  codec: 'h264',
  segDuration: 6,
  log,
  onProgress: (stage, pct) => log(`[${stage}] ${pct.toFixed(1)}%`),
})

log('--- Transcodage terminé avec succès ---')
log('Base :', r.base)
log('Barreaux :', r.rungs)
log('Segments :', r.segments.length)
log('Dossier sortie :', r.outDir)

log('\n--- Étape 2 : Push des segments sur zenray-vid-public-01 et manifestes sur zenray-data ---')
const p = await pushDash(TOKEN, r, {
  dest: DEST,
  publicRepo: 'zenray-vid-public-01',
  contentRepo: 'zenray-data',
  title: 'Hors Normes (2019) (Extrait 5 min)',
  author: 'Olivier Nakache, Éric Toledano',
  log,
  onProgress: (stage, pct) => log(`[${stage}] ${pct}%`),
})

log('\n--- Push terminé avec succès ---')
log('Public Repo :', p.publicRepo, '@ commit :', p.commitPublic)
log('Content Repo : zenray-data @ commit :', p.commitContent)
log('Manifeste .media.json :', p.manifestPath)
log('DASH MPD :', p.mpdPath)
log('HLS Master :', p.masterPath)
