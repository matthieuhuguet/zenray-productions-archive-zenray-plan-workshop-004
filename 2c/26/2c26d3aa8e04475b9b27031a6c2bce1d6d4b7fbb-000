// 3 October 2026, 15:04 CEST: labeled paths retain exact clipboard values and explicit failure feedback.
import React, { useState } from 'react'
import Icon from '../Icon.jsx'

export default function LocationPath({ label, value, icon, onOpen, status, emptyLabel = 'Non renseigné' }) {
  const [message, setMessage] = useState('')
  const copy = async () => {
    try { await navigator.clipboard.writeText(value); setMessage('Chemin copié') }
    catch { setMessage('Copie impossible. Sélectionnez le chemin pour le copier.') }
  }
  return <div className="assets-location-path">
    <span className="assets-eyebrow"><Icon name={icon} size={14} />{label}{status && <span>{status}</span>}</span>
    <div><code title={value}>{value || emptyLabel}</code><span>{value && <button type="button" className="assets-icon-button" aria-label={`Copier ${label}`} title="Copier le chemin" onClick={copy}><Icon name="doc.on.doc" size={14} /></button>}{value && onOpen && <button type="button" className="assets-icon-button" aria-label={`Ouvrir ${label}`} title="Ouvrir" onClick={onOpen}><Icon name="arrow.up.right" size={14} /></button>}</span></div>
    {message && <small role="status">{message}</small>}
  </div>
}
