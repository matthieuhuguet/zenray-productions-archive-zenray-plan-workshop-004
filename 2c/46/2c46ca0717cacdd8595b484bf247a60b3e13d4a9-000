// 12 October 2026, 12:15 CEST: one gallery card, YouTube style: 16:9 poster, duration bottom right, version bottom
// left, title on two lines (AnthropicSerif 350), meta line with the fidelity score (numbers in AnthropicSerif 400).
// The poster comes from the catalogue (pinned jsDelivr, or a signed local URL): no read per card.
// FR : une carte de la galerie ; l'affiche vient du catalogue, aucune lecture par carte.
import React from 'react'
import { formatDuration, formatFidelity } from './motionCatalogue.js'

export default function MotionCard({ card, onOpen, selected = false, lang = 'fr', labels }) {
  const duration = formatDuration(card.durationSec)
  const fidelity = formatFidelity(card.fidelity, lang)
  return (
    <button type="button" className={`zrm-card${selected ? ' is-on' : ''}`} onClick={() => onOpen(card)} data-testid={`motion-card-${card.id}`}>
      <div className="zrm-thumb">
        {card.poster ? <img src={card.poster} alt="" loading="lazy" decoding="async" /> : <div className="zrm-thumb-empty">{card.id}</div>}
        {card.version && <span className="zrm-badge zrm-badge-left zrm-mono">{card.version}</span>}
        {duration && <span className="zrm-badge zrm-num">{duration}</span>}
      </div>
      <div className="zrm-card-body">
        <div className="zrm-card-title zrm-title">{card.title}</div>
        <div className="zrm-card-meta">
          {fidelity && <span className="zrm-num" title={card.weakest || ''}>{fidelity}</span>}
          <span><span className="zrm-num">{card.versionCount}</span> {labels.versions}</span>
          {card.source === 'local' && <span>{labels.local}</span>}
        </div>
      </div>
    </button>
  )
}
