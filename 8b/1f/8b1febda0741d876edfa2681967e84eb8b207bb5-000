// 13 October 2026: `node scripts/Assets/Resume.mjs <project-id> [--prompts N] [--iterations N] [--orders N] [--conversations N] [--max-chars N] [--json] [--write]`
// EN: prints the resume brief of a project (latest conversation, last dated prompts, iterations, order of work). --write also saves RESUME.md beside FEEDBACK.md so that any LLM, including one without the service, can read it. Works without the Assets daemon.
// FR : imprime le brief de reprise ; --write l'enregistre en RESUME.md a cote de FEEDBACK.md (fichier derive, regenere, jamais edite a la main).
import { readFile, writeFile, rename } from 'node:fs/promises'
import path from 'node:path'
import { pathToFileURL } from 'node:url'
import { config } from './BridgeClient.mjs'
import { buildResume, renderResume, RESUME_SETTINGS } from './ResumeBrief.mjs'

const readOptional = async (file, fallback) => { try { return await readFile(file, 'utf8') } catch (error) { if (error.code === 'ENOENT') return fallback; throw error } }

export async function projectResume(projectId, settings = {}) {
  if (!/^[a-z0-9][a-z0-9-]*$/.test(String(projectId || ''))) throw new Error('A valid project id is required')
  const folder = path.join(config.roots.memory, 'Projects', projectId)
  const metadata = JSON.parse(await readOptional(path.join(folder, 'Project.json'), 'null'))
  if (metadata && metadata.projectId !== projectId) throw new Error('Project memory belongs to another project')
  const feedbackPath = metadata?.feedbackPath || path.join(folder, 'FEEDBACK.md'), rulesPath = path.join(path.dirname(feedbackPath), 'Rules.md')
  const feedbackText = await readOptional(feedbackPath, null)
  if (feedbackText === null) throw new Error(`No FEEDBACK.md for ${projectId} at ${feedbackPath}`)
  const conversationIndex = JSON.parse(await readOptional(path.join(path.dirname(feedbackPath), 'ConversationIndex.json'), 'null'))
  const brief = buildResume({ projectId, feedbackText, rulesText: await readOptional(rulesPath, ''), conversationIndex, settings })
  const generatedDate = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeStyle: 'short', timeZone: 'Europe/Paris' }).format(new Date())
  return { brief, markdown: renderResume(brief, { feedbackPath, rulesPath, generatedDate }), feedbackPath, rulesPath, resumePath: path.join(path.dirname(feedbackPath), 'RESUME.md') }
}

if (import.meta.url === pathToFileURL(process.argv[1] || '').href) {
  try {
    const argv = process.argv.slice(2), projectId = argv.find(item => !item.startsWith('--') && !/^\d+$/.test(item))
    const settings = {}
    for (const key of Object.keys(RESUME_SETTINGS)) {
      const flag = `--${key.replace(/[A-Z]/g, letter => `-${letter.toLowerCase()}`)}`, position = argv.indexOf(flag)
      if (position >= 0) { const value = Number(argv[position + 1]); if (!Number.isInteger(value) || value < 0) throw new Error(`${flag} needs a whole number`); settings[key] = value }
    }
    const result = await projectResume(projectId, settings)
    if (argv.includes('--write')) { const temporary = `${result.resumePath}.${process.pid}.tmp`; await writeFile(temporary, result.markdown, { mode: 0o600 }); await rename(temporary, result.resumePath) }
    console.log(argv.includes('--json') ? JSON.stringify({ ...result.brief, resumePath: argv.includes('--write') ? result.resumePath : null }, null, 2) : result.markdown)
  } catch (error) {
    console.error(`Resume failed: ${error.message}`)
    process.exitCode = 1
  }
}
