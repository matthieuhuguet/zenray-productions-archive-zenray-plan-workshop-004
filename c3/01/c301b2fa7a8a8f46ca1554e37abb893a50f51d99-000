// .zrfolder.json — marqueur qu'un dossier "vide" existe pour git (qui ne stocke jamais un dossier sans
// fichier dedans). AVANT cette extraction, `newFolder` (création interactive depuis le Finder, menu New) ET
// `createFolderAt` (dialogue « Déplacer vers… » — nom exact, sans anti-collision ni renommage inline)
// construisaient CHACUN le même chemin de marqueur et appelaient CHACUN le même apiPost('save', ...) avec
// exactement le même corps JSON — un seul endroit doit connaître ce format.
//
// Volontairement minimal : cette fonction ne fait QUE l'écriture brute (mêmes garanties que apiPost — ne
// catch rien elle-même sauf le fetch lui-même, cf. commentaire ci-dessous). La gestion du succès/échec
// reste dans chaque appelant, car elle diverge réellement : `newFolder` fait un rollback optimiste complet
// (tuile + index + renommage inline) sur échec, `createFolderAt` retente une LECTURE du marqueur avant de
// conclure à un échec (le save peut échouer sur un sha manquant alors que le dossier existe déjà côté
// serveur — cas réel documenté dans createFolderAt). Dupliquer cette divergence ici aurait recréé une
// abstraction bancale ; ne pas la dupliquer laisse chaque appelant garder EXACTEMENT son comportement actuel.
import { apiPost, causeApi } from '../lib/apiPost.js'

export const FOLDER_MARKER_FILE = '.zrfolder.json'

export const folderMarkerPath = (dir) => `${dir}/${FOLDER_MARKER_FILE}`

// Écrit le marqueur de dossier vide. Renvoie la réponse apiPost ({ok,...}) ou null en cas d'échec réseau
// (même contrat que les ~30 sites déjà migrés vers apiPost : catch(() => null) reproduit le
// .catch(() => null) que newFolder et createFolderAt faisaient chacun avant cette extraction).
export function writeFolderMarker(dir) {
  return apiPost('save', { path: folderMarkerPath(dir), markdown: JSON.stringify({ folder: true, createdAt: Date.now() }) }).catch(causeApi)
}
