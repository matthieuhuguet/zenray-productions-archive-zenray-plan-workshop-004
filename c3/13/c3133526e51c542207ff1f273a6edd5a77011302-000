// planSlots.js (20 October 2026): 90-minute slotting logic for ZenRay Plan.
// Tasks naturally default to 90-minute blocks (or 4x15m). When a task already occupies a slot,
// new or stacked tasks automatically advance to the next available slot instead of stacking at 09:00.

export const DEFAULT_SLOT_MINUTES = 90
export const STANDARD_SLOTS = [
  '09:00',
  '10:30',
  '12:00',
  '13:30',
  '15:00',
  '16:30',
  '18:00',
  '19:30',
  '21:00',
]

export const pad2 = (n) => String(n).padStart(2, '0')

export function hhmmToMinutes(hhmm) {
  if (!hhmm || typeof hhmm !== 'string') return 9 * 60
  const [h, m] = hhmm.split(':').map(Number)
  if (Number.isNaN(h) || Number.isNaN(m)) return 9 * 60
  return h * 60 + m
}

export function minutesToHhmm(totalMinutes) {
  const norm = ((Math.round(totalMinutes) % 1440) + 1440) % 1440
  const h = Math.floor(norm / 60)
  const m = norm % 60
  return `${pad2(h)}:${pad2(m)}`
}

export function slotAfter(hhmm, durationMin = DEFAULT_SLOT_MINUTES) {
  return minutesToHhmm(hhmmToMinutes(hhmm) + durationMin)
}

export function nextAvailableSlot(tasks = [], dateIso, preferredDurationMin = DEFAULT_SLOT_MINUTES) {
  if (!dateIso) return '09:00'
  const duration = Math.max(15, preferredDurationMin || DEFAULT_SLOT_MINUTES)
  const activeTasks = (tasks || []).filter((t) => t && t.date === dateIso && t.status !== 'dropped')
  if (activeTasks.length === 0) return '09:00'

  const intervals = activeTasks.map((t) => {
    const start = hhmmToMinutes(t.startTime || '09:00')
    const dur = Math.max(15, Number(t.durationMin) || DEFAULT_SLOT_MINUTES)
    return { start, end: start + dur, title: t.title }
  })

  // Check candidate slots in sequence starting from 09:00 (540 min)
  for (const slotHhmm of STANDARD_SLOTS) {
    const slotStart = hhmmToMinutes(slotHhmm)
    const slotEnd = slotStart + duration
    const overlaps = intervals.some((inv) => inv.start < slotEnd && inv.end > slotStart)
    if (!overlaps) return slotHhmm
  }

  // If all standard slots are occupied, place after the latest task end, aligned to 15 min
  const maxEnd = Math.max(...intervals.map((i) => i.end))
  const aligned = Math.ceil(maxEnd / 15) * 15
  return minutesToHhmm(aligned)
}

export function getSlotPresets(tasks = [], dateIso, durationMin = DEFAULT_SLOT_MINUTES) {
  const duration = Math.max(15, durationMin || DEFAULT_SLOT_MINUTES)
  const activeTasks = (tasks || []).filter((t) => t && t.date === dateIso && t.status !== 'dropped')
  const intervals = activeTasks.map((t) => {
    const start = hhmmToMinutes(t.startTime || '09:00')
    const dur = Math.max(15, Number(t.durationMin) || DEFAULT_SLOT_MINUTES)
    return { start, end: start + dur, title: t.title }
  })

  return STANDARD_SLOTS.map((time) => {
    const slotStart = hhmmToMinutes(time)
    const slotEnd = slotStart + duration
    const occupying = intervals.find((inv) => inv.start < slotEnd && inv.end > slotStart)
    return {
      time,
      occupied: Boolean(occupying),
      taskTitle: occupying ? occupying.title : null,
    }
  })
}
