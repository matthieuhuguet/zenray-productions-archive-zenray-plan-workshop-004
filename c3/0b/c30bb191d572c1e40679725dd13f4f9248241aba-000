// 4 October 2026: finds the long-lived token in what `claude setup-token` prints (colours, line breaks, boxes included).
// FR : retrouve le jeton dans ce que `claude setup-token` affiche (couleurs, retours a la ligne, cadres compris).
const ANSI = /\u001b\[[0-9;?]*[ -/]*[@-~]|\u001b\][^\u0007]*\u0007/g
const TOKEN = /sk-ant-oat01-[A-Za-z0-9_-]{60,}/

export function extractToken(raw) {
  const text = String(raw || '').replace(ANSI, '').replace(/\r/g, '')
  const after = text.split(/Your OAuth token[^\n]*\n/i)[1]
  if (after) {
    // The token may be broken over several lines by a narrow terminal: join everything up to the next sentence.
    const block = after.split(/Store this token/i)[0].replace(/\s+/g, '')
    const found = block.match(TOKEN)
    if (found) return found[0]
  }
  const all = text.match(new RegExp(TOKEN.source, 'g'))
  return all ? all[all.length - 1] : ''
}
