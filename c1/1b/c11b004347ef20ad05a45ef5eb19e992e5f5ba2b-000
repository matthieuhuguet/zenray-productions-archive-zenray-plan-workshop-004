import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
import { readImgManifestCached, clearManifestCache } from './ImageNodeViewer.jsx'

// ═══ LA PASTILLE ORANGE NE DOIT JAMAIS COLLER ══════════════════════════════════════════════════
//
// Mesuré le 2026-08-31 sur les données réelles : IMG_6083 (vert) et IMG_6084 (orange) ont des liens
// valides, des registres identiques et des manifestes canoniques structurellement identiques. La
// donnée est parfaite. L'orange venait d'un échec de résolution TRANSITOIRE (rafale de tuiles) que
// le code mettait en cache comme une absence définitive — d'où une pastille figée pour la session.
//
// Ces cas gardent la distinction qui compte : transitoire = jamais mis en cache, réessayé ;
// absence confirmée par le serveur = mise en cache.

const LIEN = { v: 1, type: 'zenray-eagle-link/v1', resourceId: 'zr_x', title: 'IMG.jpeg' }
const CANON = { type: 'image', vis: 'public', cdnRepo: 'r', cdnCommit: 'c', cdnChunks: ['a'], thumb: 'https://cdn/x.webp', iv: 'iv', thumbIv: 'tiv' }

const reponseRead = (corps) => ({ ok: true, status: 200, json: async () => ({ markdown: JSON.stringify(corps), sha: null }) })

beforeEach(() => { clearManifestCache() })
afterEach(() => { vi.unstubAllGlobals() })

describe('un échec transitoire de résolution n’est jamais mis en cache', () => {
  it('LE BUG : resolve-link échoue toute une rafale, PUIS réussit — la seconde lecture rend l’image', async () => {
    let resolveAppels = 0
    vi.stubGlobal('fetch', vi.fn(async (url) => {
      const u = String(url)
      if (u.includes('action=read')) {
        // la lecture du lien rend le lien ; la lecture du canonique rend l'image
        return u.includes('tri') ? reponseRead(LIEN) : reponseRead(CANON)
      }
      if (u.includes('resolve-link')) {
        resolveAppels++
        // premier appel : panne réseau (null) ; ensuite : OK
        return resolveAppels <= 4
          ? { ok: true, status: 200, json: async () => { throw new Error('reseau') } }
          : { ok: true, status: 200, json: async () => ({ ok: true, path: 'pages/A/IMG.jpeg.img.json' }) }
      }
      return { ok: false, status: 404, json: async () => ({}) }
    }))

    // La rafale a fait échouer la résolution : on obtient un transitoire, PAS un null mis en cache.
    const premier = await readImgManifestCached('pages/A/tri/IMG.jpeg.img.json')
    expect(premier, 'un échec transitoire doit rendre undefined, jamais null').toBeUndefined()

    // Deuxième regard : comme rien n’a été mis en cache, on RÉESSAIE et l’image vient.
    const second = await readImgManifestCached('pages/A/tri/IMG.jpeg.img.json')
    expect(second, 'le pointeur doit résoudre au second essai — la donnée était parfaite').toMatchObject({ type: 'image' })
  }, 15000)

  it('une ABSENCE confirmée par le serveur, elle, est mise en cache (pas de retry infini)', async () => {
    let resolveAppels = 0
    vi.stubGlobal('fetch', vi.fn(async (url) => {
      const u = String(url)
      if (u.includes('action=read')) return reponseRead(LIEN)
      if (u.includes('resolve-link')) { resolveAppels++; return { ok: true, status: 200, json: async () => ({ ok: false, error: 'orphan-link' }) } }
      return { ok: false, status: 404, json: async () => ({}) }
    }))
    const a = await readImgManifestCached('pages/A/tri/IMG.jpeg.img.json')
    const b = await readImgManifestCached('pages/A/tri/IMG.jpeg.img.json')
    expect(a).toBeNull()
    expect(b).toBeNull()
    // orphelin = absence réelle : une seule résolution, la seconde vient du cache.
    expect(resolveAppels).toBe(1)
  })

  it('un lien qui résout du premier coup rend le manifeste canonique et le met en cache', async () => {
    let readAppels = 0
    vi.stubGlobal('fetch', vi.fn(async (url) => {
      const u = String(url)
      if (u.includes('action=read')) { readAppels++; return u.includes('tri') ? reponseRead(LIEN) : reponseRead(CANON) }
      if (u.includes('resolve-link')) return { ok: true, status: 200, json: async () => ({ ok: true, path: 'pages/A/IMG.jpeg.img.json' }) }
      return { ok: false, status: 404, json: async () => ({}) }
    }))
    const m = await readImgManifestCached('pages/A/tri/IMG.jpeg.img.json')
    expect(m).toMatchObject({ type: 'image', cdnRepo: 'r' })
    const avant = readAppels
    await readImgManifestCached('pages/A/tri/IMG.jpeg.img.json') // second appel : tout en cache
    expect(readAppels, 'le second affichage ne doit RIEN relire').toBe(avant)
  })
})
