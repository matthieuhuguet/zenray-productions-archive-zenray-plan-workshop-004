import { describe, expect, it } from 'vitest'
import { initialPlayerState, isDuplicatePlayCommand, playerStateReducer, providerForTrack, trackKey } from './playerState.js'

describe('playerStateReducer', () => {
  it('accepte une commande une seule fois et ignore sa répétition', () => {
    const requested = playerStateReducer(initialPlayerState, { type: 'request', requestId: 1, provider: 'local', trackKey: 'a' })
    expect(requested).toMatchObject({ phase: 'loading', requestId: 1, provider: 'local', trackKey: 'a' })
    expect(playerStateReducer(requested, { type: 'request', requestId: 1, provider: 'local', trackKey: 'a' })).toBe(requested)
  })

  it('ignore les acquittements obsolètes provenant du provider précédent', () => {
    const first = playerStateReducer(initialPlayerState, { type: 'request', requestId: 1, provider: 'youtube', trackKey: 'yt' })
    const second = playerStateReducer(first, { type: 'request', requestId: 2, provider: 'local', trackKey: 'local' })
    expect(playerStateReducer(second, { type: 'playing', requestId: 1 })).toBe(second)
    expect(playerStateReducer(second, { type: 'playing', requestId: 2 }).phase).toBe('playing')
  })

  it('ignore aussi un acquittement du mauvais provider pour la commande courante', () => {
    const spotify = playerStateReducer(initialPlayerState, { type: 'request', requestId: 1, provider: 'spotify', trackKey: 'sp' })
    const local = playerStateReducer(spotify, { type: 'request', requestId: 2, provider: 'local', trackKey: 'local' })
    expect(playerStateReducer(local, { type: 'playing', requestId: 2, provider: 'spotify' })).toBe(local)
  })

  it('ignore un événement tardif de la piste précédente du même provider', () => {
    const first = playerStateReducer(initialPlayerState, { type: 'request', requestId: 1, provider: 'local', trackKey: 'a' })
    const second = playerStateReducer(first, { type: 'request', requestId: 2, provider: 'local', trackKey: 'b' })
    expect(playerStateReducer(second, { type: 'playing', requestId: 2, provider: 'local', trackKey: 'a' })).toBe(second)
    expect(playerStateReducer(second, { type: 'playing', requestId: 2, provider: 'local', trackKey: 'b' }).phase).toBe('playing')
  })

  it('ne déclare jamais playing avant l’acquittement du provider', () => {
    const requested = playerStateReducer(initialPlayerState, { type: 'request', requestId: 7, provider: 'spotify', trackKey: 'spotify:track:1' })
    expect(requested.phase).toBe('loading')
    expect(playerStateReducer(requested, { type: 'ready', requestId: 7 }).phase).toBe('ready')
    expect(playerStateReducer(requested, { type: 'playing', requestId: 7 }).phase).toBe('playing')
  })
})

describe('track identity', () => {
  it('normalise les providers et privilégie le chemin stable du manifeste', () => {
    expect(providerForTrack({ source: 'spotify' })).toBe('spotify')
    expect(providerForTrack({ source: 'unknown' })).toBe('local')
    expect(trackKey({ manifestPath: 'pages/Music/a.media.json', uri: 'fallback' })).toBe('pages/Music/a.media.json')
    expect(trackKey({ contextUri: 'spotify:album:1' })).toBe('spotify:album:1')
  })
})

describe('play command gate', () => {
  it('supprime uniquement la même commande dans la fenêtre du double-clic', () => {
    const previous = { key: 'track-a:0', at: 1_000 }
    expect(isDuplicatePlayCommand(previous, 'track-a:0', 1_349)).toBe(true)
    expect(isDuplicatePlayCommand(previous, 'track-a:0', 1_350)).toBe(false)
    expect(isDuplicatePlayCommand(previous, 'track-b:1', 1_100)).toBe(false)
  })

  it('ne bloque pas une commande après un recul de l’horloge', () => {
    expect(isDuplicatePlayCommand({ key: 'track-a:0', at: 1_000 }, 'track-a:0', 900)).toBe(false)
  })
})
