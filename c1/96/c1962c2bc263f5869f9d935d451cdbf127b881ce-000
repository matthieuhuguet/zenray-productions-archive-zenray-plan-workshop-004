import { describe, expect, it } from 'vitest'
import { interpolatedScore, planScore, scoreEase } from './planScore.js'

describe('planScore', () => {
  it('counts completed goals and publications', () => {
    expect(planScore([
      { status: 'done' },
      { status: 'late-complete' },
      { status: 'done', publish: true },
      { status: 'planned', publish: true },
      { status: 'late' },
    ])).toBe(40)
  })

  it('returns zero without completed tasks', () => {
    expect(planScore()).toBe(0)
    expect(planScore([{ status: 'planned' }])).toBe(0)
  })
})

describe('score interpolation', () => {
  it('uses the exact timing endpoints in both directions', () => {
    expect(scoreEase(0)).toBe(0)
    expect(scoreEase(1)).toBe(1)
    expect(interpolatedScore(100, 120, 0)).toBe(100)
    expect(interpolatedScore(100, 120, 1)).toBe(120)
    expect(interpolatedScore(120, 100, 1)).toBe(100)
  })

  it('remains monotonic throughout the transition', () => {
    const samples = Array.from({ length: 101 }, (_, index) => interpolatedScore(100, 120, index / 100))
    expect(samples.every((sample, index) => index === 0 || sample >= samples[index - 1])).toBe(true)
  })
})

// 17 October 2026: events imported from Google Calendar never earn points.
import { planScore as planScoreGcal } from './planScore.js'
import { test as testGcal, expect as expectGcal } from 'vitest'
testGcal('imported calendar events earn no points, Plan tasks still do', () => {
  expectGcal(planScoreGcal([{ status: 'done', source: 'gcal' }, { status: 'done' }, { status: 'late-complete', publish: true }, { status: 'planned' }])).toBe(30)
})
