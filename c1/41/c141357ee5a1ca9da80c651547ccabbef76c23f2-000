import React from 'react'
import { describe, it, expect, vi, afterEach } from 'vitest'
import { render, screen, act, cleanup } from '@testing-library/react'
import SubtitleLayer, { SUB_SIZES } from './SubtitleLayer.jsx'
import { HORS_NORMES_PLACEHOLDER_SRT } from '../../media/subtitles/subtitleParser.js'
import { subtitleBox } from '../../media/subtitles/subtitleSettings.js'

describe('SubtitleLayer', () => {
  afterEach(() => {
    cleanup()
  })

  it('renders active cue in Inter small style when video reaches timestamp', async () => {
    const listeners = {}
    const mockVideo = {
      currentTime: 1,
      addEventListener: vi.fn((event, cb) => {
        listeners[event] = cb
      }),
      removeEventListener: vi.fn((event) => {
        delete listeners[event]
      }),
    }
    const videoRef = { current: mockVideo }
    const track = {
      format: 'srt',
      text: HORS_NORMES_PLACEHOLDER_SRT,
    }

    render(<SubtitleLayer videoRef={videoRef} track={track} controlsVisible={false} />)

    // Wait for async decode and initial active cue calculation
    await act(async () => {
      await new Promise((r) => setTimeout(r, 10))
      if (listeners.timeupdate) listeners.timeupdate()
    })

    const cueEl = screen.getByText(/\[Musique rythmée/i)
    expect(cueEl).toBeDefined()
    expect(cueEl.style.fontFamily).toBe('var(--zr-police-sans)')
    expect(cueEl.style.fontSize).toBe(SUB_SIZES.sm.fontSize)
    expect(cueEl.style.color).toBe('rgb(255, 255, 255)')

    // Advance time to cue 2
    await act(async () => {
      mockVideo.currentTime = 4
      if (listeners.timeupdate) listeners.timeupdate()
    })

    expect(screen.getByText(/Valentin ! Attends-moi !/i)).toBeDefined()
  })

  it('adjusts bottom offset smoothly when controlsVisible changes', async () => {
    const listeners = {}
    const mockVideo = {
      currentTime: 1,
      addEventListener: vi.fn((event, cb) => {
        listeners[event] = cb
      }),
      removeEventListener: vi.fn((event) => {
        delete listeners[event]
      }),
    }
    const videoRef = { current: mockVideo }
    const track = {
      format: 'srt',
      text: HORS_NORMES_PLACEHOLDER_SRT,
    }

    const { rerender } = render(<SubtitleLayer videoRef={videoRef} track={track} controlsVisible={false} />)

    await act(async () => {
      await new Promise((r) => setTimeout(r, 10))
      if (listeners.timeupdate) listeners.timeupdate()
    })

    const container = screen.getByText(/\[Musique rythmée/i).closest('.zr-subtitle-layer')
    expect(container.style.bottom).toBe('28px')

    // Rerender with controlsVisible = true
    rerender(<SubtitleLayer videoRef={videoRef} track={track} controlsVisible={true} />)
    expect(container.style.bottom).toBe('72px')
  })

  it('cleans up event listeners when unmounted', async () => {
    const listeners = {}
    const mockVideo = {
      currentTime: 5,
      addEventListener: vi.fn((event, cb) => {
        listeners[event] = cb
      }),
      removeEventListener: vi.fn((event) => {
        delete listeners[event]
      }),
    }
    const videoRef = { current: mockVideo }
    const track = {
      format: 'srt',
      text: HORS_NORMES_PLACEHOLDER_SRT,
    }

    const { unmount } = render(<SubtitleLayer videoRef={videoRef} track={track} />)

    await act(async () => {
      await new Promise((r) => setTimeout(r, 10))
    })

    expect(mockVideo.addEventListener).toHaveBeenCalledWith('timeupdate', expect.any(Function))

    unmount()
    expect(mockVideo.removeEventListener).toHaveBeenCalledWith('timeupdate', expect.any(Function))
  })

  it('renders different subtitle sizes (petite, moyenne, grande) with balanced wrapping', async () => {
    const mockVideo = {
      currentTime: 1,
      addEventListener: vi.fn(),
      removeEventListener: vi.fn(),
    }
    const videoRef = { current: mockVideo }
    const track = {
      format: 'srt',
      text: HORS_NORMES_PLACEHOLDER_SRT,
    }

    // Petite (sm)
    const { rerender } = render(<SubtitleLayer videoRef={videoRef} track={track} size="sm" />)
    await act(async () => {
      await new Promise((r) => setTimeout(r, 10))
    })
    let pill = screen.getByText(/\[Musique rythmée/i)
    expect(pill.style.fontSize).toBe(subtitleBox(100).fontSize)
    expect(pill.style.overflowWrap).toBe('break-word')
    expect(pill.style.textWrap).toBe('balance')

    // Moyenne (md)
    rerender(<SubtitleLayer videoRef={videoRef} track={track} size="md" />)
    pill = screen.getByText(/\[Musique rythmée/i)
    expect(pill.style.fontSize).toBe(subtitleBox(150).fontSize)

    // Grande (lg)
    rerender(<SubtitleLayer videoRef={videoRef} track={track} size="lg" />)
    pill = screen.getByText(/\[Musique rythmée/i)
    expect(pill.style.fontSize).toBe(subtitleBox(150).fontSize)
    expect(pill.style.maxWidth).toBe('100%')
  })

  it('takes the percentage, the serif family and the switched-off background from its props', async () => {
    const videoRef = { current: { currentTime: 1, addEventListener: vi.fn(), removeEventListener: vi.fn() } }
    const track = { format: 'srt', text: HORS_NORMES_PLACEHOLDER_SRT }
    render(<SubtitleLayer videoRef={videoRef} track={track} sizePct={50} font="serif" background={false} />)
    await act(async () => { await new Promise((r) => setTimeout(r, 10)) })
    const pill = screen.getByText(/\[Musique rythmée/i)
    expect(pill.style.fontSize).toBe(subtitleBox(50).fontSize)
    expect(pill.style.fontFamily).toBe('var(--zr-police-serif)')
    expect(pill.style.backgroundColor).toBe('transparent')
  })

  it('draws an ASS track with the same overlay as an SRT track', async () => {
    const listeners = {}
    const videoRef = { current: { currentTime: 1, addEventListener: vi.fn((e, cb) => { listeners[e] = cb }), removeEventListener: vi.fn() } }
    const ass = '[Script Info]\n[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\nDialogue: 0,0:00:00.50,0:00:03.00,Default,,0,0,0,,{\\an8}Bonjour ASS\n'
    render(<SubtitleLayer videoRef={videoRef} track={{ format: 'ass', text: ass }} />)
    await act(async () => { await new Promise((r) => setTimeout(r, 10)); listeners.timeupdate?.() })
    const pill = screen.getByText(/Bonjour ASS/)
    expect(pill.style.fontFamily).toBe('var(--zr-police-sans)')
    expect(pill.style.backgroundColor).not.toBe('transparent')
  })
})
