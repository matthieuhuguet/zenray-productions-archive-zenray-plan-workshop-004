#!/usr/bin/env node
// UploadTimingReport.mjs (14 October 2026): reads a push metrics file and writes UploadTiming.json beside it (read only on the metrics).
// Usage: node scripts/UploadTimingReport.mjs <push-metrics.jsonl> --label "Bleach S17E25 + E26" [--total-mib 3770] [--done] [--out file.json]
// FR : lit les metriques de push et ecrit UploadTiming.json a cote ; la bannière du site lit ce fichier.
import fs from 'node:fs'
import path from 'node:path'
import { summarizeUploadTiming, formatUploadMessage, UPLOAD_TIMING } from './lib/upload-timing.mjs'

const args = process.argv.slice(2)
const file = args.find((arg) => !arg.startsWith('--'))
const flag = (name) => { const i = args.indexOf(`--${name}`); return i >= 0 ? args[i + 1] : undefined }
if (!file) { console.error('usage: UploadTimingReport.mjs <push-metrics.jsonl> --label <text> [--total-mib N] [--done] [--out file]'); process.exit(2) }
const label = flag('label') || path.basename(path.dirname(path.resolve(file)))
const totalBytes = Number(flag('total-mib') || 0) * UPLOAD_TIMING.megabyte
const rows = fs.readFileSync(file, 'utf8').split('\n').filter(Boolean).flatMap((line) => { try { return [JSON.parse(line)] } catch { return [] } })
const summary = summarizeUploadTiming(rows, { totalBytes })
const done = args.includes('--done')
const report = { label, done, message: formatUploadMessage(label, summary, { done }), summary, generatedAt: new Date().toISOString() }
const out = flag('out') || path.join(path.dirname(path.resolve(file)), 'UploadTiming.json')
fs.writeFileSync(out, `${JSON.stringify(report, null, 2)}\n`)
console.log(report.message)
