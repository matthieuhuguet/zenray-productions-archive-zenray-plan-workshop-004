import { describe, expect, it, vi } from 'vitest'
import { readLocalWorkspaces, readProjectConversationIndex } from './assetsWorkspaceBridge.js'

// 9 October 2026, 11:20 CEST: Cover compatibility with older bridge actions and safe transcript index reads.
describe('Assets workspace bridge compatibility', () => {
  it('uses only the selected project status when an older bridge lacks the compact catalogue action', async () => {
    const activeProject = { id: 'bayou', files: [{ id: 'file' }] }
    const bridge = {
      catalogue: vi.fn().mockRejectedValue(new Error('Unsupported Assets workspace action')),
      status: vi.fn().mockResolvedValue({ project: activeProject }),
      list: vi.fn(),
    }

    const result = await readLocalWorkspaces(bridge, 'bayou', [{ id: 'bayou' }, { id: 'tiles' }])

    expect(result).toMatchObject({ projects: [activeProject, { id: 'tiles' }], activeProjectId: 'bayou' })
    expect(bridge.status).toHaveBeenCalledTimes(1)
    expect(bridge.list).not.toHaveBeenCalled()
  })

  it('keeps cloud projects in view when the compact local catalogue does not contain the selection', async () => {
    const bridge = {
      catalogue: vi.fn().mockResolvedValue({ projects: [{ id: 'local-project' }], checkedAt: '2026-10-09T08:00:00Z' }),
      status: vi.fn(),
    }

    const result = await readLocalWorkspaces(bridge, 'cloud-only')

    expect(result).toMatchObject({ projects: [{ id: 'local-project' }], activeProjectId: null })
    expect(bridge.status).not.toHaveBeenCalled()
  })

  it('reads indexed project links through the legacy bounded text preview without changing session bindings', async () => {
    const rows = [{ projectId: 'bayou', conversationId: 'gemini:evidence', sessionId: 'evidence', provider: 'gemini', strength: 'strong', boundProject: 'research' }]
    const workspace = {
      id: 'bayou',
      sources: [{ id: 'memory', namespace: 'memory' }, { id: 'tmp', namespace: 'tmp' }],
      files: [{ id: 'memory:ConversationIndex.json', sourceId: 'memory', relativePath: 'ConversationIndex.json' }],
    }
    const bridge = {
      projectConversations: vi.fn().mockRejectedValue(new Error('Unsupported Assets workspace action')),
      request: vi.fn().mockResolvedValue({ text: JSON.stringify({ projectId: 'bayou', scannedAt: '2026-10-09T08:00:00Z', conversations: rows }), truncated: false }),
      status: vi.fn(),
    }

    const result = await readProjectConversationIndex(bridge, 'bayou', workspace)

    expect(result).toMatchObject({ state: 'ready', projectId: 'bayou', conversations: rows })
    expect(bridge.request).toHaveBeenCalledWith('preview-text', { projectId: 'bayou', fileId: 'memory:ConversationIndex.json' })
    expect(bridge.status).not.toHaveBeenCalled()
  })

  it.each([
    [{ projectId: 'other', scannedAt: '2026-10-09T08:00:00Z', conversations: [] }, false, 'ne correspond pas'],
    [{ projectId: 'bayou', scannedAt: '2026-10-09T08:00:00Z', conversations: [] }, true, 'dépasse la limite'],
  ])('rejects an invalid or truncated project index', async (index, truncated, message) => {
    const bridge = {
      projectConversations: vi.fn().mockRejectedValue(new Error('Unsupported Assets workspace action')),
      request: vi.fn().mockResolvedValue({ text: JSON.stringify(index), truncated }),
    }
    const workspace = { id: 'bayou', sources: [{ id: 'memory', namespace: 'memory' }], files: [{ id: 'index', sourceId: 'memory', relativePath: 'ConversationIndex.json' }] }

    await expect(readProjectConversationIndex(bridge, 'bayou', workspace)).rejects.toThrow(message)
  })

  it('does not mask an unrelated catalogue outage as a supported bridge fallback', async () => {
    const failure = new Error('Network unavailable')
    const bridge = { catalogue: vi.fn().mockRejectedValue(failure) }

    await expect(readLocalWorkspaces(bridge, 'bayou', [{ id: 'bayou' }])).rejects.toBe(failure)
  })
})
