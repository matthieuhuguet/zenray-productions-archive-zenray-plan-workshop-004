// 16 October 2026 14:35 Europe/Paris: personal notes are saved explicitly, versioned and archived reversibly.
import React, { useEffect, useState } from 'react'
import { PERSONAL_CONFIG } from './japanesePersonalConfig.js'
const emptyDraft = () => ({id:crypto.randomUUID(),title:'',text:'',topic:'japanese',archived:false,revision:0})
function recoveredDraft() { try { const value=JSON.parse(sessionStorage.getItem(PERSONAL_CONFIG.draftKey)); return value && typeof value.id==='string' && typeof value.title==='string' && typeof value.text==='string' && ['japanese','japan'].includes(value.topic) && Number.isInteger(value.revision) ? value : null } catch { return null } }
export default function JapaneseNotebook({ notes = {}, busy, onSave }) {
  const [draft,setDraft] = useState(()=>recoveredDraft() || emptyDraft()), [dirty,setDirty] = useState(()=>!!recoveredDraft()), [query,setQuery] = useState(''), [showArchived,setShowArchived] = useState(false)
  useEffect(() => { if (!dirty) return; const guard = event => { event.preventDefault(); event.returnValue = '' }; window.addEventListener('beforeunload',guard); return () => window.removeEventListener('beforeunload',guard) },[dirty])
  useEffect(()=>{ try { if(dirty)sessionStorage.setItem(PERSONAL_CONFIG.draftKey,JSON.stringify(draft));else sessionStorage.removeItem(PERSONAL_CONFIG.draftKey) } catch { /* 16 October 2026 14:25 Europe/Paris: explicit saving remains available if browser storage is denied. */ } },[draft,dirty])
  const stored = notes[draft.id]
  useEffect(() => { if (stored && !dirty && stored.revision > draft.revision) { setDraft({id:draft.id,...stored}); setDirty(false) } }, [stored?.revision,draft.id])
  function select(next) { if (dirty && !window.confirm('Ce brouillon n’est pas enregistré. Changer de note et abandonner ce brouillon ?')) return; setDraft(next); setDirty(false) }
  const change = updates => { setDraft(value=>({...value,...updates})); setDirty(true) }
  const list = Object.entries(notes).filter(([,note])=>!!note.archived === showArchived && `${note.title} ${note.text}`.toLowerCase().includes(query.toLowerCase())).sort((a,b)=>b[1].updatedAt-a[1].updatedAt)
  return <article className="jps-notebook"><h3>Mon carnet de japonais et du Japon</h3><p>Notes personnelles, questions et observations. Elles restent distinctes des leçons et des acquis.</p><div className="jps-levels"><button disabled={busy} onClick={()=>select(emptyDraft())}>Nouvelle note</button><label>Rechercher mes notes<input value={query} onChange={event=>setQuery(event.target.value)} /></label><label><input type="checkbox" checked={showArchived} onChange={event=>setShowArchived(event.target.checked)} /> Voir les notes archivées</label></div>
    <div className="jps-grid">{list.map(([id,note])=><button key={id} className="jps-card" aria-pressed={draft.id===id} onClick={()=>select({id,...note})}><span>{note.title}</span><small>{note.topic==='japanese'?'Japonais':'Japon'}</small></button>)}</div>
    <form onSubmit={async event=>{event.preventDefault();const submitted = {...draft}; const saved = await onSave({action:'note',eventId:crypto.randomUUID(),noteId:draft.id,title:draft.title,text:draft.text,topic:draft.topic,archived:draft.archived,expectedRevision:draft.revision}); if(saved) { setDraft({...submitted,revision:submitted.revision+1}); setDirty(false) }}}><fieldset disabled={busy}>
      <label>Titre de la note<input value={draft.title} maxLength={PERSONAL_CONFIG.titleLength} required onChange={event=>change({title:event.target.value})} /></label><label>Sujet de la note<select aria-label="Sujet de la note" value={draft.topic} onChange={event=>change({topic:event.target.value})}><option value="japanese">Apprentissage du japonais</option><option value="japan">Japon</option></select></label><label>Texte de la note<textarea value={draft.text} rows={12} maxLength={PERSONAL_CONFIG.bodyLength} onChange={event=>change({text:event.target.value})} /></label><label><input type="checkbox" checked={draft.archived} onChange={event=>change({archived:event.target.checked})} /> Archiver cette note, sans la supprimer</label><button disabled={busy || !draft.title.trim()}>Enregistrer la note</button><p role="status">{dirty?'Brouillon non enregistré dans Memory ; conservé dans cet onglet du navigateur.':stored?'Note enregistrée dans Memory.':'Nouvelle note, pas encore enregistrée.'}</p>
    </fieldset></form>
  </article>
}
