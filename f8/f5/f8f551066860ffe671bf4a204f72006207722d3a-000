// 5 October 2026: public remote and international job feeds (Remotive, Jobicy, Remote OK, Arbeitnow). Each one publishes an open API
// meant for reuse; their terms ask for a visible credit and a link back, which the offer keeps (sourceLabel, source URL).
// None of them is a full catalogue (a search window or a latest-jobs page), so absence from a feed never closes a vacancy.
// FR : flux publics de postes a distance et internationaux, API ouvertes a la reutilisation ; credit et lien d'origine conserves.
// Aucun n'est un catalogue complet : l'absence d'une annonce ne la ferme jamais.
import { ROLE_PATTERN, OTHER_ROLE_PATTERN, offerId } from '../lib/Offer.mjs'

const iso = (value) => {
  const raw = String(value || '').trim()
  if (/^\d{9,11}$/.test(raw)) return new Date(Number(raw) * 1000).toISOString()
  return raw
}
// A listing without a company, a title or an address cannot be applied to: it is dropped here rather than shown half-empty.
// FR : une annonce sans entreprise, titre ou adresse n'est pas candidatable : elle est ecartee ici plutot qu'affichee a moitie vide.
const usable = (listing) => Boolean(listing.name && listing.title && /^https?:\/\//.test(listing.url || ''))
const windowBoard = (key, label, all, errors, complete) => { const listings = all.filter(usable); return { key, label, listings, seenIds: listings.map((l) => offerId(l.sourceId)), listed: listings.length, matched: listings.length, errors, complete: false, partial: complete } }
// Games wins when a title fits both lanes, unless the text plainly describes another industry without mentioning games.
// FR : le jeu video l'emporte quand un titre va aux deux voies, sauf si le texte decrit nettement une autre industrie sans parler de jeu.
const OTHER_INDUSTRY = /\b(film|feature film|tv series|television|broadcast|commercials?|advertising|architectur\w*|archviz|automotive|medical|healthcare|simulation|digital twin|visuali[sz]ation|product configurator|e-?commerce|industrial|manufactur\w*|aerospace|defen[cs]e)\b/i
const GAME_WORDS = /\b(video ?games?|gaming|game studio|game development|jeu vid[ée]o|games? industry|aaa)\b/i
export const laneOf = (title, text = '') => {
  const t = String(title || '')
  if (ROLE_PATTERN.test(t)) return OTHER_INDUSTRY.test(text) && !GAME_WORDS.test(text) && OTHER_ROLE_PATTERN.test(t) ? 'other' : 'games'
  return OTHER_ROLE_PATTERN.test(t) ? 'other' : null
}
const wanted = (title) => laneOf(title) !== null

export async function remotive({ http, config }) {
  const s = config.sources.remotive
  const found = new Map(); const errors = []; let complete = true
  for (const query of s.queries) {
    try {
      const data = await http.json(`https://remotive.com/api/remote-jobs?search=${encodeURIComponent(query)}`)
      for (const job of data.jobs || []) if (wanted(job.title)) found.set(job.id, job)
    } catch (error) { complete = false; errors.push({ source: `remotive:${query}`, error: error.message }) }
  }
  const listings = [...found.values()].map((job) => ({
    lane: laneOf(job.title, job.description), sourceKey: 'remotive', sourceLabel: 'Remotive', evidence: 'Remotive, annonce relayée avec lien d’origine', name: String(job.company_name || '').trim(), title: job.title, url: job.url, applyUrl: job.url,
    sourceId: `remotive:${job.id}`, location: job.candidate_required_location || '', country: '', contract: job.job_type || '', workplace: 'Remote', published: job.publication_date || '', text: job.description || '', careersUrl: '',
  }))
  return [windowBoard('remotive', 'Remotive', listings, errors, complete)]
}

export async function jobicy({ http, config }) {
  const s = config.sources.jobicy
  const found = new Map(); const errors = []; let complete = true
  for (const tag of s.tags) {
    try {
      const data = await http.json(`https://jobicy.com/api/v2/remote-jobs?count=50&tag=${encodeURIComponent(tag)}`)
      for (const job of data.jobs || []) if (wanted(job.jobTitle)) found.set(job.id, job)
    } catch (error) { complete = false; errors.push({ source: `jobicy:${tag}`, error: error.message }) }
  }
  const listings = [...found.values()].map((job) => ({
    lane: laneOf(job.jobTitle, job.jobDescription), sourceKey: 'jobicy', sourceLabel: 'Jobicy', evidence: 'Jobicy, annonce relayée avec lien d’origine', name: String(job.companyName || '').trim(), title: job.jobTitle, url: job.url, applyUrl: job.url,
    sourceId: `jobicy:${job.id}`, location: job.jobGeo || '', country: '', contract: [].concat(job.jobType || []).join(', '), workplace: 'Remote', published: job.pubDate || '', text: job.jobDescription || '', careersUrl: '',
  }))
  return [windowBoard('jobicy', 'Jobicy', listings, errors, complete)]
}

export async function remoteok({ http }) {
  const errors = []; let listings = []; let complete = true
  try {
    const data = await http.json('https://remoteok.com/api')
    listings = data.filter((job) => job && job.id && wanted(job.position)).map((job) => ({
      lane: laneOf(job.position, job.description), sourceKey: 'remoteok', sourceLabel: 'Remote OK', evidence: 'Remote OK, annonce relayée avec lien d’origine', name: String(job.company || '').trim(), title: job.position, url: job.url, applyUrl: job.apply_url || job.url,
      sourceId: `remoteok:${job.id}`, location: job.location || '', country: '', contract: '', workplace: 'Remote', published: job.date || iso(job.epoch), text: job.description || '', careersUrl: '',
    }))
  } catch (error) { complete = false; errors.push({ source: 'remoteok', error: error.message }) }
  return [windowBoard('remoteok', 'Remote OK', listings, errors, complete)]
}

export async function arbeitnow({ http, config }) {
  const pages = config.sources.arbeitnow.pages || 3
  const listings = []; const errors = []; let complete = true
  for (let page = 1; page <= pages; page += 1) {
    try {
      const data = await http.json(`https://www.arbeitnow.com/api/job-board-api?page=${page}`)
      for (const job of data.data || []) if (wanted(job.title)) listings.push({
        lane: laneOf(job.title, job.description), sourceKey: 'arbeitnow', sourceLabel: 'Arbeitnow', evidence: 'Arbeitnow, annonce relayée avec lien d’origine', name: String(job.company_name || '').trim(), title: job.title, url: job.url, applyUrl: job.url,
        sourceId: `arbeitnow:${job.slug}`, location: job.location || '', country: 'DE', contract: [].concat(job.job_types || []).join(', '), workplace: job.remote ? 'Remote' : 'Voir conditions de la fiche', published: iso(job.created_at), text: job.description || '', careersUrl: '',
      })
    } catch (error) { complete = false; errors.push({ source: `arbeitnow:${page}`, error: error.message }) }
  }
  return [windowBoard('arbeitnow', 'Arbeitnow', listings, errors, complete)]
}
