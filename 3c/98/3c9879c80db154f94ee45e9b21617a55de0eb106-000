// Identité visuelle d'un fichier d'après son extension : label lisible + couleur d'accent (pour un badge),
// et formatage de taille humain. Utilisé par la carte fichier (MediaViewer) et, à terme, par les tuiles.
const KIND = {
  zip: 'Archive', rar: 'Archive', '7z': 'Archive', tar: 'Archive', gz: 'Archive', tgz: 'Archive',
  pdf: 'PDF',
  psd: 'Photoshop', ai: 'Illustrator', xd: 'Adobe XD', sketch: 'Sketch', fig: 'Figma',
  blend: 'Blender', fbx: '3D', obj: '3D', glb: '3D', gltf: '3D', stl: '3D', usd: '3D', usdz: '3D', spp: 'Substance', sbsar: 'Substance',
  exe: 'Exécutable', msi: 'Installeur', pkg: 'Installeur', dmg: 'Image disque', app: 'Application', deb: 'Paquet', appimage: 'AppImage',
  mp4: 'Vidéo', mov: 'Vidéo', mkv: 'Vidéo', avi: 'Vidéo', webm: 'Vidéo',
  wav: 'Audio', mp3: 'Audio', flac: 'Audio', aiff: 'Audio', m4a: 'Audio', ogg: 'Audio',
  doc: 'Word', docx: 'Word', xls: 'Excel', xlsx: 'Excel', ppt: 'Présentation', pptx: 'Présentation', key: 'Keynote', numbers: 'Numbers', pages: 'Pages',
  json: 'JSON', csv: 'CSV', xml: 'XML', txt: 'Texte', md: 'Markdown',
  uasset: 'Unreal', uproject: 'Unreal', unitypackage: 'Unity',
}
const COLOR = {
  Archive: '#E2A33C', PDF: '#FF3B30', Photoshop: '#31A8FF', Illustrator: '#FF9A00', 'Adobe XD': '#FF61F6',
  Sketch: '#FDB300', Figma: '#A259FF', Blender: '#E87D0D', '3D': '#8E8E93', Substance: '#C04A2B',
  Vidéo: '#5E5CE6', Audio: '#FF2D55', Word: '#2B7CD3', Excel: '#1E8E3E', 'Présentation': '#D24726',
  Keynote: '#0A84FF', JSON: '#6E56CF', CSV: '#1E8E3E', Unreal: '#1F1F1F', Unity: '#222C37',
}

// fileKind('Final.blend') -> { ext:'blend', label:'Blender', color:'#E87D0D' }
export function fileKind(name = '') {
  const ext = (String(name).split('.').pop() || '').toLowerCase()
  const label = KIND[ext] || (ext ? ext.toUpperCase() : 'Fichier')
  return { ext, label, color: COLOR[label] || '#8E8E93' }
}

// fmtBytes(53900000) -> '51 Mo'
export function fmtBytes(n) {
  if (!Number.isFinite(n) || n <= 0) return ''
  const u = ['o', 'Ko', 'Mo', 'Go', 'To']
  let i = 0, v = n
  while (v >= 1024 && i < u.length - 1) { v /= 1024; i++ }
  return `${v < 10 && i > 0 ? v.toFixed(1) : Math.round(v)} ${u[i]}`
}
