import { describe, it, expect } from 'vitest'
import { EXTENSIONS_NOEUDS } from './extensionsNoeuds.js'
import { isExposedTreeNode } from './nodeTreeFilter.js'

describe('isExposedTreeNode', () => {
  // 9 October 2026 08:05 CEST: Keep the tree filter complete with the canonical node suffix list.
  it('exposes every canonical node suffix', () => {
    for (const extension of EXTENSIONS_NOEUDS) {
      expect(isExposedTreeNode(`pages/A/node.${extension}`), `${extension} must stay visible`).toBe(true)
    }
  })

  it('expose les extensions de noeud connues', () => {
    expect(isExposedTreeNode('pages/A.md')).toBe(true)
    expect(isExposedTreeNode('pages/A.db.json')).toBe(true)
    expect(isExposedTreeNode('pages/A.img.json')).toBe(true)
  })

  it('expose le marqueur .zrfolder.json (régression 2026-07-12)', () => {
    expect(isExposedTreeNode('pages/A/.zrfolder.json')).toBe(true)
  })

  it('expose le marqueur .zrmusic.json (régression 2026-07-16 : dead code sinon)', () => {
    expect(isExposedTreeNode('pages/Music/.zrmusic.json')).toBe(true)
  })

  it('expose le marqueur de jonction Eagle sans exposer son identité interne', () => {
    expect(isExposedTreeNode('pages/Projet/Asset/.zreagle-folder.json')).toBe(true)
    expect(isExposedTreeNode('pages/Source/.zreagle-resource.json')).toBe(false)
  })

  it('rejette un fichier interne jumeau (.props/.blocknote/.comments)', () => {
    expect(isExposedTreeNode('pages/A.props.json')).toBe(false)
    expect(isExposedTreeNode('pages/A.blocknote.json')).toBe(false)
  })

  it('rejette un marqueur .zrvis.json (lu à la demande, jamais listé — comportement volontaire différent)', () => {
    expect(isExposedTreeNode('pages/A/.zrvis.json')).toBe(false)
  })

  it('rejette un fichier binaire quelconque', () => {
    expect(isExposedTreeNode('pages/photo.png')).toBe(false)
  })

  it('masque les manifestes canoniques internes même s’ils portent une extension visible', () => {
    expect(isExposedTreeNode('pages/.zr-resources/canonical/zr_1.img.json')).toBe(false)
  })
})
