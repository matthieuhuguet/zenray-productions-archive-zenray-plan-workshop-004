// 2 October 2026: the global mapping must remain stable, compact and honest about absent shared sources.
import { describe, it, expect } from 'vitest'
import { buildGlobalProjectIndex, renderProjectContext, projectIdFromLocalPath } from './projectContextIndex.js'

const project = (id, dependencies = []) => ({ id, name: id, folder: `pages/ZenRayAssets/${id}`, dependencies,
  feedbackPath: `/Memory/Projects/${id}/FEEDBACK.md`, sources: [
    { id: 'workshop', namespace: 'tmp', localPath: `/TMP/${id}`, include: ['exports'], exclude: ['cache'] },
    { id: 'notes', namespace: 'memory', localPath: `/Memory/Projects/${id}` },
    { id: 'scene', namespace: 'houdini', localPath: `/Houdini/${id}` },
    { id: 'content', namespace: 'unreal', localPath: `/Unreal/Content/${id}` },
  ], files: [{ id: 'notes:FEEDBACK.md', name: 'FEEDBACK.md', namespace: 'memory', relativePath: 'FEEDBACK.md',
    localPath: `/Memory/Projects/${id}/FEEDBACK.md`, cloudPath: null, expectedCloudPath: `pages/ZenRayAssets/${id}/sources/memory/notes/FEEDBACK.md`, status: 'local-only' }],
  sync: { backedUpCount: 0 } })

describe('global project mapping', () => {
  // 3 October 2026, 22:06 CEST: application documentation remains discoverable outside Memory, with cloud-safe pointers.
  it('indexes project Markdown from every source while preserving Memory entry points and bounding the rendered preview', () => {
    const app = project('dictate')
    app.files.push({ id: 'app:README.md', name: 'README.md', namespace: 'tmp', sourceId: 'app', relativePath: 'README.md', localPath: '/PrivateApp/README.md', expectedCloudPath: 'pages/ZenRayAssets/dictate/sources/tmp/app/README.md', status: 'local-only' })
    app.files.push(...Array.from({ length: 30 }, (_, index) => ({ id: `scene:docs/${index}.md`, namespace: 'houdini', relativePath: `docs/${index}.md`, localPath: `/PrivateScene/docs/${index}.md`, status: 'local-only' })))
    const local = buildGlobalProjectIndex([app])
    expect(local.projects.dictate.context.documents).toHaveLength(32)
    expect(local.projects.dictate.context.memoryFiles).toHaveLength(1)
    expect(renderProjectContext(local, 'dictate')).toContain('/PrivateApp/README.md')
    expect(renderProjectContext(local, 'dictate')).toContain('Showing 24 of 32 documents')
    const cloud = buildGlobalProjectIndex([app], { cloud: true })
    expect(JSON.stringify(cloud)).not.toContain('/PrivateApp/')
    expect(JSON.stringify(cloud)).not.toContain('/PrivateScene/')
    expect(renderProjectContext(cloud, 'dictate')).toContain('pages/ZenRayAssets/dictate/sources/tmp/app/README.md')
    expect(cloud.projects.dictate.context.documents[1].fileId).toBe('app:README.md')
  })
  // 3 October 2026, 09:24 CEST: narrow reconnection evidence cannot imply a saved portable or rendered scene.
  it('includes preparation applicability and limits in the context read by agents', () => {
    const tiles = project('tiles')
    tiles.sceneReferences = [{ sceneFileId: 'scene:Scene.hiplc', state: 'current', sceneSha256: 'a'.repeat(64), references: [], preparation: { state: 'historical', inputCount: 20, libraryCount: 7, instanceCount: 16, unresolvedReferenceCount: 58 } }]
    const text = renderProjectContext(buildGlobalProjectIndex([tiles]), 'tiles')
    expect(text).toContain('historical; 20 inputs, 7 libraries, 16 instances; 58 references outside this preparation')
    expect(text).toContain('No scene was saved or rendered')
    expect(text).toContain('Runtime portability remains unverified')
  })
  it('maps four source families by stable id regardless of project order', () => {
    const entries = [project('tiles', ['core']), project('core')]
    const first = buildGlobalProjectIndex(entries)
    const second = buildGlobalProjectIndex([...entries].reverse())
    expect(first.projects).toEqual(second.projects)
    expect(Object.keys(first.projects.tiles.locations)).toEqual(['tmp', 'memory', 'houdini', 'unreal'])
    expect(first.projects.tiles.locations.tmp[0].include).toEqual(['exports'])
    expect(first.projects.tiles.dependencies).toEqual(['core'])
    expect(first.projects.tiles.context.feedback.status).toBe('local-only')
    const text = renderProjectContext(first, 'tiles')
    expect(text).toContain('/Memory/Projects/tiles/FEEDBACK.md')
    expect(text).toContain('pages/ZenRayAssets/core/.workspace.json')
    expect(text).toContain('verified archive records: 0')
  })
  it('omits local paths from cloud context while retaining cloud folders and archive coverage', () => {
    const index = buildGlobalProjectIndex([project('tiles')], { cloud: true })
    const serialized = JSON.stringify(index)
    expect(serialized).not.toContain('/TMP/')
    expect(serialized).not.toContain('/Memory/')
    expect(serialized).not.toContain('/Unreal/')
    expect(index.projects.tiles.locations.houdini[0].cloudFolder).toContain('/sources/houdini/scene')
    expect(renderProjectContext(index, 'tiles')).toContain('not yet archived')
  })
  // 3 October 2026, 10:11 CEST: conflict evidence is linked by identity without leaking the original machine path.
  it('includes divergent version hashes in agent context and omits their local path from cloud mappings', () => {
    const tiles = project('tiles')
    tiles.files.push({ id: 'scene:Scene.hiplc', sourceConflict: { originalPath: '/private-origin/Scene.hiplc', originalSha256: 'origin-hash', copySha256: 'copy-hash' } })
    const local = buildGlobalProjectIndex([tiles])
    expect(local.projects.tiles.context.sourceConflicts[0].originalPath).toBe('/private-origin/Scene.hiplc')
    expect(renderProjectContext(local, 'tiles')).toContain('Original SHA256 origin-hash; copy SHA256 copy-hash')
    const cloud = buildGlobalProjectIndex([tiles], { cloud: true })
    expect(JSON.stringify(cloud)).not.toContain('/private-origin/')
    expect(cloud.projects.tiles.context.sourceConflicts[0].fileId).toBe('scene:Scene.hiplc')
  })
  it('reports missing dependencies and cycles without recursively duplicating host files', () => {
    const index = buildGlobalProjectIndex([project('a', ['b', 'missing']), project('b', ['a'])])
    expect(index.issues.some((issue) => issue.code === 'dependency-cycle')).toBe(true)
    expect(index.issues).toContainEqual({ projectId: 'a', dependency: 'missing', code: 'dependency-missing' })
    expect(index.projectCount).toBe(2)
    expect(() => renderProjectContext(index, 'unknown')).toThrow('Unknown')
  })
  it('resolves real shared-host objects and preserves descriptive external dependency notes', () => {
    const tiles = project('tiles', [{ projectId: 'core', kind: 'shared-host' }, 'Houdini Engine plugin is an external dependency.'])
    tiles.sources[3].sharedProjectId = 'core'
    const index = buildGlobalProjectIndex([tiles, project('core')])
    expect(index.projects.tiles.dependencies).toEqual(['core'])
    expect(index.issues).toEqual([])
    expect(renderProjectContext(index, 'tiles')).toContain('Houdini Engine plugin is an external dependency.')
  })
})

// 5 October 2026, 13:44 CEST: broad/shared roots never silently select the wrong project.
it('resolves every source and loaded copy by path with stable IDs and strict path boundaries', () => {
  const tiles = project('tiles'); tiles.workspace = { state: 'loaded', path: '/Loads/tiles/active' }
  const index = buildGlobalProjectIndex([tiles])
  for (const pathname of ['/TMP/tiles/', '/TMP/tiles/exports/image.png', '/Memory/Projects/tiles/Project1.md', '/Houdini/tiles/main.hiplc', '/Unreal/Content/tiles/material.uasset', '/Loads/tiles/active/sources/tmp/workshop/notes.md']) expect(projectIdFromLocalPath(index, pathname)).toBe('tiles')
  expect(() => projectIdFromLocalPath(index, '/TMP/tiles-other')).toThrow('No registered project')
  expect(() => projectIdFromLocalPath(index, 'tiles')).toThrow('absolute')
})
it('rejects shared roots and resolves a narrower explicitly registered project', () => {
  const a = project('a'), b = project('b'); b.sources[0].localPath = '/TMP/a'
  const index = buildGlobalProjectIndex([a, b]); expect(() => projectIdFromLocalPath(index, '/TMP/a/file.md')).toThrow('Ambiguous')
  b.sources[0].localPath = '/TMP/a/b'
  expect(projectIdFromLocalPath(buildGlobalProjectIndex([a, b]), '/TMP/a/b/file.md')).toBe('b')
})

// 7 October 2026, 23:13 CEST: canonical and project-specific skills survive mapping without duplicate routes.
it('recommends the canonical Assets entry and preserves project skill identities once', () => {
  const edit = project('edit'); edit.skills = ['zenray-assets', 'zenray-edit']
  const skills = buildGlobalProjectIndex([edit]).projects.edit.context.skills
  expect(skills).toContain('zenray-edit')
  expect(skills.filter(name => name === 'zenray-assets')).toHaveLength(1)
  expect(skills).not.toContain('zenray-assets-v2')
})
