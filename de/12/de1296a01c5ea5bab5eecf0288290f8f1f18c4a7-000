import { describe, it, expect } from 'vitest'
import { diagnostiquerBoard, SEUILS, PHRASES } from './autoDiagnostic.js'

// LE VÉRIFICATEUR SE VÉRIFIE DANS LES DEUX SENS. Un diagnostic qui ne vire jamais au rouge n'a rien
// prouvé : chaque cause a donc son cas cassé ET le cas sain à côté, sinon on ne saurait pas qu'il
// regarde vraiment le DOM plutôt que de rendre toujours la même réponse.
const faireElement = ({ l = 800, h = 600, enfants = {} } = {}) => ({
  getBoundingClientRect: () => ({ width: l, height: h }),
  querySelector: (sel) => enfants[sel] || null,
})
const faireBarre = ({ l = 54, h = 500, opacite = '1', visibilite = 'visible', affichage = 'flex' } = {}) => ({
  getBoundingClientRect: () => ({ width: l, height: h }),
  __style: { opacity: opacite, visibility: visibilite, display: affichage },
})

// getComputedStyle est global : on le bouchonne pour lire le style porté par l'élément factice.
globalThis.getComputedStyle = (el) => el.__style || { opacity: '1', visibility: 'visible', display: 'block' }

describe('autoDiagnostic du board Ref', () => {
  it('cause A — un conteneur de hauteur nulle est nommé, et rien d’autre', () => {
    const r = diagnostiquerBoard(faireElement({ h: 0 }), null)
    expect(r.cause).toBe('A')
    expect(r.sain).toBe(false)
    expect(r.details.racine).toEqual({ l: 800, h: 0 })
  })

  it('cause A — la hauteur du canevas compte autant que celle de la racine', () => {
    const toile = faireElement({ l: 800, h: 10 })
    const r = diagnostiquerBoard(faireElement({ enfants: { '.tl-container': toile } }), null)
    expect(r.cause).toBe('A')
  })

  it('cause B — tldraw absent du DOM se distingue d’un conteneur plat', () => {
    const r = diagnostiquerBoard(faireElement({}), null)
    expect(r.cause).toBe('B')
    expect(r.details.tldrawMonte).toBe(false)
  })

  it('cause B — une racine absente ne lève pas, elle rend un verdict', () => {
    expect(diagnostiquerBoard(null, null).cause).toBe('B')
  })

  it('cause C — une barre présente mais transparente est le cas du 2026-08-30', () => {
    const toile = faireElement({ h: 600 })
    const barre = faireBarre({ opacite: '0' })
    const r = diagnostiquerBoard(faireElement({ enfants: { '.tl-container': toile, '.zr-ref-toolbar': barre } }), null)
    expect(r.cause).toBe('C')
    expect(r.details.barrePresente).toBe(true)
  })

  it('cause C — une barre absente alors que tldraw est monté accuse notre CSS', () => {
    const toile = faireElement({ h: 600 })
    const r = diagnostiquerBoard(faireElement({ enfants: { '.tl-container': toile } }), null)
    expect(r.cause).toBe('C')
    expect(r.details.tldrawMonte).toBe(true)
  })

  it('cause D — tout sain rend le verdict sain, avec le nombre de formes', () => {
    const toile = faireElement({ h: 600 })
    const barre = faireBarre()
    const editeur = { getCurrentPageShapes: () => [1, 2, 3], getColorMode: () => 'dark' }
    const r = diagnostiquerBoard(faireElement({ enfants: { '.tl-container': toile, '.zr-ref-toolbar': barre } }), editeur)
    expect(r.cause).toBe('D')
    expect(r.sain).toBe(true)
    expect(r.details.formes).toBe(3)
    expect(r.details.modeCouleur).toBe('dark')
  })

  it('cause D — un board sain mais VIDE reste sain : c’est la confusion qui a coûté la session', () => {
    const toile = faireElement({ h: 600 })
    const editeur = { getCurrentPageShapes: () => [], getColorMode: () => 'light' }
    const r = diagnostiquerBoard(faireElement({ enfants: { '.tl-container': toile, '.zr-ref-toolbar': faireBarre() } }), editeur)
    expect(r.sain).toBe(true)
    expect(r.details.formes).toBe(0)
  })

  it('un éditeur qui lève ne casse pas le diagnostic', () => {
    const toile = faireElement({ h: 600 })
    const editeur = { getCurrentPageShapes: () => { throw new Error('store mort') }, getColorMode: () => { throw new Error('x') } }
    const r = diagnostiquerBoard(faireElement({ enfants: { '.tl-container': toile, '.zr-ref-toolbar': faireBarre() } }), editeur)
    expect(r.cause).toBe('D')
    expect(r.details.formes).toBe(null)
  })

  it('chaque cause a sa phrase lisible, et les seuils sont des paramètres', () => {
    for (const c of ['A', 'B', 'C', 'D']) expect(typeof PHRASES[c]).toBe('string')
    expect(SEUILS.hauteurMinimale).toBeGreaterThan(0)
    expect(SEUILS.delaiMesure).toBeGreaterThan(0)
  })
})
