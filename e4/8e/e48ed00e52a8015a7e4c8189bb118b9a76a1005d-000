// 4 October 2026, 10:20 CEST: retained archives expose cloud evidence without exporting private Mac paths.
import { it, expect } from 'vitest'
import { conversationArchiveEntries } from './assetsConversationArchives.js'
it('keeps the archived identity with a missing original and strips Mac paths in cloud snapshots', () => {
  const entries = { 'codex:actual': { summary: { provider: 'codex', sessionId: 'actual', title: 'Original title' }, copies: [{ relativePath: 'copy.jsonl', originalPath: '/private/original.jsonl' }] } }
  const files = [{ relativePath: 'copy.jsonl', localPath: '/private/copy.jsonl', present: true, status: 'backed-up', cloudPath: 'cloud/copy.jsonl.file.json' }]
  const local = conversationArchiveEntries(entries, files)[0]
  expect(local).toMatchObject({ id: 'codex:actual', archiveCopy: true, readable: true, localPath: '/private/copy.jsonl', cloudPath: 'cloud/copy.jsonl.file.json' })
  expect(JSON.stringify(conversationArchiveEntries(entries, files, { cloud: true }))).not.toContain('/private/')
  expect(conversationArchiveEntries(entries, [{ ...files[0], present: false }])[0].readable).toBe(false)
})
