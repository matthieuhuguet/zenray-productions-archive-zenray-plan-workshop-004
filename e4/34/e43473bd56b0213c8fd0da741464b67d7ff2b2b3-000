// ZenRayMedia — le fil d'Ariane de Create.
//
// UN SEUL composant pour les deux gestes, parce que c'est le même geste : parcourir la même
// arborescence.
//   mode="save" -> choisir le dossier de destination et le nom du fichier
//   mode="open" -> parcourir et ouvrir un document existant
//
// Il ne charge QUE le dossier affiché (`action=children`, non récursif) : parcourir un drive de
// plusieurs milliers de nœuds ne coûte jamais plus qu'un seul appel par dossier ouvert.

import React from 'react'
import Icon from '../components/Icon.jsx'
import { listFolders, listDocuments, crumbsOf, parentOf, slugify, ZMEDIA_EXT, DEFAULT_MEDIA_DIR } from './document.js'

export default function CreateBrowser({ mode = 'save', startDir = DEFAULT_MEDIA_DIR, defaultName = '', onCancel, onConfirm, onOpen, busy = false }) {
  const [dir, setDir] = React.useState(startDir)
  const [folders, setFolders] = React.useState([])
  const [documents, setDocuments] = React.useState([])
  const [loading, setLoading] = React.useState(true)
  const [name, setName] = React.useState(slugify(defaultName))
  const [newFolder, setNewFolder] = React.useState('')

  React.useEffect(() => {
    let cancelled = false
    setLoading(true)
    Promise.all([listFolders(dir), mode === 'open' ? listDocuments(dir) : Promise.resolve([])])
      .then(([f, d]) => { if (!cancelled) { setFolders(f); setDocuments(d) } })
      .catch(() => { if (!cancelled) { setFolders([]); setDocuments([]) } })
      .finally(() => { if (!cancelled) setLoading(false) })
    return () => { cancelled = true }
  }, [dir, mode])

  const crumbs = crumbsOf(dir)
  const atRoot = crumbs.length <= 1
  const finalPath = `${dir.replace(/\/+$/, '')}/${slugify(name) || 'media'}${ZMEDIA_EXT}`

  // Un dossier n'existe pas tant qu'il ne contient rien : on ne crée donc rien tout de suite,
  // on descend simplement dedans. Le dossier naîtra avec le premier fichier écrit — c'est déjà
  // le comportement de Git, inutile d'inventer une étape de création qui pourrait échouer.
  const enterNewFolder = () => {
    const slug = slugify(newFolder)
    if (!slug) return
    setDir(`${dir.replace(/\/+$/, '')}/${slug}`)
    setNewFolder('')
  }

  return (
    <div className="zrm-browser">
      <div className="zrm-crumbs">
        <button className="zrm-btn zrm-btn-sm zrm-btn-icon" title="Dossier parent" onClick={() => setDir(parentOf(dir))} disabled={atRoot}>
          <Icon name="chevron.left" size={12} />
        </button>
        {crumbs.map((crumb, i) => (
          <React.Fragment key={crumb.path}>
            {i > 0 && <span className="zrm-crumb-sep">/</span>}
            <button className="zrm-crumb" data-on={i === crumbs.length - 1} onClick={() => setDir(crumb.path)}>{crumb.name}</button>
          </React.Fragment>
        ))}
      </div>

      <div className="zrm-browser-list">
        {loading && <p className="zrm-note">Lecture du dossier…</p>}
        {!loading && folders.length === 0 && documents.length === 0 && <p className="zrm-note">Dossier vide.</p>}
        {folders.map((folder) => (
          <button key={folder.path} className="zrm-browser-row" onClick={() => setDir(folder.path)}>
            <Icon name="folder" size={14} />
            <span className="zrm-browser-name">{folder.name}</span>
            <Icon name="chevron.right" size={11} />
          </button>
        ))}
        {documents.map((doc) => (
          <button key={doc.path} className="zrm-browser-row" data-doc="true" onClick={() => onOpen?.(doc.path)}>
            <Icon name="doc.text" size={14} />
            <span className="zrm-browser-name">{doc.name}</span>
          </button>
        ))}
      </div>

      {mode === 'save' ? (
        <div className="zrm-browser-foot">
          <div className="zrm-row">
            <input className="zrm-input" aria-label="Nom du fichier" value={name} placeholder="nom-du-document"
              onChange={(e) => setName(e.target.value)} onKeyDown={(e) => { if (e.key === 'Enter') onConfirm?.(finalPath) }} />
            <input className="zrm-input" aria-label="Nouveau sous-dossier" value={newFolder} placeholder="+ sous-dossier"
              onChange={(e) => setNewFolder(e.target.value)} onKeyDown={(e) => { if (e.key === 'Enter') enterNewFolder() }} />
          </div>
          <p className="zrm-mono zrm-browser-path" title={finalPath}>{finalPath}</p>
          <div className="zrm-row">
            <button className="zrm-btn" onClick={onCancel} disabled={busy}>Annuler</button>
            <button className="zrm-btn zrm-btn-primary" onClick={() => onConfirm?.(finalPath)} disabled={busy || !slugify(name)}>
              {busy ? 'Enregistrement…' : 'Enregistrer ici'}
            </button>
          </div>
        </div>
      ) : (
        <div className="zrm-browser-foot">
          <button className="zrm-btn" onClick={onCancel}>Fermer</button>
        </div>
      )}
    </div>
  )
}
