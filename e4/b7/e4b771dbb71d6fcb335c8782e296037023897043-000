// 3 October 2026, 12:56 : Public comments, replies and mentions. A reply here is PUBLIC and signed by the account. Hiding is reversible and
// silent, so it is the default moderation gesture; deleting is irreversible. A mention belongs to its author: reply only. (3 October 2026)
import React, { useState } from 'react'
import { useAction, useQuery } from './usePostKit.js'
import { Badge, Btn, Card, Empty, ErrorLine, Field, PlatformDot, ago } from './ui.jsx'

function Item({ e, client, reload }) {
  const [reply, setReply] = useState('')
  const act = useAction(reload)
  return (
    <li className="zr-pk-li">
      <div className="zr-pk-row"><PlatformDot platform={e.platform} label={`@${e.author.handle}`} /><Badge tone="muted">{e.kind}</Badge>{e.hidden && <Badge tone="warn">hidden</Badge>}<span className="zr-pk-spacer" /><span className="zr-pk-when">{ago(e.publishedAt)}</span></div>
      <p className="zr-pk-quote">{e.text}</p>
      {e.post?.caption && <p className="zr-pk-meta">under: {e.post.caption.slice(0, 100)}</p>}
      <div className="zr-pk-inline"><input value={reply} onChange={(ev) => setReply(ev.target.value)} placeholder="Public reply" aria-label="Public reply" /><Btn tone="primary" busy={act.busy} disabled={!reply} onClick={() => act.run(() => client.post(`/v1/engagement/${e.id}/reply`, { message: reply }))}>Reply publicly</Btn>
        {e.kind !== 'mention' && <Btn busy={act.busy} onClick={() => act.run(() => client.post(`/v1/engagement/${e.id}/hide`, { hidden: !e.hidden }))}>{e.hidden ? 'Unhide' : 'Hide'}</Btn>}
        <Btn busy={act.busy} onClick={() => act.run(() => client.post(`/v1/engagement/${e.id}/handled`, { handled: true }))}>Mark handled</Btn></div>
      <ErrorLine error={act.error} />
    </li>
  )
}

export default function EngagementPanel({ client, overview, reload }) {
  const feed = useQuery(client, '/v1/engagement?limit=50')
  const summary = useQuery(client, '/v1/engagement/summary')
  const refresh = async () => { await feed.reload(); await summary.reload(); await reload() }
  const sync = useAction(refresh)
  const sandbox = overview.data.accounts.filter((a) => a.platform === 'sandbox' && a.status === 'CONNECTED')
  const [sim, setSim] = useState({ accountId: sandbox[0]?.id || '', handle: 'tom', text: 'Where can I get this?', postId: 'p1' })
  const simAct = useAction(async () => { await client.post('/v1/engagement/sync', {}); await refresh() })
  return (
    <>
      <Card title="Comments to answer" aside={<Btn busy={sync.busy} onClick={() => sync.run(() => client.post('/v1/engagement/sync', {}))}>Sync from platforms</Btn>}>
        {summary.data && <div className="zr-pk-chips">{summary.data.accounts.map((a) => <span key={a.accountId} className="zr-pk-chip"><PlatformDot platform={a.platform} label={a.username} /><Badge tone={a.pending ? 'warn' : 'ok'}>{a.pending} pending</Badge></span>)}</div>}
        <ErrorLine error={feed.error || sync.error} />
        {feed.data?.engagements?.length ? <ul className="zr-pk-list">{feed.data.engagements.map((e) => <Item key={e.id} e={e} client={client} reload={refresh} />)}</ul> : <Empty>{feed.loading ? 'Loading…' : 'Nothing waits for an answer.'}</Empty>}
      </Card>
      {sandbox.length > 0 && <Card><details className="zr-pk-details"><summary>Simulate a comment (sandbox)</summary><div className="zr-pk-grid3">
        <Field label="Account"><select value={sim.accountId} onChange={(e) => setSim({ ...sim, accountId: e.target.value })}>{sandbox.map((a) => <option key={a.id} value={a.id}>{a.username}</option>)}</select></Field>
        <Field label="From"><input value={sim.handle} onChange={(e) => setSim({ ...sim, handle: e.target.value })} /></Field>
        <Field label="Text"><input value={sim.text} onChange={(e) => setSim({ ...sim, text: e.target.value })} /></Field></div>
        <Btn busy={simAct.busy} onClick={() => simAct.run(() => client.post('/v1/sandbox/inject', { accountId: sim.accountId, kind: 'comment', postId: sim.postId, handle: sim.handle, text: sim.text }))}>Inject and sync</Btn><ErrorLine error={simAct.error} /></details></Card>}
    </>
  )
}
