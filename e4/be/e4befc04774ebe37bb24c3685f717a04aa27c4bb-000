// 9 October 2026, 01:52 CEST: Verify cloud folder navigation and its independent breadcrumb.
import React from 'react'
import { act, cleanup, fireEvent, render, waitFor } from '@testing-library/react'
import { afterEach, describe, expect, it, vi } from 'vitest'
import LinkedAssetsGallery from './LinkedAssetsGallery.jsx'

const { indexListeners } = vi.hoisted(() => ({ indexListeners: new Set() }))

vi.mock('../search/searchIndexClient.js', () => ({
  loadSearchIndex: vi.fn(async () => ({ paths: [
    'pages/ZenRayAssets/louisiana-bayou/sources/tmp/workshop/concepts/swamp.png.file.json',
    'pages/ZenRayAssets/louisiana-bayou/sources/tmp/workshop/references/bayou.png.file.json',
    'pages/ZenRayAssets/louisiana-bayou/sources/houdini/materials/wood.png.file.json',
  ] })),
  subscribeSearchIndex: vi.fn((listener) => { indexListeners.add(listener); return () => indexListeners.delete(listener) }),
  getNodeMime: vi.fn(() => null),
}))
vi.mock('../media/useImageThumb.js', () => ({ useInView: () => ({ ref: { current: null }, inView: false }) }))
vi.mock('./QuickLookOverlay.jsx', () => ({ default: () => null }))

afterEach(() => { cleanup(); indexListeners.clear() })

describe('linked Assets Gallery folder view', () => {
  it('shows sources as folders, drills down, and follows breadcrumb clicks', async () => {
    const view = render(<LinkedAssetsGallery project={{ id: 'louisiana-bayou', name: 'Louisiana Bayou' }} t={{ border: '#ddd', textPrimary: '#111', textSecondary: '#666', surface: '#fff' }} />)

    await waitFor(() => expect(view.getByRole('button', { name: 'Ouvrir le dossier Atelier' })).toBeTruthy())
    expect(view.getByRole('button', { name: 'Ouvrir le dossier Houdini' })).toBeTruthy()
    fireEvent.click(view.getByRole('button', { name: 'Ouvrir le dossier Atelier' }))
    await waitFor(() => expect(view.getByRole('button', { name: 'Ouvrir le dossier workshop' })).toBeTruthy())
    fireEvent.click(view.getByRole('button', { name: 'Ouvrir le dossier workshop' }))
    await waitFor(() => expect(view.getByRole('button', { name: 'Ouvrir le dossier concepts' })).toBeTruthy())
    expect(view.getByRole('navigation', { name: 'Chemin des fichiers cloud' }).textContent).toContain('Louisiana Bayou')
    expect(view.getByRole('navigation', { name: 'Chemin des fichiers cloud' }).textContent).toContain('Atelier')

    fireEvent.click(view.getByRole('button', { name: 'Atelier' }))
    await waitFor(() => expect(view.getByRole('button', { name: 'Ouvrir le dossier workshop' })).toBeTruthy())
  })

  it('updates an open gallery when the cached search index refreshes', async () => {
    const view = render(<LinkedAssetsGallery project={{ id: 'louisiana-bayou', name: 'Louisiana Bayou' }} t={{ border: '#ddd', textPrimary: '#111', textSecondary: '#666', surface: '#fff' }} />)
    await waitFor(() => expect(view.getByRole('button', { name: 'Ouvrir le dossier Atelier' })).toBeTruthy())
    fireEvent.click(view.getByRole('button', { name: 'Ouvrir le dossier Atelier' }))
    fireEvent.click(view.getByRole('button', { name: 'Ouvrir le dossier workshop' }))

    const refreshedPaths = [
      'pages/ZenRayAssets/louisiana-bayou/sources/tmp/workshop/02_sources/references/BarrierMesh.png.file.json',
      'pages/ZenRayAssets/louisiana-bayou/sources/tmp/workshop/02_sources/references/EntranceArch.png.file.json',
      'pages/ZenRayAssets/louisiana-bayou/sources/tmp/workshop/02_sources/references/FinishedEnviro.png.file.json',
      'pages/ZenRayAssets/louisiana-bayou/sources/tmp/workshop/02_sources/references/FinishedEnvironGreyPixel.png.file.json',
      'pages/ZenRayAssets/louisiana-bayou/sources/tmp/workshop/02_sources/references/FullEnviroGreyMesh.png.file.json',
      'pages/ZenRayAssets/louisiana-bayou/sources/tmp/workshop/02_sources/references/TerrainRef.png.file.json',
    ]
    act(() => indexListeners.forEach((listener) => listener({ paths: refreshedPaths })))

    fireEvent.click(await view.findByRole('button', { name: 'Ouvrir le dossier 02_sources' }))
    fireEvent.click(await view.findByRole('button', { name: 'Ouvrir le dossier references' }))
    await waitFor(() => expect(view.getByText('FinishedEnviro.png')).toBeTruthy())
    expect(view.getByText('BarrierMesh.png')).toBeTruthy()
    expect(view.getByText('TerrainRef.png')).toBeTruthy()
    expect(view.getByText('6 images au total')).toBeTruthy()
  })
})
