// LanguageSwitcher.jsx — bouton GLOBE unique -> popover segmenté FR / EN / JP (2026-07-06, plan UX validé :
// « FR EN JP devrait être un multiple button toggle encapsulé dans une fine fonction language »).
// Une seule icône visible en permanence ; les 3 états vivent DANS le popover (façon iOS), fermeture au choix
// ou au clic extérieur. Espacements sur l'échelle nombre d'or (GOLD). Change la langue via useLang()
// (état React + localStorage, aucun reload).
//
// Ce fichier exporte AUSSI EyeMenu : le point de restauration des éléments d'UI cachés (uiPrefs.js) —
// un œil qui liste chaque élément enregistré avec un interrupteur, choix persistés au rafraîchissement.
import React from 'react'
import Icon from './Icon.jsx'
import { useLang, SUPPORTED_LANGS } from '../i18n/useT.js'
import { GOLD, HIDEABLES, useUiPref, Pop } from '../lib/uiPrefs.jsx'

const SHORT = { fr: 'FR', en: 'EN', ja: 'JP' }
const SANS = "var(--zr-police-sans)"

export default function LanguageSwitcher({ t }) {
  const [lang, setLang] = useLang()
  return (
    <Pop t={t} title={`Langue : ${SHORT[lang] || lang}`} width={168} trigger={<Icon name="globe" size={16} weight={1.8} color="currentColor" />}>
      {(close) => (
        // segmenté iOS : 3 options équidistantes (grid 3 colonnes = distribution parfaite), gap or S1
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: GOLD.s1 }}>
          {SUPPORTED_LANGS.map((l) => {
            const on = lang === l
            return (
              <button key={l} onClick={() => { setLang(l); close() }}
                style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-xs)', fontWeight: 600, letterSpacing: 0.3, padding: `${GOLD.s1}px 0`, textAlign: 'center', borderRadius: GOLD.s1, border: 'none', cursor: 'pointer', transition: 'background .15s, color .15s',
                  background: on ? (t.textPrimary || '#111') : 'transparent', color: on ? (t.cardBg || '#fff') : (t.textPrimary || '#111') }}>
                {SHORT[l]}
              </button>
            )
          })}
        </div>
      )}
    </Pop>
  )
}

// Interrupteur iOS miniature (l'état vit dans uiPrefs, persisté localStorage).
function Toggle({ t, id }) {
  const [on, setOn] = useUiPref(id, true)
  return (
    <button onClick={() => setOn(!on)} title={on ? 'Cacher' : 'Afficher'}
      style={{ width: 34, height: 20, borderRadius: 999, border: 'none', cursor: 'pointer', padding: 2, background: on ? '#30a46c' : (t.border || 'rgba(0,0,0,0.18)'), transition: 'background .18s', display: 'inline-flex', flexShrink: 0 }}>
      <span style={{ width: 16, height: 16, borderRadius: 999, background: '#fff', transform: on ? 'translateX(14px)' : 'translateX(0)', transition: 'transform .18s', boxShadow: '0 1px 2px rgba(0,0,0,0.25)' }} />
    </button>
  )
}

// Menu œil : liste TOUS les éléments cachables (registre HIDEABLES) avec leur interrupteur.
// C'est LE point de restauration : un élément caché se ré-affiche toujours ici, jamais perdu.
export function EyeMenu({ t }) {
  return (
    <Pop t={t} title="Afficher / cacher des éléments d’interface" width={252} trigger={<Icon name="eye" size={16} weight={1.8} color="currentColor" />}>
      {() => (
        <div style={{ display: 'flex', flexDirection: 'column', gap: GOLD.s1 }}>
          <div style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-2xs)', letterSpacing: 0.4, color: t.textSecondary, padding: `0 ${GOLD.s1}px` }}>INTERFACE</div>
          {HIDEABLES.map((h) => (
            <div key={h.id} style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: GOLD.s2, padding: `${GOLD.s1 - 2}px ${GOLD.s1}px`, borderRadius: GOLD.s1, fontFamily: SANS, fontSize: 'var(--zr-ui-md)', color: t.textPrimary }}>
              <span style={{ minWidth: 0, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{h.label}</span>
              <Toggle t={t} id={h.id} />
            </div>
          ))}
        </div>
      )}
    </Pop>
  )
}
