// MESURER LE GEL PLUTOT QUE DE LE DEVINER — à coller dans la console du navigateur, sur le site.
//
// Un « freeze » est une TÂCHE LONGUE : un calcul synchrone qui monopolise le thread principal, pendant
// lequel aucune frappe, aucun défilement, aucun rendu ne peut passer. Le navigateur sait les signaler
// lui-même (PerformanceObserver, entrée `longtask`), et c'est infiniment plus fiable que l'impression
// d'avoir attendu : on obtient la DURÉE exacte et le nombre.
//
// Seuils utiles : 50 ms est le seuil officiel d'une tâche longue, 100 ms est le moment où l'on ressent
// nettement le retard, au-delà de 300 ms l'interface paraît cassée.
//
// USAGE : coller ce fichier dans la console, puis taper « passeport » dans la recherche, puis lire le
// rapport avec `zrLag.rapport()`. `zrLag.stop()` arrête la mesure.
(() => {
  const taches = []
  const debut = performance.now()
  let obs = null
  try {
    obs = new PerformanceObserver((liste) => {
      for (const e of liste.getEntries()) taches.push({ ms: Math.round(e.duration), a: Math.round(e.startTime - debut) })
    })
    obs.observe({ entryTypes: ['longtask'] })
  } catch { console.warn('longtask non supporté par ce navigateur') }

  // La frappe elle-même : délai entre l'appui sur une touche et le moment où le thread redevient libre.
  const frappes = []
  const surTouche = () => {
    const t = performance.now()
    requestAnimationFrame(() => requestAnimationFrame(() => frappes.push(Math.round(performance.now() - t))))
  }
  window.addEventListener('keydown', surTouche, true)

  const median = (a) => { if (!a.length) return 0; const s = [...a].sort((x, y) => x - y); return s[Math.floor(s.length / 2)] }

  window.zrLag = {
    rapport() {
      const longues = taches.filter((t) => t.ms >= 50)
      const bloquantes = taches.filter((t) => t.ms >= 200)
      const total = taches.reduce((s, t) => s + t.ms, 0)
      console.table(longues.slice(0, 20))
      return {
        duree_mesure_s: +((performance.now() - debut) / 1000).toFixed(1),
        taches_longues_50ms: longues.length,
        taches_bloquantes_200ms: bloquantes.length,
        pire_tache_ms: taches.reduce((m, t) => Math.max(m, t.ms), 0),
        temps_total_bloque_ms: total,
        frappes_mesurees: frappes.length,
        latence_frappe_mediane_ms: median(frappes),
        latence_frappe_pire_ms: frappes.reduce((m, x) => Math.max(m, x), 0),
        verdict: bloquantes.length ? 'GEL CONFIRMÉ' : longues.length > 5 ? 'saccades' : 'fluide',
      }
    },
    stop() { try { obs && obs.disconnect() } catch {} window.removeEventListener('keydown', surTouche, true); return this.rapport() },
  }
  console.log('Mesure démarrée. Tape ta recherche, puis : zrLag.rapport()')
})()
