// Mode d'upload vidéo CHOISI par l'utilisateur, persisté en localStorage.
//
// EN CLAIR : quand on dépose une vidéo, deux moteurs existent.
//   - 'wasm' (défaut) : le NAVIGATEUR transcode la vidéo lui-même (ffmpeg.wasm) puis l'uploade. Zéro Terminal.
//   - 'cmd'           : on génère une COMMANDE à coller dans le Terminal pour un transcodage local sur le Mac.
//
// Ce choix PRIME sur l'aiguillage par taille : si l'utilisateur a choisi 'cmd', on passe toujours par la
// commande, quelle que soit la taille. S'il a choisi 'wasm', on transcode dans le navigateur tant que le
// fichier tient sous le plafond mémoire (sinon repli automatique sur la commande).
//
// 'auto' = ancien comportement : décide selon la taille (wasm si < seuil et navigateur capable, sinon cmd).

const LS_KEY = 'zr:upload-mode'
const EVT = 'zr:upload-mode'
const VALID = new Set(['wasm', 'cmd', 'auto'])

export function getUploadMode() {
  try {
    const v = typeof localStorage !== 'undefined' ? localStorage.getItem(LS_KEY) : null
    return VALID.has(v) ? v : 'wasm'
  } catch { return 'wasm' }
}

export function setUploadMode(mode) {
  const m = VALID.has(mode) ? mode : 'wasm'
  try { localStorage.setItem(LS_KEY, m) } catch { /* localStorage indispo */ }
  try { window.dispatchEvent(new CustomEvent(EVT, { detail: m })) } catch { /* SSR */ }
  return m
}

// S'abonner aux changements de mode (pour resynchroniser une UI). Renvoie une fonction de désabonnement.
export function onUploadModeChange(fn) {
  const h = (e) => fn(e && e.detail)
  try { window.addEventListener(EVT, h); return () => window.removeEventListener(EVT, h) } catch { return () => {} }
}

export const UPLOAD_MODE_EVENT = EVT
