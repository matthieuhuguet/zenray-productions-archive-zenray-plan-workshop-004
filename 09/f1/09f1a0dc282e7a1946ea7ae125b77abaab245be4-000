// 7 October 2026, 09:30 CEST: keeps every project's ConversationIndex.md/json current WITHOUT anyone running a command.
// EN: the index (session -> project, strength, reader id) is regenerated by the service when a bound session progresses, when a session is bound, and at start-up. Every write is read back and checked against the invariants below; a failed check is a visible error and a retry, never a silent stale file.
//   Invariant 1: every session bound to the project (SessionBindings.json) is listed in the JSON, with boundProject equal to the project, even before its transcript cites a project path (strength `bound`).
//   Invariant 2: the markdown lists exactly the conversations of the JSON, and both come from the same scan.
//   Invariant 3: files are written atomically (temporary file then rename), never half written.
// FR : l'index des conversations est regenere par le service quand une session liee avance, quand une session est liee, et au demarrage. Chaque ecriture est relue et verifiee ; un controle qui echoue est une erreur visible suivie d'une nouvelle tentative, jamais un fichier perime en silence.
import { readFile, writeFile, rename, rm } from 'node:fs/promises'
import path from 'node:path'
import { linkConversations, renderConversationIndex, writeJsonAtomic } from './ConversationLinks.mjs'

export const INDEX_SYNC_SETTINGS = { sweepMs: 60_000, quietMs: 30_000, maxWaitMs: 300_000, jsonFile: 'ConversationIndex.json', markdownFile: 'ConversationIndex.md' }
const parisDate = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeZone: 'Europe/Paris' })
const readJson = async (file, fallback) => { try { return JSON.parse(await readFile(file, 'utf8')) } catch (error) { if (error.code === 'ENOENT') return fallback; throw error } }
// 13 October 2026: prefer the project's own notes folder (beside FEEDBACK.md), as AssetsService does; the first memory source can be a linked social post or letters folder.
export const memoryFolder = (index, projectId) => {
  const memory = index?.projects?.[projectId]?.locations?.memory || []
  return (memory.find(item => item.sourceId === 'project-notes') || memory.find(item => String(item.localPath || '').endsWith(`/Projects/${projectId}`)) || memory[0])?.localPath || null
}

// Bound sessions that do not cite a project path yet still belong in the index (a brand new conversation, a Gemini session not decoded yet).
export function completeWithBound({ projectId, links, bindings, conversations, metadata = {} }) {
  const listed = links.byProject[projectId] || [], present = new Set(listed.map(item => item.sessionId)), warnings = [], extra = []
  const bySession = new Map(conversations.map(item => [item.sessionId, item]))
  for (const [sessionId, boundProject] of Object.entries(bindings)) {
    if (boundProject !== projectId || present.has(sessionId)) continue
    const conversation = bySession.get(sessionId), provider = conversation?.provider || metadata[sessionId]?.provider || 'unknown'
    if (!conversation?.readable) warnings.push(`${provider}:${sessionId} is bound to ${projectId} but its transcript is not readable yet`)
    extra.push({ projectId, strength: 'bound', lines: 0, work: 0, prompts: 0, first: null, last: conversation?.updatedAt || null,
      conversationId: conversation?.id || metadata[sessionId]?.id || `${provider}:${sessionId}`, provider, sessionId,
      title: conversation?.title || metadata[sessionId]?.title || sessionId, updatedAt: conversation?.updatedAt || null, bytes: conversation?.bytes || 0, boundProject: projectId })
  }
  return { list: [...listed, ...extra], warnings, boundOnly: extra.length }
}

export function renderIndexMarkdown(projectId, links, list, date, boundOnly) {
  const markdown = renderConversationIndex(projectId, { ...links, byProject: { ...links.byProject, [projectId]: list } }, date)
  return boundOnly ? markdown + `Strength \`bound\`: the session is bound to this project in SessionBindings.json but its transcript has not cited a project path yet. (${date})\n` : markdown
}

// Write both files atomically, then read them back and check the invariants. Returns the problems found (empty = impeccable).
export async function writeProjectIndex({ folder, projectId, links, list, date, boundOnly = 0, bindings }) {
  const jsonFile = path.join(folder, INDEX_SYNC_SETTINGS.jsonFile), markdownFile = path.join(folder, INDEX_SYNC_SETTINGS.markdownFile)
  const temporary = `${markdownFile}.${process.pid}.tmp`
  await writeJsonAtomic(jsonFile, { schemaVersion: 1, projectId, scannedAt: links.scannedAt, conversations: list })
  try { await writeFile(temporary, renderIndexMarkdown(projectId, links, list, date, boundOnly), { mode: 0o600 }); await rename(temporary, markdownFile) } finally { await rm(temporary, { force: true }) }
  return verifyWrittenIndex({ projectId, folder, bindings })
}

export async function verifyWrittenIndex({ projectId, folder, bindings }) {
  let json, markdown
  try { json = JSON.parse(await readFile(path.join(folder, INDEX_SYNC_SETTINGS.jsonFile), 'utf8')); markdown = await readFile(path.join(folder, INDEX_SYNC_SETTINGS.markdownFile), 'utf8') }
  catch (error) { return [`index files unreadable: ${error.message}`] }
  const problems = [], listed = new Map((json.conversations || []).map(item => [item.sessionId, item]))
  if (json.projectId !== projectId) problems.push(`the JSON names project ${json.projectId}, expected ${projectId}`)
  for (const [sessionId, boundProject] of Object.entries(bindings)) {
    if (boundProject !== projectId) continue
    const item = listed.get(sessionId)
    if (!item) problems.push(`bound session ${sessionId} is missing from the index`)
    else if (item.boundProject !== projectId) problems.push(`bound session ${sessionId} is listed as bound to ${item.boundProject}`)
  }
  for (const item of json.conversations || []) if (!markdown.includes(`\`${item.conversationId}\``)) problems.push(`${item.conversationId} is in the JSON but not in the markdown`)
  if (!json.scannedAt || !markdown.includes(json.scannedAt)) problems.push('the markdown and the JSON come from different scans')
  return problems
}

export function createConversationIndexSync({ stateDir, catalog, onEvent = () => {}, settings = {}, now = () => Date.now() }) {
  const options = { ...INDEX_SYNC_SETTINGS, ...settings }
  const dirty = new Map(), status = { startedAt: null, lastRunAt: null, lastOk: null, error: null, warnings: [], projects: {} }
  let quietTimer, sweepTimer, running = null, closed = false, again = false

  const state = async () => ({
    index: await readJson(path.join(stateDir, 'GlobalProjectIndex.json'), {}),
    bindings: await readJson(path.join(stateDir, 'SessionBindings.json'), {}),
    metadata: await readJson(path.join(stateDir, 'SessionConversationMetadata.json'), {}) })

  // A project is stale when its index is missing, lacks a bound session, or is older than the newest activity of a listed or bound session.
  async function findStale() {
    const { index, bindings } = await state(), { conversations } = await catalog.list(), stale = []
    const bySession = new Map(conversations.map(item => [item.sessionId, item]))
    for (const projectId of new Set(Object.values(bindings))) {
      const folder = memoryFolder(index, projectId)
      if (!folder) continue
      const json = await readJson(path.join(folder, options.jsonFile), null)
      if (!json) { stale.push(projectId); continue }
      const scanned = Date.parse(json.scannedAt), listed = new Set((json.conversations || []).map(item => item.sessionId))
      // A listed session whose binding changed since the scan (unbound then bound) makes the file wrong even if nothing was said in it.
      if ((json.conversations || []).some(item => (bindings[item.sessionId] || null) !== (item.boundProject || null))) { stale.push(projectId); continue }
      const sessions = [...Object.entries(bindings).filter(([, id]) => id === projectId).map(([sessionId]) => sessionId), ...listed]
      if ([...new Set(sessions)].some(sessionId => !listed.has(sessionId) || Date.parse(bySession.get(sessionId)?.updatedAt) > scanned)) stale.push(projectId)
    }
    return stale
  }

  async function runOnce(projectIds) {
    const { index, bindings, metadata } = await state(), { conversations } = await catalog.list()
    const links = await linkConversations({ conversations, index, stateDir, bindings, readConversation: (id, before) => catalog.read(id, before) })
    const date = parisDate.format(new Date(now())), warnings = [], failures = []
    for (const projectId of projectIds) {
      const folder = memoryFolder(index, projectId)
      if (!folder) { warnings.push(`${projectId}: no memory folder, index not written`); continue }
      try {
        const { list, warnings: found, boundOnly } = completeWithBound({ projectId, links, bindings, conversations, metadata })
        warnings.push(...found.map(text => `${projectId}: ${text}`))
        const problems = await writeProjectIndex({ folder, projectId, links, list, date, boundOnly, bindings })
        status.projects[projectId] = { writtenAt: new Date(now()).toISOString(), conversations: list.length, bound: list.filter(item => item.boundProject === projectId).length, error: problems.join('; ') || null }
        if (problems.length) { failures.push(`${projectId}: ${problems.join('; ')}`); onEvent(projectId, 'conversation-index-error', problems.join('; ')) }
        else onEvent(projectId, 'conversation-index', `${list.length} conversations, ${status.projects[projectId].bound} bound`)
      } catch (error) { failures.push(`${projectId}: ${error.message}`); status.projects[projectId] = { ...status.projects[projectId], error: error.message }; onEvent(projectId, 'conversation-index-error', error.message) }
    }
    status.warnings = warnings
    if (failures.length) throw new Error(failures.join(' | '))
  }

  async function flush() {
    if (closed) return
    if (running) { again = true; return running }
    const ids = [...dirty.keys()]; dirty.clear()
    if (!ids.length) return
    running = (async () => {
      try { await runOnce(ids); status.lastOk = true; status.error = null }
      catch (error) { status.lastOk = false; status.error = error.message; for (const id of ids) dirty.set(id, now()) }
      finally { status.lastRunAt = new Date(now()).toISOString(); running = null }
    })()
    await running
    // A failed run is retried by the next sweep (the index is still stale), not in a tight loop.
    if (again || [...dirty.keys()].some(id => !ids.includes(id))) { again = false; schedule() }
  }

  function schedule(immediate = false) {
    if (closed || !dirty.size) return
    clearTimeout(quietTimer)
    const oldest = Math.min(...dirty.values()), wait = immediate ? 0 : Math.max(0, Math.min(options.quietMs, options.maxWaitMs - (now() - oldest)))
    quietTimer = setTimeout(() => { flush().catch(() => {}) }, wait); quietTimer.unref?.()
  }

  function request(projectId, { immediate = false } = {}) {
    if (closed || !projectId) return
    if (!dirty.has(projectId)) dirty.set(projectId, now())
    schedule(immediate)
  }

  async function sweep() {
    if (dirty.size) schedule()   // a failed run keeps its projects dirty: retry them on the next sweep
    try { for (const projectId of await findStale()) request(projectId) }
    catch (error) { status.error = `sweep failed: ${error.message}`; status.lastOk = false }
  }

  return {
    request, sweep, flush, status: () => ({ ...status, pending: [...dirty.keys()] }),
    start() { if (sweepTimer || closed) return; status.startedAt = new Date(now()).toISOString(); sweep(); sweepTimer = setInterval(sweep, options.sweepMs); sweepTimer.unref?.() },
    async close() { closed = true; clearInterval(sweepTimer); clearTimeout(quietTimer); await running?.catch(() => {}) } }
}
