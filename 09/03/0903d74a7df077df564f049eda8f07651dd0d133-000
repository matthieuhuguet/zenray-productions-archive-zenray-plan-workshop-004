import { describe, it, expect } from 'vitest'
import { renderToStaticMarkup } from 'react-dom/server'
import UploadTimingBanner from './UploadTimingBanner.jsx'

describe('UploadTimingBanner', () => {
  it('shows the message and a progress bar at the real percentage', () => {
    const html = renderToStaticMarkup(<UploadTimingBanner report={{ label: 'Bleach S17E25 + E26', done: false, message: 'Bleach S17E25 + E26 : 3 min 08 s écoulées', summary: { progress: 0.52 } }} />)
    expect(html).toContain('role="progressbar"')
    expect(html).toContain('aria-valuenow="52"')
    expect(html).toContain('width:52%')
  })
  it('is full when done and renders nothing without a report (red controls)', () => {
    expect(renderToStaticMarkup(<UploadTimingBanner report={{ label: 'x', done: true, message: 'ok', summary: { progress: 0.1 } }} />)).toContain('aria-valuenow="100"')
    expect(renderToStaticMarkup(<UploadTimingBanner report={null} />)).toBe('')
  })
  it('lists every file of the queue with its stage and dims a held report (14 October 2026)', () => {
    const html = renderToStaticMarkup(<UploadTimingBanner held report={{ label: 'x', done: false, message: 'Envoi : 1 sur 2 terminés', summary: { progress: 0.5 }, queue: [{ name: 'a.mkv', stage: 'done', label: 'terminé' }, { name: 'b.mkv', stage: 'archive', label: 'envoi' }] }} />)
    expect(html).toContain('a.mkv')
    expect(html).toContain('data-stage="archive"')
    expect(html).toContain('data-held="true"')
  })
  it('uses the sidebar glass, offers a toggle, and collapses to a pill that keeps the percentage (14 October 2026)', () => {
    const report = { label: 'x', done: false, message: 'Envoi : 1 sur 2 terminés', summary: { progress: 0.5 } }
    const open = renderToStaticMarkup(<UploadTimingBanner report={report} onToggle={() => {}} />)
    expect(open).toContain('zr-liquid')
    expect(open).toContain('Masquer')
    const pill = renderToStaticMarkup(<UploadTimingBanner report={report} collapsed onToggle={() => {}} />)
    expect(pill).toContain('zr-upload-timing-pill')
    expect(pill).toContain('50')
    expect(pill).not.toContain('role="progressbar"')
    expect(renderToStaticMarkup(<UploadTimingBanner report={report} />)).not.toContain('Masquer')
  })
})
