// 3 October 2026, 12:12 : Minimal client for the PostKit API. Failures are classified so the view can say what is wrong:
// offline (nothing is listening), unauthorized (missing or revoked key) or http (the API answered with an error). (3 October 2026)
import { POSTKIT } from './postkitConfig.js'

export class PostKitError extends Error {
  constructor(kind, message, { status = 0, code = null, details = null } = {}) { super(message); this.name = 'PostKitError'; this.kind = kind; this.status = status; this.code = code; this.details = details }
}

export function createClient({ baseUrl, key, fetchImpl, timeoutMs = POSTKIT.requestTimeoutMs } = {}) {
  const doFetch = fetchImpl || ((...a) => fetch(...a))
  const root = String(baseUrl || POSTKIT.defaultBaseUrl).replace(/\/$/, '')
  async function request(method, path, body) {
    const controller = new AbortController()
    const timer = setTimeout(() => controller.abort(), timeoutMs)
    let res
    try {
      res = await doFetch(`${root}${path}`, { method, signal: controller.signal, headers: { ...(key ? { authorization: `Bearer ${key}` } : {}), ...(body !== undefined ? { 'content-type': 'application/json' } : {}) }, body: body !== undefined ? JSON.stringify(body) : undefined })
    } catch (e) { throw new PostKitError('offline', `PostKit is not reachable at ${root}.`) } finally { clearTimeout(timer) }
    const text = await res.text()
    let data = null
    try { data = text ? JSON.parse(text) : null } catch { data = text }
    if (res.status === 401) throw new PostKitError('unauthorized', 'The PostKit key is missing, wrong or revoked.', { status: 401 })
    if (!res.ok) throw new PostKitError('http', data?.error?.message || `PostKit answered ${res.status}.`, { status: res.status, code: data?.error?.code, details: data?.error })
    return data
  }
  // Multipart upload of a file to the media library (no JSON content type: the browser sets the boundary). (3 October 2026)
  async function upload(file) {
    const fd = new FormData(); fd.append('file', file)
    let res
    try { res = await doFetch(`${root}/v1/media/upload`, { method: 'POST', headers: key ? { authorization: `Bearer ${key}` } : {}, body: fd }) } catch { throw new PostKitError('offline', `PostKit is not reachable at ${root}.`) }
    const data = await res.json().catch(() => null)
    if (!res.ok) throw new PostKitError('http', data?.error?.message || `Upload failed (${res.status}).`, { status: res.status })
    return data
  }
  return { baseUrl: root, hasKey: !!key, upload, get: (p) => request('GET', p), post: (p, b = {}) => request('POST', p, b), patch: (p, b = {}) => request('PATCH', p, b), del: (p) => request('DELETE', p) }
}

export function loadConfig(storage = globalThis.localStorage) {
  try { const v = JSON.parse(storage.getItem(POSTKIT.storageKey)); if (v && typeof v === 'object') return { baseUrl: v.baseUrl || POSTKIT.defaultBaseUrl, key: v.key || '' } } catch {}
  return { baseUrl: POSTKIT.defaultBaseUrl, key: '' }
}
export function saveConfig(config, storage = globalThis.localStorage) { try { storage.setItem(POSTKIT.storageKey, JSON.stringify(config)) } catch {} }

export const qs = (params = {}) => { const s = new URLSearchParams(Object.entries(params).filter(([, v]) => v !== undefined && v !== null && v !== '').map(([k, v]) => [k, String(v)])).toString(); return s ? `?${s}` : '' }
