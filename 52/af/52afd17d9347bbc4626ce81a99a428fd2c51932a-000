// 10 October 2026, 21:06 CEST: Unload a verified local video only after its complete cloud recovery receipt matches.
import fs from 'node:fs'
import { unloadVerifiedVideo, unloadStreamedVideo } from './lib/video-cloud-recovery.mjs'

const [receiptPath, sourceRoot, auditDir] = process.argv.slice(2)
if (!receiptPath || !sourceRoot || !auditDir) {
  throw new Error('Usage: UnloadVideoCloud.mjs <receiptPath> <sourceRoot> <auditDir>')
}
const receipt = JSON.parse(fs.readFileSync(receiptPath, 'utf8'))
if (!receipt.manifestPath) {
  throw new Error('Receipt is missing manifestPath')
}
// 14 October 2026: a streaming-v1 receipt (policy streaming only) goes through unloadStreamedVideo. FR : recu de streaming -> chemin streame.
const unload = receipt.kind === 'streaming-v1' ? unloadStreamedVideo : unloadVerifiedVideo
const result = await unload({
  receiptPath,
  manifestPath: receipt.manifestPath,
  sourceRoot,
  auditDir,
  isQueueRequired: async () => false,
})
console.log(JSON.stringify(result))
