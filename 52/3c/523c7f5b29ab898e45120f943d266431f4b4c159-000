import { describe, it, expect } from 'vitest'
import { decidesRafraichissement, dossierDe } from './rafraichirApres.js'

const VUE = 'pages/Photos/DJI/29 Aout 2026/Photos'

describe('dossierDe', () => {
  it('rend le parent d’un chemin', () => {
    expect(dossierDe('pages/A/B/x.img.json')).toBe('pages/A/B')
    expect(dossierDe('pages/A')).toBe('pages')
  })
  it('ne casse pas sur un chemin sans parent', () => {
    expect(dossierDe('x.json')).toBe('')
    expect(dossierDe('')).toBe('')
    expect(dossierDe(null)).toBe('')
  })
})

describe('decidesRafraichissement — ce qui vient d’être créé doit apparaître', () => {
  it('créé DIRECTEMENT dans la vue : on recharge', () => {
    const r = decidesRafraichissement([`${VUE}/IMG_1.img.json`], VUE)
    expect(r.aRecharger).toBe(VUE)
    expect(r.aInvalider).toEqual([VUE])
  })

  it('créé PLUS PROFOND sous la vue : on recharge AUSSI — c’est le bug de Matthieu', () => {
    // Trier vers `tmp-img-selection1` écrit deux niveaux plus bas, mais le dossier qui porte le lien
    // est un enfant direct de ce qu'on regarde : sans ce cas, il reste invisible.
    const r = decidesRafraichissement([`${VUE}/tmp-img-selection1/IMG_1.img.json`], VUE)
    expect(r.aRecharger).toBe(VUE)
    expect(r.aInvalider).toEqual([`${VUE}/tmp-img-selection1`])
  })

  it('créé encore plus profond : on recharge toujours la vue', () => {
    const r = decidesRafraichissement([`${VUE}/a/b/c/IMG.img.json`], VUE)
    expect(r.aRecharger).toBe(VUE)
  })

  it('créé AILLEURS : on invalide pour plus tard, on ne recharge PAS', () => {
    // Recharger un dossier sans rapport coûte un appel pour rien et fait clignoter la vue.
    const r = decidesRafraichissement(['pages/Build/autre/IMG.img.json'], VUE)
    expect(r.aRecharger).toBe(null)
    expect(r.aInvalider).toEqual(['pages/Build/autre'])
  })

  it('créé AU-DESSUS de la vue : rien à recharger', () => {
    const r = decidesRafraichissement(['pages/Photos/DJI/x.img.json'], VUE)
    expect(r.aRecharger).toBe(null)
    expect(r.aInvalider).toEqual(['pages/Photos/DJI'])
  })

  it('un nom qui COMMENCE pareil n’est pas dessous', () => {
    // `…/PhotosBis` commence par `…/Photos` sans être dedans. Sans la barre, on rechargerait à tort.
    const r = decidesRafraichissement([`${VUE}Bis/IMG.img.json`], VUE)
    expect(r.aRecharger).toBe(null)
  })

  it('un lot mixte : la vue se recharge dès qu’UN chemin la touche, tous les parents s’invalident', () => {
    const r = decidesRafraichissement([
      'pages/Build/ailleurs/a.img.json',
      `${VUE}/tmp-img-selection1/b.img.json`,
      `${VUE}/c.img.json`,
    ], VUE)
    expect(r.aRecharger).toBe(VUE)
    expect(r.aInvalider.sort()).toEqual(['pages/Build/ailleurs', `${VUE}`, `${VUE}/tmp-img-selection1`].sort())
  })

  it('ne casse sur aucune entrée vide, nulle ou mal formée', () => {
    expect(decidesRafraichissement([], VUE)).toEqual({ aInvalider: [], aRecharger: null })
    expect(decidesRafraichissement(null, VUE)).toEqual({ aInvalider: [], aRecharger: null })
    expect(decidesRafraichissement([null, '', 42, {}], VUE)).toEqual({ aInvalider: [], aRecharger: null })
  })

  it('sans dossier affiché, on invalide sans rien recharger', () => {
    const r = decidesRafraichissement([`${VUE}/x.img.json`], null)
    expect(r.aRecharger).toBe(null)
    expect(r.aInvalider).toEqual([VUE])
  })

  it('une barre finale sur la vue ne change rien', () => {
    expect(decidesRafraichissement([`${VUE}/x.img.json`], VUE + '/').aRecharger).toBe(VUE)
  })
})
