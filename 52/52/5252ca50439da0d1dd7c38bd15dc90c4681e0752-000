// public-shard.test.js (14 October 2026)
import { describe, it, expect } from 'vitest'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { allocatePublicShard } from './public-shard.mjs'

// repositories 90 to 92 are renamed (200 with another full_name), 93 does not exist (404 then created)
const fakeFetch = (log) => async (url, init = {}) => {
  const match = /repos\/matthieuhuguet\/(zenray-vid-public-(\d+))$/.exec(url)
  if (init.method === 'POST') { log.push('create'); return { ok: true, status: 201, json: async () => ({}) } }
  const n = Number(match[2])
  if (n >= 90 && n <= 92) return { status: 200, ok: true, json: async () => ({ full_name: `matthieuhuguet/zenrayshards-vid-abc${n}` }) }
  return { status: 404, ok: false, json: async () => ({}) }
}

describe('allocatePublicShard', () => {
  it('skips renamed repositories and creates the first free name', async () => {
    const clone = fs.mkdtempSync(path.join(os.tmpdir(), 'shard-'))
    fs.mkdirSync(path.join(clone, 'pages'), { recursive: true })
    fs.writeFileSync(path.join(clone, 'pages/.zr-vid-drive.json'), JSON.stringify({ active: 'zenray-vid-public-90', bytes: 10 }))
    const log = []
    const got = await allocatePublicShard(clone, 1000, 'token', { persist: false, fetchImpl: fakeFetch(log) })
    expect(got.repo).toBe('zenray-vid-public-93')
    expect(got.state.bytes).toBe(1000)
    expect(log).toEqual(['create'])
    fs.rmSync(clone, { recursive: true, force: true })
  })
})
