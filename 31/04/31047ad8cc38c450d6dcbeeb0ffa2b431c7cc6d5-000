// 9 October 2026 09:32 CEST: Check the shared renderer context before adapting specialized viewers.
import React from 'react'
import { afterEach, describe, expect, it, vi } from 'vitest'
import { cleanup, render, screen } from '@testing-library/react'
import { isSymbol } from '../components/Icon.jsx'
import { dispatchNodeOpen, NodeRenderer, REGISTRY } from './registry.jsx'

afterEach(() => cleanup())

describe('node registry', () => {
  it('registers every path type with renderer and routing metadata', () => {
    expect(Object.keys(REGISTRY)).toEqual(['folder', 'page', 'db', 'media', 'image', 'canvas', 'embed', 'file', 'plan', 'zmedia', 'comment'])
    for (const definition of Object.values(REGISTRY)) {
      expect(typeof definition.Renderer).toBe('function')
      expect(['navigate', 'editor', 'overlay']).toContain(definition.open)
      expect(isSymbol(definition.icon)).toBe(true)
      expect(typeof definition.ext).toBe('string')
      expect(typeof definition.creatable).toBe('boolean')
    }
  })

  it('chooses the renderer from the resolved path instead of stale node metadata', () => {
    render(<NodeRenderer node={{ type: 'page', contentPath: 'pages/old.md' }} path="pages/real.img.json"
      renderers={{ image: ({ path, type }) => <span role="status">{type}:{path}</span> }} />)
    expect(screen.getByRole('status').textContent).toBe('image:pages/real.img.json')
  })

  it('sends unregistered Create leaves through the existing page renderer', () => {
    render(<NodeRenderer node={{ type: 'folder', contentPath: 'pages/report.pdf' }} path="pages/report.pdf" context="create"
      renderPage={() => <span role="status">page fallback</span>} />)
    expect(screen.getByRole('status').textContent).toBe('page fallback')
  })

  it('passes the common node context to the page renderer', () => {
    const theme = { id: 'light' }
    const paths = ['pages/notes.md', 'pages/table.db.json']
    const onOpenPage = vi.fn()
    render(<NodeRenderer node={{ contentPath: 'pages/notes.md' }} path="pages/notes.md" context="create" t={theme}
      title="Notes" paths={paths} onOpenPage={onOpenPage}
      renderPage={(context) => <span role="status">{JSON.stringify({
        t: context?.t?.id || null,
        path: context?.path || null,
        title: context?.title || null,
        paths: context?.paths || null,
        onOpenPage: typeof context?.onOpenPage === 'function',
      })}</span>} />)
    expect(screen.getByRole('status').textContent).toBe(JSON.stringify({
      t: 'light', path: 'pages/notes.md', title: 'Notes', paths, onOpenPage: true,
    }))
  })

  it('routes folder, editor and explicit overlay actions through registry metadata', () => {
    const navigate = vi.fn()
    const editor = vi.fn()
    const overlay = vi.fn()
    const handlers = { navigate, editor, overlay }
    const folder = { type: 'folder', dir: 'pages/assets' }
    const folderWithOwnPage = { type: 'page', dir: 'pages/project', contentPath: 'pages/project.md', hasKids: true }
    const page = { contentPath: 'pages/notes.md' }
    const audio = { contentPath: 'pages/music.media.json' }

    expect(dispatchNodeOpen(folder, handlers)).toBe(true)
    expect(dispatchNodeOpen(folderWithOwnPage, handlers, 'navigate')).toBe(true)
    expect(dispatchNodeOpen(page, handlers)).toBe(true)
    expect(dispatchNodeOpen(audio, handlers, 'overlay')).toBe(true)
    expect(navigate).toHaveBeenCalledWith(folder)
    expect(navigate).toHaveBeenCalledWith(folderWithOwnPage)
    expect(editor).toHaveBeenCalledWith(page)
    expect(overlay).toHaveBeenCalledWith(audio)
  })
})
