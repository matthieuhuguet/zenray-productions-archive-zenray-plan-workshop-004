// 2026-09-11 ZenRay Assets v2 pure logic: schema reader, folder listing, sections, storage dot.
// FR : logique pure de ZenRay Assets, lecteur de schéma, liste d'un dossier, sections, pastille.
import { describe, it, expect } from 'vitest'
import { normalizeProject, mergeAssetsProjects, DEFAULT_ASSETS_PROJECTS, projectPaths, coverPath, folderView, crumbs, excerptOf, storageState, sourceState, readableSize } from './assetsProjects.js'
import { UI } from '../config/colors.js'

const F = 'pages/ZenRayAssets/tmp-louisiana-bayou-houdini-church'
const INDEX = [
  `${F}/shorts/reel-01-armature.mp4.media.json`,
  `${F}/shorts/raw/reel-01-armature-raw.mov.media.json`,
  `${F}/shorts/post-3components-zenray-houdini.md.file.json`,
  `${F}/images/hero-rear.webp.img.json`,
  `${F}/images/.DS_Store.file.json`,
  `${F}/cover.png.img.json`,
  `${F}-other/should-not-leak.png.img.json`,
  'pages/Elsewhere/unrelated.png.img.json',
]

describe('mergeAssetsProjects', () => {
  it('adds default projects (materials and meshes) when drive list is empty', () => {
    const list = mergeAssetsProjects([])
    expect(list.some((p) => p.id === 'zenray-assets-materials')).toBe(true)
    expect(list.some((p) => p.id === 'zenray-assets-meshes')).toBe(true)
  })

  it('sorts projects by date descending like an email inbox', () => {
    const drive = [
      { id: 'old', name: 'Old Project', date: '2026-08-01' },
      { id: 'mid', name: 'Mid Project', date: '2026-09-10' },
    ]
    const list = mergeAssetsProjects(drive)
    expect(list[0].date).toBe('2026-09-19')
    expect(list[1].date).toBe('2026-09-19')
    expect(list[2].id).toBe('mid')
    expect(list[3].id).toBe('old')
  })
})

describe('normalizeProject', () => {
  it('reads the legacy French keys so no deposited project is lost', () => {
    const p = normalizeProject({ id: 'x', nom: 'Retour', categorie: 'Plan', resume: 'r', depose: '2026-09-10',
      vitrine: [{ image: '/a.webp', titre: 'T', note: 'n' }], composants: [{ nom: 'C', groupe: 'G', court: 's', poids: '1 Kio', lien: 'https://x' }] })
    expect(p).toMatchObject({ id: 'x', name: 'Retour', category: 'Plan', summary: 'r', date: '2026-09-10', folder: null })
    expect(p.showcase[0]).toEqual({ image: '/a.webp', title: 'T', note: 'n' })
    expect(p.components[0]).toMatchObject({ name: 'C', group: 'G', short: 's', size: '1 Kio', link: 'https://x' })
  })
  it('reads the English v2 keys', () => {
    const p = normalizeProject({ id: 'y', name: 'Studio', category: 'Design', folder: F, sources: [{ localPath: '/a', present: true }] })
    expect(p).toMatchObject({ id: 'y', name: 'Studio', category: 'Design', folder: F })
    expect(p.sources).toHaveLength(1)
  })
  it('rejects garbage without throwing', () => {
    expect(normalizeProject(null)).toBe(null)
  })
})

describe('projectPaths', () => {
  it('keeps only the project folder, never a sibling with the same prefix, never .DS_Store', () => {
    const own = projectPaths(F, INDEX)
    expect(own).toHaveLength(5)
    expect(own.some((p) => p.includes('-other/'))).toBe(false)
    expect(own.some((p) => p.includes('.DS_Store'))).toBe(false)
  })
  it('returns nothing for a project without a folder', () => {
    expect(projectPaths(null, INDEX)).toEqual([])
  })
})

describe('coverPath', () => {
  const own = projectPaths(F, INDEX)
  it('resolves a cover named by its source file to the image manifest', () => {
    expect(coverPath({ cover: `${F}/images/hero-rear.webp` }, own)).toBe(`${F}/images/hero-rear.webp.img.json`)
  })
  it('keeps a cover already named by its manifest', () => {
    expect(coverPath({ cover: `${F}/cover.png.img.json` }, own)).toBe(`${F}/cover.png.img.json`)
  })
  it('falls back to the first image when the cover is missing or unknown', () => {
    expect(coverPath({ cover: `${F}/nope.jpg` }, own)).toMatch(/\.img\.json$/)
    expect(coverPath({}, [])).toBe(null)
  })
})

describe('folderView', () => {
  it('shows root files, one group per sub-folder, and deeper folders as cards', () => {
    const v = folderView(F, projectPaths(F, INDEX))
    expect(v.files.map((e) => e.name)).toEqual(['cover.png'])
    expect(v.groups.map((g) => g.title)).toEqual(['images', 'shorts'])
    const shorts = v.groups.find((g) => g.title === 'shorts')
    expect(shorts.files.map((e) => e.name).sort()).toEqual(['post-3components-zenray-houdini.md', 'reel-01-armature.mp4'])
    expect(shorts.folders).toEqual([{ dir: `${F}/shorts/raw`, name: 'raw', count: 1 }])
    expect(shorts.count).toBe(3)
  })
  it('opens a deeper folder in place', () => {
    const v = folderView(`${F}/shorts/raw`, projectPaths(F, INDEX))
    expect(v.files.map((e) => e.name)).toEqual(['reel-01-armature-raw.mov'])
    expect(v.groups).toEqual([])
  })
})

describe('crumbs', () => {
  it('walks from the project folder to the open folder', () => {
    expect(crumbs(F, `${F}/shorts/raw`)).toEqual([{ name: 'shorts', dir: `${F}/shorts` }, { name: 'raw', dir: `${F}/shorts/raw` }])
    expect(crumbs(F, F)).toEqual([])
  })
})

describe('storageState', () => {
  it('is orange while one source still sits on the Mac, with its size', () => {
    const st = storageState({ sources: [{ present: true, bytes: 52e6 }, { present: false, bytes: 9e6 }] })
    expect(st.color).toBe(UI.orange)
    expect(st.label).toContain('52,0 Mo')
  })
  it('is green once every source is gone from the Mac', () => {
    expect(storageState({ sources: [{ present: false }] }).color).toBe(UI.green)
  })
  it('never counts a versioned `keep` source as space to free', () => {
    expect(storageState({ sources: [{ present: true, keep: true, bytes: 9e6 }, { present: false }] }).color).toBe(UI.green)
    expect(sourceState({ present: true, keep: true }).color).toBe(UI.blue)
    expect(sourceState({ present: true, bytes: 52e6 }).color).toBe(UI.orange)
    expect(sourceState({ present: false }).color).toBe(UI.green)
  })
  it('says nothing for a project without sources', () => {
    expect(storageState({ sources: [] })).toBe(null)
  })
})

describe('readableSize', () => {
  it('formats in French units', () => {
    expect(readableSize(7838)).toBe('8 Ko')
    expect(readableSize(52e6)).toBe('52,0 Mo')
    expect(readableSize(0)).toBe('')
  })
})

describe('excerptOf', () => {
  it('reads a Markdown title and its first words without the syntax', () => {
    const x = excerptOf('plan.md', '# Plan des 12 semaines\n\n**10 000 €** au minimum\n- freelance\n---\n| a | b |')
    expect(x.title).toBe('Plan des 12 semaines')
    expect(x.lines).toEqual(['10 000 € au minimum', 'freelance', 'a   b'])
    expect(x.mono).toBe(false)
  })
  it('reads an HTML title and its visible text, never its scripts', () => {
    const x = excerptOf('cal.html', '<html><head><title>PVT 2027</title><style>p{}</style></head><body><h1>Calendrier</h1><script>evil()</script><p>Marseille</p></body></html>')
    expect(x.title).toBe('PVT 2027')
    expect(x.lines).toEqual(['Calendrier', 'Marseille'])
  })
  it('shows code as its first lines, in mono', () => {
    const x = excerptOf('a.css', ':root{\n  --a:1;\n}\n')
    expect(x).toEqual({ title: '', lines: [':root{', '  --a:1;', '}'], mono: true })
  })
})

