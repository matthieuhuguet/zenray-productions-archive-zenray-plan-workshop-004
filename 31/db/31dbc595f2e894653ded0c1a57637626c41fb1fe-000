// ═══ DECIDER CE QU'UN FICHIER LACHE SUR UNE IMAGE DOIT PRODUIRE ══════════════════════════════
//
// La logique de decision vit ici, separee du composant, pour une raison simple : elle se teste sans
// navigateur, alors qu'un glisser-deposer ne se teste qu'a la main. Le composant, lui, se contente
// de mesurer une position et d'appliquer le verdict.
//
// LA REGLE DES BORDS, telle que Notion l'a rendue evidente. Lacher au MILIEU d'une image la
// remplace, ou insere apres, selon les cas ; lacher pres d'un BORD veut dire « mets-la a cote ».
// Le seuil est une fraction de la largeur, pas un nombre de pixels : une image de 300 px et une de
// 900 px doivent offrir la meme zone de bord a l'oeil, donc la meme proportion.

export const SEUIL_BORD = 0.32
export const IMAGE_ROW_TYPE = 'zenrayImageRow'

// x et largeur en pixels, relatifs a la boite de l'image survolee.
export function coteVise(x, largeur, seuil = SEUIL_BORD) {
  if (!largeur || largeur <= 0) return null
  const f = x / largeur
  if (f <= seuil) return 'gauche'
  if (f >= 1 - seuil) return 'droite'
  return null
}

// Rend l'action a executer, ou null si le lacher ne concerne pas ce mecanisme.
//   { action: 'creerRangee', urlExistante, cote }  -> une image simple devient une rangee de deux
//   { action: 'remplacerCote', cote }              -> une rangee existante recoit l'image d'un cote
export function planifierLacher({ typeBloc, propsBloc, x, largeur, seuil = SEUIL_BORD }) {
  const cote = coteVise(x, largeur, seuil)
  if (!cote) return null
  if (typeBloc === 'image') {
    const urlExistante = (propsBloc && propsBloc.url) || ''
    if (!urlExistante) return null
    return { action: 'creerRangee', urlExistante, legendeExistante: (propsBloc && propsBloc.caption) || '', cote }
  }
  if (typeBloc === IMAGE_ROW_TYPE) return { action: 'remplacerCote', cote }
  return null
}

// Construit les props de la rangee. L'image DEPOSEE prend le cote vise, l'existante garde l'autre :
// c'est ce que la main attend, puisqu'on a vise un bord vide et non l'image qu'on survolait.
export function propsRangee({ urlExistante, legendeExistante, urlDeposee, legendeDeposee, cote }) {
  const gaucheEstDeposee = cote === 'gauche'
  return {
    gauche: gaucheEstDeposee ? urlDeposee : urlExistante,
    droite: gaucheEstDeposee ? urlExistante : urlDeposee,
    legendeGauche: gaucheEstDeposee ? (legendeDeposee || '') : (legendeExistante || ''),
    legendeDroite: gaucheEstDeposee ? (legendeExistante || '') : (legendeDeposee || ''),
  }
}

// ═══ ACCOLER DEUX IMAGES DEJA PRESENTES DANS LA PAGE ═════════════════════════════════════════
//
// Le mecanisme du dessus repond au lacher d'un FICHIER venu du disque. Matthieu, le 2026-08-29 :
// « je peux pas mettre 2 images cote a cote dans le markdown ? je parle de gauche droite ». Son cas
// est l'autre, et c'est le plus courant : les deux images sont deja dans le document, empilees, et
// il veut les accoler. Rien ne le permettait.
//
// Trois chemins mENENT desormais au meme resultat, et c'est deliberer : un geste peut echouer ou ne
// pas etre devine, une commande ne rate jamais.
//   1. lacher un fichier sur le bord d'une image  -> `planifierLacher` plus haut
//   2. glisser une image du document sur le bord d'une autre -> `fusionner` ci-dessous
//   3. la commande « Deux images cote a cote » -> `fusionnerAvecVoisine` ci-dessous

export const estImage = (b) => !!b && b.type === 'image' && !!(b.props && b.props.url)

// Rend { rangee, aSupprimer } ou null. `gauche` et `droite` sont deux blocs image du document.
export function fusionner(blocGauche, blocDroite) {
  if (!estImage(blocGauche) || !estImage(blocDroite)) return null
  if (blocGauche.id && blocGauche.id === blocDroite.id) return null
  return {
    rangee: {
      type: IMAGE_ROW_TYPE,
      props: {
        gauche: blocGauche.props.url,
        droite: blocDroite.props.url,
        legendeGauche: blocGauche.props.caption || '',
        legendeDroite: blocDroite.props.caption || '',
      },
    },
    aSupprimer: [blocGauche, blocDroite],
  }
}

// Depuis une image et le document, trouve l'image VOISINE et fusionne. On regarde d'abord APRES,
// parce que « mettre a cote » se lit de gauche a droite ; si rien ne suit, on regarde avant, et
// l'image courante passe alors a droite, ce qui respecte l'ordre de lecture d'origine.
export function fusionnerAvecVoisine(document, idCourant) {
  const blocs = Array.isArray(document) ? document : []
  const i = blocs.findIndex((b) => b && b.id === idCourant)
  if (i < 0 || !estImage(blocs[i])) return null
  const apres = blocs[i + 1]
  if (estImage(apres)) return fusionner(blocs[i], apres)
  const avant = blocs[i - 1]
  if (estImage(avant)) return fusionner(avant, blocs[i])
  return null
}

// ═══ D'OU VIENT CE QU'ON GLISSE ══════════════════════════════════════════════════════════════
//
// ERREUR PAYEE LE 2026-08-29, et elle a coute un aller-retour a Matthieu. Ma premiere version
// testait `types.includes('Files')` avant toute chose, ce qui rejetait tout glisser INTERNE : un
// bloc pris dans le document annonce `blocknote/html`, jamais `Files`. Le mecanisme ne pouvait donc
// pas fonctionner pour deux images deja dans la page, c'est-a-dire pour le seul cas qu'il demandait.
//
// Le symptome le disait pourtant : la barre affichee restait HORIZONTALE, celle de BlockNote qui
// insere avant ou apres, alors que la mienne est verticale et colle a un bord. Une barre qui n'est
// pas la sienne veut dire que son code n'a jamais tourne, pas qu'il a mal calcule.
//
// La condition vit ici desormais, ou elle se teste, plutot que dans le composant ou elle etait
// invisible.

export function sourceDeGlisse(types, blocEnMain) {
  const l = Array.from(types || [])
  if (l.includes('Files')) return 'fichier'
  if (blocEnMain) return 'interne'
  return null
}
