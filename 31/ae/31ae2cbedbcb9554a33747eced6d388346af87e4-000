import { describe, expect, it } from 'vitest'
import { isProxiedPoster, isPublicPosterUrl, parseProxiedPoster, publicPosterUrl, verifyPublicPoster } from './film-poster.mjs'

const RAW = 'https://raw.githubusercontent.com/matthieuhuguet/zenrayshards-vid-b3fed0e1a80f/918b5068d71e093f705b1c729abb8396c4c8d9a4/dc/1a/dc1ad7090584f225a5c5a6839e2f47cbb2cd851552c17ad64732a2fde9ecfe6a.jpg'
const PROXIED = `/api/raw-proxy?u=${encodeURIComponent(RAW)}`
const PUBLIC = 'https://cdn.jsdelivr.net/gh/matthieuhuguet/zenray-poster-public-01@918b5068d71e093f705b1c729abb8396c4c8d9a4/posters/a.jpg'

describe('film poster', () => {
  it('recognises and parses a proxied private poster', () => {
    expect(isProxiedPoster(PROXIED)).toBe(true)
    expect(parseProxiedPoster(PROXIED)).toEqual({
      owner: 'matthieuhuguet', repo: 'zenrayshards-vid-b3fed0e1a80f', commit: '918b5068d71e093f705b1c729abb8396c4c8d9a4',
      path: 'dc/1a/dc1ad7090584f225a5c5a6839e2f47cbb2cd851552c17ad64732a2fde9ecfe6a.jpg',
    })
    expect(parseProxiedPoster(PUBLIC)).toBeNull()
    expect(parseProxiedPoster('/api/raw-proxy?u=https%3A%2F%2Fexample.com%2Fa%2Fb%2Fc%2Fd.jpg')).toBeNull()
  })
  it('accepts only clear jsDelivr posters pinned on a commit', () => {
    expect(isPublicPosterUrl(PUBLIC)).toBe(true)
    expect(isPublicPosterUrl(PROXIED)).toBe(false)
    expect(isPublicPosterUrl(RAW)).toBe(false)
    expect(isPublicPosterUrl('https://cdn.jsdelivr.net/gh/matthieuhuguet/zenray-poster-public-01@main/posters/a.jpg')).toBe(false)
    expect(publicPosterUrl({ owner: 'matthieuhuguet', repo: 'zenray-poster-public-01', commit: '918b5068d71e093f705b1c729abb8396c4c8d9a4', relPath: 'posters/a.jpg' })).toBe(PUBLIC)
  })
  it('verifies the CDN answer is an image, and reports why it is not', async () => {
    const sleep = async () => {}
    const good = async () => ({ ok: true, status: 200, headers: { get: () => 'image/jpeg' } })
    expect(await verifyPublicPoster(PUBLIC, { fetchImpl: good, sleep })).toMatchObject({ ok: true })
    const html = async () => ({ ok: true, status: 200, headers: { get: () => 'text/html' } })
    expect(await verifyPublicPoster(PUBLIC, { fetchImpl: html, sleep })).toMatchObject({ ok: false, reason: 'http_200_text/html' })
    expect(await verifyPublicPoster(PROXIED, { fetchImpl: good, sleep })).toMatchObject({ ok: false, reason: 'not_a_public_jsdelivr_url' })
  })
  it('waits for a freshly pushed poster that jsDelivr first answers with 403 (14 October 2026), but not forever (red control)', async () => {
    const waits = []
    const sleep = async (ms) => { waits.push(ms) }
    let calls = 0
    const lateGood = async () => { calls += 1; return calls <= 8 ? { ok: false, status: 403, headers: { get: () => 'text/plain; charset=utf-8' } } : { ok: true, status: 200, headers: { get: () => 'image/jpeg' } } }
    expect(await verifyPublicPoster(PUBLIC, { fetchImpl: lateGood, sleep })).toMatchObject({ ok: true })
    expect(calls).toBe(9)
    expect(Math.max(...waits)).toBeLessThanOrEqual(30000)
    const always403 = async () => ({ ok: false, status: 403, headers: { get: () => 'text/plain' } })
    const result = await verifyPublicPoster(PUBLIC, { fetchImpl: always403, sleep: async () => {} })
    expect(result).toMatchObject({ ok: false, reason: 'http_403_text/plain' })
  })
})
