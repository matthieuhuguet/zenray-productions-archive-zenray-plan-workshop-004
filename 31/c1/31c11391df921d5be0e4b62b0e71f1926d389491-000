// useT.js — i18n LÉGER, sans dépendance npm. Deux hooks :
//   useLang() -> [lang, setLang] persisté dans localStorage ('zr:lang'), défaut 'fr',
//                détection navigator.language au tout premier lancement (si aucune clé stockée).
//   useT()    -> t(key) qui va chercher "namespace.sous.cle" dans dict[langue courante],
//                repli sur 'fr' si absent dans la langue active, repli sur la clé brute
//                si absente partout (jamais un écran vide).
import { useState, useEffect, useCallback } from 'react'
import { dict } from './dict.js'

const LANG_KEY = 'zr:lang'
const SUPPORTED = ['fr', 'en', 'ja']

function detectLang() {
  try {
    const stored = localStorage.getItem(LANG_KEY)
    if (stored && SUPPORTED.includes(stored)) return stored
  } catch {}
  try {
    const nav = (navigator.language || 'fr').toLowerCase()
    if (nav.startsWith('ja')) return 'ja'
    if (nav.startsWith('en')) return 'en'
  } catch {}
  return 'fr'
}

// petit event bus maison pour synchroniser tous les hooks useLang() montés en même temps
// (ex: LanguageSwitcher dans le header + composants qui affichent du texte) sans passer par
// un Context React — reste dans l'esprit "léger, sans dépendance".
const LANG_EVENT = 'zr:lang-change'

export function useLang() {
  const [lang, setLangState] = useState(detectLang)

  useEffect(() => {
    const onChange = (e) => { if (e && e.detail && e.detail !== lang) setLangState(e.detail) }
    window.addEventListener(LANG_EVENT, onChange)
    return () => window.removeEventListener(LANG_EVENT, onChange)
  }, [lang])

  const setLang = useCallback((next) => {
    if (!SUPPORTED.includes(next)) return
    try { localStorage.setItem(LANG_KEY, next) } catch {}
    setLangState(next)
    window.dispatchEvent(new CustomEvent(LANG_EVENT, { detail: next }))
  }, [])

  return [lang, setLang]
}

function lookup(langDict, key) {
  if (!langDict) return undefined
  const parts = key.split('.')
  let cur = langDict
  for (const p of parts) {
    if (cur == null || typeof cur !== 'object') return undefined
    cur = cur[p]
  }
  return typeof cur === 'string' ? cur : undefined
}

export function useT() {
  const [lang] = useLang()
  const t = useCallback((key) => {
    return lookup(dict[lang], key) ?? lookup(dict.fr, key) ?? key
  }, [lang])
  return t
}

export const SUPPORTED_LANGS = SUPPORTED
