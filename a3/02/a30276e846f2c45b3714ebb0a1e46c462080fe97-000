// 9 October 2026, 11:19 CEST: Keep the project browser usable across bridge versions without reading the full catalogue.
function isUnsupportedAction(error) {
  return /unsupported assets workspace action/i.test(error?.message || '')
}

export async function readLocalWorkspaces(bridge, preferredId, fallbackProjects = []) {
  let catalogue = null
  let projects
  try {
    catalogue = await bridge.catalogue()
    projects = catalogue.projects || []
  } catch (error) {
    if (!isUnsupportedAction(error)) throw error
    projects = Array.isArray(fallbackProjects) ? fallbackProjects : []
  }

  if (catalogue && preferredId && !projects.some((project) => project.id === preferredId)) {
    return { projects, checkedAt: catalogue.checkedAt || null, activeProjectId: null }
  }

  const selected = projects.find((project) => project.id === preferredId) || projects[0] || (preferredId ? { id: preferredId } : null)
  if (!selected) return { projects, checkedAt: catalogue?.checkedAt || null, activeProjectId: null }

  const { project } = await bridge.status(selected.id)
  const hasSelected = projects.some((item) => item.id === project.id)
  return {
    projects: hasSelected ? projects.map((item) => item.id === project.id ? project : item) : [...projects, project],
    checkedAt: project.checkedAt || catalogue?.checkedAt || null,
    activeProjectId: project.id,
  }
}

export async function readProjectConversationIndex(bridge, projectId, workspace) {
  try {
    return await bridge.projectConversations(projectId)
  } catch (error) {
    if (!isUnsupportedAction(error)) throw error
  }

  const project = workspace?.id === projectId && Array.isArray(workspace.files)
    ? workspace
    : (await bridge.status(projectId)).project
  const memorySourceIds = new Set((project.sources || []).filter((source) => source.namespace === 'memory').map((source) => source.id))
  if (!memorySourceIds.size) return { projectId, scannedAt: null, state: 'missing-source', conversations: [] }

  const indexFile = (project.files || []).find((file) => memorySourceIds.has(file.sourceId) && (file.relativePath || file.name || '').replaceAll('\\', '/').split('/').at(-1) === 'ConversationIndex.json')
  if (!indexFile) return { projectId, scannedAt: null, state: 'missing-index', conversations: [] }

  const result = await bridge.request('preview-text', { projectId, fileId: indexFile.id })
  if (result.truncated) throw new Error('ConversationIndex.json dépasse la limite de lecture vérifiée.')

  let index
  try { index = JSON.parse(result.text) }
  catch { throw new Error('ConversationIndex.json ne contient pas un JSON lisible.') }
  if (index.projectId !== projectId || !Array.isArray(index.conversations) || typeof index.scannedAt !== 'string') {
    throw new Error('ConversationIndex.json ne correspond pas à ce projet.')
  }
  return { projectId, scannedAt: index.scannedAt, state: 'ready', conversations: index.conversations }
}
