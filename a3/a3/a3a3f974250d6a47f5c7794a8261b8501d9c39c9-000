// 3 October 2026, 21:45 CEST: byte conservation prevents misleading diagrams and duplicate folder attribution.
import { expect, it } from 'vitest'
import { storageBreakdown, storageChartGroups } from './assetsStorageBreakdown.js'
const files = [
  { id: 'a', namespace: 'houdini', sourceId: 'production', relativePath: 'render/final/a.EXR', name: 'a.EXR', size: 700 },
  { id: 'b', namespace: 'houdini', sourceId: 'production', relativePath: 'render/b.exr', name: 'b.exr', size: 200 },
  { id: 'c', namespace: 'tmp', sourceId: 'workshop', relativePath: 'render/final/c.exr', name: 'c.exr', size: 100 },
  { id: 'd', name: 'README', size: 0 }, { id: 'e', name: 'unknown.png' }, { id: 'f', name: 'invalid.png', size: -1 },
]
it('preserves total bytes across views and keeps same-named folders from different sources separate', () => {
  for (const mode of ['folders', 'types', 'files']) {
    const result = storageBreakdown(files, mode)
    expect(result.bytes).toBe(1000)
    expect(result.unknown).toBe(2)
    expect(result.groups.reduce((sum, group) => sum + group.percent, 0)).toBe(100)
    expect(result.groups.flatMap(group => group.files).map(file => file.id).sort()).toEqual(['a','b','c','d','e','f'])
  }
  expect(storageBreakdown(files).groups.filter(group => group.label === 'render/final')).toHaveLength(2)
  expect(storageBreakdown(files, 'types').groups[0].label).toBe('.exr')
})
it('keeps the remainder measurable and explorable, including an empty or entirely unknown inventory', () => {
  const groups = storageBreakdown(Array.from({ length: 20 }, (_, index) => ({ id: String(index), name: `${index}.png`, relativePath: `dir${index}/a.png`, size: index }))).groups
  const chart = storageChartGroups(groups)
  expect(chart).toHaveLength(6)
  expect(chart.reduce((sum, group) => sum + group.bytes, 0)).toBe(190)
  expect(chart.flatMap(group => group.files)).toHaveLength(20)
  expect(storageBreakdown([{}]).groups[0].percent).toBe(0)
  expect(storageBreakdown([]).groups).toEqual([])
})
