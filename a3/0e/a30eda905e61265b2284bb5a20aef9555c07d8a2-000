    border:1px dashed #d5d5cf;border-radius:8px;margin:0 0 4px}
  .tag{font-size:10px;text-transform:uppercase;letter-spacing:.12em;color:#999;flex:0 0 58px}
  /* LA règle qui fait tout marcher : capture et candidates à hauteur d'encre identique. */
  .capture img,.cand img{height:38px;width:auto;image-rendering:auto}
  .cands{display:flex;flex-direction:column}
  .cand{display:flex;align-items:center;gap:14px;padding:9px 16px;border-bottom:1px solid #f2f2ee}
  .cand:hover{background:#f2f8f2}
  .num{flex:0 0 58px;color:#bbb;font-variant-numeric:tabular-nums;font-size:13px;text-align:left}
  .cand:first-child .num{color:#1a7f37;font-weight:700}
