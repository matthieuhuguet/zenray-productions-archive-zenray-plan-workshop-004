}

async function main() {
  const argv = process.argv.slice(2)
  const arg = (name, def = null) => {
    const i = argv.indexOf(`--${name}`)
    return i >= 0 && argv[i + 1] && !argv[i + 1].startsWith('--') ? argv[i + 1] : def
  }
  const has = (name) => argv.includes(`--${name}`)

  // Plusieurs --probe acceptés : un rapport unique, une section par sonde, dans l'ordre donné.
  // Comparer cinq quotidiens dans cinq fichiers séparés ne permet pas de VOIR ce qui les
  // distingue ; côte à côte, la doctrine typographique de chacun saute aux yeux.
  const probePaths = argv.reduce((acc, a, i) => (a === '--probe' && argv[i + 1] && !argv[i + 1].startsWith('--') ? [...acc, argv[i + 1]] : acc), [])
  const probePath = probePaths[0] || null
  const outPath = arg('out')
  const top = Number(arg('top', 10))
  const weights = (arg('weights') || '').split(',').filter(Boolean)
  const families = (arg('families') || '').split(',').filter(Boolean)

  let probes = []
  let outDir = null
  if (probePath) {
    outDir = path.dirname(probePath)
    for (const file of probePaths) {
      const spec = JSON.parse(await readFile(file, 'utf8'))
      const dir = path.dirname(file)
      for (const p of spec.probes) {
        probes.push({
          ...p,
          // Le rôle est préfixé du thème dès qu'on en compare plusieurs : sans ça, cinq sondes
          // « titre-une » deviennent indiscernables dans le rapport combiné.
          role: probePaths.length > 1 ? `${spec.calibrationMedia || spec.theme} · ${p.role}` : p.role,
          imagePath: path.resolve(dir, p.image),
          rect: p.rect || null,
        })
      }
    }
  } else {
    const image = argv.find((a) => !a.startsWith('--') && /\.(jpe?g|png)$/i.test(a))
    if (!image) throw new Error('usage : node scripts/zrm-detect-font.mjs <image> --text "..." [--rect x,y,w,h]')
    probes = [{
      role: arg('role', 'échantillon'),
      text: arg('text') || 'Hamburgefonstiv',
      imagePath: path.resolve(image),
      rect: arg('rect') ? arg('rect').split(',').map(Number) : null,
      invert: has('invert'),
      letterSpacing: arg('letter-spacing') || '',
    }]
  }

  const faces = await loadFaceBuffers(candidateFaces({ weights, families }))
  console.log(`Polices candidates : ${faces.length} faces (${new Set(faces.map((f) => f.family)).size} familles)\n`)

  const browser = await chromium.launch()
  const page = await browser.newPage()
  await page.setContent('<!doctype html><meta charset="utf-8"><body></body>')
  await page.addScriptTag({ content: PAGE_CODE })

  const done = []
  for (const probe of probes) {
    process.stdout.write(`▸ ${probe.role} — « ${probe.text} »\n`)
    const { ref, results, verdict, calibration } = await detect(page, probe, faces)
    console.log(`  capture : chasse ${ref.aspect.toFixed(3)}  densite ${ref.density.toFixed(3)}  hauteur d'encre ${ref.inkHeight}px`)
    for (const [i, r] of results.slice(0, top).entries()) {
      const mark = i === 0 ? '★' : ' '
      console.log(`  ${mark} ${String(i + 1).padStart(2)}. ${r.family.padEnd(24)} ${r.weight}  score ${fmt(r.total)}  chasse ${fmt(r.ratio)}  graisse ${fmt(r.weightMatch)}  superp ${fmt(r.overlap)}  lignes ${fmt(r.rows)}`)
    }
    if (verdict) {
      console.log(verdict.invalid
        ? `  → SONDE INVALIDE : ${verdict.reason}`
        : verdict.decisive
        ? `  → IDENTIFIÉE : ${verdict.family} ${verdict.weight} (${verdict.archetype}), ${(verdict.margin * 100).toFixed(1)} pts devant ${verdict.rival}`
        : `  → CARACTÉRISÉE seulement : ${verdict.dominantArchetype} (${Math.round(verdict.dominantShare * 100)} % du top 5). `
          + `${verdict.family} ${verdict.weight} n'a que ${(verdict.margin * 100).toFixed(1)} pts sur ${verdict.rival} — écart non concluant.`)
    }
    if (calibration) {
      if (!calibration.installed) {
        console.log(`  ⚑ POLICE CONNUE : ${calibration.family} (${calibration.source}) — PAS INSTALLÉE. `
          + `L'ajouter à scripts/zrm-fonts.mjs, sinon le thème la déclarera sans pouvoir la rendre.`)
      } else {
        console.log(`  ⚑ POLICE CONNUE : ${calibration.family}${calibration.weight ? ' ' + calibration.weight : ''} `
          + `(${calibration.source}) — fait autorité. La mesure la classe ${calibration.rank ? `n°${calibration.rank}` : `n°${calibration.rankAnyWeight} (autre graisse)`}`
          + `${calibration.agrees ? ' : la mesure est d\'accord.' : ' : la mesure ne la met pas en tête.'}`)
      }
    }
    console.log('')
    done.push({ ...probe, ref, results, verdict, calibration })
  }
  await browser.close()

  if (outDir) {
    const json = done.map((p) => ({
      role: p.role,
      text: p.text,
      image: path.basename(p.imagePath),
      refAspect: p.ref.aspect,
      refDensity: p.ref.density,
      refInkHeight: p.ref.inkHeight,
      warning: p.ref.warning || null,
      verdict: p.verdict,
      calibration: p.calibration,
      ranking: p.results.slice(0, 12).map((r) => ({
        family: r.family, weight: r.weight, total: r.total, ratio: r.ratio, weightMatch: r.weightMatch, overlap: r.overlap, rows: r.rows,
      })),
    }))
    const htmlOut = outPath || path.join(outDir, 'font-report.html')
    const jsonOut = htmlOut.replace(/\.html$/, '.json')
    await mkdir(path.dirname(htmlOut), { recursive: true })
    // On propage le média de calibrage : c'est lui qui identifie la source du relevé, et
    // zrm-new-theme le reprend dans le champ privé `calibration.ref` du thème.
    const media = probePaths.length === 1
      ? JSON.parse(await readFile(probePaths[0], 'utf8')).calibrationMedia || null
      : null
    await writeFile(jsonOut, JSON.stringify({ calibrationMedia: media, probes: json }, null, 2))
    await writeFile(htmlOut, reportHtml(done))
    const benchOut = htmlOut.replace(/\.html$/, '-atelier.html')
    await writeFile(benchOut, workbenchHtml(done))
    console.log(`Rapport  : ${htmlOut}`)
    console.log(`Atelier  : ${benchOut}`)

    // Proposition prête à coller dans theme.json : le script ne modifie pas le thème lui-même,
    // parce qu'un classement à 2 % d'écart mérite un oeil humain sur la planche côte-à-côte.
    const proposal = {}
    for (const p of done) {
      if (p.calibration && p.calibration.installed) {
        proposal[p.role] = `${p.calibration.family}${p.calibration.weight ? ' ' + p.calibration.weight : ''}  (connue — ${p.calibration.source})`
        continue
      }
      proposal[p.role] = p.verdict.invalid
        ? `SONDE INVALIDE — à refaire`
        : p.verdict.decisive
        ? `${p.verdict.family} ${p.verdict.weight}`
        : `${p.verdict.family} ${p.verdict.weight}  (non décisif — ${p.verdict.dominantArchetype})`
    }
    console.log('\nProposition :')
    console.log(JSON.stringify(proposal, null, 2))
  }
}

main().catch((e) => { console.error(e); process.exit(1) })
