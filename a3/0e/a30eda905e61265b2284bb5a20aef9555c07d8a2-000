  .nom b{color:#999;font-weight:500}
  .sc{flex:0 0 34px;text-align:right;color:#c0c0bb;font-size:12px;font-variant-numeric:tabular-nums}
  .answer{margin-top:12px;padding-top:12px;border-top:1px solid #f0f0ec;font-size:12px;color:#888}
