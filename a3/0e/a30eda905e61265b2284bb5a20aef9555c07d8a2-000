// ---------------------------------------------------------------------------------------------
// L'ATELIER DE CALIBRAGE.
//
// Le rapport de détection sert à comprendre POURQUOI une police l'emporte. L'atelier sert à
// autre chose : à ce que Matthieu tranche en dix secondes.
//
// La différence tient à une seule idée. Comparer une capture à une police est instantané SI les
// deux montrent le même mot, à la même hauteur de lettre, alignés à gauche, empilés
// verticalement. L'oeil descend la colonne et s'arrête. Dès qu'une de ces conditions manque —
// tailles différentes, mots différents, disposition en tableau — la comparaison redevient un
// travail, et un travail qu'on n'a aucune raison de lui demander.
//
// D'où : la capture en haut, figée, et les huit meilleures candidates dessous, toutes au même
// gabarit. Il répond par un numéro. S'il ne reconnaît rien, il a le chemin du crop sous la main
// pour le passer dans son outil externe — et ce chemin est affiché, sélectionnable.
// ---------------------------------------------------------------------------------------------
function workbenchHtml(probes, topN = 8) {
  const sections = probes.map((p, pi) => {
    const rows = p.results.slice(0, topN).map((r, i) => `
      <label class="cand">
        <span class="num">${i + 1}</span>
        <img src="${r.clean}" alt="">
        <span class="nom">${r.family} <b>${r.weight}</b></span>
        <span class="sc">${(r.total * 100).toFixed(0)}</span>
      </label>`).join('')
    return `
    <section class="probe">
      <h2><span class="idx">${pi + 1}</span>${p.role}</h2>
      <div class="capture">
        <span class="tag">capture</span>
        <img src="${p.ref.cropTight || p.ref.crop}" alt="">
      </div>
      <div class="cands">${rows}</div>
      <div class="answer">
        <span class="none">Aucune ne correspond ?</span>
        <code>${p.imagePath}</code>
        <span class="hint">rect ${(p.rect || []).join(',')} — le PNG découpé est dans <code>probes/${String(p.role).split('·').pop().trim()}.png</code></span>
      </div>
    </section>`
  }).join('')
  return `<!doctype html><meta charset="utf-8"><title>ZenRayMedia — atelier de calibrage des polices</title>
<style>
  :root{color-scheme:light}
  body{margin:0;padding:28px 32px 64px;background:#f6f6f4;color:#111;
