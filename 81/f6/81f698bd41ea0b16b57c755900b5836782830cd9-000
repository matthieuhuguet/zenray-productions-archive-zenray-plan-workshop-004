// cmaf-stage.mjs (14 October 2026): a packaged CMAF set kept on disk, ready to be pushed later (decision of Matthieu, 14 October 2026:
// "continue to prepare the CMAF" while the pushes are stopped). The packaging pass (ffmpeg, local, no network) and the publish step (push to
// the public shard, manifest attach) are separated by this directory: <stageRoot>/<key>/{files/, poster.jpg, stage.json}.
// FR : un jeu CMAF empaquete, garde sur disque en attendant le push. L'empaquetage (local) et la publication (reseau) sont separes.
//
// A stage is valid only if it is complete, the source has not changed (size and mtime) and every segment is on disk with the recorded
// total. An invalid stage is ignored (the film is packaged again), never trusted.
import fs from 'node:fs'
import path from 'node:path'

export const STAGE_FILE = 'stage.json'
export const STAGE_POSTER = 'poster.jpg'
export const STAGE_FILES = 'files'

export function stagePaths(stageDir) {
  return { dir: stageDir, filesDir: path.join(stageDir, STAGE_FILES), posterFile: path.join(stageDir, STAGE_POSTER), recordFile: path.join(stageDir, STAGE_FILE) }
}

/** The staged package of this film, or null if there is none or it cannot be trusted. / Le paquet reserve, ou null. */
export function readStage(stageDir, sourcePath) {
  const paths = stagePaths(stageDir)
  let record
  try { record = JSON.parse(fs.readFileSync(paths.recordFile, 'utf8')) } catch { return null }
  const packaged = record && record.packaged
  if (!record || record.complete !== true || !packaged || packaged.ok !== true || !Array.isArray(packaged.names) || !packaged.names.length) return null
  let source
  try { source = fs.statSync(sourcePath) } catch { return null }
  if (record.source?.size !== source.size || Math.abs(Number(record.source?.mtimeMs) - source.mtimeMs) > 1) return null
  let total = 0
  for (const name of packaged.names) {
    try { total += fs.statSync(path.join(paths.filesDir, name)).size } catch { return null }
  }
  if (total !== packaged.totalBytes) return null
  for (const name of ['master.m3u8', 'manifest.mpd']) if (!fs.existsSync(path.join(paths.filesDir, name))) return null
  if (!fs.existsSync(paths.posterFile)) return null
  return { ...paths, packaged, record }
}

/** Move a packaging work directory and its poster into the stage (same disk: a rename, no copy). / Range le paquet dans la reserve. */
export function writeStage({ stageDir, workDir, posterFile, sourcePath, packaged }) {
  const paths = stagePaths(stageDir)
  fs.rmSync(stageDir, { recursive: true, force: true })
  fs.mkdirSync(stageDir, { recursive: true })
  fs.renameSync(workDir, paths.filesDir)
  fs.renameSync(posterFile, paths.posterFile)
  const source = fs.statSync(sourcePath)
  const record = {
    complete: true,
    createdAt: new Date().toISOString(),
    source: { path: sourcePath, size: source.size, mtimeMs: source.mtimeMs },
    packaged: JSON.parse(JSON.stringify(packaged)),
  }
  const temp = `${paths.recordFile}.tmp`
  fs.writeFileSync(temp, JSON.stringify(record, null, 2))
  fs.renameSync(temp, paths.recordFile)
  return { ...paths, packaged: record.packaged, record }
}

export function removeStage(stageDir) {
  fs.rmSync(stageDir, { recursive: true, force: true })
}
