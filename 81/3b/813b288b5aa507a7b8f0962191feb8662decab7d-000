export const FONTS_BY_FAMILY = Object.fromEntries(FONTS.map((f) => [f.family, f]))

/** Familles d'un archétype typographique (labeur · grotesque · condense · didone · mono · cjk). */
export function fontsOfArchetype(archetype) {
  return FONTS.filter((f) => f.archetype === archetype)
}

const FALLBACKS = {
  labeur: 'Georgia, "Times New Roman", serif',
  didone: 'Didot, "Bodoni MT", Georgia, serif',
  grotesque: 'system-ui, -apple-system, sans-serif',
  condense: '"Arial Narrow", "Helvetica Neue Condensed", system-ui, sans-serif',
  mono: 'ui-monospace, SFMono-Regular, monospace',
  cjk: '"Hiragino Mincho ProN", "Yu Mincho", "Noto Serif CJK JP", serif',
}

// Archétype d'une famille CONNUE mais non installée (les japonaises sont hors du défaut).
// Sans cette table, fontStack('Noto Serif JP') retombait sur sans-serif : un texte japonais
// se serait affiché en police latine générique au lieu d'un mincho système. Bug évité 2026-07-25.
// (Aucun accent grave dans ce commentaire : il vit DANS un gabarit de chaîne, un backtick y
//  terminerait le gabarit et casserait le générateur -- erreur payée le 2026-07-25.)
const KNOWN_ARCHETYPES = { 'Noto Serif JP': 'cjk', 'Noto Sans JP': 'cjk' }

/** Pile CSS d'une famille, avec ses replis. Rend la famille utilisable même non installée. */
export function fontStack(family) {
  const archetype = FONTS_BY_FAMILY[family]?.archetype || KNOWN_ARCHETYPES[family]
  const fallback = FALLBACKS[archetype] || 'system-ui, sans-serif'
  return `'${family}', ${fallback}`
}

/** Familles connues du catalogue mais absentes du disque (installables par --cjk). */
export function missingFamilies(families) {
  return (families || []).filter((f) => !FONTS_BY_FAMILY[f])
}

/** Les @font-face d'une liste de familles, pour l'aperçu (fichiers servis depuis /zrm-fonts/). */
export function fontFaceCss(families) {
  const wanted = (families || []).map((f) => FONTS_BY_FAMILY[f]).filter(Boolean)
  return wanted.flatMap((entry) => entry.faces.map((face) =>
    `@font-face{font-family:'${entry.family}';font-style:${face.style};font-weight:${face.weight};font-display:block;src:url('${face.file}') format('woff2');${face.unicodeRange ? `unicode-range:${face.unicodeRange};` : ''}}`
  )).join('\n')
}

// ═══ CE QU'UN EXPORT EMBARQUE RÉELLEMENT (2026-08-04) ═════════════════════════════════════════
//
// L'export embarquait TOUTES les coupes d'une famille : neuf graisses, deux styles, deux
// sous-ensembles, soit trente-six fichiers pour Merriweather seul. D'où les 3,8 Mo que le Critique
// signalait, et il avait raison de le signaler.
//
// Or une maquette de presse emploie deux graisses, le romain et le gras, plus l'italique du romain
// pour les citations. Les six autres graisses partent dans le fichier sans jamais être appelées.
// La politique ci-dessous est donc une VRAIE réduction et non un seuil relevé : on n'embarque que
// ce qui sert, et le chiffre du Critique mesure exactement ce que l'export produit.
//
// Les sous-ensembles latin et latin-ext restent tous les deux : les retirer casserait
// l'accentuation, et une page française sans accents n'est pas une page allégée, c'est une page
// fausse.
const GRAISSES_UTILES = new Set(['400', '700'])
const SOUS_ENSEMBLES_UTILES = new Set(['latin', 'latin-ext'])

/** Les coupes qu'un export embarque réellement pour une famille. */
export function essentialFaces(family) {
  const entry = FONTS_BY_FAMILY[family]
  if (!entry) return []
  const gardees = entry.faces.filter((face) =>
    GRAISSES_UTILES.has(String(face.weight)) && SOUS_ENSEMBLES_UTILES.has(face.subset))
  // Une famille dont aucune coupe ne correspond garde ses coupes d'origine : mieux vaut une page
  // lourde qu'une page sans police.
  return gardees.length ? gardees : entry.faces
}

/** Poids total d'un jeu de familles, MESURÉ sur ce que l'export embarque vraiment. */
export function fontsWeight(families) {
  return (families || []).reduce((total, family) => {
    const entry = FONTS_BY_FAMILY[family]
    if (!entry) return total
    const gardees = essentialFaces(family)
    // Le poids par coupe n'est pas connu fichier par fichier : on le répartit au prorata, ce qui
    // est une approximation ASSUMÉE et non une mesure. Elle suffit pour un avertissement.
    return total + Math.round((entry.bytes || 0) * (gardees.length / (entry.faces.length || 1)))
  }, 0)
}
