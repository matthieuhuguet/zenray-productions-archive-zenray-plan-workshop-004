// 23 October 2026: the gate between a model's output and the knowledge base. An answer without a proof copied word for word
// from its source is thrown away: this is what makes "never invented" a property of the code, not a promise.
// FR : la porte entre la sortie d'un modèle et la base. Une réponse sans preuve copiée mot pour mot de sa source est jetée.
import { isSecretLine } from './Sources.mjs'

/** Compare texts the way a copy survives: same words, whitespace and quote styles ignored. */
export const flat = (text) => String(text || '').replace(/[‘’ʼ`]/g, "'").replace(/[“”«»]/g, '"').replace(/[  ]/g, ' ').replace(/[*_]{1,3}/g, '').replace(/\s+/g, ' ').trim().toLowerCase()

export function checkEntry(raw, sourceText, config) {
  const rules = config.extract
  if (!raw || typeof raw !== 'object') return { ok: false, reason: 'not-an-object' }
  // Long dashes are banned in Matthieu's texts: replaced by a comma rather than losing the entry.
  const undash = (t) => String(t || '').replace(/\s*[—–]\s*/g, ', ')
  // French spacing before the question mark. FR : espace avant le point d'interrogation.
  const q = undash(raw.q).replace(/\s+/g, ' ').trim().replace(/\s*\?$/, ' ?')
  const a = (Array.isArray(raw.a) ? raw.a : [raw.a]).map((p) => undash(p).trim()).filter(Boolean)
  const proof = String(raw.proof || '').trim()
  if (q.length < 6 || !q.endsWith('?')) return { ok: false, reason: 'question' }
  if (!a.length || a.length > rules.maxParagraphs || a.join('').length > rules.maxAnswerChars) return { ok: false, reason: 'answer-shape' }
  if (proof.length < rules.minProofChars) return { ok: false, reason: 'proof-short' }
  if (!flat(sourceText).includes(flat(proof))) return { ok: false, reason: 'proof-not-in-source' }
  if ([q, ...a, proof].some(isSecretLine)) return { ok: false, reason: 'secret' }
  const domain = config.domains.includes(raw.d) ? raw.d : 'Autre'
  const kw = [...new Set((Array.isArray(raw.kw) ? raw.kw : []).map((k) => String(k).toLowerCase().trim()).filter(Boolean))].slice(0, 8)
  // A date only counts when it is written in the source itself. FR : une date ne compte que si elle est écrite dans la source.
  const date = raw.date && flat(sourceText).includes(flat(raw.date)) ? String(raw.date) : null
  return { ok: true, entry: { q, a, d: domain, kw, proof, date } }
}
