// ═══ LES ESPACES DE TRI `tmp-img-selectionN` ════════════════════════════════════════════════════
//
// LE BESOIN, dans les mots de Matthieu (2026-08-30) : « trier rapidement plusieurs espaces d'images
// sans perdre l'image originale et son espace initial — il n'y a que des références qui sont
// déplacées ». Un espace de tri n'est donc pas une copie : c'est un dossier qui ne contient que des
// LIENS vers des images qui restent chez elles.
//
// POURQUOI CE MODULE EXISTE SÉPARÉMENT. La numérotation paraît triviale et ne l'est pas : elle doit
// tenir devant un dossier vide, devant des numéros à trous (1, 3, 7), devant un nom qui ressemble
// sans en être un (`tmp-img-selection` nu, `tmp-img-selection01`, `tmp-img-selectionX`), et devant
// deux clics rapprochés qui viseraient le même numéro. Une fonction pure se teste sur ces cas en
// une seconde ; la même logique noyée dans un composant ne se teste jamais.
//
// LA RÈGLE D'AFFICHAGE, telle qu'il l'a demandée : on montre les espaces qui EXISTENT DÉJÀ, plus le
// PROCHAIN LIBRE. Un dossier vierge n'offre donc que `tmp-img-selection1` ; dès que celui-ci existe,
// `tmp-img-selection2` apparaît à côté. C'est ce qui permet de trier en plusieurs tas sans jamais
// avoir à créer un dossier à la main.

// Le préfixe est un PARAMÈTRE, pas un littéral répété : le changer une fois le change partout, et
// un autre type de tri (vidéos, documents) réutilisera cette définition au lieu de la recopier.
export const PREFIXE_TRI = 'tmp-img-selection'

// Reconnaît un espace de tri et rend son numéro, ou `null`. Strict par construction : seul un
// entier positif SANS zéro de tête compte, sinon `tmp-img-selection01` et `tmp-img-selection1`
// désigneraient le même tas en portant deux noms, et le tri se disperserait sans qu'on le voie.
export function numeroDeTri(nom, prefixe = PREFIXE_TRI) {
  const s = String(nom || '')
  if (!s.startsWith(prefixe)) return null
  const reste = s.slice(prefixe.length)
  if (!/^[1-9]\d*$/.test(reste)) return null
  return Number(reste)
}

// Rend les espaces à PROPOSER pour un dossier donné : ceux qui existent, triés, puis le prochain
// libre marqué `neuf`. `entrees` est la liste des enfants du dossier courant, telle que la vue la
// possède déjà — aucune requête réseau n'est faite ici, c'est une fonction pure.
//
// `prochain` est le plus petit entier strictement supérieur au plus grand numéro existant, et non
// le premier trou. Réutiliser un trou ferait réapparaître un tas supprimé sous son ancien nom, ce
// qui trompe : on avance toujours, comme un compteur.
export function espacesDeTri(entrees, dossierCourant, prefixe = PREFIXE_TRI) {
  const dossiers = (entrees || []).filter((e) => e && (e.hasKids || e.type === 'dir' || e.isDir))
  const numeros = []
  for (const e of dossiers) {
    const n = numeroDeTri(e.name || (e.dir || '').split('/').pop(), prefixe)
    if (n != null) numeros.push(n)
  }
  numeros.sort((a, b) => a - b)

  const base = String(dossierCourant || '').replace(/\/$/, '')
  const existants = numeros.map((n) => ({
    n,
    nom: `${prefixe}${n}`,
    chemin: `${base}/${prefixe}${n}`,
    neuf: false,
  }))
  const suivant = numeros.length ? numeros[numeros.length - 1] + 1 : 1
  existants.push({
    n: suivant,
    nom: `${prefixe}${suivant}`,
    chemin: `${base}/${prefixe}${suivant}`,
    neuf: true,
  })
  return existants
}

// L'espace visé par le geste PAR DÉFAUT, celui du clic direct sans ouvrir le menu : le dernier
// espace EXISTANT s'il y en a un, sinon le neuf. C'est le comportement attendu quand on trie en
// rafale — on continue de remplir le tas courant plutôt que d'en ouvrir un à chaque clic.
export function espaceParDefaut(espaces) {
  if (!espaces || !espaces.length) return null
  const existants = espaces.filter((e) => !e.neuf)
  return existants.length ? existants[existants.length - 1] : espaces[espaces.length - 1]
}


// ═══ CE QUI PEUT ÊTRE TRIÉ, EN UN SEUL ENDROIT ══════════════════════════════════════════════════
//
// « Tout type confondu », demande de Matthieu le 2026-08-30 : une photo, une vidéo, un son, une
// archive, un board, une vidéo intégrée, une table, et un DOSSIER entier. Le lien Eagle ne
// distingue pas : il porte un `resourceId`, et un identifiant ne connaît pas le type de ce qu'il
// désigne.
//
// CE MOTIF EST LA MÊME VÉRITÉ QUE CELLE DE `createEagleLinks`, et c'est tout l'intérêt de l'écrire
// ici : deux filtres qui doivent s'accorder et vivent à deux endroits finissent toujours par
// diverger, et la divergence se voit le jour où un type accepté par l'un est refusé par l'autre,
// sans qu'aucune erreur ne le dise. Le menu contextuel et le Quick Look interrogent donc cette
// fonction, jamais leur propre expression régulière.
export const TYPES_TRIABLES = /\.(img|media|file|canvas|embed|db)\.json$/

// Vrai si cette entrée de Create peut recevoir une référence dans un espace de tri. Les dossiers
// comptent : `createEagleLinks` sait poser un lien de dossier entier (`.zreagle-folder.json`).
export function estTriable(entree) {
  if (!entree) return false
  if (entree.hasKids) return true
  return !!(entree.contentPath && TYPES_TRIABLES.test(entree.contentPath))
}

// Filtre une sélection. Rendue séparément parce que l'appelant a besoin du COMPTE pour son
// étiquette (« Trier vers… (12) ») avant de savoir s'il affiche quoi que ce soit.
export function triables(entrees) {
  return (entrees || []).filter(estTriable)
}
