// 2 October 2026, 13:28 CEST: legacy archives and live sources share one project identity without losing files.
import { mergeAssetsProjects, projectPaths, coverPath, compareProjectsByDateDesc } from './assetsProjects.js'
import { typeOfPath, stripLeafExt, legacyFlags } from '../create/node.js'
import { kindForName } from './fileKinds.js'
import { LEGACY_WORKSPACE_REGISTRY_PATH, WORKSPACE_CATALOGUE_PATH } from './assetsWorkspaceCatalogue.js'
import { assertWorkspaceId } from './projectWorkspace.js'

export const ASSETS_WORKSPACE_PATHS = { legacy: 'pages/.zr-assets.json', registry: LEGACY_WORKSPACE_REGISTRY_PATH, index: WORKSPACE_CATALOGUE_PATH }

// 9 October 2026, 10:21 CEST: The selected live snapshot bypasses the raw CDN's five-minute cache.
export function workspaceSnapshotRequest(folder) {
  const match = /^pages\/ZenRayAssets\/([^/]+)$/.exec(folder || '')
  if (!match) throw new Error('Workspace snapshot folder is invalid')
  assertWorkspaceId(match[1])
  return { path: `${folder}/.workspace.json`, fresh: true }
}

export function cloudWorkspaceFiles(project, paths, getSize = () => undefined) {
  const own = projectPaths(project.folder, paths).filter((path) => !/\/(?:\.[^/]+|[^/]*\.(?:m3u8|mpd))$/.test(path))
  return own.map((contentPath) => {
    const type = typeOfPath(contentPath)
    const relativePath = stripLeafExt(contentPath.slice(project.folder.length + 1))
    const name = relativePath.split('/').pop()
    return { id: contentPath, name, relativePath, contentPath, cloudPath: contentPath, type,
      ...legacyFlags(type), dir: stripLeafExt(contentPath), hasKids: false, kind: kindForName(name),
      size: getSize(contentPath) ?? undefined, status: 'cloud-only', namespace: 'cloud' }
  })
}

export function mergeWorkspaceProjects(legacy, workspaces, paths = [], getSize) {
  const oldProjects = mergeAssetsProjects(legacy)
  const claimed = new Set(workspaces.flatMap((project) => project.legacyProjectIds || []))
  const unclaimed = oldProjects.filter((project) => !claimed.has(project.id))
  const byId = new Map(unclaimed.map((project) => [project.id, { ...project, files: cloudWorkspaceFiles(project, paths, getSize) }]))
  for (const workspace of workspaces) {
    const prior = byId.get(workspace.id)
    const linked = oldProjects.filter((project) => (workspace.legacyProjectIds || []).includes(project.id))
    const archived = [workspace, ...(prior && prior.folder !== workspace.folder ? [prior] : []), ...linked].flatMap((project) => cloudWorkspaceFiles(project, paths, getSize))
    const files = [...(workspace.files || [])]
    const seen = new Set(files.map((file) => file.contentPath).filter(Boolean))
    for (const file of archived) if (!seen.has(file.contentPath)) { files.push(file); seen.add(file.contentPath) }
    byId.set(workspace.id, { ...prior, ...workspace, files, legacyCollections: linked.map(({ id, name }) => ({ id, name })) })
  }
  return [...byId.values()].map((project) => {
    const cover = coverPath(project, project.files.map((file) => file.contentPath).filter(Boolean))
    return { ...project, coverFile: project.files.find((file) => file.contentPath === cover) || project.files.find((file) => file.kind === 'image' && file.contentPath) }
  }).sort(compareProjectsByDateDesc)
}

export function previewWorkspaceFile(file) {
  if (!file.contentPath) return null
  const type = typeOfPath(file.contentPath)
  return { ...file, type, ...legacyFlags(type), dir: stripLeafExt(file.contentPath), hasKids: false }
}

export function workspaceSelection(files) {
  if (!files.length) return null
  if (files.some((file) => !file.sourceId || !file.id)) throw new Error('Reliez cette archive au projet avant de la charger ou de la sauvegarder.')
  return files.map((file) => file.id)
}

export function workspaceSlug(name) {
  return name.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
}
