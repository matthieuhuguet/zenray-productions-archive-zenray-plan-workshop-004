import React from 'react'
import { afterEach, beforeEach, expect, test, vi } from 'vitest'
import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
import PlanBoard from './PlanBoard.jsx'
import { saveJsonWithRetry } from '../lib/saveJson.js'
import { captureAttachment } from '../capture/universalCapture.js'
import { linkCreateAttachment } from './linkCreateAttachment.js'

const moviePath = 'pages/Anime_Movies_Series_Documentaries/Movies/Kamikaze Girls (2004).mkv.media.json'
vi.mock('../capture/universalCapture.js', () => ({ captureAttachment: vi.fn() }))
vi.mock('./linkCreateAttachment.js', () => ({ linkCreateAttachment: vi.fn() }))
vi.mock('../lib/shareLinks.js', () => ({ issueShareToken: vi.fn(async () => ({ token: 'file-token' })), revokeShareToken: vi.fn() }))
vi.mock('../search/searchIndexClient.js', () => ({ loadSearchIndex: vi.fn(async () => {}), getIndexPaths: () => ['pages/Anime_Movies_Series_Documentaries/Movies/Kamikaze Girls (2004).mkv.media.json'], getNodeThumb: () => null }))
vi.mock('../lib/saveJson.js', () => ({ saveJsonWithRetry: vi.fn() }))
vi.mock('./planCache.js', () => ({ PLAN_REFRESH_MS: 30000, readCachedPlan: () => ({ type: 'plan', tasks: [] }), writeCachedPlan: vi.fn(), shouldAdoptPlan: () => false, readPlanState: vi.fn(async () => ({ status: 'ok', board: { type: 'plan', tasks: [] } })) }))

beforeEach(() => {
  window.matchMedia = () => ({ matches: false, addEventListener() {}, removeEventListener() {} })
  global.IntersectionObserver = class { observe() {} disconnect() {} }
  Element.prototype.scrollTo = vi.fn()
  Element.prototype.scrollIntoView = vi.fn()
  let board = { type: 'plan', tasks: [] }
  saveJsonWithRetry.mockImplementation(async (_path, mutate) => { board = mutate(board); return { ok: true, data: board } })
})
afterEach(() => { cleanup(); vi.clearAllMocks() })

// Exercise the actual creation form in the user's screenshot. (19 October 2026, 01:10 Paris)
test('new task composer links an existing Create film and persists it on Add', async () => {
  const attachment = { name: 'Kamikaze Girls (2004).mkv', path: moviePath, mode: 'view', url: 'https://site.test/watch?v=signed', token: 'signed' }
  linkCreateAttachment.mockResolvedValue(attachment)
  render(<PlanBoard t={{ textPrimary: '#111' }} path="pages/test.plan.json" />)
  fireEvent.click(screen.getByRole('button', { name: 'New goal' }))
  expect(screen.getByLabelText('Drop files or Create items here')).toBeInTheDocument()
  fireEvent.change(screen.getByPlaceholderText('Plan…'), { target: { value: 'Watch Kamikaze Girls' } })
  fireEvent.click(screen.getByRole('button', { name: 'From Create' }))
  fireEvent.change(screen.getByLabelText('Search Create files'), { target: { value: 'Kamikaze Girls' } })
  fireEvent.click(await screen.findByRole('button', { name: 'Kamikaze Girls (2004).mkv' }))
  await screen.findByRole('link', { name: /Kamikaze Girls.*Shared view/ })
  await waitFor(() => expect(screen.getByRole('button', { name: 'Add', exact: true })).toBeEnabled())
  fireEvent.click(screen.getByRole('button', { name: 'Add', exact: true }))
  await waitFor(() => expect(saveJsonWithRetry).toHaveBeenCalled())
  const saved = saveJsonWithRetry.mock.results[0].value
  expect((await saved).data.tasks[0].attachments).toEqual([attachment])
  expect(captureAttachment).not.toHaveBeenCalled()
})
test('a local file dropped into the creation form is retained when the task is created', async () => {
  captureAttachment.mockResolvedValue({ nodePath: 'pages/PlanAttachments/file.media.json' })
  render(<PlanBoard t={{ textPrimary: '#111' }} path="pages/test.plan.json" />)
  fireEvent.click(screen.getByRole('button', { name: 'New goal' }))
  fireEvent.change(screen.getByPlaceholderText('Plan…'), { target: { value: 'Audio task' } })
  fireEvent.drop(screen.getByLabelText('Drop files or Create items here'), { dataTransfer: { files: [new File(['audio'], 'audio.m4a')], getData: () => '' } })
  await screen.findByRole('link', { name: /audio.m4a/ })
  await waitFor(() => expect(screen.getByRole('button', { name: 'Add', exact: true })).toBeEnabled())
  fireEvent.click(screen.getByRole('button', { name: 'Add', exact: true }))
  await waitFor(() => expect(saveJsonWithRetry).toHaveBeenCalled())
  expect((await saveJsonWithRetry.mock.results[0].value).data.tasks[0].attachments[0]).toMatchObject({ name: 'audio.m4a', path: 'pages/PlanAttachments/file.media.json' })
})
