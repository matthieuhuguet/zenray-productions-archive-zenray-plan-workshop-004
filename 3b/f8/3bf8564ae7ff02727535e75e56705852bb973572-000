// 9 October 2026 09:16 CEST: Keep node metadata and rendering decisions in one registry.
import React from 'react'
import Icon from '../components/Icon.jsx'
import { pgPretty } from '../lib/pgPretty.js'
import { lazyRetry } from '../lib/lazyRetry.js'
import { FONTS, PALETTE } from '../theme.js'
import { stripLeafExt, typeOfPath } from './node.js'

const LazyImageNodeViewer = lazyRetry(() => import('../components/ImageNodeViewer.jsx'))
const LazyMediaViewer = lazyRetry(() => import('../components/MediaViewer.jsx'))
const LazyFileNodeViewer = lazyRetry(() => import('../components/FileNodeViewer.jsx'))
const LazyCanvasNodeViewer = lazyRetry(() => import('../ref/RefBoardHost.jsx'))
const LazyEmbedNodeViewer = lazyRetry(() => import('../components/EmbedNodeViewer.jsx'))
const LazyDatabaseTable = lazyRetry(() => import('../components/DatabaseTable.jsx'))
const LazyPlanBoard = lazyRetry(() => import('./PlanBoard.jsx'))

const Fallback = ({ t, label }) => <div style={{ padding: 24, color: t ? t.textSecondary : '#888' }}>{label}</div>
const BoardFallback = ({ t }) => (
  <div style={{
    position: 'absolute', inset: 0, display: 'flex', flexDirection: 'column',
    alignItems: 'center', justifyContent: 'center', gap: 12,
    fontFamily: 'var(--zr-police-sans)', color: t ? t.textSecondary : '#888',
  }}>
    <span style={{
      width: 22, height: 22, borderRadius: 999,
      border: '2px solid color-mix(in srgb, currentColor 24%, transparent)',
      borderTopColor: 'currentColor', animation: 'zrBoardSpin .8s linear infinite',
    }} />
    <span style={{ fontSize: 'var(--zr-ui-sm)', fontWeight: 400 }}>Ouverture du board…</span>
    <span style={{ fontSize: 'var(--zr-ui-2xs)', opacity: .62 }}>Chargement de l’éditeur de canevas, une seule fois par session.</span>
    <style>{'@keyframes zrBoardSpin{to{transform:rotate(360deg)}}'}</style>
  </div>
)

function FolderRenderer({ renderDefault, renderPage, path, context }) {
  if (context === 'create' && path && typeof renderPage === 'function') return renderPage()
  return typeof renderDefault === 'function' ? renderDefault() : null
}

function nodeRenderContext({ t, path, title, paths, onOpenPage }) {
  return { t, path, title, paths: Array.isArray(paths) ? paths : [], onOpenPage }
}

// 9 October 2026 09:33 CEST: Give page, database and media renderers one shared context shape.
function PageRenderer(props) {
  const { renderPage, renderDefault } = props
  if (typeof renderPage === 'function') return renderPage(nodeRenderContext(props))
  return typeof renderDefault === 'function' ? renderDefault() : null
}

function ImageRenderer({ t, path, title }) {
  return <React.Suspense fallback={<Fallback t={t} label="chargement de l'image…" />}><LazyImageNodeViewer key={path} t={t} path={path} title={title} /></React.Suspense>
}

function MediaRenderer(props) {
  const context = nodeRenderContext(props)
  return <React.Suspense fallback={<Fallback t={context.t} label="chargement du média…" />}><LazyMediaViewer key={context.path} {...context} /></React.Suspense>
}

function FileRenderer({ t, path, title }) {
  return <React.Suspense fallback={<Fallback t={t} label="chargement du fichier…" />}><LazyFileNodeViewer key={path} t={t} path={path} title={title} /></React.Suspense>
}

function CanvasRenderer({ t, path, title, theme, dark, context }) {
  const viewer = <React.Suspense fallback={<BoardFallback t={t} />}><LazyCanvasNodeViewer key={path} t={t} path={path} title={title} theme={theme || (dark ? 'dark' : 'light')} /></React.Suspense>
  if (context !== 'create') return viewer
  return <div style={{ position: 'relative', width: '100%', height: 'calc(100vh - 210px)', minHeight: 460, isolation: 'isolate', borderRadius: 14, overflow: 'hidden', border: `1px solid ${t.border}`, background: t.bg }}>{viewer}</div>
}

function EmbedRenderer({ t, path, title }) {
  return <React.Suspense fallback={<Fallback t={t} label="chargement de l'embed…" />}><LazyEmbedNodeViewer key={path} t={t} path={path} title={title} /></React.Suspense>
}

function DatabaseRenderer(props) {
  const common = nodeRenderContext(props)
  const { tableImmersive, context: renderContext } = props
  const table = <React.Suspense fallback={<Fallback t={common.t} label="chargement de la table…" />}><LazyDatabaseTable key={common.path} {...common} /></React.Suspense>
  if (renderContext !== 'create') return table
  return (
    <div style={{ maxWidth: '100%', width: '100%', margin: '0 auto' }}>
      {!tableImmersive && <div style={{ fontFamily: 'var(--zr-police-sans)', fontSize: 32, fontWeight: 700, marginBottom: 14 }}>{common.title}</div>}
      {table}
    </div>
  )
}

function PlanRenderer({ t, path }) {
  return (
    <div style={{ maxWidth: '100%', width: '100%', margin: '0 auto' }}>
      <React.Suspense fallback={<div style={{ padding: 24, minHeight: 300, color: t.textSecondary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)' }}>Loading plan…</div>}>
        <LazyPlanBoard t={t} path={path} />
      </React.Suspense>
    </div>
  )
}

function ZMediaRenderer({ t, path }) {
  const name = pgPretty(stripLeafExt(path).split('/').pop() || '')
  const open = () => window.dispatchEvent(new CustomEvent('zr:media-open', { detail: { path } }))
  return (
    <div style={{ maxWidth: 560, margin: '0 auto', padding: '28px 26px', borderRadius: 18, border: `1px solid ${t.border}`, background: t.cardBg }}>
      <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 10 }}>
        <Icon name="doc.richtext" size={20} />
        <div style={{ fontFamily: FONTS.serif, fontSize: 22, fontWeight: 400 }}>{name}</div>
      </div>
      <p style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-md)', lineHeight: 1.5, margin: '0 0 18px' }}>
        Document ZenRayMedia. Il contient la source (brief, blocs, thème, format), pas le rendu : la page se recompile à l’ouverture.
      </p>
      <button onClick={open} style={{ display: 'inline-flex', alignItems: 'center', gap: 7, border: 0, borderRadius: 999, padding: '9px 17px', cursor: 'pointer', background: PALETTE.primary, color: '#fff', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', fontWeight: 500 }}>
        <Icon name="arrow.up.right" size={14} />Ouvrir dans Media
      </button>
    </div>
  )
}

const QUICK_LOOK = Object.freeze({ folder: 'folder', page: 'markdown', db: 'db', media: 'media', image: 'image', canvas: 'canvas', embed: 'embed', file: 'file', plan: null, zmedia: null, comment: null })
const EXTENSIONS = Object.freeze({ folder: '', page: '.md', db: '.db.json', media: '.media.json', image: '.img.json', canvas: '.ref.json', embed: '.embed.json', file: '.file.json', plan: '.plan.json', zmedia: '.zmedia.json', comment: '.comment.json' })

export const REGISTRY = Object.freeze({
  folder: { Renderer: FolderRenderer, open: 'navigate', icon: 'folder', quickLook: QUICK_LOOK.folder, ext: EXTENSIONS.folder, creatable: true },
  page: { Renderer: PageRenderer, open: 'editor', icon: 'doc.text', quickLook: QUICK_LOOK.page, ext: EXTENSIONS.page, creatable: true },
  db: { Renderer: DatabaseRenderer, open: 'editor', icon: 'tablecells', quickLook: QUICK_LOOK.db, ext: EXTENSIONS.db, creatable: true },
  media: { Renderer: MediaRenderer, open: 'editor', icon: 'play.rectangle', quickLook: QUICK_LOOK.media, ext: EXTENSIONS.media, creatable: false },
  image: { Renderer: ImageRenderer, open: 'editor', icon: 'photo', quickLook: QUICK_LOOK.image, ext: EXTENSIONS.image, creatable: false },
  canvas: { Renderer: CanvasRenderer, open: 'editor', icon: 'square.grid.2x2', quickLook: QUICK_LOOK.canvas, ext: EXTENSIONS.canvas, creatable: true },
  embed: { Renderer: EmbedRenderer, open: 'editor', icon: 'link', quickLook: QUICK_LOOK.embed, ext: EXTENSIONS.embed, creatable: false },
  file: { Renderer: FileRenderer, open: 'editor', icon: 'doc', quickLook: QUICK_LOOK.file, ext: EXTENSIONS.file, creatable: false },
  plan: { Renderer: PlanRenderer, open: 'editor', icon: 'calendar', quickLook: QUICK_LOOK.plan, ext: EXTENSIONS.plan, creatable: true, createOnly: true },
  zmedia: { Renderer: ZMediaRenderer, open: 'editor', icon: 'doc.richtext', quickLook: QUICK_LOOK.zmedia, ext: EXTENSIONS.zmedia, creatable: true, createOnly: true },
  comment: { Renderer: PageRenderer, open: 'editor', icon: 'doc.text', quickLook: QUICK_LOOK.comment, ext: EXTENSIONS.comment, creatable: false, createOnly: true },
})

export function dispatchNodeOpen(node, handlers, modeOverride) {
  const path = node?.contentPath ?? node?.path ?? null
  const type = path ? typeOfPath(path) : (node?.type || 'folder')
  const mode = modeOverride || REGISTRY[type]?.open
  const handler = handlers?.[mode]
  if (typeof handler !== 'function') return false
  handler(node)
  return true
}

export function NodeRenderer({ node, path: pathProp, renderers, context = 'viewer', ...props }) {
  const path = pathProp ?? node?.contentPath ?? node?.path ?? null
  const type = path ? typeOfPath(path) : (node?.type || 'folder')
  const definition = REGISTRY[type]
  if (!definition || (definition.createOnly && context !== 'create')) {
    return typeof props.renderDefault === 'function' ? props.renderDefault() : null
  }
  const Renderer = renderers?.[type] || definition.Renderer
  return <Renderer {...props} node={node} type={type} path={path} paths={props.paths || []} context={context} />
}

export const precharcherBoardRef = () => LazyCanvasNodeViewer.precharger && LazyCanvasNodeViewer.precharger()
