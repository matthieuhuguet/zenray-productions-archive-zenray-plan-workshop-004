// ── INDEX DE RECHERCHE : delta PUBLIC chiffré (zenray-index-public/delta.json) ───────────────────────
// Au lieu de réécrire le gros index privé (47 Mo) à CHAQUE ajout de nœud (drop, archive, push), on append
// les nouveaux chemins à un PETIT delta chiffré sur le repo public. Le client fusionne shards + delta ->
// tout fichier ajouté est cherchable IMMÉDIATEMENT, sans quota API et sans coût O(taille totale). Le prochain
// rebuild complet (build-search-index.mjs) replie le delta dans les shards et le remet à zéro.
const IREPO = 'matthieuhuguet/zenray-index-public'
const ghI = (token, path, init = {}) => fetch(`https://api.github.com/repos/${IREPO}/${path}`, { ...init, headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress', ...(init.headers || {}) } })
async function importMediaKeyCK() { const { loadMediaKey } = await import('./media-key.js'); const raw = Uint8Array.from(Buffer.from(loadMediaKey(), 'base64')); return globalThis.crypto.subtle.importKey('raw', raw, { name: 'AES-GCM' }, false, ['encrypt', 'decrypt']) }
