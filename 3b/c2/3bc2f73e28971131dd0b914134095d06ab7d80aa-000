// D — 403 GRACIEUX : détecte un rate-limit GitHub sur une réponse non-ok.
// GitHub renvoie 403 (limite primaire, x-ratelimit-remaining=0) ou 429 (limite secondaire).
// On expose au client { rateLimited:true, resetAt } (millisecondes epoch) pour qu'il affiche
// un bandeau exact et reprogramme UN seul re-fetch à l'heure de reset, au lieu de spinner/boucler.
// Sur tout autre non-ok, renvoie {} (rien) -> comportement existant inchangé.
const rlInfo = (r) => {
