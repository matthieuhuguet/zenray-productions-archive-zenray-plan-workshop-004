// Reecriture des refs de chemin (from->to) dans les fichiers texte (playlists HLS, manifeste media), AVEC garde
// de FRONTIERE : on ne remplace qu'a la limite '/' (ou '%2F' en URL-encode), donc deplacer `pages/A` ne corrompt
// JAMAIS `pages/AB`. Couvre le brut, l'encode-complet (?path=) et l'encode-partiel.
function rewriteTreePaths(txt, from, to) {
  const variants = [
    [from + '/', to + '/'],
    [encodeURIComponent(from) + '%2F', encodeURIComponent(to) + '%2F'],
    [encodeURI(from) + '/', encodeURI(to) + '/'],
  ]
  for (const [a, b] of variants) if (a !== b) txt = txt.split(a).join(b)
  return txt
}

