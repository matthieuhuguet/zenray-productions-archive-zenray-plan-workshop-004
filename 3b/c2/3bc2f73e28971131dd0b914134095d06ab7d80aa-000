      const rr = await ghI(token, `contents/delta.json?ref=${baseSha}`, { headers: { Accept: 'application/vnd.github.raw' } })
      if (rr.ok) { const blob = await rr.json(); if (blob && blob.ct) cur = JSON.parse(await decSrv(key, blob)) }
      else if (rr.status !== 404) { await sleep(300 * (a + 1)); continue }
      const rmSet = new Set(cur.rm || [])
      const set = new Set(cur.paths || []); let changed = 0
      // Recréer un chemin précédemment supprimé doit aussi annuler son tombstone.
      // Sinon il est présent dans `paths` puis immédiatement retiré par `rm` côté client.
      for (const p of addPaths) {
        if (rmSet.delete(p)) changed++
        if (!set.has(p)) { set.add(p); changed++ }
      }
      // rm = chemins disparus (déplacement) : retirés du delta ET listés pour que le client les ôte des shards.
      for (const p of (rmPaths || [])) { rmSet.add(p); set.delete(p); changed++ }
