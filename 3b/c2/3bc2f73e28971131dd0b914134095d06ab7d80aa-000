// Wrapper fetch brut sur le repo content. Instrumenté ci-dessous : chaque écriture (PUT/POST/DELETE)
// est journalisée dans le Repo Commands log (les GET ne le sont pas).
const ghRaw = (token, path, init = {}) =>
  fetch(`https://api.github.com/repos/${REPO}/${path}`, {
    ...init,
    headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress', ...(init.headers || {}) },
  })
const gh = instrument(ghRaw, {
  repoOf: () => REPO,
  pathOf: (args) => args[1],
  initOf: (args) => args[2] || {},
})
const b64e = (s) => Buffer.from(s, 'utf8').toString('base64')
const b64d = (s) => Buffer.from(s, 'base64').toString('utf8')
// ═══ UN FICHIER DE PLUS D'1 MIO REND UN CORPS VIDE PAR L'API CONTENTS (2026-10-04) ═══════════════
//
// BUG MESURE : GET /contents/<fichier> renvoie `content: ""` et `encoding: "none"` au-dessus de 1 Mio,
// avec un sha pourtant VALIDE. Un client qui lit « vide » et sauvegarde ensuite avec ce sha valide
// ecrase le fichier entier sans une erreur. Le fichier des studios de ZenRay Freelance a franchi ce
// seuil (1 093 861 octets) et le site l'a lu vide pendant quelques minutes.
//
// La parade est de relire le contenu par son blob (`git/blobs/<sha>`), qui sert jusqu'a 100 Mio, et de
// LEVER une erreur plutot que de rendre un corps vide si ce second chemin echoue aussi.
const contentsText = async (token, j) => {
  if (j && typeof j.content === 'string' && j.content !== '' && j.encoding !== 'none') return b64d(j.content)
  if (!j || !j.sha) throw new Error('contents-without-sha')
  const blob = await gh(token, `git/blobs/${j.sha}`)
  if (!blob.ok) throw new Error(`blob-${blob.status}`)
  return b64d((await blob.json()).content)
}
const EAGLE_LINK_TYPE = 'zenray-eagle-link/v1'
const EAGLE_FOLDER_LINK_TYPE = 'zenray-eagle-folder-link/v1'
const EAGLE_FOLDER_LINK_FILE = '.zreagle-folder.json'
const EAGLE_FOLDER_RESOURCE_FILE = '.zreagle-resource.json'
const EAGLE_RESOURCE_DIR = 'pages/.zr-resources'
const EAGLE_LINK_RE = /\.(img|media|file|canvas|ref|embed|db)\.json$/
const isEagleLink = (value) => !!(value && value.type === EAGLE_LINK_TYPE && typeof value.resourceId === 'string')
const resourcePathOf = (id) => `${EAGLE_RESOURCE_DIR}/${id}.json`
const resourceIdOf = () => `zr_${globalThis.crypto.randomUUID().replace(/-/g, '')}`
const jsonBlob = async (token, value) => {
  const r = await gh(token, 'git/blobs', { method: 'POST', body: JSON.stringify({ content: b64e(JSON.stringify(value, null, 2)), encoding: 'base64' }) })
  if (!r.ok) return null
  return (await r.json()).sha
}
// ═══ UN CHEMIN SE NORMALISE EN NFC AVANT DE PARTIR SUR LE RÉSEAU (2026-08-31) ═══════════════════
//
// BUG RÉEL, mesuré : le même chemin rend 200 en forme COMPOSÉE et 404 en forme DÉCOMPOSÉE.
//
//   .../29%20Ao%C3%BBt%202026/…      -> 200
//   .../29%20Aou%CC%82t%202026/…     -> 404
//
// macOS écrit les accents décomposés (« û » = « u » + accent combinant), GitHub les stocke composés.
// Les deux s'affichent à l'identique et ne sont PAS la même chaîne d'octets, donc pas la même URL.
// Un chemin passé par le système de fichiers du Mac, un presse-papier ou un glisser-déposer peut
// arriver ici décomposé, et la lecture échoue alors sur un fichier qui existe pourtant.
//
// Ce que ça coûtait : « 0/13 lien(s) créé(s) » sur un dossier nommé « 29 Août 2026 », avec l'erreur
// `invalid-source` — un manifeste déclaré illisible alors qu'il se lit parfaitement.
//
// La normalisation est SANS RISQUE : sur un chemin sans accent, NFC ne change rien.
const nfc = (p) => typeof p === 'string' ? p.normalize('NFC') : p

// Lecture d'un JSON du dépôt. Par défaut : `raw` SEUL, gratuit et hors quota REST.
//
// ═══ LE REPLI SUR L'API EST EXPLICITE, ET C'EST UNE RÈGLE DE QUOTA ══════════════════════════════
//
// INCIDENT PAYÉ le 2026-08-31 à 03h03 : quota GitHub à 0 sur 5000, et « Lien média indisponible » sur
// des images qui existent. Ma faute, quelques heures plus tôt.
//
// J'avais ajouté un repli sur l'API `contents` quand `raw` échoue, pour distinguer « absent » de
// « pas encore propagé ». Mais je le déclenchais AUSSI sur un 404 — or le 404 est le cas NORMAL,
// massivement : `resolveEagleFolderDir` sonde `.zreagle-folder.json` sur CHAQUE ancêtre de CHAQUE
// chemin, cinq par fichier, et aucun de ces fichiers n'existe. Chaque sonde consommait donc une
// requête de quota. Un lot de treize fichiers en brûlait soixante-cinq, pour rien.
//
// LE 404 DE `raw` EST FIABLE POUR UNE SONDE D'EXISTENCE : si le fichier n'a jamais été écrit, il
// n'est ni dans le CDN ni dans l'arbre, et les deux voies répondent la même chose. Le repli n'a de
// sens que pour un fichier qu'on vient d'ÉCRIRE et qu'on relit aussitôt — là, et seulement là, le
// cache du CDN peut mentir.
//
// D'où `{ replierSur404: true }`, à passer UNIQUEMENT sur ces lectures-là. Le défaut ne coûte rien.
const rawJsonAt = async (token, path, { replierSur404 = false } = {}) => {
  const chemin = nfc(path)
  const parRaw = async () => {
    try {
      const r = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(chemin)}`, { cache: 'no-store', headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })
      if (r.ok) return { lu: true, valeur: await r.json() }
      return { lu: false, statut: r.status }
    } catch { return { lu: false, statut: 0 } }
  }
  const parApi = async () => {
    try {
      const c = await gh(token, `contents/${encodeURI(chemin)}?ref=${BRANCH}`)
      if (!c.ok) return { lu: false }
      const j = await c.json()
      if (!j || typeof j.content !== 'string') return { lu: false }
      return { lu: true, valeur: JSON.parse(b64d(j.content)) }
    } catch { return { lu: false } }
  }

  let r = await parRaw()
  if (r.lu) return r.valeur

  // Un 404 sur une sonde d'existence est une réponse, pas une panne : on s'arrête là.
  if (r.statut === 404 && !replierSur404) return null

  // PAS DE RETENTE, et c'est un chiffre qui l'impose. Un Worker Cloudflare a droit à CINQUANTE
  // sous-requêtes, et un seul fichier d'un lot en consomme déjà treize : cinq sondes d'ancêtres pour
  // la source, cinq pour la cible, le manifeste, le registre, le dossier. Une retente les DOUBLE, à
  // vingt-six — deux fichiers suffisaient alors à faire tuer le Worker, qui ne rend plus rien du
  // tout. C'est le « Aucun élément créé · inconnu » signalé à 03h39 : pas un code d'erreur, une
  // absence de réponse.
  //
  // Le repli sur l'API, lui, reste : il ne se déclenche que sur les lectures marquées, et une
  // sous-requête vaut mieux qu'un lot annulé.
  const a = await parApi()
  return a.lu ? a.valeur : null
}

// ═══ UNE LECTURE QU'ON VA RÉÉCRIRE NE PASSE JAMAIS PAR RAW (2026-09-05) ═════════════════════════
//
// SYMPTÔME : Matthieu trie deux fois la même image dans le même dossier de tri et obtient DEUX
// raccourcis, « IMG_6454.3hdh7r » et « IMG_6454.3hdh7r 2 », pointant deux ressources distinctes,
// pendant que le manifeste canonique ne garde que la dernière identité.
//
// CAUSE : le cache CDN de raw ne sert pas seulement des 404 sur les fichiers neufs, il sert aussi
// des 200 PÉRIMÉS sur les fichiers qu'on vient de réécrire. Le second tri relisait donc un canonique
// d'avant le premier, n'y voyait aucun `resourceId`, et en frappait un neuf. Rien ne le signalait :
// la réponse était un succès, seulement vieille.
//
// LA RÈGLE QUI EN SORT : une lecture d'AFFICHAGE peut être vieille de quelques minutes sans dommage,
// et raw reste alors le bon choix, gratuit en quota. Une lecture qu'on va MODIFIER PUIS RÉÉCRIRE ne
// le peut pas : elle doit venir de l'API, seule immédiatement cohérente, sans quoi l'écriture forke
// silencieusement la donnée.
//
// CE QUE CELA COÛTE : une sous-requête, et seulement quand raw prétend qu'il n'y a pas encore
// d'identité — c'est-à-dire au premier tri d'une image, jamais aux suivants.
const apiJsonAt = async (token, path) => {
  try {
    const c = await gh(token, `contents/${encodeURI(nfc(path))}?ref=${BRANCH}`)
    if (!c.ok) return null
    const j = await c.json()
    if (!j || typeof j.content !== 'string') return null
    return JSON.parse(b64d(j.content))
  } catch { return null }
}
// Resolve a logical directory through the nearest Eagle folder placement. The
// marker points to a stable resourceId; the registry owns the movable sourceDir.
// ═══ LES SONDES D'ANCÊTRES NE SE REFONT PAS POUR CHAQUE FICHIER D'UN MÊME LOT ═══════════════════
//
// `resolveEagleFolderDir` interroge `.zreagle-folder.json` sur chaque ancêtre du chemin — cinq pour
// un chemin ordinaire, et aucun de ces fichiers n'existe. Or les treize fichiers d'un lot vivent
// dans le MÊME dossier : sans mémoire, ce sont soixante-cinq appels pour cinq réponses.
//
// La mémoire vit le temps d'UNE invocation du Worker (`globalThis`, remis à zéro entre deux requêtes
// froides), ce qui est exactement la bonne durée : assez longue pour couvrir un lot entier, trop
// courte pour servir une réponse périmée à la requête suivante.
const memoireDossiers = () => {
  const g = globalThis
  if (!g.__zrDossiersEagle) g.__zrDossiersEagle = new Map()
  return g.__zrDossiersEagle
}
export function oublierMemoireDossiers() { try { delete globalThis.__zrDossiersEagle; delete globalThis.__zrSondesEagle } catch {} }

async function resolveEagleFolderDir(token, logicalDir) {
  const memo = memoireDossiers()
  if (memo.has(logicalDir)) return memo.get(logicalDir)
  const p = resolveEagleFolderDirBrut(token, logicalDir)
  memo.set(logicalDir, p)
  return p
}

// LA SONDE D UN ANCETRE SE MEMOISE, PAS SEULEMENT LE CHEMIN COMPLET (2026-08-31).
//
// La memoire posee cette nuit portait sur le chemin logique ENTIER, ce qui evitait bien de resonder
// pour chacun des treize fichiers d un meme dossier. Mais une source et sa cible partagent leurs
// ancetres : resoudre `pages/A/B/C` puis `pages/A/B/C/tri` sondait deux fois `C`, deux fois `B`,
// deux fois `A`. Mesure du test : sept sondes pour quatre chemins distincts.
//
// Ce surcout etait INVISIBLE jusqu'ici parce que le test ne savait pas commiter : il mesurait le
// chemin d ECHEC, qui s arrete plus tot. C est exactement ce que le constat #17 de l audit annoncait.
const memoireSondes = () => {
  const g = globalThis
  if (!g.__zrSondesEagle) g.__zrSondesEagle = new Map()
  return g.__zrSondesEagle
}

function sonderMarqueur(token, root) {
  const memo = memoireSondes()
  const cle = `${root}/${EAGLE_FOLDER_LINK_FILE}`
  if (memo.has(cle)) return memo.get(cle)
  const p = rawJsonAt(token, cle)
  memo.set(cle, p)
  return p
}

async function resolveEagleFolderDirBrut(token, logicalDir) {
  const segs = logicalDir.split('/')
  for (let i = segs.length; i >= 2; i--) {
    const root = segs.slice(0, i).join('/')
    const marker = await sonderMarqueur(token, root)
    if (!marker || marker.type !== EAGLE_FOLDER_LINK_TYPE || typeof marker.resourceId !== 'string') continue
    const registry = await rawJsonAt(token, resourcePathOf(marker.resourceId))
    if (!registry || registry.resourceId !== marker.resourceId || typeof registry.sourceDir !== 'string') return { error: 'orphan-folder-link' }
    const suffix = segs.slice(i).join('/')
    return { logicalRoot: root, sourceRoot: registry.sourceDir, physicalDir: suffix ? `${registry.sourceDir}/${suffix}` : registry.sourceDir, resourceId: marker.resourceId }
  }
  return { physicalDir: logicalDir }
}
async function resolveEagleFilePath(token, logicalPath) {
  const slash = logicalPath.lastIndexOf('/')
  if (slash < 0) return { physicalPath: logicalPath }
  const folder = await resolveEagleFolderDir(token, logicalPath.slice(0, slash))
  if (folder.error) return folder
  return {
    ...folder,
    physicalPath: `${folder.physicalDir}/${logicalPath.slice(slash + 1)}`,
  }
}

// .plan.json (ZenRay Plan, 2026-07-20) ajouté ici -- même piège que server/nodeTreeFilter.js : un noeud
// absent de cette regex reste invisible à l'indexation, même s'il existe bel et bien sur GitHub.
// SOURCE UNIQUE (2026-08-31) : cette liste oubliait `zmedia.json`, si bien qu un document
// ZenRayMedia deplace n etait pas reindexe et disparaissait de la recherche. Le commentaire juste
// en dessous decrivait deja ce piege — il etait ecrit a cote de la copie, ce qui ne l a pas empeche.
const INDEX_NODE_RE = RE_NOEUD

// UN DOSSIER PRÉCIS SE LIT PAR SON PROPRE SOUS-ARBRE, jamais par l'arbre entier du dépôt filtré
// ensuite. Généralisé le 2026-08-29 : la même fonction servait déjà l'indexation d'un déplacement
// (isNode = INDEX_NODE_RE) ; `action=tree&dir=…` en avait besoin aussi et faisait l'inverse — un seul
// `git/trees/${BRANCH}?recursive=1` SANS BORNE, filtré après coup par préfixe. Sur ce dépôt, cet appel
// est TRONQUÉ (mesuré le 2026-08-05, 44 015 entrées sur 135 588) et un dossier entier peut disparaître
// sans un mot dès que ses fichiers tombent après la coupure. Bug réel, payé le 2026-08-29 sur un lien
// de partage : `pages/Photos/DJI/29 Août 2026` rendait « Empty folder » alors que les 749 manifestes
// étaient bien commités, parce que TOUT le sous-arbre `pages/Photos/DJI` tombait après la troncature.
//
// Le prédicat est un paramètre et non figé sur INDEX_NODE_RE, pour que l'appelant décide ce qui compte
// comme nœud visible : l'indexation d'un déplacement ignore les marqueurs de dossier vide
// (.zrfolder.json) à dessein, alors que `action=tree` doit les garder (`isExposedTreeNode`), sans quoi
// un dossier vide fraîchement créé redeviendrait invisible — exactement la régression du 2026-07-12
// que `isExposedTreeNode` avait déjà corrigée.
// La mécanique elle-même (sous-arbre, repli, garde de troncature) vit dans `repoSubtree.js`, qui la
// teste sans réseau et la partage avec `share-og.js`, atteint du même bug le même jour.
async function scopedNodePathsUnder(token, root, isNode) {
  const readTreeish = async (dir) => {
    const r = await gh(token, `git/trees/${encodeURIComponent(BRANCH + ':' + dir)}?recursive=1`)
    if (!r.ok) return { ok: false }
    const json = await r.json()
    return { ok: true, tree: json.tree || [], truncated: !!json.truncated }
  }
  const readDirContents = async (dir) => {
    const response = await gh(token, `contents/${encodeURI(dir)}?ref=${BRANCH}`)
    if (!response.ok) return []
    const value = await response.json()
    return Array.isArray(value) ? value : []
  }
  const { paths } = await collectSubtreeBlobPaths(readTreeish, readDirContents, root, isNode, (dir) => dir.startsWith(EAGLE_RESOURCE_DIR + '/'))
  return paths.map((p) => `${root}/${p}`)
}
// A folder placement indexes the logical mirror of every visible node in its physical bundle —
// marqueurs de dossier exclus à dessein, une indexation de recherche n'a rien à faire d'un dossier vide.
const indexedNodePathsUnder = (token, root) => scopedNodePathsUnder(token, root, (p) => INDEX_NODE_RE.test(p))

async function directDirectoryEntries(token, dir) {
  const response = await gh(token, `git/trees/${encodeURIComponent(BRANCH + ':' + dir)}`)
  if (!response.ok) return null
  const value = await response.json()
  return Array.isArray(value.tree) ? value.tree : []
}

