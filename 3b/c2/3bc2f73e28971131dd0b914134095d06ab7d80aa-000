    const arbre = await r.json()
    const noeud = (arbre.tree || []).find((x) => x.type === 'tree' && x.path === segment)
    if (!noeud) { cache.set(cle, null); return null }
    cache.set(cle, noeud.sha)
    sha = noeud.sha
    void parent
  }
  const rf = await gh(token, `git/trees/${encodeURIComponent(sha)}`)
