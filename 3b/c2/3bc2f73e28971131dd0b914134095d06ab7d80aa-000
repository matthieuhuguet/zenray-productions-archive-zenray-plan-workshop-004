      const key = await importMediaKeyCK()
      // 2026-09-11 Read the delta AT the ref we are about to fast-forward, through the API, never through
      // raw.githubusercontent (5 min cache). The cached read made four index-adds run minutes apart each
      // start from the same stale delta, so the last one erased the three before it (ZenRay Assets).
      // FR : lire le delta AU ref qu'on va avancer, par l'API, jamais par le cache raw de 5 min.
      const ref0 = await ghI(token, 'git/ref/heads/main'); if (!ref0.ok) { await sleep(300 * (a + 1)); continue }
