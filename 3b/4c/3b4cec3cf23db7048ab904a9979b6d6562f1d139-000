// RETROUVER UN DOSSIER PAR SON NOM AFFICHÉ, DE FAÇON DÉTERMINISTE.
//
// Extrait d'App.jsx le 2026-08-12 pour être testable : cette résolution a causé DEUX fois la même
// perte d'intégrité (deux dossiers « Calendar » se remplissant en parallèle), et une fonction qui a
// coûté ça mérite des tests, pas un commentaire de plus.
//
// LE PROBLÈME. Les dossiers créés par l'interface portent un suffixe technique de quatre caractères
// (`Calendar-76ct`, `Aout 2026-1lhw`) que `pgPretty` retire À L'AFFICHAGE. Deux dossiers physiques
// distincts peuvent donc porter le même nom visible. La première version visait `pages/Calendar` en
// dur et créait un second Calendar ; la deuxième rendait le PREMIER nom correspondant trouvé dans
// l'index, ce qui n'est pas un choix mais un tirage — l'ordre de l'index n'est pas stable, donc la
// note du jour tombait tantôt dans un dossier, tantôt dans l'autre.
//
// LA RÈGLE. À noms affichés égaux, le dossier qui contient LE PLUS de fichiers gagne : c'est celui
// où le travail vit réellement, jamais la coquille créée par accident. À égalité stricte, l'ordre
// alphabétique du segment départage, pour que deux chargements successifs ne divergent jamais.
import { pgPretty } from './pgPretty.js'

export const sansAccents = (s) => String(s).normalize('NFD').replace(/[̀-ͯ]/g, '')
export const clefNom = (s) => sansAccents(s).toLowerCase().trim()

/**
 * @param {string[]} paths   tous les chemins connus de l'arbre
 * @param {string}   parent  dossier parent, sans barre finale (« pages »)
 * @param {string}   nomAffiche  nom cherché, tel qu'il s'affiche (« Calendar », « Aout 2026 »)
 * @returns {string|null} le chemin du dossier gagnant, ou null si aucun ne correspond
 */
export function dossierExistant(paths, parent, nomAffiche) {
  const prefixe = parent + '/'
  const cible = clefNom(nomAffiche)
  const poids = new Map()
  for (const p of (paths || [])) {
    if (typeof p !== 'string' || !p.startsWith(prefixe)) continue
    const segment = p.slice(prefixe.length).split('/')[0]
    if (!segment || clefNom(pgPretty(segment)) !== cible) continue
    poids.set(segment, (poids.get(segment) || 0) + 1)
  }
  if (!poids.size) return null
  const [gagnant] = [...poids.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))[0]
  return prefixe + gagnant
}
