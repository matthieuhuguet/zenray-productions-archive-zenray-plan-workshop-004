export function createLruCache({ maxEntries, onEvict } = {}) {
  const limit = Math.max(1, Math.floor(Number(maxEntries) || 1))
  const values = new Map()
  const evict = (key, value) => { try { onEvict?.(value, key) } catch {} }
  const trim = () => {
    while (values.size > limit) {
      const key = values.keys().next().value
      const value = values.get(key)
      values.delete(key)
      evict(key, value)
    }
  }
  return {
    get size() { return values.size },
    has: (key) => values.has(key),
    peek: (key) => values.get(key),
    get(key) {
      if (!values.has(key)) return undefined
      const value = values.get(key)
      values.delete(key)
      values.set(key, value)
      return value
    },
    set(key, value) {
      if (values.has(key)) values.delete(key)
      values.set(key, value)
      trim()
      return value
    },
    delete(key) {
      if (!values.has(key)) return false
      const value = values.get(key)
      values.delete(key)
      evict(key, value)
      return true
    },
    clear() {
      for (const [key, value] of values) evict(key, value)
      values.clear()
    },
    keys: () => values.keys(),
  }
}

export function createLruSet(maxEntries) {
  const cache = createLruCache({ maxEntries })
  return {
    get size() { return cache.size },
    has: (key) => cache.get(key) !== undefined,
    add(key) { cache.set(key, true); return this },
    delete: (key) => cache.delete(key),
    clear: () => cache.clear(),
  }
}
