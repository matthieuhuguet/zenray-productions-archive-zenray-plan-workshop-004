#!/usr/bin/env node
// GÉNÈRE LE THÈME SPOTIFY DEPUIS SON PROPRE TABLEAU DE SPÉCIFICATION.
//
// Le tableau de `docs/zenraymedia/v1/07-theme-spotify.md` déclare 48 parts avec leurs champs
// éditables. Le recopier à la main dans 48 fichiers ferait diverger la spécification du thème dès
// la première retouche ; le générer depuis elle rend la divergence impossible.
//
// Ce que ce script produit est un thème COMPLET et ÉDITABLE, pas une reproduction au pixel de
// Spotify : chaque part porte son en-tête `<!--zrm …-->`, ses champs déclarés que la carte C1 sait
// désormais lire, et un balisage réel en unités RELATIVES — le contrat de la voie Lego, la densité
// des formats bornés passant par la taille de police racine.
import { readFileSync, writeFileSync, mkdirSync } from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const RACINE = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const SPEC = path.join(RACINE, 'docs/zenraymedia/v1/07-theme-spotify.md')
const ID = 'T-16-1-1'
const DIR = path.join(RACINE, 'src/zenraymedia/themes', `${ID}--spotify-client`)

// ── Lire la spécification ───────────────────────────────────────────────────────────────────────
const lignes = readFileSync(SPEC, 'utf8').split('\n').filter((l) => /^\|\s*`\d\d-/.test(l))
const parts = lignes.map((l) => {
  const [, fichier, groupe, champs, role] = l.split('|').map((x) => x.trim())
  const nom = fichier.replace(/`/g, '')
  const props = champs === 'aucun' ? [] : champs.split(',').map((c) => {
    const m = /`?(\w+):(\w+)(?:\(([^)]*)\))?`?/.exec(c.trim())
    if (!m) return null
    return { key: m[1], type: m[2], ...(m[3] ? { choices: m[3].split(',') } : {}) }
  }).filter(Boolean)
  return { file: nom, id: nom.replace(/\.html$/, ''), group: groupe, props, role }
})
if (parts.length < 32) { console.error(`spécification illisible : ${parts.length} parts trouvées`); process.exit(1) }

// ── Le corps d'une part, dérivé de ses champs ───────────────────────────────────────────────────
const TYPE_RENDU = {
  color: (k) => `<i class="sp-swatch" style="background:{{${k}}}"></i>`,
  bool: (k) => `<i class="sp-flag" data-${k}="{{${k}}}"></i>`,
  number: (k) => `<span class="sp-num">{{${k}}}</span>`,
}
const corps = (p) => {
  if (!p.props.length) return '<div class="sp-defs"><svg class="sp-signs" aria-hidden="true"><defs></defs></svg></div>'
  const champs = p.props.map((d) => (TYPE_RENDU[d.type] || ((k) => `<span class="sp-${d.key}">{{${k}}}</span>`))(d.key)).join('')
  return `<div class="sp-part" data-part="${p.id}">${champs}</div>`
}

mkdirSync(path.join(DIR, 'parts'), { recursive: true })
for (const p of parts) {
  const entete = JSON.stringify({ name: p.id.replace(/^\d+-/, '').replace(/-/g, ' '), group: p.group, props: p.props })
  writeFileSync(path.join(DIR, 'parts', p.file),
    `<!--zrm ${entete}-->\n<style>.sp-part{display:flex;align-items:center;gap:.6em;min-width:0}` +
    `.sp-swatch{width:1cap;height:1cap;border-radius:99px;flex:0 0 auto}` +
    `.sp-flag[data-${p.props.find((d) => d.type === 'bool')?.key || 'x'}="false"]{display:none}` +
    `.sp-num{font-variant-numeric:tabular-nums;opacity:.7}</style>\n${corps(p)}\n`)
}

writeFileSync(path.join(DIR, 'component-registry.json'), JSON.stringify(
  parts.map((p) => ({ id: p.id, name: p.id.replace(/^\d+-/, '').replace(/-/g, ' '), group: p.group, file: `parts/${p.file}`, props: p.props, standalone: true })), null, 2) + '\n')

writeFileSync(path.join(DIR, 'theme.json'), JSON.stringify({
  id: ID, name: 'Client de streaming', family: 16, subfamily: 1, variant: 1,
  fonts: ['AnthropicSans'], forms: [3], generated: 'scripts/generer-theme-spotify.mjs',
}, null, 2) + '\n')

writeFileSync(path.join(DIR, 'tokens.css'), `/* Jetons du thème, en unités RELATIVES : la densité des formats bornés passe par la taille de
   police racine, donc toute valeur en pixels durs ne suivrait pas. */
:root{--sp-bg:#121212;--sp-panel:#181818;--sp-ink:#fff;--sp-muted:#b3b3b3;--sp-accent:#1ed760;
--sp-radius:.5em;--sp-gap:.6em}\n`)

console.log(`${parts.length} parts écrites dans ${path.relative(RACINE, DIR)}`)
