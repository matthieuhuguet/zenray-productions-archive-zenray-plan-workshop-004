// FR : Keywords Studios, le catalogue officiel et chaque fiche individuelle.
import { ROLE_PATTERN, offerId } from '../lib/Offer.mjs'
import { mapLimited } from '../lib/Http.mjs'
import { clean, jobPosting } from '../lib/Text.mjs'

export const KEY = 'keywords'
const STUDIOS = ['d3t', 'GameSim', 'VOLTA', 'Sperasoft', 'Electric Square', 'Climax Studios', 'Wicked Workshop', 'Tantalus']

export function parseBoard(index) {
  const endpoint = (index.match(/data_url:\s*'([^']+filter_stream[^']+)'/) || [])[1]
  const total = Number((index.match(/_filter_total\s*=\s*(\d+)/) || [])[1])
  if (!endpoint || !total) throw new Error('Keywords board layout changed: endpoint or total not found')
  return { endpoint, total }
}

export function parseDetail(job, body) {
  const posting = jobPosting(body)
  if (!posting) throw new Error('No JobPosting in the current career page')
  const start = body.indexOf('<h1')
  const end = body.indexOf('<form', start)
  const text = end > start ? body.slice(start, end) : posting.description || ''
  const plain = clean(text)
  let name = posting.hiringOrganization?.name || 'Keywords Studios'
  if (name === 'Keywords Studios') {
    const studio = STUDIOS.find((entry) => new RegExp(`\\b${entry.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`, 'i').test(plain))
    if (studio) name = `${studio} (Keywords Studios)`
  }
  const address = posting.jobLocation?.address || {}
  let contract = Array.isArray(posting.employmentType) ? posting.employmentType.join(', ') : posting.employmentType || ''
  let title = job.title
  let extra = ''
  if (/talent pool|talent pipe(?:line)?|candidate pipe(?:line)?|speculative application/i.test(title)) {
    title = `Vivier de candidatures : ${title}`
    extra = 'Vivier de candidatures ou candidature spontanée ; aucun poste immédiat garanti. Cette fiche ne compte pas comme une offre de poste confirmé.'
  }
  if (title.includes('12 Month Contract')) contract = 'Contrat de 12 mois ; statut freelance non établi'
  return {
    sourceKey: KEY, sourceLabel: 'Keywords Studios', evidence: 'Keywords Studios, catalogue officiel et fiche individuelle', name, title, url: job.url, applyUrl: job.url, sourceId: `keywords:${job.id}`,
    location: job.location_text || '', country: address.addressCountry || '', contract, workplace: /\bremote\b/i.test(plain) ? 'Remote' : /\bhybrid\b/i.test(plain) ? 'Hybride' : 'À confirmer dans la fiche',
    published: posting.datePosted || '', validThrough: posting.validThrough || '', text, extra, careersUrl: 'https://www.keywordsstudios.com/en/careers/browse-careers/',
  }
}

export async function collect({ http, config }) {
  const settings = config.sources.keywords
  const { endpoint, total } = parseBoard(await http.text(settings.boardUrl))
  const offsets = Array.from({ length: Math.ceil(total / 50) }, (_, index) => index * 50)
  const pages = await mapLimited(offsets, config.http.workers, (offset) => http.json(`${endpoint}?offset=${offset}&limit=50`))
  const failed = pages.filter((page) => !page.ok)
  const unique = new Map()
  for (const page of pages) if (page.ok) for (const job of page.value) unique.set(job.id, job)
  const selected = [...unique.values()].filter((job) => ROLE_PATTERN.test(job.title))
  const errors = failed.map((page) => ({ source: 'keywords-page', error: page.error.message }))
  const details = await mapLimited(selected, config.http.workers, async (job) => parseDetail(job, await http.text(job.url)))
  const listings = []
  details.forEach((result, index) => { if (result.ok) listings.push(result.value); else errors.push({ source: selected[index].url, error: result.error.message }) })
  return [{ key: KEY, label: settings.label, listings, seenIds: selected.map((job) => offerId(`keywords:${job.id}`)), listed: unique.size, matched: listings.length, errors, complete: failed.length === 0, boardTotal: total }]
}
