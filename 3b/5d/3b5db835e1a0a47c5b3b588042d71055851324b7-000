// C214b — bloc déplaçable librement en mode Canvas (pointer events, position persistée localStorage). Layout séparé de la donnée.
export function DraggableBlock({ id, canvas, setPos, children }) {
  const ref = useRef(null)
  const pos = canvas[id] || null
  const onDown = (e) => {
    if (e.target.closest('button, input, textarea, a, select, [contenteditable="true"]')) return
    const startX = e.clientX, startY = e.clientY, base = pos || { x: 40, y: 40 }
    const move = (ev) => setPos(id, { x: Math.max(0, base.x + (ev.clientX - startX)), y: Math.max(0, base.y + (ev.clientY - startY)) })
    const up = () => { window.removeEventListener('pointermove', move); window.removeEventListener('pointerup', up) }
    window.addEventListener('pointermove', move); window.addEventListener('pointerup', up)
  }
  return (
    <div ref={ref} onPointerDown={onDown} style={{ position: 'absolute', left: pos ? pos.x : 40, top: pos ? pos.y : 40, width: 'min(680px,90%)', cursor: 'grab', touchAction: 'none' }}>{children}</div>
  )
}
export function Board({ t, state, todayY, toggleStep, addCard, moveCard, addImages, onOpen, delCard }) {
  const syn = DATA.synthesis || {}
  const stepsTotal = allObjs().reduce((n, o) => n + (o.milestones ? o.milestones.length : 0), 0)
  const stepsDone = Object.keys(state.steps).length
  const [canvasMode, setCanvasMode] = useState(false) // C214d
  const [canvas, setCanvas] = usePersistedState('zr:canvas:home', {}, { json: true })
  const setPos = (id, p) => setCanvas((c) => ({ ...c, [id]: p }))
  const blocks = [
    ['overall', <Overall t={t} value={overall(state.steps)} done={stepsDone} total={stepsTotal} theme={syn.overall_theme} />],
    ['priority', <Priority t={t} syn={syn} />],
    ['week', <WeekCalendar t={t} cards={state.cards} today={todayY} onDropObj={(p, date) => addCard(p.obj, p.domain, date)} onMoveCard={moveCard} onOpen={onOpen} onDelCard={delCard} addImages={addImages} onAddBlank={(date) => addCard(null, '', date)} />],
    ['domains', <Domains t={t} steps={state.steps} onToggle={toggleStep} onDone={(obj, domain) => addCard(obj, domain, todayY)} />],
    ['sequence', <Sequence t={t} seq={syn.master_sequence || []} />],
    ['twocol', <TwoCol t={t} blindSpots={syn.blind_spots || []} cadence={syn.weekly_cadence || []} />],
  ]
  const toolbar = (
    <div style={{ display: 'flex', justifyContent: 'flex-end', marginBottom: 12 }}>
      <button onClick={() => setCanvasMode((v) => !v)} style={{ display: 'inline-flex', alignItems: 'center', gap: 7, background: canvasMode ? PALETTE.gradient : 'transparent', color: canvasMode ? '#fff' : t.textSecondary, border: `1px solid ${canvasMode ? 'transparent' : t.border}`, borderRadius: RADII.sm, padding: '5px 13px', cursor: 'pointer', fontSize: 'var(--zr-ui-sm)', fontWeight: 600 }}><Icon name="square.grid.2x2" size={14} color={canvasMode ? '#fff' : t.textSecondary} />{canvasMode ? 'Canvas (libre)' : 'Mode Canvas'}</button>
    </div>
  )
  if (canvasMode) return (
    <>
      {toolbar}
      <div style={{ position: 'relative', minHeight: '160vh', width: '100%' }}>
        {blocks.map(([id, node]) => <DraggableBlock key={id} id={id} canvas={canvas} setPos={setPos}>{node}</DraggableBlock>)}
      </div>
    </>
  )
  return (
    <>
      {toolbar}
      {blocks.map(([id, node]) => <React.Fragment key={id}>{node}</React.Fragment>)}
      <div style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-sm)', fontFamily: FONTS.sans, marginTop: 44, borderTop: `1px solid ${t.border}`, paddingTop: 14 }}>
        ZenRayProgress · {allObjs().length} objectifs · source : Memory/LifeOS/objectives.json
      </div>
    </>
  )
}

export function Overall({ t, value, done, total, theme }) {
  return (
    <div style={{ ...card(t), display: 'flex', gap: 24, alignItems: 'center', flexWrap: 'wrap', marginBottom: 14, boxShadow: SHADOWS.apple }}>
      <div style={{ fontFamily: FONTS.sans, fontSize: 46, fontWeight: 700, minWidth: 110, background: PALETTE.gradient, WebkitBackgroundClip: 'text', backgroundClip: 'text', color: 'transparent' }}>{pc(value)}%</div>
      <div style={{ flex: 1, minWidth: 220 }}>
        <Bar t={t} value={value} />
        <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary, marginTop: 9 }}>{done} / {total} étapes franchies</div>
      </div>
      {theme && <div style={{ flexBasis: '100%', fontFamily: FONTS.serif, fontSize: 'var(--zr-ui-xl)', color: t.textPrimary, borderLeft: `3px solid ${PALETTE.primary}`, paddingLeft: 14, marginTop: 4 }}>{theme}</div>}
    </div>
  )
}

export function Priority({ t, syn }) {
  const tp = syn.top_priority || {}; const cm = syn.choice_menu || {}
  const opts = [{ k: 'x', name: 'X · dur', col: PALETTE.red, o: cm.x }, { k: 'y', name: 'Y · moyen', col: PALETTE.primary, o: cm.y }, { k: 'z', name: 'Z · facile', col: PALETTE.green, o: cm.z }].filter((x) => x.o)
  if (!tp.title) return null
  return (
    <div style={{ ...card(t), border: `1px solid ${PALETTE.primary}`, marginBottom: 16, boxShadow: SHADOWS.glow }}>
      <SectionLabel t={t} color={PALETTE.primary}>Priorité maintenant</SectionLabel>
      <div style={{ fontFamily: FONTS.serif, fontSize: 20, fontWeight: 600 }}>{tp.title}</div>
      <div style={{ color: t.textSecondary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', margin: '4px 0 8px' }}>{tp.domain}</div>
      {tp.why_now && <div style={{ opacity: 0.92, lineHeight: 1.55 }}>{tp.why_now}</div>}
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit,minmax(240px,1fr))', gap: 12, marginTop: 14 }}>
        {opts.map((opt) => (
          <div key={opt.k} style={{ background: t.bg, border: `1px solid ${t.border}`, borderRadius: RADII.md, padding: 14 }}>
            <span style={{ display: 'inline-block', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', fontWeight: 700, letterSpacing: 1, textTransform: 'uppercase', color: opt.col, border: `1px solid ${opt.col}`, borderRadius: 99, padding: '2px 9px', marginBottom: 9 }}>{opt.name} · +{opt.o.advance_pct}%</span>
            <div style={{ fontWeight: 600, marginBottom: 4 }}>{opt.o.label}</div>
            <div style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-md)', lineHeight: 1.5 }}>{opt.o.action}</div>
          </div>
        ))}
      </div>
    </div>
  )
}
