const slugOf = (family) => family.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')

async function fetchRetry(url, options = {}, tries = 4) {
  let lastError
  for (let i = 0; i < tries; i++) {
    try {
      const res = await fetch(url, { ...options, headers: { 'User-Agent': UA, ...(options.headers || {}) } })
      if (res.ok) return res
      lastError = new Error(`HTTP ${res.status}`)
    } catch (err) { lastError = err }
    await new Promise((r) => setTimeout(r, 400 * (i + 1)))
  }
  throw lastError
}

// Découpe la feuille CSS en blocs @font-face et retient ceux dont le commentaire de sous-ensemble
// nous intéresse. Google précède chaque bloc d'un `/* latin */` : c'est la seule façon de savoir
// à quel sous-ensemble appartient un fichier.
function parseFaces(css, wanted) {
  const faces = []
  // Le commentaire de sous-ensemble est FACULTATIF. Piège réel (2026-07-25) : une police CJK
  // renvoie ~124 blocs dont seuls 4 portent une étiquette (`latin`, `latin-ext`, `vietnamese`,
  // `cyrillic`) ; les ~120 blocs japonais n'en ont AUCUNE. Une première version exigeait le
  // commentaire et les sautait tous en silence -- Noto Serif JP « s'installait » en 33 ko, soit
  // uniquement son latin, sans un seul kanji. Un bloc sans étiquette est donc conservé et
  // identifié par son unicode-range.
  const re = /(?:\/\*\s*([a-z0-9-]+)\s*\*\/\s*)?@font-face\s*\{([^}]+)\}/gi
  let m
  while ((m = re.exec(css)) !== null) {
    const body = m[2]
    // Détection SIMPLE et juste : dans une police CJK, Google n'étiquette QUE les sous-ensembles
    // latins ; tout bloc sans commentaire est une tranche d'idéogrammes. Une version précédente
    // cherchait des points de code précis (U+4E00, U+3040) et n'attrapait que 3 tranches sur 120,
    // parce que la plupart des tranches ne contiennent aucun de ces points de code de départ.
    const subset = m[1] || 'cjk'
    if (!wanted.includes(subset)) continue
    const url = /src:\s*url\(([^)]+)\)/.exec(body)?.[1]
    if (!url) continue
    faces.push({
      subset,
      url,
      style: /font-style:\s*([a-z]+)/i.exec(body)?.[1] || 'normal',
      weight: /font-weight:\s*([^;]+)/i.exec(body)?.[1]?.trim() || '400',
      unicodeRange: /unicode-range:\s*([^;]+)/i.exec(body)?.[1]?.trim() || '',
    })
  }
  return faces
}

async function installFamily(entry, { force }) {
  const slug = slugOf(entry.family)
  const dir = path.join(OUT_DIR, slug)
  const subsets = entry.subsets || DEFAULT_SUBSETS
  // Jeux d'axes essayés dans l'ordre, du plus riche au plus pauvre. Google refuse (400) un axe
  // qu'une famille ne possède pas : on retient le premier accepté plutôt que de maintenir à la
  // main la liste des axes de 128 familles.
  // Les familles STATIQUES n'acceptent pas la syntaxe d'axe `100..900` : la requête échoue et on
  // retombait directement sur `400;700`. Le fichier installé ne portait donc QUE du 400, mais
  // était déclaré `font-weight:100 900` — le navigateur rendait du 400 pour toute graisse
  // demandée, sans la moindre erreur. Un titre en 300 sortait en 400 et paraissait « trop gras »
  // sans qu'aucun réglage de graisse n'y change rien. On tente donc la LISTE de graisses avant
  // de se rabattre sur régulier + gras.
  const attempts = entry.axes ? [entry.axes] : ['ital,wght@0,100..900;1,100..900', 'wght@100..900',
    'ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900',
    'wght@100;200;300;400;500;600;700;800;900', 'ital,wght@0,400;0,700;1,400', 'wght@400;700', '']
  let css = null
  for (const axes of attempts) {
    const url = `https://fonts.googleapis.com/css2?family=${encodeURIComponent(entry.family).replace(/%20/g, '+')}${axes ? ':' + axes : ''}&display=block`
    try { css = await fetchRetry(url, {}, 2).then((r) => r.text()); break } catch { /* axe refusé : on tente le suivant */ }
  }
  if (!css) throw new Error('aucun jeu d\'axes accepté')
  const faces = parseFaces(css, subsets)
  if (!faces.length) throw new Error(`aucun sous-ensemble ${subsets.join('/')} trouvé`)

  await mkdir(dir, { recursive: true })
  const files = []
  let bytes = 0
  for (const [i, face] of faces.entries()) {
    const name = `${face.style}-${face.subset}-${i}.woff2`
    const dest = path.join(dir, name)
    if (!force && existsSync(dest)) {
      bytes += (await stat(dest)).size
      files.push({ ...face, file: `/zrm-fonts/${slug}/${name}` })
      continue
    }
    const buf = Buffer.from(await fetchRetry(face.url).then((r) => r.arrayBuffer()))
    await writeFile(dest, buf)
    bytes += buf.length
    files.push({ ...face, file: `/zrm-fonts/${slug}/${name}` })
  }
  return { ...entry, slug, files, bytes }
}

function renderRegistry(installed) {
  const lines = installed.map((f) => `  {
    family: ${JSON.stringify(f.family)},
    slug: ${JSON.stringify(f.slug)},
    archetype: ${JSON.stringify(f.archetype)},
    license: ${JSON.stringify(f.license)},
    heavy: ${f.heavy ? 'true' : 'false'},
    bytes: ${f.bytes},
    faces: [
${f.files.map((x) => `      { file: ${JSON.stringify(x.file)}, style: ${JSON.stringify(x.style)}, weight: ${JSON.stringify(x.weight)}, subset: ${JSON.stringify(x.subset)}, unicodeRange: ${JSON.stringify(x.unicodeRange)} },`).join('\n')}
    ],
  },`).join('\n')

  return `// ZenRayMedia — registre des polices (ZM-L4-11). GÉNÉRÉ, ne pas éditer à la main.
// Regénérer : node scripts/zrm-fonts.mjs
//
// Toutes les familles sont sous licence libre (OFL 1.1 ou Apache 2.0) : elles peuvent être
// EMBARQUÉES dans un fichier livré à un client, ce qui est exactement ce dont une page compilée
// autonome a besoin. Les fichiers sont des WOFF2 découpés par sous-ensemble Unicode, servis
// depuis /zrm-fonts/ pour l'aperçu et inlinés en base64 à l'export.
//
// Les trois familles Anthropic (AnthropicSerif, AnthropicSans, AnthropicMono) restent
// disponibles en plus, via /fonts/ : elles ne sont pas dans ce registre parce qu'elles ne sont
// pas redistribuables sous licence libre. Un thème destiné à un client utilise celles d'ici.

export const FONTS = [
${lines}
]

export const FONTS_BY_FAMILY = Object.fromEntries(FONTS.map((f) => [f.family, f]))

/** Familles d'un archétype typographique (labeur · grotesque · condense · didone · mono · cjk). */
export function fontsOfArchetype(archetype) {
  return FONTS.filter((f) => f.archetype === archetype)
}

