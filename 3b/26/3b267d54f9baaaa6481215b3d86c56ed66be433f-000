#!/usr/bin/env node
// ZenRayMedia — installateur de polices Google Fonts.
//
//   node scripts/zrm-fonts.mjs            # installe tout ce qui manque
//   node scripts/zrm-fonts.mjs --force    # retélécharge tout
//   node scripts/zrm-fonts.mjs --list     # affiche le catalogue sans rien télécharger
//   node scripts/zrm-fonts.mjs --cjk      # ajoute les familles japonaises (~12 Mo, voir plus bas)
//
// POURQUOI LE JAPONAIS EST HORS DU DÉFAUT (mesuré, pas supposé) : une famille CJK arrive en
// 121 tranches Unicode -- Noto Serif JP pèse 6,8 Mo, Noto Sans JP 5,0 Mo. Douze mégaoctets dans
// `public/` pour une famille de thèmes dont AUCUN n'est encore construit, c'est du poids de
// déploiement payé pour rien. Les 13 familles latines (2,1 Mo) servent 15 familles de thèmes sur
// 16 et sont installées par défaut. Le jour où un thème japonais existe : `--cjk`, et les 12 Mo
// se justifient. En attendant, `fontStack()` retombe sur Hiragino Mincho, présent sur tout Mac.
//
// POURQUOI L'API CSS ET PAS LE DÉPÔT GITHUB (décision, pas préférence) :
// `github.com/google/fonts` sert des TTF complets — Playfair Display y pèse 300 ko. L'API CSS,
// elle, sert des **WOFF2 déjà découpés par sous-ensemble Unicode** : le même Playfair en latin
// tombe à 38 ko, soit 8 fois moins. Comme chaque page compilée embarque ses polices en base64
// (sinon elle n'est pas autonome), ce facteur 8 est la différence entre un export de 200 ko et
// un export de 1,6 Mo. Aucun outil local n'est requis : ni fontTools, ni brotli, ni woff2.
//
// LICENCES : toutes les familles listées ici sont sous SIL Open Font License ou Apache 2.0,
// donc redistribuables — y compris à l'intérieur d'un fichier HTML livré à un client. C'est ce
// que réclamait ZM-L4-11. La licence de chaque famille est écrite dans le registre généré.

import { writeFile, readFile, mkdir, readdir, stat } from 'node:fs/promises'
