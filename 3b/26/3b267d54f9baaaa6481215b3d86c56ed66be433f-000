  cjk: '"Hiragino Mincho ProN", "Yu Mincho", "Noto Serif CJK JP", serif',
}

// Archétype d'une famille CONNUE mais non installée (les japonaises sont hors du défaut).
// Sans cette table, fontStack('Noto Serif JP') retombait sur sans-serif : un texte japonais
// se serait affiché en police latine générique au lieu d'un mincho système. Bug évité 2026-07-25.
// (Aucun accent grave dans ce commentaire : il vit DANS un gabarit de chaîne, un backtick y
//  terminerait le gabarit et casserait le générateur -- erreur payée le 2026-07-25.)
const KNOWN_ARCHETYPES = { 'Noto Serif JP': 'cjk', 'Noto Sans JP': 'cjk' }

/** Pile CSS d'une famille, avec ses replis. Rend la famille utilisable même non installée. */
export function fontStack(family) {
  const archetype = FONTS_BY_FAMILY[family]?.archetype || KNOWN_ARCHETYPES[family]
  const fallback = FALLBACKS[archetype] || 'system-ui, sans-serif'
  return \`'\${family}', \${fallback}\`
}

/** Familles connues du catalogue mais absentes du disque (installables par --cjk). */
export function missingFamilies(families) {
  return (families || []).filter((f) => !FONTS_BY_FAMILY[f])
}

/** Les @font-face d'une liste de familles, pour l'aperçu (fichiers servis depuis /zrm-fonts/). */
export function fontFaceCss(families) {
  const wanted = (families || []).map((f) => FONTS_BY_FAMILY[f]).filter(Boolean)
  return wanted.flatMap((entry) => entry.faces.map((face) =>
    \`@font-face{font-family:'\${entry.family}';font-style:\${face.style};font-weight:\${face.weight};font-display:block;src:url('\${face.file}') format('woff2');\${face.unicodeRange ? \`unicode-range:\${face.unicodeRange};\` : ''}}\`
  )).join('\\n')
}

/** Poids total d'un jeu de familles — sert à prévenir avant un export trop lourd. */
export function fontsWeight(families) {
  return (families || []).reduce((n, f) => n + (FONTS_BY_FAMILY[f]?.bytes || 0), 0)
}
`
}

async function readExtras() {
  if (!existsSync(EXTRA_FILE)) return []
  return JSON.parse(await readFile(EXTRA_FILE, 'utf8'))
}

/** Ajoute une famille au fichier d'extras, puis l'installe. Idempotent. */
async function addFamily(family, opts) {
  const extras = await readExtras()
  if (extras.some((e) => e.family === family) || CATALOG.some((e) => e.family === family)) {
    console.log(`${family} est déjà au catalogue.`)
    return extras
  }
  // On vérifie l'existence dans l'index Google AVANT d'écrire : sans ça, une faute de frappe
  // s'installe silencieusement dans le fichier d'extras et échoue à chaque exécution suivante.
  const indexPath = path.join(import.meta.dirname, '..', 'src', 'zenraymedia', 'fonts-index.json')
  if (existsSync(indexPath)) {
    const idx = JSON.parse(await readFile(indexPath, 'utf8'))
    const hit = idx.families.find((f) => f.family.toLowerCase() === family.toLowerCase())
    if (!hit) {
      const first = family.toLowerCase().split(/\s+/)[0]
      const near = idx.families.filter((f) => f.family.toLowerCase().includes(first)).slice(0, 6)
      throw new Error(`« ${family} » n'existe pas chez Google Fonts.`
        + (near.length ? ` Vouliez-vous : ${near.map((f) => f.family).join(', ')} ?` : '')
        + ` (Google renomme des familles : Source Sans Pro est devenue Source Sans 3.)`)
    }
    family = hit.family // casse officielle
    opts = { ...opts, archetype: opts.archetype || hit.archetype }
  }
  const entry = { family, archetype: opts.archetype || 'grotesque', license: 'OFL-1.1', addedFor: opts.addedFor || null }
  extras.push(entry)
  await writeFile(EXTRA_FILE, JSON.stringify(extras, null, 2) + '\n', 'utf8')
  console.log(`Ajoutée : ${family} (${entry.archetype})`)
  return extras
}

async function main() {
  const args = process.argv.slice(2)
  const force = args.includes('--force')
  const withCjk = args.includes('--cjk')
  const argOf = (n) => { const i = args.indexOf(`--${n}`); return i >= 0 ? args[i + 1] : null }

  if (args.includes('--add')) {
    const fam = argOf('add')
    if (!fam) throw new Error('usage : node scripts/zrm-fonts.mjs --add "Nom De Famille" [--for T-04-1-1]')
    await addFamily(fam, { addedFor: argOf('for') })
  }
  const EXTRAS = await readExtras()

  if (args.includes('--list')) {
    for (const e of [...CATALOG, ...await readExtras()]) console.log(`${e.archetype.padEnd(10)} ${e.family.padEnd(20)} ${e.license}${e.heavy ? '  (lourde)' : ''}`)
    console.log(`\n${CATALOG.length} familles`)
    return
  }

  await mkdir(OUT_DIR, { recursive: true })
  const installed = []
  let failed = 0
  for (const entry of [...CATALOG, ...EXTRAS]) {
    if (entry.archetype === 'cjk' && !withCjk) {
      console.log(`  skip ${entry.family.padEnd(20)} (japonais, ~6 Mo — ajouter avec --cjk)`)
      continue
    }
    try {
      const res = await installFamily(entry, { force })
      installed.push(res)
      console.log(`  ok  ${entry.family.padEnd(20)} ${String(res.files.length).padStart(2)} fichier(s)  ${(res.bytes / 1024).toFixed(0).padStart(5)} ko`)
    } catch (err) {
      // Une famille qui échoue ne doit PAS annuler les autres : le registre se régénère avec
      // ce qui est réellement sur le disque, et l'erreur est dite.
      failed++
      console.error(`  ÉCHEC ${entry.family} : ${err.message}`)
    }
  }

  const code = renderRegistry(installed)
  // GARDE-FOU (deux pannes payées le 2026-07-25) : un accent grave égaré dans un commentaire du
  // gabarit termine la chaîne et produit un fichier qui ne compile pas. On refuse d'écrire un
  // registre invalide plutôt que de le découvrir à l'import, trois commandes plus tard.
  try { new Function(code.replace(/^export /gm, '')) }
  catch (err) { throw new Error(`registre généré invalide (${err.message}) — rien n'a été écrit`) }
  await writeFile(REGISTRY, code, 'utf8')
  const total = installed.reduce((n, f) => n + f.bytes, 0)
  console.log(`\n${installed.length} familles installées (${failed} échec(s)) · ${(total / 1024).toFixed(0)} ko · registre écrit dans src/zenraymedia/fonts.js`)
}

main().catch((err) => { console.error(err); process.exit(1) })
