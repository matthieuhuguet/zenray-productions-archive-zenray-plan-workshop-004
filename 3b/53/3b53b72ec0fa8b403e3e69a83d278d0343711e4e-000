// 3 October 2026, 22:12 CEST: every file presentation shares the same two labeled, copyable locations.
import React from 'react'
import { assetsFileLocations } from '../../lib/assetsFileLocations.js'
import LocationPath from './LocationPath.jsx'
export default function FileLocations({ file, project, connected, compact = true }) {
  const locations = assetsFileLocations(file, project, connected)
  return <div className="assets-file-locations" role="group" aria-label={`Emplacements de ${file.name || file.relativePath}`} data-compact={compact} onClick={event => event.stopPropagation()} onDoubleClick={event => event.stopPropagation()}>
    <LocationPath label="Mac" icon="externaldrive" value={locations.local.path} status={locations.local.state} emptyLabel={locations.local.missing} />
    <LocationPath label="Cloud" icon="lock.icloud" value={locations.cloud.path} status={locations.cloud.state} emptyLabel={locations.cloud.missing} />
  </div>
}
