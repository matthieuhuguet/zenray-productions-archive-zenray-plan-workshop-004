import { describe, expect, it } from 'vitest'
import { filterOperationsForColumn, findDatabaseDateColumn, matchesDatabaseFilter, selectDatabaseRows } from './databaseViewModel.js'

const columns = [
  { id: 'name', type: 'text' },
  { id: 'score', type: 'number' },
  { id: 'done', type: 'checkbox' },
]
const rows = [
  { id: 'a', cells: { name: 'Alpha', score: 10, done: false } },
  { id: 'b', cells: { name: 'Beta', score: 2, done: true } },
  { id: 'c', cells: { name: 'Gamma', score: 7, done: true } },
]

describe('database view model', () => {
  it('applies every persisted filter type without mutating rows', () => {
    expect(matchesDatabaseFilter(rows[0], { col: 'name', op: 'contains', val: 'LPH' })).toBe(true)
    expect(matchesDatabaseFilter(rows[0], { col: 'score', op: '>', val: 7 })).toBe(true)
    expect(matchesDatabaseFilter(rows[0], { col: 'done', op: 'false' })).toBe(true)
    expect(matchesDatabaseFilter({ cells: {} }, { col: 'name', op: 'empty' })).toBe(true)

    const selected = selectDatabaseRows({ rows, columns, filters: [{ col: 'done', op: 'true' }], sort: { col: 'score', dir: 'desc' } })
    expect(selected.map((row) => row.id)).toEqual(['c', 'b'])
    expect(rows.map((row) => row.id)).toEqual(['a', 'b', 'c'])
  })

  it('keeps the legacy categorical operation sets for both callers', () => {
    expect(filterOperationsForColumn({ type: 'select' }).map(([value]) => value)).toEqual(['contains', '=', '!=', 'empty'])
    expect(filterOperationsForColumn({ type: 'select' }, { categoricalContains: false }).map(([value]) => value)).toEqual(['=', '!=', 'empty'])
  })

  it('prefers an explicit date column and only infers dates when requested', () => {
    const inferred = { columns: [{ id: 'label', type: 'text' }, { id: 'when', type: 'text' }], rows: [{ cells: { when: '2026-07-15' } }, { cells: { when: '2026-07-16' } }] }
    expect(findDatabaseDateColumn(inferred)).toBeNull()
    expect(findDatabaseDateColumn(inferred, { infer: true })).toBe('when')
    expect(findDatabaseDateColumn({ ...inferred, columns: [{ id: 'real', type: 'date' }, ...inferred.columns] }, { infer: true })).toBe('real')
  })
})
