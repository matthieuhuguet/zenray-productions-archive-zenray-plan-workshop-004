    expect(screen.getByText(/T-01-3-2/)).toBeTruthy()
    // Le mode d'emploi d'ajout des futurs gabarits est visible dans le produit, pas seulement en doc.
    expect(screen.getByText(/T-FF-S-V--slug\.html/)).toBeTruthy()
