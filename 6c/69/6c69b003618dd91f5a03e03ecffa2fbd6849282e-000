// ZenRayMedia — vérification de l'interface réelle (L9).
// Les tests de `zenraymedia.test.js` gardent la logique ; ceux-ci gardent les BOUTONS : un
// produit vendable n'a aucun contrôle mort. Chaque interaction testée ici est une action que
// Matthieu peut faire devant un client.

import React from 'react'
import { describe, it, expect, beforeEach, afterEach, beforeAll, vi } from 'vitest'
import { render, screen, fireEvent, waitFor, cleanup, within } from '@testing-library/react'
import MediaApp from './MediaApp.jsx'

beforeAll(() => {
  // jsdom n'implémente ni ResizeObserver (mise à l'échelle du Stage) ni matchMedia.
  if (!global.ResizeObserver) {
    global.ResizeObserver = class { observe() {} unobserve() {} disconnect() {} }
  }
})

beforeEach(() => {
  localStorage.clear()
  vi.restoreAllMocks()
})

// Sans nettoyage explicite, les rendus s'empilent dans le document et toute requête devient
// ambiguë. Le projet n'a pas de cleanup global : on le pose ici.
afterEach(() => cleanup())

async function mount() {
  const utils = render(<MediaApp />)
  // Deux attentes, pas une : le thème se charge de façon asynchrone (un gabarit HTML est un
  // fichier à part), PUIS la partition se monte. Tant que la partition n'existe pas, rien n'est
  // compilé et les boutons de rendu sont désactivés -- c'est le comportement voulu du produit,
  // donc le test doit attendre le vrai signal « prêt » au lieu de cliquer dans le vide.
  // REFONTE DU 2026-08-04 : le panneau de droite s'ouvre désormais sur « Détails », comme dans un
  // éditeur de widgets, et le formulaire de l'article vit sous l'onglet « Contenu ». Le montage de
  // test ouvre donc successivement les deux onglets dont les tests ont besoin, au lieu de supposer
  // que tout est visible d'emblée. C'est une correction du HARNAIS, pas un contournement : le
  // produit affiche bien ces champs, à un clic d'onglet près.
  // Les thèmes vivent dans la PALETTE depuis le 2026-08-04 ; on y passe pour attendre le signal de
  // chargement, puis on revient aux composants, puis on ouvre le contenu de l'article.
  fireEvent.click(screen.getByRole('button', { name: 'Thèmes' }))
  await waitFor(() => expect(screen.getByRole('button', { name: /Lecture pure/ })).toBeTruthy())
  fireEvent.click(screen.getByRole('button', { name: 'Comp.' }))
  fireEvent.click(screen.getByRole('button', { name: 'Contenu' }))
  await waitFor(() => expect(screen.getByLabelText('Texte du bloc 1')).toBeTruthy())
  return utils
}

// Rouvre l'onglet dont un test a besoin, sans supposer lequel est ouvert.
function onglet(nom) { fireEvent.click(screen.getByRole('button', { name: nom })) }

// AUDIT — feuille blanche par défaut (2026-08-06) : « Lecture pure » (T-01-3-2), le thème qui
// s'ouvre désormais par défaut, ne porte AUCUN composant Lego enregistré par construction (« aucune
// décoration »). Les tests qui exercent spécifiquement la bibliothèque de composants basculent donc
// EXPLICITEMENT vers « Quotidien de référence sobre » (T-01-1-3, le thème le plus riche du
// catalogue), plutôt que de supposer un thème par défaut que la décision de Matthieu a changé.
async function versLeThemeRiche() {
  const recherche = screen.getByPlaceholderText(/Rechercher une action/)
  // « quotidien » seul trouve DEUX thèmes (« … sobre » ET « … saumon », audit économique) : la
  // recherche cible le slug complet du thème visé, jamais un préfixe qui redevient ambigu dès
  // qu'un thème voisin partage le même premier mot.
  fireEvent.change(recherche, { target: { value: 'reference sobre' } })
  const entree = await screen.findByText(/^Thème : Quotidien/)
  fireEvent.click(entree)
  // Le composant du calque n'existe qu'une fois le NOUVEAU thème réellement chargé (asynchrone,
  // un gabarit HTML est un fichier à part) : attendre CE signal-là plutôt qu'un état intermédiaire
  // de la barre de commandes, qui ne prouve rien sur le thème lui-même.
  await waitFor(() => expect(screen.queryByLabelText('Rôle du bloc 1')).toBeTruthy())
}

describe('ZenRayMedia — interface', () => {
  // AUDIT — feuille blanche par défaut (2026-08-06, décision de Matthieu) : remplace l'ancienne
  // porte « jamais un écran vide » par son inverse assumé. Le premier lancement (localStorage vide,
  // garanti par `beforeEach`) doit ouvrir sur un canevas NEUTRE, prêt à composer, jamais sur le
  // pitch produit qui y vivait jusqu'ici — celui-ci reste disponible via « Recharger le brief de
