    fireEvent.change(screen.getByLabelText('Position X'), { target: { value: '444' } })
    await waitFor(() => expect(srcdoc()).toContain('left:444px'))
    expect(screen.getByText('Rétablir l’état hérité')).toBeTruthy()   // le remplacement existe désormais
