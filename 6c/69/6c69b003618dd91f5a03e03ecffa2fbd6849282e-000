  it('« Inverser la sélection » depuis le MENU échange réellement le choisi et le non-choisi', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    const lignes = [...document.querySelectorAll('.zrm-pane-structure .zrm-tree-name')]
      .filter((el) => !el.textContent.startsWith('[')).map((el) => el.closest('[data-hidden]'))
    fireEvent.click(lignes[0])   // sélectionne UNIQUEMENT ce calque, état de départ sans ambiguïté
    const nomAvant = screen.getByLabelText('Nom du calque').value
