// Famille InDesign D3 — chaînage de blocs de texte : ports d'entrée/sortie, curseur de texte
// chargé, liaisons visibles, déchaînage. Chaque bloc garde son propre contenu.
describe('InDesign D3 — chaînage de blocs de texte', () => {
  function lignesDeCalque() {
    return [...document.querySelectorAll('.zrm-pane-structure .zrm-tree-name')]
      .filter((el) => !el.textContent.startsWith('[')).map((el) => el.closest('[data-hidden]'))
  }

  it('les ports n’apparaissent QUE sur un bloc de texte sélectionné, jamais sur une forme', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))
    expect(document.querySelector('.zrm-lay-port')).toBe(null)
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    expect(document.querySelectorAll('.zrm-lay-port')).toHaveLength(2)   // entrée + sortie
  })

  it('cliquer le port de sortie puis un autre bloc texte les CHAÎNE réellement', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    const lignes = lignesDeCalque()
    // La hiérarchie se lit comme le canevas, du PLUS AU PREMIER PLAN : `lignes[0]` est donc le
    // dernier calque posé, celui dont `.zrm-lay-box` sort AUSSI en premier dans le DOM. Le port de
    // sortie lui appartient ; compléter la chaîne exige de cliquer l'AUTRE boîte, `[1]`.
    fireEvent.click(lignes[0])
    const sortie = document.querySelector('.zrm-lay-port[data-at="sortie"]')
    fireEvent.pointerDown(sortie, { button: 0 })
    fireEvent.pointerDown(document.querySelectorAll('.zrm-lay-box')[1])
    onglet('Détails')
    await waitFor(() => expect(screen.getByText(/Chaîné vers/)).toBeTruthy())
  })

  it('Échap annule un curseur de texte chargé sans rien chaîner', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    const lignes = lignesDeCalque()
    fireEvent.click(lignes[0])
    const sortie = document.querySelector('.zrm-lay-port[data-at="sortie"]')
    fireEvent.pointerDown(sortie, { button: 0 })
    fireEvent.keyDown(document.body, { code: 'Escape' })
    fireEvent.pointerDown(document.querySelector('.zrm-lay-box'))
    onglet('Détails')
    expect(screen.queryByText(/Chaîné vers/)).toBe(null)
  })

  it('un clic sur le VIDE du canevas annule aussi un curseur de texte chargé', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    const lignes = lignesDeCalque()
    fireEvent.click(lignes[0])
    const sortie = document.querySelector('.zrm-lay-port[data-at="sortie"]')
    fireEvent.pointerDown(sortie, { button: 0 })
    fireEvent.pointerDown(document.querySelector('.zrm-stage-body'), { button: 0, clientX: 5, clientY: 5 })
    fireEvent.pointerUp(document.querySelector('.zrm-stage-body'))
    fireEvent.pointerDown(document.querySelector('.zrm-lay-box'))
    onglet('Détails')
    expect(screen.queryByText(/Chaîné vers/)).toBe(null)
  })

  it('« Déchaîner » rompt le lien sans effacer le contenu d’aucun des deux blocs', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    const lignes = lignesDeCalque()
    fireEvent.click(lignes[0])
    const sortie = document.querySelector('.zrm-lay-port[data-at="sortie"]')
    fireEvent.pointerDown(sortie, { button: 0 })
    fireEvent.pointerDown(document.querySelectorAll('.zrm-lay-box')[1])
    onglet('Détails')
    await waitFor(() => expect(screen.getByText('Déchaîner')).toBeTruthy())
    fireEvent.click(screen.getByText('Déchaîner'))
    await waitFor(() => expect(screen.queryByText(/Chaîné vers/)).toBe(null))
    expect(screen.getByLabelText('Contenu du calque').value).toBe('Nouveau texte')
  })

  it('« Afficher les liaisons » dessine une ligne entre deux blocs chaînés', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    const lignes = lignesDeCalque()
    fireEvent.click(lignes[0])
    const sortie = document.querySelector('.zrm-lay-port[data-at="sortie"]')
    fireEvent.pointerDown(sortie, { button: 0 })
    fireEvent.pointerDown(document.querySelectorAll('.zrm-lay-box')[1])
    expect(document.querySelector('.zrm-thread-line-svg')).toBe(null)   // pas affichées par défaut
    fireEvent.click(screen.getByTitle('Afficher les liaisons de texte'))
    expect(document.querySelector('.zrm-thread-line-svg')).toBeTruthy()
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Famille InDesign D4 — styles de texte nommés : une définition partagée, remplacement local
// prioritaire champ par champ, suppression qui ne change rien à l'écran.
describe('InDesign D4 — styles de texte nommés', () => {
  function srcdoc() { return screen.getByTitle('Aperçu ZenRayMedia').srcdoc }

  it('« Ajouter un style de texte » crée une entrée nommée dans la liste', async () => {
    await mount()
    fireEvent.click(screen.getByText('Ajouter un style de texte'))
    await waitFor(() => expect(within(document.querySelector('.zrm-pane-structure')).getByText('Style 1')).toBeTruthy())
  })

  it('régler la DÉFINITION d’un style (son propre panneau) le RÉSOUT réellement sur le calque qui l’applique', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    onglet('Détails')
    fireEvent.click(screen.getByText('Ajouter un style de texte'))
    // Cliquer la LIGNE du style (pas un calque) ouvre son propre panneau, distinct de celui d’un calque.
    fireEvent.click(within(document.querySelector('.zrm-pane-structure')).getByText('Style 1'))
    await waitFor(() => expect(screen.getByLabelText('Nom du style de texte')).toBeTruthy())
    fireEvent.change(screen.getByLabelText('Corps'), { target: { value: '40px' } })

    // Revenir au calque et lui APPLIQUER le style depuis son propre panneau Détails. Nom EXACT
    // « Texte » plutôt qu'un recensement positionnel : la ligne du style partage `.zrm-tree-name`.
    fireEvent.click(within(document.querySelector('.zrm-pane-structure')).getByText('Texte'))
    const styleId = [...screen.getByLabelText('Style de texte').querySelectorAll('option')].find((o) => o.textContent === 'Style 1').value
    fireEvent.change(screen.getByLabelText('Style de texte'), { target: { value: styleId } })
    await waitFor(() => expect(srcdoc()).toContain('font-size:40px'))
  })

  it('modifier la définition du style change TOUS les calques qui l’appliquent ; un remplacement LOCAL n’en affecte qu’un seul', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    onglet('Détails')
    fireEvent.click(screen.getByText('Ajouter un style de texte'))
    fireEvent.click(within(document.querySelector('.zrm-pane-structure')).getByText('Style 1'))
    await waitFor(() => expect(screen.getByLabelText('Nom du style de texte')).toBeTruthy())
    fireEvent.change(screen.getByLabelText('Corps'), { target: { value: '40px' } })

    // Requête par NOM EXACT « Texte » plutôt que par position : les lignes Pages parentes et
    // Styles de texte partagent la même classe `.zrm-tree-name` que les calques (cohérence
    // visuelle voulue), un recensement positionnel les compterait à tort parmi les calques.
    const lignes = within(document.querySelector('.zrm-pane-structure')).getAllByText('Texte')
    fireEvent.click(lignes[0])
    const idDuStyle = [...screen.getByLabelText('Style de texte').querySelectorAll('option')].find((o) => o.textContent === 'Style 1').value
    fireEvent.change(screen.getByLabelText('Style de texte'), { target: { value: idDuStyle } })
    expect(screen.getByLabelText('Corps').value).toBe('40px')   // hérité du style, rien de local encore

    fireEvent.click(lignes[1])
    fireEvent.change(screen.getByLabelText('Style de texte'), { target: { value: idDuStyle } })
    expect(screen.getByLabelText('Corps').value).toBe('40px')   // le MÊME style, la MÊME valeur héritée
    fireEvent.change(screen.getByLabelText('Corps'), { target: { value: '96px' } })   // remplacement LOCAL sur ce calque seul

    await waitFor(() => {
      const tailles = [...srcdoc().matchAll(/font-size:(\d+)px/g)].map((m) => m[1])
      expect(tailles).toEqual(expect.arrayContaining(['40', '96']))
    })
  })

  it('« Effacer les remplacements » efface le « + » et ramène EXACTEMENT au style', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    onglet('Détails')
    fireEvent.click(screen.getByText('Ajouter un style de texte'))
    const styleId = [...screen.getByLabelText('Style de texte').querySelectorAll('option')].find((o) => o.textContent === 'Style 1').value
    fireEvent.change(screen.getByLabelText('Style de texte'), { target: { value: styleId } })
    fireEvent.change(screen.getByLabelText('Corps'), { target: { value: '40px' } })
    fireEvent.change(screen.getByLabelText('Police'), { target: { value: 'AnthropicSerif' } })

    // Régler la DÉFINITION du style à une autre valeur : si le remplacement local est bien effacé,
    // le calque doit ensuite suivre CETTE nouvelle valeur, pas garder l'ancienne figée.
    await waitFor(() => expect(screen.getByTitle('Effacer les remplacements : revenir exactement au style')).toBeTruthy())
    fireEvent.click(screen.getByTitle('Effacer les remplacements : revenir exactement au style'))
    expect(screen.queryByTitle('Effacer les remplacements : revenir exactement au style')).toBe(null)
    expect(screen.getByLabelText('Corps').value).toBe('')   // remplacement effacé : le champ local est vide
  })

  it('supprimer un style ramène le calque à [Aucun] SANS changer son apparence à l’écran', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    onglet('Détails')
    fireEvent.click(screen.getByText('Ajouter un style de texte'))
    const styleId = [...screen.getByLabelText('Style de texte').querySelectorAll('option')].find((o) => o.textContent === 'Style 1').value
    fireEvent.change(screen.getByLabelText('Style de texte'), { target: { value: styleId } })
    fireEvent.change(screen.getByLabelText('Corps'), { target: { value: '40px' } })

    await waitFor(() => expect(srcdoc()).toContain('font-size:40px'))
    fireEvent.click(screen.getByTitle('Supprimer ce style (les calques qui l’appliquent reviennent à [Aucun], sans changer d’apparence)'))
    await waitFor(() => expect(screen.getByLabelText('Style de texte').value).toBe(''))
    // « 40px » vivait dans le remplacement LOCAL du calque, jamais dans le style : la suppression
    // du style ne l'efface pas, l'apparence effective reste identique à l'écran.
    expect(srcdoc()).toContain('font-size:40px')
  })
})

