// ═══════════════════════════════════════════════════════════════════════════════════════════════
// PowerPoint P1 — structure, diapositives et système de conception.
// ═══════════════════════════════════════════════════════════════════════════════════════════════
describe('PowerPoint P1 — diapositives', () => {
  // La feuille de style STATIQUE contient en permanence `[data-shape="ellipse"]` comme sélecteur
  // CSS, qu'un calque forme existe ou non : on isole donc le BALISAGE avant de chercher son absence,
  // même précaution déjà prise pour la carte F6 (`layers.test.js`).
  function balisage() {
    return screen.getByTitle('Aperçu ZenRayMedia').srcdoc.replace(/<style>[\s\S]*?<\/style>/, '')
  }

  it('« Ajouter une diapositive » crée une diapositive et l’affiche dans le panneau', async () => {
    await mount()
    fireEvent.click(screen.getByText('Ajouter une diapositive'))
    await waitFor(() => expect(screen.getByText('Diapositive 1')).toBeTruthy())
  })

  it('un calque posé PENDANT qu’une diapositive est active rejoint cette diapositive, et disparaît si on en active une autre', async () => {
    await mount()
    fireEvent.click(screen.getByText('Ajouter une diapositive'))
    // « Diapositive 1 » nomme ICI À LA FOIS la ligne du panneau Diapositives ET le panneau Détails
    // de la diapositive active (carte InDesign D1, rien d'autre sélectionné) : `getAllByText`.
    await waitFor(() => expect(screen.getAllByText('Diapositive 1')[0]).toBeTruthy())
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))
    await waitFor(() => expect(balisage()).toContain('data-shape'))

    fireEvent.click(screen.getByText('Ajouter une diapositive'))
    await waitFor(() => expect(screen.getAllByText('Diapositive 2')[0]).toBeTruthy())
    // La diapositive 2 est vide et maintenant active : la forme posée sur la 1 ne doit plus apparaître.
    await waitFor(() => expect(balisage()).not.toContain('data-shape'))

    // « Diapositive 1 » nomme À LA FOIS la ligne du panneau Diapositives ET, désormais que son
    // contenu n'est plus vide, le dossier homonyme dans Calques (c'est le MÊME groupe) : le premier
    // exemplaire du DOM est celui du panneau Diapositives, rendu avant la section Calques.
    fireEvent.click(screen.getAllByText('Diapositive 1')[0])
    await waitFor(() => expect(balisage()).toContain('data-shape'))
  })

  it('un calque posé SANS diapositive active reste un masque visible sur toutes les diapositives', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))
    await waitFor(() => expect(balisage()).toContain('data-shape'))
    fireEvent.click(screen.getByText('Ajouter une diapositive'))
    // « Diapositive 1 » nomme ICI À LA FOIS la ligne du panneau Diapositives ET le panneau Détails
    // de la diapositive active elle-même (carte InDesign D1, rien d'autre n'étant sélectionné) :
    // même ambiguïté déjà déclarée pour le dossier Calques homonyme, même remède, `getAllByText`.
    await waitFor(() => expect(screen.getAllByText('Diapositive 1')[0]).toBeTruthy())
    // La forme posée AVANT toute diapositive n'a pas de diapositive : elle reste visible.
    expect(balisage()).toContain('data-shape')
  })

  it('dupliquer une diapositive copie son contenu et devient la diapositive active', async () => {
    await mount()
    fireEvent.click(screen.getByText('Ajouter une diapositive'))
    await waitFor(() => expect(screen.getAllByText('Diapositive 1')[0]).toBeTruthy())
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))
    fireEvent.click(screen.getByTitle('Dupliquer la diapositive'))
    // Le nom du groupe dédié à la copie apparaît à la fois dans le panneau Diapositives et dans
    // Calques (c'est un groupe réel) : on vérifie la présence, pas un exemplaire unique.
    await waitFor(() => expect(screen.getAllByText('Diapositive 1 copie').length).toBeGreaterThan(0))
  })

  it('supprimer une diapositive retire aussi son contenu de l’aperçu', async () => {
    await mount()
    fireEvent.click(screen.getByText('Ajouter une diapositive'))
    await waitFor(() => expect(screen.getAllByText('Diapositive 1')[0]).toBeTruthy())
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))
    await waitFor(() => expect(balisage()).toContain('data-shape'))
    fireEvent.click(screen.getByTitle('Supprimer la diapositive'))
    await waitFor(() => expect(screen.queryByText('Diapositive 1')).toBe(null))
    // L'aperçu est débounced (220 ms) : attendre son rattrapage plutôt qu'une lecture synchrone.
    await waitFor(() => expect(balisage()).not.toContain('data-shape'))
  })
})

