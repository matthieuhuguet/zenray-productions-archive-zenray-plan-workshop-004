    expect(before).toBeGreaterThan(0)

    fireEvent.click(screen.getAllByRole('button', { name: '+' })[0])
    await waitFor(() => {
      const after = screen.getAllByRole('combobox').filter((el) => el.className.includes('zrm-beat-role')).length
      expect(after).toBe(before + 1)
    })

    fireEvent.click(screen.getAllByRole('button', { name: 'Retirer' })[0])
    await waitFor(() => {
      const after = screen.getAllByRole('combobox').filter((el) => el.className.includes('zrm-beat-role')).length
      expect(after).toBe(before)
    })
  })

  it('la Forge ne s’active que sur un format temporel, et donne la commande alpha exacte', async () => {
    await mount()
    fireEvent.click(screen.getByRole('button', { name: 'Forge' }))
    expect(screen.getByText(/La Forge s’active sur un format temporel/)).toBeTruthy()

    fireEvent.change(screen.getByLabelText('Format de sortie'), { target: { value: 'F-overlay-1920x1080' } })
    await waitFor(() => expect(screen.getByText(/prores_ks/)).toBeTruthy())
    expect(screen.getByText(/yuva444p10le/)).toBeTruthy()
    // Le coût disque évité est affiché : c'est la justification du flux direct.
    expect(screen.getByText(/images à 30 i\/s/)).toBeTruthy()
