    fireEvent.change(listeFormat, { target: { value: 'F-still-1080x1920' } })
    await waitFor(() => expect(screen.getByText(/1080 × 1920/)).toBeTruthy())
    fireEvent.change(listeFormat, { target: { value: 'F-web-article' } })
    await waitFor(() => expect(screen.getByText(/820 × libre/)).toBeTruthy())
