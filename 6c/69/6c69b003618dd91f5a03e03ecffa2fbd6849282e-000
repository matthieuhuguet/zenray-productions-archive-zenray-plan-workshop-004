// ═══════════════════════════════════════════════════════════════════════════════════════════════
// AUDIT P2-V1 (première tranche) — une vraie vignette par diapositive, jamais un numéro nu (« les
// diapositives apparaissent comme une liste textuelle, sans vignette », 04-UX-UI-PARCOURS.md).
describe('P2-V1 — vraies vignettes de diapositive', () => {
  // Les deux marqueurs ciblent l'ATTRIBUT posé sur le calque réel, jamais le sélecteur CSS statique
  // qui porte le même nom sans espace devant (`.zrm-layer-shape[data-shape=` / `.zrm-layer-text-
  // host{`) — piège déjà rencontré et documenté pour `data-shape` seul (audit P1-R5, plus haut).
  function contientForme(srcdoc) { return / data-shape="/.test(srcdoc || '') }
  function contientTexte(srcdoc) { return / zrm-layer-text-host"/.test(srcdoc || '') }

  it('chaque vignette montre RÉELLEMENT le contenu de SA diapositive, jamais celui d’une autre', async () => {
    await mount()
    onglet('Détails')
    fireEvent.click(screen.getByText('Ajouter une diapositive'))   // Diapositive 1, active
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))
    fireEvent.click(screen.getByText('Ajouter une diapositive'))   // Diapositive 2, active
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))

    await waitFor(() => expect(document.querySelectorAll('.zrm-slide-thumb iframe')).toHaveLength(2))
    const vignettes = [...document.querySelectorAll('.zrm-slide-thumb iframe')]
    await waitFor(() => {
      expect(contientForme(vignettes[0].getAttribute('srcdoc'))).toBe(true)
      expect(contientTexte(vignettes[0].getAttribute('srcdoc'))).toBe(false)
      expect(contientTexte(vignettes[1].getAttribute('srcdoc'))).toBe(true)
      expect(contientForme(vignettes[1].getAttribute('srcdoc'))).toBe(false)
    })
  })
})
