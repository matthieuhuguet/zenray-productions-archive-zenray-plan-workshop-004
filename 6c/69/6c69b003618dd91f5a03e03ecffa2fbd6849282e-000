      .filter((el) => el.getAttribute('style')?.includes('42px'))
  }

  async function grouperDeuxFormes() {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))
    const lignes = lignesDeCalque()
    fireEvent.click(lignes[0])
    fireEvent.click(lignes[1], { shiftKey: true })
    fireEvent.keyDown(document.body, { code: 'KeyG', metaKey: true })
    await waitFor(() => expect(screen.getByText('Groupe 1')).toBeTruthy())
  }

  it('activer Auto Layout range les deux membres en colonne, écart par défaut de 8px', async () => {
    await grouperDeuxFormes()
    fireEvent.click(screen.getByTitle('Activer Auto Layout (colonne)'))
    // Les deux calques Forme partent à (0,0), hauteur 180 : le second doit tomber à 180+8=188.
    await waitFor(() => expect(screen.getByTitle('Aperçu ZenRayMedia').srcdoc).toContain('top:188px'))
  })

  it('« le parent réagit immédiatement » : agrandir un membre repousse l’autre, sans le toucher', async () => {
    await grouperDeuxFormes()
    fireEvent.click(screen.getByTitle('Activer Auto Layout (colonne)'))
    await waitFor(() => expect(screen.getByTitle('Aperçu ZenRayMedia').srcdoc).toContain('top:188px'))

    // Le calque en TÊTE du flux (le premier placé, celui qui n'a personne devant lui) grandit :
    // c'est lui qui pousse l'autre, jamais l'inverse.
    const membres = lignesMembres()
    fireEvent.click(membres[membres.length - 1])
    fireEvent.change(screen.getByLabelText('Taille Y'), { target: { value: '300' } })
    await waitFor(() => expect(screen.getByTitle('Aperçu ZenRayMedia').srcdoc).toContain('top:308px'))
  })

  it('le bouton de sens bascule ligne/colonne, et disparaît quand Auto Layout est désactivé', async () => {
    await grouperDeuxFormes()
    fireEvent.click(screen.getByTitle('Activer Auto Layout (colonne)'))
    await waitFor(() => expect(screen.getByTitle('Passer en ligne')).toBeTruthy())

    fireEvent.click(screen.getByTitle('Passer en ligne'))
    // En ligne : le second membre suit sur X, pas sur Y. Largeur 320 + écart 8 = 328.
    await waitFor(() => expect(screen.getByTitle('Aperçu ZenRayMedia').srcdoc).toContain('left:328px'))

    fireEvent.click(screen.getByTitle('Désactiver Auto Layout'))
    expect(screen.queryByTitle('Passer en colonne')).toBe(null)
    expect(screen.queryByTitle('Passer en ligne')).toBe(null)
  })
})

