// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Famille Illustrator I2 — l'outil Plume : dessiner un tracé, éditer ses points, régler son contour.
// jsdom ne simule pas fidèlement `getBoundingClientRect`/l'échelle de l'aperçu (limite déjà connue,
// voir S3) : ces tests vérifient donc la STRUCTURE produite (nombre de points, présence d'un `Z` de
// fermeture, le `d` qui change) plutôt que des coordonnées exactes, déjà prouvées par les fonctions
// pures de `layers.test.js`.
describe('Illustrator I2 — outil Plume', () => {
  function outilPlume() { return screen.getByRole('button', { name: /Plume/ }) }
  function canevas() { return document.querySelector('.zrm-stage-body') }
  function traceCompile() {
    const srcdoc = screen.getByTitle('Aperçu ZenRayMedia').srcdoc
    const d = srcdoc.match(/<svg class="zrm-layer-path"[^>]*><path d="([^"]*)"/)
    return { srcdoc, d: d ? d[1] : null }
  }
  function clic(x, y) {
    fireEvent.pointerDown(canevas(), { button: 0, clientX: x, clientY: y })
    fireEvent.pointerUp(canevas())
  }

  it('le bouton Plume est un BASCULE : il s’active et se désactive au clic, jamais une pose immédiate', async () => {
    await mount()
    expect(outilPlume().getAttribute('data-on')).toBe('false')
    fireEvent.click(outilPlume())
    expect(outilPlume().getAttribute('data-on')).toBe('true')
    fireEvent.click(outilPlume())
    expect(outilPlume().getAttribute('data-on')).toBe('false')
  })

  it('trois clics puis Entrée posent réellement un tracé OUVERT à trois points dans la page compilée', async () => {
    await mount()
    fireEvent.click(outilPlume())
    clic(100, 100); clic(250, 140); clic(180, 260)
    fireEvent.keyDown(document.body, { code: 'Enter' })
    await waitFor(() => expect(traceCompile().d).toBeTruthy())
    const { d } = traceCompile()
    expect((d.match(/ C /g) || [])).toHaveLength(2)   // deux segments entre trois points accumulés
    expect(d.trim().endsWith('Z')).toBe(false)         // jamais fermé sans le geste de fermeture
  })

  // Fermer un tracé en cliquant PRÈS DU PREMIER POINT n'est pas vérifié ici : jsdom n'implémente
  // aucun constructeur `PointerEvent` (vérifié empiriquement), donc `event.clientX` d'un
  // pointerDown/pointerUp simulé arrive toujours `undefined` — la comparaison de distance entre
  // deux clics n'a alors plus aucun sens à tester. Ce que cette fermeture produit RÉELLEMENT
  // (le `Z` de `pathD` sur un tracé fermé de plus de deux points, jamais sur deux) est déjà prouvé
  // par les fonctions pures de `layers.test.js` ; ce qu'expose l'interface en est vérifié plus bas
  // par un geste qui, lui, ne dépend d'aucune coordonnée : le bouton « Tracé fermé » du panneau
  // Détails.

  it('Échap annule le point en cours SANS quitter l’outil ; un second Échap, lui, quitte l’outil', async () => {
    await mount()
    fireEvent.click(outilPlume())
    clic(100, 100)
    fireEvent.keyDown(document.body, { code: 'Escape' })
    expect(outilPlume().getAttribute('data-on')).toBe('true')   // trace annulée, outil toujours actif
    fireEvent.keyDown(document.body, { code: 'Escape' })
    expect(outilPlume().getAttribute('data-on')).toBe('false')  // trace déjà vide : ce second Échap quitte
  })


  it('le tracé qu’on vient de poser devient la sélection : ses points d’ancrage sont immédiatement visibles', async () => {
    await mount()
    fireEvent.click(outilPlume())
    clic(100, 100); clic(250, 140); clic(180, 260)
    fireEvent.keyDown(document.body, { code: 'Enter' })
    await waitFor(() => expect(document.querySelectorAll('.zrm-path-anchor[data-point-index]')).toHaveLength(3))
  })

  it('sélectionner un point puis Suppr retire CE point, jamais le calque entier', async () => {
    await mount()
    fireEvent.click(outilPlume())
    clic(100, 100); clic(250, 140); clic(180, 260)
    fireEvent.keyDown(document.body, { code: 'Enter' })
    await waitFor(() => expect(document.querySelectorAll('.zrm-path-anchor[data-point-index]')).toHaveLength(3))
    const ancre1 = document.querySelector('.zrm-path-anchor[data-point-index="1"]')
    fireEvent.pointerDown(ancre1, { button: 0, clientX: 250, clientY: 140 })
    fireEvent.pointerUp(canevas())
    fireEvent.keyDown(document.body, { code: 'Backspace' })
    await waitFor(() => expect(document.querySelectorAll('.zrm-path-anchor[data-point-index]')).toHaveLength(2))
    // L'aperçu compilé est débouncé (220ms, carte L6) : lire `srcdoc` à l'instant même de la
    // frappe attraperait presque toujours la version PRÉCÉDENTE, pas encore rafraîchie.
    await waitFor(() => expect(traceCompile().srcdoc).toContain('zrm-layer-path'))   // le calque tracé existe toujours
  })

  it('double-cliquer une ancre convertit angle ↔ lisse : la courbe compilée change réellement', async () => {
    await mount()
    fireEvent.click(outilPlume())
    clic(100, 100); clic(250, 140); clic(180, 260)
    fireEvent.keyDown(document.body, { code: 'Enter' })
    await waitFor(() => expect(document.querySelectorAll('.zrm-path-anchor[data-point-index]')).toHaveLength(3))
    const avant = traceCompile().d
    const ancre1 = document.querySelector('.zrm-path-anchor[data-point-index="1"]')
    fireEvent.doubleClick(ancre1)
    await waitFor(() => expect(traceCompile().d).not.toBe(avant))
  })

  it('double-cliquer LE TRACÉ (pas une ancre) insère un point de plus sur la courbe', async () => {
    await mount()
    fireEvent.click(outilPlume())
    clic(100, 100); clic(300, 100)
    fireEvent.keyDown(document.body, { code: 'Enter' })
    await waitFor(() => expect(traceCompile().d).toBeTruthy())
    expect((traceCompile().d.match(/ C /g) || [])).toHaveLength(1)
    const traitCliquable = document.querySelector('.zrm-path-hit')
    fireEvent.doubleClick(traitCliquable, { clientX: 200, clientY: 100 })
    await waitFor(() => expect((traceCompile().d.match(/ C /g) || [])).toHaveLength(2))
  })

  it('le panneau Détails règle la couleur, l’épaisseur et l’ouverture du contour, et cela compile réellement', async () => {
    await mount()
    fireEvent.click(outilPlume())
    clic(100, 100); clic(250, 140); clic(180, 260)
    fireEvent.keyDown(document.body, { code: 'Enter' })
    await waitFor(() => expect(screen.getByLabelText('Couleur du contour du tracé')).toBeTruthy())

    fireEvent.change(screen.getByLabelText('Couleur du contour du tracé'), { target: { value: '#ff00aa' } })
    await waitFor(() => expect(traceCompile().srcdoc).toContain('stroke="#ff00aa"'))

    fireEvent.change(screen.getByLabelText('Épaisseur du contour du tracé'), { target: { value: '6' } })
    await waitFor(() => expect(traceCompile().srcdoc).toContain('stroke-width="6"'))

    expect(screen.getByText('Ouvert')).toBeTruthy()
    fireEvent.click(screen.getByText('Ouvert'))
    await waitFor(() => expect(traceCompile().d.trim().endsWith('Z')).toBe(true))
    expect(screen.getByText('Fermé')).toBeTruthy()
  })
})

