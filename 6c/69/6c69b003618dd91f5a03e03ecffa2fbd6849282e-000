// AUDIT P1-R5 · coller retirait TOUJOURS `groupId`, quelle que soit la diapositive active : la
// copie devenait un masque global, visible sur toutes les diapositives, y compris celles qui
// n'avaient rien à voir avec le collage.
describe('P1-R5 — le collage rejoint la diapositive active, jamais un masque global', () => {
  function srcdoc() { return screen.getByTitle('Aperçu ZenRayMedia').srcdoc }

  // Le compteur cible ` data-shape="` (espace devant), jamais le brut `data-shape` : la feuille de
  // style compilée porte aussi deux sélecteurs CSS statiques `[data-shape="ellipse"/"line"]`
  // (compile.js), présents sur CHAQUE document sans espace avant `data-shape` — un `match` naïf les
  // compte comme deux calques fantômes. Seul l'attribut réel posé par `attrForme` a l'espace.
  function nbFormes() { return (srcdoc().match(/ data-shape="/g) || []).length }

  it('coller sur la diapositive 1 laisse la diapositive 2 entièrement vide', async () => {
    await mount()
    onglet('Détails')
    fireEvent.click(screen.getByText('Ajouter une diapositive'))   // Diapositive 1, active
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))
    await waitFor(() => expect(nbFormes()).toBe(1))

    // Portée sur le MENU lui-même : la barre de commandes porte des entrées « Copier… » du même
    // préfixe (« Copier le texte du livrable »), qui mêlerait deux boutons distincts sans elle.
    fireEvent.click(screen.getByRole('button', { name: 'Édition' }))
    fireEvent.click(within(document.querySelector('.zrm-menu-pop')).getByRole('button', { name: /^Copier/ }))
    fireEvent.click(screen.getByRole('button', { name: 'Édition' }))
    fireEvent.click(within(document.querySelector('.zrm-menu-pop')).getByRole('button', { name: /^Coller/ }))
    await waitFor(() => expect(nbFormes()).toBe(2))   // l'original + la copie

    fireEvent.click(screen.getByText('Ajouter une diapositive'))   // Diapositive 2, active
    await waitFor(() => expect(nbFormes()).toBe(0))   // ni l'original ni la copie n'y fuient
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// AUDIT P1-R1 — Transactions de geste : un glisser continu, quel que soit son nombre réel de
// `pointermove`, ne doit produire QU'UNE seule entrée d'historique ; Échap sans relâcher n'en
// produit AUCUNE. jsdom ne porte pas `clientX` sur un geste pointeur simulé (limite déjà connue,
// famille Illustrator I2) : la géométrie résultante n'est donc jamais vérifiable ici. Le test compte
// à la place le nombre d'Annuler nécessaires pour vider la pile — un geste qui empilerait encore une
// entrée par `pointermove` (bug d'origine) en réclamerait bien plus que deux.
describe('P1-R1 — transaction de geste : un glisser vaut une seule entrée d’historique', () => {
  function nomsDeCalques() {
    return [...document.querySelectorAll('.zrm-pane-structure .zrm-tree-name')]
      .filter((el) => !el.textContent.startsWith('[')).map((el) => el.textContent)
  }
  function annulerUneFois() { fireEvent.keyDown(document.body, { code: 'KeyZ', metaKey: true }) }

  it('poser un calque puis le glisser (plusieurs pointermove) ne coûte que deux Annuler pour tout effacer', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))
    await waitFor(() => expect(nomsDeCalques()).toEqual(['Forme']))

    const boite = document.querySelector('.zrm-lay-box')
    const calque = document.querySelector('.zrm-lay-layer')
    fireEvent.pointerDown(boite, { button: 0, clientX: 100, clientY: 100 })
    // Trois `pointermove` pour UN seul geste continu : c'est exactement le cas qui, avant le
    // correctif, empilait trois entrées au lieu d'une.
    fireEvent.pointerMove(calque, { clientX: 110, clientY: 100 })
    fireEvent.pointerMove(calque, { clientX: 120, clientY: 105 })
    fireEvent.pointerMove(calque, { clientX: 130, clientY: 90 })
    fireEvent.pointerUp(calque)
    await waitFor(() => expect(nomsDeCalques()).toEqual(['Forme']))   // le geste n'a pas fait disparaître le calque

    annulerUneFois()   // défait le glisser
    await waitFor(() => expect(nomsDeCalques()).toEqual(['Forme']))   // le calque reste : seule sa géométrie a bougé

    annulerUneFois()   // défait la pose
    await waitFor(() => expect(nomsDeCalques()).toEqual([]))   // DEUX annulations suffisent à tout vider
  })

  it('un simple clic sans glisser (aucun pointermove) n’ajoute aucune entrée', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))
    await waitFor(() => expect(nomsDeCalques()).toEqual(['Forme']))

    const boite = document.querySelector('.zrm-lay-box')
    const calque = document.querySelector('.zrm-lay-layer')
    fireEvent.pointerDown(boite, { button: 0, clientX: 100, clientY: 100 })
    fireEvent.pointerUp(calque)   // relâché immédiat, sans le moindre `pointermove` entre les deux

    annulerUneFois()   // une SEULE annulation doit suffire à tout vider : rien n'a été empilé par le clic
    await waitFor(() => expect(nomsDeCalques()).toEqual([]))
  })

  it('Échap pendant un glisser (relâché jamais reçu) n’empile rien : un seul Annuler efface tout', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))
    await waitFor(() => expect(nomsDeCalques()).toEqual(['Forme']))

    const boite = document.querySelector('.zrm-lay-box')
    const calque = document.querySelector('.zrm-lay-layer')
    fireEvent.pointerDown(boite, { button: 0, clientX: 100, clientY: 100 })
    fireEvent.pointerMove(calque, { clientX: 140, clientY: 60 })
    fireEvent.keyDown(document.body, { code: 'Escape' })   // annule le geste, jamais de `pointerUp`
    await waitFor(() => expect(nomsDeCalques()).toEqual(['Forme']))   // le calque lui-même reste

    annulerUneFois()   // la SEULE entrée restante est la pose elle-même : le geste annulé n'en a posé aucune
    await waitFor(() => expect(nomsDeCalques()).toEqual([]))
  })
})

