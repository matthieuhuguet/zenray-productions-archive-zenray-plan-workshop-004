// AUDIT P1-R4 — Visibilité et verrou effectifs uniques : rendu, boîte, marquee, snapping et clavier
// doivent voir le même ensemble. Ici, les deux divergences les plus directement observables depuis
// l'interface : un calque d'une autre diapositive que la navigation clavier ne doit jamais atteindre,
// et un calque verrouillé par son GROUPE (jamais lui-même) dont les poignées doivent disparaître
// exactement comme si le calque portait lui-même `locked`.
describe('P1-R4 — visibilité et verrou effectifs uniques', () => {
  function lignesDeCalque() {
    return [...document.querySelectorAll('.zrm-pane-structure .zrm-tree-name')]
      .filter((el) => !el.textContent.startsWith('[')).map((el) => el.closest('[data-hidden]'))
  }

  it('la navigation clavier ignore un calque d’une autre diapositive : jamais de saut invisible', async () => {
    await mount()
    onglet('Détails')
    fireEvent.click(screen.getByText('Ajouter une diapositive'))   // Diapositive 1, active
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))    // seul calque de la diapositive 1
    fireEvent.click(screen.getByText('Ajouter une diapositive'))   // Diapositive 2, active
    fireEvent.click(screen.getByTitle('Poser un calque Texte'))    // seul calque de la diapositive 2
    expect(screen.getByLabelText('Nom du calque').value).toBe('Texte')

    // Avant le correctif, l'ordre de navigation restait celui de TOUT le document (`stackOrder`
    // brut) : une flèche bas aurait sauté vers la Forme de la diapositive 1, invisible ici.
    fireEvent.keyDown(document.body, { code: 'ArrowDown' })
    await waitFor(() => expect(screen.getByLabelText('Nom du calque').value).toBe('Texte'))
    fireEvent.keyDown(document.body, { code: 'ArrowUp' })
    await waitFor(() => expect(screen.getByLabelText('Nom du calque').value).toBe('Texte'))
  })

  it('un calque verrouillé par son GROUPE (pas lui-même) perd ses poignées, comme s’il était verrouillé directement', async () => {
    await mount()
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))
    fireEvent.click(screen.getByTitle('Poser un calque Forme'))
    const lignes = lignesDeCalque()
    fireEvent.click(lignes[0])
    fireEvent.click(lignes[1], { shiftKey: true })
    fireEvent.keyDown(document.body, { code: 'KeyG', metaKey: true })
    await waitFor(() => expect(screen.getByText('Groupe 1')).toBeTruthy())

    // Resélectionne UN SEUL membre (via la ligne, jamais la boîte canevas : celle-ci refuse déjà le
    // clic sur un calque effectivement verrouillé, ce qui rendrait ce test circulaire).
    fireEvent.click(lignesDeCalque()[0])
    await waitFor(() => expect(document.querySelector('.zrm-lay-h')).toBeTruthy())   // poignées visibles, rien n'est verrouillé

    fireEvent.click(screen.getByTitle('Verrouiller le groupe'))
    // Le calque lui-même ne porte toujours pas `locked` : seul son GROUPE l'est.
    await waitFor(() => expect(document.querySelector('.zrm-lay-box[data-locked]')).toBeTruthy())
    expect(document.querySelector('.zrm-lay-h')).toBe(null)   // les poignées de redimensionnement disparaissent
    expect(document.querySelector('.zrm-lay-rot')).toBe(null)   // la poignée de rotation aussi
  })
})

