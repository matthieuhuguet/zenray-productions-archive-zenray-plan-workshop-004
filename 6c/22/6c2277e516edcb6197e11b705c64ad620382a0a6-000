// 2026-09-23 18:58 : pure pieces of the journal relay. Run: node --test relay/
import test from 'node:test'
import assert from 'node:assert/strict'
import { sliceSince, originAllowed, sha256 } from './journal-relay.mjs'

test('sliceSince returns the appended bytes only', () => {
  const buf = Buffer.from('abcdef')
  assert.equal(sliceSince(buf, '4').body.toString(), 'ef')
  assert.equal(sliceSince(buf, '6').body.length, 0)
})

test('sliceSince falls back to the whole file when since is absent or incoherent', () => {
  const buf = Buffer.from('abcdef')
  for (const since of [null, '', '-1', '7', 'x', '2.5']) {
    const r = sliceSince(buf, since)
    assert.equal(r.from, 0)
    assert.equal(r.body.toString(), 'abcdef')
  }
})

test('originAllowed accepts the site, its previews and localhost, nothing else', () => {
  assert.ok(originAllowed('https://zenray-progress.pages.dev'))
  assert.ok(originAllowed('https://abc123.zenray-progress.pages.dev'))
  assert.ok(originAllowed('http://localhost:5173'))
  assert.ok(!originAllowed('https://evil.example'))
  assert.ok(!originAllowed('https://zenray-progress.pages.dev.evil.example'))
  assert.ok(!originAllowed(undefined))
})

test('sha256 is stable', () => {
  assert.equal(sha256(Buffer.from('')), 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855')
})
