import { describe, it, expect } from 'vitest'
import { fmt, SPEEDS } from './playerControls.jsx'

describe('fmt', () => {
  it('formate sous l\'heure en m:ss', () => {
    expect(fmt(0)).toBe('0:00')
    expect(fmt(65)).toBe('1:05')
    expect(fmt(3599)).toBe('59:59')
  })
  it('formate au-delà de l\'heure en h:mm:ss (régression corrigée : affichait 125:30 avant)', () => {
    expect(fmt(3600)).toBe('1:00:00')
    expect(fmt(7515)).toBe('2:05:15')
  })
  it('gère les valeurs invalides sans planter', () => {
    expect(fmt(NaN)).toBe('0:00')
    expect(fmt(Infinity)).toBe('0:00')
    expect(fmt(undefined)).toBe('0:00')
    expect(fmt(-5)).toBe('0:00')
  })
})

describe('SPEEDS', () => {
  it('inclut la vitesse normale 1x', () => { expect(SPEEDS).toContain(1) })
})
