// Pont vers /api/stream : lecture par intervalle d'octets, byte-exact.
// L'API borne CHAQUE réponse à 2 Mo (MAX_WINDOW) -> on BOUCLE jusqu'à couvrir [start,end].
// On avance de la longueur RÉELLE reçue, jamais de la valeur demandée : robuste.
const enc = encodeURIComponent
export const streamUrl = (path) => `/api/stream?path=${enc(path)}`

export async function readRange(path, start, end, { signal, onProgress } = {}) {
  const chunks = []
  let pos = start
  const total = end - start + 1
  while (pos <= end) {
    const r = await fetch(streamUrl(path), { headers: { Range: `bytes=${pos}-${end}` }, signal })
    if (r.status !== 206 && r.status !== 200) throw new Error(`range ${r.status}`)
    const buf = new Uint8Array(await r.arrayBuffer())
    if (buf.byteLength === 0) break // garde-fou anti-boucle infinie
    chunks.push(buf)
    pos += buf.byteLength
    if (onProgress) onProgress(Math.min(1, (pos - start) / total))
  }
  const len = chunks.reduce((n, c) => n + c.byteLength, 0)
  const out = new Uint8Array(len)
  let o = 0
  for (const c of chunks) { out.set(c, o); o += c.byteLength }
  chunks.length = 0 // libère la RAM immédiatement (review: éviter la double copie)
  return out
}
