// 12 October 2026 17:25 CEST: explicit search, documented references and a local lesson cooker.
import React, { useEffect, useMemo, useRef, useState } from 'react'
import { urlLectureAffichage } from '../lib/urlLecture.js'
import { CORPUS_CONFIG, createCorpusClient, createLatestRequest, filterCorpusCards, cookCorpusLesson, corpusLessonValidationIssue, originalExamples } from './japaneseCorpusModel.js'
import './JapaneseCorpus.css'

export async function readCorpusJson(path) {
  const response = await fetch(urlLectureAffichage(path), { cache: 'no-cache' })
  if (!response.ok) throw new Error(`Lecture impossible (${response.status}). Réessayer.`)
  const payload = await response.json()
  if (payload?.missing || typeof payload?.markdown !== 'string') throw new Error('Fichier du corpus indisponible. Réessayer.')
  return JSON.parse(payload.markdown)
}
const defaultClient = createCorpusClient(readCorpusJson)
const domainLabels = { grammar: 'Grammaire', dictionary: 'Dictionnaire', kanji: 'Kanji', sentence: 'Phrases', methodology: 'Méthode', curriculum: 'Parcours', pragmatics: 'Situations', geography: 'Géographie', seasons: 'Saisons', religion: 'Religions', 'daily-life': 'Vie quotidienne', food: 'Repas', transport: 'Transports', society: 'Société', history: 'Histoire', administration: 'Administration', safety: 'Sécurité' }
const glossLabels = { eng: 'anglais', fre: 'français', fra: 'français', ger: 'allemand', dut: 'néerlandais', rus: 'russe', spa: 'espagnol', por: 'portugais', hun: 'hongrois', swe: 'suédois', slv: 'slovène' }
const today = () => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' }).format(new Date())

export function CorpusStroke({ path }) {
  const [url, setUrl] = useState('')
  const [error, setError] = useState('')
  const [attempt, setAttempt] = useState(0)
  useEffect(() => {
    let alive = true
    let objectUrl = ''
    setUrl(''); setError('')
    fetch(urlLectureAffichage(path), { cache: 'no-cache' }).then(async (response) => {
      if (!response.ok) throw new Error(`Tracé indisponible (${response.status}).`)
      const payload = await response.json()
      if (payload.missing || !payload.markdown?.includes('<svg')) throw new Error('Tracé absent ou invalide.')
      // 12 October 2026 17:35 CEST: SVG is an image resource, never injected into the page DOM.
      objectUrl = URL.createObjectURL(new Blob([payload.markdown], { type: 'image/svg+xml' }))
      if (alive) setUrl(objectUrl); else URL.revokeObjectURL(objectUrl)
    }).catch((failure) => alive && setError(failure.message))
    return () => { alive = false; if (objectUrl) URL.revokeObjectURL(objectUrl) }
  }, [path, attempt])
  return <div className="jpc-stroke">{url && <img src={url} alt="Tracé et numéros des traits du kanji" onError={() => setError('Image du tracé illisible.')} />}
    {!url && !error && <p>Chargement du tracé…</p>}
    {error && <p role="alert">{error} <button type="button" onClick={() => setAttempt((value) => value + 1)}>Réessayer</button></p>}
    <p>Tracé : <a href="https://kanjivg.tagaini.net/" target="_blank" rel="noopener noreferrer">KanjiVG</a>, CC BY-SA 3.0, auteurs et contributeurs KanjiVG.</p>
  </div>
}

function CorpusDetails({ record, onAdd, basePath }) {
  return <article className="jpc-detail">
    <header><h2>{record.title}</h2><button type="button" onClick={() => onAdd(record)}>Ajouter à la leçon</button></header>
    {record.lessonValidation?.status !== 'approved' && <p role="note">Brouillon pédagogique : revue adversariale requise. Ces exemples ne sont pas validés pour une leçon.</p>}
    <p className="jpc-meta">{domainLabels[record.domain] || record.domain} · {record.level === 'unclassified' ? 'Niveau non classé' : record.level} · {record.levelEstimated ? 'niveau estimé' : 'référence documentaire'}</p>
    {!!record.glossLanguages?.length && <p>Langue des définitions : {record.glossLanguages.map((language) => glossLabels[language] || language).join(', ')}.</p>}
    <p>{record.explanationFr}</p>
    {record.reading && <p lang="ja">Lecture : {record.reading}</p>}
    {!!record.misc?.strokeCounts?.length && <p>Nombre de traits : {record.misc.strokeCounts.join(', ')}.</p>}
    {!!record.radicals?.length && <p>Radicaux de la source : {record.radicals.map((radical) => `${radical.type} ${radical.value}`).join(', ')}.</p>}
    {record.strokeFile && <CorpusStroke key={record.id} path={`${basePath}/${record.strokeFile}`} />}
    {record.domain === 'kanji' && !record.strokeFile && <p>Tracé absent de cette source.</p>}
    {record.frenchLearnerTrap && <p>Point d’attention : {record.frenchLearnerTrap}</p>}
    {record.freshness?.recheckBeforeUse && <p>Règle ou information variable, vérifiée le {record.freshness.checkedAt}. Vérifier la source avant utilisation.</p>}
    {!!record.examples?.length && <div className="jpc-examples">{record.examples.map((example, index) => <div key={index}>
      <p lang="ja">{example.ja}</p>{example.reading && <p lang="ja">{example.reading}</p>}<p>{example.fr}</p>
    </div>)}</div>}
    {!record.examples?.length && <p>Fiche de référence, aucun exercice original disponible.</p>}
    {!!record.prerequisites?.length && <p>Prérequis : {record.prerequisites.join(', ')}.</p>}
    <h3>Sources et droits</h3>
    <ul>{(record.sources || []).map((source, index) => <li key={`${source.url}-${index}`}>
      <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title || source.publisher || source.url}</a>
      <p>{source.publisher} · {source.license || 'Droits à vérifier'} · vérifié : {source.checkedAt || 'date non fournie'}</p>
      {source.reuse && <p>{source.reuse}</p>}
    </li>)}</ul>
    {record.reviewScope && <p className="jpc-meta">{record.reviewScope}</p>}
  </article>
}

export default function JapaneseCorpus({ active = true, client = defaultClient }) {
  const [catalogue, setCatalogue] = useState(null)
  const [loadAttempt, setLoadAttempt] = useState(0)
  const [error, setError] = useState('')
  const [query, setQuery] = useState('')
  const [results, setResults] = useState(null)
  const [busy, setBusy] = useState(false)
  const [domain, setDomain] = useState('')
  const [level, setLevel] = useState('')
  const [page, setPage] = useState(0)
  const [selected, setSelected] = useState(null)
  const [selection, setSelection] = useState([])
  const [script, setScript] = useState('kana')
  const [activity, setActivity] = useState('oral')
  const [lesson, setLesson] = useState(null)
  const [validationIssue, setValidationIssue] = useState('Choisir une fiche validée.')
  const [validating, setValidating] = useState(false)
  const searchRequest = useRef(createLatestRequest())
  const detailRequest = useRef(createLatestRequest())
  const lessonRequest = useRef(createLatestRequest())

  useEffect(() => {
    if (!active || catalogue) return undefined
    let alive = true
    client.getCatalogue().then((head) => {
      if (alive) {
        setCatalogue(head)
        setScript(head.lesson?.script === 'mixed' ? 'mixed' : 'kana')
        setActivity(head.lesson?.mode === 'reading' ? 'reading' : 'oral')
        setError('')
      }
    })
      .catch((failure) => alive && setError(failure.message))
    return () => { alive = false }
  }, [active, catalogue, client, loadAttempt])
  useEffect(() => () => { searchRequest.current.cancel(); detailRequest.current.cancel() }, [])

  // 13 October 2026 00:07 CEST: stale approval checks cannot unlock a newer selection.
  useEffect(() => {
    let alive = true
    lessonRequest.current.cancel()
    setValidating(true); setLesson(null)
    corpusLessonValidationIssue(selection, catalogue?.learner).then((issue) => {
      if (alive) { setValidationIssue(issue); setValidating(false) }
    }).catch(() => { if (alive) { setValidationIssue('Vérification indisponible.'); setValidating(false) } })
    return () => { alive = false }
  }, [selection, catalogue, script, activity])

  const domains = useMemo(() => Object.keys(catalogue?.counts || {}).sort(), [catalogue])
  const levels = useMemo(() => [...new Set((catalogue?.cards || []).map((card) => card.level))].sort(), [catalogue])
  const filteredCards = useMemo(() => filterCorpusCards(results || catalogue?.cards || [], { domain, level }), [results, catalogue, domain, level])
  const pageCount = Math.max(1, Math.ceil(filteredCards.length / CORPUS_CONFIG.resultLimit))
  const visible = filteredCards.slice(page * CORPUS_CONFIG.resultLimit, (page + 1) * CORPUS_CONFIG.resultLimit)
  async function search(event) {
    event.preventDefault()
    const ticket = searchRequest.current.start()
    setBusy(true); setError(''); setSelected(null); setPage(0); detailRequest.current.cancel()
    try {
      const found = await client.search(query, { domain, level })
      if (searchRequest.current.isCurrent(ticket)) setResults(found)
    } catch (failure) { if (searchRequest.current.isCurrent(ticket)) { setError(failure.message); setResults([]) } }
    finally { if (searchRequest.current.isCurrent(ticket)) setBusy(false) }
  }
  async function openRecord(record) {
    const ticket = detailRequest.current.start()
    setSelected(null); setError('')
    try {
      const full = record.explanationFr !== undefined ? record : await client.getRecord(record.id)
      if (detailRequest.current.isCurrent(ticket)) setSelected(full)
    } catch (failure) { if (detailRequest.current.isCurrent(ticket)) setError(failure.message) }
  }
  function addRecord(record) {
    if (selection.some((item) => item.id === record.id)) return
    setSelection([record]); setLesson(null); setError('')
  }
  async function prepareLesson() {
    const ticket = lessonRequest.current.start()
    try {
      const prepared = await cookCorpusLesson(selection, { script, activity, date: today(), learner: catalogue.learner }, { ...CORPUS_CONFIG, lesson: catalogue.lesson || CORPUS_CONFIG.lesson })
      if (lessonRequest.current.isCurrent(ticket)) { setLesson(prepared); setError('') }
    } catch (failure) { if (lessonRequest.current.isCurrent(ticket)) { setLesson(null); setError(failure.message) } }
  }
  async function downloadLesson() {
    const ticket = lessonRequest.current.start()
    const issue = await corpusLessonValidationIssue(selection, catalogue?.learner)
    if (!lessonRequest.current.isCurrent(ticket)) return
    if (!lesson || issue) { setLesson(null); setValidationIssue(issue || 'Préparer une leçon validée.'); return }
    const blob = new Blob([lesson.markdown], { type: 'text/markdown;charset=utf-8' })
    const url = URL.createObjectURL(blob)
    const anchor = document.createElement('a')
    anchor.href = url; anchor.download = 'JapaneseLesson.md'; anchor.click()
    setTimeout(() => URL.revokeObjectURL(url), 1000)
  }
  if (!active) return null
  return <section className="jpc" aria-label="Corpus japonais">
    <h2>Corpus et leçons à la demande</h2>
    <p className="jpc-notice">{catalogue?.notice || 'Chargement du catalogue documentaire…'}</p>
    <p>Les fiches documentaires et les exemples disponibles ne mesurent aucun acquis. Les niveaux de grammaire sont estimés ; aucune liste officielle complète du JLPT n’est revendiquée.</p>
    {error && <div role="alert" className="jpc-error">{error}{!catalogue && <button type="button" onClick={() => setLoadAttempt((value) => value + 1)}>Réessayer</button>}</div>}
    {catalogue && <>
      <p className="jpc-meta"><span className="jpc-number">{Object.values(catalogue.counts).reduce((sum, count) => sum + count, 0).toLocaleString('fr-FR')}</span> références · <span className="jpc-number">{catalogue.cards.length}</span> fiches pédagogiques ou culturelles · version du {catalogue.builtAt}</p>
      {catalogue.learner?.nextRecordId && <p>Suite proposée d’après {catalogue.learner.nextBasis || 'le dernier point consigné'} : <button type="button" onClick={() => openRecord(catalogue.cards.find((card) => card.id === catalogue.learner.nextRecordId) || { id: catalogue.learner.nextRecordId })}>Ouvrir la prochaine fiche</button></p>}
      <form className="jpc-controls" onSubmit={search}>
        <label>Question ou mot<input value={query} onChange={(event) => setQuery(event.target.value)} placeholder="は が, 梅雨, restaurant…" /></label>
        <button type="submit" disabled={busy || !query.trim()}>{busy ? 'Recherche…' : 'Rechercher'}</button>
        <button type="button" onClick={() => { searchRequest.current.cancel(); detailRequest.current.cancel(); setResults(null); setSelected(null); setPage(0); setBusy(false); setQuery(''); setError('') }}>Parcourir les fiches</button>
        <label>Domaine<select aria-label="Domaine" value={domain} onChange={(event) => { searchRequest.current.cancel(); setBusy(false); setPage(0); setDomain(event.target.value); setResults(null) }}><option value="">Tous</option>{domains.map((item) => <option key={item} value={item}>{domainLabels[item] || item}</option>)}</select></label>
        <label>Niveau<select aria-label="Niveau" value={level} onChange={(event) => { searchRequest.current.cancel(); setBusy(false); setPage(0); setLevel(event.target.value); setResults(null) }}><option value="">Tous</option>{[...new Set([...levels, 'unclassified'])].map((item) => <option key={item} value={item}>{item === 'unclassified' ? 'Non classé' : item}</option>)}</select></label>
      </form>
      <p className="jpc-meta">La recherche consulte le dictionnaire, les phrases, les kanji et les fiches. Jusqu’à <span className="jpc-number">{CORPUS_CONFIG.resultLimit}</span> résultats par demande ; préciser les termes pour réduire la sélection.</p>
      {results === null && <nav className="jpc-pagination" aria-label="Pages du catalogue"><button type="button" disabled={page === 0} onClick={() => setPage((value) => value - 1)}>Précédent</button><p><span className="jpc-number">{filteredCards.length}</span> fiches dans la sélection · page <span className="jpc-number">{page + 1}</span> sur <span className="jpc-number">{pageCount}</span></p><button type="button" disabled={page + 1 >= pageCount} onClick={() => setPage((value) => value + 1)}>Suivant</button></nav>}
      <div className="jpc-layout"><div className="jpc-results" aria-live="polite">
        {!busy && !visible.length && <p>Aucune fiche dans cette sélection. Modifier les termes ou les filtres.</p>}
        {visible.map((record) => <button key={record.id} type="button" className="jpc-card" aria-pressed={selected?.id === record.id} onClick={() => openRecord(record)}><span>{record.title}</span><small>{domainLabels[record.domain] || record.domain} · {record.level === 'unclassified' ? 'Non classé' : record.level}</small></button>)}
      </div>{selected && <CorpusDetails record={selected} onAdd={addRecord} basePath={catalogue.basePath} />}</div>
      <section className="jpc-cooker"><h3>Préparer une séance sans LLM</h3>
        <p><span className="jpc-number">{catalogue.lesson?.minutes || CORPUS_CONFIG.lesson.minutes}</span> minutes, retest, un point neuf, drill, puis <span className="jpc-number">{catalogue.lesson?.pauseMinutes || CORPUS_CONFIG.lesson.pauseMinutes}</span> minutes de pause. Choisir une fiche ; jusqu’à trois de ses exemples originaux deviennent des exercices.</p>
        {!!selection.length && <ul>{selection.map((record) => <li key={record.id}>{record.title} <button type="button" onClick={() => { setSelection(selection.filter((item) => item.id !== record.id)); setLesson(null) }}>Retirer</button></li>)}</ul>}
        <div className="jpc-controls"><label>Écriture<select aria-label="Écriture" value={script} onChange={(event) => { setScript(event.target.value); setLesson(null) }}><option value="mixed">Kanji et kana</option><option value="kana">Lecture en kana si disponible</option></select></label>
          <label>Activité<select aria-label="Activité" value={activity} onChange={(event) => { setActivity(event.target.value); setLesson(null) }}><option value="oral">Oral</option><option value="reading">Lecture</option></select></label>
          <button type="button" disabled={!selection.length || validating || !!validationIssue} onClick={prepareLesson}>Préparer la leçon</button>
        </div>
        <p role="status">{validating ? 'Vérification de la validation…' : validationIssue ? `Leçon bloquée : revue adversariale requise. ${validationIssue}` : 'Validation vérifiée : deux relecteurs distincts, contenu inchangé.'}</p>
        {lesson && <><button type="button" disabled={validating || !!validationIssue} onClick={downloadLesson}>Télécharger la leçon Markdown</button><div className="jpc-lesson">
          <h3>Retest</h3><p>Restituer avant d’ouvrir la réponse. Aucun score n’est automatiquement ajouté aux acquis.</p>
          {lesson.retestItems.map((item, index) => <div key={index}><p>{item.fr}</p><details><summary>Réponse du retest</summary><p lang="ja">{item.ja}</p></details></div>)}
          {!lesson.retestItems.length && <p>Retest précédent non évalué. Restituer le point de la dernière séance.</p>}
          {activity === 'oral' && <p>ORAL : n’écris PAS, dis à voix haute.</p>}
          <h3>Neuf</h3>{lesson.records.map((record) => <div key={record.id}><h4>{record.title}</h4>
            {!!originalExamples(record).length && <table><thead><tr><th>Japonais et lecture</th><th>Français</th></tr></thead><tbody>{originalExamples(record).slice(0, CORPUS_CONFIG.lesson.maxDrills).map((example, index) => <tr key={index}><td lang="ja">{script === 'kana' && example.reading ? example.reading : example.ja}</td><td>{example.fr}</td></tr>)}</tbody></table>}
            <p>{record.explanationFr}</p></div>)}
          <h3>Drill</h3>{lesson.referenceOnly && <p>Cette sélection contient uniquement des références, sans exercices originaux.</p>}
          {lesson.exercises.map((exercise, index) => <div key={exercise.recordId}><p><span className="jpc-number">{index + 1}</span>. {activity === 'oral' ? 'Dire à voix haute' : 'Lire et restituer'} : {exercise.prompt}</p><details><summary>Réponse de référence</summary><p lang="ja">{exercise.answer}</p></details></div>)}
          <p>FINI : deux minutes de pause. Les sources et leurs droits sont conservés dans le fichier téléchargé.</p>
        </div></>}
      </section>
    </>}
  </section>
}
