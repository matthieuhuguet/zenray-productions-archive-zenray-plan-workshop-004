// GET /api/cmdlog : renvoie le journal des operations Git/drive (anneau en memoire).
// Lecture seule, pas de token requis. Anonymise par construction (voir cmdlog.js).
import { snapshot } from './cmdlog.js'

export default async function handler(req, res) {
  if (req.method !== 'GET') return res.status(405).json({ error: 'method-not-allowed' })
  return res.status(200).json({ entries: snapshot() })
}
