// SPORT x NOTE DU JOUR : le bloc Sport est réécrit entre deux balises dans la note du jour.
// EN: same file convention as `openTodayNote` in create/Pages.jsx (pages/Calendar/<Month Year>/<D Month Year>.md, no accents).
// The pure parts are tested; the network part never guesses a folder: it asks the live listing (children).
// FR : on ne devine JAMAIS un dossier (règle payée le 2026-08-15) : le résolveur lit la liste réelle.
import { dossierExistant, sansAccents } from '../lib/dossierExistant.js'
import { SPORT } from '../config/sport.js'
import { noteBlock } from './sportPlan.js'

export const MOIS_FR = ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre']

/** Day note title, accent-free like the existing notes: « 12 Octobre 2026 » -> « 12 Octobre 2026 » (month names without accent). */
export function dayParts(dateIso) {
  const [y, m, d] = dateIso.split('-').map(Number)
  return { title: sansAccents(`${d} ${MOIS_FR[m - 1]} ${y}`), month: sansAccents(`${MOIS_FR[m - 1]} ${y}`) }
}

/** Path of the day note given the folders actually known. `paths` = known paths under pages/. */
export function dayNotePath(paths, dateIso) {
  const { title, month } = dayParts(dateIso)
  const racine = dossierExistant(paths, 'pages', SPORT.note.calendarFolder) || `pages/${SPORT.note.calendarFolder}`
  const dossier = dossierExistant(paths, racine, month) || `${racine}/${month}`
  return `${dossier}/${title}.md`
}

/** Inserts or rewrites the Sport block. Never duplicates, never touches the rest of the note. */
export function applyNoteBlock(markdown, title, entries) {
  const { start, end } = SPORT.note
  const base = markdown && markdown.trim() ? markdown : `# ${title}\n\n`
  const i = base.indexOf(start), j = base.indexOf(end)
  const withoutBlock = i >= 0 && j > i ? (base.slice(0, i) + base.slice(j + end.length)).replace(/\n{3,}/g, '\n\n').replace(/\s+$/, '\n') : base
  if (!entries.length) return withoutBlock
  if (i >= 0 && j > i) return base.slice(0, i) + noteBlock(entries) + base.slice(j + end.length)
  return withoutBlock.replace(/\s*$/, '\n\n') + noteBlock(entries) + '\n'
}

async function children(dir) {
  const r = await fetch(`/api/page?action=children&dir=${encodeURIComponent(dir)}`, { cache: 'no-store' }).then((x) => x.json()).catch(() => null)
  if (!r || !Array.isArray(r.entries)) throw new Error(`listing illisible : ${dir}`)
  return r.entries.map((e) => e.path)
}

/** Resolves the day note path from the live listing: pages -> Calendar folder -> month folder. */
export async function resolveDayNotePath(dateIso) {
  const known = await children('pages')
  const racine = dossierExistant(known, 'pages', SPORT.note.calendarFolder)
  const second = racine ? await children(racine) : []
  return dayNotePath([...known, ...second], dateIso)
}

/** Rewrites the Sport block of the day note, with a sha-checked save and a few retries. Returns the path. */
export async function writeDayNote(dateIso, entries, { apiPost, path } = {}) {
  const notePath = path || await resolveDayNotePath(dateIso)
  const { title } = dayParts(dateIso)
  for (let essai = 0; essai < 4; essai += 1) {
    const r = await fetch(`/api/page?action=read&path=${encodeURIComponent(notePath)}`, { cache: 'no-store' }).then((x) => x.json())
    const markdown = r && r.markdown != null && !r.missing ? r.markdown : ''
    const next = applyNoteBlock(markdown, title, entries)
    if (next === markdown) return notePath
    try {
      const res = await apiPost('save', { path: notePath, markdown: next, sha: r && !r.missing ? r.sha || null : null })
      if (!(res && res.conflict)) return notePath   // a conflict answer means someone wrote in between: read again and retry
    } catch (e) { if (essai === 3 || !(e && e.statut === 409)) throw e }
  }
  throw new Error('note du jour : conflit persistant, rien n\'a été écrit')
}
