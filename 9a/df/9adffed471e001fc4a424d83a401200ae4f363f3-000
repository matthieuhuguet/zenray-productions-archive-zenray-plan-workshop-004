import { describe, it, expect } from 'vitest'
import {
  parseTimestamp,
  cleanSubtitleText,
  parseSrt,
  parseVtt,
  parseAss,
  parseSubtitles,
  findActiveCue,
  HORS_NORMES_PLACEHOLDER_SRT,
} from './subtitleParser.js'

describe('subtitleParser', () => {
  it('parses timestamps with comma and colon', () => {
    expect(parseTimestamp('00:01:23,456')).toBeCloseTo(83.456, 3)
    expect(parseTimestamp('01:23.456')).toBeCloseTo(83.456, 3)
    expect(parseTimestamp('01:00:00,000')).toBe(3600)
    expect(parseTimestamp('00:00:00,000')).toBe(0)
  })

  it('cleans subtitle text from HTML and ASS formatting', () => {
    expect(cleanSubtitleText('<i>Bonjour</i> monde')).toBe('Bonjour monde')
    expect(cleanSubtitleText('{\\an8}Texte en haut')).toBe('Texte en haut')
    expect(cleanSubtitleText('<font color="#fff">Sous-titre</font>')).toBe('Sous-titre')
  })

  it('turns ASS escapes into real line breaks instead of printing them (14 October 2026)', () => {
    expect(cleanSubtitleText("That's why Kurosaki and\\N Kuchiki are suffering...")).toBe("That's why Kurosaki and\nKuchiki are suffering...")
    expect(cleanSubtitleText('{\\an8}Premiere\\NSeconde')).toBe('Premiere\nSeconde')
    expect(cleanSubtitleText('mot\\nsuivant')).toBe('mot suivant')
    expect(cleanSubtitleText('10\\hkm')).toBe('10\u00a0km')
    expect(cleanSubtitleText('Trois\\Nlignes\\Nici')).toBe('Trois\nlignes\nici')
  })

  it('RED: a literal backslash N never reaches the cue text of an SRT or an ASS file', () => {
    const srt = '1\n00:00:01,000 --> 00:00:04,000\nand\\N Kuchiki\n'
    expect(parseSrt(srt)[0].text).not.toContain('\\N')
    const ass = 'Dialogue: 0,0:00:01.00,0:00:04.00,Default,,0,0,0,,and\\N Kuchiki'
    expect(parseAss(ass)[0].text).toBe('and\nKuchiki')
  })

  it('parses SRT content into structured cues', () => {
    const srt = `1
00:00:01,000 --> 00:00:04,000
Première ligne

2
00:00:05,500 --> 00:00:09,000
Deuxième ligne
Suite de la deuxième ligne
`
    const cues = parseSrt(srt)
    expect(cues).toHaveLength(2)
    expect(cues[0].start).toBe(1)
    expect(cues[0].end).toBe(4)
    expect(cues[0].text).toBe('Première ligne')
    expect(cues[1].start).toBe(5.5)
    expect(cues[1].end).toBe(9)
    expect(cues[1].text).toContain('Deuxième ligne\nSuite de la deuxième ligne')
  })

  it('parses WebVTT content', () => {
    const vtt = `WEBVTT

1
00:00:02.000 --> 00:00:05.000
Ligne VTT test
`
    const cues = parseVtt(vtt)
    expect(cues).toHaveLength(1)
    expect(cues[0].start).toBe(2)
    expect(cues[0].end).toBe(5)
    expect(cues[0].text).toBe('Ligne VTT test')
  })

  it('parses ASS Dialogue lines', () => {
    const ass = `[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
Dialogue: 0,0:00:01.50,0:00:04.20,Default,,0,0,0,,{\\b1}Dialogue en gras{\\b0}
`
    const cues = parseAss(ass)
    expect(cues).toHaveLength(1)
    expect(cues[0].start).toBeCloseTo(1.5, 2)
    expect(cues[0].end).toBeCloseTo(4.2, 2)
    expect(cues[0].text).toBe('Dialogue en gras')
  })

  it('finds active cue accurately', () => {
    const cues = [
      { id: 1, start: 10, end: 15, text: 'Premier' },
      { id: 2, start: 20, end: 25, text: 'Deuxième' },
    ]
    expect(findActiveCue(cues, 9)).toBeNull()
    expect(findActiveCue(cues, 10)?.text).toBe('Premier')
    expect(findActiveCue(cues, 12.5)?.text).toBe('Premier')
    expect(findActiveCue(cues, 15)?.text).toBe('Premier')
    expect(findActiveCue(cues, 16)).toBeNull()
    expect(findActiveCue(cues, 22)?.text).toBe('Deuxième')
  })

  it('parses Hors Normes placeholder SRT successfully', () => {
    const cues = parseSubtitles(HORS_NORMES_PLACEHOLDER_SRT, 'srt')
    expect(cues.length).toBe(103)
    expect(cues[0].text).toContain('Paris')
    const cueAtTwentyTwo = findActiveCue(cues, 22)
    expect(cueAtTwentyTwo?.text).toContain('Joseph')
    const cueAtMinute = findActiveCue(cues, 61)
    expect(cueAtMinute?.text).toContain('[01:00]')
    const cueAtFiveMinutes = findActiveCue(cues, 301)
    expect(cueAtFiveMinutes?.text).toContain('[05:00]')
  })
})
