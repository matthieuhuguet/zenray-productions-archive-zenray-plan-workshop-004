// Résolution/persistance de la vue courante (Dashboard/Create/Tables/…) dans localStorage.
// Migration unique depuis l'ancienne clé zr:tabs (UI multi-onglets retirée) : lue une seule fois puis
// supprimée immédiatement, pour ne jamais écraser zr:view à un reload ultérieur (régression corrigée
// le 2026-07-16 : zr:tabs n'était jamais supprimé, donc chaque reload revenait à la vue figée dedans).
export function resolveInitialView(storage) {
  try {
    const a = JSON.parse(storage.getItem('zr:tabs'))
    if (Array.isArray(a) && a[0] && a[0].view) { storage.removeItem('zr:tabs'); return a[0].view }
  } catch {}
  try { return storage.getItem('zr:view') || 'board' } catch { return 'board' }
}

export function persistView(storage, view) {
  try { storage.setItem('zr:view', view) } catch {}
}
