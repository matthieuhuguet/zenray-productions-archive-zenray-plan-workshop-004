// 23 October 2026: ZenRay Knowledge index mapping, shared by the engine (Node) and the page (browser).
// One tokenizer for both sides, so a word found by the engine is always found by the search box.
// FR : l'index mapping de ZenRay Knowledge, partagé par le moteur et la page : un seul découpage des mots des deux côtés.

const STOP = new Set(('le la les un une des du de d l au aux et ou en a à est sont ce cet cette ces que qui quoi quel quelle quels quelles ' +
  'pour par sur dans avec sans pas ne plus moins mon ma mes ton ta tes son sa ses nos vos leur leurs je tu il elle on nous vous ils elles ' +
  'me te se y lui c s n j m t qu est-ce estce comment pourquoi combien quand faut faire fait peut peux veux dois doit ça ca cela ' +
  'the a an of to in on for and or is are be it this that what how why when which with from by as at do does can i you my your').split(' '))

/** Lowercase, strip accents and punctuation; Japanese characters are kept as they are. */
export function normalize(text) {
  return String(text || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/[’'`]/g, ' ').replace(/[^\p{L}\p{N}\s.-]/gu, ' ').replace(/\s+/g, ' ').trim()
}

/** Words that carry meaning. Japanese runs are split into overlapping pairs (bigrams) so a part of a word still matches. */
export function tokenize(text, { minLength = 2 } = {}) {
  const out = []
  for (const raw of normalize(text).split(' ')) {
    const word = raw.replace(/^[.-]+|[.-]+$/g, '')
    if (!word || STOP.has(word)) continue
    if (/[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}]/u.test(word)) {
      const chars = [...word]
      if (chars.length === 1) out.push(word)
      for (let i = 0; i + 1 < chars.length; i++) out.push(chars[i] + chars[i + 1])
      continue
    }
    if (word.length >= minLength) out.push(word)
  }
  return out
}

/** Stable key of a question: same words in any order, punctuation and accents ignored. */
export function questionKey(question) {
  return [...new Set(tokenize(question))].sort().join(' ')
}

/** token -> list of entry positions. Question words weigh 3, keywords 2, answer words 1 (stored as [position, weight]). */
export function buildIndexMap(entries, { minLength = 2 } = {}) {
  const map = {}
  entries.forEach((entry, position) => {
    const weights = new Map()
    const add = (text, weight) => { for (const token of tokenize(text, { minLength })) weights.set(token, Math.max(weights.get(token) || 0, weight)) }
    add((entry.a || []).join(' '), 1)
    add((entry.kw || []).join(' '), 2)
    add(entry.d, 2)
    add(entry.q, 3)
    for (const [token, weight] of weights) (map[token] ||= []).push(position, weight)
  })
  return map
}

/**
 * Ranked search. Every query word must match (exactly, or as the start of an indexed word when it has 3 letters or more).
 * Returns positions, best first; an empty query returns [].
 */
export function searchIndex(map, query, { limit = 200, minLength = 2 } = {}) {
  const words = [...new Set(tokenize(query, { minLength }))]
  if (!words.length) return []
  const keys = Object.keys(map)
  let scores = null
  for (const word of words) {
    const found = new Map()
    const matching = word.length >= 3 ? keys.filter((key) => key === word || key.startsWith(word)) : (map[word] ? [word] : [])
    for (const key of matching) {
      const list = map[key], exact = key === word ? 1 : 0.6
      for (let i = 0; i < list.length; i += 2) found.set(list[i], Math.max(found.get(list[i]) || 0, list[i + 1] * exact))
    }
    if (!scores) scores = found
    else { const next = new Map(); for (const [position, score] of scores) if (found.has(position)) next.set(position, score + found.get(position)); scores = next }
    if (!scores.size) return []
  }
  return [...scores].sort((a, b) => b[1] - a[1] || a[0] - b[0]).slice(0, limit).map(([position]) => position)
}
