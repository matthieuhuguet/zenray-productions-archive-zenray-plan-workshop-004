      <div className="jps-grid">{shown.map(card => <button key={card.record.id} className="jps-card" data-stage={card.issue ? 'suspended' : card.missing.length && card.stage === 'new' ? 'locked' : card.stage} aria-pressed={selected?.id === card.record.id} onClick={() => open(card.record)}><span className="jps-card-title">{card.record.title}</span><small>{card.issue ? 'Référence à consulter' : card.missing.length && card.stage === 'new' ? 'Prérequis à consolider' : STAGE_LABELS[card.stage]}</small>{card.progress?.due && card.stage !== 'mastered' ? <small>Révision : {dateTime(card.progress.due)}</small> : null}</button>)}</div>
      {!shown.length && <p>Aucune fiche pour ce filtre. Signale la notion dans « Couverture et lacunes ».</p>}
