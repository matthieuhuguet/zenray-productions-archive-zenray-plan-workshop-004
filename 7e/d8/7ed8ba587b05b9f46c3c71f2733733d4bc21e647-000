// 14 October 2026, 11:30 CEST: WaniKani-inspired oral study inside Learn > Japanese.
import React, { useEffect, useMemo, useRef, useState } from 'react'
import { CORPUS_CONFIG, createCorpusClient, corpusLessonValidationIssue, cookCorpusLesson, originalExamples } from './japaneseCorpusModel.js'
import { readCorpusJson } from './JapaneseCorpus.jsx'
import { createStudyClient } from './japaneseStudyClient.js'
import { STUDY_CONFIG, STAGE_LABELS, studyCardStatus } from './japaneseStudyModel.js'
import learningResources from './data/OfficialLearningResources.json'
import release from './data/JapaneseRelease.json'
import './JapaneseStudy.css'
import JapaneseLessonCategory from './JapaneseLessonCategory.jsx'
import JapaneseNotebook from './JapaneseNotebook.jsx'
const defaultCorpus = createCorpusClient(readCorpusJson), defaultClient = createStudyClient()
const today = () => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' }).format(new Date())
const dateTime = value => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(value))
const eventId = () => crypto.randomUUID()
const numeric = value => Number(value).toLocaleString('fr-FR')

export default function JapaneseStudy({ active = true, client = defaultClient, corpus = defaultCorpus, onCorpus = () => {} }) {
  const [catalogue, setCatalogue] = useState(null), [state, setState] = useState(null), [validation, setValidation] = useState({})
  const [coverage, setCoverage] = useState(null), [coverageError, setCoverageError] = useState('')
  const [error, setError] = useState(''), [attempt, setAttempt] = useState(0), [busy, setBusy] = useState(false)
  const [selected, setSelected] = useState(null), [lesson, setLesson] = useState(null), [review, setReview] = useState(null)
  const [notice, setNotice] = useState(''), [gap, setGap] = useState(''), [filter, setFilter] = useState(''), [tab, setTab] = useState('course')
  // 16 October 2026 14:15 Europe/Paris: a free library and practice never advance spaced mastery.
  const [libraryLevel, setLibraryLevel] = useState(''), [librarySeen, setLibrarySeen] = useState(''), [librarySort, setLibrarySort] = useState('title')
  const [libraryCategory, setLibraryCategory] = useState(''), [favoritesOnly, setFavoritesOnly] = useState(false)
  const [now, setNow] = useState(Date.now()), [pendingEvent, setPendingEvent] = useState(null), [sessionDone, setSessionDone] = useState(0)
  const [reviewQueue, setReviewQueue] = useState([]), [lessonQueue, setLessonQueue] = useState([]), [draftPreferences, setDraftPreferences] = useState({})
  const alive = useRef(true), revision = useRef(0), writing = useRef(false)
  useEffect(() => { alive.current = true; return () => { alive.current = false; revision.current++ } }, [])
  useEffect(() => {
    if (!active) return undefined
    let current = true
    setError('')
    Promise.all([corpus.getCatalogue(), client.load()]).then(async ([head, saved]) => {
      const checks = await Promise.all(head.cards.map(async record => [record.id, await corpusLessonValidationIssue([record], head.learner)
        || (!originalExamples(record).length || originalExamples(record).some(example => !example.reading) ? 'Référence sans exercice oral complet.' : '')]))
      if (current) { setCatalogue(head); setState(previous => previous?.updatedAt > (saved.state.updatedAt || 0) ? previous : saved.state); setValidation(Object.fromEntries(checks)) }
      // 15 October 2026, 10:00 CEST: an unavailable audit does not hide lessons or pretend coverage is zero.
      if (corpus.getCoverage) corpus.getCoverage().then(value => { if (current) { setCoverage(value); setCoverageError('') } })
        .catch(failure => { if (current) { setCoverage(null); setCoverageError(failure.message) } })
    }).catch(failure => current && setError(failure.message))
    const timer = setInterval(() => setNow(Date.now()), 30000)
    return () => { current = false; clearInterval(timer) }
  }, [active, attempt, client, corpus])
  const cards = useMemo(() => (catalogue?.cards || []).map(record => ({ record, ...studyCardStatus(record, state || { progress: {} }, now, catalogue.cards), issue: validation[record.id] ?? 'Vérification en cours.' })), [catalogue, state, now, validation])
  const due = cards.filter(card => card.due && !card.issue).sort((a, b) => ['red', 'orange', 'green'].indexOf(a.stage) - ['red', 'orange', 'green'].indexOf(b.stage) || a.progress.due - b.progress.due)
  const available = cards.filter(card => card.available && !card.issue)
  const count = stage => cards.filter(card => card.stage === stage && !card.issue).length
  const prefs = state?.preferences || STUDY_CONFIG.preferences
  const shown = cards.filter(card => card.record.level === prefs.level && (!filter || card.record.title.toLowerCase().includes(filter.toLowerCase())))
  const libraryCards = cards.filter(card => (!libraryCategory || state.annotations?.[card.record.id]?.category === libraryCategory) && (!favoritesOnly || state.annotations?.[card.record.id]?.favorite) && (!libraryLevel || card.record.level === libraryLevel) && (!filter || card.record.title.toLowerCase().includes(filter.toLowerCase())) && (!librarySeen || (librarySeen === 'seen' ? !!state.progress[card.record.id] : !state.progress[card.record.id]))).sort((a,b) => librarySort === 'recent' ? (b.progress?.reviewedAt || b.progress?.exposedAt || 0) - (a.progress?.reviewedAt || a.progress?.exposedAt || 0) : a.record.title.localeCompare(b.record.title, 'fr'))
  async function save(event) {
    if (writing.current) return false
    writing.current = true; setBusy(true); setError(''); setPendingEvent(event)
    try {
      const saved = await client.save(event)
      if (saved.commit && ['expose', 'review', 'placement'].includes(event.action)) window.dispatchEvent(new CustomEvent('zr:japanese-updated', { detail: { commit: saved.commit, index: saved.index } }))
      if (alive.current) { setState(saved.state); setPendingEvent(null); setNotice(['annotate','note'].includes(event.action) ? 'Enregistré dans Memory : classement ou note personnelle.' : 'Enregistré dans Memory. Les séances rejoignent Japanese1.md.'); setNow(Date.now()) }
      return true
    } catch (failure) { if (alive.current) setError(failure.message); return false }
    finally { writing.current = false; if (alive.current) setBusy(false) }
  }
  async function open(record) {
    const ticket = ++revision.current
    setSelected(record); setLesson(null); setError(''); setNotice('')
    try {
      const prepared = await cookCorpusLesson([record], { learner: catalogue.learner, date: today() })
      if (ticket === revision.current && alive.current) setLesson(prepared)
    } catch (failure) { if (ticket === revision.current) setError(failure.message) }
  }
  function startReview() {
    const queue = due.slice(0, prefs.reviewBatch).map(card => card.record)
    const record = queue[0]
    if (!record) return
    setReviewQueue(queue.slice(1)); setSessionDone(0)
    setSelected(null); setLesson(null); setNotice(''); setError('')
    setReview({ record, index: 0, grades: [], elapsed: [], started: Date.now(), answer: false, expectedReviews: state.progress[record.id].reviews })
  }
  async function grade(value) {
    const grades = [...review.grades, value], elapsed = [...review.elapsed, review.responseMs]
    if (review.index + 1 < originalExamples(review.record).slice(0, CORPUS_CONFIG.lesson.maxDrills).length) {
      setReview({ ...review, index: review.index + 1, grades, elapsed, started: Date.now(), answer: false }); return
    }
    if (review.practice) { setReview(null); setNotice('Entraînement libre FINI. Les dates de révision et les acquis restent inchangés.'); return }
    if (await save({ action: review.placement ? 'placement' : 'review', eventId: eventId(), recordId: review.record.id, expectedReviews: review.expectedReviews, grades, elapsed })) {
      const next = reviewQueue[0]
      setReviewQueue(reviewQueue.slice(1)); setSessionDone(value => value + 1)
      setReview(next ? { record: next, index: 0, grades: [], elapsed: [], started: Date.now(), answer: false, expectedReviews: state.progress[next.id].reviews } : null)
      setNotice(next ? 'Révision enregistrée ; la suivante est prête.' : 'Lot de révisions FINI. Pause de deux minutes.')
    }
  }
  async function enrollSelected() {
    if (await save({ action: 'expose', eventId: eventId(), recordId: selected.id })) {
      const next = lessonQueue[0]
      setLessonQueue(lessonQueue.slice(1))
      if (next) open(next)
      else setNotice('Leçon consignée comme exposition. Retrouve-la dans les révisions dues ; aucun acquis déclaré.')
    }
  }
  async function download() {
    try {
      const refreshed = await cookCorpusLesson([selected], { learner: catalogue.learner, date: today() })
      const url = URL.createObjectURL(new Blob([refreshed.markdown], { type: 'text/markdown;charset=utf-8' }))
      const link = document.createElement('a'); link.href = url; link.download = `${selected.id}.md`; link.click()
      setTimeout(() => URL.revokeObjectURL(url), 1000)
    } catch (failure) { setError(failure.message) }
  }
  if (!state || !catalogue) return <section className="jps" hidden={!active}><h2>Ton parcours japonais</h2><p>{error || 'Chargement du corpus et de tes révisions…'}</p>{error && <button onClick={() => setAttempt(value => value + 1)}>Réessayer</button>}</section>
  const selectedCard = selected && cards.find(card => card.record.id === selected.id)
  const example = review && originalExamples(review.record)[review.index]
  return <section className="jps" hidden={!active} style={{ '--jps-base': `${prefs.scale}px` }} aria-label="Parcours japonais">
    <header className="jps-heading"><div><p className="jps-eyebrow">日本語（にほんご） · ZenRay Japanese</p><h2>Ton parcours japonais</h2><p>Restitue à voix haute, compare, puis consolide au fil des jours.</p></div><button onClick={onCorpus}>Interroger le corpus</button></header>
    <details><summary>Mode d’emploi · version <span className="jps-number">{release.version}</span></summary><ol>{release.guide.map(step => <li key={step}>{step}</li>)}</ol><p>Version publiée le {release.releasedAt}. Les leçons validées restent distinctes d’une couverture complète N5 à N1 et au-delà.</p></details>
    <div className="jps-actions"><button className="jps-action" onClick={startReview} disabled={busy || !due.length || !!review}><span>Révisions dues</span><strong>{numeric(due.length)}</strong><small>Restituer avant d’apprendre</small></button>
      <button className="jps-action jps-new" onClick={() => { setTab('course'); const queue = [...available.filter(card => card.record.level === prefs.level), ...available.filter(card => card.record.level !== prefs.level)].slice(0, prefs.batch).map(card => card.record); setLessonQueue(queue.slice(1)); if (queue[0]) open(queue[0]) }} disabled={busy || !available.length || !!review}><span>Leçons débloquées</span><strong>{numeric(available.length)}</strong><small>Un point neuf par boucle</small></button>
      <div className="jps-action jps-mastered"><span>Acquis dans ce parcours</span><strong>{numeric(count('mastered'))}</strong><small>Exemples restitués à plusieurs jours d’écart</small></div></div>
    <p className="jps-honest">L’historique reste dans les autres onglets. Ces compteurs suivent tes nouvelles restitutions ; ils n’effacent aucun acquis ancien et n’en supposent aucun.</p>
    {error && <div role="alert" className="jps-message">{error}{pendingEvent && <button disabled={busy} onClick={async () => { if (await save(pendingEvent)) setReview(null) }}>Réessayer l’enregistrement</button>}</div>}
    {notice && <p role="status" className="jps-message">{notice}</p>}{busy && <p role="status">Enregistrement dans Memory…</p>}
    <nav className="jps-tabs" aria-label="Outils du parcours">{[['course', 'Parcours'], ['library', 'Toutes les leçons'], ['notes', 'Mon carnet'], ['coverage', 'Couverture et lacunes'], ['settings', 'Réglages']].map(([key, label]) => <button key={key} aria-pressed={tab === key} onClick={() => setTab(key)}>{label}</button>)}</nav>
    <div hidden={tab !== 'notes' || !!review}><JapaneseNotebook notes={state.notes} busy={busy} onSave={save} /></div>
    {review ? <article className="jps-review"><p>{review.record.title} · exercice <span className="jps-number">{review.index + 1}/{originalExamples(review.record).slice(0, CORPUS_CONFIG.lesson.maxDrills).length}</span></p><h3>ORAL : n’écris PAS, dis à voix haute.</h3><p className="jps-prompt">{example.fr}</p>{review.practice && <p>Entraînement libre : aucune modification des dates de révision ni des acquis.</p>}{review.placement && <p>Ce diagnostic porte sur les exemples validés de cette fiche ; il ne certifie pas la maîtrise complète de la notion.</p>}
      {!review.answer ? <button onClick={() => setReview({ ...review, answer: true, responseMs: Date.now() - review.started })}>Comparer ma réponse</button> : <><div className="jps-answer"><p lang="ja">{example.ja}</p><p lang="ja">{example.reading}</p><small>Réponse de référence. D’autres formulations peuvent être justes ; aucun correcteur automatique ne les juge ici.</small></div><p>Évalue ta restitution orale après comparaison.</p><div className="jps-grade"><button disabled={busy} onClick={() => grade('failed')}>Raté ou avec aide</button><button disabled={busy} onClick={() => grade('hesitated')}>Juste, avec hésitation</button><button disabled={busy || review.responseMs > STUDY_CONFIG.srs.fluentMs} onClick={() => grade('fluent')}>Juste, sans aide en moins de cinq secondes</button></div></>}
      <button disabled={busy} onClick={() => { setReview(null); setNotice('Révision interrompue, aucun succès enregistré.') }}>Quitter cette révision</button></article> : <>

    {tab === 'course' && <><div className="jps-levels">{STUDY_CONFIG.levels.map(level => <button key={level} aria-pressed={prefs.level === level} disabled={busy} onClick={() => save({ action: 'preferences', eventId: eventId(), updates: { level } })}>{level === 'beyond-N1' ? 'Au-delà' : level === 'culture' ? 'Japon' : level === 'all' ? 'Méthode' : level}</button>)}</div>
      <label className="jps-filter">Chercher dans ce niveau<input value={filter} onChange={event => setFilter(event.target.value)} placeholder="Une notion, une forme…" /></label>
