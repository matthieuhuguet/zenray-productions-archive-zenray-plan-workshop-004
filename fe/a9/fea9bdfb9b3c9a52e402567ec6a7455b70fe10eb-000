// share-decode.js — miroir SERVEUR (Node) de encodeShare/decodeShare (src/components/ShareVideoPage.jsx).
// base64url <-> chemin. Duplication volontaire (2 lignes) plutôt qu'un import cross-boundary client/serveur.
export const decodeShare = (s) => { try { return decodeURIComponent(escape(Buffer.from(String(s).replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString('binary'))) } catch { return '' } }
