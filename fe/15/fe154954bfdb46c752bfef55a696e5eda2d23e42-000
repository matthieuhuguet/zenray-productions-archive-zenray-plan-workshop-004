// 12 October 2026, 12:45 CEST: the page of one motion, laid out like a YouTube watch page (R06 section 9.4): the player
// on the left (VideoPlayer2 on the published HLS manifest, or the signed local render of the Mac), title and meta line
// (version, duration, fidelity), actions, then tabs Fidelity, Parameters, History; on the right the column of
// versions V_001 to V_999 with their scores, in place of the suggestions. Reads are display reads (out of quota).
// FR : la page d'un motion facon YouTube : lecteur, titre, actions, onglets, colonne des versions.
import React, { useEffect, useMemo, useState } from 'react'
import VideoPlayer2 from '../components/VideoPlayer2.jsx'
import { urlLectureAffichage } from '../lib/urlLecture.js'
import { MOTION } from '../config/motion.js'
import MotionIterationPanel from './MotionIterationPanel.jsx'
import { formatDuration, formatFidelity, parameterCategories, versionRows } from './motionCatalogue.js'

/** A small JSON display read; null when missing or unreadable (the caller says which). */
export async function readCloudJson(path, { fetchImpl = fetch } = {}) {
  const response = await fetchImpl(urlLectureAffichage(path), { cache: 'no-cache' })
  if (!response.ok) throw new Error(`lecture ${response.status}`)
  const result = await response.json()
  if (result.missing || typeof result.markdown !== 'string') return null
  return JSON.parse(result.markdown)
}

function localRows(motion) {
  return (motion?.versions || []).map((v) => ({
    version: v.version, parent: v.parent, note: v.note, fidelity: v.score, weakest: v.weakest, dimensions: v.dimensions,
    render: v.render, poster: v.poster, publishedAt: v.created, changes: {},
  })).sort((a, b) => b.version.localeCompare(a.version))
}

function Dimensions({ row, tr, lang }) {
  const dims = row?.dimensions || {}
  const entries = Object.entries(dims).filter(([, v]) => typeof v === 'number')
  if (!entries.length && row?.fidelity == null) return <p>{tr('motion.page.noParams')}</p>
  return (
    <div className="zrm-dims">
      {row?.fidelity != null && (<><span>score</span><div className="zrm-bar"><span style={{ width: `${Math.min(100, row.fidelity * 100)}%` }} /></div><span className="zrm-num">{formatFidelity(row.fidelity, lang)}</span></>)}
      {entries.map(([k, v]) => (
        <React.Fragment key={k}><span>{k}</span><div className="zrm-bar"><span style={{ width: `${Math.min(100, v * 100)}%` }} /></div><span className="zrm-num">{formatFidelity(v, lang)}</span></React.Fragment>
      ))}
      <span>{tr('motion.page.target')}</span><span /><span className="zrm-num">{formatFidelity(MOTION.fidelityTarget, lang)}</span>
    </div>
  )
}

export default function MotionPage({ t, card, initialVersion, bridge, bridgeUp, tr, lang, onBack, reader = readCloudJson }) {
  const [zmotion, setZmotion] = useState(null)
  const [local, setLocal] = useState(null)
  const [error, setError] = useState(null)
  const [version, setVersion] = useState(initialVersion || card.version)
  const [manifest, setManifest] = useState(null)
  const [tab, setTab] = useState('fidelity')
  const [iterating, setIterating] = useState(false)
  const [refresh, setRefresh] = useState(0)
  const [actionNote, setActionNote] = useState('')

  useEffect(() => {
    let live = true
    setError(null)
    if (card.source === 'cloud' && card.zmotion) {
      reader(card.zmotion).then((z) => { if (live) setZmotion(z) }).catch((e) => { if (live) setError(e.message) })
    } else if (card.source === 'local' && bridge) {
      bridge.motion(card.id, null).then((r) => { if (live) setLocal(r.motion) }).catch((e) => { if (live) setError(e.message) })
    }
    return () => { live = false }
  }, [card.id, card.source, card.zmotion, bridge, reader, refresh])

  const rows = useMemo(() => (card.source === 'cloud' ? versionRows(zmotion) : localRows(local)), [card.source, zmotion, local])
  const row = rows.find((r) => r.version === version) || rows[0] || null

  useEffect(() => {
    let live = true
    setManifest(null)
    if (card.source === 'cloud' && row?.media) reader(row.media).then((m) => { if (live) setManifest(m) }).catch((e) => { if (live) setError(e.message) })
    return () => { live = false }
  }, [card.source, row?.media, reader])

  const parameters = card.source === 'cloud' ? zmotion?.parameters : local?.version === row?.version ? local?.exposed?.categories : null
  const categories = parameterCategories(parameters)
  const runAction = async (fn) => { try { const r = await fn(); setActionNote(JSON.stringify(r).slice(0, 160)) } catch (e) { setActionNote(e.message) } }

  return (
    <div data-testid="motion-page">
      <div className="zrm-actions"><button type="button" className="zrm-btn" onClick={onBack}>{tr('motion.page.back')}</button></div>
      <div className="zrm-watch">
        <div>
          <div className="zrm-player">
            {card.source === 'cloud' && manifest && row?.media && <VideoPlayer2 t={t} path={row.media} manifest={manifest} />}
            {card.source === 'local' && row?.render && <video src={row.render} poster={row.poster || undefined} controls playsInline data-testid="motion-local-video" />}
            {!manifest && !(card.source === 'local' && row?.render) && <div className="zrm-thumb-empty">{error || tr('motion.page.noVideo')}</div>}
          </div>
          <h1 className="zrm-h1 zrm-title">{zmotion?.title || local?.title || card.title}</h1>
          <div className="zrm-meta">
            {row && <span className="zrm-mono">{row.version}</span>}
            {row?.durationSec != null && <span className="zrm-num">{formatDuration(row.durationSec)}</span>}
            {card.durationSec != null && row?.durationSec == null && <span className="zrm-num">{formatDuration(card.durationSec)}</span>}
            {row?.fidelity != null && <span className="zrm-num">{formatFidelity(row.fidelity, lang)}</span>}
            <span><span className="zrm-num">{rows.length}</span> {tr('motion.card.versions')}</span>
          </div>
          <div className="zrm-actions">
            <button type="button" className={`zrm-btn${iterating ? ' is-primary' : ''}`} onClick={() => setIterating((v) => !v)} data-testid="motion-open-iteration">{tr('motion.page.iterate')}</button>
            <button type="button" className="zrm-btn" onClick={() => window.dispatchEvent(new CustomEvent('zr:navigate', { detail: 'assets' }))}>{tr('motion.page.openAssets')}</button>
            {card.source === 'local' && bridgeUp && (
              <>
                <button type="button" className="zrm-btn" onClick={() => runAction(() => bridge.openStudio(card.id, row?.version).then((r) => { window.open(r.studio.url, '_blank', 'noopener'); return r }))}>{tr('motion.montage.studio')}</button>
                <button type="button" className="zrm-btn" onClick={() => runAction(() => bridge.load(card.id, row?.version))}>{tr('motion.montage.load')}</button>
                <button type="button" className="zrm-btn" onClick={() => runAction(() => bridge.unload(card.id, row?.version))}>{tr('motion.montage.unload')}</button>
              </>
            )}
          </div>
          {actionNote && <p className="zrm-mono" data-testid="motion-action-note">{actionNote}</p>}
          {iterating && (
            <MotionIterationPanel motionId={card.source === 'local' ? card.id : (zmotion?.localId || card.id)} baseVersion={row?.version} parameters={parameters}
              bridge={bridge} tr={tr} onVersion={(v) => { setVersion(v); setRefresh((n) => n + 1) }} />
          )}
          <div className="zrm-tabs" role="tablist">
            {['fidelity', 'parameters', 'history'].map((k) => (
              <button key={k} type="button" role="tab" className={`zrm-chip${tab === k ? ' is-on' : ''}`} onClick={() => setTab(k)}>{tr(`motion.page.${k}`)}</button>
            ))}
          </div>
          <div className="zrm-panel">
            {tab === 'fidelity' && <Dimensions row={row?.dimensions ? row : { ...row, dimensions: null }} tr={tr} lang={lang} />}
            {tab === 'parameters' && (Object.keys(categories).length ? (
              <div className="zrm-dims">
                {Object.values(categories).flat().map((p) => (
                  <React.Fragment key={p.key}><span>{p.label}</span><span className="zrm-mono">{p.key}</span><span className="zrm-num">{String(p.value)}</span></React.Fragment>
                ))}
              </div>
            ) : <p>{tr('motion.page.noParams')}</p>)}
            {tab === 'history' && (
              <ol className="zrm-steps">
                {rows.map((r) => <li key={r.version}><span className="zrm-mono">{r.version}</span>{r.parent ? <> ← <span className="zrm-mono">{r.parent}</span></> : null} {r.note}</li>)}
              </ol>
            )}
          </div>
        </div>
        <aside className="zrm-versions" aria-label={tr('motion.page.versions')} data-testid="motion-versions">
          {rows.map((r) => (
            <button key={r.version} type="button" className={`zrm-version${row?.version === r.version ? ' is-on' : ''}`} onClick={() => setVersion(r.version)} data-testid={`motion-version-${r.version}`}>
              <div className="zrm-thumb">{r.poster ? <img src={r.poster} alt="" loading="lazy" /> : <div className="zrm-thumb-empty">{r.version}</div>}</div>
              <div className="zrm-card-body">
                <span className="zrm-mono">{r.version}</span>
                {r.fidelity != null && <span className="zrm-num">{formatFidelity(r.fidelity, lang)}</span>}
                {r.note && <span className="zrm-card-meta">{r.note}</span>}
              </div>
            </button>
          ))}
        </aside>
      </div>
    </div>
  )
}
