// Politique unique des endpoints Documents (/api/tree et /api/doc).
// Ces routes lisent des repos personnels avec un token serveur : une vérification
// côté client ne suffit jamais. Les chemins sensibles restent invisibles dans
// l'arbre ET impossibles à lire directement en connaissant leur nom.

export const DOCUMENT_REPOS = Object.freeze({
  memory: process.env.MEMORY_REPO || 'matthieuhuguet/Memory',
  claude: process.env.CLAUDE_REPO || 'matthieuhuguet/.claude',
})

const SENSITIVE_SEGMENTS = new Set([
  'identity',
  'secret',
  'secrets',
  'credential',
  'credentials',
  'token',
  'tokens',
  'password',
  'passwords',
  'private',
  '.env',
  '.ssh',
  '.gnupg',
])

export function documentRepo(repoKey) {
  const key = String(repoKey || 'memory').trim().toLowerCase()
  return Object.prototype.hasOwnProperty.call(DOCUMENT_REPOS, key)
    ? { key, repo: DOCUMENT_REPOS[key] }
    : null
}

export function normalizeDocumentPath(rawPath) {
  let value = String(rawPath || '').trim()
  if (!value || value.includes('\0') || /[\r\n]/.test(value)) return null

  // Vercel décode normalement query.path une fois. On redécode de façon bornée
  // pour que Identity%252F... ne redevienne pas Identity/... seulement chez GitHub.
  for (let i = 0; i < 2 && value.includes('%'); i += 1) {
    try {
      const decoded = decodeURIComponent(value)
      if (decoded === value) break
      value = decoded
    } catch {
      return null
    }
  }

  value = value.normalize('NFKC').replace(/\\/g, '/')
  if (value.startsWith('/') || value.includes('//')) return null
  const segments = value.split('/')
  if (!segments.length || segments.some((segment) => !segment || segment === '.' || segment === '..')) return null
  return segments.join('/')
}

export function isAllowedDocumentPath(rawPath) {
  const path = normalizeDocumentPath(rawPath)
  if (!path || !path.toLowerCase().endsWith('.md')) return false
  return !path.split('/').some((segment) => {
    const lower = segment.toLowerCase()
    const stem = lower.endsWith('.md') ? lower.slice(0, -3) : lower
    return SENSITIVE_SEGMENTS.has(lower) || SENSITIVE_SEGMENTS.has(stem)
  })
}

export function visibleDocumentPaths(tree = []) {
  return tree
    .filter((entry) => entry && entry.type === 'blob' && isAllowedDocumentPath(entry.path))
    .map((entry) => normalizeDocumentPath(entry.path))
    .sort()
}
