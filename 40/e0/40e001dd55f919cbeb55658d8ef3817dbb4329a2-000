/* 23 October 2026: ZenRay Knowledge, V5 Liquid Glass (zenray-edit/templates/liquid-glass). Every visual value is a token here.
   FR : jetons de la V5 ; titres GT Sectra LCG normal, corps et chiffres Anthropic Serif, interface Inter. */
@font-face { font-family: 'GT Sectra LCG'; src: url('/fonts/GT-Sectra-LCGV-Regular-latin.woff2') format('woff2'); font-weight: 400; font-display: swap; unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122, U+2212; }

.zrk {
  --zrk-titles: 'GT Sectra LCG', var(--zr-police-serif);
  --zrk-list-w: 440px; --zrk-gap: 28px; --zrk-row-pad: 14px; --zrk-date-w: 64px;
  --zrk-row-size: 16px; --zrk-title-size: 28px; --zrk-answer-size: 16px;
  --lg-radius: 26px; --lg-blur: 22px; --lg-sat: 170%; --lg-tint-top: .20; --lg-tint-bottom: .07; --lg-rim: .60; --lg-veil: .46; --zrk-bg-blur: 4px;
  --lg-fill: linear-gradient(180deg, rgb(255 255 255 / var(--lg-tint-top)), rgb(255 255 255 / var(--lg-tint-bottom)));
  --lg-filter: blur(var(--lg-blur)) saturate(var(--lg-sat));
  --lg-edge: inset 0 1px 0 rgb(255 255 255 / var(--lg-rim)), inset 0 0 0 1px rgb(255 255 255 / calc(var(--lg-rim) * .3));
  --zrk-ink: #fff; --zrk-ink-2: rgb(255 255 255 / .74); --zrk-ink-3: rgb(255 255 255 / .54);
  position: relative; isolation: isolate; min-height: calc(100vh - 120px); color: var(--zrk-ink); font-family: var(--zr-police-sans);
  text-shadow: 0 1px 12px rgb(0 0 0 / .28); padding: 28px clamp(16px, 3vw, 44px) 80px; border-radius: 20px; overflow: hidden;
}
/* The photo is a sibling layer of the glass, never its ancestor (SilentBugs1.md). */
.zrk-bg { position: absolute; inset: 0; z-index: -2; background: center / cover no-repeat; filter: blur(var(--zrk-bg-blur)); transform: scale(1.04); }
.zrk-veil { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgb(10 12 16 / calc(var(--lg-veil) * .7)), rgb(10 12 16 / var(--lg-veil))); }
.zrk button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; text-align: left; text-shadow: inherit; }
.zrk .num { font-family: var(--zr-police-serif); font-weight: 400; font-style: normal; }
.zrk-title { font-family: var(--zrk-titles); font-weight: 400; font-style: normal; }
.zrk-body { font-family: var(--zr-police-serif); font-weight: 400; }
.zrk-glass { background: var(--lg-fill); backdrop-filter: var(--lg-filter); -webkit-backdrop-filter: var(--lg-filter); box-shadow: var(--lg-edge), 0 18px 44px rgb(0 0 0 / .18); }

.zrk-wrap { position: relative; max-width: 1180px; margin: 0 auto; }
.zrk-head { width: var(--zrk-list-w); max-width: 100%; margin-bottom: 14px; }
.zrk-search { display: flex; align-items: center; gap: 10px; height: 46px; padding: 0 16px; border-radius: 99px; }
.zrk-search input { flex: 1; min-width: 0; border: 0; background: none; outline: none; color: var(--zrk-ink); font: inherit; font-size: 15px; text-shadow: inherit; }
.zrk-search input::placeholder { color: var(--zrk-ink-3); }
.zrk-ask { padding: 6px 12px; border-radius: 99px; background: rgb(255 255 255 / .9) !important; color: #16171a !important; text-shadow: none !important; font-size: 13px; white-space: nowrap; }
.zrk-meta { color: var(--zrk-ink-3); font-size: 12.5px; margin: 10px 4px 0; }
.zrk-meta.warn { color: #ffd9b8; }
.zrk-run { text-decoration: underline; text-underline-offset: 2px; color: inherit !important; font-size: inherit !important; }

.zrk-list { width: var(--zrk-list-w); max-width: 100%; position: relative; z-index: 2; }
.zrk-row { display: grid; grid-template-columns: var(--zrk-date-w) 1fr; gap: 14px; align-items: baseline; width: 100%; padding: var(--zrk-row-pad); border-radius: 16px; font-size: var(--zrk-row-size); line-height: 1.4; transition: background-color .25s cubic-bezier(.16,1,.3,1); }
.zrk-row:hover:not(.on) { background: rgb(255 255 255 / .07); }
.zrk-row .d { color: var(--zrk-ink-3); font-size: 13px; }
.zrk-row.pending { opacity: .7; }
.zrk-more { margin: 10px var(--zrk-row-pad); color: var(--zrk-ink-2); font-size: 13px; }

.zrk-shape { position: absolute; z-index: 1; pointer-events: none; background: var(--lg-fill); backdrop-filter: var(--lg-filter); -webkit-backdrop-filter: var(--lg-filter); filter: drop-shadow(0 18px 40px rgb(0 0 0 / .18)); transition: top .35s cubic-bezier(.16,1,.3,1), height .35s cubic-bezier(.16,1,.3,1); }
.zrk-rim { position: absolute; z-index: 1; pointer-events: none; overflow: visible; }
.zrk-panel { position: absolute; z-index: 2; padding: calc(var(--zrk-row-pad) + 2px) 34px 34px; transition: top .35s cubic-bezier(.16,1,.3,1); }
.zrk-panel .when { color: var(--zrk-ink-2); font-size: 13px; margin-bottom: 12px; }
.zrk-panel h2 { font-size: var(--zrk-title-size); line-height: 1.2; margin: 0; }
.zrk-panel .a, .zrk-panel .proof, .zrk-panel h2 { overflow-wrap: anywhere; }
.zrk-panel .a { margin-top: 18px; font-size: var(--zrk-answer-size); line-height: 1.65; }
.zrk-panel .a p { margin: 0; } .zrk-panel .a p + p { margin-top: .75em; }
.zrk-panel .proof { margin-top: 20px; color: var(--zrk-ink-3); font-size: 13px; line-height: 1.5; }
.zrk-empty { color: var(--zrk-ink-2); padding: 20px var(--zrk-row-pad); }

@media (max-width: 900px) {
  .zrk-shape, .zrk-rim { display: none; }
  .zrk-head, .zrk-list { width: 100%; }
  .zrk-panel { position: static; margin: 6px 0 14px; border-radius: var(--lg-radius); background: var(--lg-fill); backdrop-filter: var(--lg-filter); -webkit-backdrop-filter: var(--lg-filter); box-shadow: var(--lg-edge); padding: 22px; }
  .zrk-row.on { background: rgb(255 255 255 / .16); }
}
@media (prefers-reduced-motion: reduce) { .zrk-shape, .zrk-panel, .zrk-row { transition: none; } }
