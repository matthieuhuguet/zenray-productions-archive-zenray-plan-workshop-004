import { afterEach, expect, test, vi } from 'vitest'
import { linkCreateAttachment } from './linkCreateAttachment.js'
import { createDropPaths, isCreateMediaPath } from './planAttachments.js'
import { createShareLink, issueShareToken } from '../lib/shareLinks.js'
vi.mock('../lib/shareLinks.js', () => ({ createShareLink: vi.fn(), issueShareToken: vi.fn() }))
afterEach(() => { vi.restoreAllMocks(); vi.clearAllMocks() })
const path = 'pages/Movies/Kamikaze Girls (2004).mkv.media.json'
const manifest = (value) => vi.spyOn(globalThis, 'fetch').mockResolvedValue({ ok: true, json: async () => ({ markdown: JSON.stringify(value) }) })
// Existing movies never enter the binary uploader. (19 October 2026, 01:14 Paris)
test('links a 9 GB movie through the permanent shared viewer with one manifest read', async () => {
  const read = manifest({ type: 'dash', mpd: 'movie.mpd', size: 9347686567, name: 'Kamikaze Girls (2004).mkv' })
  createShareLink.mockResolvedValue({ token: 'signed', url: '/watch?v=signed' })
  const item = await linkCreateAttachment(path, { origin: 'https://site.test' })
  expect(item).toMatchObject({ mode: 'view', source: 'create', size: 9347686567, url: 'https://site.test/watch?v=signed' })
  expect(createShareLink).toHaveBeenCalledWith('video', path, { permanent: true })
  expect(read).toHaveBeenCalledTimes(1)
  expect(read.mock.calls[0][0]).toContain('raw=1')
  expect(issueShareToken).not.toHaveBeenCalled()
})
test('preserves the download route for an existing encrypted audio original', async () => {
  manifest({ type: 'chunked-media', alg: 'AES-GCM', mime: 'audio/mp4', name: 'book.m4a' })
  issueShareToken.mockResolvedValue({ token: 'file-token' })
  expect(await linkCreateAttachment(path, { origin: 'https://site.test' })).toMatchObject({ mode: 'download', url: 'https://site.test/api/attachment-download?share=file-token' })
})
test('refuses a streamed movie download rather than returning a broken original link', async () => {
  manifest({ type: 'dash', mpd: 'movie.mpd' })
  await expect(linkCreateAttachment(path, { mode: 'download' })).rejects.toThrow('shared viewer')
  expect(issueShareToken).not.toHaveBeenCalled()
})
test('parses Create drops, deduplicates paths and rejects traversal', () => {
  expect(createDropPaths(JSON.stringify({ items: [{ path }, { path }, { path: 'pages/../private.media.json' }] }))).toEqual([path])
  expect(createDropPaths(path)).toEqual([path])
  expect(isCreateMediaPath('https://other.test/a.media.json')).toBe(false)
})
