import { describe, it, expect } from 'vitest'
import { readFileSync } from 'node:fs'

// ═══ UN DÉPLACEMENT TROP GROS SE REFUSE, IL NE MEURT PAS EN SILENCE ═════════════════════════════
//
// Le 2026-08-30, Matthieu a vu « Aucun élément créé • inconnu, cause non répertoriée ». La Function
// avait été tuée pour dépassement de sous-requêtes : elle ne répondait rien du tout, et l'interface
// n'avait donc aucun code à expliquer.
//
// Le danger réel n'est pas la limite, c'est le SILENCE : un déplacement partiel de plusieurs
// centaines de fichiers est exactement ce qu'on ne veut pas découvrir après coup.

const SERVEUR = readFileSync('server/page.js', 'utf8')
const CLIENT = readFileSync('src/create/Pages.jsx', 'utf8')

describe('la borne existe et refuse AVANT de toucher quoi que ce soit', () => {
  it('le serveur porte un budget de sous-requêtes explicite', () => {
    expect(SERVEUR).toContain('BUDGET_REECRITURE')
    expect(SERVEUR).toContain('trop-de-fichiers')
  })

  it('le refus arrive AVANT le commit, pas après un déplacement partiel', () => {
    const i = SERVEUR.indexOf('trop-de-fichiers')
    const j = SERVEUR.indexOf('const dual = await Promise.all(movers.map')
    expect(i, 'la borne doit précéder la boucle qui réécrit les fichiers').toBeLessThan(j)
  })

  it('le budget reste sous la limite de la Function, avec de la marge', () => {
    const m = SERVEUR.match(/const BUDGET_REECRITURE = (\d+)/)
    expect(m, 'budget introuvable').toBeTruthy()
    const budget = Number(m[1])
    expect(budget).toBeGreaterThan(0)
    // La Function Pages tolère ~50 sous-requêtes ; il faut garder de quoi écrire le commit.
    expect(budget).toBeLessThan(50)
  })
})

describe('l’échec est DIT à Matthieu, pas seulement au serveur', () => {
  it('l’interface sait expliquer ce code', () => {
    expect(CLIENT).toContain("'trop-de-fichiers'")
  })

  it('le message précis du serveur prime sur l’explication générique', () => {
    // Sans cela, Matthieu lirait « cause non répertoriée » alors que le serveur a écrit une phrase
    // qui dit exactement quoi faire.
    expect(CLIENT).toContain('cause.message || EXPLICATIONS[cause.code]')
  })

  it('le message promet que RIEN n’a été déplacé — c’est ce qui rassure et qui doit rester vrai', () => {
    expect(SERVEUR).toMatch(/RIEN n a été déplacé/)
  })
})
