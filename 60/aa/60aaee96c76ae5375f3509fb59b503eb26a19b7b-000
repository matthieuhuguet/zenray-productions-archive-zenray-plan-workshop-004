// 4 October 2026: what the engine reads (sources and their health), what it cannot read (boards that forbid scraping, as search links),
// and what the letters know about him (the published CV and his latest work). Everything here comes from freelance/engine.json.
// FR : ce que le moteur lit (sources et leur sante), ce qu'il ne peut pas lire (liens de recherche), et ce que les lettres savent de lui.
import React from 'react'
import { relativeTime } from '../../lib/freelanceEngineModel.js'
import { P, SectionTitle, glassStyle } from './ui.jsx'

const STATE = {
  ok: { mark: '●', color: '#3dbb3d', label: 'lue en entier' },
  partial: { mark: '◐', color: '#d68c00', label: 'lue en partie' },
  error: { mark: '●', color: '#eb584f', label: 'en erreur' },
}
const stateOf = (source) => (source.errors && source.errors.length && !source.listed ? STATE.error : source.complete ? STATE.ok : source.partial ? STATE.partial : STATE.error)

// Tenders belong to the other lane only; the open feeds serve both; every studio board and board of games stays in the games lane.
// FR : les appels d'offres sont de l'autre voie ; les flux ouverts servent les deux ; les tableaux de studios restent au jeu video.
const OTHER_ONLY = ['boamp', 'ted']
const BOTH = ['remotive', 'jobicy', 'remoteok', 'arbeitnow']
const inLane = (key, lane) => (lane === 'other' ? OTHER_ONLY.includes(key) || BOTH.includes(key) : !OTHER_ONLY.includes(key))

export default function FreelanceSources({ t, engine, lane = 'games' }) {
  if (!engine) return <p style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>Le moteur n’a pas encore publié son état. La première recherche le crée.</p>
  const sources = (engine.sources || []).filter((source) => inLane(source.key, lane))
  const links = (engine.manualSearches || []).filter((link) => (link.lane || 'games') === lane)
  const boards = [...new Set(links.map((link) => link.board))]
  const cv = engine.cv || {}
  const small = { fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, lineHeight: 1.5 }
  return (
    <div>
      <SectionTitle t={t} title="Sources lues automatiquement" count={sources.length} />
      <div style={{ display: 'grid', gap: 6, marginBottom: 26 }}>
        {sources.map((source) => {
          const state = stateOf(source)
          return (
            <div key={source.key} style={{ display: 'flex', gap: 10, alignItems: 'baseline', fontFamily: P.sans, fontSize: 13 }}>
              <span aria-label={state.label} title={state.label} style={{ color: state.color, minWidth: 14 }}>{state.mark}</span>
              <span style={{ minWidth: 170 }}>{source.label}</span>
              <span style={{ ...small, fontFamily: P.serif, fontWeight: P.numberWeight }}>{source.listed} annonces vues · {source.matched} proches de ton métier{source.added ? ` · ${source.added} nouvelle${source.added > 1 ? 's' : ''}` : ''}</span>
              <span style={{ ...small, marginLeft: 'auto' }}>{relativeTime(source.checkedAt)}</span>
              {source.errors && source.errors.length > 0 && <span style={{ ...small, color: '#eb584f' }} title={source.errors.join('\n')}>{source.errors[0].slice(0, 60)}</span>}
            </div>
          )
        })}
      </div>

      <SectionTitle t={t} title="Recherches à ouvrir toi-même" count={links.length} />
      <p style={{ ...small, margin: '0 0 12px' }}>Ces sites interdisent la lecture automatique : la recherche est déjà préparée, triée par date, il n’y a qu’à l’ouvrir.</p>
      <div style={{ display: 'grid', gap: 10, marginBottom: 26 }}>
        {boards.map((board) => (
          <div key={board} style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center' }}>
            <span style={{ ...small, minWidth: 110 }}>{board}</span>
            {links.filter((link) => link.board === board).map((link) => <a key={link.url} title={link.why || link.label} href={link.url} target="_blank" rel="noreferrer" style={{ ...glassStyle(t), textDecoration: 'none' }}>{link.label} ↗</a>)}
          </div>
        ))}
      </div>

      <SectionTitle t={t} title="Ce que les lettres savent de toi" />
      <div style={{ display: 'grid', gap: 8 }}>
        <div style={small}>
          CV publié sur ton site{cv.updated ? ` (mis à jour : ${cv.updated.fr})` : ''} :
          {' '}{cv.pdf && cv.pdf.fr && <a href={cv.pdf.fr} target="_blank" rel="noreferrer" style={{ color: 'inherit' }}>PDF français ↗</a>}
          {' · '}{cv.pdf && cv.pdf.en && <a href={cv.pdf.en} target="_blank" rel="noreferrer" style={{ color: 'inherit' }}>PDF anglais ↗</a>}
          {cv.stale && <span style={{ color: '#d68c00' }}> · lecture du site impossible, copie gardée en mémoire ({cv.staleReason})</span>}
        </div>
        <div style={small}>
          Derniers travaux cités dans chaque lettre, lus sur la page Works de ton site :
          {' '}{(engine.latestWork || []).map((work, index) => <span key={work.url}>{index ? ' · ' : ''}<a href={work.url} target="_blank" rel="noreferrer" style={{ color: 'inherit' }}>{work.title} ↗</a></span>)}
        </div>
        <div style={small}>
          Accroche écrite par Claude ({(engine.claude && engine.claude.model) || 'Sonnet 5.5'}, effort {(engine.claude && engine.claude.effort) || 'medium'}) :{' '}
          {engine.claude && engine.claude.enabled ? <span style={{ color: '#3dbb3d' }}>activée, relis chaque accroche avant d’envoyer</span> : <span style={{ color: '#d68c00' }}>désactivée, les lettres gardent l’accroche automatique</span>}
          {engine.claude && engine.claude.enabled && engine.claude.via && <span> · connexion : {engine.claude.via === 'login' ? 'ta session Claude Code' : 'jeton d’un an'}</span>}
          {engine.claude && !engine.claude.enabled && <span> · en veille depuis le 5 octobre 2026 : le code est gardé, les lettres sont composées par le programme à partir de ton modèle, et les accroches déjà écrites sont conservées.</span>}
        </div>
        <div style={small}>Ces trois sources se relisent à chaque recherche : ajouter un projet au site met donc à jour les lettres, sans rien refaire.</div>
      </div>
    </div>
  )
}
