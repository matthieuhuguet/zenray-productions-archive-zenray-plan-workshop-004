// ═══ OÙ EST LA BARRE LATÉRALE, VRAIMENT ═══════════════════════════════════════════════════════════
//
// Deux objets flottants ont besoin de le savoir : le mini-lecteur de ZenRay Audio, qui se pose juste
// SOUS elle, et la pastille du minuteur, qui se pose à sa DROITE, en bas. Cette mesure vivait dans
// `PlayerBar.jsx` sous le nom `useSidebarAnchor` et n'en est sortie que le 2026-08-27, quand un second
// client s'est présenté. Le corps n'a pas changé d'une ligne ; seule la valeur rendue s'est élargie au
// rectangle entier, chacun y prenant ce qui l'intéresse.
//
// POURQUOI UNE MESURE ET PAS UNE CONSTANTE. La barre n'a pas de largeur fixe : elle se replie, elle
// passe en survol au-dessus du contenu sur écran étroit, elle disparaît en mode immersif. Un 230 écrit
// en dur aurait été juste un jour et faux le lendemain, sans que rien ne le signale.
//
// TROIS OBSERVATEURS, ET AUCUN N'EST DE TROP. Le `ResizeObserver` voit le repli, le `MutationObserver`
// voit le remplacement de l'élément quand l'app change de mode, l'écouteur de défilement voit le
// glissement de la barre collante. Retirer l'un des trois laisse un cas où l'ancrage se fige au mauvais
// endroit jusqu'au prochain changement de vue, ce qui se lit comme un bug d'affichage aléatoire.
import { useLayoutEffect, useState } from 'react'

export function useSidebarRect() {
  const [rect, setRect] = useState(null)
  useLayoutEffect(() => {
    let sidebar = null
    let observer = null
    const sync = () => {
      const r = sidebar?.getBoundingClientRect()
      setRect(r && r.width > 0
        ? { left: Math.round(r.left), right: Math.round(r.right), top: Math.round(r.top), bottom: Math.round(r.bottom), width: Math.round(r.width) }
        : null)
    }
    const findSidebar = () => {
      // `offsetParent !== null` écarte la barre cachée : en mode superposé, les deux existent dans le
      // DOM et seule celle qui est affichée doit servir d'ancre.
      const next = [...document.querySelectorAll('aside.zr-liquid')].find((node) => node.offsetParent !== null) || null
      if (next === sidebar) return sync()
      observer?.disconnect()
      sidebar = next
      if (sidebar && typeof ResizeObserver !== 'undefined') {
        observer = new ResizeObserver(sync)
        observer.observe(sidebar)
      }
      sync()
    }
    findSidebar()
    const mutations = new MutationObserver(findSidebar)
    mutations.observe(document.querySelector('main') || document.body, { childList: true, subtree: true })
    window.addEventListener('resize', findSidebar)
    window.addEventListener('scroll', sync, true)
    return () => { observer?.disconnect(); mutations.disconnect(); window.removeEventListener('resize', findSidebar); window.removeEventListener('scroll', sync, true) }
  }, [])
  return rect
}

// ═══ OÙ COMMENCE LE CONTENU, ET NON PAS OÙ FINIT LA BARRE ════════════════════════════════════════
//
// « et aligné » (Matthieu, 2026-08-27). La pastille se posait à un écart fixe du bord droit de la barre
// latérale, donc elle flottait dans la gouttière, à gauche du panneau, alignée sur rien. Mesuré sur deux
// vues qui n'ont pourtant aucune mise en page commune, la vue Create et la vue Timer : le contenu
// commence dans les deux cas à `main.left + 38` et s'arrête 42 pixels au-dessus du bas de `main`. Cette
// ligne existe donc bel et bien, l'application la respecte partout, et un objet flottant qui l'ignore se
// lit comme posé de travers, quel que soit l'espace qu'on lui donne autour.
//
// ON LA MESURE PLUTÔT QUE DE L'ÉCRIRE, parce qu'elle n'est pas une constante : elle vient d'un
// `clamp(16px, 2.5vw, 30px)` qui rétrécit avec la fenêtre. Un 38 écrit en dur serait juste sur ce
// portable et faux sur un écran étroit, sans que rien ne le signale.
//
// LA DESCENTE S'ARRÊTE AU PREMIER DÉCROCHAGE. On suit l'enfant qui occupe encore l'essentiel de la
// largeur, et l'on retient la première boîte dont le bord gauche s'écarte de celui de `main` : c'est
// exactement l'endroit où une marge intérieure a été posée, donc l'endroit où le contenu commence.
// Six niveaux suffisent largement et bornent le coût ; au-delà, on rend `null` et l'appelant se rabat
// sur la barre latérale, ce qui reste correct plutôt que faux.
export function useZoneContenu() {
  const [zone, setZone] = useState(null)
  useLayoutEffect(() => {
    let observer = null
    const sync = () => {
      const m = document.querySelector('main')
      if (!m) return setZone(null)
      const mr = m.getBoundingClientRect()
      if (mr.width < 1) return setZone(null)
      let n = m
      let trouve = null
      for (let i = 0; i < 6 && n; i++) {
        const enfant = [...n.children].find((c) => c.getBoundingClientRect().width > mr.width * 0.6)
        if (!enfant) break
        const b = enfant.getBoundingClientRect()
        if (b.left > mr.left + 1) { trouve = b; break }
        n = enfant
      }
      if (!trouve) return setZone(null)
      // LE BAS N'EST PAS TOUJOURS MESURABLE, et c'est le cas normal plutôt que l'exception. Sur une vue
      // qui défile, le panneau descend bien au-delà de la fenêtre : mesuré 4 533 pixels sur le tableau
      // de bord, contre 678 sur Create. Son bord bas n'existe alors nulle part à l'écran, et s'y aligner
      // n'aurait aucun sens. On se rabat sur la marge de GAUCHE, la seule qui reste vraie partout, ce qui
      // donne un retrait de même ordre au lieu d'un objet collé au bord de la fenêtre.
      const insetGauche = Math.round(trouve.left - mr.left)
      const insetBas = Math.round(window.innerHeight - trouve.bottom)
      setZone({
        gauche: Math.round(trouve.left),
        insetBas: insetBas >= 0 ? insetBas : insetGauche,
      })
    }
    const m = document.querySelector('main')
    if (m && typeof ResizeObserver !== 'undefined') { observer = new ResizeObserver(sync); observer.observe(m) }
    const mutations = new MutationObserver(sync)
    mutations.observe(m || document.body, { childList: true, subtree: true })
    window.addEventListener('resize', sync)
    sync()
    return () => { observer?.disconnect(); mutations.disconnect(); window.removeEventListener('resize', sync) }
  }, [])
  return zone
}
