// 23 October 2026: check model outputs against their units before ingesting (node scripts/Knowledge/CheckOutput.mjs <unit id>...).
// FR : vérifier les sorties du modèle contre leurs unités avant l'ingestion.
import { readFile } from 'node:fs/promises'
import { candidatesFromOutput } from './lib/Pipeline.mjs'
const config = JSON.parse(await readFile(new URL('./KnowledgeConfig.json', import.meta.url), 'utf8'))
const dir = process.env.HOME + '/Library/Application Support/ZenRayKnowledge'
for (const id of process.argv.slice(2)) {
  const unit = JSON.parse(await readFile(`${dir}/Queue/${id}.json`, 'utf8'))
  const out = JSON.parse((await readFile(`${dir}/Out/${id}.json`, 'utf8')).match(/\{[\s\S]*\}/)[0])
  const r = candidatesFromOutput(unit, out, config)
  console.log(id, 'given', (out.entries || out.pairs || []).length, 'kept', r.candidates.length, 'rejected', JSON.stringify(r.rejected))
  for (const c of r.candidates.slice(0, 4)) console.log(' -', c.q, '|', c.a[0].slice(0, 140), '| proof:', c.src.proof.slice(0, 60), '| at', c.src.at)
}
