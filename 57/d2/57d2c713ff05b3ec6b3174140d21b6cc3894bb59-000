// === ZENRAY HOUDINI, HARVESTED VOCABULARY (2026-09-07) =======================================
//
// This panel displays NOTHING it wrote itself. It reads an index derived from the local Houdini
// installation, produced by Memory/Houdini/Scripts/build-houdini-vocab.py, which queries the `hou`
// module and the official SideFX help. Measured on 2026-09-07: 5564 node types and 1132 VEX
// functions on Houdini 22.0.368.
//
// WHY AN INDEX AND NOT A WRITTEN LIST. A vocabulary of 5564 terms written by hand would be wrong at
// the edges and stale at the next software update. Here a single `hython build-houdini-vocab.py`
// refreshes it, and `--verify` fails when the index diverges from the installation.
//
// FR : un vocabulaire ecrit a la main serait faux sur les bords et perime a la version suivante.
//
// The files weigh 818 KiB and 256 KiB: they load on the first display of this tab only, never when
// the parent view mounts.

import React, { useEffect, useMemo, useRef, useState } from 'react'
import Icon from '../components/Icon.jsx'

// -- PARAMETER INTERFACE (HDA law: everything tunable lives here) -----------------------------
const VOCABULARY = {
  index: 'Memory/Houdini/Site/houdini-vocabulary.json',
  nodes: 'Memory/Houdini/Site/houdini-nodes.json',
  vex: 'Memory/Houdini/Site/houdini-vex.json',
  maxResults: 120,          // beyond this, ask to narrow down: a 5000 line list is not readable
  minCharacters: 2,
}

// The /api/page endpoint ALWAYS wraps content in { markdown }, even with raw=1, even for JSON.
// A bare r.json() returns the envelope instead of the data, and the list stays empty with no error
// whatsoever. Same unwrapping as ZenRayJapanese, which paid the lesson first.
// FR : la liste reste vide sans la moindre erreur, et rien ne signale l'enveloppe.
const readJson = (path) =>
  fetch(`/api/page?action=read&raw=1&path=${encodeURIComponent(path)}`, { cache: 'no-store' })
    .then((response) => (response.ok ? response.json() : Promise.reject(new Error(`HTTP ${response.status}`))))
    .then((payload) => {
      if (!payload || !payload.markdown || payload.missing) throw new Error(`${path} unreadable`)
      return JSON.parse(payload.markdown)
    })

export default function ZenRayHoudiniVocabulary() {
  const [index, setIndex] = useState(null)
  const [nodes, setNodes] = useState(null)
  const [vexFunctions, setVexFunctions] = useState(null)
  const [error, setError] = useState(null)
  const [query, setQuery] = useState('')
  const [family, setFamily] = useState('all')
  const [tab, setTab] = useState('nodes')
  const requested = useRef(false)

  useEffect(() => {
    if (requested.current) return
    requested.current = true
    Promise.all([readJson(VOCABULARY.index), readJson(VOCABULARY.nodes), readJson(VOCABULARY.vex)])
      .then(([loadedIndex, loadedNodes, loadedVex]) => {
        setIndex(loadedIndex); setNodes(loadedNodes); setVexFunctions(loadedVex)
      })
      .catch((caught) => setError(String(caught.message || caught)))
  }, [])

  const families = useMemo(() => ['all', ...(index?.families || [])], [index])

  const results = useMemo(() => {
    const source = tab === 'nodes' ? nodes : vexFunctions
    if (!source) return []
    const needle = query.trim().toLowerCase()
    return source.filter((entry) => {
      if (family !== 'all' && !(entry.f || []).includes(family)) return false
      if (needle.length < VOCABULARY.minCharacters) return family !== 'all'
      return entry.n.toLowerCase().includes(needle) || (entry.s || '').toLowerCase().includes(needle)
    })
  }, [tab, nodes, vexFunctions, query, family])

  if (error) {
    return (
      <div className="zhd-voc-state">
        Vocabulaire illisible : {error}.<br />
        Le regenerer avec <code>hython Memory/Houdini/Scripts/build-houdini-vocab.py</code>.
      </div>
    )
  }
  if (!index) return <div className="zhd-voc-state">Lecture de l index Houdini…</div>

  const visible = results.slice(0, VOCABULARY.maxResults)

  return (
    <div className="zhd-voc">
      <div className="zhd-voc-measures">
        <span><strong>Houdini {index.houdini_version}</strong> mesure sur cette machine</span>
        <span>{index.total_nodes} types de noeuds</span>
        <span>{index.nodes_with_summary} avec resume officiel</span>
        <span>{index.total_vex} fonctions VEX</span>
      </div>

      <div className="zhd-voc-bar">
        <div className="zhd-tabs">
          <button type="button" className={`zhd-tab-btn ${tab === 'nodes' ? 'active' : ''}`} onClick={() => setTab('nodes')}>
            <Icon name="cube" size={14} /><span>Noeuds ({index.total_nodes})</span>
          </button>
          <button type="button" className={`zhd-tab-btn ${tab === 'vex' ? 'active' : ''}`} onClick={() => setTab('vex')}>
            <Icon name="chevron.left.forwardslash.chevron.right" size={14} /><span>VEX ({index.total_vex})</span>
          </button>
        </div>
        <div className="zhd-search-box">
          <Icon name="magnifyingglass" size={14} className="zhd-search-icon" />
          <input className="zhd-search-input" type="text" value={query} placeholder="scatter, copytopoints, fit01, heightfield…"
                 onChange={(event) => setQuery(event.target.value)} />
        </div>
      </div>

      <div className="zhd-domain-pills">
        {families.map((entry) => (
          <button key={entry} type="button" className={`zhd-domain-pill ${family === entry ? 'active' : ''}`} onClick={() => setFamily(entry)}>
            <span>{entry}</span>
            {entry !== 'all' && index.by_family?.[entry] ? <em className="zhd-voc-counter">{index.by_family[entry]}</em> : null}
          </button>
        ))}
      </div>

      {query.trim().length < VOCABULARY.minCharacters && family === 'all' ? (
        <div className="zhd-voc-state">
          Chercher un terme, ou choisir une famille. Le vocabulaire complet ne s affiche jamais d un bloc :
          {index.total_nodes} lignes ne se lisent pas.
        </div>
      ) : (
        <>
          <div className="zhd-voc-count">
            {results.length} resultat{results.length > 1 ? 's' : ''}
            {results.length > VOCABULARY.maxResults ? `, ${VOCABULARY.maxResults} affiches, affiner la recherche` : ''}
          </div>
          <ul className="zhd-voc-list">
            {visible.map((entry) => (
              <li key={`${entry.c || 'vex'}/${entry.n}`} className="zhd-voc-row">
                <code className="zhd-voc-name">{entry.c ? `${entry.c}/${entry.n}` : entry.n}</code>
                <span className="zhd-voc-summary">{entry.s || (entry.u ? entry.u[0] : '')}</span>
                <span className="zhd-voc-families">{(entry.f || []).join(' · ')}</span>
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  )
}
