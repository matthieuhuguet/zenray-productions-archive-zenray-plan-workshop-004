// 5 October 2026: the batch picks the best distinct postings and never repeats a posting listed for several countries.
import { describe, it, expect } from 'vitest'
import { pickBatch, postingKey, doneToday } from './freelanceBatch.js'

const offer = (id, name, role, score, extra = {}) => ({ id, name, role, status: 'to_contact', messages: [], engine: { score, tier: score >= 60 ? 'high' : 'medium', kind: 'offer', freelance: false, ...extra } })
describe('daily batch', () => {
  it('orders by fit, drops the repeats of one posting, caps per studio', () => {
    const studios = [
      offer('1', 'Keywords Studios', 'Technical Artist | Artiste technique', 70),
      offer('2', 'Keywords Studios', 'Technical Artist', 69),
      offer('3', 'Keywords Studios', 'VFX Artist', 68),
      offer('4', 'Keywords Studios', 'Level Artist', 67),
      offer('5', 'Gameloft', 'Senior Technical Artist', 52),
      offer('6', 'Low', 'Environment Artist', 30),
      { ...offer('7', 'Closed', 'Technical Artist', 90), engine: { score: 90, closedAt: '2026-10-01' } },
      { ...offer('8', 'Done', 'Technical Artist', 90), status: 'contacted' },
    ]
    const { picked, waiting, duplicates } = pickBatch(studios, { today: '2026-10-05', size: 8 })
    expect(picked.map((e) => e.studio.id)).toEqual(['1', '3', '5'])
    expect(picked[0].duplicates).toBe(1); expect(duplicates).toBe(1)
    expect(waiting.map((e) => e.studio.id)).toEqual(['4'])
  })
  it('respects the size', () => {
    const studios = Array.from({ length: 10 }, (_, i) => offer(String(i), `Studio ${i}`, 'Technical Artist', 80 - i))
    expect(pickBatch(studios, { today: '2026-10-05', size: 5 }).picked).toHaveLength(5)
  })
  it('one posting has one key whatever its location tail or prefix', () => {
    expect(postingKey(offer('a', 'GameSim (Keywords Studios)', 'Vivier de candidatures : VFX Artist - GameSim - Talent Pool', 1))).toBe(postingKey(offer('b', 'GameSim', 'VFX Artist | Artiste en effets', 1)))
  })
  // 15 October 2026: edge cases of the 10/20/50 batch before it opens that many tabs.
  it('an empty list or a size beyond the candidates never throws and never invents offers', () => {
    expect(pickBatch([], { today: '2026-10-15', size: 50 })).toEqual({ picked: [], waiting: [], duplicates: 0 })
    const two = [offer('1', 'A', 'Technical Artist', 80), offer('2', 'B', 'VFX Artist', 70)]
    const { picked, waiting } = pickBatch(two, { today: '2026-10-15', size: 50 })
    expect(picked).toHaveLength(2); expect(waiting).toHaveLength(0)
  })
  it('the same offers in any input order give the same batch', () => {
    const studios = [
      offer('b', 'Same Studio', 'Technical Artist', 60), offer('a', 'Same Studio', 'VFX Artist', 60),
      offer('c', 'Same Studio', 'Level Artist', 60), offer('d', 'Other', 'Houdini Artist', 60),
    ]
    const ids = (list) => pickBatch(list, { today: '2026-10-15', size: 3 }).picked.map((e) => e.studio.id)
    expect(ids([...studios].reverse())).toEqual(ids(studios))
  })
  it('prioritizes France opportunities over distant regions in the daily batch', () => {
    const studios = [
      { ...offer('ar_1', 'FS Studio', 'Houdini Artist', 75), city: 'Argentina', engine: { score: 75, country: 'AR' } },
      { ...offer('fr_1', 'Drama Studios', 'Environment Technical Artist', 70), city: 'Rennes (35)', engine: { score: 70, country: 'FR' } },
    ]
    const { picked } = pickBatch(studios, { today: '2026-10-08', size: 1 })
    expect(picked[0].studio.id).toBe('fr_1')
  })
})
