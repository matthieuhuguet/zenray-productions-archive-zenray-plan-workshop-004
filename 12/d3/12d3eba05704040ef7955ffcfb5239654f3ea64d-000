// 5 October 2026: the open job feeds keep only matching roles, credit their source, and never close a vacancy.
import { describe, it, expect } from 'vitest'
import { remotive, jobicy, remoteok, arbeitnow } from './sources/Aggregators.mjs'
import { scoreOffer, publishedMs } from './lib/Offer.mjs'
import config from './FreelanceConfig.json'

const http = (map) => ({ json: async (url) => { const hit = Object.keys(map).find((key) => url.startsWith(key)); if (!hit) throw new Error(`HTTP 404 ${url}`); const v = map[hit]; if (v instanceof Error) throw v; return v } })

describe('open feeds', () => {
  it('remotive: matching roles only, deduped across queries, window board', async () => {
    const [board] = await remotive({ http: http({ 'https://remotive.com/api/remote-jobs': { jobs: [{ id: 1, title: 'Technical Artist', company_name: 'Acme ', url: 'https://remotive.com/x', description: '<p>Houdini</p>', publication_date: '2026-10-02T10:00:00' }, { id: 2, title: 'Copywriter', company_name: 'B', url: 'u' }] } }), config })
    expect(board.listings).toHaveLength(1)
    expect(board.listings[0]).toMatchObject({ name: 'Acme', sourceLabel: 'Remotive', url: 'https://remotive.com/x' })
    expect(board.complete).toBe(false); expect(board.partial).toBe(true)
  })
  it('a failing query makes the board non-partial, never throws', async () => {
    const [board] = await jobicy({ http: http({}), config })
    expect(board.errors.length).toBeGreaterThan(0); expect(board.partial).toBe(false); expect(board.listings).toEqual([])
  })
  it('remoteok skips the legal header and non-matching jobs', async () => {
    const [board] = await remoteok({ http: http({ 'https://remoteok.com/api': [{ legal: 'x' }, { id: '9', position: 'Environment Artist', company: 'C', url: 'https://remoteOK.com/9', date: '2026-10-03T00:00:00+00:00', description: 'd' }, { id: '8', position: 'Head of Operations', company: 'D', url: 'u' }] }) })
    expect(board.listings.map((l) => l.sourceId)).toEqual(['remoteok:9'])
  })
  it('arbeitnow converts epoch seconds', async () => {
    const [board] = await arbeitnow({ http: http({ 'https://www.arbeitnow.com/api/job-board-api': { data: [{ slug: 's1', title: 'VFX Artist (m/w/d)', company_name: 'E', url: 'https://www.arbeitnow.com/s1', description: 'd', created_at: '1791187227', location: 'Berlin' }] } }), config: { ...config, sources: { ...config.sources, arbeitnow: { pages: 1 } } } })
    expect(board.listings[0].published).toBe(new Date(1791187227 * 1000).toISOString())
  })
})

describe('honest scoring', () => {
  const base = { text: 'Houdini Unreal Engine Python', contract: 'Freelance', country: 'FR', workplace: 'Remote' }
  const now = new Date('2026-10-05T10:00:00Z')
  it('a senior title can never be rated high', () => {
    const verdict = scoreOffer({ ...base, title: 'Senior Technical Artist' }, config, undefined)
    expect(verdict.score).toBeLessThanOrEqual(55); expect(verdict.tier).not.toBe('high')
  })
  it('an old announcement loses points; a very old one loses more', () => {
    const fresh = scoreOffer({ ...base, title: 'Technical Artist', published: '2026-09-30', now }, config).score
    const old = scoreOffer({ ...base, title: 'Technical Artist', published: '2026-03-01', now }, config).score
    const ancient = scoreOffer({ ...base, title: 'Technical Artist', published: '2022-09-01', now }, config).score
    expect(fresh).toBeGreaterThan(old); expect(old).toBeGreaterThan(ancient)
  })
  it('reads the date shapes the sources use', () => {
    expect(publishedMs('1747305600000')).toBe(1747305600000)
    expect(publishedMs('Jul 23, 2026')).not.toBeNull()
    expect(publishedMs('')).toBeNull(); expect(publishedMs('nonsense')).toBeNull()
  })
})

import { boamp, ted } from './sources/Tenders.mjs'
describe('lanes and tenders', () => {
  it('a feed job outside games but inside the other lane is labelled other; games wins on a tie', async () => {
    const [board] = await remotive({ http: http({ 'https://remotive.com/api/remote-jobs': { jobs: [
      { id: 1, title: 'Houdini FX Artist', company_name: 'Film Co', url: 'https://remotive.com/a', description: 'film' },
      { id: 2, title: 'Technical Artist', company_name: 'Game Co', url: 'https://remotive.com/b', description: 'game' },
      { id: 3, title: 'WebGL Developer', company_name: 'Viz Co', url: 'https://remotive.com/c', description: 'web' },
      { id: 4, title: 'Houdini FX Artist', company_name: 'Series Co', url: 'https://remotive.com/d', description: 'feature film and tv series visual effects' },
    ] } }), config })
    expect(Object.fromEntries(board.listings.map((l) => [l.title, l.lane]))).toEqual({ 'Houdini FX Artist': 'other', 'Technical Artist': 'games', 'WebGL Developer': 'other' })
  })
  it('boamp keeps only open tenders about 3D work, with the deadline as validThrough', async () => {
    const now = new Date('2026-10-05T10:00:00Z')
    const [board] = await boamp({ now, config, http: { json: async () => ({ results: [
      { idweb: '26-1', objet: 'Création de modules immersifs en Réalité Virtuelle', nomacheteur: 'Université X', dateparution: '2026-10-01', datelimitereponse: '2026-11-01T12:00:00+00:00', url_avis: 'https://www.boamp.fr/pages/avis/?q=idweb:26-1' },
      { idweb: '26-3', objet: 'Acquisition de licences logicielles pour la 3D', nomacheteur: 'Université', dateparution: '2026-10-01', datelimitereponse: '2026-11-01T12:00:00+00:00' },
      { idweb: '26-2', objet: 'Fourniture de papier', nomacheteur: 'Mairie', dateparution: '2026-10-01', datelimitereponse: '2026-11-01T12:00:00+00:00' },
    ] }) } })
    expect(board.listings).toHaveLength(1)
    expect(board.listings[0]).toMatchObject({ lane: 'other', sourceKey: 'boamp', contract: 'Appel d’offres', validThrough: '2026-11-01', country: 'FR' })
    expect(board.partial).toBe(true)
  })
  it('ted drops goods, award notices and passed deadlines, and reads the object after the category', async () => {
    const now = new Date('2026-10-05T10:00:00Z')
    const notice = (n, type, title, deadline) => ({ 'publication-number': n, 'notice-type': type, 'notice-title': { eng: title }, 'buyer-name': { eng: ['Buyer'] }, 'deadline-receipt-tender-date-lot': [deadline], 'publication-date': '2026-10-01' })
    const [board] = await ted({ now, config: { ...config, sources: { ...config.sources, ted: { ...config.sources.ted, queries: ['digital twin'] } } }, http: { postJson: async () => ({ notices: [
      notice('1', 'cn-standard', 'Italy – Software development services – Digital twin of a city', '2026-11-01+01:00'),
      notice('2', 'can-standard', 'Italy – Software development services – Digital twin of a city award', '2026-11-01+01:00'),
      notice('3', 'cn-standard', 'Italy – Software development services – Digital twin of a port', '2026-09-01+01:00'),
      notice('4', 'cn-standard', 'Ireland – Display screens – Digital twin screens', '2026-11-01+01:00'),
    ] }) } })
    expect(board.listings.map((l) => l.sourceId)).toEqual(['ted:1'])
  })
})
