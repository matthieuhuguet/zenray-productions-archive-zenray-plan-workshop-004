// C215a — Modèle de navigation OS (Phase 6). Désambiguïse le mot "view" (pris 2x) en 3 axes :
//   appView : l'écran de plus haut niveau (create | articles | docs | roadmap | trash)
//   section : à l'intérieur de Create, l'espace courant (files | bases | gallery | references | projects | freelance | archive | home)
//   layout  : la disposition de la grille Finder (icons | list | gallery)  — l'ancien `view` local de Pages
// Décision D6 (relecture) : migration = CHANGEMENT DE SHAPE à défaut SÛR. Une valeur inconnue -> create/files,
// jamais de throw, et on n'écrase pas l'ancienne clé avant succès (rollback possible).

// Sections repliées dans Create (cf master plan §3.1). Music vit désormais dans Create ;
// Documents/Articles/Roadmap/Trash restent des appViews.
export const SECTIONS = ['files', 'home', 'bases', 'gallery', 'references', 'projects', 'freelance', 'archive']

// Table de mapping des anciennes `view` (legacy localStorage zr:view / zr:tabs) vers {appView, section}.
const LEGACY = {
  pages: { appView: 'create', section: 'files' },
  board: { appView: 'create', section: 'home' },
  db: { appView: 'create', section: 'bases' },
  gallery: { appView: 'create', section: 'gallery' },
  references: { appView: 'create', section: 'references' },
  projects: { appView: 'create', section: 'projects' },
  freelance: { appView: 'create', section: 'freelance' },
  archive: { appView: 'create', section: 'archive' },
  // L'ancienne app Audio est dépréciée : une ancienne valeur ouvre Create, où Music vit désormais.
  audio: { appView: 'create', section: 'files' },
  articles: { appView: 'articles' },
  docs: { appView: 'docs' },
  build: { appView: 'roadmap' },
  trash: { appView: 'trash' },
}

// Migre une ancienne valeur `view` vers {appView, section}. Défaut SÛR : inconnu -> create/files. Jamais de throw.
export function migrateView(view) {
  if (view && LEGACY[view]) return { ...LEGACY[view] }
  // déjà au nouveau format ?
  if (view === 'create') return { appView: 'create', section: 'files' }
  if (['articles', 'docs', 'roadmap', 'trash'].includes(view)) return { appView: view }
  return { appView: 'create', section: 'files' } // défaut sûr
}

// Migre un onglet {view,...} legacy vers {appView, section, folder, path}. Conserve folder/path si présents.
export function migrateTab(tab) {
  const t = tab || {}
  const base = migrateView(t.view || t.appView)
  return { id: t.id, appView: base.appView, section: base.section || (base.appView === 'create' ? 'files' : undefined), folder: t.folder || 'pages', path: t.path || null }
}

export const isCreateSection = (s) => SECTIONS.includes(s)
