// @vitest-environment node
// 7 October 2026, 14:50 CEST: a sentence finds its file; the file map counts every file once and never lists itself.
import { it, expect } from 'vitest'
import { queryConcepts, rankProjectFiles, matchingPassages, renderFileMap } from './FindInProject.mjs'

const file = (relativePath, day, sourceId = 'production', root = '/p') => ({ relativePath, sourceId, localPath: `${root}/${relativePath}`, size: 10, mtimeMs: Date.parse(`2026-10-${day}T10:00:00Z`) })
const files = [
  file('snapshots/Church/v005_texturing_start/graph.hiplc', '03'), file('snapshots/Church/v005_texturing_start/metadata.json', '03'),
  file('snapshots/Church/v002_ground_aligned/graph.hiplc', '01'), file('Content/Bayou/M_WornWood_02.uasset', '02', 'game'),
  file('refs/moodboard_church.png', '01', 'workshop'), file('renders/final_0001.png', '04'),
  file('sources/houdini/production/textures/M_WornWood_02.uasset', '05', 'production', '/x/AssetsWorkspaces/bayou/loads/abc'),
]

it('maps French and English words to the same concept families', () => {
  expect(queryConcepts("reprendre depuis le concept où on avait mis les matériaux").map(item => item.key).sort()).toEqual(['f:0', 'f:1'])
  expect(queryConcepts('materials texture').length).toBe(1)
})

it('finds the step of work a sentence means and ranks the original above a restored copy', () => {
  const result = rankProjectFiles({ phrase: 'là où on a commencé le texturing', files })
  expect(result.units[0].unit).toBe('snapshots/Church/v005_texturing_start')
  const material = rankProjectFiles({ phrase: 'le matériau bois usé', files })
  const paths = material.results.map(item => item.localPath)
  expect(paths.indexOf('/p/Content/Bayou/M_WornWood_02.uasset')).toBeLessThan(paths.indexOf('/x/AssetsWorkspaces/bayou/loads/abc/sources/houdini/production/textures/M_WornWood_02.uasset'))
})

it('boosts a file the project memory names in a passage that matches the sentence, and finds nothing for unrelated words', () => {
  const passages = matchingPassages('- 3 October 2026 : le concept validé est final_0001.png, on garde ce rendu.\n- 2 October 2026 : autre chose.', queryConcepts('le concept validé'), 'FEEDBACK.md')
  expect(passages[0]).toMatchObject({ date: '3 October 2026', cited: ['final_0001.png'] })
  const result = rankProjectFiles({ phrase: 'le concept validé', files, passages })
  expect(result.results[0].relativePath).toBe('renders/final_0001.png')
  expect(rankProjectFiles({ phrase: 'zeppelin', files }).results).toEqual([])
  expect(() => rankProjectFiles({ phrase: 'le la les', files })).toThrow('no searchable word')
})

it('the file map counts every file exactly once, lists folders, and excludes itself and the conversation index', () => {
  const all = [...files, file('FileMap.md', '06', 'notes'), file('ConversationIndex.json', '06', 'notes'), file('FEEDBACK.md', '06', 'notes')]
  const map = renderFileMap('bayou', all, { houdini: [{ sourceId: 'production', localPath: '/p' }] })
  expect(map.files).toBe(all.length - 2); expect(map.counted).toBe(map.files)
  expect(map.markdown).toContain('`/p/snapshots/Church/v005_texturing_start`'); expect(map.markdown).not.toContain('FileMap.md |')
  expect(renderFileMap('bayou', all).markdown).toBe(renderFileMap('bayou', [...all].reverse()).markdown)
})
