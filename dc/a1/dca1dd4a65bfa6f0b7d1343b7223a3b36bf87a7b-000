// privateFetch.js — lecture côté CLIENT des repos GitHub PRIVÉS zenrayshards-* (2026-07-05).
//
// CONVENTION (source de vérité unique, partagée avec le Service Worker zr-stream-sw.js et les pipelines) :
// seul zenrayshards-img-* est PUBLIC (jsDelivr l'exige) ; tout autre type (vid/blob/pdf/doc/...) est PRIVÉ.
// Un repo privé ne se lit pas via raw.githubusercontent.com sans authentification -> on convertit l'URL raw
// en appel api.github.com (Accept: application/vnd.github.raw), avec le token servi par /api/raw-token
// (gated, même modèle que /api/media-key). CORS d'api.github.com vérifié OK avec Authorization (2026-07-05).
// Limite structurelle assumée : ce chemin API accepte les fichiers jusqu'à 100 Mo — nos parts font 95 Mo,
// c'est LA raison historique de cette taille de part.

let _tokenPromise = null
export function getRawToken() {
  if (!_tokenPromise) {
    _tokenPromise = fetch('/api/raw-token', { cache: 'no-store' })
      .then((r) => r.json()).then((j) => (j && j.token) || null).catch(() => null)
  }
  return _tokenPromise
}

export const isPrivateFamilyUrl = (u) => /raw\.githubusercontent\.com\/[^/]+\/zenrayshards-(?!img-)/.test(String(u || ''))

// raw.githubusercontent.com/<owner>/<repo>/<sha>/<path> -> api.github.com/repos/<owner>/<repo>/contents/<path>?ref=<sha>
export function rawToApiUrl(rawUrl) {
  const m = /^https:\/\/raw\.githubusercontent\.com\/([^/]+)\/([^/]+)\/([^/]+)\/(.+)$/.exec(String(rawUrl || ''))
  if (!m) return null
  return `https://api.github.com/repos/${m[1]}/${m[2]}/contents/${m[4]}?ref=${m[3]}`
}

// fetch d'une part/blob en tenant compte de la visibilité : privé (flag manifeste OU famille du nom) ->
// api.github.com + token ; public -> fetch direct avec REPLI authentifié sur 401/403/404 (repo basculé
// privé après coup). Renvoie la Response (l'appelant lit arrayBuffer/body comme d'habitude).
export async function fetchMaybePrivate(url, isPrivate = false) {
  if (isPrivate || isPrivateFamilyUrl(url)) {
    const t = await getRawToken()
    const api = rawToApiUrl(url)
    if (!t || !api) throw new Error('lecture privée impossible (token/url)')
    return fetch(api, { headers: { Authorization: `Bearer ${t}`, Accept: 'application/vnd.github.raw' } })
  }
  const r = await fetch(url)
  if (!r.ok && (r.status === 401 || r.status === 403 || r.status === 404)) {
    const t = await getRawToken(); const api = rawToApiUrl(url)
    if (t && api) return fetch(api, { headers: { Authorization: `Bearer ${t}`, Accept: 'application/vnd.github.raw' } })
  }
  return r
}
