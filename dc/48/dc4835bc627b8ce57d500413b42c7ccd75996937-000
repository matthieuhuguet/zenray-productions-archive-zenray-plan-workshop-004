#!/usr/bin/env bash
# Barre de progression d'un upload archive-folder.mjs en cours.
# Lit le log (arg 1, défaut /tmp/dji-archive.log) + le total Go (arg 2, défaut 105.39).
# Progression = somme des shards déjà flushés ("✓ ... poussé (..., N.NN Go)") + shard courant
# (dernier "[shard N.NN Go]"). Affiche % + barre + état du process + dernière ligne utile.
LOG="${1:-/tmp/dji-archive.log}"
TOTAL_GO="${2:-105.39}"
# Log absent (ex. /tmp nettoyé) n'est PAS fatal : la barre se calcule sur le work dir persistant. On crée un
# log vide temporaire pour que les greps ne cassent pas, et on signale la situation.
[ -f "$LOG" ] || { echo "(log $LOG absent — barre calculée sur le work dir ; vérifier manifestes pour la fin)"; LOG=$(mktemp); }

# Go déjà poussés (shards flushés). Note: le script imprime les Go shard en base-2 (GiB) ;
# le total annoncé est en base-10. On reste cohérent en comparant à TOTAL_GiB ≈ TOTAL_GO/1.07374.
TOTAL_GIB=$(awk -v t="$TOTAL_GO" 'BEGIN{printf "%.2f", t/1.073741824}')
# Progression RÉELLE = taille des chunks sur disque (/Users/zenray/.zr-archive-work). Les pushes suivent la découpe de près
# (remote rattrape le HEAD en continu), donc « chunks sur disque » ≈ « poussé sur GitHub ». Bien plus fiable
# que la dernière ligne par-fichier du log, qui reste figée pendant la découpe d'un gros MP4 (16 Go = ~2,5 h).
UP=$(du -sk /Users/zenray/.zr-archive-work 2>/dev/null | awk '{printf "%.2f", $1/1048576}')
[ -z "$UP" ] && UP=0
PCT=$(awk -v u="$UP" -v t="$TOTAL_GIB" 'BEGIN{p=(t>0)?u/t*100:0; if(p>100)p=100; printf "%.1f", p}')

# barre 30 caractères
FILL=$(awk -v p="$PCT" 'BEGIN{printf "%d", p/100*30}')
BAR=""
for ((i=0;i<30;i++)); do [ "$i" -lt "$FILL" ] && BAR+="█" || BAR+="░"; done

# process vivant ?
if pgrep -f "archive-folder.mjs" >/dev/null; then PROC="● en cours"; else
  grep -q "=== TERMINÉ" "$LOG" && PROC="✓ terminé" || PROC="✗ ARRÊTÉ (process mort, non terminé)"
fi

# compteur fichiers (dernier "[N maj / M inchangés / TOTAL]")
FILES=$(grep -oE '\[[0-9]+ maj / [0-9]+ inchangés / [0-9]+\]' "$LOG" | tail -1)
# nb shards ouverts
SHARDS=$(grep -cE '>>> SHARD .* r?ouvert' "$LOG")
# KO de vérif éventuels
KO=$(grep -c 'vérif KO' "$LOG")

# Signal "vivant" même avant la 1re ligne par-fichier : taille des chunks en cours de découpe + push actif.
WORK=$(du -sh /Users/zenray/.zr-archive-work 2>/dev/null | awk '{print $1}')
GITRAM=$(ps aux | grep '[g]it' | awk '{s+=$6}END{print int(s/1024)}')
PUSHING=$([ "${GITRAM:-0}" -gt 60 ] && echo "push en vol (${GITRAM} Mo git)" || echo "git ${GITRAM:-0} Mo")

echo "DJI archive  $PROC"
echo "[$BAR] ${PCT}%   ${UP} / ${TOTAL_GIB} GiB poussés"
echo "shards: $SHARDS ouverts · fichiers: ${FILES:-—} · vérif KO: $KO"
echo "en cours: chunks /tmp ${WORK:-0} · $PUSHING"
echo "dernier: $(grep -E '^\s*\[|^\s*✓|^>>>|vérif|TERMINÉ' "$LOG" | tail -1 | sed 's/^[[:space:]]*//')"
