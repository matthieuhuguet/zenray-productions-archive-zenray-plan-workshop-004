// 10 October 2026, 13:53 CEST: Reconstruct pinned private video bytes through Git and verify them against the local source.
// 10 October 2026, 14:40 CEST: Retry transient GitHub fetch failures and retain source stat identity in the recovery receipt.
// 12 October 2026: ONE implementation. This script no longer carries its own copy of the read-back; it asks the policy of
// lib/video-identity-proof.mjs, which writes a receipt that names its proof (verificationMode):
//   identity-v1    re-derived parts matched to GitHub's object ids + manifest online + one real part read (about 4 s per film)
//   full-readback  every part downloaded, decrypted and hashed: 1 film in ZR_VERIFY_FULL_EVERY (default 0 since 14 October 2026: no sampling, Matthieu), every
//                  film whose identity proof failed REMOTELY (escalation), and every film when ZR_VERIFY_MODE=full.
// FR : une seule implementation ; le recu dit comment la preuve a ete faite (identity-v1 ou full-readback).
//   node scripts/VerifyVideoCloud.mjs <manifest> <source> <receipt> [--mode=identity|full|shadow] [--force-full]
//   node scripts/VerifyVideoCloud.mjs --stats <receipts directory>      (separate counters for the panel, JSON on stdout)
import { verifyVideoCloudByPolicy, resolveIdentityProofConfig, summarizeVerificationReceipts } from './lib/video-identity-proof.mjs'

const argv = process.argv.slice(2)
const flags = argv.filter((entry) => entry.startsWith('--'))
const positional = argv.filter((entry) => !entry.startsWith('--'))
const modeFlag = flags.find((entry) => entry.startsWith('--mode='))?.slice('--mode='.length)

if (flags.includes('--stats')) {
  const directory = positional[0]
  if (!directory) throw new Error('Usage: VerifyVideoCloud.mjs --stats <receipts directory>')
  console.log(JSON.stringify(await summarizeVerificationReceipts(directory, { config: resolveIdentityProofConfig(modeFlag ? { mode: modeFlag } : {}) }), null, 2))
} else {
  const [manifestPath, source, receiptPath] = positional
  if (!manifestPath || !source || !receiptPath) throw new Error('Usage: VerifyVideoCloud.mjs manifest source receipt [--mode=identity|full|shadow] [--force-full]')
  const config = resolveIdentityProofConfig(modeFlag ? { mode: modeFlag } : {})
  const result = await verifyVideoCloudByPolicy({ manifestPath, source, receiptPath, config, forceFull: flags.includes('--force-full') })
  console.log(JSON.stringify({ verificationMode: result.verificationMode, reused: result.reused }))
}
