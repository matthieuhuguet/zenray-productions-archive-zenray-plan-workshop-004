// 12 October 2026: the feedback request shows only for a refusal, copies the exact mail, and is logged only on his click.
import React from 'react'
import { afterEach, beforeEach, expect, it, vi } from 'vitest'
import { cleanup, fireEvent, render, screen } from '@testing-library/react'

vi.mock('../Notifications.jsx', () => ({ notify: vi.fn() }))
import FreelanceFeedbackRequest from './FreelanceFeedbackRequest.jsx'

const t = { border: 'gray', surface: 'transparent', textPrimary: 'black', textSecondary: 'gray', bg: 'white' }
const studio = (over = {}) => ({
  id: 'job_voodoo', name: 'Voodoo', role: 'Technical Artist (AI), Portfolio Games Team, Freelance', status: 'declined', messages: [],
  history: [{ at: '2026-10-12', from: 'contacted', to: 'declined', note: 'refus' }], notes: '', engine: { language: 'en', contactEmails: [] }, ...over,
})

beforeEach(() => { Object.assign(navigator, { clipboard: { writeText: vi.fn().mockResolvedValue() } }) })
afterEach(() => { cleanup(); vi.clearAllMocks() })

it('renders nothing unless the studio refused', () => {
  const { container } = render(<FreelanceFeedbackRequest t={t} studio={studio({ status: 'contacted' })} onSent={vi.fn()} />)
  expect(container).toBeEmptyDOMElement()
})

it('shows the English mail for an English listing and copies it exactly', () => {
  render(<FreelanceFeedbackRequest t={t} studio={studio()} onSent={vi.fn()} />)
  const box = screen.getByLabelText('Mail')
  expect(box.value.startsWith('Hello Voodoo team,')).toBe(true)
  expect(screen.getByLabelText('Objet')).toHaveValue('Feedback request: Technical Artist (AI), Portfolio Games Team')
  expect(screen.getByText(/Refus reçu le 12 octobre 2026/)).toBeTruthy()
  fireEvent.click(screen.getByRole('button', { name: 'Copier le mail' }))
  expect(navigator.clipboard.writeText).toHaveBeenCalledWith(box.value)
})

it('switches language, keeps his edit until he resets, and logs the exact text only on his click', () => {
  const onSent = vi.fn()
  render(<FreelanceFeedbackRequest t={t} studio={studio()} onSent={onSent} />)
  fireEvent.click(screen.getByRole('button', { name: 'FR' }))
  expect(screen.getByLabelText('Mail').value.startsWith('Bonjour l’équipe Voodoo,')).toBe(true)
  fireEvent.change(screen.getByLabelText('Mail'), { target: { value: 'Mon texte.' } })
  expect(onSent).not.toHaveBeenCalled()
  fireEvent.click(screen.getByRole('button', { name: 'Marquer comme envoyé' }))
  expect(onSent).toHaveBeenCalledWith({ text: 'Mon texte.', channel: 'mail' })
  fireEvent.click(screen.getByRole('button', { name: 'Revenir au texte d’origine' }))
  expect(screen.getByLabelText('Mail').value.startsWith('Bonjour l’équipe Voodoo,')).toBe(true)
})

it('does not offer the same request twice once it was marked sent', () => {
  render(<FreelanceFeedbackRequest t={t} studio={studio({ feedbackRequestedAt: '2026-10-12' })} onSent={vi.fn()} />)
  expect(screen.getByRole('button', { name: 'Déjà marqué envoyé' })).toBeDisabled()
  expect(screen.getByText(/envoyé le 12 octobre 2026/)).toBeTruthy()
})
