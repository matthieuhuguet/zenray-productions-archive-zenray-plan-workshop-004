})

describe('official boards', () => {
  it('groups Greenhouse variants under one record and sees every variant id', async () => {
    const jobs = [{ id: 1, internal_job_id: 77, title: 'Technical Artist', location: { name: 'BLANK,BLANK,Paris' }, absolute_url: 'https://g.example/1', content: '&lt;p&gt;Houdini&lt;/p&gt;' }, { id: 2, internal_job_id: 77, title: 'Technical Artist', location: { name: 'London' }, absolute_url: 'https://g.example/2', content: '&lt;p&gt;Houdini&lt;/p&gt;' }, { id: 3, internal_job_id: 80, title: 'Accountant', location: { name: 'Paris' }, absolute_url: 'https://g.example/3', content: '' }]
    const [board] = await greenhouse({ http: fakeHttp({ 'https://boards-api.greenhouse.io/v1/boards/acme/jobs?content=true': { jobs } }), config: { ...config, sources: { ...config.sources, greenhouse: { boards: { acme: 'Acme' } } } } })
    expect(board.listings).toHaveLength(1)
    expect(board.listings[0]).toMatchObject({ sourceId: 'acme:2', location: 'London' })
    expect(board.listings[0].variantIds).toEqual([offerId('acme:1'), offerId('acme:2')])
    expect(board.seenIds).toEqual([offerId('acme:1'), offerId('acme:2')])
  })
  it('marks a board that answers 404 as incomplete instead of empty', async () => {
    const [board] = await lever({ http: fakeHttp({}), config: { ...config, sources: { ...config.sources, lever: { boards: { gone: 'Gone' } } } } })
    expect(board).toMatchObject({ complete: false, listings: [] })
    expect(board.errors[0].error).toMatch(/404/)
  })
  it('reads SmartRecruiters in pages and keeps one record per ref and place', async () => {
    const list = (offset) => ({ totalFound: 2, content: [{ id: String(offset + 1), refNumber: 'R1', name: 'Technical Artist', location: { fullLocation: 'Paris' } }] })
    const base = 'https://api.smartrecruiters.com/v1/companies/acme/postings'
    const http = fakeHttp({ [`${base}?limit=100&offset=0`]: list(0), [`${base}/1`]: { name: 'Technical Artist', location: { fullLocation: 'Paris', country: 'fr' }, jobAd: { sections: { jobDescription: { text: '<p>Unreal</p>' } } }, typeOfEmployment: { label: 'Full-time' }, releasedDate: '2026-10-01' } })
    const [board] = await smartrecruiters({ http, config: { ...config, sources: { ...config.sources, smartrecruiters: { boards: { acme: 'Acme' } } } } })
    expect(board.listings[0]).toMatchObject({ sourceId: 'acme:1', contract: 'Full-time', url: 'https://jobs.smartrecruiters.com/acme/1', careersUrl: 'https://jobs.smartrecruiters.com/acme' })
  })
})

describe('SmartRecruiters duplicates', () => {
  it('recognises a record written from either posting of the same reference, and sees both as present', async () => {
    const base = 'https://api.smartrecruiters.com/v1/companies/acme/postings'
    const list = { totalFound: 2, content: [{ id: '10', refNumber: 'R1', name: 'Technical Artist', location: { fullLocation: 'Paris' } }, { id: '11', refNumber: 'R1', name: 'Technical Artist', location: { fullLocation: 'Paris' } }] }
    const detail = { name: 'Technical Artist', location: { fullLocation: 'Paris', country: 'fr' }, jobAd: { sections: { a: { text: 'Unreal' } } }, typeOfEmployment: { label: 'Full-time' } }
    const http = fakeHttp({ [`${base}?limit=100&offset=0`]: list, [`${base}/10`]: detail })
    const [board] = await smartrecruiters({ http, config: { ...config, sources: { ...config.sources, smartrecruiters: { boards: { acme: 'Acme' } } } } })
    expect(board.listings).toHaveLength(1)
    expect(board.listings[0].variantIds).toEqual([offerId('acme:10'), offerId('acme:11')])
    expect(board.seenIds).toEqual([offerId('acme:10'), offerId('acme:11')])
  })
})

