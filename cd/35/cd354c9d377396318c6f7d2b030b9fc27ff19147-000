describe('collectAll and the http layer', () => {
  it('turns a thrown source into an incomplete board and keeps the others', async () => {
    const registry = { afjv: async () => { throw new Error('boom') }, lever: async () => [{ key: 'lever:a', label: 'A', listings: [], seenIds: [], listed: 0, matched: 0, errors: [], complete: true }] }
    const cfg = { ...config, sources: { ...config.sources, afjv: { ...config.sources.afjv, enabled: true }, lever: { ...config.sources.lever, enabled: true } } }
    const boards = await collectAll({ http: {}, config: cfg, registry })
    expect(boards.find((b) => b.key === 'afjv')).toMatchObject({ complete: false, errors: [{ error: 'boom' }] })
    expect(boards.find((b) => b.key === 'lever:a').complete).toBe(true)
  })
  it('retries a server error, never a 404, and bounds concurrency', async () => {
    let calls = 0
    const http = createHttp(config, { fetchImpl: async () => { calls += 1; return calls < 3 ? { ok: false, status: 503 } : { ok: true, status: 200, text: async () => '{"a":1}' } }, sleep: async () => {} })
    expect(await http.json('https://x')).toEqual({ a: 1 })
    expect(calls).toBe(3)
    let notFound = 0
    const gone = createHttp(config, { fetchImpl: async () => { notFound += 1; return { ok: false, status: 404 } }, sleep: async () => {} })
    await expect(gone.text('https://x')).rejects.toThrow(/404/)
    expect(notFound).toBe(1)
    let active = 0, peak = 0
    const results = await mapLimited([1, 2, 3, 4, 5, 6], 2, async (n) => { active += 1; peak = Math.max(peak, active); await new Promise((r) => setTimeout(r, 5)); active -= 1; if (n === 3) throw new Error('x'); return n })
    expect(peak).toBeLessThanOrEqual(2)
    expect(results.filter((r) => r.ok)).toHaveLength(5)
  })
})
