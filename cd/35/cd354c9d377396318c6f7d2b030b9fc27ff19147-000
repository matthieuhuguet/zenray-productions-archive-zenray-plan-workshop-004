const AFJV_ROW = '<section class="1FR3403" style="display:none" data-cv="14" data-ref="SCOM801-29118" ><span class="emp_log"></span><a class="emp_lnk" href="/emploi-jeux-video/SCOM801-29118" ></a><span class="emp_cat">CDI </span><a class="emp_pos" href="/emploi-jeux-video/SCOM801-29118" title="Technical Artist">Technical Artist</a><a class="empt_soc" href="/annonces-societes/701" title="Plug In Digital">Plug In Digital</a><a class="emp_met" href="/metier/graphisme" title="Graphisme">Graphisme</a><a class="emp_vil" href="/annonces-departement/34" title="34">Montpellier (34)</a><span data-ts="1790934600" class="emp_dat">2 oct. 2026</span><span class="emp_msk"></span></section>'
const AFJV_OTHER = AFJV_ROW.replaceAll('SCOM801-29118', 'SCOM801-1').replaceAll('Technical Artist', 'Comptable').replace('Graphisme', 'Gestion')
const AFJV_DETAIL = '<html><script type="application/ld+json">{"@type":"JobPosting","datePosted":"2026-10-02","hiringOrganization":{"@type":"Organization","name":"Plug In Digital","sameAs":"https://www.pluginDigital.com"},"jobLocation":{"address":{"addressCountry":"FR"}}}</script><h1>Technical Artist</h1><p>Houdini et Unreal Engine.</p><div id="nws_shr"></div></html>'

const fakeHttp = (routes) => ({
  text: async (url) => { if (!(url in routes)) throw new Error(`HTTP 404 ${url}`); return routes[url] },
  json: async (url) => { if (!(url in routes)) throw new Error(`HTTP 404 ${url}`); return routes[url] },
})

describe('text helpers', () => {
  it('decodes entities, flattens and keeps readable paragraphs', () => {
    expect(decodeEntities('Caf&eacute; &amp; l&rsquo;&#233;quipe &#x41;')).toBe('Café & l’équipe A')
    expect(clean('<p>One</p><script>x()</script> <b>two&nbsp;three</b>')).toBe('One two three')
    expect(readable('<p>Missions</p><ul><li>One</li><li>Two</li></ul>')).toBe('Missions\n\n• One\n• Two')
    expect(jobPosting('<script type="application/ld+json">{"@graph":[{"@type":"WebSite"},{"@type":"JobPosting","title":"T"}]}</script>').title).toBe('T')
    expect(jobPosting('<p>nothing</p>')).toBeNull()
  })
})

describe('AFJV', () => {
  it('reads the listing, keeps trade and title matches, and reads the detail with its employer link', async () => {
    const rows = afjv.parseListing(`<div>${AFJV_ROW}${AFJV_OTHER}</div>`, 'https://emploi.afjv.com')
    expect(rows).toHaveLength(2)
    expect(rows[0]).toMatchObject({ company: 'Plug In Digital', title: 'Technical Artist', contract: 'CDI', location: 'Montpellier (34)', url: 'https://emploi.afjv.com/emploi-jeux-video/SCOM801-29118' })
    expect(rows.filter(afjv.isRelevant)).toHaveLength(1)
    const listing = afjv.parseDetail(rows[0], AFJV_DETAIL, 'https://emploi.afjv.com')
    expect(listing).toMatchObject({ country: 'FR', applyUrl: 'https://emploi.afjv.com/postuler/SCOM801-29118', employerUrl: 'https://www.pluginDigital.com', careersUrl: 'https://emploi.afjv.com/annonces-societes/701', sourceId: rows[0].url })
  })
  it('refuses a listing page with no row instead of reading it as "no vacancy"', async () => {
    await expect(afjv.collect({ http: fakeHttp({ [config.sources.afjv.listUrl]: '<html>maintenance</html>' }), config })).rejects.toThrow(/no vacancy row/)
  })
  it('skips an expired advertisement and records a failed detail without losing its id', async () => {
    const http = fakeHttp({ [config.sources.afjv.listUrl]: `<div>${AFJV_ROW}</div>`, 'https://emploi.afjv.com/emploi-jeux-video/SCOM801-29118': '<h1>x</h1> Cette offre n’est plus disponible' })
    const [board] = await afjv.collect({ http, config })
    expect(board.listings).toHaveLength(0)
    expect(board.seenIds).toEqual([offerId('https://emploi.afjv.com/emploi-jeux-video/SCOM801-29118')])
    expect(board.complete).toBe(true)
  })
})

describe('Keywords Studios and GamesIndustry', () => {
  it('finds the stream endpoint and total, and refuses a changed layout', () => {
    expect(keywords.parseBoard("data_url: 'https://k.example/filter_stream/abc'; var _filter_total = 379;")).toEqual({ endpoint: 'https://k.example/filter_stream/abc', total: 379 })
    expect(() => keywords.parseBoard('<html></html>')).toThrow(/layout changed/)
  })
  it('reads a pool as a pool and names the studio inside Keywords', () => {
    const body = '<script type="application/ld+json">{"@type":"JobPosting","datePosted":"2026-07-11","jobLocation":{"address":{"addressCountry":"MX"}},"hiringOrganization":{"name":"Keywords Studios"}}</script><h1>Role</h1><p>Join d3t, fully remote.</p><form></form>'
    const listing = keywords.parseDetail({ id: '9', title: 'Environment Artist Talent Pipeline', url: 'https://k.example/9', location_text: 'Mexico' }, body)
    expect(listing).toMatchObject({ name: 'd3t (Keywords Studios)', title: 'Vivier de candidatures : Environment Artist Talent Pipeline', workplace: 'Remote', sourceId: 'keywords:9' })
    expect(listing.extra).toMatch(/Vivier/)
  })
  it('reads a GamesIndustry card and never lets a search window close a vacancy', async () => {
    const card = '<article id="node-44197" about="/job/x-44197"><h2 class="node__title"><a href="https://jobs.gamesindustry.biz/job/technical-artist-44197" class="recruiter-job-link" title="Technical Artist (Profiling)">T</a></h2><span class="recruiter-company-profile-job-organization"><a href="/company/a">Avalanche Studios</a></span><div class="location"><span>Stockholm, SE</span></div><div class="terms">Art</div></article>'
    expect(gamesindustry.parseSearch(card, 'https://jobs.gamesindustry.biz')[0]).toMatchObject({ id: '44197', title: 'Technical Artist (Profiling)', company: 'Avalanche Studios', location: 'Stockholm, SE' })
    const detail = '<script type="application/ld+json">{"@type":"JobPosting","datePosted":"2026-09-24","validThrough":"2026-10-14","hiringOrganization":{"name":"Avalanche Studios"},"jobLocation":[{"address":{"addressCountry":"SE","addressLocality":"Stockholm"}}],"description":"<p>Houdini wanted</p>"}</script>'
    const http = { text: async (url) => (url.includes('/jobs?') ? card : detail) }
    const [board] = await gamesindustry.collect({ http, config: { ...config, sources: { ...config.sources, gamesindustry: { ...config.sources.gamesindustry, queries: ['technical artist'] } } } })
    expect(board.complete).toBe(false)
    expect(board.listings[0]).toMatchObject({ validThrough: '2026-10-14', applyUrl: 'https://jobs.gamesindustry.biz/node/44197/apply-external', country: 'SE', careersUrl: 'https://jobs.gamesindustry.biz/company/a' })
