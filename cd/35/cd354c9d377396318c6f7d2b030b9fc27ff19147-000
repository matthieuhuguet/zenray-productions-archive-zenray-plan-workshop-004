    const positions = [{ id: 'p1', name: '3D Environment Artist', url: 'https://acme.breezy.hr/p/p1-env', published_date: '2026-04-09T13:37:28Z', type: { name: 'Full-Time' }, location: { city: 'Copenhagen', country: { id: 'DK', name: 'Denmark' }, is_remote: false } }, { id: 'p2', name: 'Accountant', url: 'https://acme.breezy.hr/p/p2' }]
