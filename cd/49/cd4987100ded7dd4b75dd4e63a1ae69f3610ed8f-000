import React, { useEffect, useRef, useState } from 'react'
import Icon from '../components/Icon.jsx'

// Panneau "Regarder" dans Create (retour Matthieu 2026-07-17) : ouvert depuis un résultat de recherche
// YouTube tapé dans la sidebar gauche. CONTRAINTE ABSOLUE de Matthieu : aucune recommandation YouTube, ni
// avant, ni pendant, ni après. D'où :
//  - instanciation par l'IFrame Player API (new YT.Player), PAS une simple <iframe src=...> -- seule l'API
//    JS permet d'écouter onStateChange et donc de réagir à la fin de la vidéo ;
//  - playerVars: { rel: 0, modestbranding: 1 } -- rel:0 depuis 2018 limite déjà les suggestions à la MÊME
//    chaîne (YouTube a retiré la possibilité de les supprimer totalement), modestbranding réduit le branding ;
//  - sur ENDED, démontage IMMÉDIAT du lecteur (player.destroy() + vidage du conteneur) : aucun écran de fin
//    ne doit avoir le temps de s'afficher ;
//  - filet de sécurité : un timer calé sur getDuration() déclenche le même démontage au cas où l'événement
//    ENDED tarderait ou ne se déclenche pas (bug navigateur, vidéo sans son de fin, etc.).
let apiLoadPromise = null
function loadYouTubeIframeAPI() {
  if (window.YT && window.YT.Player) return Promise.resolve()
  if (apiLoadPromise) return apiLoadPromise
  apiLoadPromise = new Promise((resolve) => {
    const previous = window.onYouTubeIframeAPIReady
    window.onYouTubeIframeAPIReady = () => { previous?.(); resolve() }
    const tag = document.createElement('script')
    tag.src = 'https://www.youtube.com/iframe_api'
    document.head.appendChild(tag)
  })
  return apiLoadPromise
}

export default function YouTubeWatchPanel({ videoId, onClose }) {
  const mountRef = useRef(null)
  const playerRef = useRef(null)
  const endTimerRef = useRef(null)
  const endedRef = useRef(false)
  const [error, setError] = useState('')

  useEffect(() => {
    endedRef.current = false
    let cancelled = false

    const teardown = () => {
      if (endedRef.current) return
      endedRef.current = true
      if (endTimerRef.current) { clearTimeout(endTimerRef.current); endTimerRef.current = null }
      try { playerRef.current?.destroy() } catch {}
      playerRef.current = null
      onClose?.()
    }

    loadYouTubeIframeAPI().then(() => {
      if (cancelled || !mountRef.current) return
      try {
        playerRef.current = new window.YT.Player(mountRef.current, {
          videoId,
          playerVars: { rel: 0, modestbranding: 1, autoplay: 1 },
          events: {
            onReady: () => {
              // Filet de sécurité (retour Matthieu) : ENDED peut tarder -- un timer calé sur la durée réelle
              // garantit qu'aucun écran de fin YouTube ne s'affiche même une fraction de seconde.
              try {
                const duration = playerRef.current?.getDuration?.() || 0
                if (duration > 0) {
                  endTimerRef.current = setTimeout(teardown, (duration + 0.75) * 1000)
                }
              } catch {}
            },
            onStateChange: (event) => {
              if (event.data === window.YT.PlayerState.ENDED) teardown()
            },
            onError: () => setError('Vidéo indisponible.'),
          },
        })
      } catch (e) {
        setError(e?.message || 'Lecteur YouTube indisponible.')
      }
    })

    return () => {
      cancelled = true
      if (endTimerRef.current) clearTimeout(endTimerRef.current)
      try { playerRef.current?.destroy() } catch {}
      playerRef.current = null
    }
  }, [videoId]) // eslint-disable-line react-hooks/exhaustive-deps

  return (
    <div style={{ position: 'absolute', inset: 0, display: 'flex', flexDirection: 'column', background: '#000' }}>
      <button onClick={onClose} title="Fermer"
        style={{ position: 'absolute', top: 12, right: 12, zIndex: 2, width: 34, height: 34, borderRadius: 999, display: 'grid', placeItems: 'center', background: 'rgba(0,0,0,.5)', color: '#fff', border: 'none', cursor: 'pointer' }}>
        <Icon name="xmark" size={16} />
      </button>
      {error ? (
        <div style={{ margin: 'auto', color: '#fff', fontSize: 'var(--zr-ui-lg)' }}>{error}</div>
      ) : (
        <div ref={mountRef} style={{ flex: 1, width: '100%' }} />
      )}
    </div>
  )
}
