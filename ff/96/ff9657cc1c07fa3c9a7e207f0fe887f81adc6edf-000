  'M23.0815 16.2373C23.0815 16.8614 23.623 17.371 24.2279 17.371L31.3475 17.371C31.959 17.371 32.4746 16.8421 32.4746 16.2373C32.4746 15.6258 31.9524 15.1035 31.3475 15.1035L24.2279 15.1035C23.6164 15.1035 23.0815 15.6197 23.0815 16.2373Z',
  'M21.0771 11.3975C21.5361 11.8498 22.2622 11.8305 22.6885 11.3975L27.7224 6.35088C28.1494 5.91127 28.1428 5.18518 27.7224 4.75881C27.2828 4.32521 26.5567 4.33184 26.1237 4.75881L21.0771 9.78609C20.6441 10.2191 20.6381 10.9518 21.0771 11.3975Z',
