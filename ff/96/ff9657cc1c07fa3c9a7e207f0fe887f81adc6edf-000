]

// L'ordre ANGULAIRE des tracés ci-dessus, pour que la lumière tourne au lieu de sauter.
// Index dans BRANCHES, en partant du haut et en tournant dans le sens des aiguilles.
const ORDRE = [7, 6, 5, 4, 3, 2, 1, 0]

export const DUREE_SPINNER = 0.8   // secondes pour un tour complet, paramètre unique

export default function SpinnerApple({ taille = 13, couleur = 'currentColor', duree = DUREE_SPINNER, titre = 'En cours…' }) {
  return (
    <svg
      viewBox="0 0 32.4746 32.6096" width={taille} height={taille} role="img" aria-label={titre}
      style={{ flex: `0 0 ${taille}px`, display: 'block' }}
    >
      <title>{titre}</title>
      {ORDRE.map((iTrace, position) => (
        <path
          key={iTrace}
          d={BRANCHES[iTrace]}
          fill={couleur}
          style={{
            // Le décalage est NÉGATIF : l'animation démarre déjà entamée, si bien que les huit
            // branches sont dans huit états différents dès la première image. Un décalage positif
            // les allumerait toutes en même temps pendant le premier tour.
            animation: `zrSpinApple ${duree}s linear ${(-position * duree) / ORDRE.length}s infinite`,
          }}
        />
      ))}
      <style>{`@keyframes zrSpinApple { 0% { opacity: .85 } 100% { opacity: .1 } }`}</style>
    </svg>
  )
}
