# test_stream_banner.py (17 October 2026): the banner follows the batch status, never an older run. Run: python3 -I test_stream_banner.py
import json, sys, tempfile
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from QueueStatus import UploadQueue
import StreamBatchBanner as B

with tempfile.TemporaryDirectory() as d:
    live = Path(d) / 'LiveTransferStatus.json'
    live.write_text(json.dumps({'status': 'retrying', 'currentItem': 'Bleach S17E40.mkv', 'completedUnits': 217, 'totalUnits': 230}))
    q = UploadQueue(Path(d), ['A.mkv', 'B.mkv'])
    B.apply_films(q, live, {'A.mkv': {'status': 'staging'}, 'B.mkv': {'status': 'unloaded'}})
    data = json.loads(live.read_text())
    assert data['currentItem'] == 'A.mkv' and 'Bleach' not in json.dumps(data), data      # no stale Bleach
    assert data['completedUnits'] == 217, data                                           # library totals kept
    stages = {i['name']: i['stage'] for i in json.loads((Path(d) / 'UploadQueueStatus.json').read_text())['items']}
    assert stages == {'A.mkv': 'cmaf', 'B.mkv': 'done'}, stages
    q.set_progress('A.mkv', 40, '1.0 Go envoyes')
    B.apply_films(q, live, {'A.mkv': {'status': 'staging'}, 'B.mkv': {'status': 'unloaded'}})  # same stage again: the percentage stays
    assert json.loads((Path(d) / 'UploadQueueStatus.json').read_text())['items'][0].get('percent') == 40
    B.apply_films(q, live, {'A.mkv': {'status': 'unloaded'}, 'B.mkv': {'status': 'unloaded'}})
    assert json.loads(live.read_text())['status'] == 'idle'
    # the verifier must go red on a wrong mapping (both directions). / FR : le test doit virer au rouge sur un mauvais mapping.
    assert B.stage_of('staged') == 'push' and B.stage_of('published') == 'proof'
    assert B.stage_of('proof-red') == 'failed' and B.stage_of('nonsense') == 'waiting'
print('OK test_stream_banner')
