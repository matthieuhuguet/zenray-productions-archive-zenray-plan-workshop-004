// Heberge une image webp dans un repo GitHub PUBLIC d'assets (memoire permanente, URL chargeable).
// Configurable via env Vercel :
//   GITHUB_TOKEN        : token avec droit contents:write sur le repo d'assets
//   GITHUB_ASSETS_REPO  : "owner/repo" PUBLIC (ex: matthieuhuguet/zenray-progress-assets)
//   GITHUB_ASSETS_BRANCH: branche (defaut "main")
// Si non configure : repond { url: null } et le client garde le dataURL embarque (toujours fonctionnel).

import { logStart, logEnd, describeCommand } from './cmdlog.js'

export default async function handler(req, res) {
  if (req.method !== 'POST') { res.setHeader('Allow', 'POST'); return res.status(405).end() }

  const token = process.env.GITHUB_TOKEN
  const repo = process.env.GITHUB_ASSETS_REPO
  const branch = process.env.GITHUB_ASSETS_BRANCH || 'main'
  if (!token || !repo) return res.status(200).json({ url: null, store: 'none' })

  let body = req.body
  if (typeof body === 'string') { try { body = JSON.parse(body) } catch { body = {} } }
  const dataUrl = body && body.dataUrl
  if (!dataUrl || !dataUrl.startsWith('data:image/')) return res.status(400).json({ url: null, error: 'bad dataUrl' })

  const b64 = dataUrl.split(',')[1]
  const ts = Date.now()
  const rand = Math.random().toString(36).slice(2, 8)
  const path = `uploads/${ts}-${rand}.webp`

  const logId = logStart({ repo, dir: `contents/${path}`, action: 'put', command: describeCommand('PUT', `contents/${path}`) })
  try {
    const r = await fetch(`https://api.github.com/repos/${repo}/contents/${path}`, {
      method: 'PUT',
      headers: {
        Authorization: `Bearer ${token}`,
        Accept: 'application/vnd.github+json',
        'User-Agent': 'zenray-progress',
      },
      body: JSON.stringify({ message: 'media blob', content: b64, branch }),
    })
    if (!r.ok) { const t = await r.text(); logEnd(logId, { httpStatus: r.status, detail: t.slice(0, 200) }); return res.status(200).json({ url: null, store: 'error', detail: t.slice(0, 200) }) }
    logEnd(logId, { httpStatus: r.status })
    const url = `https://raw.githubusercontent.com/${repo}/${branch}/${path}`
    return res.status(200).json({ url, store: 'github' })
  } catch (e) {
    logEnd(logId, { status: 'failed', detail: e && e.message })
    return res.status(200).json({ url: null, store: 'error' })
  }
}
