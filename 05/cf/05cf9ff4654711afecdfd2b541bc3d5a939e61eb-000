#!/usr/bin/env node
// CheckCatalogue.mjs (12 October 2026, 11:40 CEST): verifies the ZenRay Motion Design catalogue of a zenray-data clone
// against the invariants of R06 section 9.2 (neutral ids, every cited path present in the same tree, pinned jsDelivr
// posters, numbers in range, size bound). Prints JSON, exit 0 when green, 1 when red.
// Usage: node scripts/Motion/CheckCatalogue.mjs [--clone <zenray-data clone>]
// FR : verifie le catalogue d'un clone de zenray-data ; vert = code 0, rouge = code 1.
import fs from 'node:fs'
import path from 'node:path'
import { MOTION_CONFIG, checkCatalogue, cloudPath } from './MotionPublish.mjs'

const i = process.argv.indexOf('--clone')
const clone = path.resolve(i >= 0 ? process.argv[i + 1] : MOTION_CONFIG.clone)
let catalogue = null
try { catalogue = JSON.parse(fs.readFileSync(path.join(clone, cloudPath(MOTION_CONFIG.files.catalogue)), 'utf8')) } catch {}
const problems = checkCatalogue(catalogue, (rel) => typeof rel === 'string' && fs.existsSync(path.join(clone, rel)))
console.log(JSON.stringify({ ok: problems.length === 0, clone, motions: catalogue?.motions?.length ?? 0, problems }))
process.exit(problems.length ? 1 : 0)
