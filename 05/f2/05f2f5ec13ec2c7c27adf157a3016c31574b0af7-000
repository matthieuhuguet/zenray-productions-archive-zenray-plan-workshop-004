// Garde-fou anti-injection : une URL distante (unfurl, thumbnail) ne doit JAMAIS être interpolée
// telle quelle dans du CSS `url("...")` (un `")` la ferait sortir du contexte et injecter du style).
// safeImg renvoie l'URL uniquement si elle est http(s) ou data:image ET sans caractère dangereux
// (guillemets, parenthèses, chevrons, antislash, espaces), sinon null.
export function safeImg(u) {
  if (typeof u !== 'string' || !u) return null
  if (/["'()<>\\\s]/.test(u)) return null
  if (!/^https?:\/\//i.test(u) && !/^data:image\//i.test(u)) return null
  return u
}
