// Fusion non destructive de deux versions d'un board (plan §4.3 + P0 "deux onglets ne se détruisent pas").
//
// Stratégie : `items` est un objet indexé par id, chaque item porte un `updatedAt`. Pour fusionner LOCAL
// (mes modifs) et REMOTE (ce qui est sur GitHub maintenant), on prend item par item le plus RÉCENT.
// Un item présent d'un seul côté est conservé (on n'efface jamais un ajout de l'autre onglet).
//
// Suppressions : pour distinguer "jamais vu" de "supprimé", on garde une tombstone légère `deletedAt`.
// Un item supprimé localement (item.deleted = true, item.updatedAt récent) gagne sur un item remote plus ancien.

const at = (it) => (it && it.updatedAt) ? Date.parse(it.updatedAt) || 0 : 0

export function mergeItems(localItems = {}, remoteItems = {}) {
  const out = {}
  const ids = new Set([...Object.keys(localItems), ...Object.keys(remoteItems)])
  for (const id of ids) {
    const l = localItems[id], r = remoteItems[id]
    if (l && !r) { out[id] = l; continue }
    if (r && !l) { out[id] = r; continue }
    out[id] = at(l) >= at(r) ? l : r // égalité -> on garde le local (mes intentions priment à temps égal)
  }
  // On retire les tombstones résolues (item.deleted gagnant) pour ne pas faire grossir le board indéfiniment.
  for (const id of Object.keys(out)) if (out[id] && out[id].deleted) delete out[id]
  return out
}

// Fusionne deux boards entiers. base/local = ce que j'ai en main, remote = relu juste avant save.
// On garde le titre/settings du plus récent au niveau board (updatedAt board), les items au cas par cas.
export function mergeCanvas(local, remote) {
  if (!remote) return local
  if (!local) return remote
  const localNewer = (Date.parse(local.updatedAt) || 0) >= (Date.parse(remote.updatedAt) || 0)
  const head = localNewer ? local : remote
  return {
    ...remote,
    ...local,
    title: head.title,
    settings: head.settings,
    tldraw: head.tldraw,
    items: mergeItems(local.items || {}, remote.items || {}),
    updatedAt: new Date().toISOString(),
  }
}
