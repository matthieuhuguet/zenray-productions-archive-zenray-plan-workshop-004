// 3 October 2026, 13:14 : Webhooks, API keys, connected assistants (OAuth) and the monthly spend cap. A secret (webhook signing secret, API key)
// is shown ONCE, at creation, in a box you must copy from: PostKit stores only a hash or a sealed value. (3 October 2026)
import React, { useState } from 'react'
import { useAction, useQuery } from './usePostKit.js'
import { Badge, Btn, Card, Copy, Empty, ErrorLine, Field, StatusBadge, ago, when } from './ui.jsx'

const EVENTS = ['post.published', 'post.partial', 'post.failed', 'message.received', 'comment.received', 'comment.dm_sent', 'broadcast.finished', 'account.disconnected', 'usage.threshold_reached']

function Secret({ label, value, onClose }) {
  return <div className="zr-pk-secret" role="status"><strong>{label}: shown once, copy it now.</strong><div className="zr-pk-command"><code>{value}</code><Copy text={value} /></div><Btn onClick={onClose}>I stored it</Btn></div>
}

function Webhooks({ client }) {
  const list = useQuery(client, '/v1/webhooks')
  const [url, setUrl] = useState('')
  const [events, setEvents] = useState([])
  const [secret, setSecret] = useState(null)
  const [open, setOpen] = useState(null)
  const deliveries = useQuery(client, open ? `/v1/webhooks/${open}/deliveries` : null, { enabled: !!open })
  const act = useAction(list.reload)
  return (
    <Card title="Webhooks">
      {secret && <Secret label="Signing secret" value={secret} onClose={() => setSecret(null)} />}
      <ErrorLine error={list.error} />
      {list.data?.webhooks?.length ? <ul className="zr-pk-list">{list.data.webhooks.map((w) => (
        <li key={w.id} className="zr-pk-li"><div className="zr-pk-row"><code>{w.url}</code><Badge tone={w.enabled ? 'ok' : 'muted'}>{w.enabled ? 'enabled' : 'paused'}</Badge><span className="zr-pk-meta">{w.events.length ? w.events.join(', ') : 'all events'}</span><span className="zr-pk-spacer" />
          <Btn onClick={() => setOpen(open === w.id ? null : w.id)}>Deliveries</Btn><Btn busy={act.busy} onClick={() => act.run(() => client.patch(`/v1/webhooks/${w.id}`, { enabled: !w.enabled }))}>{w.enabled ? 'Pause' : 'Resume'}</Btn><Btn tone="danger" busy={act.busy} onClick={() => act.run(() => client.del(`/v1/webhooks/${w.id}`))}>Delete</Btn></div>
          {open === w.id && (deliveries.data?.deliveries?.length ? <table className="zr-pk-table"><thead><tr><th>Event</th><th>Status</th><th>Attempts</th><th>Last</th></tr></thead><tbody>{deliveries.data.deliveries.map((d) => <tr key={d.id}><td>{d.type}</td><td><StatusBadge status={d.status} /></td><td>{d.attempts}</td><td>{d.lastError || (d.deliveredAt ? ago(d.deliveredAt) : '')}</td></tr>)}</tbody></table> : <Empty>No delivery yet.</Empty>)}</li>))}</ul> : <Empty>No webhook endpoint.</Empty>}
      <details className="zr-pk-details"><summary>New endpoint</summary>
        <Field label="HTTPS URL"><input value={url} onChange={(e) => setUrl(e.target.value)} placeholder="https://example.com/hooks/postkit" /></Field>
        <div className="zr-pk-chips">{EVENTS.map((ev) => <label key={ev} className={`zr-pk-pick${events.includes(ev) ? ' is-on' : ''}`}><input type="checkbox" checked={events.includes(ev)} onChange={(e) => setEvents(e.target.checked ? [...events, ev] : events.filter((x) => x !== ev))} />{ev}</label>)}</div>
        <p className="zr-pk-meta">No event selected means every event, including ones added later. Deliveries are signed (x-postkit-signature) and retried up to 6 times; dedupe on the event id.</p>
        <Btn tone="primary" busy={act.busy} disabled={!url} onClick={() => act.run(async () => { const w = await client.post('/v1/webhooks', { url, events }); setSecret(w.secret); setUrl(''); setEvents([]) })}>Create</Btn><ErrorLine error={act.error} /></details>
    </Card>
  )
}

function Keys({ client }) {
  const list = useQuery(client, '/v1/api-keys')
  const [name, setName] = useState('')
  const [readOnly, setReadOnly] = useState(false)
  const [secret, setSecret] = useState(null)
  const act = useAction(list.reload)
  return (
    <Card title="API keys">
      {secret && <Secret label="API key" value={secret} onClose={() => setSecret(null)} />}
      <ErrorLine error={list.error} />
      {list.data?.apiKeys?.length ? <ul className="zr-pk-list">{list.data.apiKeys.map((k) => (
        <li key={k.id} className="zr-pk-li zr-pk-row"><strong>{k.name}</strong><code>{k.prefix}…</code><Badge tone={k.revokedAt ? 'bad' : 'ok'}>{k.revokedAt ? 'revoked' : k.scopes.includes('write') ? 'full access' : 'read only'}</Badge><span className="zr-pk-meta">{k.lastUsedAt ? `used ${ago(k.lastUsedAt)}` : 'never used'}</span><span className="zr-pk-spacer" />
          {!k.revokedAt && <><Btn busy={act.busy} onClick={() => act.run(async () => setSecret((await client.post(`/v1/api-keys/${k.id}/roll`)).key))}>Rotate</Btn><Btn tone="danger" busy={act.busy} onClick={() => confirm(`Revoke "${k.name}" at once? Anything using it stops working.`) && act.run(() => client.del(`/v1/api-keys/${k.id}`))}>Revoke</Btn></>}</li>))}</ul> : <Empty>No key.</Empty>}
      <div className="zr-pk-inline"><input value={name} onChange={(e) => setName(e.target.value)} placeholder="Key name" aria-label="Key name" /><label className="zr-pk-check"><input type="checkbox" checked={readOnly} onChange={(e) => setReadOnly(e.target.checked)} /> read only</label><Btn tone="primary" busy={act.busy} disabled={!name} onClick={() => act.run(async () => { const k = await client.post('/v1/api-keys', { name, scopes: readOnly ? ['read'] : ['read', 'write'] }); setSecret(k.key); setName('') })}>Create key</Btn></div>
      <ErrorLine error={act.error} />
    </Card>
  )
}

function ConnectedApps({ client }) {
  const list = useQuery(client, '/v1/connected-apps')
  const act = useAction(list.reload)
  return (
    <Card title="Connected assistants (OAuth)" aside={<code className="zr-pk-meta">{client.baseUrl}/mcp</code>}>
      <p className="zr-pk-meta">Add this MCP URL to Claude, ChatGPT, Cursor or VS Code as a custom connector. Approve it on the consent page with your owner passphrase; revoke it here.</p>
      <ErrorLine error={list.error} />
      {list.data?.apps?.length ? <ul className="zr-pk-list">{list.data.apps.map((a) => <li key={a.id} className="zr-pk-li zr-pk-row"><strong>{a.clientName}</strong><Badge tone="muted">{a.scopes.join(' ')}</Badge><span className="zr-pk-meta">{a.lastUsedAt ? `used ${ago(a.lastUsedAt)}` : `connected ${when(a.createdAt)}`}</span><span className="zr-pk-spacer" /><Btn tone="danger" busy={act.busy} onClick={() => act.run(() => client.del(`/v1/connected-apps/${a.id}`))}>Revoke</Btn></li>)}</ul> : <Empty>No assistant connected.</Empty>}
    </Card>
  )
}

function Spend({ client, overview, reload }) {
  const { usage, subscription } = overview.data
  const [cap, setCap] = useState('')
  const act = useAction(reload)
  return (
    <Card title="Metered spend" aside={<Badge tone={subscription.cap_is_default ? 'muted' : 'info'}>{subscription.cap_is_default ? 'default cap' : 'your cap'}</Badge>}>
      <dl className="zr-pk-dl"><dt>This month</dt><dd>${usage.total_usd} of ${usage.cap_usd} (${usage.remaining_usd} left)</dd><dt>Breakdown</dt><dd>{usage.breakdown.length ? usage.breakdown.map((b) => `${b.operation} ×${b.quantity} = $${b.cost_usd}`).join(' · ') : 'nothing billed'}</dd></dl>
      <p className="zr-pk-meta">There is no unlimited: clearing the cap returns to the $20 default. At 100% background collection stops; publishing and sending never do.</p>
      <div className="zr-pk-inline"><input inputMode="decimal" value={cap} onChange={(e) => setCap(e.target.value)} placeholder="Monthly cap in USD" aria-label="Monthly cap" /><Btn busy={act.busy} disabled={!(Number(cap) > 0)} onClick={() => act.run(() => client.post('/v1/billing/spend-cap', { capUsd: Number(cap) }))}>Set cap</Btn><Btn busy={act.busy} onClick={() => act.run(() => client.post('/v1/billing/spend-cap', { capUsd: null }))}>Back to default</Btn></div>
      <ErrorLine error={act.error} />
    </Card>
  )
}

export default function DevelopersPanel({ client, overview, reload }) {
  return (<><Webhooks client={client} /><div className="zr-pk-grid2"><Keys client={client} /><ConnectedApps client={client} /></div><Spend client={client} overview={overview} reload={reload} /></>)
}
