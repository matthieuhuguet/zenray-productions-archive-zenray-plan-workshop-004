// 14 October 2026: the push is sized by the MEASURED line. Matthieu's connection can change, and a batch can be 15 or 1 500 files.
describe('throughput sizing (14 October 2026)', () => {
  const MiBs = 1048576
  const PART = 95 * MiBs + 16
  const success = (controller, bytes, seconds) => controller.recordSuccess({ headId: `b${Math.random()}`, count: Math.round(bytes / PART), bytes, durationMs: seconds * 1000 })
  const budgetParts = (controller) => controller.budgetBytes() / PART

  it('keeps the full 20 parts on a fast line and shrinks on a slow one', () => {
    const fast = createPushController(config({}, { rampStartParts: 20 }))
    success(fast, 1900 * MiBs, 170) // 11.2 MB/s
    expect(budgetParts(fast)).toBeCloseTo(20, 0)
    const slow = createPushController(config({}, { rampStartParts: 20 }))
    success(slow, 380 * MiBs, 380) // 1 MB/s
    expect(budgetParts(slow)).toBeLessThan(4)
    expect(budgetParts(slow)).toBeGreaterThanOrEqual(1) // a part is the atomic unit
  })
  it('follows a line that gets faster and slower again (average with weight 0.3)', () => {
    const controller = createPushController(config({}, { rampStartParts: 20 }))
    const seen = []
    for (const mbps of [11, 11, 2, 2, 2, 2, 11, 11, 11, 11]) {
      success(controller, 600 * MiBs, (600 * 1.048576) / mbps)
      seen.push(Math.round(budgetParts(controller)))
    }
    expect(seen[0]).toBe(20)
    expect(Math.min(...seen.slice(2, 6))).toBeLessThan(16) // the slow stretch shrinks the batch
    expect(seen[9]).toBeGreaterThan(seen[5]) // and the fast line gets it back
  })
  it('ignores small pushes, and the switch off value 0 keeps the old behaviour (red controls)', () => {
    const controller = createPushController(config({}, { rampStartParts: 20 }))
    success(controller, 10 * MiBs, 100) // 0.1 MB/s but only 10 MiB: not a sample
    expect(budgetParts(controller)).toBeCloseTo(20, 0)
    const off = createPushController(config({ ZR_PUSH_THROUGHPUT_SIZING: '0' }, { rampStartParts: 20 }))
    success(off, 380 * MiBs, 380)
    expect(budgetParts(off)).toBeCloseTo(20, 0)
  })
  it('is carried between processes by the state file (one process per film)', () => {
    const stateFile = path.join(mkdtempSync(path.join(tmpdir(), 'zr-throughput-')), 'state.json')
    const first = createPushController(config({ ZR_PUSH_STATE_FILE: stateFile }, { rampStartParts: 20 }))
    success(first, 380 * MiBs, 380)
    const second = createPushController(config({ ZR_PUSH_STATE_FILE: stateFile }, { rampStartParts: 20 }))
    expect(second.state().throughputBps).toBeGreaterThan(900000)
    expect(budgetParts(second)).toBeLessThan(4)
  })
})

describe('hiccups are learned (14 October 2026)', () => {
  it('a flaky line lowers the aimed push duration, a clean hour raises it', () => {
    const controller = createPushController(config({}, { rampStartParts: 20 }))
    const clean = controller.state().targetSeconds
    for (let i = 0; i < 4; i += 1) controller.recordFailure(`b${i}`, { count: 8, bytes: 760 * 1048576, durationMs: 60000 }, 'transient')
    expect(controller.state().hiccups).toBe(4)
    expect(controller.state().targetSeconds).toBeLessThan(clean)
    expect(controller.state().targetSeconds).toBeGreaterThanOrEqual(60)
  })
})

describe('adapter for the scripts with their own push loop (14 October 2026)', () => {
  it('follows the measured line, reports hiccups, ignores permanent refusals and honours a fixed batch (red controls)', async () => {
    const { sharedBatchAdapter } = await import('./push-batch-policy.mjs')
    const MiBs = 1048576
    const slow = sharedBatchAdapter({ controller: createPushController(config({}, { rampStartParts: 20 })) })
    expect(slow.budgetBytes() / MiBs).toBeGreaterThan(1800) // before any measure: the full level
    slow.track(380 * MiBs, 4).ok(380000) // 1 MB/s
    expect(slow.budgetBytes() / MiBs).toBeLessThan(400)
    const batch = slow.track(300 * MiBs, 3)
    batch.fail(5000, 'fatal: unable to access: Could not resolve host') // a hiccup, counted
    expect(slow.controller.state().hiccups).toBe(1)
    batch.fail(5000, 'remote: error: GH013: Repository rule violations found') // permanent: not a hiccup
    expect(slow.controller.state().hiccups).toBe(1)
    expect(slow.timeoutMs(1900 * MiBs)).toBeGreaterThanOrEqual(30 * 60 * 1000)
    const fixed = sharedBatchAdapter({ controller: createPushController(config({ ZR_SHARD_PUSH_BATCH_MB: '400' })) })
    expect(fixed.budgetBytes()).toBe(400 * MiBs)
  })
})
