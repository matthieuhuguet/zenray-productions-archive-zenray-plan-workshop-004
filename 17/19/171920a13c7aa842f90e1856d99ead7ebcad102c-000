import React, { useCallback, useEffect, useState } from 'react'
import RefBoardHost from './RefBoardHost.jsx'
import { listChildren, saveJson, saveText } from './content.js'
import { makeCanvas } from './schema.js'
import { newId } from './schema.js'
import Icon from '../components/Icon.jsx'
import { notify } from '../components/Notifications.jsx'
import { PALETTE, RADII } from '../theme.js'

// RefApp (lot B) — l'application Ref : un onglet à part entière (plan §6 Phase 1, §2 nommage).
// Premier écran = OUTIL, pas landing : liste des projets/boards, et ouverture directe d'un board (drop/paste).
//
// Stockage (architecture existante, 0 nouveau backend) : tout vit dans zenray-data via /api/page sous pages/Ref/.
//   pages/Ref/<Projet>.md            (page Create normale : recherchable, liable, publiable)
//   pages/Ref/<Projet>/Boards/<Board>.canvas.json   (board, type de nœud du lot A)
//   pages/Ref/<Projet>/Assets|Embeds (médias importés)
//
// Un board ouvert s'ouvre dans CanvasNodeViewer (lot A) via RefBoardHost (qui ajoute drop/paste médias).

const SANS = "var(--zr-police-sans)"
const ROOT = 'pages/Ref'

const slug = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || 'item'
const prettyName = (s) => String(s || '')   // les tirets restent, voir lib/pgPretty.js

export default function RefApp({ t }) {
  const tt = t || {}
  const [projects, setProjects] = useState(null)   // [{ name, dir }]
  const [project, setProject] = useState(null)     // dir sélectionné
  const [boards, setBoards] = useState(null)       // [{ name, path }]
  const [open, setOpen] = useState(() => { try { const p = localStorage.getItem('zr:ref:board'); return p ? { path: p } : null } catch { return null } })
  const [busy, setBusy] = useState('')

  useEffect(() => { try { if (open && open.path) localStorage.setItem('zr:ref:board', open.path); else localStorage.removeItem('zr:ref:board') } catch {} }, [open])

  // Liste des projets = sous-dossiers de pages/Ref/.
  const loadProjects = useCallback(() => {
    listChildren(ROOT).then((entries) => {
      const dirs = entries.filter((e) => e.type === 'dir').map((e) => ({ name: e.name, dir: e.path }))
      setProjects(dirs)
      if (!project && dirs.length) setProject(dirs[0].dir)
    })
  }, [project])

  useEffect(() => { loadProjects() }, []) // au montage

  // Boards d'un projet = .ref.json (nouveau nom ZenRay Ref, 2026-07-19) OU .canvas.json (rétrocompat)
  // sous <projet>/Boards/.
  const loadBoards = useCallback((dir) => {
    if (!dir) { setBoards([]); return }
    listChildren(dir + '/Boards').then((entries) => {
      const bs = entries.filter((e) => e.type !== 'dir' && /\.(canvas|ref)\.json$/.test(e.name || e.path || '')).map((e) => ({ name: (e.name || e.path.split('/').pop()).replace(/\.(canvas|ref)\.json$/, ''), path: e.path }))
      setBoards(bs)
    })
  }, [])

  useEffect(() => { if (project) loadBoards(project) }, [project, loadBoards])

  const newProject = async () => {
    const title = (window.prompt('Nom du projet Ref ?', 'Moodboard') || '').trim()
    if (!title) return
    const dir = `${ROOT}/${slug(title)}-${newId('p').slice(-4)}`
    setBusy('Création du projet…')
    // Page Create normale (md + .props.json) pour rester recherchable/publiable, puis un board initial.
    await saveText(`${dir}.md`, `# ${title}\n\nProjet Ref.\n`)
    await saveJson(`${dir}.props.json`, { icon: 'square.grid.2x2', kind: 'ref-project' })
    const boardPath = `${dir}/Boards/${slug('Board')}.ref.json`
    await saveJson(boardPath, makeCanvas({ projectPath: boardPath, title: 'Board' }))
    setBusy('')
    loadProjects(); setProject(dir); setOpen({ path: boardPath })
    notify({ icon: 'square.grid.2x2', tint: PALETTE.primary, label: 'Ref', title: 'Projet créé', body: title })
  }

  const newBoard = async () => {
    if (!project) return
    const title = (window.prompt('Nom du board ?', 'Board') || '').trim()
    if (!title) return
    const path = `${project}/Boards/${slug(title)}-${newId('b').slice(-4)}.ref.json`
    setBusy('Création du board…')
    await saveJson(path, makeCanvas({ projectPath: path, title }))
    setBusy('')
    loadBoards(project); setOpen({ path })
  }

  // ── Board ouvert : plein écran, drop/paste médias via RefBoardHost ───────────────────────────────
  if (open && open.path) {
    // Le board reste DANS la zone contenu (jamais un overlay plein écran) : la sidebar de l'app reste
    // toujours accessible pour naviguer. `isolation:isolate` confine les z-index internes de tldraw.
    return (
      <div style={{ display: 'flex', flexDirection: 'column', height: 'calc(100vh - 150px)', minHeight: 460, border: '1px solid color-mix(in srgb, var(--g9-fg) 12%, transparent)', borderRadius: 20, overflow: 'hidden', background: tt.bg || '#FDFDFC', isolation: 'isolate' }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '8px 14px', borderBottom: '1px solid color-mix(in srgb, var(--g9-fg) 10%, transparent)', flex: '0 0 auto' }}>
          <button onClick={() => { setOpen(null); if (project) loadBoards(project) }} style={ghost(tt)}><Icon name="chevron.left" size={15} weight={2} /> Ref</button>
          <span style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-md)', fontWeight: 400, color: 'var(--g9-fg)' }}>{prettyName(open.path.split('/').pop().replace(/\.(canvas|ref)\.json$/, '').replace(/-[a-z0-9]{1,6}$/, ''))}</span>
          <span style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-2xs)', fontWeight: 300, color: 'var(--g9-muted)', marginLeft: 'auto' }}>images du drive via l’outil photo de la barre gauche · glisser des fichiers Finder · coller une URL YouTube</span>
        </div>
        <div style={{ flex: 1, minHeight: 0 }}>
          <RefBoardHost t={t} path={open.path} title={prettyName(open.path)} theme={tt && tt.textPrimary && tt.bg === '#1d1d1f' ? 'dark' : 'light'} />
        </div>
      </div>
    )
  }

  // ── Écran d'accueil : projets + boards ────────────────────────────────────────────────────────────
  return (
    <div style={{ fontFamily: SANS }}>
      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 12, flexWrap: 'wrap', marginBottom: 18 }}>
        <div>
          <div style={{ fontSize: 28, fontWeight: 400, color: 'var(--g9-fg)' }}>ZenRay Ref</div>
          <div style={{ fontSize: 'var(--zr-ui-md)', fontWeight: 300, color: 'var(--g9-muted)', marginTop: 2 }}>Boards de références (PureRef / Miro) reliés à Create. {busy}</div>
        </div>
        <button onClick={newProject} style={primary()}><Icon name="plus" size={15} weight={2} color="#fff" /> Nouveau projet</button>
      </div>

      {projects === null && <div style={{ color: tt.textSecondary }}>chargement…</div>}
      {projects && projects.length === 0 && (
        <div style={{ border: `1.5px dashed ${tt.border || 'rgba(0,0,0,0.12)'}`, borderRadius: RADII.lg, padding: 40, textAlign: 'center', color: tt.textSecondary }}>
          Aucun projet Ref. Crée le premier : il contiendra des boards où tu déposes images, assets Create, audio et vidéos YouTube.
        </div>
      )}

      {projects && projects.length > 0 && (
        <div style={{ display: 'grid', gridTemplateColumns: '220px 1fr', gap: 18, alignItems: 'start' }}>
          {/* Colonne projets */}
          <div style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
            <div style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-3xs)', textTransform: 'uppercase', letterSpacing: 1, color: tt.textSecondary, margin: '4px 0 6px 6px' }}>Projets</div>
            {projects.map((p) => (
              <button key={p.dir} onClick={() => setProject(p.dir)} style={{ display: 'flex', alignItems: 'center', gap: 8, textAlign: 'left', padding: '7px 10px', borderRadius: 11, border: 'none', cursor: 'pointer', background: project === p.dir ? 'rgba(10,132,255,.13)' : 'transparent', color: project === p.dir ? '#0a84ff' : 'var(--g9-fg)', fontFamily: SANS, fontSize: 'var(--zr-ui-md)', fontWeight: 300, transition: 'background-color var(--g9-timing) var(--g9-ease)' }}>
                <Icon name="square.grid.2x2" size={16} weight={1.6} /> {prettyName(p.name.replace(/-[a-z0-9]{1,6}$/, ''))}
              </button>
            ))}
          </div>
          {/* Boards du projet sélectionné */}
          <div>
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 12 }}>
              <div style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-3xs)', textTransform: 'uppercase', letterSpacing: 1, color: tt.textSecondary }}>Boards</div>
              <button onClick={newBoard} style={ghost(tt)}><Icon name="plus" size={14} weight={2} /> Nouveau board</button>
            </div>
            {boards === null && <div style={{ color: tt.textSecondary }}>chargement…</div>}
            {boards && boards.length === 0 && <div style={{ color: tt.textSecondary, fontSize: 'var(--zr-ui-md)' }}>Aucun board. Crée-en un.</div>}
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill,minmax(170px,1fr))', gap: 12 }}>
              {(boards || []).map((b) => (
                <button key={b.path} onClick={() => setOpen({ path: b.path })} style={{ textAlign: 'left', cursor: 'pointer', border: '1px solid color-mix(in srgb, var(--g9-fg) 12%, transparent)', borderRadius: 14, padding: 0, overflow: 'hidden', background: 'color-mix(in srgb, var(--g9-fg) 4%, transparent)', transition: 'transform var(--g9-timing) var(--g9-ease)' }}>
                  <div style={{ aspectRatio: '4 / 3', background: 'rgba(10,132,255,.10)', display: 'grid', placeItems: 'center', color: '#0a84ff' }}>
                    <Icon name="square.grid.2x2" size={28} weight={1.4} />
                  </div>
                  <div style={{ padding: '8px 10px', fontFamily: SANS, fontSize: 'var(--zr-ui-md)', fontWeight: 400, color: 'var(--g9-fg)' }}>{prettyName(b.name.replace(/-[a-z0-9]{1,6}$/, ''))}</div>
                </button>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  )
}

// Chrome V9 (2026-07-19) : bouton principal = bleu du design (#3b82f7, rim clair, pilule) ; ghost =
// bouton nu sur verre, couleurs par variables --g9-* (deux thèmes, fonts.css).
const primary = () => ({ display: 'inline-flex', alignItems: 'center', justifyContent: 'center', gap: 7, height: 42, background: '#3b82f7', color: '#fff', border: 'none', borderRadius: 999, padding: '0 16px', cursor: 'pointer', fontFamily: SANS, fontSize: 'var(--zr-ui-md)', fontWeight: 400, boxShadow: 'inset 0 1px 0 rgba(255,255,255,.46), inset 0 -1px 0 rgba(255,255,255,.46), 0 8px 23px rgba(59,130,247,.24)', transition: 'transform var(--g9-timing) var(--g9-ease), filter var(--g9-timing) var(--g9-ease)' })
const ghost = () => ({ display: 'inline-flex', alignItems: 'center', gap: 6, background: 'transparent', color: 'var(--g9-muted)', border: '1px solid color-mix(in srgb, var(--g9-fg) 14%, transparent)', borderRadius: 999, padding: '6px 12px', cursor: 'pointer', fontFamily: SANS, fontSize: 'var(--zr-ui-sm)', fontWeight: 400, transition: 'background-color var(--g9-timing) var(--g9-ease)' })
