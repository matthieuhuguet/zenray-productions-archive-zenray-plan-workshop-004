// 2026-09-23 20:50 : the play badge pattern must not let a double click reach the tile.
import { it, expect, vi } from 'vitest'
import { render, fireEvent } from '@testing-library/react'

it('a double click on the badge never triggers the tile double click', () => {
  const openFull = vi.fn(); const play = vi.fn()
  const { getByRole } = render(
    <button onDoubleClick={openFull}>
      <span role="button" aria-label="Lire" onClick={(ev) => { ev.stopPropagation(); if (ev.detail > 1) return; play() }}
        onDoubleClick={(ev) => { ev.stopPropagation(); ev.preventDefault() }} />
    </button>,
  )
  const badge = getByRole('button', { name: 'Lire' })
  fireEvent.click(badge, { detail: 1 }); fireEvent.click(badge, { detail: 2 }); fireEvent.doubleClick(badge)
  expect(play).toHaveBeenCalledTimes(1)
  expect(openFull).not.toHaveBeenCalled()
})
