// upload-img-list.mjs — uploade une LISTE d'images via le pipeline image (chiffré + découpé en morceaux ≤19 Mo,
// tout servi par jsDelivr). Modèle EN LOTS (2026-07-12, demande Matthieu « gros lots façon vidéo ~900 Mo » pour
// la VITESSE) : on INGÈRE plusieurs images dans le shard, puis dès que ~900 Mo sont accumulés on flush UNE fois
// (un seul push shard) -> on résout TOUS les manifestes du lot -> on les committe ENSEMBLE sur zenray-data (un
// seul commit) -> on vérifie jsDelivr UNE fois par (repo,commit) du lot. Bien plus rapide que l'ancien mode
// « un push git par image » : sur ~480 images, ~4-5 push shard au lieu de ~480 et ~5 commits zenray-data au
// lieu de ~480 (l'essentiel du temps par image était justement ce push + ce commit + la vérif à retries).
//
// PATRON RÉUTILISÉ, JAMAIS RÉINVENTÉ : flushBatch() est calqué sur scripts/upload-img-all.mjs (ctx.flush ->
// resolveImgManifest pour tout le lot -> pushBlobs groupé). img-ingest.mjs n'est PAS touché : chaque `pending`
// capture DÉJÀ son propre repo à l'ingestion (pending.repo, img-ingest.mjs:210/231) et ctx.commitOf mappe
// repo->commit (rempli AU ROLLOVER, img-ingest.mjs:160, ET AU FLUSH, :149). Donc un lot qui franchit une
// frontière de shard (rollover au cap dur 4,3 Go) résout chaque manifeste sur le BON commit, sans une ligne de
// logique en plus ici. Vérifié par lecture du code + hérité de upload-img-all.mjs (tourné sur des runs multi-Go).
//
// ARBITRAGE ASSUMÉ (inverse de la demande « média par média » du 2026-07-11) : en mode lot, les images
// n'apparaissent dans Create qu'à la FIN de chaque lot (~900 Mo), pas une par une. ZR_IMG_BATCH_MB=0 rétablit
// l'ancien comportement média-par-média (flush après CHAQUE image) via le MÊME code — un seuil de 0 octet est
// franchi dès la première image, donc aucune branche séparée à maintenir. Reprise après crash : un lot perdu =
// jusqu'à ~900 Mo d'images ré-ingérées au prochain run (binaires orphelins dans un shard neuf, gaspillage borné
// à UN lot ; JAMAIS de tuile en double car le chemin du manifeste est déterministe <dest>/<rel>.img.json).
//
// RÉSILIENCE (symétrique du skip côté vidéo) : saute les images dont le manifeste existe déjà sur zenray-data
// (relance sûre) ; un échec sur UNE image (ingestion OU résolution) ne casse pas le lot (log + continue).
//
// Usage : GITHUB_TOKEN=.. node scripts/upload-img-list.mjs "<dest>" "<img1>" "<img2>" ...
//         ZR_IMG_BATCH_MB=<Mo> optionnel (défaut 900 ; 0 = un flush par image = média par média)

import { makeImgShardCtx, ingestImageBulk, resolveImgManifest } from './img-ingest.mjs'
import { jsDelivrUrl } from './lib/img-pipeline.mjs'
import { pushBlobs } from './video-mse-lib.mjs'
import { appendPublicDelta, thumbsForPaths } from '../server/page.js'
import path from 'node:path'
import { rm, stat } from 'node:fs/promises'

const token = process.env.GITHUB_TOKEN
const OWNER = process.env.CONTENT_OWNER || 'matthieuhuguet'
const REPO = '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress'
const DATA = 'zenray-data'
const dest = process.argv[2]
const files = process.argv.slice(3)
if (!token || !dest || !files.length) { console.error('usage: GITHUB_TOKEN=.. node upload-img-list.mjs <dest> <img...>'); process.exit(1) }

// Seuil de lot. Défaut 900 Mo, aligné sur le push interne de writeBinary (img-ingest.mjs:177) : les deux
// coïncident, donc en pratique jamais deux push réseau consécutifs. ZR_IMG_BATCH_MB=0 -> seuil 0 octet ->
// franchi dès la 1re image -> flush par image = média par média (visibilité immédiate, plus lent), même code.
const _mb = parseFloat(process.env.ZR_IMG_BATCH_MB)
const BATCH_BYTES = (Number.isFinite(_mb) ? _mb : 900) * 1024 * 1024

const manifestPathOf = (rel) => `${dest}/${rel}.img.json`
// déjà en ligne ? (manifeste .img.json présent sur zenray-data). RETRIES réseau, même patron que
// upload-vidraw-list.mjs : un timeout transitoire au démarrage ne doit pas faire sauter une image à tort.
async function alreadyOnline(rel) {
  const p = manifestPathOf(rel)
  for (let a = 0; a < 4; a++) {
    try {
      const r = await fetch(`https://api.github.com/repos/${OWNER}/${DATA}/contents/${encodeURIComponent(p).replace(/%2F/g, '/')}`, { headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zr' } })
      return r.status === 200
    } catch (e) { if (a === 3) { console.log(`  ⚠ réseau (alreadyOnline), on suppose absent: ${rel}`); return false } await new Promise((r) => setTimeout(r, 4000 * (a + 1))) }
  }
  return false
}
// Vérifie une URL jsDelivr avec retries courts (propagation CDN juste après un push tout frais).
async function checkUrl200(url, tries = 4, delayMs = 1500) {
  let code = 0
  for (let a = 0; a < tries && code !== 200; a++) { try { code = (await fetch(url)).status } catch {} ; if (code !== 200) await new Promise((r) => setTimeout(r, delayMs)) }
  return code === 200
}

console.log(`\n=== UPLOAD ${files.length} image(s) -> ${dest} (lots de ${(BATCH_BYTES / 1048576) | 0} Mo) ===`)
// 1) filtrer (skip déjà en ligne), même logique que upload-vidraw-list.mjs.
const cand = []
for (const f of files) {
  const rel = path.basename(f)
  if (await alreadyOnline(rel)) { console.log(`  ⏭  déjà en ligne, sauté: ${rel}`); continue }
  cand.push({ f, rel })
}
console.log(`=== À UPLOADER : ${cand.length} image(s) ===\n`)
// Rien à faire -> ne PAS créer de repo GitHub vide pour rien (bug annexe repéré 2026-07-11 en testant le skip
// « déjà en ligne » : sans cette garde, un relancement où tout est déjà en ligne crée quand même un repo
// zenrayshards-img-<hex> flambant neuf, jamais utilisé).
if (!cand.length) { console.log('rien à uploader (tout déjà en ligne).'); process.exit(0) }

// MODÈLE 2026-07-05 : repo image NEUF par lot (zenrayshards-img-<hex12>, public jsDelivr), zéro clone, zéro
// check distant. Le nom est aléatoire, rien à chercher.
// Espace propre par invocation : deux lots simultanés ne partagent jamais un dépôt local, et le finally
// supprime tous les repos créés par les rollovers du lot (pas seulement le dernier ctx.dir).
const runWork = path.join(process.env.HOME, '.zr-archive-work-img', `run-${process.pid}-${Date.now().toString(36)}`)
const ctx = makeImgShardCtx({
  token,
  work: runWork,
  repoRoot: REPO,
  log: (...a) => console.log('   ', ...a),
})

let done = 0, failed = 0, shardsOk = 0, shardsTot = 0
let batch = []       // { pending, rel } — images ingérées, pas encore flushées/committées
let batchBytes = 0   // octets (taille disque, ≈ ciphertext) accumulés depuis le dernier flush
const indexedPaths = []  // manifestes committés, tous lots confondus -> index-add en fin de script

// Flush d'un lot : push shard UNE fois (ctx.flush enregistre commitOf du repo courant ; les repos déjà
// rolled-over ont le leur depuis le rollover) -> résout TOUS les manifestes -> commit groupé sur zenray-data
// -> vérifie jsDelivr d'UNE URL représentative par (repo,commit) distinct : jsDelivr sert tout l'arbre d'un
// commit, donc vérifier un seul chemin par commit prouve la propagation de TOUS les morceaux de ce commit.
async function flushBatch() {
  if (!batch.length) return
  await ctx.flush()
  const items = []
  for (const b of batch) {
    try { const sb = resolveImgManifest(b.pending, ctx); items.push({ sb, m: JSON.parse(sb.content) }) }
    catch (e) { failed++; console.log(`  ✗ résolution ${b.rel} : ${(e && e.message || e).toString().slice(0, 100)}`) }
  }
  const n = items.length
  batch = []; batchBytes = 0
  if (!n) return
  // commit groupé (tranches de 200 : un POST git/trees à ~950 entrées fait planter GitHub en 502, cf. pushBlobs).
  for (let i = 0; i < n; i += 200) await pushBlobs(token, DATA, items.slice(i, i + 200).map((x) => x.sb), `img lot (${Math.min(200, n - i)})`, () => {})
  for (const x of items) indexedPaths.push(x.sb.path)
  // vérif : une URL représentative par (repo,commit) distinct du lot.
  const seen = new Set()
  for (const x of items) {
    const key = `${x.m.cdnRepo}@${x.m.cdnCommit}`
    if (seen.has(key)) continue
    seen.add(key)
    const c0 = Array.isArray(x.m.cdnChunks) && x.m.cdnChunks[0]
    if (!c0) continue
    shardsTot++
    if (await checkUrl200(jsDelivrUrl(OWNER, x.m.cdnRepo, x.m.cdnCommit, c0))) shardsOk++
    else console.log(`     ⚠ jsDelivr pas encore propagé (${key.slice(0, 46)}…) — cache lag, OK au refresh`)
  }
  done += n
  console.log(`✓✓ LOT — ${n} image(s) en ligne (${done}/${cand.length}), ${seen.size} shard-commit(s), jsDelivr ${shardsOk}/${shardsTot} 200`)
}

try {
  await ctx.openShard()
  for (const c of cand) {
    const { f, rel } = c
    try {
      const sz = (await stat(f)).size
      const pending = await ingestImageBulk(f, rel, dest, ctx)
      batch.push({ pending, rel })
      batchBytes += sz
      console.log(`  · ingérée [${done + batch.length}/${cand.length}] ${rel} (${(sz / 1048576).toFixed(1)} Mo)`)
      if (batchBytes >= BATCH_BYTES) await flushBatch()
    } catch (e) {
      failed++
      console.log(`✗ ÉCHEC ${rel} : ${(e && e.message || e).toString().slice(0, 160)}`)
    }
  }
  await flushBatch() // lot résiduel (le dernier, sous le seuil)
} finally {
  await rm(runWork, { recursive: true, force: true }).catch(() => {})
}
// INDEX-ADD (2026-07-14, bug trouvé par Matthieu) : même correctif que upload-img-list-git.mjs — sans ça,
// les images restent invisibles à la recherche jusqu'au prochain rebuild manuel. Best-effort, jamais fatal.
// PIÈGE CORRIGÉ (2026-07-14) : plusieurs appendPublicDelta séquentiels rapprochés (un par lot de 200)
// s'écrasent via le cache ~5 min de raw.githubusercontent — UN SEUL appel final avec la liste complète.
if (indexedPaths.length) {
  try {
    const allThumbs = {}
    for (let i = 0; i < indexedPaths.length; i += 200) {
      Object.assign(allThumbs, await thumbsForPaths(token, indexedPaths.slice(i, i + 200)))
    }
    const idxOk = await appendPublicDelta(token, indexedPaths, allThumbs)
    console.log(`  index-add : ${idxOk ? indexedPaths.length : 0}/${indexedPaths.length} chemins ajoutés au delta public (cherchables immédiatement)`)
  } catch (e) { console.log(`  ⚠ index-add échoué (rattrapable par scripts/index-add-paths.mjs) : ${(e && e.message || e).toString().slice(0, 120)}`) }
}

console.log(`\n✓✓ BATCH IMG COMPLET — ${done}/${cand.length} images en ligne${failed ? `, ${failed} échec(s)` : ''}, ${shardsOk}/${shardsTot} shard-commit(s) jsDelivr 200 (lots de ${(BATCH_BYTES / 1048576) | 0} Mo).`)
// BUG TROUVÉ EN PROD (2026-07-11, run DJI 76 Go) : sans sortie explicite, le process reste VIVANT après la fin
// du travail — les sockets HTTPS keep-alive ouverts par fetch() (undici) vers jsDelivr/api.github.com ne se
// referment jamais tout seuls, donc Node ne vide jamais sa boucle d'événements. Un wrapper séquentiel
// (`node a.mjs && node b.mjs`) reste alors bloqué INDÉFINIMENT sur cette ligne, sans jamais lancer l'étape
// suivante — repéré après 9 min d'immobilité totale pendant que 3 lots vidéo (~75 Go) attendaient derrière.
process.exit(0)
