import { describe, expect, it } from 'vitest'
import { execFileSync } from 'node:child_process'
import { mkdtempSync, writeFileSync, rmSync } from 'node:fs'
import { tmpdir } from 'node:os'
import path from 'node:path'
import { makeThumbAt } from './img-ingest.mjs'

// ═══ UNE VIGNETTE PORTRAIT NE DOIT JAMAIS SORTIR ÉTIRÉE (mesuré le 2026-09-03) ═══════════════════
//
// Symptôme signalé par Matthieu : plein de miniatures étirées horizontalement sur le site, « un effet
// d'agrandissement en scale x ». Ce n'était pas du CSS : la vignette elle-même, en pixels, était
// déformée sur le drive.
//
// LA CAUSE. `sips -g pixelWidth -g pixelHeight` rend le buffer BRUT du capteur, jamais la taille
// affichée. Une photo iPhone portrait (EXIF Orientation=6) est alors mesurée comme un PAYSAGE.
// `makeThumbAt` calcule ensuite la géométrie de la vignette à partir de cette mesure fausse, puis
// appelle `magick … -auto-orient -resize <geom>!` : `-auto-orient` pivote CORRECTEMENT les pixels
// vers le portrait, mais le `!` force le résultat dans le cadre PAYSAGE calculé par erreur — la
// vignette générée est donc étirée, en pixels, pas seulement affichée de travers.
//
// LE FIXTURE reproduit exactement ce piège en miniature : un JPEG dont le buffer est 40x30
// (paysage) mais dont le tag EXIF Orientation vaut 6, de sorte que l'image, vue normalement, est
// PORTRAIT 30x40 — la même relation que la vraie photo qui a révélé le bug (buffer 5712x4284,
// affichée 4284x5712).

const FIXTURE = path.join(import.meta.dirname, '__fixtures__', 'portrait-exif6.jpg')

describe('une photo portrait avec rotation EXIF ne sort jamais étirée en vignette', () => {
  it('sips seul se trompe : il rend le buffer brut, pas la taille affichée (preuve du bug)', () => {
    const out = execFileSync('/usr/bin/sips', ['-g', 'pixelWidth', '-g', 'pixelHeight', FIXTURE]).toString()
    const w = Number((out.match(/pixelWidth:\s*(\d+)/) || [])[1])
    const h = Number((out.match(/pixelHeight:\s*(\d+)/) || [])[1])
    // C'est la cause racine, gravée ici pour qu'on se souvienne pourquoi sips seul est insuffisant.
    expect(w, 'sips rend le buffer capteur : paysage, pas ce que montre le fichier').toBeGreaterThan(h)
  })

  it('identify -auto-orient donne la vraie forme : portrait (preuve que le correctif existe)', () => {
    const out = execFileSync('/opt/homebrew/bin/identify', ['-auto-orient', '-format', '%wx%h', FIXTURE]).toString()
    const [w, h] = out.match(/(\d+)x(\d+)/).slice(1, 3).map(Number)
    expect(h, 'la photo doit être mesurée comme portrait, comme elle s’affiche').toBeGreaterThan(w)
  })

  it('LE VRAI TEST : la vignette produite par makeThumbAt n’est pas étirée', () => {
    const work = mkdtempSync(path.join(tmpdir(), 'zr-thumb-orient-'))
    try {
      const thumb = makeThumbAt(FIXTURE, work, 200, 60)
      expect(thumb, 'la génération a échoué (magick/cwebp absents ?)').toBeTruthy()
      // La géométrie ANNONCÉE doit être portrait, exactement comme le fixture (ratio 30:40 = 0.75).
      expect(thumb.h, 'hauteur annoncée doit dépasser la largeur (portrait)').toBeGreaterThan(thumb.w)

      // La preuve qui compte : les pixels RÉELS du fichier produit, pas seulement les nombres renvoyés.
      const buf = thumb.buf || thumb.data || thumb
      const outFile = path.join(work, 'out.webp')
      writeFileSync(outFile, buf)
      const dims = execFileSync('/opt/homebrew/bin/identify', ['-format', '%wx%h', outFile]).toString()
      const [rw, rh] = dims.match(/(\d+)x(\d+)/).slice(1, 3).map(Number)
      expect(rh, `vignette réellement écrite en ${rw}x${rh} — étirée si ce n’est pas portrait`).toBeGreaterThan(rw)
      // Le ratio doit rester proche de celui du fixture (30/40 = 0.75), à l'arrondi près.
      expect(rw / rh).toBeCloseTo(30 / 40, 1)
    } finally {
      rmSync(work, { recursive: true, force: true })
    }
  })
})
