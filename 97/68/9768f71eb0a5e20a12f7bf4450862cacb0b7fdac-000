import { describe, it, expect } from 'vitest'
import { decidesRafraichissement } from '../lib/rafraichirApres.js'
import { espacesDeTri, espaceParDefaut, triables } from '../lib/dossiersDeTri.js'
import { deplacerDansRegistre, deplacerPlusieurs } from '../../server/eagleRegistry.js'
import { sansAccent, aUnAccent } from '../lib/sansAccent.js'
import { attendreLaPreuve } from '../lib/attendreLisible.js'

// ═══ LES PARCOURS DE CREATE, D'UN BOUT À L'AUTRE ════════════════════════════════════════════════
//
// Les tests de cette base couvrent chaque brique isolément, et c'est nécessaire. Mais les bugs de la
// nuit du 2026-08-30 au 31 ne vivaient PAS dans une brique : ils vivaient dans leur ENCHAÎNEMENT.
// Le dossier était créé mais pas encore lisible ; le registre était juste mais l'index périmé ; la
// vignette existait mais personne ne la demandait au bon endroit.
//
// Ce fichier rejoue donc des parcours entiers, dans l'ordre où Matthieu les fait, en composant les
// briques réelles. Aucun réseau : chaque parcours décrit un état et vérifie ce que les briques en
// déduisent, ensemble.

const ICI = 'pages/Photos/DJI/29 Aout 2026/Photos'
const dossier = (name) => ({ name, hasKids: true, dir: `${ICI}/${name}` })
const image = (name) => ({ name, hasKids: false, contentPath: `${ICI}/${name}`, dir: `${ICI}/${name}` })

describe('parcours : trier treize photos vers un espace neuf', () => {
  it('l’espace proposé est le premier, et il est marqué neuf', () => {
    const espaces = espacesDeTri([], ICI)
    expect(espaces).toHaveLength(1)
    expect(espaceParDefaut(espaces)).toMatchObject({ nom: 'tmp-img-selection1', neuf: true })
  })

  it('les treize sont triables, et le dossier voisin l’est aussi', () => {
    const selection = Array.from({ length: 13 }, (_, i) => image(`IMG_${5500 + i}.jpeg.img.json`))
    selection.push(dossier('Videos'))
    expect(triables(selection)).toHaveLength(14)
  })

  it('l’espace créé sous la vue la fait se rafraîchir — le bug du dossier invisible', () => {
    // Sans ce cas, il fallait recharger la page pour voir l'espace de tri apparaître : la mise à
    // jour était gardée par `dest === folder`, et l'espace est un SOUS-dossier.
    const espace = espacesDeTri([], ICI)[0]
    const chemins = Array.from({ length: 13 }, (_, i) => `${espace.chemin}/IMG_${5500 + i}.jpeg.img.json`)
    const r = decidesRafraichissement([...chemins, espace.chemin], ICI)
    expect(r.aRecharger).toBe(ICI)
  })

  it('après le premier tri, le second espace apparaît, et le clic CONTINUE le premier', () => {
    const espaces = espacesDeTri([dossier('tmp-img-selection1')], ICI)
    expect(espaces.map((e) => e.nom)).toEqual(['tmp-img-selection1', 'tmp-img-selection2'])
    expect(espaceParDefaut(espaces).nom).toBe('tmp-img-selection1')
  })
})

describe('parcours : déplacer un original déjà référencé', () => {
  it('les références suivent, et aucune ne pointe dans le vide', () => {
    // Le parcours exact du 2026-08-31 : des originaux déplacés vers Photos/, alors que trois avaient
    // déjà des liens dans un espace de tri.
    const registre = {
      resourceId: 'zr_a', kind: 'img',
      sourcePath: 'pages/Photos/DJI/29 Aout 2026/IMG_5522.jpeg.img.json',
      placements: [
        'pages/Photos/DJI/29 Aout 2026/IMG_5522.jpeg.img.json',
        'pages/Photos/DJI/29 Aout 2026/tmp-img-selection1/IMG_5522.jpeg.img.json',
      ],
    }
    const apres = deplacerDansRegistre(registre, {
      resourceId: 'zr_a',
      from: 'pages/Photos/DJI/29 Aout 2026/IMG_5522.jpeg.img.json',
      to: `${ICI}/IMG_5522.jpeg.img.json`,
      canonical: true, kind: 'leaf',
    })
    expect(apres.sourcePath).toBe(`${ICI}/IMG_5522.jpeg.img.json`)
    expect(apres.placements).toContain('pages/Photos/DJI/29 Aout 2026/tmp-img-selection1/IMG_5522.jpeg.img.json')
    expect(apres.placements).not.toContain(registre.sourcePath)
  })

  it('déplacer le DOSSIER entier applique tous les mouvements en une passe', () => {
    // Écrire le registre après chaque mouvement ferait perdre toutes les mutations sauf la dernière.
    const registre = {
      resourceId: 'zr_b', sourcePath: 'pages/A/photo.img.json',
      placements: ['pages/A/photo.img.json', 'pages/A/tri/photo.img.json'],
    }
    const apres = deplacerPlusieurs(registre, [
      { resourceId: 'zr_b', from: 'pages/A/photo.img.json', to: 'pages/B/photo.img.json', canonical: true, kind: 'leaf' },
      { resourceId: 'zr_b', from: 'pages/A/tri/photo.img.json', to: 'pages/B/tri/photo.img.json', canonical: false, kind: 'leaf' },
    ], '2026-08-31T00:00:00Z')
    expect(apres.sourcePath).toBe('pages/B/photo.img.json')
    expect(apres.placements.sort()).toEqual(['pages/B/photo.img.json', 'pages/B/tri/photo.img.json'])
  })
})

describe('parcours : créer un dossier puis écrire dedans', () => {
  it('on attend que l’espace RÉPONDE, jamais un délai fixe', async () => {
    // Bug du 2026-08-30 : créer le dossier ne suffit pas, GitHub met un instant à le rendre. Un lot
    // parti trop tôt était refusé en entier.
    let visible = false
    setTimeout(() => { visible = true }, 5)
    const r = await attendreLaPreuve(() => visible, { dormir: (ms) => new Promise((res) => setTimeout(res, ms)) })
    expect(r.ok).toBe(true)
  })

  it('si l’espace ne répond jamais, on REFUSE au lieu d’écrire dans le vide', async () => {
    const r = await attendreLaPreuve(() => false, { essais: 3, dormir: async () => {} })
    expect(r.ok).toBe(false)
    expect(r.essais).toBe(3)
  })
})

describe('parcours : un nom qui arrive du Mac', () => {
  it('l’accent est retiré, et le japonais reste intact', () => {
    expect(sansAccent('29 Août 2026')).toBe('29 Aout 2026')
    expect(sansAccent('壁の向こうへ')).toBe('壁の向こうへ')
    expect(aUnAccent('Août')).toBe(true)
  })

  it('les deux formes Unicode donnent le MÊME nom — sinon deux dossiers jumeaux', () => {
    // macOS écrit décomposé, GitHub stocke composé : sans normalisation, deux dossiers identiques à
    // l'œil et distincts pour git.
    const compose = 'Août 2026'
    const decompose = 'Août 2026'.normalize('NFD')
    expect(compose).not.toBe(decompose)
    expect(sansAccent(compose)).toBe(sansAccent(decompose))
  })
})

describe('parcours : ce qui est créé ailleurs ne fait pas clignoter la vue', () => {
  it('un import dans un AUTRE dossier n’entraîne aucun rechargement', () => {
    const r = decidesRafraichissement(['pages/Build/ailleurs/x.img.json'], ICI)
    expect(r.aRecharger).toBe(null)
    expect(r.aInvalider).toEqual(['pages/Build/ailleurs'])
  })

  it('un import DANS la vue la rafraîchit', () => {
    expect(decidesRafraichissement([`${ICI}/neuf.img.json`], ICI).aRecharger).toBe(ICI)
  })
})
