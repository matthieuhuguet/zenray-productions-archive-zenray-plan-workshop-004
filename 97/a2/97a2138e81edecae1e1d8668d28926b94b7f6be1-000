export const CONVERSATION_SETTINGS = { metadataBytes: 65536, windowBytes: 2097152, refreshMs: 10000, collapsedPromptCharacters: 900, emptyPageScanLimit: 24, initialPromptScanLimit: 128 }
export const CONVERSATION_PROVIDERS = { claude: 'Claude', codex: 'Codex / GPT', gemini: 'Gemini / Google' }

// 9 October 2026, 11:38 CEST: Hide host-only prompt context when a running bridge has not reloaded its parser yet.
export function cleanConversationPrompt(text) {
  const original = String(text || '')
  const cleaned = original
    .replace(/<in-app-browser-context\b[^>]*>[\s\S]*?<\/in-app-browser-context>\s*/gi, '')
    .replace(/<codex_internal_context\b[^>]*>[\s\S]*?<\/codex_internal_context>\s*/gi, '')
    .replace(/<external_codex_apps_open_page\b[^>]*>[\s\S]*?<\/external_codex_apps_open_page>\s*/gi, '')
  return cleaned === original ? original : cleaned.trim()
}

// 9 October 2026, 11:35 CEST: Keep visible message numbers in Serif while technical code blocks retain Mono.
export function wrapConversationNumbers(html) {
  const codeBlocks = []
  const protectedHtml = String(html).replace(/<(pre|code)\b[\s\S]*?<\/\1>/gi, block => {
    const token = `\u0000CODEBLOCK${'x'.repeat(codeBlocks.length + 1)}\u0000`
    codeBlocks.push(block)
    return token
  })
  const wrappedHtml = protectedHtml.replace(/>([^<>]*\d[^<>]*)(?=<)/g, (_match, text) => {
    const numbered = text.replace(/\d+(?:[.,:/-]\d+)*(?:%|[.,])?/gu, value => `<span class="assets-number">${value}</span>`)
    return `>${numbered}`
  })
  return wrappedHtml.replace(/\u0000CODEBLOCK(x+)\u0000/g, (_match, index) => codeBlocks[index.length - 1] || '')
}
