// 4 October 2026: the letter template, editable. It starts as his own Asobo letter cut by paragraph without changing a word;
// the slots in braces are filled for each vacancy ({studio}, {role}, {age}, {portfolio}, {hook}, {latestWork}).
// FR : le modele de lettre, modifiable. Il part de sa lettre Asobo decoupee par paragraphe sans changer un mot ; les emplacements
// entre accolades sont remplis pour chaque annonce.
import React, { useEffect, useState } from 'react'
import { saveJsonWithRetry } from '../../lib/saveJson.js'
import { notify } from '../Notifications.jsx'
import { Button, GlassPill, P, SectionTitle, textareaStyle } from './ui.jsx'

const SECTIONS = [
  ['blocks', 'Paragraphes de la lettre', { greeting: 'Salutation', identity: 'Qui je suis', background: 'Parcours', experience: 'Expérience et portfolio', currentWork: 'En ce moment', hook: 'Accroche (remplie pour chaque annonce)', seeking: 'Ce que je recherche', closing: 'Fin de lettre', signature: 'Signature' }],
  ['reasons', 'Raison du message selon l’annonce', { offer: 'Offre', freelance: 'Mission freelance', internship: 'Stage', pool: 'Vivier de candidatures', spontaneous: 'Candidature spontanée' }],
  ['seekingVariants', 'Ce que je recherche, pour un stage ou une mission', { internship: 'Stage', freelance: 'Mission freelance' }],
  ['subjects', 'Objet du mail', { offer: 'Offre', freelance: 'Mission freelance', internship: 'Stage', pool: 'Vivier de candidatures', spontaneous: 'Candidature spontanée' }],
]
const SINGLE = [['hookFromOffer', 'Accroche construite depuis l’offre'], ['latestWork', 'Phrase des derniers travaux']]

export default function FreelanceTemplate({ t, template, templatePath, bridge, onSaved }) {
  const [lang, setLang] = useState('fr')
  const [draft, setDraft] = useState(template)
  const [saving, setSaving] = useState(false)
  useEffect(() => { setDraft(template) }, [template])
  if (!draft || !draft[lang]) return <p style={{ fontFamily: P.sans, fontSize: 13, color: t.textSecondary }}>Le modèle n’est pas encore publié : la première recherche l’écrit.</p>
  const part = draft[lang]
  const set = (path, value) => setDraft((current) => {
    const next = { ...current, [lang]: { ...current[lang] } }
    if (path.length === 2) next[lang][path[0]] = { ...next[lang][path[0]], [path[1]]: value }
    else next[lang][path[0]] = value
    return next
  })
  const dirty = JSON.stringify(draft.fr) !== JSON.stringify(template.fr) || JSON.stringify(draft.en) !== JSON.stringify(template.en) || JSON.stringify(draft.variables) !== JSON.stringify(template.variables)

  const save = async () => {
    setSaving(true)
    try {
      const at = new Date().toISOString()
      const result = await saveJsonWithRetry(templatePath, (current) => {
        const before = current && current.fr ? current : template
        return { ...draft, hooks: before.hooks || draft.hooks, status: 'custom', history: [...(before.history || []), { at, fr: before.fr, en: before.en, variables: before.variables }].slice(-30) }
      })
      if (!result.ok) throw new Error(String(result.error || 'Enregistrement impossible'))
      onSaved(result.data)
      notify({ title: 'Modèle enregistré', body: 'Les lettres non modifiées se mettent à jour à la prochaine recherche.' })
    } catch (error) { notify({ title: 'Modèle non enregistré', body: error.message }) } finally { setSaving(false) }
  }
  const apply = async () => { try { await bridge.run(); notify({ title: 'Recherche lancée', body: 'Les lettres sont recalculées avec le nouveau modèle.' }) } catch (error) { notify({ title: 'Service local indisponible', body: error.message }) } }

  const field = (path, value, rows = 3) => (
    <textarea key={path.join('.')} value={value || ''} onChange={(e) => set(path, e.target.value)} rows={rows} aria-label={path.join(' ')} style={{ ...textareaStyle(t), maxWidth: P.letterWidth, lineHeight: 1.5 }} />
  )
  const small = { fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, lineHeight: 1.5 }
  return (
    <div>
      <p style={{ ...small, margin: '0 0 6px' }}>
        {template.status === 'seed'
          ? 'Gabarit d’origine : ta lettre Asobo découpée par paragraphe, aucun mot changé. Les variantes pour un stage, une mission, une candidature spontanée et la version anglaise sont des propositions : relis-les et adapte-les.'
          : 'Modèle personnalisé : chaque ancienne version est gardée dans l’historique du fichier.'}
      </p>
      <p style={{ ...small, margin: '0 0 14px' }}>Emplacements remplis pour chaque annonce : <code>{'{studio} {role} {age} {portfolio} {hook} {latestWork}'}</code></p>
      <div style={{ display: 'flex', gap: 8, marginBottom: 16, alignItems: 'center', flexWrap: 'wrap' }}>
        {['fr', 'en'].map((code) => <GlassPill key={code} t={t} onClick={() => setLang(code)} active={lang === code}>{code === 'fr' ? 'Français' : 'English'}</GlassPill>)}
        {part.translated && <span style={small}>Traduction à valider</span>}
        <span style={{ flex: 1 }} />
        <label style={small}>Âge <input type="number" value={draft.variables.age} onChange={(e) => setDraft({ ...draft, variables: { ...draft.variables, age: Number(e.target.value) } })} style={{ ...textareaStyle(t), width: 70, display: 'inline-block', padding: 6, resize: 'none' }} /></label>
        <label style={small}>Portfolio <input value={draft.variables.portfolio} onChange={(e) => setDraft({ ...draft, variables: { ...draft.variables, portfolio: e.target.value } })} style={{ ...textareaStyle(t), width: 190, display: 'inline-block', padding: 6, resize: 'none' }} /></label>
      </div>
      {SECTIONS.map(([key, title, labels]) => (
        <div key={key} style={{ marginBottom: 22 }}>
          <SectionTitle t={t} title={title} />
          <div style={{ display: 'grid', gap: 12 }}>
            {Object.entries(labels).map(([name, label]) => part[key] && name in part[key] && (
              <div key={name}><div style={{ ...small, marginBottom: 4 }}>{label}</div>{field([key, name], part[key][name], key === 'subjects' ? 1 : name === 'greeting' ? 3 : 4)}</div>
            ))}
          </div>
        </div>
      ))}
      <div style={{ display: 'grid', gap: 12, marginBottom: 18 }}>
        {SINGLE.map(([name, label]) => <div key={name}><div style={{ ...small, marginBottom: 4 }}>{label}</div>{field([name], part[name], 2)}</div>)}
      </div>
      <div style={{ display: 'flex', gap: 10, flexWrap: 'wrap' }}>
        <Button t={t} primary onClick={save} disabled={!dirty || saving}>{saving ? 'Enregistrement…' : 'Enregistrer le modèle'}</Button>
        <Button t={t} onClick={apply} title="Lance une recherche : toutes les lettres non modifiées sont recalculées">Appliquer aux lettres maintenant</Button>
      </div>
    </div>
  )
}
