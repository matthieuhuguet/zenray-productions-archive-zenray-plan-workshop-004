// Mesure le coût de la chaîne de recherche quand `filtered` change d'identité à chaque rendu.
// Reproduit fidèlement les trois étapes de App.jsx : union Set, construction des entrées, tri.
const N_PATHS = 107000        // ordre de grandeur du drive, mesuré : 30k à 107k selon la source
const N_HITS = 18             // « passeport » : ce que la capture de Matthieu affiche
const RENDUS = 60             // une seconde d'interface à 60 images par seconde

const ext = ['.img.json', '.media.json', '.plan.json', '.md', '.file.json']
const paths = Array.from({ length: N_PATHS }, (_, i) => `pages/D${i % 400}/S${i % 40}/n${i}${ext[i % 5]}`)
const hits = paths.slice(0, N_HITS)
const locaux = paths.filter((p) => p.includes('n1')).slice(0, 400)

const stripLeafExt = (p) => p.replace(/\.(img|media|plan|file)\.json$/, '').replace(/\.md$/, '')
const construireEntrees = (liste) => liste.map((p) => ({
  name: stripLeafExt(p).split('/').pop(), contentPath: p, hasKids: false, dir: stripLeafExt(p),
}))

// AVANT : `filtered` recree un Set + un tableau a chaque rendu, donc les useMemo en aval
// (searchEntries, shownEntries) voient une dependance neuve et se rejouent TOUS.
let t0 = performance.now()
for (let r = 0; r < RENDUS; r++) {
  const filtered = [...new Set([...hits, ...locaux])]
  const entrees = construireEntrees(filtered)
  ;[...entrees].sort((a, b) => a.name.localeCompare(b.name))
}
const avant = performance.now() - t0

// APRES : `filtered` est memoise, son identite est stable, les useMemo en aval ne se rejouent pas.
t0 = performance.now()
const filteredStable = [...new Set([...hits, ...locaux])]
const entreesStables = construireEntrees(filteredStable)
const trieStable = [...entreesStables].sort((a, b) => a.name.localeCompare(b.name))
for (let r = 0; r < RENDUS; r++) { void filteredStable; void entreesStables; void trieStable }
const apres = performance.now() - t0

// LE CAS QUI GELE VRAIMENT : hors recherche `filtered` vaut allPaths (107k). Si le split est
// ouvert, buildTree(107k) se rejoue a chaque rendu parce que sa dependance `filtered` bouge.
const buildTree = (liste) => {
  const racine = {}
  for (const p of liste) {
    let n = racine
    for (const seg of p.split('/')) { n[seg] = n[seg] || {}; n = n[seg] }
  }
  return racine
}
t0 = performance.now()
buildTree(paths)
const unArbre = performance.now() - t0

console.log(JSON.stringify({
  rendus: RENDUS,
  chaine_recherche_ms: { avant: +avant.toFixed(1), apres: +apres.toFixed(1), gain: +(avant / Math.max(apres, 0.001)).toFixed(0) + 'x' },
  par_rendu_ms: { avant: +(avant / RENDUS).toFixed(2), apres: +(apres / RENDUS).toFixed(4) },
  buildTree_107k_un_seul_ms: +unArbre.toFixed(1),
  buildTree_a_chaque_rendu_ms: +(unArbre * RENDUS).toFixed(0),
}, null, 2))
