// clone-lock.mjs (12 October 2026): ONE Git writer at a time on the shared zenray-data clone.
// FR : un seul ecrivain Git a la fois sur le clone partage. Le 12 October 2026 deux ecrivains (renommage et worker) ont laisse
// un rebase en suspens qui a fait abandonner les films un par un ; avec l'envoi de l'archive du film N+1 en meme temps que
// l'empaquetage du film N, ce cas devient la regle : tout acces en ecriture au clone passe par ce verrou.
// The Python worker uses the SAME on-disk protocol (directory <clone>.lock/owner.json) so both languages exclude each other.
import { realpathSync } from 'node:fs'
import { acquireDirectoryLock, directoryLockOptions } from './directory-lock.mjs'

// The lock lives NEXT TO the clone (never inside it: git clean and reset must not be able to remove it).
export const cloneLockDir = (clone) => `${realpathSync(clone).replace(/\/+$/, '')}.lock`

// Runs fn while holding the lock. Waiting is not failing: the profile waits up to 60 minutes and reclaims a lock whose owner PID is dead.
export async function withCloneLock(clone, label, fn) {
  const lock = await acquireDirectoryLock(cloneLockDir(clone), directoryLockOptions('long', label))
  try { return await fn() } finally { await lock.release() }
}
