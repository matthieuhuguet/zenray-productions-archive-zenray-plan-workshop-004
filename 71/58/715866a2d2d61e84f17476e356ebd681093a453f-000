import { afterEach, describe, expect, it, vi } from 'vitest'
import { FOLDER_MARKER_FILE, folderMarkerPath, writeFolderMarker } from './folderMarker.js'

describe('folderMarker', () => {
  afterEach(() => { vi.restoreAllMocks() })

  it('exporte le nom de fichier marqueur attendu par App.jsx (newFolder/createFolderAt)', () => {
    expect(FOLDER_MARKER_FILE).toBe('.zrfolder.json')
  })

  it('folderMarkerPath compose <dir>/.zrfolder.json', () => {
    expect(folderMarkerPath('pages/Build/Nouveau dossier-ab12')).toBe('pages/Build/Nouveau dossier-ab12/.zrfolder.json')
  })

  it("writeFolderMarker POST une action 'save' sur le chemin marqueur avec {folder:true, createdAt}", async () => {
    const fetchMock = vi.spyOn(globalThis, 'fetch').mockResolvedValue({ ok: true, status: 200, json: async () => ({ ok: true, sha: 'abc' }) })
    const result = await writeFolderMarker('pages/Build/X')

    expect(fetchMock).toHaveBeenCalledTimes(1)
    const [url, init] = fetchMock.mock.calls[0]
    expect(url).toBe('/api/page')
    const body = JSON.parse(init.body)
    expect(body.action).toBe('save')
    expect(body.path).toBe('pages/Build/X/.zrfolder.json')
    const markdown = JSON.parse(body.markdown)
    expect(markdown.folder).toBe(true)
    expect(typeof markdown.createdAt).toBe('number')
    expect(result).toEqual({ ok: true, sha: 'abc' })
  })

  it('ne rejette JAMAIS, et rend un objet qui PORTE la cause (2026-08-31)', async () => {
    vi.spyOn(globalThis, 'fetch').mockRejectedValue(new Error('network down'))
    const result = await writeFolderMarker('pages/Build/X')
    // Ne rend plus `null` (2026-08-31) : rendre null effaçait la cause, et l'interface affichait
    // « erreur » suivi de rien — Matthieu a vu « 0 déplacé(s), 1 échec(s) » sans savoir pourquoi.
    // Les deux appelants testent `!j || !j.ok`, donc ce contrat leur convient exactement pareil,
    // avec la cause en plus.
    expect(result).not.toBeNull()
    expect(result.ok).toBe(false)
    expect(result.error, 'la cause doit être portée, sinon rien ne s’affiche').toBeTruthy()
  })

  it('porte la cause aussi quand la réponse est illisible', async () => {
    vi.spyOn(globalThis, 'fetch').mockResolvedValue({ ok: true, status: 200, json: async () => { throw new Error('bad json') } })
    const result = await writeFolderMarker('pages/Build/X')
    // Ne rend plus `null` (2026-08-31) : rendre null effaçait la cause, et l'interface affichait
    // « erreur » suivi de rien — Matthieu a vu « 0 déplacé(s), 1 échec(s) » sans savoir pourquoi.
    // Les deux appelants testent `!j || !j.ok`, donc ce contrat leur convient exactement pareil,
    // avec la cause en plus.
    expect(result).not.toBeNull()
    expect(result.ok).toBe(false)
    expect(result.error, 'la cause doit être portée, sinon rien ne s’affiche').toBeTruthy()
  })
})
