// 12 October 2026: covers are chosen by name first, generated files never count as edits.
import { describe, expect, it } from 'vitest'
import { pickProjectCover, isGeneratedFile, lastFileActivity, coverReference, namedScore } from './assetsProjectCover.js'
import { projectActivityTime } from './assetsProjects.js'
import { summarizeWorkspaceProject } from './assetsWorkspaceCatalogue.js'

const img = (relativePath, extra = {}) => ({ id: relativePath, name: relativePath.split('/').pop(), relativePath, kind: 'image', contentPath: `pages/${relativePath}.file.json`, ...extra })

describe('pickProjectCover', () => {
  it('prefers a file named thumbnail over deeper or later images', () => {
    const files = [img('renders/a_final.png'), img('workshop/thumbnail.png'), img('b.png')]
    const picked = pickProjectCover(files)
    expect(picked.file.relativePath).toBe('workshop/thumbnail.png')
    expect(picked.reason).toBe('named')
  })
  it('accepts cover, poster, icon and a thumbnails folder', () => {
    for (const path of ['cover.jpg', 'Poster_v2.png', 'icon.webp', 'thumbnails/001.png']) expect(pickProjectCover([img('z.png'), img(path)]).file.relativePath).toBe(path)
  })
  it('only returns named files in strict mode and the first image otherwise', () => {
    const files = [img('b/render.png'), img('a.png')]
    expect(pickProjectCover(files, { named: true })).toBeNull()
    expect(pickProjectCover(files)).toMatchObject({ reason: 'first-image', file: { relativePath: 'a.png' } })
  })
  it('skips images nothing can render and non images', () => {
    expect(pickProjectCover([{ id: 'x', name: 'cover.png', relativePath: 'cover.png', kind: 'image' }, { id: 'y', name: 'cover.txt', relativePath: 'cover.txt', kind: 'text', contentPath: 'p' }])).toBeNull()
  })
  it('never names build output, plugin icons or web icons as a cover', () => {
    const files = [img('worktree/dist/apple-touch-icon.png'), img('Plugins/UnrealEngine/Resources/hengine_recook_icon.png'), img('pages-deploy-1/dist/cover.png')]
    expect(pickProjectCover(files, { named: true })).toBeNull()
  })
  it('does not treat a preview as a thumbnail but may use it as a last resort', () => {
    expect(pickProjectCover([img('methods/BC_preview.png')], { named: true })).toBeNull()
    expect(pickProjectCover([img('a/zzz.png'), img('methods/BC_preview.png')]).file.relativePath).toBe('methods/BC_preview.png')
  })
  it('scores a thumbnail word above nothing', () => {
    expect(namedScore(img('thumb.png'))).toBeGreaterThan(namedScore(img('render.png')))
  })
})

describe('activity time', () => {
  it('ignores generated files', () => {
    expect(isGeneratedFile({ relativePath: 'ConversationIndex.json' })).toBe(true)
    expect(isGeneratedFile({ relativePath: 'workshop/a.png' })).toBe(false)
    expect(lastFileActivity([{ relativePath: 'ConversationIndex.json', mtimeMs: 9_000 }, { relativePath: 'a.png', mtimeMs: 5_000 }])).toBe(5_000)
  })
  it('orders by the last real edit, not by publication time', () => {
    const edited = { id: 'edited', checkedAt: '2026-10-12T20:00:00Z', files: [{ relativePath: 'a.png', mtimeMs: Date.parse('2026-10-10T10:00:00Z') }] }
    const published = { id: 'published', checkedAt: '2026-10-12T21:00:00Z', files: [{ relativePath: 'FileMap.md', mtimeMs: Date.parse('2026-10-12T21:00:00Z') }] }
    expect(projectActivityTime(edited)).toBeGreaterThan(projectActivityTime(published))
  })
  it('puts lastActivityAt in the light catalogue summary', () => {
    const summary = summarizeWorkspaceProject({ id: 'p', name: 'P', folder: 'pages/ZenRayAssets/p', files: [{ id: 'a', relativePath: 'a.png', mtimeMs: 1_790_000_000_000 }] })
    expect(summary.lastActivityAt).toBe(1_790_000_000_000)
  })
})

describe('coverReference', () => {
  it('keeps only what a renderer needs', () => {
    expect(Object.keys(coverReference({ ...img('a.png'), sha256: 'x', manifestPath: 'y' })).sort()).toEqual(['contentPath', 'id', 'kind', 'name', 'relativePath'])
  })
})

import { coverDrawRect, coverAdjustedRect } from './coverThumbnail.js'
describe('coverDrawRect', () => {
  it('covers a wide box from a square source without distortion', () => {
    const rect = coverDrawRect(1000, 1000, 360, 203)
    expect(rect.width).toBeCloseTo(360); expect(rect.height).toBeCloseTo(360)
    expect(rect.y).toBeCloseTo(-78.5)
  })
  it('covers a wide box from a portrait source by cropping top and bottom', () => {
    const rect = coverDrawRect(900, 1600, 360, 203)
    expect(rect.width / rect.height).toBeCloseTo(900 / 1600)
    expect(rect.x).toBeCloseTo(0)
  })
  it('never leaves an empty edge', () => {
    for (const [w, h] of [[100, 100], [4000, 100], [100, 4000], [1920, 1080]]) {
      const r = coverDrawRect(w, h)
      expect(r.x).toBeLessThanOrEqual(0.0001); expect(r.y).toBeLessThanOrEqual(0.0001)
      expect(r.x + r.width).toBeGreaterThanOrEqual(360 - 0.001); expect(r.y + r.height).toBeGreaterThanOrEqual(203 - 0.001)
    }
  })
})

describe('coverAdjustedRect', () => {
  it('computes contain fit mode with letterboxing/pillarboxing', () => {
    // 1000x1000 source inside 720x406 canvas with contain fitMode
    const rect = coverAdjustedRect(1000, 1000, { width: 720, height: 406, fitMode: 'contain' })
    expect(rect.width).toBeCloseTo(406)
    expect(rect.height).toBeCloseTo(406)
    expect(rect.x).toBeCloseTo((720 - 406) / 2)
    expect(rect.y).toBeCloseTo(0)
  })

  it('applies pan offsets in X and Y', () => {
    const rect = coverAdjustedRect(720, 406, { width: 720, height: 406, panX: 50, panY: -30 })
    expect(rect.x).toBe(50)
    expect(rect.y).toBe(-30)
  })

  it('applies zoom scaling', () => {
    const rect = coverAdjustedRect(720, 406, { width: 720, height: 406, zoom: 0.5 })
    expect(rect.width).toBeCloseTo(360)
    expect(rect.height).toBeCloseTo(203)
    expect(rect.x).toBeCloseTo((720 - 360) / 2)
    expect(rect.y).toBeCloseTo((406 - 203) / 2)
  })
})
