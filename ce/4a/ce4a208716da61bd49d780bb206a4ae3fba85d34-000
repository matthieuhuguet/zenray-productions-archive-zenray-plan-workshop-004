export const initialPlayerState = Object.freeze({
  phase: 'idle',
  provider: 'local',
  requestId: 0,
  trackKey: '',
  error: '',
})

export function providerForTrack(track) {
  const source = String(track?.source || 'local').toLowerCase()
  return source === 'spotify' || source === 'youtube' ? source : 'local'
}

export function trackKey(track) {
  return String(track?.manifestPath || track?.streamPath || track?.path || track?.uri || track?.contextUri || track?.videoId || '')
}

// Un double-clic produit deux `click` avant le `dblclick`. Cette décision reste
// pure et testable : le composant conserve seulement la dernière commande.
export function isDuplicatePlayCommand(previous, key, now, windowMs = 350) {
  const elapsed = Number(now) - Number(previous?.at)
  return Boolean(key && previous?.key === key && Number.isFinite(elapsed) && elapsed >= 0 && elapsed < windowMs)
}

export function playerStateReducer(state, action) {
  if (action.type === 'request') {
    if (!Number.isInteger(action.requestId) || action.requestId <= state.requestId) return state
    return {
      phase: 'loading',
      provider: action.provider || 'local',
      requestId: action.requestId,
      trackKey: action.trackKey || '',
      error: '',
    }
  }
  if (action.requestId !== state.requestId) return state
  if (action.provider && action.provider !== state.provider) return state
  if (action.trackKey && action.trackKey !== state.trackKey) return state
  if (action.type === 'ready') return state.phase === 'playing' ? state : { ...state, phase: 'ready', error: '' }
  if (action.type === 'playing') return { ...state, phase: 'playing', error: '' }
  if (action.type === 'paused') return { ...state, phase: 'paused' }
  if (action.type === 'error') return { ...state, phase: 'error', error: action.error || 'Lecture impossible.' }
  return state
}
