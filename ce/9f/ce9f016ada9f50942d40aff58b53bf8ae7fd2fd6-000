import React from 'react'
import { afterEach, expect, it } from 'vitest'
import { cleanup, render, screen, fireEvent } from '@testing-library/react'
import JapaneseReferences from './JapaneseReferences.jsx'
afterEach(cleanup)
it('browses vocabulary memberships and switches to kana without writing mastery', async () => {
  const word = {id:'word-1',level:'N5',memberships:['N5','N2'],kanji:[{text:'会う'}],kana:[{text:'あう'}],senses:[{gloss:[{text:'rencontrer'}]}],bindings:[[0,0,[0]]],sourceRefs:[]}
  const client={load:async kind => kind === 'vocabulary' ? {entries:[word],withFrench:1,missingFrench:0,unresolvedRows:[],unresolvedFormRows:[]} : {entries:[{id:'a',script:'hiragana',category:'base',display:'あ',reading:'a'}]}}
  render(<JapaneseReferences client={client} />)
  await screen.findByText('rencontrer')
  fireEvent.change(screen.getByLabelText('Liste de vocabulaire'),{target:{value:'N2'}})
  fireEvent.click(screen.getByRole('button',{name:/会う/}))
  expect(screen.getByRole('table')).toHaveTextContent('あう')
  fireEvent.click(screen.getByRole('button',{name:'Hiragana et katakana'}))
  expect(await screen.findByRole('button',{name:/あ a/})).toBeInTheDocument()
})
