// planFocus.test.js (23 October 2026): guards the day focus contract chosen by Matthieu. / garde le contrat du mode Focus.
import { describe, expect, it } from 'vitest'
import { PLAN_CSS_VARIABLES, PLAN_UI } from './planUiConfig.js'

describe('Plan day focus', () => {
  it('keeps the two steps at 0.35 s each and the light "Focus" zoom', () => {
    expect(PLAN_UI.focus.step1Ms).toBe(350)
    expect(PLAN_UI.focus.step2Ms).toBe(350)
    expect(PLAN_UI.focus.weekZoom).toBeLessThanOrEqual(1.1)
    expect(PLAN_UI.focus.onOpen).toBe(true)
    expect(PLAN_UI.focus.quickLookKey).toBe(' ') // Space = Quick Look on a day
  })
  it('exposes its values and the opaque toolbar fill as CSS variables', () => {
    for (const k of ['--zrp-focus-width', '--zrp-focus-scrim-blur', '--zrp-toolbar-fill-light', '--zrp-toolbar-fill-dark']) expect(PLAN_CSS_VARIABLES[k]).toBeTruthy()
  })
})
