// 4 October 2026: the page's door to the local freelance service (search now, progress, one letter on demand).
// Same pattern as the Assets bridge: loopback only, the service refuses every other origin and every request without its client header.
// FR : la porte de la page vers le service local (rechercher, avancement, une lettre a la demande). Meme patron que le pont Assets.
import { getApiSecret } from './apiAuth.js'

export const FREELANCE_BRIDGE = { path: '/api/freelance-engine', origin: 'http://localhost:3101', timeoutMs: 20000, letterTimeoutMs: 120000 }

export class FreelanceBridgeError extends Error {
  constructor(message, { code = 'bridge-unavailable', status = 0, cause } = {}) {
    super(message, { cause })
    this.name = 'FreelanceBridgeError'
    this.code = code
    this.status = status
  }
}

export function createFreelanceBridge({ origin = FREELANCE_BRIDGE.origin, fetchImpl = (...args) => fetch(...args) } = {}) {
  async function request(action, payload = {}, { timeoutMs = FREELANCE_BRIDGE.timeoutMs, signal } = {}) {
    const secret = getApiSecret()
    const timeout = AbortSignal.timeout(timeoutMs)
    const combined = signal && typeof AbortSignal.any === 'function' ? AbortSignal.any([signal, timeout]) : signal || timeout
    let response
    try {
      response = await fetchImpl(`${origin}${FREELANCE_BRIDGE.path}`, {
        method: 'POST', headers: { 'content-type': 'application/json', 'x-zr-freelance-client': '1', ...(secret ? { 'x-zr-auth': secret } : {}) },
        body: JSON.stringify({ ...payload, action }), signal: combined,
      })
    } catch (cause) {
      throw new FreelanceBridgeError('Le service local ZenRay Freelance est indisponible (Mac éteint ou service arrêté).', { cause })
    }
    let result
    try { result = await response.json() } catch (cause) { throw new FreelanceBridgeError('Réponse du service local illisible.', { cause, status: response.status }) }
    if (!response.ok || result.error) throw new FreelanceBridgeError(result.error || 'La demande locale échoue.', { code: result.code || 'bridge-request-failed', status: response.status })
    return result
  }
  return {
    request,
    status: (options) => request('status', {}, options),
    run: (only = null, options) => request('run', only ? { only } : {}, options),
    // 14 October 2026: the local service opens the batch's pages as tabs (no pop-up blocker, at most 60 public https links).
    openLinks: (urls, options) => request('open-links', { urls }, options),
    // 16 October 2026: ZenRay Apply (prepare N applications, read progress, reopen the ready pages, record "sent"); nothing is ever submitted.
    applyStart: (size, options) => request('apply-start', { size }, options),
    applyStatus: (options) => request('apply-status', {}, options),
    applyOpen: (options) => request('apply-open', {}, options),
    applySent: (ids = null, options) => request('apply-sent', ids ? { ids } : {}, { timeoutMs: 120000, ...options }),
    letter: (studioId, lang = null, options) => request('letter', { studioId, ...(lang ? { lang } : {}) }, { timeoutMs: FREELANCE_BRIDGE.letterTimeoutMs, ...options }),
  }
}
