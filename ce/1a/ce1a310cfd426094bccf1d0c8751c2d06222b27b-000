// ZenRayMedia — moteur de gabarit pour les thèmes HTML déposés à la main.
//
// Contrat volontairement MINUSCULE (4 constructions, pas une de plus). Un moteur de gabarit
// riche est une source de bugs sans fin ; ici tout ce qui n'est pas listé est laissé tel quel.
//
//   {{champ}}                 — valeur échappée
//   {{{champ}}}               — valeur brute (HTML déjà sûr, produit par nous)
//   {{#beats}} … {{/beats}}   — répétition sur la liste des beats
//   {{^beats}} … {{/beats}}   — bloc affiché si la liste est vide
//
// Dans un bloc `beats`, les champs disponibles sont : index, number, role, roleLabel, text,
// html, duration, weight, tempo, isFirst, isLast.

export function escapeHtml(value) {
  return String(value ?? '')
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;')
}

function lookup(scope, path) {
  if (path === '.') return scope
  let cur = scope
  for (const key of path.split('.')) {
    if (cur == null) return ''
    cur = cur[key]
  }
  return cur == null ? '' : cur
}

// Analyseur à PASSE UNIQUE.
//
// Bug réel corrigé le 2026-07-25, trouvé par le test : une première version résolvait les
// sections d'abord, puis les champs à la toute fin, contre la portée RACINE. Résultat, `{{role}}`
// et `{{text}}` à l'intérieur d'un bloc `{{#beats}}` sortaient vides : la portée du beat courant
// n'existait plus au moment de la substitution. Une passe unique qui descend avec sa portée est
// la seule forme correcte -- et elle interdit du même coup la double interprétation d'une valeur
// qui contiendrait elle-même des accolades.
const TAG = /\{\{(\{)?\s*([#^/]?)\s*([\w.]+)\s*(\})?\}\}/g

function renderScope(template, scope, depth = 0) {
  if (depth > 16) return '' // gabarit pathologiquement imbriqué : on s'arrête proprement
  const tpl = String(template)
  let out = ''
  let cursor = 0
  TAG.lastIndex = 0
  let match

  while ((match = TAG.exec(tpl)) !== null) {
    const [raw, openBrace, kind, name, closeBrace] = match
    out += tpl.slice(cursor, match.index)
    cursor = match.index + raw.length

    if (kind === '#' || kind === '^') {
      // Cherche la balise de fermeture correspondante, en comptant les imbrications de MÊME nom.
      const close = `{{/${name}}}`
      const open = kind === '#' ? `{{#${name}}}` : `{{^${name}}}`
      let level = 1
      let scan = cursor
      let bodyEnd = -1
      while (scan < tpl.length) {
        const nextClose = tpl.indexOf(close, scan)
        if (nextClose === -1) break
        const nextOpenHash = tpl.indexOf(`{{#${name}}}`, scan)
        const nextOpenCaret = tpl.indexOf(`{{^${name}}}`, scan)
        const candidates = [nextOpenHash, nextOpenCaret].filter((i) => i !== -1 && i < nextClose)
        if (candidates.length) { level++; scan = Math.min(...candidates) + open.length; continue }
        level--
        if (level === 0) { bodyEnd = nextClose; break }
        scan = nextClose + close.length
      }
      // Section jamais fermée : on ignore la balise et on continue. Jamais d'exception, jamais
      // de boucle -- un gabarit déposé à la main a le droit d'être imparfait.
      if (bodyEnd === -1) continue

      const body = tpl.slice(cursor, bodyEnd)
      cursor = bodyEnd + close.length

      const value = lookup(scope, name)
      const list = Array.isArray(value) ? value : (value ? [value] : [])
      if (kind === '^') {
        out += list.length === 0 ? renderScope(body, scope, depth + 1) : ''
      } else {
        out += list.map((item, i) => {
          const child = (item && typeof item === 'object')
            ? { ...scope, ...item, index: i, number: i + 1, isFirst: i === 0, isLast: i === list.length - 1 }
            : { ...scope, value: item, index: i, number: i + 1, isFirst: i === 0, isLast: i === list.length - 1 }
          return renderScope(body, child, depth + 1)
        }).join('')
      }
      TAG.lastIndex = cursor
      continue
    }

    if (kind === '/') continue // fermeture orpheline : ignorée

    const value = lookup(scope, name)
    out += (openBrace && closeBrace) ? String(value) : escapeHtml(value)
  }

  return out + tpl.slice(cursor)
}

export function renderTemplate(template, data) {
  if (typeof template !== 'string') throw new TypeError('renderTemplate : gabarit attendu sous forme de chaîne.')
  return renderScope(template, data || {})
}

// Un gabarit HTML doit consommer au moins le titre et les beats, sinon le contenu du brief
// n'apparaît nulle part et le thème est muet. Contrôle appliqué au chargement, pas au rendu.
export function inspectTemplate(template) {
  const tpl = String(template || '')
  return {
    usesTitle: /\{\{\{?\s*title\s*\}?\}\}/.test(tpl),
    usesBeats: /\{\{#\s*beats\s*\}\}/.test(tpl),
    hasHtmlSkeleton: /<html[\s>]/i.test(tpl),
  }
}
