// plan-check.jsx (23 October 2026): mounts the real PlanBoard (with its day focus) on a read-only copy of the plan. Workshop only.
// FR : monte le vrai PlanBoard sur une copie en lecture seule du plan. Atelier seulement.
import React, { useState } from 'react'
import { createRoot } from 'react-dom/client'
import './fonts.css'
import PlanBoard from './create/PlanBoard.jsx'
import Pages, { BIBLIOTHEQUES } from './create/Pages.jsx'
import { THEMES } from './theme.js'
import BOARD from './plan-lab.data.json'
const PATH = 'pages/Calendar-76ct/Matthieu2026-l8at.plan.json'
localStorage.setItem('zr:plan:cache:v1:' + encodeURIComponent(PATH), JSON.stringify(BOARD))
localStorage.setItem('zr:plan:paths', JSON.stringify([PATH]))
const library = new URLSearchParams(location.search).get('mode') === 'library'
let current = BOARD, n = 0
const real = window.fetch.bind(window)
const json = (o) => new Response(JSON.stringify(o), { headers: { 'content-type': 'application/json' } })
window.fetch = async (url, opts) => {
  const u = String(url)
  if (u.includes('/api/page')) { if (opts && opts.method === 'POST') { try { current = JSON.parse(JSON.parse(opts.body).markdown) } catch {} return json({ ok: true, sha: 's' + (++n) }) } return json({ markdown: JSON.stringify(current), sha: 's' + n }) }
  if (u.startsWith('/api/')) return json({ ok: false })
  return real(url, opts)
}
const dark = new URLSearchParams(location.search).get('theme') === 'dark'
function Check() {
  // Same scroll scene as App.jsx (.zr-scene, padding 70px on top). / même scène défilante qu'App.jsx.
  return <div className={dark ? 'zr-dark' : ''} style={{ display: 'flex', height: '100vh', overflow: 'hidden' }}>
    <div className="zr-scene" style={{ flex: 1, minWidth: 0, minHeight: 0, overflowY: 'auto', padding: '70px clamp(16px,3vw,42px) 80px' }}>
      {library ? <Pages t={THEMES[dark ? 'dark' : 'light']} planLibrary={BIBLIOTHEQUES.plan} /> : <div style={{ maxWidth: '100%', width: '100%', margin: '0 auto' }}><PlanBoard t={THEMES[dark ? 'dark' : 'light']} path={PATH} /></div>}
    </div>
  </div>
}
createRoot(document.getElementById('root')).render(<Check />)
