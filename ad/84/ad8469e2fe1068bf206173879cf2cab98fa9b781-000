// 12 October 2026, 12:20 CEST: the gallery: filter chips drawn from the data present, then the grid of cards. The
// active chip is shown by a class (never by hover), and the state of the list names its cause (loading, empty,
// unreadable, transient failure, Mac away): a transient failure is never displayed as an absence.
// 14 October 2026: PROGRESSIVE. Cards are drawn by windows (MOTION.windowSize, then more as the end of the grid comes into view or on
// a button), a catalogue that arrives page by page shows what it has with skeleton cards for the rest and a counter, and a failure
// shows its cause and a retry instead of leaving "Loading" for ever.
// FR : la galerie progressive : fenetres de cartes, squelettes pendant l'arrivee des pages, erreur avec reessayer.
import React, { useEffect, useMemo, useRef, useState } from 'react'
import { MOTION } from '../config/motion.js'
import MotionCard from './MotionCard.jsx'
import { applyChip, filterChips } from './motionCatalogue.js'

export function MotionState({ title, hint, testId, action }) {
  return <div className="zrm-state" data-testid={testId}><strong>{title}</strong>{hint}{action}</div>
}

function Skeletons({ count }) {
  return Array.from({ length: count }, (_, i) => (
    <div key={`sk-${i}`} className="zrm-card zrm-skeleton" aria-hidden="true" data-testid="motion-skeleton">
      <div className="zrm-thumb" />
      <div className="zrm-card-body"><div className="zrm-sk-line" /><div className="zrm-sk-line zrm-sk-short" /></div>
    </div>
  ))
}

/** How many cards are drawn: a window that grows when the sentinel at the end of the grid is seen (all of them without IntersectionObserver). */
export function useWindow(total, resetKey) {
  const [count, setCount] = useState(MOTION.windowSize)
  const sentinel = useRef(null)
  useEffect(() => { setCount(MOTION.windowSize) }, [resetKey])
  useEffect(() => {
    const node = sentinel.current
    if (!node || count >= total) return undefined
    if (typeof IntersectionObserver === 'undefined') { setCount(total); return undefined }
    const io = new IntersectionObserver((entries) => { if (entries.some((e) => e.isIntersecting)) setCount((c) => Math.min(total, c + MOTION.windowSize)) }, { rootMargin: '600px' })
    io.observe(node)
    return () => io.disconnect()
  }, [count, total])
  return { count: Math.min(count, total), more: () => setCount((c) => Math.min(total, c + MOTION.windowSize)), sentinel }
}

export default function MotionGallery({ cards, status, chip, onChip, onOpen, tr, lang, total = null, onRetry = null }) {
  const chips = useMemo(() => filterChips(cards), [cards])
  const shown = useMemo(() => applyChip(cards, chip), [cards, chip])
  const windowed = useWindow(shown.length, `${chip || 'all'}:${cards.length === 0 ? 0 : 1}`)
  const retry = onRetry ? <button type="button" className="zrm-btn zrm-retry" onClick={onRetry} data-testid="motion-retry">{tr('motion.state.retry')}</button> : null
  if (status === 'loading' && !cards.length) {
    return (
      <div data-testid="motion-loading">
        <MotionState title={tr('motion.state.loading')} />
        <div className="zrm-grid" aria-busy="true"><Skeletons count={MOTION.windowSize / 2} /></div>
      </div>
    )
  }
  if (status === 'error' && !cards.length) return <MotionState testId="motion-error" title={tr('motion.state.error')} hint={tr('motion.state.errorHint')} action={retry} />
  if (status === 'unreadable') return <MotionState testId="motion-unreadable" title={tr('motion.state.unreadable')} action={retry} />
  if (status === 'away') return <MotionState testId="motion-away" title={tr('motion.state.bridgeAway')} hint={tr('motion.state.bridgeHint')} />
  if (!cards.length) return <MotionState testId="motion-empty" title={tr('motion.state.empty')} hint={tr('motion.state.emptyHint')} />
  const label = (c) => (c.kind === 'all' ? tr('motion.chip.all') : c.kind === 'status' ? tr(`motion.chip.${c.key}`) : c.label)
  const labels = { versions: tr('motion.card.versions'), local: tr('motion.rail.local') }
  const loadingMore = status === 'loading-more'
  const remaining = total && total > cards.length ? Math.min(MOTION.windowSize, total - cards.length) : 0
  return (
    <div>
      <div className="zrm-chips" role="toolbar">
        {chips.map((c) => (
          <button key={c.key} type="button" className={`zrm-chip${(chip || 'all') === c.key ? ' is-on' : ''}`} onClick={() => onChip(c.key)} data-testid={`motion-chip-${c.key}`}>
            {label(c)}
          </button>
        ))}
        {total ? <span className="zrm-count zrm-num" data-testid="motion-count">{cards.length} {tr('motion.state.of')} {total}</span> : null}
      </div>
      <div className="zrm-grid" data-testid="motion-grid" aria-busy={loadingMore ? 'true' : undefined}>
        {shown.slice(0, windowed.count).map((card) => <MotionCard key={`${card.source}:${card.id}`} card={card} onOpen={onOpen} lang={lang} labels={labels} />)}
        {loadingMore && windowed.count >= shown.length ? <Skeletons count={remaining || 4} /> : null}
      </div>
      {windowed.count < shown.length
        ? <div ref={windowed.sentinel} className="zrm-more"><button type="button" className="zrm-btn" onClick={windowed.more} data-testid="motion-more">{tr('motion.state.showMore')}</button></div>
        : null}
      {status === 'partial' ? <MotionState testId="motion-partial" title={tr('motion.state.partial')} action={retry} /> : null}
    </div>
  )
}
