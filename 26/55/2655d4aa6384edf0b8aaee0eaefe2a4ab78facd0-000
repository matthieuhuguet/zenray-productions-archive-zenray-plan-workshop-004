import { createShareLink, issueShareToken } from '../lib/shareLinks.js'
import { urlLectureAffichage } from '../lib/urlLecture.js'
import { attachmentUrl, isCreateMediaPath } from './planAttachments.js'

// Reuse Create's public viewer; large existing films are not uploaded again. (19 October 2026, 01:08 Paris)
export async function linkCreateAttachment(path, { mode = 'auto', origin = window.location.origin } = {}) {
  if (!isCreateMediaPath(path)) throw new Error('Choose a Create media file (.media.json or .img.json).')
  const response = await fetch(urlLectureAffichage(path))
  if (!response.ok) throw new Error(`Create file could not be read (${response.status}).`)
  const data = await response.json()
  if (data.missing || !data.markdown) throw new Error('Create file not found.')
  const manifest = JSON.parse(data.markdown)
  const image = path.endsWith('.img.json')
  const video = Boolean(manifest.mpd || manifest.master || ['dash', 'hls', 'fmp4-single'].includes(manifest.type) || String(manifest.mime).startsWith('video/'))
  const useView = mode !== 'download' && (image || video)
  const name = manifest.name || manifest.title || path.split('/').pop().replace(/\.(media|img)\.json$/, '')
  if (useView) {
    const shared = await createShareLink(image ? 'image' : 'video', path, { permanent: true })
    return { name, path, size: manifest.size || 0, mime: manifest.mime || '', source: 'create', mode: 'view', token: shared.token, url: new URL(shared.url, origin).href }
  }
  if (manifest.type !== 'chunked-media' || manifest.alg !== 'AES-GCM') throw new Error('This media uses a shared viewer. Choose the shared view option.')
  const shared = await issueShareToken('file', path)
  return { name, path, size: manifest.size || 0, mime: manifest.mime || '', source: 'create', mode: 'download', token: shared.token, url: attachmentUrl(shared.token, origin) }
}
