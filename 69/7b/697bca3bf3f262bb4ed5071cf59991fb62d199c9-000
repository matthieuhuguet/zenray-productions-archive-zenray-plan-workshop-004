// 21 October 2026: the ledger skips what the index holds, re-indexes what changed, survives a restart, and can be forgotten.
import { afterEach, expect, it } from 'vitest'
import { mkdtemp, rm, writeFile } from 'node:fs/promises'
import os from 'node:os'
import path from 'node:path'
import { createIndexLedger } from './index-ledger.mjs'

const roots = []
afterEach(async () => { await Promise.all(roots.splice(0).map((root) => rm(root, { recursive: true, force: true }))) })
const ledgerPath = async () => { const root = await mkdtemp(path.join(os.tmpdir(), 'index-ledger-')); roots.push(root); return path.join(root, 'IndexedPaths.txt') }

it('skips a recorded manifest, indexes a changed one, and keeps the record across a restart', async () => {
  const file = await ledgerPath()
  const ledger = createIndexLedger(file)
  const a = { path: 'pages/A/a.file.json', sha256: 'aaa' }, b = { path: 'pages/A/b.file.json', sha256: 'bbb' }
  expect(await ledger.missing([a, b])).toEqual([a, b])
  expect(await ledger.record([a])).toBe(1)
  expect(await ledger.record([a])).toBe(0)
  expect(await ledger.missing([a, b])).toEqual([b])
  // same path, new content: the thumbnail may have changed, so it goes through the index again
  expect(await ledger.missing([{ path: a.path, sha256: 'a2' }])).toHaveLength(1)
  const restarted = createIndexLedger(file)
  expect(await restarted.missing([a, b])).toEqual([b])
})

it('fails open on a damaged ledger and forgets on request', async () => {
  const file = await ledgerPath()
  await writeFile(file, 'not a ledger line\n\u0000\u0000')
  const ledger = createIndexLedger(file)
  const entry = { path: 'pages/A/a.file.json', sha256: 'aaa' }
  expect(await ledger.missing([entry])).toEqual([entry])
  await ledger.record([entry])
  expect(await ledger.missing([entry])).toEqual([])
  await ledger.forget()
  expect(await ledger.missing([entry])).toEqual([entry])
  expect(await createIndexLedger(file).missing([entry])).toEqual([entry])
})
