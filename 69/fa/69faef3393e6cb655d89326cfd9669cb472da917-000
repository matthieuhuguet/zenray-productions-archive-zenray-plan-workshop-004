{
  "_comment": "23 October 2026: every value of ZenRay Knowledge lives here (HDA interface). FR : toutes les valeurs du moteur Knowledge, en un seul endroit.",
  "memory": {
    "roots": [
      { "path": "~/.claude/Memory1", "label": "Memory1" },
      { "path": "~/.claude/rules", "label": "rules" },
      { "path": "~/.claude/CLAUDE.md", "label": "CLAUDE.md" }
    ],
    "exclude": [
      "(^|/)\\.git/", "^Skills/", "^Japanese/Japanese[2-9]\\.md$", "^Projects/.*/FEEDBACK\\.md$", "(^|/)FileMap\\.md$",
      "(^|/)ConversationIndex\\.md$", "^Credentials/", "^Documents/Sensible/", "^tmp", "^_TEMP/", "(^|/)AGENTS\\.md$",
      "(^|/)GEMINI\\.md$", "/node_modules/", "^Mails/", "^Knowledge/"
    ],
    "dropSections": ["API / Passwords", "Credentials", "Confidential", "Mots de passe"],
    "unitChars": 24000
  },
  "conversations": {
    "claude": "~/.claude/projects",
    "codex": "~/.codex/sessions",
    "gemini": "~/.gemini/antigravity/conversations",
    "geminiReader": "scripts/Assets/ReadGeminiConversation.py",
    "maxQuestionChars": 700,
    "maxAnswerChars": 5000,
    "pairsPerUnit": 28,
    "skipPrompt": ["^Base directory for this skill", "^Do this task here", "^<", "^\\[Image", "^(status|ok|go|oui|non|continue|merci)\\b.{0,12}$"]
  },
  "extract": {
    "backend": "api",
    "apiModel": "claude-haiku-5-5",
    "maxOutputTokens": 32000,
    "model": "haiku",
    "effort": "high",
    "_effortNote": "23 October 2026: max never finishes on a memory unit (64 000 thinking tokens, cut, no answer); high answers in about 100 s for about 0.02 USD with every proof valid.",
    "timeoutMs": 600000,
    "maxUnitsPerRun": 40,
    "drainBatch": 6,
    "drainPauseSeconds": 5,
    "maxParagraphs": 3,
    "maxAnswerChars": 1400,
    "minProofChars": 12
  },
  "backfill": {
    "_comment": "23 October 2026: reading order of the first pass by agents, most useful first. FR : ordre de lecture de la premiere passe.",
    "priority": ["^Memory1/Identity/", "^CLAUDE.md", "^rules/", "^Memory1/(Business|HealthSport|PVT)/", "^Memory1/(Culture|Design|ZenRayShards|Houdini|Japanese/Japanese1)", "^Memory1/(SocialMedia|Storytelling|Animation|UnrealEngine|Substance|Stock|AudioProductions)/", "^Memory1/(Tools|docs|ZenRayProductions|MotivationLetters|Socrate|Learning|Focus|SEO|Workflows|Prompts)/", "^Memory1/(Documents|Masterclass|Posts|CalendarMemory)/", "^Memory1/Projects/"]
  },
  "domains": ["Japonais", "Houdini et 3D", "Jeu et Unreal", "Tech et drive", "Business et argent", "Santé et sport", "Japon et PVT", "Identité et valeurs", "Culture", "Design et typographie", "Apprentissage", "Autre"],
  "store": {
    "dir": "~/.claude/Memory1/Knowledge",
    "jsonl": "Questions1.jsonl",
    "markdown": "Questions1.md"
  },
  "index": {
    "shardBytes": 700000,
    "minTokenLength": 2,
    "maxIndexBytes": 8000000
  },
  "cloud": {
    "repo": "matthieuhuguet/zenray-data",
    "branch": "main",
    "folder": "knowledge",
    "indexPath": "knowledge/index.json",
    "shardPrefix": "knowledge/entries-",
    "statusPath": "knowledge/engine.json",
    "inboxPath": "knowledge/inbox.json",
    "pushAttempts": 6,
    "author": { "name": "ZenRay Knowledge", "email": "knowledge@zenray.local" }
  },
  "service": {
    "label": "com.zenray.knowledge",
    "port": 3103,
    "schedule": { "timeZone": "Europe/Paris", "hours": [0, 6, 12, 18] },
    "tickSeconds": 60,
    "inboxPollSeconds": 600,
    "bodyLimitBytes": 32768,
    "allowedOrigins": ["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3300", "http://127.0.0.1:3300", "http://localhost:5173", "http://127.0.0.1:5173", "https://zenray-progress.pages.dev"]
  }
}
