    }
  }

  // 14 October 2026: automatic backups of one project start at most once per `watch.backupMinIntervalSeconds`. Generated notes (feedback, file map,
  // conversation index) used to trigger 460 one-or-two-file passes a day, each paying a full inventory and publication.
  scheduleBackup(id, { continuation = false } = {}) {
    if (this.disposed || !this.state(id).watched) return
    if (this.pending.has(id)) { this.dirty.add(id); return }
    const minimumMs = (this.config.watch.backupMinIntervalSeconds || 0) * 1000
    const wait = continuation ? 0 : (this.lastBackupStartedAt.get(id) || 0) + minimumMs - Date.now()
    if (wait > 0) {
      if (!this.backupDelayTimers.has(id)) {
        const timer = setTimeout(() => { this.backupDelayTimers.delete(id); this.scheduleBackup(id, { continuation: true }) }, wait)
        timer.unref(); this.backupDelayTimers.set(id, timer)
      }
