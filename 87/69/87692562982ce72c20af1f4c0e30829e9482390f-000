    const candidates = new Map(Object.entries(this.state(id).sceneAudits || {}))
    if (this.config.sceneAudit?.discoverScenes) {
      const excludedFolders = new Set([...(this.config.sceneAudit.excludedFolders || []), this.config.storage.versionDirectory].filter(Boolean))
      for (const file of this.state(id).inventory?.localFiles || []) {
        const source = this.project(id).sources.find((entry) => entry.id === file.sourceId)
        if (!['tmp', 'houdini'].includes(source?.namespace) || !/\.hip(?:lc|nc)?$/i.test(file.relativePath) || file.relativePath.split('/').slice(0, -1).some((segment) => excludedFolders.has(segment.toLowerCase()))) continue
        if (!candidates.has(file.id)) candidates.set(file.id, null)
      }
    }
    for (const [key, pending] of this.sceneAuditTimers) if (key.startsWith(`${id}/`) && !candidates.has(key.slice(id.length + 1))) {
      clearTimeout(pending.timer); this.sceneAuditTimers.delete(key)
    }
    for (const key of this.sceneAuditErrors.keys()) if (key.startsWith(`${id}/`) && !candidates.has(key.slice(id.length + 1)) && !this.sceneAuditTasks.has(key)) this.sceneAuditErrors.delete(key)
    for (const [fileId, entry] of candidates) {
