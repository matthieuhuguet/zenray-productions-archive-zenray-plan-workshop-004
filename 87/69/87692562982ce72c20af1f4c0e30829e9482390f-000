  }

  async createWatcher() {
    if (this.watcher) return this.watcher
    // 2 October 2026, 13:22 CEST: compile the existing TypeScript watcher instead of copying its logic.
    let factory = this.watchFactory
    if (!factory) {
      const source = await readFile(path.join(this.repoRoot, 'Cloud/electron/watcher.ts'), 'utf8')
      const fingerprint = createHash('sha256').update(source).digest('hex').slice(0, 16)
      const runtime = path.join(this.config.storage.stateDir, 'runtime', `CloudWatcher-${fingerprint}.mjs`)
      await mkdir(path.dirname(runtime), { recursive: true })
      const { transform } = await import('esbuild')
      const { code } = await transform(source, { loader: 'ts', format: 'esm', target: 'node22' })
      await writeFile(runtime, code, { mode: 0o600 })
      factory = (await import(new URL(`file://${runtime}`))).Surveillance
    }
    this.watcher = new factory((sourceKey) => {
      const id = sourceKey.split(':')[0]
      this.scheduleBackup(id)
    }, () => this.config.watch.settleSeconds, () => this.config.watch.reconnectSeconds,
    (sourceKey, detail) => {
      const id = sourceKey.split(':')[0]
      // 3 October 2026, 03:12 CEST: recovering one source must not erase another source's ongoing failure.
      if (/rétablie/.test(detail)) {
        this.watchErrors.delete(sourceKey)
        // 3 October 2026, 03:29 CEST: discover changes missed while disconnected instead of waiting for the next backup sweep.
        this.scheduleInventory(id)
      } else this.watchErrors.set(sourceKey, detail)
      this.event(id, 'watch', detail)
    }, undefined, (sourceKey) => this.scheduleInventory(sourceKey.split(':')[0]))
    this.sweep = setInterval(() => {
      for (const [id, state] of this.states) if (state.watched) this.scheduleBackup(id)
    }, this.config.watch.sweepSeconds * 1000)
    this.sweep.unref()
    return this.watcher
  }

  // 2 October 2026: local discovery advances independently of the cloud writer and its settling delay.
