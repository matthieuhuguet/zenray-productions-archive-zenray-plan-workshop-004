  }

  // 2 October 2026, 15:10 CEST: cloud recovery is tested again before removing managed copies.
  // 3 October 2026, 09:47 CEST: keep the change token of the bytes actually verified instead of later user-edited bytes.
  async restoreOriginal(backup, destination, job, signal, verification = null) {
    destination = path.resolve(destination)
    const token = await this.getToken()
    const result = await this.runProcess(path.join(this.repoRoot, 'Cloud', 'scripts', 'restaurer.mjs'),
      [backup.sourceFolder, backup.relativePath, destination, `--manifest=${backup.relativeManifest}`, `--sha256=${backup.sha256}`],
      { env: { ...process.env, GITHUB_TOKEN: token }, signal, onEvent: (event) => { job.progress = { ...event, scopeId: backup.id } } })
    const restored = result.lastEvent
    if (restored?.ev !== 'restaure' || !restored.cible || !isInside(destination, path.resolve(restored.cible))) throw new Error('Restore engine did not confirm a scoped destination')
    const target = await realpath(restored.cible)
    if (!isInside(destination, target) || target !== restored.cible) throw new Error('Restored file escaped the workspace')
    const metadata = await lstat(target)
    if (!metadata.isFile() || metadata.size !== backup.size || await hashLocalFile(target) !== backup.sha256) throw new Error('Independent restore byte verification failed')
    const after = await lstat(target)
    if (changeToken(after) !== changeToken(metadata) || await realpath(target) !== target) throw new Error('Restored file changed during independent verification')
    if (verification) verification.changeToken = changeToken(after)
    return target
  }

  // 10 October 2026, 12:36 CEST: the plan and operation share every actual loaded file, including canonical memory copies.
  async prepareUnloadProof(id, fileIds, { checkIdle = false } = {}) {
    const state = this.state(id)
    const workspace = path.join(this.config.storage.workspaceDir, id)
    const current = JSON.parse(await readFile(path.join(workspace, 'Current.json'), 'utf8'))
    if (current.projectId !== id || current.path !== state.workspacePath || path.dirname(current.path) !== path.join(workspace, 'loads')) throw new Error('No verified active workspace to unload')
    if (!current.files?.length) throw new Error('No loaded files to unload')
    if (checkIdle && process.platform === 'darwin') await assertWorkspaceIdle(current.path)
    if (state.inventory.localFiles.some((file) => file.sourceConflict)) throw new Error('Original and loaded copy diverged; retain both versions before unloading')
    if (fileIds && current.files.some((file) => !fileIds.includes(file.id))) throw new Error('Unload requires the complete loaded workspace; clear the selection')
    const candidates = new Map(current.files.map((file) => [file.id, file]))
    for (const file of state.inventory.localFiles.filter((entry) => entry.loadedCopy)) candidates.set(file.id, { ...candidates.get(file.id), id: file.id, path: file.localPath })
    if (fileIds && [...candidates.keys()].some((fileId) => !fileIds.includes(fileId))) throw new Error('Unload requires the complete loaded workspace; clear the selection')
    const files = []
    for (const file of candidates.values()) {
      if (!isInside(current.path, file.path)) throw new Error('Loaded file escaped its workspace')
      const hash = await hashLocalFile(file.path)
      const backup = [state.backups[file.id], file.backup].find((entry) => entry?.sha256 === hash)
      if (!backup) throw new Error('Modified workspace file retained: archive the working copy first')
      files.push({ ...backup, relativePath: path.relative(current.path, file.path).split(path.sep).join('/'), backup: { ...backup } })
    }
    const metadata = (await workspaceFinderMetadata(current.path)).filter((entry) => !files.some((file) => file.relativePath === entry.relativePath))
    const completeProof = [...files, ...metadata]
    await verifyWorkspaceTree(current.path, completeProof)
    return { state, workspace, current, files, metadata, completeProof }
