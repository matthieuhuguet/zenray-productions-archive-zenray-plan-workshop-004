      const result = await execFileAsync('python3', [this.config.storage.feedbackWriter, 'add', id, payload.summary, '--file', project.feedbackPath, '--kind', 'iteration', '--event-id', eventId, '--source', `checkpoint:${payload.agent}:${payload.sessionId}`, '--json'])
      await this.inventory(id)
      this.scheduleBackup(id)
      return { checkpoint: { ...JSON.parse(result.stdout), eventId, backupConfirmed: false }, checkedAt: new Date().toISOString() }
    }
    if (action === 'history') {
      const project = this.project(id)
      const events = await readProjectHistory(project, this.state(id).inventory?.localFiles || [], this.events.filter((event) => event.projectId === id), {
        progressPath: this.config.storage.progressPath,
      })
      return { events, feedbackPath: project.feedbackPath, checkedAt: new Date().toISOString() }
    }
    if (action === 'publish') {
      if (!this.cloudPublisher) throw new Error('Cloud publisher unavailable')
      await this.publishProject(id)
      return { project: this.snapshot(id), checkedAt: new Date().toISOString() }
    }
    if (action === 'register') return { project: await this.register(payload.project), checkedAt: new Date().toISOString() }
    // 8 October 2026, 16:38 CEST: keep menu bar polling independent of every project's full file inventory.
    if (action === 'dashboard') {
      const transferRates = this.dashboardTransferRates()
      // 8 October 2026, 16:57 CEST: read conversation-index health once for the compact response.
      const conversationIndexProjects = this.conversationIndexSync?.status().projects || {}
      const projects = [...this.projects.keys()].map((projectId) => {
        const project = this.project(projectId), state = this.state(projectId)
        const allJobs = (state.jobs || []).map((jobId) => this.jobs.get(jobId)).filter(Boolean)
        const activeJobs = allJobs.filter((job) => ['queued', 'running'].includes(job.state))
        const latestJob = allJobs.at(-1)
        const visibleJobs = latestJob && !activeJobs.includes(latestJob) ? [...activeJobs, latestJob] : activeJobs
        const jobs = visibleJobs.map((job) => {
          const values = job.progress && typeof job.progress === 'object'
            ? Object.fromEntries(['ev', 'envoyes', 'recus', 'done', 'total', 'seen', 'ko'].flatMap((key) => {
              const value = job.progress[key]
              return key === 'ev' ? typeof value === 'string' ? [[key, value]] : []
                : Number.isFinite(value) && value >= 0 ? [[key, value]] : []
            })) : {}
          return { id: job.id, type: job.type, state: job.state, error: job.error || null,
            progress: Object.keys(values).length ? values : null, createdAt: job.createdAt || '' }
        })
        // 9 October 2026, 00:34 CEST: expose counts only, never project file paths, to the menu bar.
        const localFiles = Array.isArray(state.inventory?.localFiles) ? state.inventory.localFiles : null
        const backups = Object.values(state.backups || {})
        const stats = localFiles ? {
          fileCount: new Set([...localFiles.map((file) => file.id), ...Object.keys(state.backups || {})]).size,
          macFileCount: localFiles.length,
          cloudFileCount: backups.length,
          pendingUploadCount: localFiles.filter((file) => {
            const backup = state.backups?.[file.id]
            return !backup?.sha256 || !file.sha256 || backup.sha256 !== file.sha256 || backup.size !== file.size
          }).length,
          loadedFileCount: Object.values(state.restorations || {}).filter((entry) => state.workspacePath && isInside(state.workspacePath, entry.path)).length,
          localBytes: localFiles.reduce((sum, file) => sum + (Number.isFinite(file.size) ? file.size : 0), 0),
          cloudBytes: backups.reduce((sum, file) => sum + (Number.isFinite(file.size) ? file.size : 0), 0),
        } : null
        const watchError = [...this.watchErrors].filter(([key]) => key.startsWith(`${projectId}:`)).map(([, value]) => value).join('; ') || null
        const sceneAuditError = [...this.sceneAuditErrors].filter(([key]) => key.startsWith(`${projectId}/`)).map(([, value]) => value).join('; ') || null
        return { id: projectId, name: project.name, workspace: { state: state.workspacePath ? 'loaded' : 'unloaded' },
          stats, errors: [state.error, this.feedbackError, watchError, sceneAuditError, conversationIndexProjects[projectId]?.error].filter(Boolean), jobs }
      })
      return { schemaVersion: this.config.schemaVersion, checkedAt: new Date().toISOString(), transferRates, projects }
    }
    if (action === 'list' || action === 'status' && !id) {
      for (const projectId of this.projects.keys()) if (!this.state(projectId).inventory) await this.inventory(projectId)
      return { schemaVersion: this.config.schemaVersion, checkedAt: new Date().toISOString(), bridge: { connected: true, state: 'connected' },
        projects: [...this.projects.keys()].map((projectId) => this.snapshot(projectId)), events: this.events }
    }
    if (action === 'inventory') return { project: await this.inventory(id), checkedAt: new Date().toISOString() }
    // 3 October 2026, 03:44 CEST: Finder opens the verified project workshop, never a path supplied by the client.
    if (action === 'open-workshop') {
      const project = await this.inventory(id)
      const directory = projectWorkshopPath(project)
      if (!directory || !(await lstat(directory)).isDirectory() || await realpath(directory) !== directory) throw new Error('Project workshop unavailable or unsafe')
      await this.openDirectory(directory)
      return { workshopPath: directory, checkedAt: new Date().toISOString() }
    }
    if (action === 'status') return { project: this.snapshot(id), checkedAt: new Date().toISOString() }
    if (action === 'archive' || action === 'restore') {
      const selection = payload.fileIds ?? null
      if (selection !== null && (!Array.isArray(selection) || selection.some((value) => typeof value !== 'string'))) throw new Error('Invalid file selection')
      return this.enqueue(id, action, (job, signal) => action === 'archive'
        ? this.archiveNow(id, selection, job, signal) : this.restoreNow(id, selection, job, signal))
    }
    if (action === 'unload' || action === 'recover') {
      const selection = payload.fileIds ?? null
      if (selection !== null && (!Array.isArray(selection) || selection.some((value) => typeof value !== 'string'))) throw new Error('Invalid file selection')
      return this.enqueue(id, action, (job, signal) => action === 'unload' ? this.unloadNow(id, selection, job, signal) : this.recoverNow(id, job, signal))
    }
    if (action === 'load-plan' || action === 'unload-plan') {
      await this.inventory(id)
      // 10 October 2026, 12:30 CEST: UNLOAD plans describe managed copies, never kept production sources.
      if (action === 'unload-plan') {
        try {
          const { files, metadata } = await this.prepareUnloadProof(id, payload.fileIds ?? null)
          return { plan: { projectId: id, action: 'unload', dryRun: true, executable: false, count: files.length,
            bytes: files.reduce((sum, file) => sum + file.size, 0), entries: files.map((file) => ({ ...file, ready: true })),
            retainedMetadataCount: metadata.length, blockers: [], dependencies: this.project(id).dependencies || [] }, checkedAt: new Date().toISOString() }
        } catch (error) {
          return { plan: { projectId: id, action: 'unload', dryRun: true, executable: false, count: 0, bytes: 0, entries: [],
            blockers: [{ reason: error.message }], dependencies: this.project(id).dependencies || [] }, checkedAt: new Date().toISOString() }
        }
      }
      const files = this.snapshot(id).files
      return { plan: buildWorkspacePlan(this.project(id), files, { action: 'load', fileIds: payload.fileIds ?? null }), checkedAt: new Date().toISOString() }
    }
    if (action === 'watch') return { project: await this.setWatch(id, payload.enabled), checkedAt: new Date().toISOString() }
    if (action === 'cloud-snapshot') return { project: this.snapshot(id, { cloud: true }), checkedAt: new Date().toISOString() }
    throw new Error('Unsupported Assets workspace action')
  }

  // 9 October 2026, 00:37 CEST: rates use byte deltas from active transfer events and reset at file boundaries.
  dashboardTransferRates() {
    const now = Date.now()
    const activeSamples = new Set()
    const rates = { uploadBytesPerSecond: 0, downloadBytesPerSecond: 0 }
    for (const job of this.jobs.values()) {
      if (job.state !== 'running') continue
      const progress = job.progress || {}
      const direction = job.type === 'archive' && Number.isFinite(progress.envoyes) && ['chunk', 'transfer'].includes(progress.ev)
        ? 'upload' : ['restore', 'recover'].includes(job.type) && progress.ev === 'download' && Number.isFinite(progress.recus)
          ? 'download' : null
      if (!direction) continue
      const bytes = progress[direction === 'upload' ? 'envoyes' : 'recus']
      const scope = progress.scopeId || progress.sourceId || ''
      const key = `${job.id}:${direction}`
      const previous = this.dashboardTransferSamples.get(key)
      activeSamples.add(key)
      if (previous && previous.scope === scope && bytes >= previous.bytes) {
        const elapsed = Math.max(1, now - previous.at)
        rates[`${direction}BytesPerSecond`] += (bytes - previous.bytes) * 1000 / elapsed
      }
      this.dashboardTransferSamples.set(key, { bytes, scope, at: now })
    }
    for (const key of this.dashboardTransferSamples.keys()) if (!activeSamples.has(key)) this.dashboardTransferSamples.delete(key)
    return Object.fromEntries(Object.entries(rates).map(([key, value]) => [key, Math.round(value)]))
  }

  async handleHttp(req, res) {
    const send = (status, value) => { res.statusCode = status; res.setHeader('content-type', 'application/json'); res.end(JSON.stringify(value)) }
    const remote = req.socket?.remoteAddress || ''
    if (!['127.0.0.1', '::1', '::ffff:127.0.0.1'].includes(remote)) { send(403, { error: 'Local bridge accepts loopback clients only', code: 'not-loopback' }); return }
    const origin = req.headers.origin
    if (origin && !this.config.bridge.allowedOrigins.includes(origin)) { send(403, { error: 'Origin refused', code: 'origin-refused' }); return }
    if (!origin && req.headers['sec-fetch-site'] && req.headers['sec-fetch-site'] !== 'same-origin') { send(403, { error: 'Browser origin required', code: 'origin-required' }); return }
    if (origin) { res.setHeader('access-control-allow-origin', origin); res.setHeader('vary', 'Origin') }
    res.setHeader('cache-control', 'no-store')
    if (req.method === 'OPTIONS') {
      res.setHeader('access-control-allow-methods', 'POST, OPTIONS')
      res.setHeader('access-control-allow-headers', 'content-type, x-zr-auth, x-zr-assets-client')
      res.setHeader('access-control-allow-private-network', 'true')
      send(204, {}); return
    }
    if (req.method !== 'POST') { send(405, { error: 'POST required', code: 'method-refused' }); return }
    if (!String(req.headers['content-type'] || '').startsWith('application/json') || req.headers['x-zr-assets-client'] !== '2') {
      send(403, { error: 'Assets client header required', code: 'client-required' }); return
    }
    const secret = process.env.ZENRAY_API_SECRET
    if (secret) {
      const given = Buffer.from(String(req.headers['x-zr-auth'] || '')), expected = Buffer.from(secret)
      if (given.length !== expected.length || !timingSafeEqual(given, expected)) { send(401, { error: 'Authentication required', code: 'auth-required' }); return }
    }
    try {
      let body = req.body
      if (!body) {
        const chunks = []; let bytes = 0
        for await (const chunk of req) {
          bytes += chunk.length
          if (bytes > this.config.bridge.bodyLimitBytes) { send(413, { error: 'Request too large', code: 'body-limit' }); return }
          chunks.push(chunk)
        }
        body = JSON.parse(Buffer.concat(chunks).toString('utf8'))
      }
      if (!body || typeof body !== 'object' || typeof body.action !== 'string') throw new Error('Action required')
      send(200, await this.request(body.action, body))
    } catch (error) { send(400, { error: errorText(error), code: 'workspace-failed', checkedAt: new Date().toISOString() }) }
  }

  async handlePreview(req, res) {
    // 2 October 2026, 13:20 CEST: expiring image capabilities expose only inventoried regular files.
    const remote = req.socket?.remoteAddress || ''
    if (!['127.0.0.1', '::1', '::ffff:127.0.0.1'].includes(remote)) { res.statusCode = 403; res.end(); return }
    let descriptor
    try {
      const url = new URL(req.url, 'http://127.0.0.1')
      const id = url.searchParams.get('projectId'), fileId = url.searchParams.get('fileId'), expires = url.searchParams.get('expires')
      const signature = createHmac('sha256', this.previewSecret).update(`${id}:${fileId}:${expires}`).digest('hex')
      const given = Buffer.from(url.searchParams.get('token') || ''), expected = Buffer.from(signature)
      if (!expires || Number(expires) < Date.now() || Number(expires) > Date.now() + 600000 || given.length !== expected.length || !timingSafeEqual(given, expected)) throw new Error('Preview expired')
      const file = this.state(id).inventory?.localFiles.find((entry) => entry.id === fileId)
      const source = this.project(id).sources.find((entry) => entry.id === file?.sourceId)
      const extension = path.extname(file?.relativePath || '').toLowerCase()
      const mime = { '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.webp': 'image/webp', '.avif': 'image/avif', '.gif': 'image/gif' }[extension]
      if (!file || !mime || !source || !isInside(file.workingRoot || source.localPath, file.localPath) || await realpath(file.localPath) !== file.localPath) throw new Error('Preview source unavailable')
      descriptor = await open(file.localPath, constants.O_RDONLY | constants.O_NOFOLLOW)
      const metadata = await descriptor.stat()
      if (!metadata.isFile()) throw new Error('Preview requires a regular file')
      res.setHeader('content-type', mime); res.setHeader('content-length', metadata.size); res.setHeader('cache-control', 'private, max-age=60')
      res.setHeader('x-content-type-options', 'nosniff')
      // 3 October 2026, 03:10 CEST: retain and explicitly close the handle after completion or client disconnection.
      await pipeline(descriptor.createReadStream({ autoClose: false }), res)
    } catch {
      if (res.headersSent || res.destroyed) { if (!res.destroyed) res.destroy() }
      else { res.statusCode = 404; res.end('Preview unavailable') }
    } finally { if (descriptor) await descriptor.close() }
  }

  async close() {
    this.disposed = true
    await this.conversationMirror.close()
    await this.conversationIndexSync.close()
    this.feedbackCapture?.close()
    this.watcher?.toutOublier()
    if (this.sweep) clearInterval(this.sweep)
    for (const timer of this.watchRetryTimers.values()) clearTimeout(timer)
    for (const timer of this.retryTimers || []) clearTimeout(timer)
    for (const timer of this.backupDelayTimers.values()) clearTimeout(timer)
    for (const timer of this.inventoryTimers.values()) clearTimeout(timer)
    for (const { timer } of this.sceneAuditTimers.values()) clearTimeout(timer)
    for (const { controller } of this.sceneAuditTasks.values()) controller.abort()
    await Promise.allSettled([...this.sceneAuditTasks.values()].map((task) => task.promise))
    for (const controller of this.controllers) controller.abort()
    await this.queue.catch(() => {})
    await this.contextIndexQueue.catch(() => {})
    this.sleepInhibitor?.stop()
    this.sleepInhibitorActive = false
  }
}

export async function createAssetsService({ configPath = DEFAULT_ASSETS_CONFIG, config, ...options } = {}) {
  return new AssetsService(config || JSON.parse(await readFile(configPath, 'utf8')), options).initialize()
}

async function main() {
  const [action = 'status', value, ...argumentsList] = process.argv.slice(2)
  const configArg = argumentsList.find((entry) => entry.startsWith('--config='))
  const configPath = configArg?.slice('--config='.length) || DEFAULT_ASSETS_CONFIG
  const config = JSON.parse(await readFile(configPath, 'utf8'))
  // 12 October 2026: parameters in one place, AssetsConfig.json storage.identityProof; `enabled: false` restores the full probe.
  const { enabled: identityEnabled = false, ...identitySettings } = config.storage.identityProof || {}
  const identityProver = identityEnabled
    ? createArchiveIdentityProver({ config: identitySettings, scratchParent: config.storage.stateDir,
      getToken: async () => process.env.GITHUB_TOKEN || (await execFileAsync('gh', ['auth', 'token'], { timeout: config.bridge.requestTimeoutMs })).stdout.trim() })
    : null
  const service = await createAssetsService({ config, identityProver })
  if (action === 'serve') {
    const port = Number(value || service.config.bridge.port)
    const server = http.createServer((req, res) => {
      if (new URL(req.url, `http://127.0.0.1:${port}`).pathname !== service.config.bridge.path) { res.statusCode = 404; res.end(); return }
      service.handleHttp(req, res).catch(() => { res.statusCode = 500; res.end('Service failure') })
    })
    await service.startWatching()
    server.listen(port, '127.0.0.1', () => console.log(`Assets bridge ready on http://127.0.0.1:${port}`))
    for (const signal of ['SIGINT', 'SIGTERM']) process.once(signal, () => { server.close(); service.close().finally(() => process.exit(0)) })
    return
  }
  let payload = { projectId: value }
  if (action === 'register' || action === 'init') payload = { project: JSON.parse(await readFile(value, 'utf8')) }
  if (action === 'watch') payload.enabled = !argumentsList.includes('--off')
  const fileArg = argumentsList.find((entry) => entry.startsWith('--files='))
  if (fileArg) payload.fileIds = JSON.parse(await readFile(fileArg.slice('--files='.length), 'utf8'))
  const result = await service.request(action === 'init' ? 'register' : action, payload)
  if (result.jobId) {
    await service.queue
    const job = service.jobs.get(result.jobId)
    console.log(JSON.stringify({ ...result, job, project: service.snapshot(value) }, null, 2))
    if (job.state === 'error') process.exitCode = 1
  } else console.log(JSON.stringify(result, null, 2))
  await service.close()
}

if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) main().catch((error) => { console.error(errorText(error)); process.exitCode = 1 })
