// 9 October 2026, 23:10 CEST: keep macOS awake only while a cloud transfer is active, then release it.
export function createIdleSleepInhibitor({ platform = process.platform, spawnProcess = spawn, retryMs = 60000 } = {}) {
  let child = null, retryTimer = null, requested = false, onError = () => {}
  const scheduleRetry = (error) => {
    onError(error)
    if (!requested || retryTimer || platform !== 'darwin') return
    retryTimer = setTimeout(() => { retryTimer = null; launch() }, retryMs)
    retryTimer.unref?.()
  }
  const launch = () => {
    if (!requested || child || platform !== 'darwin') return
    let next
    try { next = spawnProcess('/usr/bin/caffeinate', ['-i', '-w', String(process.pid)], { stdio: 'ignore' }) }
    catch (error) { scheduleRetry(error); return }
    child = next
    next.once('error', (error) => {
      if (child !== next) return
      child = null
      scheduleRetry(error)
    })
    next.once('exit', (code, signal) => {
      if (child !== next) return
      child = null
      if (requested) scheduleRetry(new Error(`caffeinate exited unexpectedly (${signal || code})`))
    })
  }
  return {
    start(onFailure = () => {}) {
      onError = onFailure
      if (requested || platform !== 'darwin') return
      requested = true
      launch()
    },
    stop() {
      requested = false
      if (retryTimer) clearTimeout(retryTimer)
      retryTimer = null
      const current = child
      child = null
      try { current?.kill('SIGTERM') } catch {}
    },
  }
}

// 14 October 2026: bounded-concurrency map that keeps input order; the first failure stops handing out new work.
export async function mapLimit(items, limit, task) {
  const results = new Array(items.length)
  let next = 0, failure = null
  const worker = async () => {
    while (!failure && next < items.length) {
      const index = next++
      try { results[index] = await task(items[index], index) }
      catch (error) { failure ||= { error }; return }
    }
  }
  await Promise.all(Array.from({ length: Math.max(1, Math.min(limit || 1, items.length)) }, worker))
  if (failure) throw failure.error
  return results
}

// 14 October 2026: `space: 0` writes compact JSON (about 15 % smaller and faster to stringify) for machine-only state files.
export async function atomicJson(file, value, { space = 2 } = {}) {
  await mkdir(path.dirname(file), { recursive: true })
  const temporary = `${file}.${process.pid}.${randomUUID()}.tmp`
  await writeFile(temporary, JSON.stringify(value, null, space || undefined), { mode: 0o600 })
  await rename(temporary, file)
}

export function validateSourceScope(source, config) {
  const target = path.resolve(source.localPath)
  // 3 October 2026, 04:03 CEST: explicit library roots extend a source family without granting access to their parent folders.
  const roots = [config.roots[source.namespace], ...(config.additionalRoots?.[source.namespace] || [])].map((root) => path.resolve(root))
  const root = roots.filter((entry) => isInside(entry, target)).sort((a, b) => b.length - a.length)[0]
  if (!root) throw new Error(`Source outside configured ${source.namespace} root`)
  if (target === root && !source.include?.length) throw new Error('A whole source root requires an explicit include list')
  const protectedParts = new Set(config.scan.blockedSegments.map((entry) => entry.toLowerCase()))
  const check = (value) => {
    if (value.split(path.sep).some((entry) => protectedParts.has(entry.toLowerCase()) || /^\.env(?:\.|$)/i.test(entry))) {
      throw new Error('Sensitive source path refused')
    }
  }
  check(target)
  for (const include of source.include || []) check(include)
  return target
}

export function isExcludedSourcePath(relativePath, source, config) {
  const parts = relativePath.split('/')
  const names = new Set([...config.scan.excludedNames, ...config.scan.blockedSegments].map((name) => name.toLowerCase()))
  if (parts.some((name) => names.has(name.toLowerCase()) || /^\.env(?:\.|$)/i.test(name) || name.startsWith('._'))) return true
  if (!config.scan.includeHidden && parts.some((name) => name.startsWith('.'))) return true
  if (config.scan.excludedExtensions.some((ext) => relativePath.toLowerCase().endsWith(ext))) return true
  return [...config.scan.excludedPaths, ...(source.exclude || [])].some((exclude) => {
    const relative = relativePath.toLowerCase()
    const scope = exclude.toLowerCase()
    return relative === scope || relative.startsWith(`${scope}/`) || relative.includes(`/${scope}/`)
  })
}

export async function scanSource(source, config) {
  const root = validateSourceScope(source, config)
  const files = [], issues = [], excluded = []
  let checkedRoot
  try {
    const entry = await lstat(root)
    checkedRoot = await realpath(root)
    if (entry.isSymbolicLink() || checkedRoot !== root || !entry.isDirectory()) throw new Error('Source root must be a real directory without symlink ancestors')
  } catch (error) {
    return { source: { ...source, present: false, count: 0, bytes: 0, status: error.code === 'ENOENT' ? 'missing' : 'error',
      checkedAt: new Date().toISOString() }, files, excluded,
      issues: source.optional && error.code === 'ENOENT' ? [] : [{ sourceId: source.id, code: error.code || 'unsafe-root', message: errorText(error) }] }
  }
  const destinations = new Set()
  const visit = async (directory, prefix = '') => {
    let entries
    try { entries = await readdir(directory, { withFileTypes: true }) }
    catch (error) { issues.push({ sourceId: source.id, relativePath: prefix, code: error.code, message: errorText(error) }); return }
    for (const entry of entries.sort((a, b) => a.name.localeCompare(b.name))) {
      const rawRelative = prefix ? `${prefix}/${entry.name}` : entry.name
      if (isExcludedSourcePath(rawRelative, source, config)) { excluded.push(rawRelative); continue }
      const absolute = path.join(directory, entry.name)
      if (entry.isSymbolicLink()) { excluded.push(rawRelative); issues.push({ sourceId: source.id, relativePath: rawRelative, code: 'symlink-skipped' }); continue }
      if (entry.isDirectory()) {
        if (!source.include || source.include.some((include) => include === rawRelative || include.startsWith(`${rawRelative}/`) || rawRelative.startsWith(`${include}/`))) {
          await visit(absolute, rawRelative)
        }
        continue
      }
      if (!entry.isFile() || !pathIsSelected(rawRelative, source.include)) continue
      if (files.length >= config.scan.maxFiles) throw new Error('Inventory limit exceeded; incomplete inventory refused')
      let relativePath
      try { relativePath = safeRelativePath(rawRelative) }
      catch { issues.push({ sourceId: source.id, relativePath: rawRelative, code: 'invalid-path' }); continue }
      const collisionKey = relativePath.toLowerCase()
      if (destinations.has(collisionKey)) throw new Error(`Case or Unicode filename collision in ${source.id}: ${relativePath}`)
      destinations.add(collisionKey)
      try {
        const metadata = await lstat(absolute)
        if (!metadata.isFile() || metadata.isSymbolicLink()) throw new Error('File changed type during scan')
        files.push({ id: workspaceFileId(source.id, relativePath), sourceId: source.id, relativePath,
          localPath: absolute, size: metadata.size, mtimeMs: metadata.mtimeMs, ctimeMs: metadata.ctimeMs,
          changeToken: changeToken(metadata) })
      } catch (error) { issues.push({ sourceId: source.id, relativePath, code: error.code || 'scan-failed', message: errorText(error) }) }
    }
  }
  await visit(root)
  return { source: { ...source, present: true, status: issues.some((issue) => issue.code !== 'symlink-skipped') ? 'error' : 'present',
    count: files.length, bytes: files.reduce((sum, file) => sum + file.size, 0), checkedAt: new Date().toISOString() }, files, excluded, issues }
}

export async function snapshotSourceFile(file, destination, sourceRoot) {
  const actual = await realpath(file.localPath)
  if (actual !== file.localPath || !isInside(path.resolve(sourceRoot), actual)) throw new Error('Source escaped its declared root')
  const descriptor = await open(file.localPath, constants.O_RDONLY | constants.O_NOFOLLOW)
  try {
    const before = await descriptor.stat()
    // 8 October 2026, 15:45 CEST: accept a ctime-only touch after inventory, then fingerprint the exact stable snapshot.
    const [expectedDevice, expectedInode, expectedSize, expectedMtime] = String(file.changeToken || '').split(':')
    if (!before.isFile() || !Number.isFinite(Number(expectedMtime)) || String(before.dev) !== expectedDevice || String(before.ino) !== expectedInode || before.size !== file.size || before.size !== Number(expectedSize) || before.mtimeMs !== Number(expectedMtime)) throw new Error('Source changed since inventory')
    const snapshotToken = changeToken(before)
    await mkdir(path.dirname(destination), { recursive: true })
    const hash = createHash('sha256')
    const hashing = new Transform({ transform(chunk, _encoding, callback) { hash.update(chunk); callback(null, chunk) } })
    await pipeline(descriptor.createReadStream({ autoClose: false }), hashing, createWriteStream(destination, { flags: 'wx', mode: before.mode & 0o777 }))
    const after = await descriptor.stat()
    if (changeToken(after) !== snapshotToken) throw new Error('Source changed during snapshot')
    const currentPath = await lstat(file.localPath)
    if (!currentPath.isFile() || currentPath.isSymbolicLink() || changeToken(currentPath) !== snapshotToken || await realpath(file.localPath) !== file.localPath) throw new Error('Source changed during snapshot')
    return { ...file, ctimeMs: after.ctimeMs, changeToken: snapshotToken, sha256: hash.digest('hex') }
  } catch (error) { await rm(destination, { force: true }); throw error }
  finally { await descriptor.close() }
}

export async function hashLocalFile(file, expectedToken = null) {
  const hash = createHash('sha256')
  if (!expectedToken) {
    for await (const chunk of createReadStream(file)) hash.update(chunk)
    return hash.digest('hex')
  }
  // 3 October 2026, 10:09 CEST: a version comparison hashes the inventoried descriptor, never a substituted path.
  const descriptor = await open(file, constants.O_RDONLY | constants.O_NOFOLLOW)
  try {
    const before = await descriptor.stat()
    if (!before.isFile() || changeToken(before) !== expectedToken) throw new Error('Source changed before version comparison')
    for await (const chunk of descriptor.createReadStream({ autoClose: false })) hash.update(chunk)
    if (changeToken(await descriptor.stat()) !== expectedToken) throw new Error('Source changed during version comparison')
    return hash.digest('hex')
  } finally { await descriptor.close() }
}

export function batchWorkspaceFiles(files, config) {
  const batches = []
  let current = [], bytes = 0
  for (const file of files) {
    if (current.length && (current.length >= config.storage.batchFiles || bytes + file.size > config.storage.batchBytes)) {
      batches.push(current); current = []; bytes = 0
    }
    current.push(file); bytes += file.size
  }
  if (current.length) batches.push(current)
  return batches
}

export async function runAssetProcess(script, args, { env = process.env, onEvent = () => {}, signal, cwd = REPO_ROOT, timeoutMs = 0, killGraceMs = 0 } = {}) {
  return new Promise((resolve, reject) => {
    const child = spawn(process.execPath, [script, ...args], { cwd, env, stdio: ['ignore', 'pipe', 'pipe'], detached: process.platform !== 'win32' })
    let buffered = '', last = '', lastEvent = null
    let timeout, killTimeout, timedOut = false, settled = false, abortError = null
    const killTree = (signalName) => {
      if (!child.pid) return
      if (process.platform === 'win32') { child.kill(signalName); return }
      try { process.kill(-child.pid, signalName) }
      catch (error) { if (error.code !== 'ESRCH') child.kill(signalName) }
    }
    const processGroupExists = () => {
      if (!child.pid) return false
      if (process.platform === 'win32') return child.exitCode === null
      try { process.kill(-child.pid, 0); return true }
      catch (error) { return error.code !== 'ESRCH' }
    }
    const finish = (callback, value) => {
      if (settled) return
      settled = true
      clearTimeout(timeout)
      if (!timedOut && !abortError) clearTimeout(killTimeout)
      signal?.removeEventListener('abort', onAbort)
      callback(value)
    }
    const beginStop = (error) => {
      if (timedOut || abortError) return
      if (error?.code === 'ASSET_PROCESS_TIMEOUT') timedOut = true
      else abortError = error
      killTree('SIGTERM')
      killTimeout = setTimeout(() => { if (processGroupExists()) killTree('SIGKILL'); killTimeout = null }, Math.max(0, killGraceMs))
      killTimeout.unref?.()
    }
    const onAbort = () => {
      const reason = signal?.reason
      const error = new Error(reason instanceof Error ? reason.message : 'The operation was aborted', { cause: reason })
      error.name = 'AbortError'
      error.code = 'ABORT_ERR'
      beginStop(error)
    }
    const line = (value) => {
      if (!value.startsWith('{"zr":')) return
      try { const event = JSON.parse(value); lastEvent = event; onEvent(event) } catch {}
    }
    child.stdout.on('data', (data) => {
      buffered += data
      let index
      while ((index = buffered.indexOf('\n')) >= 0) { line(buffered.slice(0, index)); buffered = buffered.slice(index + 1) }
    })
    child.stderr.on('data', (data) => { last = (last + errorText(data)).slice(-1600) })
    child.once('error', (error) => finish(reject, timedOut ? new Error(`Asset engine timed out after ${timeoutMs} ms`) : abortError || error))
    child.once('close', (code) => {
      if (buffered) line(buffered)
      if (timedOut) finish(reject, new Error(`Asset engine timed out after ${timeoutMs} ms`))
      else if (abortError) finish(reject, abortError)
      else if (code !== 0) finish(reject, new Error(`Asset engine failed (${code}): ${last.trim() || 'see engine logs'}`))
      // 12 October 2026: preserve failed verification diagnostics even when the child exits zero.
      else finish(resolve, { code, lastEvent, diagnostics: last.trim() })
    })
    // 9 October 2026, 22:30 CEST: terminate the whole child process group so nested Git workers cannot outlive a retry.
    if (signal?.aborted) onAbort()
    else signal?.addEventListener('abort', onAbort, { once: true })
    // 9 October 2026, 22:30 CEST: bound cloud child work so the persistent watcher can retry after a network stall.
    if (Number.isFinite(timeoutMs) && timeoutMs > 0) timeout = setTimeout(() => {
      beginStop(Object.assign(new Error(`Asset engine timed out after ${timeoutMs} ms`), { code: 'ASSET_PROCESS_TIMEOUT' }))
    }, timeoutMs)
    timeout?.unref?.()
  })
}

export class AssetsService {
  constructor(config, { repoRoot = REPO_ROOT, runProcess = runAssetProcess, getToken, publishCloud = null, watchFactory = null, identityProver = null, runSceneAudit, runScenePreparation, sleepInhibitor, openDirectory = (directory) => execFileAsync('/usr/bin/open', [directory], { timeout: config.bridge.requestTimeoutMs }) } = {}) {
    this.previewSecret = randomUUID()
    this.config = config
    this.repoRoot = repoRoot
    this.runProcess = runProcess
    this.sleepInhibitor = sleepInhibitor ?? (config.storage.preventIdleSleepDuringTransfers ? createIdleSleepInhibitor({ retryMs: config.storage.retryMs }) : null)
    this.sleepInhibitorActive = false
    this.sleepWarningRecorded = false
    this.openDirectory = openDirectory
    this.getToken = getToken || (async () => process.env.GITHUB_TOKEN || (await execFileAsync('gh', ['auth', 'token'], { timeout: config.bridge.requestTimeoutMs })).stdout.trim())
    this.cloudPublisher = publishCloud
    // null = every unload keeps its full restore probe (the behaviour before 12 October 2026)
    this.identityProver = identityProver
    this.watchFactory = watchFactory
    // 3 October 2026, 04:25 CEST: scene analysis runs independently of inventory and cloud writes.
    this.runSceneAudit = runSceneAudit || (config.sceneAudit?.enabled ? createSceneAuditRunner({ ...config.sceneAudit, auditScriptPath: path.join(repoRoot, 'scripts/Assets/AuditHoudiniScene.py'), preparationScriptPath: path.join(repoRoot, 'scripts/Assets/PrepareHoudiniScene.py') }) : null)
    this.runScenePreparation = runScenePreparation || this.runSceneAudit?.prepare || null
    this.sceneAuditTimers = new Map()
    this.sceneAuditTasks = new Map()
    this.sceneAuditErrors = new Map()
    this.projects = new Map()
    this.states = new Map()
    this.jobs = new Map()
    this.dashboardTransferSamples = new Map()
    this.events = []
    this.conversationCatalog = createConversationCatalog({ stateDir: config.storage.stateDir, fileToken: changeToken })
    this.conversationMirror = createConversationMirror({ catalog: this.conversationCatalog, service: this, atomicJson, snapshotFile: snapshotSourceFile, fileToken: changeToken, stateDir: config.storage.stateDir })
    // 7 October 2026, 10:30 CEST: each project's ConversationIndex regenerates by itself and is verified after every write.
    this.conversationIndexSync = createConversationIndexSync({ stateDir: config.storage.stateDir, catalog: this.conversationCatalog, onEvent: (projectId, type, detail) => this.event(projectId, type, detail) })
    this.writerQueue = Promise.resolve()
    this.workspaceQueues = new Map()
    this.saveSlots = new Map()
    this.revisions = new Map()
    this.filesMemo = new Map()
    this.lastBackupStartedAt = new Map()
    // 21 October 2026: what the search index already holds, so an unchanged manifest costs no index run (see lib/index-ledger.mjs).
    this.indexLedger = createIndexLedger(path.join(config.storage.stateDir, 'IndexedPaths.txt'))
    this.backupDelayTimers = new Map()
    this.queuedTasks = []
    this.completions = new Map()
    this.draining = false
    this.pending = new Set()
    this.dirty = new Set()
    this.controllers = new Set()
    this.watchErrors = new Map()
    this.watchRetryTimers = new Map()
    this.inventoryTimers = new Map()
    this.contextIndexQueue = Promise.resolve()
    this.disposed = false
  }

  // 21 October 2026: the pause after a refused index survives a restart; before, each reload of the service paid one more 34 s refusal.
  indexPausePath() { return path.join(this.config.storage.stateDir, 'IndexPause.json') }
  async loadIndexPause() {
    try { this.indexBlockedUntil = Number(JSON.parse(await readFile(this.indexPausePath(), 'utf8')).until) || 0 }
    catch { this.indexBlockedUntil = 0 }
  }
  async setIndexPause(until) {
    this.indexBlockedUntil = until
    try { await writeFile(this.indexPausePath(), JSON.stringify({ until, at: new Date().toISOString() }), { mode: 0o600 }) } catch { /* the pause then only lasts until the next restart */ }
  }

  async initialize() {
    await mkdir(this.config.storage.stateDir, { recursive: true })
    await this.loadIndexPause()
    // 15 October 2026: a write interrupted by a crash leaves `<file>.<pid>.<uuid>.tmp` behind (a 16 MB one was found). Only such files older
    // than an hour are removed, never one a live writer could still own.
    try {
      const stale = Date.now() - 60 * 60 * 1000
      for (const name of await readdir(this.config.storage.stateDir)) {
        if (!/\.\d+\.[0-9a-f-]{36}\.tmp$/.test(name)) continue
        const target = path.join(this.config.storage.stateDir, name)
        if ((await lstat(target)).mtimeMs < stale) await rm(target, { force: true })
      }
    } catch { /* cleanup is best effort */ }
    try { this.events = (await readFile(path.join(this.config.storage.stateDir, 'Events.jsonl'), 'utf8')).split('\n').filter(Boolean).map((line) => JSON.parse(line)).slice(-this.config.storage.maxEvents) }
    catch (error) { if (error.code !== 'ENOENT') throw new Error('Project history is unreadable; original events retained') }
    const definitions = [...this.config.projects]
    try {
      const registry = JSON.parse(await readFile(path.join(this.config.storage.stateDir, 'Projects.json'), 'utf8'))
      for (const project of registry.projects || []) {
        const position = definitions.findIndex((entry) => entry.id === project.id)
        if (position < 0) definitions.push(project); else definitions[position] = project
      }
    } catch (error) { if (error.code !== 'ENOENT') throw new Error('Runtime project registry is unreadable') }
    for (const definition of definitions) {
      const project = this.validateProject(definition)
      this.projects.set(project.id, project)
      let state = { backups: {}, restorations: {}, watched: false, jobs: [] }
      try { state = { ...state, ...JSON.parse(await readFile(this.statePath(project.id), 'utf8')) } }
      catch (error) { if (error.code !== 'ENOENT') state.error = 'Saved project status is unreadable; inventory required' }
      if (['queued', 'running', 'restoring'].includes(state.syncState)) {
        state.syncState = 'interrupted'; state.error = 'Previous service stopped before completion; backup can resume'
      }
      // 2 October 2026, 15:10 CEST: reconcile an interrupted release without deleting anything at startup.
      for (const release of state.releases || []) {
        if (!['prepared', 'removing', 'interrupted'].includes(release.phase)) continue
        try { await lstat(release.activePath) }
        catch (error) { if (error.code !== 'ENOENT') throw error; if (state.workspacePath === release.activePath) state.workspacePath = null }
      }
      this.states.set(project.id, state)
    }
    return this
  }

  validateProject(definition) {
    const project = normalizeWorkspaceProject(definition, this.config.storage)
    // 13 October 2026, 09:55 CEST: thumbnail indexing is an explicit per-project choice.
    if (project.indexThumbnailMode && !['resolve', 'paths-only'].includes(project.indexThumbnailMode)) throw new Error('Unknown index thumbnail mode')
    for (const source of project.sources) validateSourceScope(source, this.config)
    return project
  }

  statePath(id) { return path.join(this.config.storage.stateDir, `Project-${id}.json`) }
  project(id) { const project = this.projects.get(id); if (!project) throw new Error('Unknown project id'); return project }
  state(id) { this.project(id); return this.states.get(id) }
  // 2 October 2026, 15:35 CEST: same-project state writes stay ordered while uploads and recovery run independently.
  get queue() { return Promise.all([this.writerQueue, ...this.workspaceQueues.values()]) }
