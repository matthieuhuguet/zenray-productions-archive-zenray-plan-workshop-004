  async proveByIdentity(id, file, localPath, job, session) {
    if (!session) return { proven: false, reason: 'disabled' }
    const settings = this.identityProver.settings
    const statsPath = path.join(this.config.storage.stateDir, settings.statsFileName)
    let plan
    try { plan = await reserveVerificationSlot({ statsPath, config: settings }) }
    catch (error) { return { proven: false, reason: 'counter-unavailable', detail: errorText(error) } }
    if (plan.mode !== 'identity') return { proven: false, reason: plan.reason, sampledFull: plan.reason === 'sampled' }
    let result
    try {
      result = await session.prove({ manifestPath: file.backup.manifestPath, sha256: file.backup.sha256, size: file.backup.size, localPath })
    } catch (error) { result = { supported: true, ok: false, failure: { class: 'error', code: 'exception', message: errorText(error) } } }
    if (result.supported && result.ok) {
      await this.recordVerification(id, job, 'identity-v1', { counters: result.counters, seconds: result.seconds })
      return { proven: true }
    }
    const reason = !result.supported ? `unsupported-${result.reason}` : `failed-${result.failure.class}-${result.failure.code}`
    this.event(id, 'identity-proof-fallback', JSON.stringify({ fileId: file.id, reason }))
    return { proven: false, reason, escalated: true, unsupported: !result.supported }
  }

  async recordVerification(id, job, mode, detail = {}) {
    const state = this.state(id)
    state.verification ||= { identityProofCount: 0, fullReadBackCount: 0, lastMode: null, lastAt: null }
    const identity = mode === 'identity-v1'
    state.verification[identity ? 'identityProofCount' : 'fullReadBackCount'] += 1
    state.verification.lastMode = mode
    state.verification.lastAt = new Date().toISOString()
    job.verification ||= { identityProofCount: 0, fullReadBackCount: 0 }
    job.verification[identity ? 'identityProofCount' : 'fullReadBackCount'] += 1
    const settings = this.identityProver?.settings
    if (settings) {
      const statsPath = path.join(this.config.storage.stateDir, settings.statsFileName)
      const reason = detail.sampledFull ? 'sampled' : detail.unsupported ? 'unsupported' : detail.escalated ? 'escalated' : 'configured'
      await recordVerificationOutcome({ statsPath, kind: identity ? 'identity' : 'full', reason }).catch(() => {})
    }
    await this.save(id)
  }

  async unloadNow(id, fileIds, job, signal) {
