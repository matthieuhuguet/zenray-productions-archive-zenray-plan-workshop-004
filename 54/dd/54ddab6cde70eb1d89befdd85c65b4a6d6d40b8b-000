import { describe, expect, it } from 'vitest'
import { mergeProjectConversations } from './assetsProjectConversations.js'

describe('project conversation links', () => {
  it('keeps evidence links visible without changing the primary project or inventing unreadable transcripts', () => {
    const rows = [
      { projectId: 'bayou', conversationId: 'codex:primary', sessionId: 'primary', provider: 'codex', strength: 'bound', boundProject: 'bayou', updatedAt: '2026-10-09T08:00:00.000Z' },
      { projectId: 'bayou', conversationId: 'gemini:evidence', sessionId: 'evidence', provider: 'gemini', strength: 'strong', boundProject: null, updatedAt: '2026-10-08T08:00:00.000Z' },
      { projectId: 'bayou', conversationId: 'claude:other', sessionId: 'other', provider: 'claude', strength: 'weak', boundProject: 'tiles', updatedAt: '2026-10-07T08:00:00.000Z' },
      { projectId: 'tiles', conversationId: 'claude:other', sessionId: 'other', provider: 'claude', strength: 'strong', boundProject: 'tiles' },
    ]
    const catalogue = [
      { id: 'codex:primary', title: 'Primary', provider: 'codex', readable: true, projectId: 'bayou' },
      { id: 'gemini:evidence', title: 'Evidence', provider: 'gemini', readable: true, projectId: 'research' },
    ]

    const linked = mergeProjectConversations(rows, catalogue, 'bayou')

    expect(linked.map(item => item.id)).toEqual(['codex:primary', 'gemini:evidence', 'claude:other'])
    expect(linked[0]).toMatchObject({ readable: true, linkRelation: 'primary', primaryProjectId: 'bayou' })
    expect(linked[1]).toMatchObject({ readable: true, linkRelation: 'evidence', primaryProjectId: 'research', linkStrength: 'strong' })
    expect(linked[2]).toMatchObject({ readable: false, unavailableReason: 'transcript-missing', primaryProjectId: 'tiles', linkRelation: 'evidence' })
  })
})
