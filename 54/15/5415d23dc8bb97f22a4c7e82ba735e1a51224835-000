// 3 October 2026, 16:05 CEST: all agent entrypoints use one authenticated local bridge.
import { readFile } from 'node:fs/promises'
import { fileURLToPath } from 'node:url'
import path from 'node:path'

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..')
export const config = JSON.parse(await readFile(path.join(root, 'scripts/AssetsConfig.json'), 'utf8'))

export async function requestAssets(payload) {
  let secret = process.env.ZENRAY_API_SECRET
  if (secret === undefined) {
    try { secret = (await readFile(path.join(root, '.env.local'), 'utf8')).match(/^\s*ZENRAY_API_SECRET\s*=\s*(.*?)\s*$/m)?.[1]?.replace(/^["']|["']$/g, '') }
    catch (error) { if (error.code !== 'ENOENT') throw error }
  }
  const response = await fetch(`http://127.0.0.1:${config.bridge.port}${config.bridge.path}`, {
    method: 'POST', headers: { 'content-type': 'application/json', 'x-zr-assets-client': '2', ...(secret ? { 'x-zr-auth': secret } : {}) },
    body: JSON.stringify(payload), signal: AbortSignal.timeout(config.bridge.requestTimeoutMs),
  })
  const result = await response.json()
  if (!response.ok || result.error) throw new Error(result.error || `Assets bridge returned ${response.status}`)
  return result
}
