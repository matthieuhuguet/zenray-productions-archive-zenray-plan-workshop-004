// canonical-rel.mjs (12 October 2026): the path of a file INSIDE a git clone, written with the case the disk (and so the index) holds.
// EN: APFS ignores case and git pathspecs do not. A series folder spelled "House of the Dragon" reaches the tracked "House Of The Dragon":
// `git commit -- <path>` then fails with "did not match any file(s) known to git", and the cleanup that follows used to delete the tracked
// manifest. Taking the case from the disk makes add, commit and checkout all name the tracked path.
// FR : le chemin relatif d'un fichier du clone avec la casse du disque, donc celle de l'index git.
import fs from 'node:fs'
import path from 'node:path'

export function canonicalRel(clone, absolutePath) {
  const root = fs.realpathSync.native(clone)
  const real = fs.realpathSync.native(absolutePath)
  const rel = path.relative(root, real)
  if (!rel || rel.startsWith('..') || path.isAbsolute(rel)) throw new Error(`path ${absolutePath} is outside the clone ${clone}`)
  return rel.split(path.sep).join('/')
}
