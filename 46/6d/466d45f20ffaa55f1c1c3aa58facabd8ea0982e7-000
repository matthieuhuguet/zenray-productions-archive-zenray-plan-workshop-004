import { useState } from 'react'
import { PALETTE, FONTS } from '../theme.js'
import DATA from '../objectives.json'
import { domProg, pc } from '../lib/lifeosProgress.js'
import { card, btn, SectionLabel, Bar } from './lifeosShared.jsx'

// Extrait de App.jsx (batch refactor structurel 2026-07-16).
/* ───────── Domains ───────── */
export function Domains({ t, steps, onToggle, onDone }) {
  return (
    <>
      <SectionLabel t={t} color={t.textSecondary}>Domaines</SectionLabel>
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill,minmax(320px,1fr))', gap: 14 }}>
        {DATA.domains.map((dom) => <DomainCard key={dom.key} t={t} dom={dom} steps={steps} onToggle={onToggle} onDone={onDone} />)}
      </div>
    </>
  )
}
export function DomainCard({ t, dom, steps, onToggle, onDone }) {
  const [open, setOpen] = useState(false)
  const p = domProg(steps, dom)
  const standby = dom.key === 'standby'
  return (
    <div style={{ ...card(t), padding: '16px 18px', opacity: standby ? 0.92 : 1 }}>
      <div onClick={() => setOpen(!open)} style={{ cursor: 'pointer', userSelect: 'none' }}>
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', marginBottom: 9, gap: 10 }}>
          <span style={{ fontWeight: 600, fontSize: 'var(--zr-ui-xl)' }}>{open ? '▾ ' : '▸ '}{dom.label}{standby && <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-3xs)', color: t.textSecondary, border: `1px solid ${t.border}`, borderRadius: 99, padding: '1px 7px', marginLeft: 8, textTransform: 'uppercase' }}>standby</span>}</span>
          <span style={{ fontFamily: FONTS.sans, color: PALETTE.primary, fontWeight: 700 }}>{pc(p)}%</span>
        </div>
        <Bar t={t} value={p} height={8} />
      </div>
      {open && <div style={{ marginTop: 12 }}>{dom.objectives.map((o) => <ObjectiveRow key={o.id} t={t} o={o} domain={dom.label} steps={steps} onToggle={onToggle} onDone={onDone} />)}</div>}
    </div>
  )
}
export function ObjectiveRow({ t, o, domain, steps, onToggle, onDone }) {
  const dragStart = (e) => { e.dataTransfer.setData('text/plain', JSON.stringify({ kind: 'obj', objId: o.id, title: o.title, domain })) }
  return (
    <div style={{ borderTop: `1px solid ${t.border}`, padding: '12px 0' }}>
      <div draggable onDragStart={dragStart} style={{ display: 'flex', justifyContent: 'space-between', gap: 8, cursor: 'grab' }}>
        <span style={{ fontWeight: 600 }}>{o.title}{o.produces_signal && <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: PALETTE.primary, border: `1px solid ${PALETTE.primary}`, borderRadius: 99, padding: '1px 6px', marginLeft: 6 }}>signal</span>}</span>
        <button onClick={() => onDone(o, domain)} title="Génère une carte à aujourd'hui" style={{ ...btn(t), whiteSpace: 'nowrap', fontSize: 'var(--zr-ui-sm)', padding: '4px 10px' }}>Fait ➜ agenda</button>
      </div>
      <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: t.textSecondary, margin: '3px 0 8px' }}>départ {o.pct || 0}% · {o.horizon}{o.measure ? ` · ${o.measure}` : ''}</div>
      <div>
        {(o.milestones || []).map((m, i) => {
          const done = !!steps[`${o.id}|${i}`]
          return (
            <div key={i} onClick={() => onToggle(o.id, i)} style={{ display: 'flex', gap: 9, alignItems: 'flex-start', padding: '3px 0', cursor: 'pointer' }}>
              <span style={{ flex: '0 0 16px', width: 16, height: 16, marginTop: 2, borderRadius: 5, border: `1.5px solid ${done ? PALETTE.green : t.textSecondary}`, background: done ? PALETTE.green : 'transparent', display: 'grid', placeItems: 'center', color: '#fff', fontSize: 'var(--zr-ui-xs)' }}>{done ? '✓' : ''}</span>
              <span style={{ fontSize: 'var(--zr-ui-md)', lineHeight: 1.4, color: done ? t.textSecondary : t.textPrimary, textDecoration: done ? 'line-through' : 'none' }}>{m.step}</span>
            </div>
          )
        })}
      </div>
      {o.next_action && <div style={{ fontSize: 'var(--zr-ui-sm)', color: PALETTE.primary, background: PALETTE.primarySoft, borderLeft: `3px solid ${PALETTE.primary}`, padding: '7px 10px', borderRadius: 7, marginTop: 8 }}>➜ {o.next_action}</div>}
    </div>
  )
}
