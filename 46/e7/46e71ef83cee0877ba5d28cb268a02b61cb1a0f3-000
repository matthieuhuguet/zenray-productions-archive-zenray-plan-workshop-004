// 20 October 2026, 15:10 CEST: HTML is opt-in, standalone, bounded and isolated from the application's credentials.
import { it, expect, vi } from 'vitest'
import { PROJECT_ARTICLE_CONFIG, articleThumbnail, projectArticleFile, projectArticleDocument, loadProjectArticle, linkedArticleFile } from './assetsProjectArticle.js'
const file = { id:'workshop:Article/index.html',name:'index.html',size:120,present:true,sourceId:'workshop',contentPath:'pages/test/index.html.file.json' }
it('only opens the explicitly selected HTML file',()=>{
  expect(projectArticleFile({files:[file]})).toBeNull()
  expect(projectArticleFile({article:{fileId:file.id},files:[file]})).toEqual(file)
  expect(projectArticleFile({article:{fileId:'missing'},files:[file]})).toBeNull()
})
it('only accepts bounded image thumbnails, never a remote or active URL',()=>{
  expect(articleThumbnail({article:{thumbnailUrl:'data:image/webp;base64,YQ=='}})).toBe('data:image/webp;base64,YQ==')
  for(const url of ['https://untrusted.test/a.png','javascript:alert(1)','data:image/svg+xml;base64,YQ==']) expect(articleThumbnail({article:{thumbnailUrl:url}})).toBeNull()
})
it('removes active HTML and foreign resources while retaining internal navigation and the ChatGPT source link',()=>{
  const html=projectArticleDocument('<base href="https://bad.test"><meta http-equiv="refresh" content="0;url=https://bad.test"><script>top.stolen=1</script><form><input></form><iframe srcdoc="evil"></iframe><p onclick="bad()">Hello</p><img src="https://bad.test/x" onerror="bad()"><a href="javascript:bad()">bad</a><a href="#height">Height</a><a href="https://chatgpt.com">ChatGPT Image</a>')
  const doc=new DOMParser().parseFromString(html,'text/html')
  expect(doc.querySelector('script,form,base,iframe,[onclick],[onerror]')).toBeNull()
  expect(doc.querySelector('img').hasAttribute('src')).toBe(false)
  expect(doc.querySelector('a').hasAttribute('href')).toBe(false)
  expect(doc.querySelector('a[href="about:srcdoc#height"]')).not.toBeNull()
  expect(doc.querySelector('a[href="https://chatgpt.com"]').rel).toBe('noopener noreferrer')
  expect(doc.querySelector('meta[http-equiv]').content).toContain("default-src 'none'")
  expect(PROJECT_ARTICLE_CONFIG.sandbox).not.toContain('allow-scripts')
  expect(PROJECT_ARTICLE_CONFIG.sandbox).not.toContain('allow-same-origin')
})
it('reads local complete HTML once without touching the cloud',async()=>{
  const readLocal=vi.fn().mockResolvedValue({text:'<h1>Article</h1>',truncated:false}),readCloudBytes=vi.fn()
  expect(await loadProjectArticle(file,{connected:true,readLocal,readCloudBytes})).toContain('Article')
  expect(readCloudBytes).not.toHaveBeenCalled()
})
it('reads archived HTML with the Mac offline and falls back after a transient local error',async()=>{
  const readLocal=vi.fn().mockRejectedValue(new Error('offline')),readCloudBytes=vi.fn().mockResolvedValue({bytes:new TextEncoder().encode('<h1>Cloud</h1>')})
  expect(await loadProjectArticle(file,{connected:true,readLocal,readCloudBytes})).toContain('Cloud')
  expect(await loadProjectArticle(file,{connected:false,readLocal,readCloudBytes})).toContain('Cloud')
})
it('refuses truncated local HTML without an archive, empty content and oversized files before any read',async()=>{
  const readLocal=vi.fn().mockResolvedValue({text:'<h1>partial',truncated:true})
  await expect(loadProjectArticle({...file,contentPath:null},{connected:true,readLocal})).rejects.toThrow('tronquée')
  readLocal.mockResolvedValue({text:'',truncated:false})
  await expect(loadProjectArticle(file,{connected:true,readLocal})).rejects.toThrow('vide')
  const never=vi.fn()
  await expect(loadProjectArticle({...file,size:PROJECT_ARTICLE_CONFIG.maxBytes+1},{connected:true,readLocal:never})).rejects.toThrow('32 Mio')
  expect(never).not.toHaveBeenCalled()
})

// 21 October 2026 : a link names another HTML document of the project ; anything else falls back to the declared article
it('linkedArticleFile opens only an inventoried HTML file of the project', () => {
  const files = [{ id: 'workshop:Articles/index.html', name: 'index.html' }, { id: 'workshop:Articles/02-uv.html', name: '02-uv.html' }, { id: 'workshop:notes.txt', name: 'notes.txt' }]
  expect(linkedArticleFile({}, files, 'workshop:Articles/02-uv.html')?.id).toBe('workshop:Articles/02-uv.html')
  expect(linkedArticleFile({}, files, 'workshop:notes.txt')).toBe(null)
  expect(linkedArticleFile({}, files, 'workshop:missing.html')).toBe(null)
  expect(linkedArticleFile({}, files, null)).toBe(null)
})
