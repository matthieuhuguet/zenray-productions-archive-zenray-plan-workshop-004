// ZenRayMedia — catalogue de composants construit depuis les registres déjà présents.
// Vite produit un chunk par registre/partie : ouvrir Media ne télécharge que le thème actif,
// jamais les 162 composants d'un coup.

import tokens0111 from './themes/T-01-1-1--une-nationale-du-matin/tokens.css?raw'
import tokens0112 from './themes/T-01-1-2--une-de-rupture/tokens.css?raw'
import tokens0113 from './themes/T-01-1-3--quotidien-de-reference-sobre/tokens.css?raw'
import tokens0114 from './themes/T-01-1-4--quotidien-economique-saumon/tokens.css?raw'
import tokens0115 from './themes/T-01-1-5--tabloid-daccroche/tokens.css?raw'
import tokens0411 from './themes/T-04-1-1--revelation-cinematique/tokens.css?raw'

const registries = import.meta.glob('./themes/*/component-registry.json', { import: 'default' })
const parts = import.meta.glob('./themes/*/parts/*.html', { query: '?raw', import: 'default' })
const tokenSheets = {
  'T-01-1-1': tokens0111,
  'T-01-1-2': tokens0112,
  'T-01-1-3': tokens0113,
  'T-01-1-4': tokens0114,
  'T-01-1-5': tokens0115,
  'T-04-1-1': tokens0411,
}

function themeDirectory(themeId) {
  const prefix = `./themes/${themeId}--`
  const key = Object.keys(registries).find((path) => path.startsWith(prefix))
  return key ? key.slice('./themes/'.length, key.indexOf('/component-registry.json')) : null
}

export async function loadThemeComponents(themeId) {
  const directory = themeDirectory(themeId)
  if (!directory) return { themeId, directory: null, components: [], tokensCss: '', definitionsHtml: '' }

  const registryKey = `./themes/${directory}/component-registry.json`
  const registry = await registries[registryKey]()
  const tokensCss = tokenSheets[themeId] || ''

  const entries = Array.isArray(registry) ? registry : (registry.components || [])
  const components = await Promise.all(entries.map(async (entry) => {
    // Le registre pointe vers les pages de documentation autonomes `components/`. L'éditeur
    // charge leurs homologues légers `parts/`, faits pour être assemblés dans une même page.
    const key = `./themes/${directory}/parts/${String(entry.file).split('/').pop()}`
    const html = parts[key] ? await parts[key]() : ''
    return { ...entry, html }
  }))
  const definitionsHtml = components.find((entry) => entry.id === '00-icons')?.html || ''
  return { themeId, directory, components, tokensCss, definitionsHtml }
}

export function groupComponents(components) {
  return (components || []).reduce((groups, component) => {
    const key = component.group || 'Autres'
    ;(groups[key] = groups[key] || []).push(component)
    return groups
  }, {})
}
