// THE « ADD YOUR PHOTOS » SHEET of a shared gallery (2 October 2026). What a wedding guest sees: ask their first name once, drop or pick photos
// (or a whole folder), watch them go out, done. It never shows an error: slow or failing connections only ever say « on continue ».
// The uploader itself lives in the page (useGuestUploader), so closing the sheet does not stop anything.
import React, { useEffect, useMemo, useRef, useState } from 'react'
import { createPortal } from 'react-dom'
import { PALETTE } from '../theme.js'
import Icon from '../components/Icon.jsx'
import SpinnerApple from '../components/SpinnerApple.jsx'
import { filesFromDataTransfer, filesFromInput } from './readDrop.js'
import { rememberedName } from './useGuestUploader.js'
import { cleanGuestName } from '../lib/guestNames.js'

const FONT = 'var(--zr-police-sans)'
const INK = '#1d1d1f'
const MUTED = 'rgba(29,29,31,0.62)'
const LINE = 'rgba(29,29,31,0.12)'
const MAX_TILES = 40

const btn = (primary = false, disabled = false) => ({
  height: 38, padding: '0 18px', borderRadius: 12, cursor: disabled ? 'default' : 'pointer', fontFamily: FONT, fontSize: 'var(--zr-ui-md)', fontWeight: 500,
  border: primary ? 'none' : `1px solid ${LINE}`, background: primary ? PALETTE.gradient : 'rgba(255,255,255,0.7)', color: primary ? '#fff' : INK,
  opacity: disabled ? 0.45 : 1, display: 'inline-flex', alignItems: 'center', gap: 8, whiteSpace: 'nowrap',
})

// A thumbnail of the photo as it is on the guest's own device (never a download): an object URL, released when the tile goes away.
function LocalThumb({ file, state }) {
  const [url, setUrl] = useState(null)
  useEffect(() => {
    let u = null
    try { u = URL.createObjectURL(file); setUrl(u) } catch { setUrl(null) }
    return () => { if (u) URL.revokeObjectURL(u) }
  }, [file])
  const done = state === 'done', sending = state === 'sending' || state === 'preparing'
  return (
    <div style={{ position: 'relative', width: 64, height: 64, borderRadius: 12, overflow: 'hidden', background: 'rgba(29,29,31,0.07)', flex: '0 0 auto' }}>
      {url && <img src={url} alt="" draggable={false} style={{ width: '100%', height: '100%', objectFit: 'cover', opacity: done ? 1 : 0.55, transition: 'opacity 200ms ease' }} />}
      {sending && <span style={{ position: 'absolute', inset: 0, display: 'grid', placeItems: 'center' }}><SpinnerApple taille={20} couleur="#fff" titre="Envoi" /></span>}
      {done && <span style={{ position: 'absolute', right: 4, bottom: 4, width: 20, height: 20, borderRadius: 99, background: PALETTE.green, display: 'grid', placeItems: 'center', boxShadow: '0 1px 4px rgba(0,0,0,0.25)' }}><Icon name="checkmark" size={12} color="#fff" weight={2.4} /></span>}
    </div>
  )
}

export default function GuestUploadSheet({ open, onClose, up, rootLabel, initialEntries, onView }) {
  const { snap, add, setName, createFolder, setSub } = up
  const [name, setNameInput] = useState(() => rememberedName())
  const [asked, setAsked] = useState(() => !!rememberedName())      // the name step is skipped when they already told us who they are
  const [over, setOver] = useState(false)
  const [newFolder, setNewFolder] = useState(null)                   // null = closed, string = being typed
  const [localSub, setLocalSub] = useState('')
  const fileInput = useRef(null), dirInput = useRef(null), nameInput = useRef(null)

  // a name already known is given to the uploader straight away (nothing is sent without one)
  useEffect(() => { if (asked && name.trim()) setName(name) }, [asked]) // eslint-disable-line react-hooks/exhaustive-deps
  // files dropped on the page while the sheet was closed
  const consumed = useRef(null)
  useEffect(() => { if (open && initialEntries && initialEntries !== consumed.current) { consumed.current = initialEntries; add(initialEntries) } }, [open, initialEntries]) // eslint-disable-line react-hooks/exhaustive-deps
  useEffect(() => { if (open && !asked) setTimeout(() => nameInput.current && nameInput.current.focus(), 60) }, [open, asked])
  useEffect(() => {
    if (!open) return undefined
    const onKey = (e) => { if (e.key === 'Escape') { e.stopPropagation(); onClose() } }
    window.addEventListener('keydown', onKey, true)
    return () => window.removeEventListener('keydown', onKey, true)
  }, [open, onClose])

  const counts = snap ? snap.counts : { total: 0, done: 0, skipped: 0, active: 0, waiting: 0 }
  const folder = (snap && snap.folder) || cleanGuestName(name)
  const sendable = counts.total - counts.skipped
  const finished = sendable > 0 && counts.done >= sendable && snap && snap.idle
  const tiles = useMemo(() => {
    if (!snap) return []
    const live = snap.items.filter((i) => i.status !== 'skipped')
    const doing = live.filter((i) => i.status !== 'done')
    const recentDone = live.filter((i) => i.status === 'done').slice(-Math.max(8, MAX_TILES - doing.length))
    return [...recentDone, ...doing].slice(-MAX_TILES)
  }, [snap])
  const hidden = Math.max(0, sendable - tiles.length)
  const ratio = sendable ? Math.min(1, snap.items.filter((i) => i.status !== 'skipped').reduce((n, i) => n + (i.status === 'done' ? 1 : i.progress || 0), 0) / sendable) : 0

  if (!open) return null
  const choose = (entries) => { if (entries.length) add(entries) }
  const onDrop = async (e) => { e.preventDefault(); setOver(false); choose(await filesFromDataTransfer(e.dataTransfer)) }
  const confirmName = (e) => { e && e.preventDefault(); const n = cleanGuestName(name); setNameInput(n === 'Invité' && !name.trim() ? '' : n); if (!name.trim()) return; setName(n); setAsked(true) }
  const makeFolder = async (e) => {
    e && e.preventDefault()
    const n = (newFolder || '').trim(); setNewFolder(null)
    if (!n) return
    const made = await createFolder(n)
    if (made) { setLocalSub(made); setSub(made) }
  }

  const noticeText = !snap ? null : snap.notice === 'offline' ? 'Pas de connexion pour le moment : l’envoi reprendra tout seul dès que le réseau revient.'
    : snap.notice === 'waiting' ? 'La connexion est lente, on continue. Vous pouvez laisser cette page ouverte.'
    : snap.notice === 'daily' ? 'La galerie a reçu beaucoup de photos aujourd’hui. Les vôtres sont gardées sur cet appareil et partiront dès que possible.'
    : snap.notice === 'link' ? 'Ce lien n’accepte plus de nouvelles photos pour le moment.' : null
  const skippedType = snap ? snap.items.filter((i) => i.status === 'skipped' && i.reason === 'type').length : 0

  return createPortal((
    <div role="dialog" aria-modal="true" aria-label="Ajouter mes photos" onMouseDown={(e) => { if (e.target === e.currentTarget) onClose() }}
      style={{ position: 'fixed', inset: 0, zIndex: 400, display: 'grid', placeItems: 'center', padding: 'clamp(10px,3vw,28px)', background: 'rgba(20,22,30,0.42)', backdropFilter: 'blur(14px)', WebkitBackdropFilter: 'blur(14px)', fontFamily: FONT, color: INK, animation: 'zrQlFadeIn 200ms ease both' }}>
      <div onDragOver={(e) => { e.preventDefault(); setOver(true) }} onDragLeave={(e) => { if (e.currentTarget === e.target) setOver(false) }} onDrop={onDrop}
        style={{ width: 'min(560px, 100%)', maxHeight: 'min(760px, 94vh)', overflow: 'auto', borderRadius: 26, padding: '24px 24px 20px', background: 'rgba(253,253,252,0.92)', boxShadow: '0 30px 90px -20px rgba(20,30,70,0.45), inset 0 0 0 1px rgba(255,255,255,0.7)', boxSizing: 'border-box', animation: 'zrQlIn 200ms cubic-bezier(.2,.7,.3,1) both' }}>
        <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', gap: 12 }}>
          <div>
            <div style={{ fontFamily: 'var(--zr-police-serif)', fontWeight: 350, fontSize: 26, lineHeight: 1.15 }}>{asked ? 'Ajouter mes photos' : 'Bienvenue'}</div>
            <div style={{ color: MUTED, fontSize: 'var(--zr-ui-sm)', marginTop: 6 }}>{asked ? `Elles rejoignent la galerie « ${rootLabel} », dans un dossier à votre nom.` : `Vous allez ajouter vos photos à la galerie « ${rootLabel} ».`}</div>
          </div>
          <button onClick={onClose} aria-label="Fermer" style={{ width: 30, height: 30, borderRadius: 99, border: 'none', background: 'rgba(29,29,31,0.07)', cursor: 'pointer', display: 'grid', placeItems: 'center', flex: '0 0 auto' }}><Icon name="xmark" size={13} color={INK} weight={2.2} /></button>
        </div>

        {!asked && (
          <form onSubmit={confirmName} style={{ marginTop: 22 }}>
            <label style={{ display: 'block', fontSize: 'var(--zr-ui-sm)', color: MUTED, marginBottom: 8 }}>Comment vous appelez-vous ?</label>
            <input ref={nameInput} value={name} onChange={(e) => setNameInput(e.target.value)} placeholder="Votre prénom" maxLength={40} autoComplete="given-name"
              style={{ width: '100%', boxSizing: 'border-box', height: 50, borderRadius: 14, border: `1px solid ${LINE}`, padding: '0 16px', fontSize: 'var(--zr-ui-xl)', fontFamily: FONT, background: '#fff', color: INK, outline: 'none' }} />
            <div style={{ color: MUTED, fontSize: 'var(--zr-ui-xs)', marginTop: 8 }}>Vos photos seront rangées dans un dossier portant votre nom. Personne ne peut les supprimer.</div>
            <div style={{ marginTop: 18, display: 'flex', justifyContent: 'flex-end' }}>
              <button type="submit" disabled={!name.trim()} style={btn(true, !name.trim())}>Continuer</button>
            </div>
          </form>
        )}

        {asked && (
          <>
            <div style={{ display: 'flex', alignItems: 'center', gap: 8, flexWrap: 'wrap', marginTop: 18, fontSize: 'var(--zr-ui-sm)' }}>
              <span style={{ display: 'inline-flex', alignItems: 'center', gap: 7, padding: '6px 12px', borderRadius: 99, background: 'rgba(10,132,255,0.10)', color: PALETTE.primaryDark }}>
                <Icon name="folder" size={14} /> {folder}{localSub ? ` / ${localSub}` : ''}
              </span>
              <button onClick={() => { setAsked(false) }} style={{ border: 'none', background: 'none', color: MUTED, cursor: 'pointer', fontFamily: FONT, fontSize: 'var(--zr-ui-sm)', textDecoration: 'underline', padding: 0 }}>Ce n’est pas moi</button>
              <span style={{ flex: 1 }} />
              {newFolder === null
                ? <button onClick={() => setNewFolder('')} style={{ border: 'none', background: 'none', color: PALETTE.primary, cursor: 'pointer', fontFamily: FONT, fontSize: 'var(--zr-ui-sm)', padding: 0 }}>+ Nouveau dossier</button>
                : <form onSubmit={makeFolder} style={{ display: 'inline-flex', gap: 6 }}>
                    <input autoFocus value={newFolder} onChange={(e) => setNewFolder(e.target.value)} placeholder="Nom du dossier" maxLength={40} onKeyDown={(e) => { if (e.key === 'Escape') { e.stopPropagation(); setNewFolder(null) } }}
                      style={{ height: 30, borderRadius: 9, border: `1px solid ${LINE}`, padding: '0 10px', fontFamily: FONT, fontSize: 'var(--zr-ui-sm)', width: 150 }} />
                    <button type="submit" style={{ ...btn(true), height: 30, padding: '0 12px', fontSize: 'var(--zr-ui-sm)' }}>OK</button>
                  </form>}
            </div>

            <div style={{ marginTop: 14, borderRadius: 20, border: `2px dashed ${over ? PALETTE.primary : 'rgba(29,29,31,0.2)'}`, background: over ? 'rgba(10,132,255,0.07)' : 'rgba(29,29,31,0.025)', padding: counts.total ? '16px' : '34px 16px', textAlign: 'center', transition: 'all 160ms ease' }}>
              {!counts.total && (
                <>
                  <div style={{ display: 'inline-grid', placeItems: 'center', width: 54, height: 54, borderRadius: 18, background: 'rgba(10,132,255,0.10)', marginBottom: 12 }}><Icon name="photo" size={26} color={PALETTE.primary} weight={1.7} /></div>
                  <div style={{ fontSize: 'var(--zr-ui-xl)' }}>Glissez vos photos ici</div>
                  <div style={{ color: MUTED, fontSize: 'var(--zr-ui-sm)', margin: '6px 0 16px' }}>ou choisissez-les sur votre appareil</div>
                </>
              )}
              <div style={{ display: 'flex', justifyContent: 'center', gap: 10, flexWrap: 'wrap' }}>
                <button onClick={() => fileInput.current && fileInput.current.click()} style={btn(true)}><Icon name="plus" size={15} color="#fff" weight={2} /> Choisir des photos</button>
                <button onClick={() => dirInput.current && dirInput.current.click()} style={btn()}><Icon name="folder" size={15} /> Choisir un dossier</button>
              </div>
              <input ref={fileInput} type="file" accept="image/*" multiple hidden onChange={(e) => { choose(filesFromInput(e.target)); e.target.value = '' }} />
              <input ref={dirInput} type="file" webkitdirectory="" directory="" multiple hidden onChange={(e) => { choose(filesFromInput(e.target)); e.target.value = '' }} />
            </div>

            {counts.total > 0 && (
              <div style={{ marginTop: 18 }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', fontSize: 'var(--zr-ui-md)' }}>
                  <span>{finished ? <>Merci {folder} ! <span style={{ fontFamily: 'var(--zr-police-serif)' }}>{counts.done}</span> photo{counts.done > 1 ? 's' : ''} ajoutée{counts.done > 1 ? 's' : ''}</> : <>Envoi en cours · <span style={{ fontFamily: 'var(--zr-police-serif)' }}>{counts.done}</span> sur <span style={{ fontFamily: 'var(--zr-police-serif)' }}>{sendable}</span></>}</span>
                  <span style={{ color: MUTED, fontFamily: 'var(--zr-police-serif)', fontSize: 'var(--zr-ui-sm)' }}>{Math.round(ratio * 100)} %</span>
                </div>
                <div role="progressbar" aria-valuenow={Math.round(ratio * 100)} aria-valuemin={0} aria-valuemax={100} style={{ height: 6, borderRadius: 99, background: 'rgba(29,29,31,0.09)', overflow: 'hidden', marginTop: 8 }}>
                  <div style={{ width: `${Math.round(ratio * 100)}%`, height: '100%', borderRadius: 99, background: finished ? PALETTE.green : PALETTE.gradient, transition: 'width 250ms ease' }} />
                </div>
                {noticeText && <div style={{ marginTop: 10, color: MUTED, fontSize: 'var(--zr-ui-sm)', lineHeight: 1.4 }}>{noticeText}</div>}
                <div style={{ display: 'flex', flexWrap: 'wrap', gap: 8, marginTop: 14 }}>
                  {tiles.map((it) => <LocalThumb key={it.id} file={it.file} state={it.status} />)}
                  {hidden > 0 && <div style={{ width: 64, height: 64, borderRadius: 12, display: 'grid', placeItems: 'center', color: MUTED, fontSize: 'var(--zr-ui-sm)', background: 'rgba(29,29,31,0.05)' }}>+{hidden}</div>}
                </div>
                {skippedType > 0 && <div style={{ marginTop: 10, color: MUTED, fontSize: 'var(--zr-ui-xs)' }}>{skippedType} fichier{skippedType > 1 ? 's' : ''} ignoré{skippedType > 1 ? 's' : ''} : seules les photos sont acceptées.</div>}
              </div>
            )}

            {finished && (
              <div style={{ marginTop: 20, display: 'flex', justifyContent: 'flex-end', gap: 10, flexWrap: 'wrap' }}>
                <button onClick={() => fileInput.current && fileInput.current.click()} style={btn()}>Ajouter d’autres photos</button>
                <button onClick={() => { onView && onView(folder, localSub); onClose() }} style={btn(true)}>Voir mes photos</button>
              </div>
            )}
          </>
        )}
      </div>
    </div>
  ), document.body)
}
