// 4 October 2026: the CV and the latest published work, read from the website's own published source.
// The site is the single source of truth: src/cv/cvData.js (plain data), cvPdf.json (pinned PDFs), cvProjects.generated.json (Works order).
// FR : le CV et les derniers travaux publies, lus dans la source publiee du site, qui reste l'unique verite.
import { createHash } from 'node:crypto'

async function importData(source) {
  if (/^\s*import\s/m.test(source)) throw new Error('cvData.js now imports another module; the engine only reads plain data')
  return import(`data:text/javascript;base64,${Buffer.from(source).toString('base64')}`)
}

/** Loads the whole CV model from the website's published branch. Throws a named error if anything is unreadable. */
export async function loadCv({ gh, config }) {
  const { repo, branch, cvDataPath, cvPdfPath, projectsPath, site } = config.website
  const [dataSource, pdfSource, projectsSource, commit] = await Promise.all([
    gh.raw(repo, cvDataPath, branch), gh.raw(repo, cvPdfPath, branch), gh.raw(repo, projectsPath, branch), gh.head(repo, branch),
  ])
  const data = await importData(dataSource)
  const pdf = JSON.parse(pdfSource)
  const generated = JSON.parse(projectsSource)
  if (!Array.isArray(data.skills) || !Array.isArray(data.experiences) || !data.CV_IDENTITY) throw new Error('cvData.js lost an expected export (skills, experiences, CV_IDENTITY)')
  if (!Array.isArray(generated.projects) || !generated.projects.length) throw new Error('cvProjects.generated.json holds no project')
  return {
    identity: data.CV_IDENTITY, skills: data.skills, experiences: data.experiences, education: data.education || [], updated: data.CV_UPDATED || null,
    projects: generated.projects, site,
    pdf: { contentHash: pdf.contentHash || '', en: pdf.en?.url || '', fr: pdf.fr?.url || '' },
    fingerprint: createHash('sha256').update(dataSource).update(pdfSource).digest('hex').slice(0, 16),
    source: { repo, branch, commit },
  }
}

/** Published work, newest first as the Works page orders it, with its own URL and bilingual description. */
export function latestPublished(cv, count, lang = 'fr') {
  return cv.projects.slice(0, count).map((project) => ({ id: project.id, title: project.title.replace(/\s+-\s+Made with.*$/i, ''), brand: project.brand, url: project.url, description: project.description?.[lang] || project.description?.en || '' }))
}

/** The skills of the CV that an offer text actually mentions, so a letter can name what truly overlaps. */
export function overlappingSkills(cv, offerSkills) {
  const names = cv.skills.map((skill) => skill.name.toLowerCase())
  const aliases = { 'Unreal Engine': ['unreal engine 5', 'c++ / ue5'], Houdini: ['houdini'], Python: ['python'], Substance: ['substance designer', 'substance painter'], Maya: ['maya'], 'C++': ['c++ / ue5'], Unity: [], HDA: ['houdini'], VEX: ['houdini'], PCG: ['unreal engine 5'], Blueprints: ['unreal engine 5'], Niagara: ['unreal engine 5'], Blender: [], HLSL: [], 'C#': [] }
  return offerSkills.filter((skill) => (aliases[skill] || []).some((alias) => names.includes(alias)))
}
