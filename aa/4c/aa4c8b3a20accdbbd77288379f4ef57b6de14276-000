        )}
        {studio.messages.length > 0 && (
          <div style={{ display: 'flex', alignItems: 'center', gap: 6, fontFamily: P.sans, fontSize: 11.5, color: t.textSecondary }}>
            <span>{studio.messages.length} message{studio.messages.length > 1 ? 's' : ''} envoyé{studio.messages.length > 1 ? 's' : ''}</span>
