      <span style={{ fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
        {[country.code !== 'OTHER' ? `${country.flag} ${studio.city || country.label}` : studio.city, kindLabel(studio), sourceLabelOf(studio)].filter(Boolean).join(' · ')}
      </span>

      {/* 07 October 2026: Badges enrichis avec dates precises */}
      <span style={{ display: 'flex', gap: 6, flexWrap: 'wrap', alignItems: 'center' }}>
        {country.code !== 'OTHER' && (
          <Badge t={t} color={country.code === 'FR' ? UI.blue : country.code === 'JP' ? UI.orange : UI.gray} title={`Localisation : ${country.label}`}>
