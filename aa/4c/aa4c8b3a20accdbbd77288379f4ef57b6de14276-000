        ) : (
          <div style={{ display: 'flex', alignItems: 'baseline', justifyContent: 'space-between', gap: 6, flexWrap: 'wrap' }}>
            <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 14, color: t.textPrimary }}>
              Trouvée le {chrono.foundLabel || 'date inconnue'}
            </span>
            {chrono.daysSinceFound !== null && (
              <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 12, color: t.textSecondary }}>
                {chrono.daysSinceFound === 0 ? "aujourd'hui" : `il y a ${chrono.daysSinceFound} j`}
              </span>
            )}
