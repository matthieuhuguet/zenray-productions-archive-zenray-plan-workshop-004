        {engine && engine.letterPath && studio.status === 'to_contact' && <Badge t={t} color={UI.green} title="Une lettre est déjà écrite">Lettre prête</Badge>}
        {engine && engine.freelance && <Badge t={t} color={UI.purple}>Freelance</Badge>}
