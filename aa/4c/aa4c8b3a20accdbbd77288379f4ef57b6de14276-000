            <div style={{ display: 'flex', alignItems: 'center', gap: 6, flexWrap: 'wrap', fontFamily: P.sans, fontSize: 12, color: t.textSecondary }}>
              <span>Offre trouvée le <strong style={{ fontFamily: P.serif, fontWeight: P.numberWeight, color: t.textPrimary }}>{chrono.foundLabel}</strong></span>
              {chrono.daysToContact !== null && (
                <span>(contacté {chrono.daysToContact === 0 ? "le jour même" : `${chrono.daysToContact} jour${chrono.daysToContact > 1 ? 's' : ''} après`})</span>
