/** A small state read, outside the GitHub quota; a missing or unreadable file is just "not published yet". */
async function readDisplay(path) {
  try {
    const response = await fetch(urlLectureAffichage(path, { fresh: true }), { cache: 'no-cache' })
    if (!response.ok) return null
    const result = await response.json()
    return result.missing || typeof result.markdown !== 'string' ? null : JSON.parse(result.markdown)
  } catch { return null }
}

function Badge({ t, color, children, title }) {
  return <span title={title} style={{ ...glassStyle(t, color), padding: '2px 9px', fontSize: 11.5 }}>{children}</span>
}

/** One studio card: name, role, how well it fits, what it is, and the beginning of the last message sent. */
