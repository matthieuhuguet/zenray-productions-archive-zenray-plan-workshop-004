      <span style={{ display: 'flex', alignItems: 'baseline', gap: 10, minWidth: 0 }}>
        <span style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 18, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{studio.name}</span>
        {score !== null && (
          <span title={`Adéquation avec ton CV : ${score} sur 100`} style={{ marginLeft: 'auto', display: 'inline-flex', alignItems: 'center', gap: 6, fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 13, color: t.textPrimary }}>
            <span aria-hidden="true" style={{ width: 9, height: 9, borderRadius: 999, background: TIER_COLOR[tierOf(studio)] || UI.gray }} />{score}
