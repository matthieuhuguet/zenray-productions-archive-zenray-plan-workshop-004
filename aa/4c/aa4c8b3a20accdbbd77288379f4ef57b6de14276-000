        {studio.status === 'deprecated' && (
          <Badge t={t} color={UI.gray} title="Offre périmée / fermée sur le site source">
            <span>Périmé</span>{chrono.closedLabel ? ` · ${chrono.closedLabel}` : ''}
          </Badge>
        )}
        {studio.status === 'contacted' && <Badge t={t} color={UI.orange} title={`Contacté le ${chrono.contactedLabel}`}><span>Contacté</span> · {chrono.contactedLabel}</Badge>}
        {studio.status === 'declined' && <Badge t={t} color={UI.red} title="Refus reçu du studio"><span>Refusé</span>{refusalDate(studio) ? ` · ${readableDate(refusalDate(studio))}` : ''}</Badge>}
        {studio.status === 'replied' && <Badge t={t} color={UI.blue} title={`Activité le ${chrono.lastActivityLabel}`}><span>Réponse</span> · {chrono.lastActivityLabel}</Badge>}
