import React, { useState, useMemo } from 'react'
import PbrMaterialViewer from './PbrMaterialViewer.jsx'

// Studio de la collection ZenRayAssetsMaterials.
// Collection de materiaux PBR issus de Substance 3D Designer et Copernicus Houdini.
// Visualisation WebGL avec isolation de calques et base de sauvegarde.
// Zero tiret cadratin.

const P = {
  serif: 'var(--zr-police-serif)',
  sans: 'var(--zr-police-sans)',
  mono: 'var(--zr-police-mono)',
  serifWeight: 350,
  numberWeight: 400,
  accent: '#9A5B3C',
  radius: 8,
}

// Materiaux de demonstration reels et proceduraux
const DEFAULT_MATERIALS = [
  {
    id: 'bayou-slate-roof-shingles',
    name: 'Bayou Slate Roof Shingles',
    category: 'Architecture',
    sourceTool: 'Copernicus Houdini',
    sourceFile: 'LouisianaBayou_RoofShingles.copernicus',
    resolution: '2048 × 2048',
    summary: 'Tuiles d ardoise usees de la chapelle Louisiana Bayou, generees de facon procedurale dans Copernicus sous Houdini 22. Canaux Albedo, Normal, Roughness, Height et AO.',
    maps: {
      albedo: null,
      normal: null,
      roughness: null,
      metallic: null,
      height: null,
      ao: null,
    },
    channels: ['Albedo', 'Normal', 'Roughness', 'Height', 'AO'],
    date: '2026-09-19',
  },
  {
    id: 'procedural-river-cobblestone',
    name: 'Procedural River Cobblestone',
    category: 'Nature',
    sourceTool: 'Substance 3D Designer',
    sourceFile: 'River_Cobblestone_PBR.sbs',
    resolution: '2048 × 2048',
    summary: 'Paves de riviere arrondis avec boue et mousses en cavite, fabriques dans Adobe Substance 3D Designer. Cartes 16-bit complètes.',
    maps: {
      albedo: null,
      normal: null,
      roughness: null,
      metallic: null,
      height: null,
      ao: null,
    },
    channels: ['Albedo', 'Normal', 'Roughness', 'Metallic', 'Height', 'AO'],
    date: '2026-09-15',
  },
  {
    id: 'ornate-fabric-gold-brocade',
    name: 'Ornate Fabric Gold Brocade',
    category: 'Tissu',
    sourceTool: 'Substance 3D Designer',
    sourceFile: 'Substance_Ornate_Fabric.sbs',
    resolution: '2048 × 2048',
    summary: 'Tissu brode traditionnel a motif or et soie, avec tissage procedural microscopique et repartition metallique precise.',
    maps: {
      albedo: null,
      normal: null,
      roughness: null,
      metallic: null,
      height: null,
      ao: null,
    },
    channels: ['Albedo', 'Normal', 'Roughness', 'Metallic', 'Height'],
    date: '2026-08-30',
  },
  {
    id: 'procedural-aged-cypress-bark',
    name: 'Aged Cypress Bark',
    category: 'Nature',
    sourceTool: 'Copernicus Houdini',
    sourceFile: 'Cypress_Bark_Macro.hip',
    resolution: '4096 × 4096',
    summary: 'Ecorce de cypres chauve humide du bayou avec variations de microsillons et de creux d humidite sous Copernicus.',
    maps: {
      albedo: null,
      normal: null,
      roughness: null,
      height: null,
      ao: null,
    },
    channels: ['Albedo', 'Normal', 'Roughness', 'Height', 'AO'],
    date: '2026-09-18',
  },
]

export default function MaterialStudio({ project, t, onBack }) {
  const [selectedMaterial, setSelectedMaterial] = useState(null)
  const [category, setCategory] = useState('Tout')
  const [toolFilter, setToolFilter] = useState('Tous')
  const [query, setQuery] = useState('')

  const materials = useMemo(() => {
    return (project.materials && project.materials.length > 0) ? project.materials : DEFAULT_MATERIALS
  }, [project.materials])

  const categories = useMemo(() => {
    return ['Tout', ...new Set(materials.map((m) => m.category).filter(Boolean))]
  }, [materials])

  const tools = useMemo(() => {
    return ['Tous', ...new Set(materials.map((m) => m.sourceTool).filter(Boolean))]
  }, [materials])

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase()
    return materials.filter((m) => {
      const matchCat = category === 'Tout' || m.category === category
      const matchTool = toolFilter === 'Tous' || m.sourceTool === toolFilter
      const matchQuery = !q || `${m.name} ${m.summary} ${m.sourceTool} ${m.category}`.toLowerCase().includes(q)
      return matchCat && matchTool && matchQuery
    })
  }, [materials, category, toolFilter, query])

  if (selectedMaterial) {
    return (
      <PbrMaterialViewer
        material={selectedMaterial}
        t={t}
        onBack={() => setSelectedMaterial(null)}
      />
    )
  }

  return (
    <article style={{ display: 'flex', flexDirection: 'column', gap: 24, fontFamily: P.sans, color: t.textPrimary }}>
      {/* En-tete du studio */}
      <div>
        <button type="button" onClick={onBack}
          style={{ border: 0, background: 'transparent', padding: '4px 0', cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 13 }}>
          ← Tous les projets ZenRay Assets
        </button>
        <header style={{ display: 'flex', alignItems: 'baseline', gap: 16, flexWrap: 'wrap', padding: '14px 0 16px', borderBottom: `1px solid ${t.border}` }}>
          <span style={{ fontSize: 10.5, letterSpacing: '0.13em', textTransform: 'uppercase', color: P.accent }}>
            Collection PBR
          </span>
          <h1 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 32, letterSpacing: '-0.02em', margin: 0 }}>
            ZenRay Assets <em style={{ fontStyle: 'italic', fontWeight: 300, color: t.textSecondary }}>Materials</em>
          </h1>
          <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 13, color: t.textSecondary, marginLeft: 'auto' }}>
            {materials.length} matériaux
          </span>
        </header>
        <p style={{ maxWidth: '68ch', fontSize: 15, lineHeight: 1.62, color: t.textSecondary, margin: '14px 0 0' }}>
          Collection et base de sauvegarde de matériaux PBR procéduraux issus d'Adobe Substance 3D Designer et Houdini Copernicus.
          Chaque matériau s'inspecte en 3D temps réel avec possibilité d'isoler chaque calque (Albedo, Normal, Roughness, Metallic, Height, AO).
        </p>
      </div>

      {/* Barre de filtres et recherche */}
      <div style={{ display: 'flex', alignItems: 'center', gap: 20, flexWrap: 'wrap', borderBottom: `1px solid ${t.border}`, paddingBottom: 16 }}>
        {/* Filtres de categorie */}
        <nav style={{ display: 'flex', gap: 14, flexWrap: 'wrap' }}>
          {categories.map((c) => {
            const on = c === category
            return (
              <button key={c} type="button" onClick={() => setCategory(c)}
                style={{ border: 0, background: 'transparent', cursor: 'pointer', padding: '2px 0', fontFamily: P.sans,
                  fontSize: 13, color: on ? P.accent : t.textSecondary, boxShadow: on ? `inset 0 -1px 0 0 ${P.accent}` : undefined }}>
                {c}
              </button>
            )
          })}
        </nav>

        {/* Filtre par outil */}
        <div style={{ display: 'flex', alignItems: 'center', gap: 8, fontSize: 12.5, color: t.textSecondary, marginLeft: 'auto' }}>
          <span>Moteur :</span>
          <select value={toolFilter} onChange={(e) => setToolFilter(e.target.value)}
            style={{ border: `1px solid ${t.border}`, borderRadius: 6, background: t.cardBg || t.bg, color: t.textPrimary, padding: '4px 8px', fontSize: 12, fontFamily: P.sans }}>
            {tools.map((tl) => (
              <option key={tl} value={tl}>{tl}</option>
            ))}
          </select>
        </div>

        {/* Champ de recherche */}
        <label style={{ display: 'flex', alignItems: 'center', gap: 8, border: `1px solid ${t.border}`, borderRadius: 6, padding: '4px 10px', background: t.cardBg || t.bg }}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke={t.textSecondary} strokeWidth="2" strokeLinecap="round">
            <circle cx="11" cy="11" r="7" /><path d="M20 20l-3.6-3.6" />
          </svg>
          <input value={query} onChange={(e) => setQuery(e.target.value)} placeholder="Rechercher un matériau"
            style={{ border: 0, outline: 'none', background: 'transparent', color: t.textPrimary, fontSize: 12.5, fontFamily: P.sans, width: 160 }} />
        </label>
      </div>

      {/* Grille des cartes de materiaux */}
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(min(100%, 340px), 1fr))', gap: '30px 24px', paddingTop: 10 }}>
        {filtered.map((mat) => (
          <button key={mat.id} type="button" onClick={() => setSelectedMaterial(mat)}
            style={{ display: 'flex', flexDirection: 'column', textAlign: 'left', padding: 0, border: 0, background: 'transparent', cursor: 'pointer', color: 'inherit' }}>
            {/* Vignette simulant le materiau PBR sur sphere */}
            <div style={{ position: 'relative', width: '100%', aspectRatio: '16 / 10', borderRadius: P.radius, overflow: 'hidden', border: `1px solid ${t.border}`,
              background: 'radial-gradient(circle at 35% 35%, #5a4a3e 0%, #201815 65%, #100c0a 100%)', display: 'grid', placeItems: 'center' }}>
              <div style={{ width: '45%', aspectRatio: '1 / 1', borderRadius: 999,
                background: 'radial-gradient(circle at 30% 30%, #b89f85 0%, #755f4a 45%, #2d241c 85%)',
                boxShadow: '0 12px 30px rgba(0,0,0,0.6), inset 0 2px 4px rgba(255,255,255,0.3)' }} />
              <div style={{ position: 'absolute', bottom: 10, right: 10, background: 'rgba(15,15,18,0.75)', backdropFilter: 'blur(6px)',
                padding: '3px 8px', borderRadius: 4, fontSize: 10.5, fontFamily: P.mono, color: '#ffffff' }}>
                {mat.resolution}
              </div>
            </div>

            {/* Infos du materiau */}
            <div style={{ display: 'flex', alignItems: 'baseline', gap: 8, padding: '12px 2px 0' }}>
              <span style={{ fontSize: 10.5, letterSpacing: '0.12em', textTransform: 'uppercase', color: P.accent }}>{mat.category}</span>
              <span style={{ fontSize: 11.5, color: t.textSecondary, marginLeft: 'auto' }}>{mat.sourceTool}</span>
            </div>
            <div style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 19, letterSpacing: '-0.015em', lineHeight: 1.25, padding: '4px 2px 0' }}>
              {mat.name}
            </div>
            <div style={{ fontSize: 12.5, lineHeight: 1.5, color: t.textSecondary, padding: '6px 2px 0', display: '-webkit-box', WebkitLineClamp: 2, WebkitBoxOrient: 'vertical', overflow: 'hidden' }}>
              {mat.summary}
            </div>

            {/* Badges des canaux disponibles */}
            <div style={{ display: 'flex', flexWrap: 'wrap', gap: 5, padding: '10px 2px 0' }}>
              {(mat.channels || []).map((ch) => (
                <span key={ch} style={{ fontSize: 10.5, padding: '2px 7px', borderRadius: 4, background: 'rgba(128,128,128,0.1)', color: t.textSecondary, border: `1px solid ${t.border}` }}>
                  {ch}
                </span>
              ))}
            </div>
          </button>
        ))}
      </div>
    </article>
  )
}
