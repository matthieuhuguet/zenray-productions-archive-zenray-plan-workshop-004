// Carte Illustrator I7 — images incorporées à l'export, le pendant de `embedFonts` pour les
// polices. `embedImages` ne touche à rien d'autre : l'aperçu et l'édition gardent la voie LIÉE
// (une simple adresse), seule la sortie fichier devient autonome.

import { describe, it, expect, afterEach, vi } from 'vitest'
import { embedImages } from './exporters.js'

afterEach(() => vi.unstubAllGlobals())

function reponseImage(mime, octets) {
  return {
    ok: true,
    headers: { get: (nom) => (nom === 'content-type' ? mime : null) },
    arrayBuffer: async () => new Uint8Array(octets).buffer,
  }
}

describe('Illustrator I7 — embedImages', () => {
  it('une adresse distante devient réellement une data URI, avec le type MIME de la vraie réponse', async () => {
    const fetchSimule = vi.fn(async () => reponseImage('image/webp', [1, 2, 3]))
    vi.stubGlobal('fetch', fetchSimule)
    const html = '<img src="https://exemple.test/photo.jpg" alt="">'
    const suivant = await embedImages(html)
    expect(fetchSimule).toHaveBeenCalledWith('https://exemple.test/photo.jpg')
    expect(suivant).toContain('src="data:image/webp;base64,')
    expect(suivant).not.toContain('https://exemple.test/photo.jpg')
  })

  it('une image DÉJÀ en data URI n’est jamais re-fetchée', async () => {
    const fetchSimule = vi.fn()
    vi.stubGlobal('fetch', fetchSimule)
    const html = '<img src="data:image/png;base64,AAAA" alt="">'
    const suivant = await embedImages(html)
    expect(suivant).toBe(html)
    expect(fetchSimule).not.toHaveBeenCalled()
  })

  it('sans aucune image, la page revient inchangée (même référence, aucun appel réseau)', async () => {
    const fetchSimule = vi.fn()
    vi.stubGlobal('fetch', fetchSimule)
    const html = '<p>Aucune image ici.</p>'
    const suivant = await embedImages(html)
    expect(suivant).toBe(html)
    expect(fetchSimule).not.toHaveBeenCalled()
  })

  it('une image qui échoue au réseau reste une adresse ordinaire, jamais une page cassée', async () => {
    const fetchSimule = vi.fn(async () => { throw new Error('réseau coupé') })
    vi.stubGlobal('fetch', fetchSimule)
    const html = '<img src="https://exemple.test/absente.png" alt="">'
    const suivant = await embedImages(html)
    expect(suivant).toBe(html)
  })

  it('deux calques qui partagent la MÊME image ne la fetchent qu’UNE seule fois', async () => {
    const fetchSimule = vi.fn(async () => reponseImage('image/png', [9]))
    vi.stubGlobal('fetch', fetchSimule)
    const html = '<img src="https://exemple.test/logo.png"><img src="https://exemple.test/logo.png">'
    const suivant = await embedImages(html)
    expect(fetchSimule).toHaveBeenCalledTimes(1)
    expect((suivant.match(/data:image\/png;base64,/g) || [])).toHaveLength(2)
  })
})
