// ZenRayMedia — L5/L9 : l'ARBRE DE DÉCLINAISONS.
//
// C'est la thèse du produit rendue visible : `Livrable = Rendu(Brief × Thème × Format)`.
// Jusqu'ici l'application n'affichait qu'UN format à la fois — on devait cliquer une pastille
// pour découvrir qu'un texte ne tenait pas en 1:1. L'arbre montre les sorties SIMULTANÉMENT,
// avec le verdict du Critique sur chacune, avant d'avoir cliqué quoi que ce soit.
//
// Inspiré de l'éditeur de référence de Matthieu (`zenraymediav1-editor.html`), qui présente
// « YouTube 16:9 · Reel 9:16 · Carrousel 4:5 · Infolettre · Images » comme un arbre sous une
// source unique. La différence ici : chaque branche porte son état RÉEL, pas une décoration.

import { FORMATS, getFormat, isTemporal, durationOf } from './formats.js'
import { visibleBeats, omittedCount, readingTimeOf } from './compile.js'
import { inspectStatic, summarize } from './critic.js'

/**
 * Les groupes de déclinaisons proposés par défaut.
 * Un groupe n'est PAS un format : c'est une intention de diffusion, qui se traduit en un ou
 * plusieurs formats. « Réseaux » veut dire trois sorties, pas une.
 */
export const DECLENSION_GROUPS = [
  { id: 'lecture', label: 'Lecture', formats: ['F-web-article', 'F-print-a4'] },
  { id: 'reseaux', label: 'Réseaux', formats: ['F-still-1080-square', 'F-still-1080x1350', 'F-still-1080x1920'] },
  { id: 'ecran', label: 'Écran', formats: ['F-video-1920x1080', 'F-overlay-1920x1080'] },
]

/**
 * État d'une déclinaison, calculé sans rien rendre : ce que le format montre, ce qu'il laisse
 * de côté, sa durée s'il est temporel, et le verdict du Critique.
 */
export function declensionState({ brief, cut, theme, format, dark = false }) {
  const shown = visibleBeats(cut, format).length
  const omitted = omittedCount(cut, format)
  const issues = inspectStatic({ brief, cut, theme, format, dark })
  const verdict = summarize(issues)
  return {
    formatId: format.id,
    label: format.label,
    short: format.short,
    kind: format.kind,
    canvas: format.canvas,
    ratio: format.canvas.h > 0 ? format.canvas.w / format.canvas.h : null,
    shown,
    omitted,
    total: shown + omitted,
    duration: isTemporal(format) ? durationOf(cut, format) : 0,
    declared: Array.isArray(theme?.formats) ? theme.formats.includes(format.id) : true,
    blocking: verdict.blocking.length,
    warnings: verdict.warnings.length,
    ready: verdict.canPublish,
    issues,
  }
}

/** L'arbre complet, groupé par intention de diffusion. */
export function declensionTree({ brief, cut, theme, dark = false, groups = DECLENSION_GROUPS }) {
  if (!brief || !cut || !theme) return []
  return groups.map((group) => {
    const branches = group.formats
      .map((id) => getFormat(id))
      .filter(Boolean)
      .map((format) => declensionState({ brief, cut, theme, format, dark }))
    return {
      ...group,
      branches,
      ready: branches.filter((b) => b.ready).length,
      total: branches.length,
      // Un groupe est en défaut dès qu'UNE de ses branches l'est : on ne moyenne pas un blocage.
      blocking: branches.reduce((n, b) => n + b.blocking, 0),
    }
  })
}

/** Résumé d'une passe complète, pour l'en-tête de l'arbre. */
export function declensionSummary(tree) {
  const branches = tree.flatMap((g) => g.branches)
  return {
    total: branches.length,
    ready: branches.filter((b) => b.ready).length,
    blocking: branches.reduce((n, b) => n + b.blocking, 0),
    // Formats que le thème ne déclare pas : ils rendront quand même, mais approximativement.
    undeclared: branches.filter((b) => !b.declared).map((b) => b.formatId),
  }
}

/**
 * Estimation du travail restant, en mots, pour qu'un format cesse de tronquer.
 * Sert à dire « il te manque de la place », pas seulement « ça déborde ».
 */
export function trimAdvice(cut, format) {
  const omitted = omittedCount(cut, format)
  if (omitted <= 0) return null
  const hidden = (cut?.beats || []).slice(visibleBeats(cut, format).length)
  const words = hidden.reduce((n, b) => n + String(b.text || '').trim().split(/\s+/).filter(Boolean).length, 0)
  return { omitted, words, minutes: readingTimeOf({ beats: hidden }).minutes }
}
