#!/bin/zsh
# 2026-09-23 : (re)install the journal relay as a login agent. / FR : (re)installe le relais.
set -e
DIR=${0:a:h}
PLIST=~/Library/LaunchAgents/com.zenray.journal-relay.plist
cp "$DIR/com.zenray.journal-relay.plist" "$PLIST"
launchctl bootout gui/$(id -u) "$PLIST" 2>/dev/null || true
launchctl bootstrap gui/$(id -u) "$PLIST"
sleep 2
curl -s http://127.0.0.1:47831/status
