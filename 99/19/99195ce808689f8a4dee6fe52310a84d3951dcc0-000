import { describe, expect, it } from 'vitest'
import { manifestAudioTracks, menuAudioTracks, readAudioTracks, selectAudioTrack } from './audioTrackControl.js'

describe('audio track playback controls', () => {
  it('switches HLS playback between languages', () => {
    const engine = { kind: 'hls', api: { audioTracks: [{ name: 'Français' }, { name: 'English' }], audioTrack: 0 } }
    selectAudioTrack(engine, null, 1)
    expect(engine.api.audioTrack).toBe(1)
    expect(readAudioTracks(engine, null)[1]).toMatchObject({ label: 'English', selected: true })
  })
  it('passes the actual selected DASH track to its engine', () => {
    const tracks = [{ index: 5, lang: 'fr' }, { index: 8, lang: 'ja' }]
    let current = tracks[0]
    const engine = { kind: 'dash', api: { getTracksFor: () => tracks, getCurrentTrackFor: () => current, setCurrentTrack: (track) => { current = track } } }
    selectAudioTrack(engine, null, 1)
    expect(current).toBe(tracks[1])
    expect(readAudioTracks(engine, null).map((track) => track.selected)).toEqual([false, true])
  })
  it('enables exactly one native track and refuses nonexistent tracks', () => {
    const video = { audioTracks: [{ label: 'Français', enabled: true }, { label: '日本語', enabled: false }] }
    selectAudioTrack(null, video, 1)
    expect(video.audioTracks.map((track) => track.enabled)).toEqual([false, true])
    expect(() => selectAudioTrack(null, video, 2)).toThrow('unavailable')
    expect(video.audioTracks.map((track) => track.enabled)).toEqual([false, true])
  })
  it('does not invent selectable tracks when the browser exposes none', () => {
    expect(readAudioTracks(null, {})).toEqual([])
    expect(() => selectAudioTrack(null, {}, 0)).toThrow('unavailable')
  })
  it('lists the single audio track of a film from its manifest so the Audio option is always visible', () => {
    const manifest = { audio: [{ lang: 'jpn', label: '日本語', default: true }] }
    expect(menuAudioTracks([], manifest)).toEqual([{ index: 0, selected: true, fixed: true, label: '日本語' }])
  })
  it('replaces a generic engine label such as audio_1 by the manifest language label', () => {
    const engineTracks = [{ index: 0, label: 'audio_1', selected: true }]
    expect(menuAudioTracks(engineTracks, { audio: [{ lang: 'jpn', label: '日本語' }] })).toEqual([{ index: 0, label: '日本語', selected: true }])
  })
  it('prefers the engine tracks over the manifest list and reads older manifests through probe.audio', () => {
    const engineTracks = [{ index: 0, label: 'Français', selected: true }, { index: 1, label: 'English', selected: false }]
    expect(menuAudioTracks(engineTracks, { audio: [{ lang: 'jpn' }] })).toEqual(engineTracks)
    expect(manifestAudioTracks({ probe: { audio: [{ lang: 'fre' }, { lang: 'eng' }] } }).map((track) => track.label)).toEqual(['Français', 'English'])
    expect(manifestAudioTracks({})).toEqual([])
  })
})
