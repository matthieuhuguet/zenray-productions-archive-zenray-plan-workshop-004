import { useState } from 'react'
import { PALETTE, RADII, SHADOWS, TRANSITIONS, FONTS } from '../theme.js'
import { DAYNAMES, MONTHS_SHORT, ymd, mondayOf } from '../lib/dateHelpers.js'
import { card, btn, btnGhost, SectionLabel } from './lifeosShared.jsx'

// Extrait de App.jsx (batch refactor structurel 2026-07-16). WeekCalendar/DayColumn/CalCard forment
// le mini-calendrier hebdomadaire du Board LifeOS (drag d'un objectif ou d'une image sur un jour).

/* ───────── Week calendar ───────── */
export function WeekCalendar({ t, cards, today, onDropObj, onMoveCard, onOpen, onDelCard, addImages, onAddBlank }) {
  const [offset, setOffset] = useState(0)
  const start = mondayOf(new Date()); start.setDate(start.getDate() + offset * 7)
  const days = Array.from({ length: 7 }, (_, i) => { const d = new Date(start); d.setDate(d.getDate() + i); return d })
  const label = `${days[0].getDate()} ${MONTHS_SHORT[days[0].getMonth()]} — ${days[6].getDate()} ${MONTHS_SHORT[days[6].getMonth()]}`
  return (
    <div style={{ ...card(t), marginBottom: 16 }}>
      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 12, flexWrap: 'wrap', gap: 8 }}>
        <SectionLabel t={t} color={t.textSecondary} nomargin>Semaine — glisse un objectif (ou une image) sur un jour</SectionLabel>
        <div style={{ display: 'flex', gap: 6, alignItems: 'center' }}>
          <button style={btn(t)} onClick={() => setOffset(offset - 1)}>‹</button>
          <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary, minWidth: 150, textAlign: 'center' }}>{label}{offset === 0 ? ' · cette semaine' : ''}</span>
          <button style={btn(t)} onClick={() => setOffset(offset + 1)}>›</button>
          {offset !== 0 && <button style={btn(t)} onClick={() => setOffset(0)}>auj.</button>}
        </div>
      </div>
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7,minmax(0,1fr))', gap: 8 }}>
        {days.map((d, i) => (
          <DayColumn key={i} t={t} dayName={DAYNAMES[i]} date={d} dateStr={ymd(d)} isToday={ymd(d) === today}
            cards={cards.filter((c) => c.date === ymd(d))}
            onDropObj={onDropObj} onMoveCard={onMoveCard} onOpen={onOpen} onDelCard={onDelCard} addImages={addImages} onAddBlank={onAddBlank} />
        ))}
      </div>
    </div>
  )
}
export function DayColumn({ t, dayName, date, dateStr, isToday, cards, onDropObj, onMoveCard, onOpen, onDelCard, addImages, onAddBlank }) {
  const [over, setOver] = useState(false)
  const handleDrop = (e) => {
    e.preventDefault(); setOver(false)
    if (e.dataTransfer.files && e.dataTransfer.files.length) {
      const id = onDropObj({ obj: { id: null, title: 'Image' }, domain: '' }, dateStr) // create blank card then attach
      if (id) addImages(id, e.dataTransfer.files)
      return
    }
    let p; try { p = JSON.parse(e.dataTransfer.getData('text/plain')) } catch { return }
    if (p.kind === 'obj') onDropObj({ obj: { id: p.objId, title: p.title }, domain: p.domain }, dateStr)
    else if (p.kind === 'card') onMoveCard(p.cardId, dateStr)
  }
  return (
    <div onDragOver={(e) => { e.preventDefault(); setOver(true) }} onDragLeave={() => setOver(false)} onDrop={handleDrop}
      style={{ background: isToday ? PALETTE.primarySoft : t.bg, border: `1px solid ${over ? PALETTE.primary : t.border}`, borderRadius: RADII.md, padding: 8, minHeight: 150, display: 'flex', flexDirection: 'column', gap: 6, boxShadow: over ? SHADOWS.glow : 'none', transition: TRANSITIONS.base }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline' }}>
        <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: isToday ? PALETTE.primary : t.textSecondary, fontWeight: 700 }}>{dayName}</span>
        <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-lg)', fontWeight: 700, color: isToday ? PALETTE.primary : t.textPrimary }}>{date.getDate()}</span>
      </div>
      <div style={{ flex: 1, display: 'flex', flexDirection: 'column', gap: 6 }}>
        {cards.map((c) => <CalCard key={c.id} t={t} card={c} onOpen={onOpen} onDel={onDelCard} addImages={addImages} />)}
      </div>
      <button onClick={() => onAddBlank(dateStr)} style={{ ...btnGhost(t), fontSize: 'var(--zr-ui-sm)', padding: '4px 0' }}>+ carte</button>
    </div>
  )
}
export function CalCard({ t, card: cardData, onOpen, onDel, addImages }) {
  const [over, setOver] = useState(false)
  const dragStart = (e) => { e.stopPropagation(); e.dataTransfer.setData('text/plain', JSON.stringify({ kind: 'card', cardId: cardData.id })) }
  const drop = (e) => { if (e.dataTransfer.files && e.dataTransfer.files.length) { e.preventDefault(); e.stopPropagation(); setOver(false); addImages(cardData.id, e.dataTransfer.files) } }
  return (
    <div draggable onDragStart={dragStart} onClick={() => onOpen(cardData.id)}
      onDragOver={(e) => { if (e.dataTransfer.types.includes('Files')) { e.preventDefault(); e.stopPropagation(); setOver(true) } }} onDragLeave={() => setOver(false)} onDrop={drop}
      style={{ background: t.cardBg, border: `1px solid ${over ? PALETTE.primary : t.border}`, borderLeft: `3px solid ${PALETTE.primary}`, borderRadius: RADII.sm, padding: '7px 8px', cursor: 'pointer', boxShadow: SHADOWS.sm }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', gap: 6 }}>
        <span style={{ fontSize: 'var(--zr-ui-sm)', lineHeight: 1.35, fontWeight: 600 }}>{cardData.title}</span>
        <button onClick={(e) => { e.stopPropagation(); onDel(cardData.id) }} style={{ background: 'none', border: 'none', color: t.textSecondary, cursor: 'pointer', fontSize: 'var(--zr-ui-lg)', lineHeight: 1, padding: 0 }}>×</button>
      </div>
      {cardData.images && cardData.images[0] && <img src={cardData.images[0]} alt="" style={{ width: '100%', borderRadius: 6, marginTop: 5, display: 'block', maxHeight: 90, objectFit: 'cover' }} />}
      {cardData.domain && <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-3xs)', color: t.textSecondary, marginTop: 4, textTransform: 'uppercase', letterSpacing: 0.5 }}>{cardData.domain}</div>}
      {cardData.note && <div style={{ fontSize: 'var(--zr-ui-xs)', color: t.textSecondary, marginTop: 3, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{cardData.note}</div>}
    </div>
  )
}
