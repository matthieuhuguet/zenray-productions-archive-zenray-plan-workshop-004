// 2 October 2026, 13:05 CEST: private local workspace state never implies a successful cloud backup.
import { getApiSecret } from './apiAuth.js'

export const PROJECT_BRIDGE_CONFIG = {
  path: '/api/assets-workspace', localOrigin: 'http://localhost:3100', timeoutMs: 30000,
}

export class ProjectBridgeError extends Error {
  constructor(message, { code = 'bridge-unavailable', status = 0, cause } = {}) {
    super(message, { cause })
    this.name = 'ProjectBridgeError'
    this.code = code
    this.status = status
  }
}

export function createProjectBridge({ origin, fetchImpl = (...args) => fetch(...args), timeoutMs = PROJECT_BRIDGE_CONFIG.timeoutMs } = {}) {
  const currentOrigin = typeof location === 'undefined' ? '' : location.origin
  const isLocal = /^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])(?::\d+)?$/.test(currentOrigin)
  const base = origin ?? (isLocal ? '' : PROJECT_BRIDGE_CONFIG.localOrigin)
  const request = async (action, payload = {}, { signal } = {}) => {
    const secret = getApiSecret()
    const timeout = AbortSignal.timeout(timeoutMs)
    const combined = signal && typeof AbortSignal.any === 'function' ? AbortSignal.any([signal, timeout]) : signal || timeout
    let response
    try {
      response = await fetchImpl(`${base}${PROJECT_BRIDGE_CONFIG.path}`, {
        method: 'POST', headers: { 'content-type': 'application/json', 'x-zr-assets-client': '2', ...(secret ? { 'x-zr-auth': secret } : {}) },
        body: JSON.stringify({ ...payload, action }), signal: combined,
      })
    } catch (cause) {
      throw new ProjectBridgeError('Le service local ZenRay Assets est indisponible.', { cause })
    }
    let result
    try { result = await response.json() } catch (cause) { throw new ProjectBridgeError('Réponse du service local illisible.', { cause, status: response.status }) }
    if (!response.ok || result.error) throw new ProjectBridgeError(result.error || 'La demande locale échoue.', { code: result.code || 'bridge-request-failed', status: response.status })
    return result
  }
  return { request, list: (options) => request('list', {}, options), catalogue: (options) => request('workspace-catalogue', {}, options), status: (projectId, options) => request('status', { projectId }, options),
    projectConversations: (projectId, options) => request('project-conversations', { projectId }, options),
    inventory: (projectId, options) => request('inventory', { projectId }, options),
    archive: (projectId, fileIds = null, options) => request('archive', { projectId, fileIds }, options),
    loadPlan: (projectId, fileIds = null, options) => request('load-plan', { projectId, fileIds }, options),
    load: (projectId, fileIds = null, options) => request('restore', { projectId, fileIds }, options),
    // 2 October 2026, 15:15 CEST: managed release and cloud recovery use the same job queue.
    unload: (projectId, fileIds = null, options) => request('unload', { projectId, fileIds }, options),
    recover: (projectId, options) => request('recover', { projectId }, options),
    unloadPlan: (projectId, fileIds = null, options) => request('unload-plan', { projectId, fileIds }, options),
    watch: (projectId, enabled, options) => request('watch', { projectId, enabled }, options),
    register: (project, options) => request('register', { project }, options) }
}
