// 3 October 2026, 12:30 : PostKit dashboard. The cockpit of everything PostKit pilots: accounts, posts, inbox, comments, analytics, campaigns,
// webhooks and the platform matrix. It talks to the PostKit API only (default http://127.0.0.1:8787) and never holds a platform token. (3 October 2026)
// When PostKit is not running the view says so and gives the exact command: a silent blank screen is the one failure a product cannot afford. (3 October 2026)
import React, { useState } from 'react'
import { UI } from '../config/colors.js'
import { POSTKIT } from './postkitConfig.js'
import { usePostKitConfig, useOverview } from './usePostKit.js'
import { Badge, Btn, Card, Copy, ErrorLine, Field, ago } from './ui.jsx'
import OverviewPanel from './OverviewPanel.jsx'
import AccountsPanel from './AccountsPanel.jsx'
import PostsPanel from './PostsPanel.jsx'
import InboxPanel from './InboxPanel.jsx'
import EngagementPanel from './EngagementPanel.jsx'
import AnalyticsPanel from './AnalyticsPanel.jsx'
import CampaignsPanel from './CampaignsPanel.jsx'
import DevelopersPanel from './DevelopersPanel.jsx'
import PlatformsPanel from './PlatformsPanel.jsx'
import DocsPanel from './DocsPanel.jsx'
import './PostKitView.css'

const PANELS = { overview: OverviewPanel, accounts: AccountsPanel, posts: PostsPanel, inbox: InboxPanel, engagement: EngagementPanel, analytics: AnalyticsPanel, campaigns: CampaignsPanel, developers: DevelopersPanel, platforms: PlatformsPanel, docs: DocsPanel }

function ConnectionCard({ config, update, status, error }) {
  const [baseUrl, setBaseUrl] = useState(config.baseUrl)
  const [key, setKey] = useState(config.key)
  const offline = status === 'offline'
  return (
    <Card title={offline ? 'PostKit is offline' : 'Connect to PostKit'}>
      {offline ? <p className="zr-pk-lead">Nothing answers at <code>{config.baseUrl}</code>. Start the server, and this page connects by itself.</p>
        : <p className="zr-pk-lead">Paste an API key to see what PostKit pilots. Keys are shown once, when they are created.</p>}
      <div className="zr-pk-command"><code>{offline ? POSTKIT.startCommand : POSTKIT.keyCommand}</code><Copy text={offline ? POSTKIT.startCommand : POSTKIT.keyCommand} /></div>
      <div className="zr-pk-grid2">
        <Field label="Server address"><input value={baseUrl} onChange={(e) => setBaseUrl(e.target.value)} spellCheck={false} /></Field>
        <Field label="API key" hint="Stored in this browser only."><input type="password" value={key} onChange={(e) => setKey(e.target.value)} placeholder="pk_…" spellCheck={false} /></Field>
      </div>
      <ErrorLine error={status === 'unauthorized' && config.key ? 'That key was refused: it is wrong or revoked.' : error && !offline ? error : null} />
      <Btn tone="primary" onClick={() => update({ baseUrl: baseUrl.trim(), key: key.trim() })}>Connect</Btn>
    </Card>
  )
}

export default function PostKitView({ t }) {
  const { config, update, client } = usePostKitConfig()
  const overview = useOverview(client)
  const [tab, setTab] = useState('overview')
  const online = overview.status === 'online'
  const Panel = PANELS[tab]
  const tick = overview.data?.system?.scheduler
  const stale = online && tick?.lastTickAt && Date.now() - Date.parse(tick.lastTickAt) > POSTKIT.refreshMs * 4

  return (
    <div className="zr-pk" style={{ color: t?.textPrimary, '--zr-pk-ok': UI.green, '--zr-pk-warn': UI.orange, '--zr-pk-bad': UI.red, '--zr-pk-info': UI.blue }}>
      <div className="zr-pk-head">
        <div>
          <h1 className="zr-pk-title">PostKit</h1>
          <p className="zr-pk-sub">One API to publish, read and reply across every platform. This is what it is piloting.</p>
        </div>
        <span className="zr-pk-conn" title={overview.error || ''}>
          <span className={`zr-pk-dot is-${online ? (stale ? 'warn' : 'ok') : overview.status === 'connecting' ? 'info' : 'bad'}`} />
          {online ? (stale ? `Online, scheduler quiet since ${ago(tick.lastTickAt)}` : `Online${tick?.lastTickAt ? `, last tick ${ago(tick.lastTickAt)}` : ''}`) : overview.status === 'connecting' ? 'Connecting…' : overview.status === 'offline' ? 'Offline' : overview.status === 'unauthorized' ? 'Key needed' : 'Error'}
          {online && <Badge tone="muted">{overview.data.system.product} {overview.data.system.apiVersion}</Badge>}
        </span>
      </div>

      {!online && overview.status !== 'connecting' && <ConnectionCard config={config} update={update} status={overview.status} error={overview.error} />}

      {online && (
        <>
          <nav className="zr-pk-tabs" role="tablist" aria-label="PostKit sections">
            {POSTKIT.tabs.map((x) => <button key={x.id} role="tab" aria-selected={tab === x.id} className={`zr-pk-tab${tab === x.id ? ' is-on' : ''}`} onClick={() => setTab(x.id)}>{x.label}</button>)}
          </nav>
          <Panel client={client} overview={overview} reload={overview.reload} goTo={setTab} />
        </>
      )}
    </div>
  )
}
