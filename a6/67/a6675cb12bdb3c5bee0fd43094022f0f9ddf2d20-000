import React, { useEffect, useMemo, useState } from 'react'
import Icon from '../components/Icon.jsx'
import { getIndexPaths, loadSearchIndex } from '../search/searchIndexClient.js'
import { resolveRef, prettyName } from './resolveRef.js'
import { useRefUi } from './refUiContext.js'

// Picker d'images du drive (2026-07-19) — LA porte d'entrée rapide des références : toutes les images
// DÉJÀ uploadées (manifests .img.json indexés — imports Eagle, captures, shards privés) s'insèrent au
// board en 1 clic, par RÉFÉRENCE (zéro re-upload, l'asset tldraw pointe la vignette webp 1080 du
// pipeline existant ; le plein format n'est tiré qu'au zoom, cf. resolver LOD de RefBoard).
// Panneau en matériau V9 (classes zr-ref-*, ref.css) + pilule de recherche compacte (zr-sbs-search).

const PAGE = 60
const isImg = (p) => /\.img\.json$/.test(p)

// Dossier projet du board (".../Boards/X.(canvas|ref).json" -> dossier parent du projet).
export function projectDirOf(boardPath) {
  const p = String(boardPath || '')
  const m = p.match(/^(.*)\/Boards\/[^/]+\.(canvas|ref)\.json$/)
  if (m) return m[1]
  return p.replace(/\/[^/]+\.(canvas|ref)\.json$/, '') || 'pages/Ref'
}

// MIME custom du drag picker -> board : bug réel corrigé le 2026-07-19 ("pas de possibilité de drag
// and drop les images") — les cellules n'étaient QUE cliquables (insertion forcée au centre du
// viewport). RefBoardHost (le wrapper qui entoure ce picker, cf. RefBoard.jsx) reconnaît ce MIME et
// dépose la référence exactement là où le pointeur relâche, comme un vrai glisser-déposer.
export const REF_DRAG_MIME = 'application/zenray-ref-image'

function Cell({ path, onInsert }) {
  const [thumb, setThumb] = useState(null)
  useEffect(() => {
    let live = true
    resolveRef(path).then((r) => { if (live && r) setThumb(r.thumb || r.full || null) })
    return () => { live = false }
  }, [path])
  return (
    <button className="zr-ref-cell" draggable title={`${prettyName(path)} — cliquer, ou glisser sur le board`}
      onClick={() => onInsert(path)}
      onDragStart={(e) => { e.dataTransfer.setData(REF_DRAG_MIME, path); e.dataTransfer.effectAllowed = 'copy' }}>
      {thumb ? <img src={thumb} alt="" loading="lazy" decoding="async" draggable={false} /> : null}
      <span className="zr-ref-cell-name">{prettyName(path)}</span>
    </button>
  )
}

export default function RefImagePicker() {
  const { boardPath, setPickerOpen } = useRefUi()
  const [ready, setReady] = useState(false)
  const [query, setQuery] = useState('')
  const [limit, setLimit] = useState(PAGE)

  useEffect(() => { loadSearchIndex().then(() => setReady(true)).catch(() => setReady(true)) }, [])

  const all = useMemo(() => (ready ? getIndexPaths().filter(isImg) : []), [ready])
  const projectDir = projectDirOf(boardPath) + '/'
  const projectImages = useMemo(() => all.filter((p) => p.startsWith(projectDir)), [all, projectDir])

  const needle = query.trim().toLowerCase()
  const results = useMemo(() => {
    if (needle.length < 2) return null
    const terms = needle.split(/\s+/).filter(Boolean)
    return all.filter((p) => { const hay = p.toLowerCase(); return terms.every((t) => hay.includes(t)) })
  }, [all, needle])

  useEffect(() => { setLimit(PAGE) }, [needle])

  const insert = (path) => {
    // Même canal événementiel que le drop/paste (RefBoard écoute 'zenray-ref-add:<path du board>').
    window.dispatchEvent(new CustomEvent('zenray-ref-add:' + boardPath, { detail: { ref: path } }))
  }

  const shown = results ? results.slice(0, limit) : projectImages.slice(0, limit)
  const total = results ? results.length : projectImages.length

  return (
    <div className="zr-ref-picker zr-ref-glass" onPointerDown={(e) => e.stopPropagation()}>
      <div className="zr-ref-picker-head">
        <span className="zr-ref-picker-title">Images du drive</span>
        <button className="zr-ref-picker-close" title="Fermer" onClick={() => setPickerOpen(false)}><Icon name="xmark" size={14} /></button>
      </div>
      <div className="zr-sbs-search">
        <Icon name="magnifyingglass" size={14} style={{ position: 'relative', zIndex: 1, opacity: .6, flexShrink: 0 }} />
        <input value={query} onChange={(e) => setQuery(e.target.value)} placeholder={`Rechercher parmi ${all.length || '…'} images`} autoFocus />
      </div>
      <div className="zr-ref-picker-scroll">
        {!ready && <div className="zr-ref-picker-note">Chargement de l’index…</div>}
        {ready && !results && (
          <>
            <div className="zr-ref-picker-section">Images du projet · {projectImages.length}</div>
            {projectImages.length === 0 && <div className="zr-ref-picker-note">Aucune image dans ce projet. Cherche dans tout le drive ci-dessus (min. 2 lettres), ou glisse des fichiers du Finder sur le board.</div>}
          </>
        )}
        {ready && results && <div className="zr-ref-picker-section">Résultats · {results.length}</div>}
        {ready && results && results.length === 0 && <div className="zr-ref-picker-note">Aucune image ne correspond.</div>}
        <div className="zr-ref-grid">
          {shown.map((p) => <Cell key={p} path={p} onInsert={insert} />)}
        </div>
        {total > limit && (
          <button className="zr-ref-more-btn" onClick={() => setLimit((l) => l + PAGE)}>Afficher plus ({total - limit} restantes)</button>
        )}
      </div>
    </div>
  )
}
