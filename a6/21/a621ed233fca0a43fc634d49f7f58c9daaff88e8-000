import { describe, it, expect, vi, afterEach, beforeEach } from 'vitest'
import React from 'react'
import { render, screen, fireEvent, waitFor, cleanup } from '@testing-library/react'
import { BoutonTri, resetTriJobsForTests } from './QuickLookOverlay.jsx'
import { espacesDeTri, espaceParDefaut } from '../lib/dossiersDeTri.js'

// Sans ce nettoyage, les rendus s'empilent dans le même document et `getByRole` en trouve
// plusieurs : le test échouerait pour une raison qui n'a rien à voir avec le composant.
afterEach(cleanup)
beforeEach(resetTriJobsForTests) // sort jobs live in a module-level store: isolate each test

const ICI = 'pages/Photos/DJI/29 Août 2026'
const image = { name: 'IMG_5555.jpeg', contentPath: `${ICI}/IMG_5555.jpeg.img.json` }
const dossier = (name) => ({ name, hasKids: true })

// Fabrique la prop `tri` exactement comme App la construit, pour que le test porte sur le VRAI
// contrat et non sur une version simplifiée qui divergerait sans qu'on le voie.
const faireTri = (entrees, trier = vi.fn().mockResolvedValue(true)) => {
  const espaces = espacesDeTri(entrees, ICI)
  return { tri: { espaces, defaut: espaceParDefaut(espaces), trier }, trier }
}

describe('BoutonTri — trier une image sans la déplacer', () => {
  it('un seul espace : un bouton, pas de menu — le chevron volerait un clic à chaque image', () => {
    const { tri } = faireTri([])
    render(<BoutonTri tri={tri} item={image} />)
    expect(screen.getAllByRole('button')).toHaveLength(1)
    expect(screen.getByRole('button').textContent).toContain('Trier')
  })

  it('un clic envoie l’image vers l’espace par défaut, avec le bon chemin', async () => {
    const { tri, trier } = faireTri([])
    render(<BoutonTri tri={tri} item={image} />)
    fireEvent.click(screen.getByRole('button'))
    await waitFor(() => expect(trier).toHaveBeenCalledTimes(1))
    const [items, espace] = trier.mock.calls[0]
    expect(items).toEqual([image])
    expect(espace.chemin).toBe(`${ICI}/tmp-img-selection1`)
  })

  it('plusieurs espaces : le clic direct CONTINUE le dernier tas, il n’en ouvre pas un neuf', async () => {
    // C'est le geste du tri en rafale : ouvrir un tas neuf à chaque clic serait l'inverse du besoin.
    const { tri, trier } = faireTri([dossier('tmp-img-selection1'), dossier('tmp-img-selection2')])
    render(<BoutonTri tri={tri} item={image} />)
    fireEvent.click(screen.getAllByRole('button')[0])
    await waitFor(() => expect(trier).toHaveBeenCalled())
    expect(trier.mock.calls[0][1].nom).toBe('tmp-img-selection2')
  })

  it('le menu liste les espaces existants ET le prochain, marqué nouveau', () => {
    const { tri } = faireTri([dossier('tmp-img-selection1')])
    render(<BoutonTri tri={tri} item={image} />)
    fireEvent.click(screen.getAllByRole('button')[1])   // le chevron
    expect(screen.getByText(/tmp-img-selection1/)).toBeTruthy()
    expect(screen.getByText(/tmp-img-selection2/)).toBeTruthy()
    expect(screen.getByText(/nouveau/)).toBeTruthy()
  })

  it('choisir un espace dans le menu envoie vers CELUI-LA, et referme le menu', async () => {
    const { tri, trier } = faireTri([dossier('tmp-img-selection1'), dossier('tmp-img-selection2')])
    render(<BoutonTri tri={tri} item={image} />)
    fireEvent.click(screen.getAllByRole('button')[1])
    fireEvent.click(screen.getByText(/^tmp-img-selection1$/))
    await waitFor(() => expect(trier).toHaveBeenCalled())
    expect(trier.mock.calls[0][1].nom).toBe('tmp-img-selection1')
    await waitFor(() => expect(screen.queryByText(/nouveau/)).toBeNull())
  })

  it('DOUBLE CLIC : un seul envoi, jamais deux références pour un geste', async () => {
    // Sans ce garde, un double-clic involontaire créerait un doublon silencieux dans le tas, que
    // l'on ne remarquerait qu'au comptage. C'est le genre d'erreur qui ne se voit jamais à temps.
    let resoudre
    const trier = vi.fn(() => new Promise((r) => { resoudre = r }))
    const { tri } = faireTri([], trier)
    render(<BoutonTri tri={tri} item={image} />)
    const b = screen.getByRole('button')
    fireEvent.click(b); fireEvent.click(b); fireEvent.click(b)
    expect(trier).toHaveBeenCalledTimes(1)
    resoudre(true)
    await waitFor(() => expect(screen.getByRole('button').textContent).toContain('tmp-img-selection1'))
  })

  it('un envoi qui échoue déverrouille le bouton : on peut réessayer', async () => {
    const trier = vi.fn().mockRejectedValue(new Error('réseau'))
    const { tri } = faireTri([], trier)
    render(<BoutonTri tri={tri} item={image} />)
    const b = screen.getByRole('button')
    fireEvent.click(b)
    await waitFor(() => expect(trier).toHaveBeenCalledTimes(1))
    fireEvent.click(b)
    await waitFor(() => expect(trier).toHaveBeenCalledTimes(2))
  })

  it('le chargement est suivi PAR IMAGE : l’image suivante reste triable pendant que la première charge', async () => {
    let resoudre
    const trier = vi.fn(() => new Promise((r) => { resoudre = r }))
    const { tri } = faireTri([], trier)
    const autre = { name: 'IMG_5556.jpeg', contentPath: `${ICI}/IMG_5556.jpeg.img.json` }
    const { rerender } = render(<BoutonTri tri={tri} item={image} />)
    fireEvent.click(screen.getByRole('button'))
    expect(screen.getByRole('button').textContent).toContain('Envoi')
    rerender(<BoutonTri tri={tri} item={autre} />)
    expect(screen.getByRole('button').textContent).toContain('Trier')
    rerender(<BoutonTri tri={tri} item={image} />)
    expect(screen.getByRole('button').textContent).toContain('Envoi') // still loading when we come back
    resoudre(true)
    await waitFor(() => expect(screen.getByRole('button').textContent).toContain('→'))
  })

  it('deux images envoyées de suite partent l’une après l’autre, jamais en parallèle', async () => {
    const resolveurs = []
    const trier = vi.fn(() => new Promise((r) => { resolveurs.push(r) }))
    const { tri } = faireTri([], trier)
    const autre = { name: 'IMG_5556.jpeg', contentPath: `${ICI}/IMG_5556.jpeg.img.json` }
    const { rerender } = render(<BoutonTri tri={tri} item={image} />)
    fireEvent.click(screen.getByRole('button'))
    rerender(<BoutonTri tri={tri} item={autre} />)
    fireEvent.click(screen.getByRole('button'))
    expect(trier).toHaveBeenCalledTimes(1)   // the second one waits in the queue
    resolveurs[0](true)
    await waitFor(() => expect(trier).toHaveBeenCalledTimes(2))
    resolveurs[1](true)
    await waitFor(() => expect(screen.getByRole('button').textContent).toContain('→'))
  })

  it('les images en attente partent TOUTES ENSEMBLE dans une seule requête', async () => {
    const resolveurs = []
    const trier = vi.fn(() => new Promise((r) => { resolveurs.push(r) }))
    const { tri } = faireTri([], trier)
    const mk = (n) => ({ name: `IMG_${n}.jpeg`, contentPath: `${ICI}/IMG_${n}.jpeg.img.json` })
    const { rerender } = render(<BoutonTri tri={tri} item={mk(1)} />)
    fireEvent.click(screen.getByRole('button'))
    for (const n of [2, 3, 4]) { rerender(<BoutonTri tri={tri} item={mk(n)} />); fireEvent.click(screen.getByRole('button')) }
    expect(trier).toHaveBeenCalledTimes(1)
    resolveurs[0](true)
    await waitFor(() => expect(trier).toHaveBeenCalledTimes(2))
    expect(trier.mock.calls[1][0]).toHaveLength(3)       // 2, 3 and 4 left together
    resolveurs[1](true)
    await waitFor(() => expect(screen.getByRole('button').textContent).toContain('→'))
  })

  it('un lot refusé est rejoué image par image : une mauvaise image ne coule pas les autres', async () => {
    const trier = vi.fn(async (items) => items.length > 1 || items[0].name === 'MAUVAISE.jpeg' ? false : true)
    const { tri } = faireTri([], trier)
    const mk = (nom) => ({ name: nom, contentPath: `${ICI}/${nom}.img.json` })
    let resoudre
    const premier = vi.fn(() => new Promise((r) => { resoudre = r }))
    const tri2 = { ...tri, trier: vi.fn(async (items, e) => (trier.mock.calls.length === 0 && items.length === 1 && items[0].name === 'A.jpeg') ? premier() : trier(items, e)) }
    const { rerender } = render(<BoutonTri tri={tri2} item={mk('A.jpeg')} />)
    fireEvent.click(screen.getByRole('button'))
    rerender(<BoutonTri tri={tri2} item={mk('BONNE.jpeg')} />); fireEvent.click(screen.getByRole('button'))
    rerender(<BoutonTri tri={tri2} item={mk('MAUVAISE.jpeg')} />); fireEvent.click(screen.getByRole('button'))
    resoudre(true)
    await waitFor(() => expect(trier.mock.calls.length).toBeGreaterThanOrEqual(3)) // the batch of 2, then one by one
    rerender(<BoutonTri tri={tri2} item={mk('BONNE.jpeg')} />)
    await waitFor(() => expect(screen.getByRole('button').textContent).toContain('→'))
    rerender(<BoutonTri tri={tri2} item={mk('MAUVAISE.jpeg')} />)
    expect(screen.getByRole('button').textContent).not.toContain('→')
  })

  it('« trier » qui répond false n’affiche jamais le vert « fait »', async () => {
    const trier = vi.fn().mockResolvedValue(false)
    const { tri } = faireTri([], trier)
    render(<BoutonTri tri={tri} item={image} />)
    fireEvent.click(screen.getByRole('button'))
    await waitFor(() => expect(trier).toHaveBeenCalledTimes(1))
    await waitFor(() => expect(screen.getByRole('button').textContent).not.toContain('Envoi'))
    expect(screen.getByRole('button').textContent).not.toContain('→')
  })
})
