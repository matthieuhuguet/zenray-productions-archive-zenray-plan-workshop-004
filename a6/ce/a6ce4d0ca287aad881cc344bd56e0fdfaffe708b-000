// 6 October 2026, 21:45 CEST: `node scripts/Assets/ConversationDigest.mjs <conversation id> [--since <date>] [--until <date>] [--project <id>] [--out file.md] [--max-chars 4000]`
// EN: turns an ORIGINAL conversation (Claude, Codex or Gemini, resumed sessions included) into one readable markdown file in time order: every prompt, every assistant text, with its timestamp. Used to write an article from what really happened. Reads the transcript backwards by bounded windows and stops at --since, so a 1 GB session costs only its recent part.
// PRIVACY: a conversation linked by path evidence is not always ABOUT the project (a Gemini session that built a video also held job-application answers). `--project <id>` keeps ONLY the messages that cite the project's own paths: use it for every conversation that is not entirely about the project, and never quote the rest in public text.
// FR : transforme une conversation ORIGINALE en un fichier markdown lisible, prompts et reponses horodates, borne par --since ; --project ne garde que les messages qui citent les chemins du projet.
import { writeFile, readFile } from 'node:fs/promises'
import path from 'node:path'
import { config } from './BridgeClient.mjs'
import { createConversationCatalog } from './ConversationCatalog.mjs'
import { citingProject, renderDigest } from './ConversationLinks.mjs'

const args = process.argv.slice(2), id = args[0], option = name => { const at = args.indexOf(name); return at === -1 ? undefined : args[at + 1] }
if (!id || id.startsWith('--')) { console.error('Usage: ConversationDigest.mjs <provider:session id> [--since date] [--until date] [--project id] [--out file] [--max-chars n]'); process.exit(2) }
const since = option('--since') ? Date.parse(option('--since')) : -Infinity, until = option('--until') ? Date.parse(option('--until')) : Infinity, maxChars = Number(option('--max-chars') || 4000), out = option('--out')
const catalog = createConversationCatalog({ home: process.env.HOME, stateDir: config.storage.stateDir })
const collected = new Map(); let before, pages = 0, conversation
for (;;) {
  const page = await catalog.read(id, before); conversation = page.conversation; pages += 1
  let oldest = Infinity
  for (const message of page.messages) { const time = Date.parse(message.timestamp || 0); oldest = Math.min(oldest, time || Infinity); if (time >= since && time <= until) collected.set(message.id, message) }
  before = page.nextBefore
  if (!before || oldest < since || pages > 5000) break
}
let keep = [...collected.values()]
const only = option('--project')
if (only) keep = citingProject(keep, JSON.parse(await readFile(path.join(config.storage.stateDir, 'GlobalProjectIndex.json'), 'utf8')), only)
const markdown = renderDigest({ id, conversation, messages: keep, pages, since: option('--since'), until: option('--until'), project: only, maxChars })
const messages = keep
if (out) { await writeFile(out, markdown, { mode: 0o600 }); console.log(`wrote ${out}: ${messages.length} messages, ${markdown.length} characters, ${pages} windows`) } else console.log(markdown)
