/* 12 October 2026 17:25 CEST: shared fonts, colors and spacing remain the sole visual parameters. */
.jpc { --jpc-radius: 16px; --jpc-list-width: 280px; --jpc-gap: var(--jp-e3); color: var(--g9-fg); }
.jpc *, .jpc *::before, .jpc *::after { box-sizing: border-box; }
.jpc h2, .jpc h3, .jpc h4, .jpc p, .jpc li, .jpc-card > span { font-family: var(--zr-police-serif); font-weight: var(--zr-poids-serif, 350); }
.jpc h2 { margin: 0 0 var(--jp-e2); }
.jpc h3 { margin: var(--jp-e3) 0 var(--jp-e2); }
.jpc p { line-height: 1.65; margin: var(--jp-e1) 0 var(--jp-e2); }
.jpc .jpc-meta, .jpc .jpc-notice { color: var(--g9-muted); font-size: 13px; }
.jpc .jpc-number { font-family: var(--zr-police-serif); font-weight: var(--zr-poids-nombres, 400); }
.jpc .jpc-technical { font-family: var(--zr-police-mono); }
.jpc-controls { display: flex; flex-wrap: wrap; align-items: end; gap: var(--jp-e2); margin: var(--jp-e3) 0; }
.jpc-controls label { display: flex; flex-direction: column; gap: var(--jp-e1); font-family: var(--zr-police-sans); font-size: 13px; }
.jpc-controls label:first-child { flex: 1 1 200px; }
.jpc button, .jpc input, .jpc select { font-family: var(--zr-police-sans); font-weight: var(--zr-poids-sans, 400); font-size: 13px; color: var(--g9-fg); border: 1px solid color-mix(in srgb, var(--g9-fg) 16%, transparent); border-radius: var(--jpc-radius); padding: var(--jp-e1) var(--jp-e2); background: color-mix(in srgb, var(--g9-bg) 88%, transparent); }
.jpc button { cursor: pointer; }
.jpc button:disabled { cursor: default; opacity: .5; }
.jpc button:focus-visible, .jpc input:focus-visible, .jpc select:focus-visible { outline: 2px solid var(--g9-fg); outline-offset: 3px; }
.jpc-layout { display: grid; grid-template-columns: minmax(0, var(--jpc-list-width)) minmax(0, 1fr); gap: var(--jpc-gap); align-items: start; }
.jpc-results { display: flex; flex-direction: column; gap: var(--jp-e1); }
.jpc button.jpc-card { display: flex; flex-direction: column; text-align: left; gap: var(--jp-e1); padding: var(--jp-e2); }
.jpc-card[aria-pressed="true"] { background: color-mix(in srgb, var(--g9-fg) 12%, var(--g9-bg)); }
.jpc-card small { color: var(--g9-muted); font-size: 12px; }
.jpc-detail, .jpc-cooker { padding: var(--jp-e3); border-radius: var(--jpc-radius); background: color-mix(in srgb, var(--g9-fg) 5%, transparent); min-width: 0; overflow-wrap: anywhere; }
.jpc-detail header { display: flex; flex-wrap: wrap; gap: var(--jp-e2); align-items: start; justify-content: space-between; }
.jpc-detail li { margin-bottom: var(--jp-e2); }
.jpc a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
.jpc-examples > div { border-left: 2px solid color-mix(in srgb, var(--g9-fg) 20%, transparent); padding-left: var(--jp-e2); margin: var(--jp-e3) 0; }
.jpc-examples p { margin: var(--jp-e0) 0; }
.jpc-cooker { margin-top: var(--jp-e4); }
.jpc-error { padding: var(--jp-e2); border: 1px solid var(--g9-fg); border-radius: var(--jpc-radius); margin: var(--jp-e2) 0; }
.jpc-error button { margin-left: var(--jp-e2); }
.jpc-lesson { margin-top: var(--jp-e3); }
.jpc-stroke img { width: 160px; height: 160px; border-radius: var(--jpc-radius); }
.zr-dark .jpc-stroke img { filter: invert(1); }
.jpc details { margin: var(--jp-e2) 0 var(--jp-e3); }
.jpc summary { cursor: pointer; font-family: var(--zr-police-sans); }
.jpc table { width: 100%; border-collapse: collapse; margin: var(--jp-e2) 0; font-family: var(--zr-police-serif); }
.jpc td, .jpc th { padding: var(--jp-e1); text-align: left; font-weight: var(--zr-poids-serif, 350); border-bottom: 1px solid color-mix(in srgb, var(--g9-fg) 15%, transparent); }
.jpc-pagination { display: flex; flex-wrap: wrap; gap: var(--jp-e2); align-items: center; margin-bottom: var(--jp-e3); }
.jpc-pagination p { margin: 0; }
@media (max-width: 760px) { .jpc-layout { grid-template-columns: minmax(0, 1fr); } .jpc-detail, .jpc-cooker { padding: var(--jp-e2); } }
