import { describe, it, expect } from 'vitest'
import { numeroDeTri, espacesDeTri, espaceParDefaut, PREFIXE_TRI } from './dossiersDeTri.js'

const dossier = (name) => ({ name, hasKids: true, dir: `pages/Photos/DJI/${name}` })
const fichier = (name) => ({ name, hasKids: false, contentPath: `pages/Photos/DJI/${name}` })
const ICI = 'pages/Photos/DJI/29 Août 2026'

describe('numeroDeTri — reconnaître un espace de tri, et rien d’autre', () => {
  it('accepte les entiers positifs', () => {
    expect(numeroDeTri('tmp-img-selection1')).toBe(1)
    expect(numeroDeTri('tmp-img-selection42')).toBe(42)
  })
  it('refuse le préfixe nu, un zéro de tête, un zéro, une lettre', () => {
    // Sans cette sévérité, `tmp-img-selection01` et `tmp-img-selection1` désigneraient le même tas
    // sous deux noms, et le tri se disperserait sans que rien ne le signale.
    expect(numeroDeTri('tmp-img-selection')).toBe(null)
    expect(numeroDeTri('tmp-img-selection01')).toBe(null)
    expect(numeroDeTri('tmp-img-selection0')).toBe(null)
    expect(numeroDeTri('tmp-img-selectionX')).toBe(null)
    expect(numeroDeTri('tmp-img-selection-2')).toBe(null)
  })
  it('refuse un nom qui commence pareil mais continue autrement', () => {
    expect(numeroDeTri('tmp-img-selections1')).toBe(null)
    expect(numeroDeTri('autre-tmp-img-selection1')).toBe(null)
  })
  it('ne casse pas sur une entrée vide', () => {
    expect(numeroDeTri(null)).toBe(null)
    expect(numeroDeTri('')).toBe(null)
  })
})

describe('espacesDeTri — ce qu’on propose à l’écran', () => {
  it('un dossier vierge ne propose QUE le premier espace, marqué neuf', () => {
    const r = espacesDeTri([], ICI)
    expect(r).toHaveLength(1)
    expect(r[0]).toMatchObject({ n: 1, nom: 'tmp-img-selection1', neuf: true })
    expect(r[0].chemin).toBe(`${ICI}/tmp-img-selection1`)
  })

  it('avec le 1 existant, le 2 apparaît à côté — la demande exacte de Matthieu', () => {
    const r = espacesDeTri([dossier('tmp-img-selection1')], ICI)
    expect(r.map((x) => x.nom)).toEqual(['tmp-img-selection1', 'tmp-img-selection2'])
    expect(r[0].neuf).toBe(false)
    expect(r[1].neuf).toBe(true)
  })

  it('des numéros à trous n’en réutilisent aucun : on avance, comme un compteur', () => {
    // Réutiliser un trou ferait réapparaître un tas supprimé sous son ancien nom, ce qui trompe.
    const r = espacesDeTri([dossier('tmp-img-selection3'), dossier('tmp-img-selection1')], ICI)
    expect(r.map((x) => x.n)).toEqual([1, 3, 4])
    expect(r[2].neuf).toBe(true)
  })

  it('les FICHIERS ne comptent jamais, même bien nommés', () => {
    const r = espacesDeTri([fichier('tmp-img-selection1.img.json'), fichier('tmp-img-selection1')], ICI)
    expect(r.map((x) => x.nom)).toEqual(['tmp-img-selection1'])
    expect(r[0].neuf).toBe(true)
  })

  it('les dossiers qui ne sont pas des espaces de tri sont ignorés', () => {
    const r = espacesDeTri([dossier('Photos'), dossier('Videos'), dossier('tmp-img-selection2')], ICI)
    expect(r.map((x) => x.n)).toEqual([2, 3])
  })

  it('accepte les trois formes d’entrée de dossier du projet', () => {
    const r = espacesDeTri([
      { name: 'tmp-img-selection1', hasKids: true },
      { name: 'tmp-img-selection2', type: 'dir' },
      { name: 'tmp-img-selection3', isDir: true },
    ], ICI)
    expect(r.map((x) => x.n)).toEqual([1, 2, 3, 4])
  })

  it('le chemin est absolu et sans double barre, même si le dossier finit par une barre', () => {
    const r = espacesDeTri([], 'pages/Photos/')
    expect(r[0].chemin).toBe('pages/Photos/tmp-img-selection1')
  })

  it('le préfixe est un paramètre, jamais un littéral figé', () => {
    const r = espacesDeTri([dossier('tri-video1')], 'pages/X', 'tri-video')
    expect(r.map((x) => x.nom)).toEqual(['tri-video1', 'tri-video2'])
    expect(PREFIXE_TRI).toBe('tmp-img-selection')
  })
})

describe('espaceParDefaut — la cible du clic direct', () => {
  it('sur un dossier vierge, c’est le neuf', () => {
    expect(espaceParDefaut(espacesDeTri([], ICI)).n).toBe(1)
  })
  it('avec des espaces existants, on CONTINUE de remplir le dernier plutôt que d’en ouvrir un', () => {
    // C'est le geste du tri en rafale : ouvrir un tas neuf à chaque clic serait exactement l'inverse.
    const e = espacesDeTri([dossier('tmp-img-selection1'), dossier('tmp-img-selection2')], ICI)
    expect(espaceParDefaut(e)).toMatchObject({ n: 2, neuf: false })
  })
  it('ne casse pas sur une liste vide', () => {
    expect(espaceParDefaut([])).toBe(null)
    expect(espaceParDefaut(null)).toBe(null)
  })
})

import { estTriable, triables, TYPES_TRIABLES } from './dossiersDeTri.js'
import { readFileSync } from 'node:fs'

describe('estTriable — tout type confondu, et rien de plus', () => {
  const feuille = (nom) => ({ name: nom, hasKids: false, contentPath: `pages/X/${nom}` })

  it('accepte les sept types de nœuds que le lien Eagle sait porter', () => {
    for (const ext of ['img', 'media', 'file', 'canvas', 'embed', 'db']) {
      expect(estTriable(feuille(`a.${ext}.json`))).toBe(true)
    }
  })

  it('accepte un DOSSIER entier : createEagleLinks sait poser un lien de dossier', () => {
    expect(estTriable({ name: 'Voyage', hasKids: true })).toBe(true)
  })

  it('refuse une page markdown et un JSON quelconque', () => {
    expect(estTriable(feuille('note.md'))).toBe(false)
    expect(estTriable(feuille('config.json'))).toBe(false)
    expect(estTriable(feuille('a.props.json'))).toBe(false)
  })

  it('ne casse pas sur une entrée absente ou sans chemin', () => {
    expect(estTriable(null)).toBe(false)
    expect(estTriable({})).toBe(false)
    expect(estTriable({ name: 'x', hasKids: false })).toBe(false)
  })

  it('triables filtre une sélection mixte en gardant l’ordre', () => {
    const sel = [feuille('1.img.json'), feuille('note.md'), { name: 'D', hasKids: true }, feuille('2.media.json')]
    expect(triables(sel).map((x) => x.name)).toEqual(['1.img.json', 'D', '2.media.json'])
  })

  // LE CONTRÔLE QUI COMPTE LE PLUS, et qui n'est pas un test de confort : ce filtre et celui de
  // `createEagleLinks` DOIVENT accepter exactement la même chose. S'ils divergent, un type passera
  // le menu et sera refusé par le lot, ou l'inverse, et rien ne le signalera avant l'échec.
  it('s’accorde EXACTEMENT avec le filtre de createEagleLinks dans Pages.jsx', () => {
    // vitest tourne depuis la racine du projet : un chemin relatif au cwd est stable ici,
    // là où `import.meta.url` n'est pas une URL `file:` dans cet environnement.
    const pages = readFileSync('src/create/Pages.jsx', 'utf8')
    const ligne = pages.split('\n').find((l) => l.includes('const leaves = entries.filter'))
    expect(ligne, 'la ligne de createEagleLinks a bougé : réaligner ce test').toBeTruthy()
    const motif = ligne.match(/\/\\\.\(([a-z|]+)\)\\\.json\$\//)
    expect(motif, 'le motif de createEagleLinks n’est plus reconnaissable').toBeTruthy()
    const attendus = motif[1].split('|').sort()
    const miens = TYPES_TRIABLES.source.match(/\(([a-z|]+)\)/)[1].split('|').sort()
    expect(miens).toEqual(attendus)
  })
})
