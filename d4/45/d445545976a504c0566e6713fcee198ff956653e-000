import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { describe, expect, it } from 'vitest'
import { applyRename, checkParity, planRename, undoRename } from './media-rename.mjs'

const make = (files) => {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'rename-'))
  for (const name of files) { fs.mkdirSync(path.dirname(path.join(root, name)), { recursive: true }); fs.writeFileSync(path.join(root, name), 'x') }
  return root
}

describe('rename phase', () => {
  it('plans clean names and series subfolders, sidecars follow', () => {
    const root = make(['Akane-banashi S01E12 VOSTFR 1080p WEB x264 AAC -Tsundere-Raws (ADN).mkv', 'Akane-banashi S01E12 VOSTFR 1080p WEB x264 AAC -Tsundere-Raws (ADN).fr.srt', 'Under.the.Open.Sky.2020.FR.mkv'])
    const plan = planRename(root)
    expect(plan.items.map((i) => i.toRel).sort()).toEqual([
      'Akane Banashi/Saison 01/Akane Banashi S01E12.fr.srt', 'Akane Banashi/Saison 01/Akane Banashi S01E12.mkv', 'Under The Open Sky.mkv',
    ])
  })
  it('refuses to apply without approval, applies after it, and undoes', () => {
    const root = make(['Under.the.Open.Sky.2020.FR.mkv'])
    const plan = planRename(root)
    expect(() => applyRename(plan, { approved: false })).toThrow('not approved')
    expect(fs.existsSync(path.join(root, 'Under.the.Open.Sky.2020.FR.mkv'))).toBe(true)
    const { log } = applyRename(plan, { approved: true })
    expect(fs.existsSync(path.join(root, 'Under The Open Sky.mkv'))).toBe(true)
    expect(undoRename(log)).toEqual({ restored: 1 })
    expect(fs.existsSync(path.join(root, 'Under.the.Open.Sky.2020.FR.mkv'))).toBe(true)
  })
  it('disambiguates two releases that clean to the same name and flags series title variants', () => {
    const root = make(['Under.the.Open.Sky.2020.mkv', 'Under.the.Open.Sky.2020.FR.mkv', 'Bleach S17E43.mkv', 'Bleach.Thousand-Year.Blood.War.S17E45.1080p.mkv'])
    const plan = planRename(root)
    const targets = plan.items.map((i) => i.toRel)
    expect(new Set(targets).size).toBe(targets.length)
    expect(targets.some((t) => t.includes('Under The Open Sky (2020)'))).toBe(true)
    expect(plan.items.find((i) => i.fromRel.startsWith('Bleach.Thousand')).reasons.join()).toContain('series_title_variant:Bleach')
  })
  it('takes the season of a bare episode number from the folder it sits in', () => {
    const root = make(['Mushishi/Saison 2/Mushishi (2014) - 03 VOSTFR BDrip 1080p FLAC x265-GundamGuy.mkv'])
    const plan = planRename(root)
    expect(plan.items[0].toRel).toBe('Mushishi/Saison 02/Mushishi S02E03.mkv')
  })
  it('checks parity in both directions', () => {
    expect(checkParity([{ src: '/a/Under The Open Sky.mkv', name: 'Under The Open Sky.mkv', dest: 'Movies' }]).ok).toBe(true)
    expect(checkParity([{ src: '/a/Under.the.Open.Sky.2020.FR.mkv', name: 'Under The Open Sky.mkv', dest: 'Movies' }]).problems[0].verdict).toBe('local_name_differs_from_cloud_name')
    expect(checkParity([{ name: 'Under.the.Open.Sky.2020.FR.mkv', dest: 'Movies' }]).problems[0].verdict).toBe('name_not_clean')
    expect(checkParity([{ name: 'Akane Banashi S01E12.mkv', dest: '[DKB] Akane 1080p' }]).problems[0].verdict).toBe('folder_not_clean')
  })
})
