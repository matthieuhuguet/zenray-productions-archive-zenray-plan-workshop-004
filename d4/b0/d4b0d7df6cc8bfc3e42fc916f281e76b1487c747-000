import { describe, expect, it } from 'vitest'
import { extOf, kindForName, mimeForName } from './fileKinds.js'

describe('creative formats used by Eagle links', () => {
  it('keeps Houdini compound extensions identifiable', () => {
    expect(extOf('cache.bgeo.sc')).toBe('bgeo.sc')
    expect(kindForName('asset.hda')).toBe('houdini')
    expect(mimeForName('cache.bgeo.sc')).toBe('application/x-houdini-geometry')
  })
  it('routes FBX to the 3D preview loader', () => {
    expect(kindForName('character.fbx')).toBe('3d-lib')
  })
})
