// push-token.mjs (12 October 2026): at most ONE git push sends data at a time, across every upload process of the machine.
// EN: one push already saturates the home uplink (11 MB/s measured), but between two pushes the line sits idle for about 15 s
// (hashing, server side processing). With two or three uploads running, the token makes their data phases follow each other
// instead of overlapping, so one upload sends while the others prepare. The token is released as soon as the data is sent
// ("Writing objects: 100%"), not when the server answers.
// FR : une seule poussee envoie ses donnees a la fois ; elle rend le jeton des que les donnees sont parties.
import os from 'node:os'
import path from 'node:path'
import { acquireDirectoryLock, directoryLockOptions } from './directory-lock.mjs'

const lockDir = () => process.env.ZR_PUSH_TOKEN_DIR || path.join(os.homedir(), '.zr-archive-work-mapped', 'PushToken.lock')

export const pushTokenEnabled = () => process.env.ZR_PUSH_TOKEN !== '0'

// Returns { release(), waitedMs }; release is idempotent. waitedMs is the time spent waiting for the token (a metric of the push
// policy: wait time is measured apart from transfer time). Disabled mode returns a no-op token.
// FR : waitedMs = temps passe a attendre le jeton, mesure a part du temps de transfert.
export async function acquirePushToken(label = 'git push') {
  if (!pushTokenEnabled()) return { release: async () => {}, waitedMs: 0 }
  const startedAt = Date.now()
  const lock = await acquireDirectoryLock(lockDir(), { ...directoryLockOptions('long', label), waitMs: 45 * 60_000 })
  const waitedMs = Date.now() - startedAt
  let released = false
  return { release: async () => { if (released) return; released = true; await lock.release() }, waitedMs }
}
