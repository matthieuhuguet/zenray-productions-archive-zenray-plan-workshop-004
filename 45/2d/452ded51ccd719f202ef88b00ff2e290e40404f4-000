// 3 October 2026, 22:12 CEST: observed presence, expected destinations and disconnected paths remain separate facts.
import { isWorkspaceId, sourceCloudFolder } from './projectWorkspace.js'
export function assetsFileLocations(file, project, connected) {
  // 10 October 2026, 19:20 CEST: Ignore legacy and malformed source identities while rendering cloud files.
  const source = isWorkspaceId(file?.sourceId)
    ? project?.sources?.find(source => isWorkspaceId(source.id) && source.id === file.sourceId)
    : null
  const relative = file.directory ? file.relativePath : file.relativePath || file.name
  const safe = typeof relative === 'string' && (relative !== '' || file.directory) && !relative.startsWith('/') && !relative.split('/').some(part => part === '..' || part === '.')
  const localPath = file.localPath || (safe && source?.localPath ? `${source.localPath.replace(/\/$/, '')}/${relative}` : null)
  const archivedPath = file.cloudPath || file.contentPath || null
  const expectedPath = file.expectedCloudPath || (safe && project?.folder && source ? `${sourceCloudFolder(project, source)}/${relative}` : null)
  return {
    local: { path: localPath, state: !connected ? 'Mac déconnecté, présence à vérifier' : file.present === false ? 'Absent de ce Mac' : file.present === true ? file.loadedCopy ? 'Copie chargée' : 'Sur ce Mac' : 'Présence à vérifier', missing: !localPath ? 'Emplacement local non relié' : null },
    cloud: { path: archivedPath || expectedPath, state: archivedPath ? file.status === 'partial' ? 'Sauvegarde partielle' : ['modified', 'older-local', 'source-conflict'].includes(file.status) || file.sourceConflict ? 'Versions différentes' : ['verified', 'backed-up'].includes(file.status) ? 'Sauvegardé' : 'Archive référencée' : expectedPath ? 'Destination prévue, pas encore sauvegardé' : 'Aucune archive reliée', missing: !archivedPath && !expectedPath ? 'Emplacement cloud non relié' : null },
  }
}

// 3 October 2026, 22:18 CEST: column folders derive their two roots from their mapped descendants, not from a guessed source name.
export function assetsFolderFile(files, depth, name) {
  const first = files[0]
  const parts = first.relativePath.split('/')
  const parent = (field) => { const file = files.find(file => file[field]); return file ? file[field].split('/').slice(0, -(file.relativePath.split('/').length - depth)).join('/') : null }
  return { ...first, name, directory: true, relativePath: parts.slice(0, depth).join('/'),
    localPath: parent('localPath'), cloudPath: parent('cloudPath') || parent('contentPath'), contentPath: null,
    expectedCloudPath: parent('expectedCloudPath'),
    present: files.some(file => file.present === true) ? true : undefined,
    status: files.every(file => ['verified', 'backed-up'].includes(file.status)) ? 'backed-up' : files.some(file => file.cloudPath || file.contentPath) ? 'partial' : 'local-only',
  }
}
