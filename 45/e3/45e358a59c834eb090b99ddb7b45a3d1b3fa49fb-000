// 3 October 2026, 12:16 : Small presentational pieces shared by every PostKit panel. Tokens only, no literal color.
import React from 'react'
import { POSTKIT } from './postkitConfig.js'
import { PLATFORM_COLORS } from '../config/colors.js'

export const metric = (v) => (v === null || v === undefined ? 'n/a' : typeof v === 'number' ? v.toLocaleString('en') : String(v))
export const change = (v, unit = '%') => (v === null || v === undefined ? '' : `${v > 0 ? '+' : ''}${v}${unit === 'pts' ? ' pts' : '%'}`)
export const when = (iso) => (iso ? new Date(iso).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : '')
export const ago = (iso, now = Date.now()) => {
  if (!iso) return ''
  const s = Math.max(0, Math.round((now - Date.parse(iso)) / 1000))
  return s < 60 ? `${s} s ago` : s < 3600 ? `${Math.round(s / 60)} min ago` : s < 86400 ? `${Math.round(s / 3600)} h ago` : `${Math.round(s / 86400)} d ago`
}
export const daysUntil = (iso, now = Date.now()) => (iso ? Math.ceil((Date.parse(iso) - now) / 86_400_000) : null)

export function Num({ children, title }) { return <span className="zr-pk-num" title={title}>{children}</span> }

// A null metric is "n/a", never 0: the platform does not expose it. (3 October 2026)
export function Metric({ value }) { return value === null || value === undefined ? <span className="zr-pk-na" title="The platform does not expose this metric">n/a</span> : <Num>{metric(value)}</Num> }

export function Badge({ tone = 'muted', children, title }) { return <span className={`zr-pk-badge is-${tone}`} title={title}>{children}</span> }
export const StatusBadge = ({ status }) => <Badge tone={POSTKIT.statusTone[status] || 'muted'}>{String(status).replace('_', ' ')}</Badge>
export function Verification({ level }) { const v = POSTKIT.verification[level]; return v ? <Badge tone={v.tone} title={v.help}>{v.label}</Badge> : null }

export function PlatformDot({ platform, label }) {
  return <span className="zr-pk-plat"><span className="zr-pk-platdot" style={{ background: PLATFORM_COLORS[platform] || 'var(--g9-soft)' }} />{label ?? platform}</span>
}

export function Card({ title, aside, children, className = '' }) {
  return (
    <section className={`zr-pk-card ${className}`}>
      {(title || aside) && <header className="zr-pk-cardhead"><h3 className="zr-pk-cardtitle">{title}</h3>{aside && <div className="zr-pk-aside">{aside}</div>}</header>}
      {children}
    </section>
  )
}

export function Tile({ label, value, sub, tone }) {
  return <div className={`zr-pk-tile${tone ? ` is-${tone}` : ''}`}><div className="zr-pk-tilelabel">{label}</div><div className="zr-pk-tilevalue"><Num>{value}</Num></div>{sub && <div className="zr-pk-tilesub">{sub}</div>}</div>
}

export const Empty = ({ children }) => <p className="zr-pk-empty">{children}</p>
export const ErrorLine = ({ error }) => (error ? <p className="zr-pk-error" role="alert">{error}</p> : null)

export function Field({ label, children, hint }) { return <label className="zr-pk-field"><span>{label}</span>{children}{hint && <small>{hint}</small>}</label> }
export function Btn({ children, onClick, busy, tone, type = 'button', disabled, title }) {
  return <button type={type} className={`zr-pk-btn${tone ? ` is-${tone}` : ''}`} onClick={onClick} disabled={busy || disabled} title={title}>{busy ? '…' : children}</button>
}

export function Copy({ text, label = 'Copy' }) {
  const [done, setDone] = React.useState(false)
  return <button type="button" className="zr-pk-btn" onClick={async () => { try { await navigator.clipboard.writeText(text); setDone(true); setTimeout(() => setDone(false), 1500) } catch {} }}>{done ? 'Copied' : label}</button>
}
