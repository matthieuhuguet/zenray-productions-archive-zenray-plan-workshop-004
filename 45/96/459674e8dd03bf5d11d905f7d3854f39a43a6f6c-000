// 2026-09-11 stripLeafExt removes exactly one leaf extension.
import { describe, it, expect } from 'vitest'
import { stripLeafExt, leafExtension } from './node.js'

describe('stripLeafExt', () => {
  it('keeps the .md of an archived Markdown file', () => {
    expect(stripLeafExt('pages/A/plans/03-plan.md.file.json')).toBe('pages/A/plans/03-plan.md')
    expect(leafExtension('pages/A/plans/03-plan.md.file.json')).toBe('.file.json')
  })
  it('still drops .md from a page and the leaf suffix from media', () => {
    expect(stripLeafExt('pages/A/notes.md')).toBe('pages/A/notes')
    expect(stripLeafExt('pages/A/photo.jpeg.img.json')).toBe('pages/A/photo.jpeg')
    expect(stripLeafExt('pages/A/board.ref.json')).toBe('pages/A/board')
  })
})
