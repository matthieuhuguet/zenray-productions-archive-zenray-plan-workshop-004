// 18 October 2026 : Tests unitaires de ZenRay Money v2 (Design A Hub Hextech + Design C Grand-Livre Comptable VICTORY & Facture PDF, départ 0,00 €, zéro SFX)
import React from 'react'
import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest'
import { render, screen, fireEvent, cleanup } from '@testing-library/react'
import MoneyView from './MoneyView.jsx'

describe('ZenRay Money v2 (Design A + C)', () => {
  beforeEach(() => {
    try { localStorage.clear() } catch {}
    global.fetch = vi.fn(() => Promise.resolve({ ok: false }))
  })
  afterEach(() => {
    cleanup()
  })

  it('starts strictly at 0,00 € with 4 empty weekly contract slots, Grand-Livre VICTORY, Facture PDF and Plan dock, with zero SFX', () => {
    const { container } = render(<MoneyView />)
    expect(screen.getByText('4 Contrats / Semaine')).toBeTruthy()
    expect(screen.getByText('Slot #1 · Vide')).toBeTruthy()
    expect(screen.getByText('Slot #4 · Vide')).toBeTruthy()
    expect(screen.getByText('GRAND-LIVRE COMPTABLE & FACTURATION PDF')).toBeTruthy()
    expect(screen.getByText('ÉMETTRE UNE FACTURE PDF')).toBeTruthy()
    expect(screen.getByText('PLAN & GOOGLE CAL')).toBeTruthy()
    expect(container.querySelectorAll('audio').length).toBe(0)
  })

  it('allows recording an invoice into the accounting ledger and updates weekly/net totals from 0,00 €', () => {
    render(<MoneyView />)
    const clientInput = screen.getByPlaceholderText('Ex. Studio / Client Freelance')
    const priceInput = screen.getAllByDisplayValue('0')[0]
    fireEvent.change(clientInput, { target: { value: 'Studio Test Houdini' } })
    fireEvent.change(priceInput, { target: { value: '500' } })
    fireEvent.click(screen.getByText('+ Enregistrer au Grand-Livre'))
    expect(screen.getByText('Studio Test Houdini')).toBeTruthy()
  })
})
