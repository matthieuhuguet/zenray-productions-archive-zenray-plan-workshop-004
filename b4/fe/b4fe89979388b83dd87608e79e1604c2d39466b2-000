// LOT TABLES — presse-papier multi-cellules au format TSV (tabulations).
// C'est le format qu'utilisent Excel et Google Sheets : colonnes séparées par TAB,
// lignes séparées par retour à la ligne. Copier/coller marche donc avec le système.

// Tableau 2D -> texte TSV.
export function toTSV(grid) {
  return grid.map((row) => row.map((c) => {
    const s = c == null ? '' : String(c)
    return /[\t\n"]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s
  }).join('\t')).join('\n')
}

// Texte TSV -> tableau 2D. Gère les guillemets et les sauts de ligne dans une cellule.
export function fromTSV(text) {
  const rows = []; let row = []; let cell = ''; let q = false
  for (let i = 0; i < text.length; i++) {
    const ch = text[i]
    if (q) {
      if (ch === '"') { if (text[i + 1] === '"') { cell += '"'; i++ } else q = false }
      else cell += ch
    } else if (ch === '"') q = true
    else if (ch === '\t') { row.push(cell); cell = '' }
    else if (ch === '\n') { row.push(cell); rows.push(row); row = []; cell = '' }
    else if (ch === '\r') { /* ignore */ }
    else cell += ch
  }
  if (cell !== '' || row.length) { row.push(cell); rows.push(row) }
  return rows
}

// Écrit dans le presse-papier système (best effort). Retombe sur execCommand si l'API moderne manque.
export async function writeClipboard(text) {
  try { if (navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); return true } } catch {}
  try {
    const ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0'
    document.body.appendChild(ta); ta.select(); const ok = document.execCommand('copy'); document.body.removeChild(ta); return ok
  } catch { return false }
}

export async function readClipboard() {
  try { if (navigator.clipboard && navigator.clipboard.readText) return await navigator.clipboard.readText() } catch {}
  return null
}
