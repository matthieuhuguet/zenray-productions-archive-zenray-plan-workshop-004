// 23 October 2026: outline of the ONE glass shape made of the selected question (tab) and its answer (panel).
// The top edge is continuous because the panel top equals the row top; the join gets a concave fillet `f`.
// Reference: zenray-edit/templates/liquid-glass/README.md. FR : contour de la forme de verre unique onglet + réponse.
export function glassTabPath({ width, rowHeight, tabWidth, height, R, r, f }) {
  const w = width, h = height, t = tabWidth, rh = rowHeight
  return `M ${r} 0 H ${w - R} A ${R} ${R} 0 0 1 ${w} ${R} V ${h - R} A ${R} ${R} 0 0 1 ${w - R} ${h} H ${t + R} A ${R} ${R} 0 0 1 ${t} ${h - R} ` +
    `V ${rh + f} A ${f} ${f} 0 0 0 ${t - f} ${rh} H ${r} A ${r} ${r} 0 0 1 0 ${rh - r} V ${r} A ${r} ${r} 0 0 1 ${r} 0 Z`
}

/** The panel must at least reach below the tab, or the fillet would cut through it. */
export const minPanelHeight = ({ rowHeight, R, f }) => rowHeight + R + f
