// 2 October 2026, 15:05 CEST: only independently verified managed workspaces can be released.
import { constants } from 'node:fs'
import { lstat, open, readdir, realpath, unlink, rmdir } from 'node:fs/promises'
import { createHash } from 'node:crypto'
import path from 'node:path'
import { execFile } from 'node:child_process'
import { promisify } from 'node:util'

// 10 October 2026, 12:35 CEST: Finder metadata is retained locally rather than silently discarded or uploaded.
export async function workspaceFinderMetadata(directory) {
  const files = []
  const visit = async (folder) => {
    for (const entry of await readdir(folder, { withFileTypes: true })) {
      const target = path.join(folder, entry.name)
      if (entry.isDirectory() && !entry.isSymbolicLink()) await visit(target)
      else if (entry.name === '.DS_Store' && entry.isFile()) {
        if (await realpath(target) !== target) throw new Error('Unsafe Finder metadata path')
        const descriptor = await open(target, constants.O_RDONLY | constants.O_NOFOLLOW)
        try {
          const before = await descriptor.stat(), hash = createHash('sha256')
          for await (const chunk of descriptor.createReadStream({ autoClose: false })) hash.update(chunk)
          const after = await descriptor.stat()
          if (before.ctimeMs !== after.ctimeMs || before.size !== after.size) throw new Error('Finder metadata changed during verification')
          files.push({ relativePath: path.relative(directory, target).split(path.sep).join('/'), size: after.size, sha256: hash.digest('hex') })
        } finally { await descriptor.close() }
      }
    }
  }
  await visit(directory)
  return files
}

// 10 October 2026, 12:34 CEST: fail closed when an application still holds a managed copy open.
export async function assertWorkspaceIdle(directory, execute = promisify(execFile)) {
  try {
    const { stdout } = await execute('/usr/sbin/lsof', ['-nP', '-Fpn', '+D', directory], { timeout: 30000, maxBuffer: 4 * 1024 * 1024 })
    if (stdout.trim()) throw new Error('Workspace is open in an application; local files retained')
  } catch (error) {
    if (error.code === 1 && !error.stdout?.trim() && !error.stderr?.trim()) return
    throw error
  }
}

export async function verifyWorkspaceTree(directory, files) {
  if (!files.length) throw new Error('Empty workspace proof refused')
  if (await realpath(directory) !== directory || !(await lstat(directory)).isDirectory()) throw new Error('Unsafe workspace root')
  const expected = new Map(files.map((file) => [file.relativePath, file]))
  if (expected.size !== files.length) throw new Error('Duplicate workspace proof')
  let bytes = 0, allocatedBytes = 0
  const seen = new Set()
  const visit = async (folder, prefix = '') => {
    for (const entry of await readdir(folder, { withFileTypes: true })) {
      const relative = prefix ? `${prefix}/${entry.name}` : entry.name
      const target = path.join(folder, entry.name)
      if (entry.isSymbolicLink()) throw new Error('Workspace symlink refused')
      if (entry.isDirectory()) { await visit(target, relative); continue }
      const proof = expected.get(relative)
      if (!entry.isFile() || !proof) throw new Error(`Untracked workspace file: ${relative}`)
      const descriptor = await open(target, constants.O_RDONLY | constants.O_NOFOLLOW)
      try {
        const before = await descriptor.stat()
        const hash = createHash('sha256')
        for await (const chunk of descriptor.createReadStream({ autoClose: false })) hash.update(chunk)
        const after = await descriptor.stat()
        if (before.size !== proof.size || hash.digest('hex') !== proof.sha256 || before.ctimeMs !== after.ctimeMs || before.mtimeMs !== after.mtimeMs || before.size !== after.size) {
          throw new Error(`Modified workspace file retained: ${relative}`)
        }
        seen.add(relative); bytes += before.size; allocatedBytes += Number(before.blocks || 0) * 512
      } finally { await descriptor.close() }
    }
  }
  await visit(directory)
  if (seen.size !== expected.size) throw new Error('Workspace file missing; release refused')
  return { count: seen.size, bytes, allocatedBytes }
}

// 10 October 2026, 12:30 CEST: never recursively remove a tree that another process can add files to.
export async function removeVerifiedWorkspace(directory, files, { signal, beforeRemove } = {}) {
  await verifyWorkspaceTree(directory, files)
  for (const file of files) {
    if (signal?.aborted) throw new Error('Unload interrupted; remaining local files retained')
    const target = path.resolve(directory, file.relativePath)
    if (!target.startsWith(directory + path.sep) || await realpath(target) !== target) throw new Error('Unsafe workspace removal path')
    await beforeRemove?.(target)
    const before = await lstat(target)
    if (!before.isFile()) throw new Error('Workspace removal requires a regular file')
    const descriptor = await open(target, constants.O_RDONLY | constants.O_NOFOLLOW)
    try {
      const hash = createHash('sha256')
      for await (const chunk of descriptor.createReadStream({ autoClose: false })) hash.update(chunk)
      const after = await lstat(target)
      if (after.dev !== before.dev || after.ino !== before.ino || after.size !== file.size ||
          after.ctimeMs !== before.ctimeMs || after.mtimeMs !== before.mtimeMs || hash.digest('hex') !== file.sha256) {
        throw new Error(`Modified workspace file retained: ${file.relativePath}`)
      }
      if (signal?.aborted) throw new Error('Unload interrupted; remaining local files retained')
      await unlink(target)
    } finally { await descriptor.close() }
  }
  const removeEmpty = async (folder) => {
    for (const entry of await readdir(folder, { withFileTypes: true })) {
      if (!entry.isDirectory() || entry.isSymbolicLink()) throw new Error('New workspace file retained during unload')
      await removeEmpty(path.join(folder, entry.name))
    }
    await rmdir(folder)
  }
  await removeEmpty(directory)
}
