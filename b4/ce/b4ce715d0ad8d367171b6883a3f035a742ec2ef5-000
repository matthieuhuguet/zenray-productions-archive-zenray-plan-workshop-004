// 20 October 2026: the bindings chip reveals one row per project, with its conversations.
import React from 'react'
import { render, screen, fireEvent } from '@testing-library/react'
import { describe, expect, it, vi } from 'vitest'
import { TubeHome } from './AssetsTube.jsx'

const projects = [{ id: 'a', name: 'Alpha', category: 'Projet' }]
const conversations = [
  { id: 'c1', provider: 'claude', title: 'Premier fil', projectId: 'a', updatedAt: '2026-10-20T10:00:00Z' },
  { id: 'c2', provider: 'codex', title: 'Sans projet', projectId: null, updatedAt: '2026-10-19T10:00:00Z' },
]

describe('TubeHome bindings', () => {
  it('shows the bindings list from its chip and opens a project', () => {
    const onSelect = vi.fn()
    render(<TubeHome projects={projects} conversations={conversations} onSelect={onSelect} onConversation={() => {}} renderThumbnail={() => null} />)
    fireEvent.click(screen.getByRole('button', { name: /Liens projets/ }))
    expect(screen.getByRole('list', { name: 'Projets et conversations liées' })).toBeTruthy()
    expect(screen.getByText('Premier fil')).toBeTruthy()
    expect(screen.getByText(/1 sans projet/)).toBeTruthy()
    fireEvent.click(screen.getByRole('button', { name: 'Alpha' }))
    expect(onSelect).toHaveBeenCalledWith('a')
  })
})
