import { describe, expect, it } from 'vitest'
import {
  DEFAULT_SLOT_MINUTES,
  STANDARD_SLOTS,
  hhmmToMinutes,
  minutesToHhmm,
  nextAvailableSlot,
  getSlotPresets,
  slotAfter,
} from './planSlots.js'

describe('planSlots (20 October 2026)', () => {
  it('converts between hh:mm and total minutes accurately', () => {
    expect(hhmmToMinutes('09:00')).toBe(540)
    expect(hhmmToMinutes('10:30')).toBe(630)
    expect(hhmmToMinutes('12:00')).toBe(720)
    expect(hhmmToMinutes('00:00')).toBe(0)
    expect(minutesToHhmm(540)).toBe('09:00')
    expect(minutesToHhmm(630)).toBe('10:30')
    expect(minutesToHhmm(720)).toBe('12:00')
  })

  it('calculates the next slot after a given time and duration', () => {
    expect(slotAfter('09:00', 90)).toBe('10:30')
    expect(slotAfter('10:30', 90)).toBe('12:00')
    expect(slotAfter('12:00', 90)).toBe('13:30')
  })

  it('defaults to 09:00 when a day has no tasks', () => {
    expect(nextAvailableSlot([], '2026-10-22')).toBe('09:00')
  })

  it('slots into 10:30 when 09:00 is occupied by a 90m task', () => {
    const tasks = [
      { id: 't1', date: '2026-10-22', startTime: '09:00', durationMin: 90, status: 'planned', title: 'Task 1' },
    ]
    expect(nextAvailableSlot(tasks, '2026-10-22')).toBe('10:30')
  })

  it('slots into 10:30 even if the 09:00 task had a shorter duration (e.g. 15m)', () => {
    const tasks = [
      { id: 't1', date: '2026-10-22', startTime: '09:00', durationMin: 15, status: 'planned', title: 'Sport' },
    ]
    // A 90m task starting at 09:00 would overlap with the 09:00-09:15 window, so next slot is 10:30
    expect(nextAvailableSlot(tasks, '2026-10-22')).toBe('10:30')
  })

  it('stacks sequentially: 09:00, 10:30 -> next is 12:00', () => {
    const tasks = [
      { id: 't1', date: '2026-10-22', startTime: '09:00', durationMin: 90, status: 'planned' },
      { id: 't2', date: '2026-10-22', startTime: '10:30', durationMin: 90, status: 'planned' },
    ]
    expect(nextAvailableSlot(tasks, '2026-10-22')).toBe('12:00')
  })

  it('fills holes in the schedule: if 09:00 and 12:00 are taken, 10:30 is picked', () => {
    const tasks = [
      { id: 't1', date: '2026-10-22', startTime: '09:00', durationMin: 90, status: 'planned' },
      { id: 't3', date: '2026-10-22', startTime: '12:00', durationMin: 90, status: 'planned' },
    ]
    expect(nextAvailableSlot(tasks, '2026-10-22')).toBe('10:30')
  })

  it('ignores dropped tasks on that day', () => {
    const tasks = [
      { id: 't1', date: '2026-10-22', startTime: '09:00', durationMin: 90, status: 'dropped' },
    ]
    expect(nextAvailableSlot(tasks, '2026-10-22')).toBe('09:00')
  })

  it('ignores tasks on different dates', () => {
    const tasks = [
      { id: 't1', date: '2026-10-21', startTime: '09:00', durationMin: 90, status: 'planned' },
    ]
    expect(nextAvailableSlot(tasks, '2026-10-22')).toBe('09:00')
  })

  it('generates slot presets with accurate occupied flags', () => {
    const tasks = [
      { id: 't1', date: '2026-10-22', startTime: '09:00', durationMin: 90, status: 'planned', title: 'Deep Work' },
    ]
    const presets = getSlotPresets(tasks, '2026-10-22')
    expect(presets[0]).toEqual({ time: '09:00', occupied: true, taskTitle: 'Deep Work' })
    expect(presets[1]).toEqual({ time: '10:30', occupied: false, taskTitle: null })
    expect(presets[2]).toEqual({ time: '12:00', occupied: false, taskTitle: null })
  })
})
