// ═══ LIRE UNE DURÉE TAPÉE À LA MAIN ══════════════════════════════════════════════════════════════
//
// Demande de Matthieu (2026-08-27) : « si je double clique au milieu il faut que je puisse ajouter un
// timer de temps custom, sans preset, juste je tape dans sec ou min », puis, après avoir tapé « 24h » et
// s'être fait refuser : « pourquoi durée non comprise ? ajoute toutes les possibilités ».
//
// LE VRAI DÉFAUT N'ÉTAIT PAS LE PLAFOND, C'ÉTAIT LE MESSAGE. « 24h » avait été parfaitement compris ;
// il tombait simplement au-delà d'un maximum de huit heures que j'avais posé. Répondre « durée non
// comprise » à une durée comprise est un mensonge d'interface, et c'est pire qu'un refus : cela envoie
// chercher une faute de syntaxe là où il n'y en a pas. Un refus doit toujours dire CE QUI CLOCHE, sans
// quoi il transforme une limite en énigme. D'où le résultat rendu ci-dessous, qui porte une raison
// plutôt qu'un `null` muet, et un plafond remonté à la journée entière.
//
// LE PIÈGE DE CE GENRE DE CHAMP, PAR AILLEURS, EST TOUJOURS LE MÊME. On croit avoir affaire à un
// nombre, et l'on a affaire à une INTENTION. « 7 » veut dire sept minutes, « 90s » quatre-vingt-dix
// secondes, « 2m30 » deux minutes et demie, « 1h30 » une heure et demie. Une seule de ces quatre formes
// se lit avec `parseInt`, les trois autres donneraient silencieusement un résultat faux.
//
// L'UNITÉ PAR DÉFAUT EST LA MINUTE, et ce choix n'est pas arbitraire : les trois paliers du minuteur
// sont en minutes, la tâche écrite dans le Plan porte une durée en minutes, et la boucle de travail de
// Matthieu est la boucle 15/2. Taper « 7 » veut dire sept minutes pour la même raison que cliquer sur
// « 15 » veut dire quinze minutes.
//
// LA RÈGLE DE L'UNITÉ IMPLICITE, celle qui fait marcher « 1h30 » sans qu'on y pense : un nombre sans
// unité qui SUIT un nombre avec unité prend l'unité juste en dessous. Après une heure viennent des
// minutes, après une minute viennent des secondes. C'est la convention que tout le monde a en tête sans
// l'avoir jamais formulée, et la respecter évite d'imposer une syntaxe à quelqu'un qui tape vite.

// Bornes. En dessous de cinq secondes, un bloc n'a pas le temps d'exister et le tic des dix dernières
// secondes sonnerait avant même le départ. Le plafond est la journée : au-delà, ce n'est plus une durée
// qu'on tape dans un minuteur, c'est une date.
export const BORNES = { min: 5, max: 24 * 3600 }

// TOUTES LES ÉCRITURES, français et anglais, singulier et pluriel, abrégées et entières. Cette table
// est longue exprès : chaque ligne absente est un refus que Matthieu essuierait sans comprendre, et
// une ligne de plus ne coûte rien alors qu'une ligne manquante coûte un aller-retour.
const UNITES = {
  // heures
  h: 3600, hr: 3600, hrs: 3600, hour: 3600, hours: 3600, heure: 3600, heures: 3600,
  // minutes. L'apostrophe est la notation des minutes d'angle et de temps, familière à qui lit une carte.
  m: 60, mn: 60, min: 60, mins: 60, minute: 60, minutes: 60, "'": 60,
  // secondes. Le guillemet double est la notation symétrique.
  s: 1, sec: 1, secs: 1, second: 1, seconds: 1, seconde: 1, secondes: 1, '"': 1, '”': 1, '’': 60,
}
// L'unité « juste en dessous », pour le nombre nu qui suit un nombre à unité.
const DESSOUS = { 3600: 60, 60: 1, 1: 1 }

const refus = (raison, secondes) => ({ ok: false, raison, secondes })

/**
 * Rend `{ ok: true, secondes }`, ou `{ ok: false, raison, secondes? }`.
 * Les raisons sont `vide`, `incomprise`, `courte` et `longue`. Elles existent pour que l'interface
 * dise ce qui cloche : une durée trop longue a été COMPRISE, et le lui reprocher comme une faute de
 * syntaxe envoie chercher une erreur qui n'existe pas.
 */
export function analyserDuree(texte) {
  if (typeof texte !== 'string') return refus('vide')
  const t = texte.trim().toLowerCase().replace(/,/g, '.')
  if (!t) return refus('vide')

  // FORME À DEUX-POINTS D'ABORD, parce qu'elle est la seule où la POSITION porte le sens : dans
  // « 2:30 » aucune lettre ne dit que 30 sont des secondes, c'est le rang qui le dit. La traiter comme
  // les autres ferait lire deux minutes plus trente minutes.
  if (/^\d+(:\d{1,2})+$/.test(t)) {
    const parts = t.split(':').map(Number)
    if (parts.length > 3) return refus('incomprise')
    if (parts.slice(1).some((p) => p > 59)) return refus('incomprise')
    const poids = parts.length === 3 ? [3600, 60, 1] : [60, 1]
    return borner(parts.reduce((somme, p, i) => somme + p * poids[i], 0))
  }

  const motif = /(\d+(?:\.\d+)?)\s*([a-zé]+|['"’”])?/g
  const jetons = [...t.matchAll(motif)]
  if (!jetons.length) return refus('incomprise')
  // Un reste non consommé signifie qu'on n'a pas compris la phrase entière, et comprendre à moitié une
  // durée est pire que ne pas la comprendre : on refuse plutôt que de deviner. Les liaisons courantes
  // sont tolérées, parce que « 1h et 30 » est une façon normale d'écrire, pas une faute.
  const reste = t.replace(motif, '').replace(/\bet\b|\band\b|[+\s·-]/g, '').trim()
  if (reste) return refus('incomprise')

  let total = 0
  let precedente = null
  for (const [, nombre, lettres] of jetons) {
    const n = parseFloat(nombre)
    if (!Number.isFinite(n)) return refus('incomprise')
    let unite
    if (lettres) {
      unite = UNITES[lettres]
      if (!unite) return refus('incomprise')     // une unité inconnue est un refus, pas un défaut
    } else {
      unite = precedente ? DESSOUS[precedente] : 60   // nu et seul : des minutes. Nu et suivant : l'unité du dessous.
    }
    total += n * unite
    precedente = unite
  }
  return borner(total)
}

function borner(s) {
  const secondes = Math.round(s)
  if (secondes < BORNES.min) return refus('courte', secondes)
  if (secondes > BORNES.max) return refus('longue', secondes)
  return { ok: true, secondes }
}

/** La phrase à montrer sous le champ. Elle nomme la vraie cause, jamais une cause générique. */
export function messageRefus(resultat) {
  switch (resultat?.raison) {
    case 'courte': return `trop court, ${formaterDuree(BORNES.min)} au minimum`
    case 'longue': return `trop long, ${formaterDuree(BORNES.max)} au maximum`
    case 'vide': return 'entrez une durée'
    default: return 'durée non comprise'
  }
}

/** Forme courte et lisible d'une durée : « 7 min », « 1 min 30 », « 1 h 30 », « 24 h ». */
export function formaterDuree(secondes) {
  const s = Math.max(0, Math.round(secondes))
  const h = Math.floor(s / 3600)
  const m = Math.floor((s % 3600) / 60)
  const r = s % 60
  if (h) {
    if (r) return `${h} h ${String(m).padStart(2, '0')} min ${r}`
    return m ? `${h} h ${String(m).padStart(2, '0')}` : `${h} h`
  }
  if (m) return r ? `${m} min ${String(r).padStart(2, '0')}` : `${m} min`
  return `${r} s`
}
