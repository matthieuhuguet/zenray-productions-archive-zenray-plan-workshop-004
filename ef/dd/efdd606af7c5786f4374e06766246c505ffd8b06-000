// Le libelle affichable d une vue, pour le titre de l onglet. Rend null quand la cle est inconnue,
// ce qui laisse l appelant garder le titre nu plutot que d ecrire un nom faux.
export function libelleDeVue(cle) {
  const normKey = (cle === 'mariage-clea-septembre-2026') ? 'marriage-clea-septembre-2026' : cle
  const custom = getAllGalleries().find((g) => g.key === normKey)
  if (custom) return custom.label
  const item = NAV.find((n) => n.key === normKey)
  return item ? item.label : null
}

export default function Sidebar({ t, view, setView, overlay, floating, onCollapse, theme, setTheme, onPick, onMouseEnter, onMouseLeave, onOpenYoutubeVideo, onOpenSpotifyTrack, onOpenLocalTrack, onOpenAudioPlayer, onOpenTodayNote }) {
  const i18nT = useT()
  const [collapsed, setCollapsed] = usePersistedState(NAV_COLLAPSE_KEY, {}, { json: true })
  const toggleZone = (zone) => setCollapsed((c) => ({ ...c, [zone]: !c[zone] }))
  // 23 October 2026: Dynamic galleries subscription to update sidebar when a gallery is created from Create.
  const [galleriesRevision, setGalleriesRevision] = useState(0)
  useEffect(() => {
    const handler = () => setGalleriesRevision((r) => r + 1)
    window.addEventListener('zr:pointer-galleries-changed', handler)
    return () => window.removeEventListener('zr:pointer-galleries-changed', handler)
  }, [])
  const navItems = useMemo(() => {
    const all = getAllGalleries()
    const galleryItems = all.map((g) => ({ key: g.key, label: g.label, labelKey: g.labelKey || `nav.${g.key}`, zone: 'Gallery', zoneKey: 'nav.zoneGallery' }))
    const learnIndex = NAV.findIndex((n) => n.zone === 'Learn' || n.zone === 'Apps')
    const topItems = NAV.slice(0, learnIndex >= 0 ? learnIndex : NAV.length).filter((n) => n.zone !== 'Gallery')
    const bottomItems = NAV.slice(learnIndex >= 0 ? learnIndex : NAV.length).filter((n) => n.zone !== 'Gallery')
    return [...topItems, ...galleryItems, ...bottomItems]
  }, [galleriesRevision])
  // C215c — sidebar en 3 zones (IA OS). Routing inchangé (chaque item garde sa view) : zéro régression.
  // labelKey/zoneKey -> i18n (src/i18n/dict.js, namespace nav.*), label/zone restent le fallback FR brut.
  // SUBTRACTION DESIGN (2026-07-07) : plus d'icône par item — juste le texte, plus lisible, moins de bruit.
  // UI 2026-07-19 : "Sidebar left" du design V9 (workspace-sidebar) — verre neutre V9 (classes
  // zr-ws-* dans fonts.css), headings mono uppercase, items 36px/17px, item actif BLEU #0a84ff.
  // zr-liquid reste sur l'aside : l'ancrage du PlayerBar global cherche aside.zr-liquid.
  return (
    <aside className={`${overlay ? 'zr-liquid zr-sidebar-overlay' : 'zr-liquid'}${!overlay && !floating ? ' zr-sidebar-docked' : ''} zr-ws-sidebar`} onMouseEnter={onMouseEnter} onMouseLeave={onMouseLeave}
      style={{ width: 232, flex: floating ? undefined : '0 0 232px', padding: '17px 18px 22px', display: 'flex', flexDirection: 'column', gap: 10,
        // overlay (mobile) : panneau plein écran à gauche. floating (reveal au survol, façon Claude Code) : widget fixe qui FLOTTE
        // au-dessus du contenu sans le pousser. docked (desktop ancré) : widget flottant arrondi en flux, hauteur = contenu.
        // 9 October 2026, 01:22 CEST: The anchored desktop sidebar scrolls on its own when its links exceed the viewport.
        // FR : la barre ancrée défile seule quand ses liens dépassent la fenêtre ; l’overlay mobile garde son comportement.
        ...(overlay
          ? { borderRadius: '0 30px 30px 0', maxHeight: '100dvh', overflowY: 'auto' }
          : floating
            ? { position: 'fixed', top: 70, left: 12, zIndex: 130, borderRadius: 30 }
            : { position: 'sticky', top: 70, alignSelf: 'flex-start', margin: '70px 0 12px 12px', borderRadius: 30 }) }}>
      {/* Bandeau `.zr-ws-top` du gear SUPPRIMÉ le 2026-07-22 (demande Matthieu « récupérer l'espace du haut ») :
          l'engrenage vit désormais DANS l'en-tête de la section Tools (ex-Search), à droite du libellé -- voir plus bas. */}
      {/* Conteneur des sections : hauteur naturelle (contenu), AUCUN overflow -> pas de scrollbar (verticale NI
          horizontale : `overflowY:auto` entraînait `overflow-x:auto` par la spec). Seul l'overlay mobile défile. */}
      {/* 23 October 2026 (Matthieu): the « ZenRay Progress » brand is removed from the sidebar. / la marque est retirée. */}
      <div className={overlay ? 'zr-scroll-noblur' : undefined} style={overlay ? { flex: 1, overflowY: 'auto', minHeight: 0 } : undefined}>
      {/* La recherche est une zone cachable de plus (retour 2026-07-19 : "cachable dans un sous menu >
          Search, pareil que Create/Apps/System") -- même mécanisme collapsed/toggleZone que les 3 autres
          zones. DANS le conteneur défilant (pas au-dessus, retour 2026-07-19 bis : "pas autant d'espace
          entre search et create") : au-dessus, le `gap:10` de l'aside s'ajoutait à la marge propre du
          heading suivant, doublant l'espace visible par rapport aux transitions Create->Apps->Système
          (qui, elles, vivent toutes dans ce même conteneur et ne subissent que la marge du heading). */}
      {/* Section TOOLS (ex-Search, renommée le 2026-07-22 ; corrigée le 2026-07-22 bis après retour Matthieu
          « le gear n'est PAS imbriqué avec la search »). L'en-tête = SEUL le toggle de repli (chevron + libellé).
          Le CONTENU (déplié) = une LIGNE flex : la barre de recherche À GAUCHE qui prend le MAXIMUM d'espace
          (flex:1) + l'engrenage de Réglages À DROITE (petit, largeur fixe). Les DEUX sont cachés au repli de
          Tools (une seule condition !collapsed.Tools). Un <button> ne peut pas en contenir un autre -> ce n'est
          PAS des boutons imbriqués mais une ligne flex de deux éléments frères. Popover du gear portalé (uiPrefs.Pop)
          -> jamais rogné, même sans overflow sur le drawer. */}
      {navItems.map((n, i) => {
        const on = view === n.key
        const newZone = i === 0 || navItems[i - 1].zone !== n.zone
        const zoneShut = !!collapsed[n.zone]
        // SOUS-GROUPES DE LA ZONE CREATE (2026-09-05). Treize entrees d'affilee forment une liste
        // plate ou l'oeil ne trouve plus rien : trois intertitres tres legers, Travail, Bibliotheques,
        // Pilotage, rendent la meme liste lisible sans en retirer une seule. L'ORDRE N'EST PAS TOUCHE,
        // les trois groupes tombent sur des items deja contigus, donc aucune position ne bouge.
        // L'intertitre suit le repli de sa zone, sinon il flotterait au-dessus du vide.
        return (
          <React.Fragment key={n.key}>
            {newZone && (
              <button onClick={() => toggleZone(n.zone)} className="zr-ws-heading" title={zoneShut ? 'Déplier' : 'Replier'}>
                <Icon name={zoneShut ? 'chevron.right' : 'chevron.down'} size={12} style={{ flexShrink: 0 }} />
                {i18nT(n.zoneKey)}
              </button>
            )}
            {!zoneShut && (
              <button onClick={() => { if (n.key === 'audio') { onOpenAudioPlayer && onOpenAudioPlayer() } else if (n.key === 'notes') { onOpenTodayNote && onOpenTodayNote() } else { setView(n.key) } onPick && onPick() }} className={`zr-navitem zr-ws-item${on ? ' active' : ''}`}>
                {(() => { const txt = i18nT(n.labelKey); return txt === n.labelKey ? n.label : txt })()}
              </button>
            )}
          </React.Fragment>
        )
      })}
      {/* 23 October 2026 (Matthieu): Tools is the LAST section of the sidebar, after System. / Tools en dernier. */}
      {onOpenYoutubeVideo && (
        <button onClick={() => toggleZone('Tools')} className="zr-ws-heading" title={collapsed.Tools ? 'Déplier' : 'Replier'}>
          <Icon name={collapsed.Tools ? 'chevron.right' : 'chevron.down'} size={12} style={{ flexShrink: 0 }} />
          Tools
        </button>
      )}
      {/* ALIGNEMENT DE LA LIGNE TOOLS (corrigé le 2026-07-31, retour Matthieu « la search bar et
          l'engrenage ne sont pas alignés »). DEUX causes se cumulaient, et corriger l'une seule ne
          suffisait pas. D'abord `alignItems: 'flex-start'` calait l'engrenage sur le HAUT de la barre
          au lieu de son milieu. Ensuite l'enveloppe de la recherche portait un `padding-bottom: 8px`,
          donc sa BOÎTE dépassait de 8 px la PILULE visible : même centrée, la pilule serait restée
          4 px trop haute. Le rembourrage bas est donc remonté ici, sur la ligne, où il sépare Tools
          de la section suivante sans fausser l'alignement interne. */}
      {onOpenYoutubeVideo && !collapsed.Tools && (
        <div style={{ display: 'flex', alignItems: 'center', gap: 8, padding: '0 4px 10px 10px' }}>
          <div style={{ flex: 1, minWidth: 0 }}>
            <MultiSourceSidebarSearch
              onOpenVideo={(videoId) => { onOpenYoutubeVideo(videoId); onPick && onPick() }}
              onOpenSpotifyTrack={(url) => { onOpenSpotifyTrack(url); onPick && onPick() }}
              onOpenLocalTrack={(path) => { onOpenLocalTrack(path); onPick && onPick() }} />
          </div>
          <SettingsMenu t={t} theme={theme} setTheme={setTheme} onCollapse={onCollapse} floating={floating} />
        </div>
      )}
      </div>
    </aside>
  )
}
