// Extrait de App.jsx (batch refactor structurel 2026-07-16).
const NAV_COLLAPSE_KEY = 'zr:navCollapsed'
const basename = (path) => String(path || '').split('/').pop().replace(/\.media\.json$/, '')

// Un groupe (YouTube / Spotify / Fichiers locaux) : replié = 2 résultats + chevron bas, déplié = 6 par
// page + chevron haut + pagination. MÊME balisage/CSS dans les deux états (retour Matthieu 2026-07-18,
// V2 après rejet de la V1 qui avait un style différent replié/déplié) -- seuls la liste et le sens du
// chevron changent. Design validé sur liquidglass-components.html avant intégration ici.
function SidebarSearchGroup({ label, items, searching, getKey, getCover, getRound, getTitle, getSubtitle, onSelect }) {
  const [expanded, setExpanded] = useState(false)
  const [page, setPage] = useState(0)
  const perPage = 6
  const pageCount = Math.max(1, Math.ceil(items.length / perPage))
  const visible = expanded ? items.slice(page * perPage, page * perPage + perPage) : items.slice(0, 2)
  if (!searching && !items.length) return null
  return (
    <div className="zr-sbs-group">
      <div className="zr-sbs-group-head">
        <h4>{label}</h4>
        {items.length > 2 && (
          <button type="button" className={`zr-sbs-chevron ${expanded ? 'up' : ''}`} onClick={() => { setExpanded((v) => !v); setPage(0) }} title={expanded ? 'Réduire' : 'Afficher jusqu’à 6 résultats'}>
            <Icon name={expanded ? 'chevron.up' : 'chevron.down'} size={11} />
          </button>
        )}
      </div>
      {searching ? <div className="zr-sbs-note">Recherche…</div> : visible.map((item) => (
        <button key={getKey(item)} type="button" className="zr-sbs-row" onClick={() => onSelect(item)}>
          {getCover(item) ? <img src={getCover(item)} alt="" className={`zr-sbs-thumb ${getRound(item) ? 'round' : ''}`} /> : <div className={`zr-sbs-thumb ${getRound(item) ? 'round' : ''}`} />}
          <span><strong>{getTitle(item)}</strong><small>{getSubtitle(item)}</small></span>
        </button>
      ))}
      {expanded && pageCount > 1 && (
        <div className="zr-sbs-pagination">
          <button type="button" className="zr-sbs-page-btn" disabled={page === 0} onClick={() => setPage((v) => Math.max(0, v - 1))}><Icon name="chevron.left" size={11} /></button>
          <span>{page + 1}/{pageCount}</span>
          <button type="button" className="zr-sbs-page-btn" disabled={page === pageCount - 1} onClick={() => setPage((v) => Math.min(pageCount - 1, v + 1))}><Icon name="chevron.right" size={11} /></button>
        </div>
      )}
    </div>
  )
}

// Recherche multi-source dans la sidebar (retour Matthieu 2026-07-17/18) : YouTube (API Data v3, clé
// requise), Spotify (catalogue, Client Credentials, aucun login) et fichiers locaux (index de recherche
// déjà chargé côté client, filtré sur pages/Music). SEUL point d'entrée : pas de home, pas de feed, donc
// aucune recommandation YouTube en amont. Clic sur un résultat -> ouvre l'onglet Create au bon endroit :
// vidéo YouTube (lecteur IFrame sans suggestions) ou piste Spotify/locale (ZenRay Audio, même mécanisme
// que zr:create-music déjà utilisé par le lecteur global).
function MultiSourceSidebarSearch({ onOpenVideo, onOpenSpotifyTrack, onOpenLocalTrack }) {
  const [query, setQuery] = useState('')
  const [youtubeResults, setYoutubeResults] = useState([])
  const [youtubeSearching, setYoutubeSearching] = useState(false)
  const [youtubeError, setYoutubeError] = useState('')
  const [spotifyResults, setSpotifyResults] = useState([])
  const [spotifySearching, setSpotifySearching] = useState(false)
  const [localPaths, setLocalPaths] = useState([])
  const ytSeq = useRef(0)
  const spSeq = useRef(0)

  useEffect(() => { loadSearchIndex().then(() => setLocalPaths(getIndexPaths().filter((p) => p.startsWith('pages/Music/') && p.endsWith('.media.json')))).catch(() => {}) }, [])

  useEffect(() => {
    const needle = query.trim()
    if (needle.length < 2) { setYoutubeResults([]); setYoutubeSearching(false); setYoutubeError(''); setSpotifyResults([]); setSpotifySearching(false); return undefined }
    setYoutubeSearching(true); setSpotifySearching(true)
    const ytSequence = ++ytSeq.current
    const spSequence = ++spSeq.current
    const timer = setTimeout(async () => {
      fetch(`/api/youtube-search-v3?type=video&q=${encodeURIComponent(needle)}`).then((r) => r.json()).catch(() => null).then((data) => {
        if (ytSequence !== ytSeq.current) return
        setYoutubeSearching(false)
        if (!data?.ok) { setYoutubeResults([]); setYoutubeError(data?.error === 'not-configured' ? 'Clé YouTube Data API manquante.' : 'Recherche indisponible.'); return }
        setYoutubeError(''); setYoutubeResults(data.results || [])
      })
      fetch(`/api/spotify-search?q=${encodeURIComponent(needle)}`).then((r) => r.json()).catch(() => null).then((data) => {
        if (spSequence !== spSeq.current) return
        setSpotifySearching(false)
        const items = (data?.tracks?.items || []).map((track) => ({
          id: track.id, title: track.name, artist: (track.artists || []).map((a) => a.name).join(', '),
          cover: track.album?.images?.[track.album.images.length - 1]?.url || track.album?.images?.[0]?.url || '',
          url: track.external_urls?.spotify || (track.id ? `https://open.spotify.com/track/${track.id}` : ''),
        }))
        setSpotifyResults(items)
      })
    }, 350)
    return () => clearTimeout(timer)
  }, [query])

  const localMatches = useMemo(() => {
    const needle = query.trim().toLowerCase()
    if (needle.length < 2) return []
    return localPaths.filter((path) => basename(path).toLowerCase().includes(needle)).slice(0, 48).map((path) => ({ path, title: basename(path) }))
  }, [localPaths, query])

  const active = query.trim().length >= 2

  return (
    <div style={{ padding: '0 2px' }}>
      <div className="zr-sbs-search zr-sbs-search--sidebar">
        <Icon name="magnifyingglass" size={18} style={{ position: 'relative', zIndex: 1, opacity: .6, flexShrink: 0 }} />
        <input value={query} onChange={(e) => setQuery(e.target.value)} placeholder="Search" />
      </div>
      {active && (
        <div className="zr-sbs-drop">
          <SidebarSearchGroup label="YouTube" items={youtubeResults} searching={youtubeSearching}
            getKey={(v) => v.videoId} getCover={(v) => v.thumbnail} getRound={() => false} getTitle={(v) => v.title} getSubtitle={(v) => v.channel || 'YouTube'}
            onSelect={(v) => onOpenVideo(v.videoId)} />
          {youtubeError && <div className="zr-sbs-note">{youtubeError}</div>}
          <SidebarSearchGroup label="Spotify" items={spotifyResults} searching={spotifySearching}
            getKey={(t) => t.id} getCover={(t) => t.cover} getRound={() => true} getTitle={(t) => t.title} getSubtitle={(t) => t.artist || 'Spotify'}
            onSelect={(t) => onOpenSpotifyTrack(t.url)} />
          <SidebarSearchGroup label="Fichiers locaux" items={localMatches} searching={false}
            getKey={(t) => t.path} getCover={() => ''} getRound={() => true} getTitle={(t) => t.title} getSubtitle={() => 'ZenRay'}
            onSelect={(t) => onOpenLocalTrack(t.path)} />
        </div>
      )}
    </div>
  )
}

