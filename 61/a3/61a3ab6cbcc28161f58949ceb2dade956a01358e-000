// subtitleSettings.js (12 October 2026): the three subtitle choices of the player, in one place.
// EN: size is a percentage of the former "small" (100 % = clamp(14px, 1.8cqi, 40px)); the background pill and the family
// (sans or serif) are switches. Every player reads the same preferences, so every film looks the same.
// FR : la taille est un pourcentage de l'ancienne « petite » ; fond et famille (sans ou serif) sont des interrupteurs.
export const SUB_PERCENT = { min: 25, max: 150, step: 5, presets: [100, 75, 50], fallback: 75 }
export const SUB_FONTS_FAMILY = { sans: 'var(--zr-police-sans)', serif: 'var(--zr-police-serif)' }
export const SUB_KEYS = { size: 'zr-subtitle-size-pct', background: 'zr-subtitle-bg', font: 'zr-subtitle-font', legacySize: 'zr-subtitle-size' }

// The old three sizes, kept readable: the former small is now 100 %, and users who had picked "sm" find 75 %, which they asked for.
const LEGACY = { sm: 75, md: 100, lg: 150 }

export function clampPercent(value) {
  const n = Number(value)
  if (!Number.isFinite(n)) return SUB_PERCENT.fallback
  const stepped = Math.round(n / SUB_PERCENT.step) * SUB_PERCENT.step
  return Math.min(SUB_PERCENT.max, Math.max(SUB_PERCENT.min, stepped))
}

export function percentGrid() {
  const out = []
  for (let p = SUB_PERCENT.min; p <= SUB_PERCENT.max; p += SUB_PERCENT.step) out.push(p)
  return out
}

// css values for a percentage; 100 % is exactly the former small, so nothing else moves.
// Each bound of the clamp is scaled (no calc around clamp: some CSS parsers mangle it).
const trim = (n) => String(Math.round(n * 100) / 100)
const scaledClamp = (min, cqi, max, p) => `clamp(${trim(min * p)}px, ${trim(cqi * p)}cqi, ${trim(max * p)}px)`
export function subtitleBox(percent) {
  const p = clampPercent(percent) / 100
  return {
    percent: clampPercent(percent),
    fontSize: scaledClamp(14, 1.8, 40, p),
    padding: `${scaledClamp(4, 0.5, 12, p)} ${scaledClamp(10, 1.2, 24, p)}`,
    borderRadius: scaledClamp(6, 0.6, 14, p),
    lineHeight: 1.35,
  }
}

export function readSubtitlePrefs(storage) {
  const get = (key) => { try { return storage?.getItem(key) ?? null } catch { return null } }
  const rawSize = get(SUB_KEYS.size)
  const legacy = get(SUB_KEYS.legacySize)
  const sizePct = rawSize != null ? clampPercent(rawSize) : (LEGACY[legacy] ?? SUB_PERCENT.fallback)
  const font = get(SUB_KEYS.font) === 'serif' ? 'serif' : 'sans'
  const background = get(SUB_KEYS.background) !== '0'
  return { sizePct, font, background }
}

export function writeSubtitlePref(storage, key, value) {
  try { storage?.setItem(key, String(value)) } catch { /* private window: the choice lasts for the page only */ }
}
