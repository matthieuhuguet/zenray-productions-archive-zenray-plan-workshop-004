// @vitest-environment node
// 13 October 2026, 09:55 CEST: per-project paths-only mode must not affect neighboring projects.
import { expect, test, vi } from 'vitest'
import { mkdtemp, rm } from 'node:fs/promises'
import { tmpdir } from 'node:os'
import path from 'node:path'
import { AssetsService } from './AssetsService.mjs'
async function probe(mode) {
  const directory = await mkdtemp(path.join(tmpdir(), 'assets-index-mode-'))
  try {
    const service = Object.create(AssetsService.prototype)
    const state = {pendingIndex:['pages/synthetic.file.json']}
    service.state=()=>state;service.project=()=>({indexThumbnailMode:mode})
    service.config={storage:{indexProcessTimeoutMs:1000,processKillGraceMs:10}}
    service.repoRoot=directory;service.runProcess=vi.fn(async()=>({}));service.save=vi.fn(async()=>{})
    // 21 October 2026, 17:13 CEST: The existing service now requires its index ledger in this fixture too.
    service.indexLedger={missing:vi.fn(async(entries)=>entries),record:vi.fn(async()=>{})}
    const env={SYNTHETIC_PARAMETER:'retained'}
    await service.indexPending('synthetic',env,undefined,directory)
    expect(state.pendingIndex).toEqual([])
    expect(service.save).toHaveBeenCalledWith('synthetic')
    return service.runProcess.mock.calls[0][2].env
  } finally {await rm(directory,{recursive:true,force:true})}
}
test('paths-only project skips thumbnails while retaining child environment',async()=>{
  expect(await probe('paths-only')).toEqual({SYNTHETIC_PARAMETER:'retained',ZR_INDEX_SKIP_THUMBNAILS:'1'})
})
test('ordinary project keeps the existing indexing behavior',async()=>{
  expect(await probe(undefined)).toEqual({SYNTHETIC_PARAMETER:'retained'})
})
test('unknown thumbnail mode is refused',()=>{
  const service=Object.create(AssetsService.prototype);service.config={storage:{},roots:{}}
  expect(()=>service.validateProject({id:'synthetic',name:'Synthetic',sources:[],indexThumbnailMode:'silent-skip'})).toThrow('Unknown index thumbnail mode')
})
