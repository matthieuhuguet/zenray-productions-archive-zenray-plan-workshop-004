// 16 October 2026 14:10 Europe/Paris: browse all source references without granting lesson approval or mastery.
import React, { useEffect, useMemo, useState } from 'react'
import { readCorpusJson, CorpusStroke } from './JapaneseCorpus.jsx'
import { createReferenceClient, filterReferences, REFERENCE_CONFIG, vocabularyForms } from './japaneseReferenceModel.js'
import './JapaneseReferences.css'
const defaultClient = createReferenceClient(readCorpusJson)
const categories = { base: 'Signes de base', dakuten: 'Formes voisées', handakuten: 'Formes en p', yoon: 'Combinaisons usuelles', small: 'Petits signes', sokuon: 'Consonne prolongée', historical: 'Signes historiques', rareYoon: 'Combinaisons rares', longVowelMark: 'Voyelle prolongée' }
export default function JapaneseReferences({ active = true, client = defaultClient }) {
  const [kind, setKind] = useState('vocabulary'), [data, setData] = useState(null), [error, setError] = useState(''), [attempt, setAttempt] = useState(0)
  const [query, setQuery] = useState(''), [level, setLevel] = useState('N5'), [script, setScript] = useState('hiragana'), [category, setCategory] = useState('base'), [grade, setGrade] = useState(''), [missingOnly, setMissingOnly] = useState(false)
  const [page, setPage] = useState(0), [selected, setSelected] = useState(null)
  useEffect(() => { if (!active) return; let alive = true; setData(null); setError(''); setSelected(null)
    client.load(kind).then(value => { if (alive) setData({ ...value, loadedKind: kind }) }).catch(failure => { if (alive) setError(failure.message) })
    return () => { alive = false }
  }, [active, client, kind, attempt])
  useEffect(() => { setPage(0); setSelected(null) }, [kind, query, level, script, category, grade, missingOnly])
  const matches = useMemo(() => filterReferences(data?.loadedKind === kind ? data.entries : [], { kind, query, level: kind === 'vocabulary' ? level : '', script: kind === 'kana' ? script : '', category: kind === 'kana' ? category : '', grade: kind === 'joyo' ? grade : '', missingOnly: kind !== 'kana' && missingOnly }), [data, kind, query, level, script, category, grade, missingOnly])
  if (!active) return null
  const changeKind = value => { setKind(value); setMissingOnly(false) }
  return <section className="jpr" aria-label="Références japonais"><h2>Vocabulaire, kana et jōyō</h2>
    <p>Des références à consulter librement. Une consultation ne déclare aucun acquis et ne remplace pas une leçon validée.</p>
    <nav aria-label="Types de références">{[['vocabulary', 'Vocabulaire français-japonais'], ['kana', 'Hiragana et katakana'], ['joyo', 'Les 2 136 jōyō']].map(([key, label]) => <button key={key} aria-pressed={kind === key} onClick={() => changeKind(key)}>{label}</button>)}</nav>
    <div className="jpr-filters"><label>Rechercher en français ou japonais<input value={query} onChange={event => setQuery(event.target.value)} /></label>
      {kind === 'vocabulary' && <label>Liste de vocabulaire<select aria-label="Liste de vocabulaire" value={level} onChange={event => setLevel(event.target.value)}><option value="">Toutes les références</option>{REFERENCE_CONFIG.levels.map(value => <option key={value} value={value}>{value === 'unclassified' ? 'Pour aller plus loin : hors listes JLPT' : value}</option>)}</select></label>}
      {kind === 'kana' && <><label>Écriture<select aria-label="Écriture" value={script} onChange={event => setScript(event.target.value)}><option value="hiragana">Hiragana</option><option value="katakana">Katakana</option><option value="">Les deux</option></select></label><label>Groupe de kana<select aria-label="Groupe de kana" value={category} onChange={event => setCategory(event.target.value)}><option value="">Tous les groupes</option>{Object.entries(categories).map(([key, value]) => <option key={key} value={key}>{value}</option>)}</select></label></>}
      {kind === 'joyo' && <label>Année scolaire<select aria-label="Année scolaire" value={grade} onChange={event => setGrade(event.target.value)}><option value="">Toutes les années</option>{[1,2,3,4,5,6,8].map(value => <option key={value} value={value}>{value === 8 ? 'Secondaire' : `Primaire ${value}`}</option>)}</select></label>}
      {kind !== 'kana' && <label><input type="checkbox" checked={missingOnly} onChange={event => setMissingOnly(event.target.checked)} /> Traductions françaises manquantes</label>}</div>
    {error && <p role="alert">{error} <button onClick={() => setAttempt(value => value + 1)}>Réessayer</button></p>}
    {data?.loadedKind !== kind && !error && <p role="status">Chargement des références…</p>}
    {data?.loadedKind === kind && <>{kind === 'vocabulary' && <p>Listes communautaires Waller, sans programme officiel exhaustif du JLPT. {data.withFrench.toLocaleString('fr-FR')} entrées avec français ; {data.missingFrench} sans traduction. « Hors listes » ne prouve pas un niveau supérieur au N1. Les {data.unresolvedRows.length} lignes sans identifiant et {data.unresolvedFormRows.length} formes non résolues restent des lacunes.</p>}
      {kind === 'joyo' && <p>Ordre : années scolaires, puis nombre de traits et caractère. Les groupes scolaires sont officiels ; leur ordre interne est éditorial. {data.counts.missingFrench} sens français restent manquants. Les lectures du dictionnaire ne sont pas toutes des lectures officielles de la table jōyō.</p>}
      {kind === 'kana' && <p>46 signes de base par écriture. {data.romanization?.descriptionFr} Les combinaisons étrangères supplémentaires ne sont pas incluses dans cette table.</p>}
      <p className="jpr-number">{matches.length.toLocaleString('fr-FR')} résultats</p><div className="jpr-grid">{matches.slice(page * REFERENCE_CONFIG.pageSize, (page + 1) * REFERENCE_CONFIG.pageSize).map(entry => {
        const pair = kind === 'vocabulary' ? vocabularyForms(entry).find(form => form.senses.length) || vocabularyForms(entry)[0] : null
        return <button key={entry.id} aria-pressed={selected?.id === entry.id} onClick={() => setSelected(entry)}><span lang="ja">{pair ? pair.spelling || pair.reading : entry.display || entry.character}</span><small>{pair ? pair.reading : kind === 'kana' ? entry.reading || entry.note : `N° ${entry.order} · ${entry.strokeCount} traits`}</small><small>{pair ? pair.senses.flatMap(sense => sense.gloss.map(gloss => gloss.text)).join(' ; ') || 'Traduction française manquante' : kind === 'joyo' ? entry.meaningsFr.join(' ; ') || 'Sens français manquant' : categories[entry.category]}</small></button>
      })}</div>
      <nav aria-label="Pages de références"><button disabled={page === 0} onClick={() => { setPage(value => value - 1); setSelected(null) }}>Précédent</button><span className="jpr-number">{page + 1}/{Math.max(1, Math.ceil(matches.length / REFERENCE_CONFIG.pageSize))}</span><button disabled={(page + 1) * REFERENCE_CONFIG.pageSize >= matches.length} onClick={() => { setPage(value => value + 1); setSelected(null) }}>Suivant</button></nav>
      {selected && <article className="jpr-detail"><header><h3 lang="ja">{selected.display || selected.character || selected.kanji.map(item => item.text).join(' / ') || selected.kana[0].text}</h3><button onClick={() => setSelected(null)}>Fermer la référence</button></header>
        {kind === 'vocabulary' && <>{selected.levelRows?.some(row => row.matchStatus !== 'compatible' || !row.hasCompatibleFrench) && <p role="note">Certaines formes de la liste ne correspondent pas à un sens français vérifié. Seules les associations compatibles du dictionnaire figurent ci-dessous.</p>}<table><thead><tr><th>Forme et lecture</th><th>Sens français compatibles</th></tr></thead><tbody>{vocabularyForms(selected).map((form, index) => <tr key={index}><td lang="ja">{form.spelling}<p>{form.reading}</p></td><td>{form.senses.map((sense, number) => <p key={number}>{sense.gloss.map(gloss => gloss.text).join(' ; ')}</p>)}{!form.senses.length && 'Traduction française manquante pour cette forme'}</td></tr>)}</tbody></table><p>Listes : {selected.memberships.join(', ') || 'non classé'}</p></>}
        {kind === 'kana' && <><p>{selected.reading || 'Lecture selon le contexte'}</p><p>{selected.note}</p></>}
        {kind === 'joyo' && <><p>Français : {selected.meaningsFr.join(' ; ') || 'sens manquant'}</p><p lang="ja">ON : {selected.onReadings.map(item => item.value).join('、') || 'non indiqué'}</p><p lang="ja">KUN : {selected.kunReadings.map(item => item.value).join('、') || 'non indiqué'}</p>{!!selected.nanori.length && <p lang="ja">Lectures de noms : {selected.nanori.join('、')}</p>}<CorpusStroke path={`${data.corpusBasePath}/${selected.strokeFile}`} /></>}
        <details><summary>Sources et droits</summary>{(selected.sourceRefs || []).map(id => { const source = Array.isArray(data.sources) ? data.sources.find(item => item.id === id) : data.sources?.[id]; return source ? <p key={id}><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title || source.publisher || id}</a> {source.rights}</p> : <p key={id}>{id}</p> })}</details>
      </article>}
    </>}
  </section>
}
