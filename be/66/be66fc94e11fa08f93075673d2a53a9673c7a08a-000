// 13 October 2026: the resume brief must keep dates, pick the newest conversation and never rewrite the human text.
import { describe, expect, it } from 'vitest'
import { buildResume, feedbackDate, parseFeedback, renderResume, sourceIdentity } from './ResumeBrief.mjs'

const entry = (date, kind, source, text) => `## ${date} : ${kind}\n\n<!-- feedback-event:x (${date}) -->\n- Project: bayou; kind: ${kind.toLowerCase()}. (${date})\n${source ? `- Source: ${source}. (${date})\n` : ''}\n> ${text} (${date})\n\n`
const feedback = '# bayou : project feedback, append only (1 October 2026)\n\n'
  + entry('9 October 2026, 10:00:00 +0200', 'Prompt', '/Users/z/.codex/sessions/2026/10/09/rollout-2026-10-09T10-00-00-01a12115-ab1b-7262-9039-00c41e82a05c.jsonl', 'ancien prompt')
  + entry('10 October 2026, 22:29:05 +0200', 'Order of work', null, '/goal 8 passes')
  + entry('11 October 2026, 17:13:05 +0200', 'Prompt', '/Users/z/.claude/projects/x/8152bc29-16c2-4858-828d-937ab6240571.jsonl', 'refais la cloture')
  + entry('11 October 2026, 17:20:00 +0200', 'Iteration', 'checkpoint:gemini:abc_123', 'cloture v6 faite, prochain : herbe')

describe('ResumeBrief (13 October 2026)', () => {
  it('parses dates with their offset and identities from every source shape', () => {
    expect(new Date(feedbackDate('11 October 2026, 17:13:05 +0200')).toISOString()).toBe('2026-10-11T15:13:05.000Z')
    expect(feedbackDate('no date')).toBeNull()
    expect(sourceIdentity('checkpoint:gemini:abc_123')).toEqual({ provider: 'gemini', sessionId: 'abc_123', checkpoint: true })
    expect(sourceIdentity('/Users/z/.codex/sessions/rollout-2026-10-09T10-00-00-01a12115-ab1b-7262-9039-00c41e82a05c.jsonl')).toMatchObject({ provider: 'codex', sessionId: '01a12115-ab1b-7262-9039-00c41e82a05c' })
    expect(sourceIdentity('')).toBeNull()
  })

  it('keeps the human text verbatim, without the trailing date stamp', () => {
    const entries = parseFeedback(feedback)
    expect(entries.map(item => item.kind)).toEqual(['Prompt', 'Order of work', 'Prompt', 'Iteration'])
    expect(entries[2].body).toBe('refais la cloture')
  })

  it('names the newest conversation, including a non native host checkpoint, and a newer transcript in the index wins', () => {
    const brief = buildResume({ projectId: 'bayou', feedbackText: feedback, settings: { prompts: 1 } })
    expect(brief.conversations[0]).toMatchObject({ provider: 'gemini', sessionId: 'abc_123' })
    expect(brief.prompts.map(item => item.body)).toEqual(['refais la cloture'])
    expect(brief.orders[0].body).toBe('/goal 8 passes')
    const index = { conversations: [{ provider: 'codex', sessionId: '01a12115-ab1b-7262-9039-00c41e82a05c', conversationId: 'codex:01a12115-ab1b-7262-9039-00c41e82a05c', boundProject: 'bayou', last: '2026-10-12T08:00:00.000Z', title: 'Bayou' }, { provider: 'claude', sessionId: 'other', boundProject: 'elsewhere', last: '2026-10-13T08:00:00.000Z' }] }
    const withIndex = buildResume({ projectId: 'bayou', feedbackText: feedback, conversationIndex: index })
    expect(withIndex.conversations[0]).toMatchObject({ provider: 'codex', via: 'transcript', title: 'Bayou' })
    expect(withIndex.conversations.some(item => item.sessionId === 'other')).toBe(false)
  })

  it('renders a dated brief and clips long text with an honest count', () => {
    const long = feedback + entry('12 October 2026, 09:00:00 +0200', 'Prompt', null, 'x'.repeat(50))
    const markdown = renderResume(buildResume({ projectId: 'bayou', feedbackText: long, rulesText: '- r1\n- r2\n', settings: { maxChars: 10 } }), { feedbackPath: '/m/FEEDBACK.md', rulesPath: '/m/Rules.md', generatedDate: '13 October 2026 at 13:40' })
    expect(markdown).toContain('(2 rules)')
    expect(markdown).toContain('[... 40 more characters in FEEDBACK.md]')
    expect(markdown).toContain('### 12 October 2026, 09:00:00 +0200 · Prompt · manual')
    for (const line of markdown.split('\n').filter(item => item.startsWith('- '))) expect(line).toMatch(/\(13 October 2026 at 13:40\)$/)
    expect(markdown).not.toMatch(/[\u2014\u2013]/)
  })
})
