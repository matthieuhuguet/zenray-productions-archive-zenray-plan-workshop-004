// Fonction serverless Vercel : etat persistant de ZenRayProgress.
// Si un Redis Upstash est branche (integration Vercel Marketplace), on stocke la-bas
// et l'etat suit Matthieu sur tous ses appareils. Sinon on repond proprement et le
// client retombe sur le cache localStorage (toujours fonctionnel, mais par navigateur).
import { Redis } from '@upstash/redis'

const STATE_KEY = 'zenrayprogress:state'

function getRedis() {
  const url = process.env.UPSTASH_REDIS_REST_URL || process.env.KV_REST_API_URL
  const token = process.env.UPSTASH_REDIS_REST_TOKEN || process.env.KV_REST_API_TOKEN
  if (!url || !token) return null
  try { return new Redis({ url, token }) } catch { return null }
}

export default async function handler(req, res) {
  const redis = getRedis()

  if (req.method === 'GET') {
    if (!redis) return res.status(200).json({ state: null, store: 'none' })
    try {
      const state = await redis.get(STATE_KEY)
      return res.status(200).json({ state: state || null, store: 'cloud' })
    } catch {
      return res.status(200).json({ state: null, store: 'error' })
    }
  }

  if (req.method === 'POST') {
    let body = req.body
    if (typeof body === 'string') { try { body = JSON.parse(body) } catch { body = {} } }
    const state = body && body.state
    if (!redis) return res.status(200).json({ ok: true, store: 'none' })
    try {
      if (state) await redis.set(STATE_KEY, state)
      return res.status(200).json({ ok: true, store: 'cloud' })
    } catch {
      return res.status(200).json({ ok: false, store: 'error' })
    }
  }

  res.setHeader('Allow', 'GET, POST')
  return res.status(405).end()
}
