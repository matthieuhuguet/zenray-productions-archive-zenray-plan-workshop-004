// 5 October 2026, 13:44 CEST: context accepts a mapped local path and maintains a small entry point, not a second registry.
import { writeFile } from 'node:fs/promises'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { config, requestAssets } from './BridgeClient.mjs'
import { projectIdFromLocalPath } from '../../src/lib/projectContextIndex.js'

const [action = 'list', target, payload = '{}'] = process.argv.slice(2)
try {
  let projectId = target
  if (action === 'context' && target && (target.includes('/') || target.startsWith('.'))) {
    const { index } = await requestAssets({ action: 'global-index' })
    projectId = projectIdFromLocalPath(index, path.resolve(target))
  }
  const result = await requestAssets({ ...JSON.parse(payload), action, ...(projectId ? { projectId } : {}) })
  if (result.markdown) {
    const workshop = result.mapping?.context?.workshopPath
    if (workshop) {
      const date = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeZone: 'Europe/Paris' }).format(new Date())
      const filename = path.join(workshop, 'Index.md')
      const live = path.join(config.storage.stateDir, 'contexts', projectId + '.md')
      const command = `node ${fileURLToPath(import.meta.url)} context ${projectId}`
      const globalIndex = path.join(config.storage.stateDir, 'GlobalProjectIndex.json')
      const inventory = path.join(config.storage.stateDir, `Project-${projectId}.json`)
      const text = `# Project context entry (${date})\n\nProject ID: ${projectId}. (${date})\n\nRead the current generated context: [project context](<${live}>). (${date})\n\nRefresh it before resuming: ${command}. (${date})\n\nComplete mapping: [global project index](<${globalIndex}>). (${date})\n\nComplete inventory and backup proofs: [project inventory](<${inventory}>). Read inventory.localFiles and backups by stable file ID. (${date})\n\nThe registry resolves sources, documents, conversations and shared dependencies. This file is an entry point; the live context and original documents carry the current facts. Unlinked sources and missing transcripts remain explicit. (${date})\n`
      try { await writeFile(filename, text, { flag: 'wx', mode: 0o600 }) }
      catch (error) { if (error.code !== 'EEXIST') throw error }
      console.log(`Context entry: ${filename}\nLive context: ${live}\n`)
    }
    const locations = result.mapping?.locations || {}
    const conversations = result.mapping?.context?.conversations || []
    console.log('Linked sources: ' + ['tmp', 'memory', 'houdini', 'unreal'].map(namespace => `${namespace}: ${(locations[namespace] || []).length}`).join(', '))
    console.log('Linked conversations: ' + ['claude', 'codex', 'gemini'].map(provider => `${provider}: ${conversations.filter(item => item.provider === provider).length}`).join(', '))
    console.log('Zero means no registered association, not proof that no original exists.\n')
    console.log(result.markdown)
  } else console.log(JSON.stringify(result.project ? { id: result.project.id, sync: result.project.sync, jobs: result.project.jobs } : result.projects ? { projects: result.projects.map(({ id, sync }) => ({ id, sync })) } : result))
} catch (error) { console.error(error.message); process.exitCode = 1 }
