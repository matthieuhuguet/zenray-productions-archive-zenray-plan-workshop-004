// 9 October 2026, 00:37 CEST: project buttons must call the real service plans before changing storage.
import test from 'node:test'
import assert from 'node:assert/strict'
import { runDashboardAction } from './Actions.mjs'

test('loads only files with an exact cloud proof', async () => {
  const calls = []
  const request = async (payload) => {
    calls.push(payload)
    if (payload.action === 'load-plan') return { plan: { entries: [{ id: 'ready', ready: true }, { id: 'local-only', ready: false }] } }
    return { job: { id: 'load-job', state: 'queued', privatePath: '/private/path' } }
  }
  assert.deepEqual(await runDashboardAction('load', 'project-a', request), { action: 'load', projectId: 'project-a', jobId: 'load-job', state: 'queued' })
  assert.deepEqual(calls, [
    { action: 'load-plan', projectId: 'project-a' },
    { action: 'restore', projectId: 'project-a', fileIds: ['ready'] },
  ])
})

test('does not enqueue an unload when any managed copy is blocked', async () => {
  const calls = []
  const request = async (payload) => {
    calls.push(payload)
    if (payload.action === 'status') return { project: { files: [{ id: 'loaded', loadedCopy: true, present: true }] } }
    return { plan: { blockers: [{ id: 'loaded', reason: 'modified' }] } }
  }
  await assert.rejects(runDashboardAction('unload', 'project-a', request), /reste protégée/)
  assert.deepEqual(calls, [
    { action: 'unload-plan', projectId: 'project-a' },
  ])
})

test('queues a cloud backup without exposing the internal job object', async () => {
  const calls = []
  const request = async (payload) => { calls.push(payload); return { job: { id: 'archive-job', state: 'queued', token: 'private' } } }
  assert.deepEqual(await runDashboardAction('archive', 'project-a', request), { action: 'archive', projectId: 'project-a', jobId: 'archive-job', state: 'queued' })
  assert.deepEqual(calls, [{ action: 'archive', projectId: 'project-a' }])
})
