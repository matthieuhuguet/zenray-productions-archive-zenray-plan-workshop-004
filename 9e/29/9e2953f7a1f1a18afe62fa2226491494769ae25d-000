// 23 October 2026: ZenRay Knowledge, every question Matthieu asked and everything his memory answers, searchable by the index mapping.
// Design V5 (B2 folder tab, Liquid Glass): the selected question and its answer are one glass shape, top-aligned on the question.
// FR : la vue Knowledge. Liste des questions à gauche, réponse reliée à droite, recherche par index mapping, nouvelle question vers le moteur.
import React from 'react'
import { KNOWLEDGE } from '../config/knowledge.js'
import { searchIndex } from '../lib/knowledgeIndex.js'
import { askQuestion, loadKnowledge, readInbox, runEngineNow } from './knowledgeData.js'
import { glassTabPath, minPanelHeight } from './glassTab.js'
import './knowledge.css'

const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
const SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
const dateOf = (iso) => { const d = new Date(iso); return Number.isNaN(+d) ? null : d }
const longDate = (iso) => { const d = dateOf(iso); return d ? `${d.getDate()} ${MONTHS[d.getMonth()]} ${d.getFullYear()}` : '' }
const shortDate = (iso) => { const d = dateOf(iso); return d ? `${d.getDate()} ${SHORT[d.getMonth()]}${d.getFullYear() !== new Date().getFullYear() ? ` ${String(d.getFullYear()).slice(2)}` : ''}` : '' }
const hm = (iso) => { const d = dateOf(iso); return d ? `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}` : '' }
// French spacing: a thin no-break space before ? ! : ; so a lone « ? » never wraps.
const fr = (t) => String(t || '').replace(/ ([?!:;])/g, ' $1')
// Numbers stay Anthropic Serif even inside a Sectra title (Typography1.md, 23 October 2026).
const withNums = (text) => fr(text).split(/(\d[\d:.,]*)/).map((part, i) => (i % 2 ? <span key={i} className="num">{part}</span> : part))
const sourceLabel = (s) => (s.kind === 'memory' ? `mémoire, ${s.ref}` : s.kind === 'manual' ? `ajoutée à la main, ${s.ref}` : `conversation ${s.kind}`)

function whenLine(e) {
  if (e.asked?.length > 1) return `Posée ${e.asked.length} fois, dernière le ${longDate(e.lastAt)} à ${hm(e.lastAt)}`
  if (e.asked?.length === 1) return `Posée le ${longDate(e.asked[0])} à ${hm(e.asked[0])}`
  const s = e.src?.[0]
  return `D'après ${sourceLabel(s || {})}${e.firstAt ? `, ${longDate(e.firstAt)}` : ''}`
}

export default function KnowledgeView() {
  const [base, setBase] = React.useState(null)
  const [error, setError] = React.useState(null)
  const [inbox, setInbox] = React.useState([])
  const [query, setQuery] = React.useState('')
  const [current, setCurrent] = React.useState(0)
  const [shown, setShown] = React.useState(KNOWLEDGE.pageSize)
  const [asking, setAsking] = React.useState(false)
  const [runState, setRunState] = React.useState(null) // null | 'sent' | 'off'
  // Under 900 px the answer opens right under its question, so it stays linked on a long thread too.
  const narrowQuery = '(max-width: 900px)'
  const [narrow, setNarrow] = React.useState(() => typeof matchMedia === 'function' && matchMedia(narrowQuery).matches)
  React.useEffect(() => { if (typeof matchMedia !== 'function') return undefined; const m = matchMedia(narrowQuery), on = () => setNarrow(m.matches); m.addEventListener('change', on); return () => m.removeEventListener('change', on) }, [])
  const wrap = React.useRef(null), list = React.useRef(null), panel = React.useRef(null), shape = React.useRef(null), rim = React.useRef(null), rimPath = React.useRef(null)

  React.useEffect(() => {
    let alive = true
    loadKnowledge().then((b) => alive && setBase(b)).catch((e) => alive && setError(e.message))
    readInbox().then((x) => alive && setInbox((x.questions || []).filter((q) => q.status === 'pending')))
    return () => { alive = false }
  }, [])

  const rows = React.useMemo(() => {
    if (!base?.entries) return []
    const q = query.trim()
    const ordered = q ? searchIndex(base.index.map, q, { limit: 2000 }).map((i) => base.entries[i]) : base.entries
    return ordered
  }, [base, query])
  const visible = rows.slice(0, shown)
  const selected = visible[Math.min(current, visible.length - 1)]

  React.useEffect(() => { setCurrent(0); setShown(KNOWLEDGE.pageSize) }, [query])

  // Place the answer on the selected row and draw the single glass shape around both (desktop only).
  const layout = React.useCallback(() => {
    const w = wrap.current, l = list.current, p = panel.current, s = shape.current, r = rim.current
    if (!w || !l || !p || !s) return
    const row = l.querySelector('.zrk-row.on')
    if (!row || getComputedStyle(s).display === 'none') { p.removeAttribute('style'); w.style.minHeight = ''; return }
    const cs = getComputedStyle(w), px = (v) => parseFloat(cs.getPropertyValue(v))
    const R = px('--lg-radius'), rr = Math.min(16, R), f = Math.min(14, R)
    const tabWidth = l.offsetWidth + px('--zrk-gap'), width = w.clientWidth, rowHeight = row.offsetHeight
    const top = row.getBoundingClientRect().top - w.getBoundingClientRect().top
    Object.assign(p.style, { left: `${tabWidth}px`, width: `${width - tabWidth}px`, top: `${top}px`, minHeight: `${minPanelHeight({ rowHeight, R, f })}px` })
    const height = p.offsetHeight
    const d = glassTabPath({ width, rowHeight, tabWidth, height, R, r: rr, f })
    Object.assign(s.style, { top: `${top}px`, left: '0px', width: `${width}px`, height: `${height}px`, clipPath: `path('${d}')` })
    r.setAttribute('width', width); r.setAttribute('height', height); r.setAttribute('viewBox', `0 0 ${width} ${height}`); r.style.top = `${top}px`; r.style.left = '0px'
    rimPath.current.setAttribute('d', d)
    w.style.minHeight = `${Math.max(l.getBoundingClientRect().bottom - w.getBoundingClientRect().top, top + height)}px`
  }, [])
  React.useLayoutEffect(() => { layout() })
  React.useEffect(() => {
    if (!wrap.current) return undefined
    let raf = 0
    const ro = new ResizeObserver(() => { cancelAnimationFrame(raf); raf = requestAnimationFrame(layout) })
    ro.observe(wrap.current)
    document.fonts?.ready.then(layout)
    return () => { ro.disconnect(); cancelAnimationFrame(raf) }
  }, [layout, base])

  async function onAsk() {
    const q = query.trim()
    if (q.length < 6 || asking) return
    setAsking(true)
    try { const item = await askQuestion(q.endsWith('?') ? q : `${q} ?`); setInbox((x) => [item, ...x]) } catch (e) { setError(`question non enregistrée : ${e.message}`) }
    setAsking(false)
  }

  const answer = selected ? (
    <article className="zrk-panel" ref={panel}>
      <div className="when">{withNums(whenLine(selected))}</div>
      <h2 className="zrk-title">{withNums(selected.q)}</h2>
      <div className="a zrk-body">{selected.a.map((p, i) => <p key={i}>{withNums(p)}</p>)}</div>
      <div className="proof zrk-body">Preuve, {sourceLabel(selected.src[0])} : « {fr(selected.src[0].proof)} »</div>
    </article>
  ) : null
  const engine = base?.engine
  const modelDown = engine?.model && engine.model.ok === false
  return (
    <div className="zrk">
      <div className="zrk-bg" style={{ backgroundImage: `url('${KNOWLEDGE.wallpaper}')` }} />
      <div className="zrk-veil" />
      <div className="zrk-wrap" ref={wrap}>
        <div className="zrk-head">
          <form className="zrk-search zrk-glass" onSubmit={(e) => { e.preventDefault(); if (!rows.length) onAsk() }}>
            <input value={query} onChange={(e) => setQuery(e.target.value)} placeholder="Chercher ou poser une question" aria-label="Chercher ou poser une question" />
            {query.trim().length >= 6 && <button type="button" className="zrk-ask" onClick={onAsk} disabled={asking}>{asking ? 'Envoi…' : 'Poser'}</button>}
          </form>
          <div className={`zrk-meta${modelDown || error ? ' warn' : ''}`}>
            {error ? `Erreur : ${error}`
              : !base ? 'Chargement de la base…'
              : base.empty ? 'La base n’est pas encore publiée.'
              : <>{query ? <><span className="num">{rows.length}</span> sur </> : null}<span className="num">{base.entries.length}</span> questions{engine?.lastPass?.finished ? <>, mise à jour le {longDate(engine.lastPass.finished)} à <span className="num">{hm(engine.lastPass.finished)}</span></> : null}{engine?.nextAt ? <>, prochaine à <span className="num">{hm(engine.nextAt)}</span></> : null}{engine?.pending ? <> · <span className="num">{engine.pending}</span> morceaux de mémoire encore à lire</> : null}{modelDown ? ' · lecture IA en pause (modèle indisponible)' : ''} · <button type="button" className="zrk-run" onClick={async () => setRunState((await runEngineNow()) ? 'sent' : 'off')}>{runState === 'sent' ? 'passe lancée' : runState === 'off' ? 'service local éteint' : 'Mettre à jour'}</button></>}
          </div>
        </div>
        <div className="zrk-shape" ref={shape} />
        <svg className="zrk-rim" ref={rim} aria-hidden="true">
          <defs><linearGradient id="zrkRim" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stopColor="#fff" stopOpacity=".62" /><stop offset=".35" stopColor="#fff" stopOpacity=".22" /><stop offset="1" stopColor="#fff" stopOpacity=".12" /></linearGradient></defs>
          <path ref={rimPath} fill="none" stroke="url(#zrkRim)" strokeWidth="1" />
        </svg>
        <div className="zrk-list" ref={list}>
          {inbox.map((item) => (
            <div key={item.id} className="zrk-row zrk-body pending"><span className="d">en attente</span><span>{fr(item.q)}</span></div>
          ))}
          {visible.map((e, i) => (
            <React.Fragment key={e.id}>
              <button type="button" className={`zrk-row zrk-body${e === selected ? ' on' : ''}`} onClick={() => setCurrent(i)}>
                <span className="d num">{shortDate(e.lastAt || e.firstAt)}</span><span>{fr(e.q)}</span>
              </button>
              {narrow && e === selected && answer}
            </React.Fragment>
          ))}
          {base && !base.empty && !rows.length && <div className="zrk-empty">Aucune question ne correspond. « Poser » l’envoie au moteur, qui répond depuis ta mémoire avec une preuve.</div>}
          {rows.length > shown && <button type="button" className="zrk-more" onClick={() => setShown((n) => n + KNOWLEDGE.pageSize)}>Afficher plus (<span className="num">{rows.length - shown}</span>)</button>}
        </div>
        {!narrow && answer}
      </div>
    </div>
  )
}
