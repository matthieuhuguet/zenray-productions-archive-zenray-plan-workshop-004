// CreateUploadTiming.jsx (14 October 2026): the upload comment, progress bar and per-file list at the top of Create, fed by the relay.
// holdReport keeps the last report on screen when the relay answers nothing for a moment, so the banner never blinks.
// FR : le commentaire, la barre et la liste par fichier en haut de Create ; la banniere ne clignote pas.
import React, { useEffect, useRef, useState } from 'react'
import { createActivitySource } from '../../progress/activitySource.js'
import UploadTimingBanner from './UploadTimingBanner.jsx'
import { reportFromActivity, holdReport } from './uploadReport.js'

const CREATE_UPLOAD = { tickMs: 5000, storageKey: 'zr-upload-banner-collapsed' }

// the choice survives a reload; a blocked or empty storage never breaks the banner. FR : le choix survit au rechargement.
const readCollapsed = () => { try { return window.localStorage.getItem(CREATE_UPLOAD.storageKey) === '1' } catch { return false } }
const writeCollapsed = (value) => { try { window.localStorage.setItem(CREATE_UPLOAD.storageKey, value ? '1' : '0') } catch { /* no storage */ } }

export default function CreateUploadTiming() {
  const [live, setLive] = useState(null)
  const [now, setNow] = useState(() => Date.now())
  const memory = useRef(null)
  const [collapsed, setCollapsed] = useState(readCollapsed)
  const toggle = () => setCollapsed((value) => { writeCollapsed(!value); return !value })
  useEffect(() => {
    const source = createActivitySource({ onChange: setLive })
    source.start()
    const timer = setInterval(() => setNow(Date.now()), CREATE_UPLOAD.tickMs)
    return () => { source.stop(); clearInterval(timer) }
  }, [])
  const result = holdReport(memory.current, reportFromActivity(live, now), now)
  memory.current = result.state
  return <UploadTimingBanner report={result.report} held={result.held} collapsed={collapsed} onToggle={toggle} />
}
