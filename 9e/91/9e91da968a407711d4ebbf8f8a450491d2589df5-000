// 5 October 2026: Matthieu's own searches. He pastes a careers page or types keywords on the page; the file `freelance/my-searches.json`
// keeps them (removals are dated, never erased). A recognised board address is read by the engine at every pass; any other address
// stays a link he opens himself. Nothing here ever contacts anyone.
// 7 October 2026: any other public https page is now read too (mode 'index'), generically, with a link kept next to it.
// FR : les recherches de Matthieu. Une adresse de tableau reconnue est lue a chaque passe ; toute autre reste un lien qu'il ouvre lui-meme.
import { isPublicHttpsUrl } from './Robots.mjs'

const BOARD_PATTERNS = [
  { type: 'greenhouse', re: /^https?:\/\/(?:boards|job-boards)(?:\.eu)?\.greenhouse\.io\/([A-Za-z0-9_-]+)/i },
  { type: 'lever', re: /^https?:\/\/jobs(?:\.eu)?\.lever\.co\/([A-Za-z0-9_.-]+)/i },
  { type: 'ashby', re: /^https?:\/\/jobs\.ashbyhq\.com\/([A-Za-z0-9_.%-]+)/i },
  { type: 'smartrecruiters', re: /^https?:\/\/(?:jobs|careers)\.smartrecruiters\.com\/([A-Za-z0-9_-]+)/i },
  { type: 'recruitee', re: /^https?:\/\/([a-z0-9-]+)\.recruitee\.com/i },
  { type: 'breezy', re: /^https?:\/\/([a-z0-9-]+)\.breezy\.hr/i },
]

/** One saved search as the engine will treat it: { mode: 'board' | 'keywords' | 'index' | 'link', type?, board?, query? }. */
export function classifySearch(search) {
  if (search.kind === 'keywords') {
    const query = String(search.keywords || '').trim()
    return query ? { mode: 'keywords', query } : { mode: 'invalid', reason: 'empty keywords' }
  }
  const url = String(search.url || '').trim()
  if (!/^https?:\/\/[^\s]+$/i.test(url)) return { mode: 'invalid', reason: 'not an http address' }
  for (const { type, re } of BOARD_PATTERNS) {
    const match = url.match(re)
    if (match) return { mode: 'board', type, board: decodeURIComponent(match[1]) }
  }
  return isPublicHttpsUrl(url) ? { mode: 'index', url } : { mode: 'link', url }
}

/** The config the pass runs with: the saved boards and keywords added on top, the original object untouched. */
export function applySearches(config, file) {
  const searches = (Array.isArray(file?.searches) ? file.searches : []).filter((search) => search && search.id && !search.removedAt)
  const sources = JSON.parse(JSON.stringify(config.sources))
  const links = []
  const status = []
  const indexPages = []
  for (const search of searches) {
    const verdict = classifySearch(search)
    const label = String(search.label || verdict.board || verdict.query || verdict.url || '').slice(0, 80)
    if (verdict.mode === 'board') {
      const block = sources[verdict.type]
      if (block && block.enabled !== false && !block.boards[verdict.board]) block.boards[verdict.board] = label
      status.push({ id: search.id, label, mode: 'board', source: `${verdict.type}:${verdict.board}` })
    } else if (verdict.mode === 'keywords') {
      const add = (list, value) => { if (Array.isArray(list) && !list.includes(value)) list.push(value) }
      add(sources.gamesindustry?.queries, verdict.query); add(sources.remotive?.queries, verdict.query); add(sources.jobicy?.tags, verdict.query)
      links.push({ board: 'Mes recherches', label: `${label} (LinkedIn)`, url: `https://www.linkedin.com/jobs/search/?keywords=${encodeURIComponent(verdict.query)}&f_TPR=r86400&sortBy=DD` })
      status.push({ id: search.id, label, mode: 'keywords' })
    } else if (verdict.mode === 'index') {
      indexPages.push({ id: search.id, label, url: verdict.url })
      links.push({ board: 'Mes recherches', label, url: verdict.url })
      status.push({ id: search.id, label, mode: 'index' })
    } else if (verdict.mode === 'link') {
      links.push({ board: 'Mes recherches', label, url: verdict.url })
      status.push({ id: search.id, label, mode: 'link' })
    } else status.push({ id: search.id, label, mode: 'invalid', reason: verdict.reason })
  }
  return { config: { ...config, sources }, links, status, indexPages }
}
