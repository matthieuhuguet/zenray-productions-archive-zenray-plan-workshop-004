// 6 October 2026: the everyday batch starts with three distinct offers and preserves larger explicit choices.
import React from 'react'
import { afterEach, expect, it, vi } from 'vitest'
import { cleanup, fireEvent, render, screen } from '@testing-library/react'
import FreelanceBatch from './FreelanceBatch.jsx'
const t = { border: 'gray', surface: 'transparent', textPrimary: 'black', textSecondary: 'gray', bg: 'white' }
const studios = Array.from({ length: 6 }, (_, index) => ({ id: String(index), name: `Studio ${index}`, role: 'Technical Artist', status: 'to_contact', messages: [], engine: { score: 90 - index, tier: 'high', kind: 'offer' } }))
const props = { t, studios, today: '2026-10-06', open: true, onToggle: vi.fn(), onOpen: vi.fn(), onChange: vi.fn() }
afterEach(() => { cleanup(); localStorage.clear() })
it('starts with three pastel offers even when the former preference was eight', () => {
  localStorage.setItem('zr:freelance:batchSize', '8')
  render(<FreelanceBatch {...props} />)
  expect(screen.getByRole('button', { name: '3' })).toHaveAttribute('aria-pressed', 'true')
  const letters = screen.getAllByRole('button', { name: 'Lettre' })
  expect(letters).toHaveLength(3)
  expect(new Set(letters.map(button => button.parentElement.style.borderLeftColor)).size).toBe(3)
  fireEvent.click(letters[0]); expect(props.onOpen).toHaveBeenCalledWith('0')
})
it('retains larger batches as an explicit persisted choice', () => {
  const view = render(<FreelanceBatch {...props} />)
  fireEvent.click(screen.getByRole('button', { name: '5' }))
  expect(screen.getAllByRole('button', { name: 'Lettre' })).toHaveLength(5)
  view.unmount(); render(<FreelanceBatch {...props} />)
  expect(screen.getByRole('button', { name: '5' })).toHaveAttribute('aria-pressed', 'true')
})

// 14 October 2026: a prospecting session opens the whole batch as tabs through the local service and can record it in one go.
it('offers 10, 20 and 50 and opens the whole batch through the local service', async () => {
  const openLinks = vi.fn().mockResolvedValue({ opened: 3, skipped: [] })
  const many = Array.from({ length: 24 }, (_, index) => ({ id: `s${index}`, name: `Studio ${index}`, role: 'Technical Artist', status: 'to_contact', messages: [],
    engine: { score: 90 - (index % 40), tier: 'high', kind: 'offer', firstSeenAt: '2026-10-06', applyUrl: `https://jobs.example/${index}` } }))
  render(<FreelanceBatch {...props} studios={many} bridge={{ openLinks }} />)
  expect(['10', '20', '50'].every((name) => screen.queryByRole('button', { name }))).toBe(true)
  fireEvent.click(screen.getByRole('button', { name: /Ouvrir les 3 pages/ }))
  await Promise.resolve(); await Promise.resolve()
  expect(openLinks).toHaveBeenCalledWith(['https://jobs.example/0', 'https://jobs.example/1', 'https://jobs.example/2'])
  expect(await screen.findByRole('status')).toHaveTextContent('3 onglets ouverts')
})
it('records the whole batch only after a second confirming click', async () => {
  const onChange = vi.fn().mockResolvedValue(undefined)
  render(<FreelanceBatch {...props} onChange={onChange} />)
  fireEvent.click(screen.getByRole('button', { name: 'Tout marquer fait' }))
  expect(onChange).not.toHaveBeenCalled()
  fireEvent.click(screen.getByRole('button', { name: /Confirmer : 3 faites/ }))
  await vi.waitFor(() => expect(onChange).toHaveBeenCalledTimes(3))
})

// 16 October 2026: "Préparer N candidatures" starts ZenRay Apply through the local service, shows ready / blocked, and dates only what Matthieu confirms he sent.
it('starts ZenRay Apply for the chosen size and shows the ready and blocked pages', async () => {
  const run = { pages: 2, ready: 1, blocked: 1, totalSeconds: 4.2, items: [{ id: '0', studio: 'Studio 0', phase: 'ready', note: '8 filled, CV attached' }, { id: '1', studio: 'Studio 1', phase: 'blocked', note: 'bot wall (not bypassed)' }] }
  const bridge = { applyStatus: vi.fn().mockResolvedValueOnce({ running: false }).mockResolvedValue({ running: false, run }), applyStart: vi.fn().mockResolvedValue({ started: true }), applyOpen: vi.fn().mockResolvedValue({ opened: true }) }
  render(<FreelanceBatch {...props} bridge={bridge} />)
  fireEvent.click(screen.getByRole('button', { name: '5' }))
  fireEvent.click(await screen.findByRole('button', { name: 'Préparer 5 candidatures' }))
  await vi.waitFor(() => expect(bridge.applyStart).toHaveBeenCalledWith(5))
  expect(await screen.findByText('bot wall (not bypassed)')).toBeTruthy()
  fireEvent.click(screen.getByRole('button', { name: /Ouvrir les 1 prêtes/ }))
  await vi.waitFor(() => expect(bridge.applyOpen).toHaveBeenCalled())
})
it('records the ready pages as done only after confirmation, and never one that is already contacted', async () => {
  const run = { pages: 2, ready: 2, blocked: 0, totalSeconds: 3, items: [{ id: '0', studio: 'Studio 0', phase: 'ready', note: 'ok' }, { id: '1', studio: 'Studio 1', phase: 'ready', note: 'ok' }] }
  const onChange = vi.fn().mockResolvedValue(undefined)
  const list = studios.map((entry) => (entry.id === '1' ? { ...entry, status: 'contacted' } : entry))
  render(<FreelanceBatch {...props} studios={list} onChange={onChange} bridge={{ applyStatus: vi.fn().mockResolvedValue({ running: false, run }), applyStart: vi.fn(), applyOpen: vi.fn() }} />)
  fireEvent.click(await screen.findByRole('button', { name: 'J’ai envoyé les prêtes' }))
  expect(onChange).not.toHaveBeenCalled()
  fireEvent.click(screen.getByRole('button', { name: /Confirmer : 2 envoyées/ }))
  await vi.waitFor(() => expect(onChange).toHaveBeenCalledTimes(1))
})
it('says so when the local service cannot be reached', async () => {
  const bridge = { applyStatus: vi.fn().mockRejectedValue(new Error('down')), applyStart: vi.fn().mockRejectedValue(new Error('Le service local est indisponible.')), applyOpen: vi.fn() }
  render(<FreelanceBatch {...props} bridge={bridge} />)
  expect(await screen.findByText(/Service local éteint/)).toBeTruthy()
  fireEvent.click(screen.getByRole('button', { name: 'Préparer 3 candidatures' }))
  expect(await screen.findByText('Le service local est indisponible.')).toBeTruthy()
})
