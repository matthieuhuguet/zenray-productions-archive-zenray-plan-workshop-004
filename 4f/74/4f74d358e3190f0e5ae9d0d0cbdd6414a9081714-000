#!/usr/bin/env node
import { mkdir, link } from 'node:fs/promises'
import { readFileSync } from 'node:fs'
import path from 'node:path'

const [reportPath, stageRoot] = process.argv.slice(2)
if (!reportPath || !stageRoot) throw new Error('usage: prepare-dji-purge-candidates.mjs <audit.json> <stage-root>')
const report = JSON.parse(readFileSync(reportPath, 'utf8'))
const keep = new Set((process.env.ZR_STATUSES || 'ambiguous_hash,ambiguous_name,not_found').split(','))
const items = report.items.filter((item) => keep.has(item.status))
for (const item of items) {
  const dst = path.join(stageRoot, item.root.split('/').at(-1), item.relative)
  await mkdir(path.dirname(dst), { recursive: true })
  await link(item.file, dst)
}
const bytes = items.reduce((sum, item) => sum + item.size, 0)
console.log(`${items.length} hard links · ${(bytes / 1024 ** 3).toFixed(2)} GiB · source untouched`)
