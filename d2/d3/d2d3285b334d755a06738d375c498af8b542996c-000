// 12 October 2026: after a refusal, the mail that asks the studio what did not work. It is written from the studio's own data,
// he edits it, copies it, and marks it sent when HE sends it. Nothing here ever sends anything.
// FR : apres un refus, le mail qui demande au studio ce qui n'a pas marche. Il est ecrit depuis les donnees du studio,
// il l'edite, le copie et le marque envoye quand c'est LUI qui l'envoie. Rien n'est jamais envoye d'ici.
import React, { useEffect, useMemo, useState } from 'react'
import { notify } from '../Notifications.jsx'
import { copyBundle, mailtoUrl } from '../../lib/freelanceEngineModel.js'
import { readableDate } from '../../lib/freelanceStudios.js'
import { FEEDBACK_LANGS, FEEDBACK_SENT_FIELD, buildFeedbackRequest, canRequestFeedback, feedbackLanguage, refusalDate } from '../../lib/freelanceFeedbackRequest.js'
import { Button, GlassPill, P, SectionTitle, glassStyle, textareaStyle } from './ui.jsx'

const copy = async (text, label) => {
  try { await navigator.clipboard.writeText(text); notify({ title: `${label} copié`, body: 'Prêt à coller.' }) }
  catch { notify({ title: 'Copie impossible', body: 'Le navigateur refuse l’accès au presse-papiers.' }) }
}

/**
 * 12 October 2026: the same mail, one click from the list. The card of a refusal carries its own copy button, so the text is
 * never hidden behind an opened studio. Language toggle included; editing and "marked sent" stay in the studio's own panel.
 * FR : le meme mail, a un clic de la liste. La carte d'un refus porte son propre bouton, le texte n'est jamais cache derriere
 * une fiche ouverte. Les modifications et « marquer envoye » restent dans le panneau de la fiche.
 */
export function FeedbackRequestShortcut({ t, studio, onOpen }) {
  const [lang, setLang] = useState(feedbackLanguage(studio))
  if (!canRequestFeedback(studio)) return null
  const sentAt = studio[FEEDBACK_SENT_FIELD] || ''
  const mail = buildFeedbackRequest({ studio, lang })
  return (
    <div role="group" aria-label={`Demande de retour : ${studio.name}`}
      style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center', padding: '8px 10px', border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface }}>
      <Button t={t} small primary onClick={() => copy(mail.text, 'Mail')} title="Copie le mail de demande de retour, prêt à coller">Copier le mail</Button>
      <Button t={t} small onClick={() => copy(copyBundle({ subject: mail.subject, text: mail.text }), 'Objet et mail')}>Copier objet + mail</Button>
      {FEEDBACK_LANGS.map((code) => <GlassPill key={code} t={t} onClick={() => setLang(code)} active={lang === code}>{code.toUpperCase()}</GlassPill>)}
      <span style={{ flex: 1 }} />
      <span style={{ fontFamily: P.sans, fontSize: 12, color: t.textSecondary }}>{sentAt ? `envoyé le ${readableDate(sentAt)}` : 'pas encore envoyé'}</span>
      <Button t={t} small onClick={onOpen} title="Ouvre la fiche : modifier le texte, le marquer envoyé">Ouvrir la fiche</Button>
    </div>
  )
}

export default function FreelanceFeedbackRequest({ t, studio, onSent }) {
  const [lang, setLang] = useState(feedbackLanguage(studio))
  const generated = useMemo(() => buildFeedbackRequest({ studio, lang }), [studio.id, studio.name, studio.role, lang])
  const [draft, setDraft] = useState({ subject: generated.subject, text: generated.text })
  useEffect(() => { setLang(feedbackLanguage(studio)) }, [studio.id])
  useEffect(() => { setDraft({ subject: generated.subject, text: generated.text }) }, [generated.subject, generated.text])

  if (!canRequestFeedback(studio)) return null

  const known = studio.engine || {}
  const sentAt = studio[FEEDBACK_SENT_FIELD] || ''
  const refusedAt = refusalDate(studio)
  const emails = known.contactEmails || []
  const mailto = mailtoUrl({ to: emails[0], subject: draft.subject, body: draft.text })
  const edited = draft.subject !== generated.subject || draft.text !== generated.text
  const note = { fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary, lineHeight: 1.5, margin: '8px 0 0' }
  const box = { border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, padding: P.cardPadding, marginBottom: 24 }

  return (
    <section aria-label="Demander un retour" style={box}>
      <SectionTitle t={t} title="Demander un retour" count={sentAt ? `envoyé le ${readableDate(sentAt)}` : ''} />
      <p style={{ ...note, margin: '0 0 14px' }}>
        {refusedAt ? `Refus reçu le ${readableDate(refusedAt)}. ` : 'Refus reçu. '}
        Ce mail pose deux questions courtes pour comprendre ce qui n’a pas marché. Il se copie tel quel : réponds au mail du studio, ou utilise leur page carrières si aucune adresse n’est publiée.
      </p>

      <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center', marginBottom: 14 }}>
        <Button t={t} primary onClick={() => copy(draft.text, 'Mail')}>Copier le mail</Button>
        <Button t={t} onClick={() => copy(copyBundle({ subject: draft.subject, text: draft.text }), 'Objet et mail')}>Copier objet + mail</Button>
        {mailto && <a href={mailto} style={{ ...glassStyle(t), textDecoration: 'none' }}>Ouvrir dans Mail</a>}
        {known.careersUrl && <a href={known.careersUrl} target="_blank" rel="noreferrer" style={{ ...glassStyle(t), textDecoration: 'none' }}>Page carrières ↗</a>}
        <span style={{ flex: 1 }} />
        {FEEDBACK_LANGS.map((code) => <GlassPill key={code} t={t} onClick={() => setLang(code)} active={lang === code}>{code.toUpperCase()}</GlassPill>)}
      </div>

      <label style={{ display: 'block', fontFamily: P.sans, fontSize: 12, color: t.textSecondary, margin: '0 0 4px' }} htmlFor={`feedback-subject-${studio.id}`}>Objet</label>
      <input id={`feedback-subject-${studio.id}`} value={draft.subject} onChange={(e) => setDraft({ ...draft, subject: e.target.value })}
        style={{ ...textareaStyle(t), resize: 'none', maxWidth: P.letterWidth, display: 'block', marginBottom: 12 }} />
      <label style={{ display: 'block', fontFamily: P.sans, fontSize: 12, color: t.textSecondary, margin: '0 0 4px' }} htmlFor={`feedback-text-${studio.id}`}>Mail</label>
      <textarea id={`feedback-text-${studio.id}`} value={draft.text} onChange={(e) => setDraft({ ...draft, text: e.target.value })}
        style={{ ...textareaStyle(t), maxWidth: P.letterWidth, minHeight: 300, lineHeight: P.letterLines, fontSize: 13.5, display: 'block' }} />

      <div style={{ display: 'flex', gap: 8, alignItems: 'center', flexWrap: 'wrap', margin: '12px 0 4px' }}>
        <Button t={t} onClick={() => setDraft({ subject: generated.subject, text: generated.text })} disabled={!edited} title="Repart du texte écrit automatiquement">Revenir au texte d’origine</Button>
        <span style={{ flex: 1 }} />
        <Button t={t} primary disabled={!draft.text.trim() || Boolean(sentAt)} onClick={() => onSent({ text: draft.text.trim(), channel: 'mail' })}
          title="Garde le texte exact avec sa date dans les messages envoyés">{sentAt ? 'Déjà marqué envoyé' : 'Marquer comme envoyé'}</Button>
      </div>
      <p style={note}>Le texte ne dit rien que ton CV ne dise déjà : il remercie, pose deux questions et propose de rester dans leur vivier.</p>
    </section>
  )
}
