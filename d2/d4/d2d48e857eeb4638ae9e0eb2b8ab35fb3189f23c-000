// 7 October 2026, 12:00 CEST: install one native app without modifying the Assets daemon.
import { mkdir, writeFile, readFile, access } from 'node:fs/promises'
import { execFileSync } from 'node:child_process'
import { fileURLToPath } from 'node:url'
import path from 'node:path'
const root = path.dirname(fileURLToPath(import.meta.url))
const destination = path.join(process.env.HOME, 'Applications/ZenRay Assets.app')
const contents = path.join(destination,'Contents')
try {
 await access(path.join(contents,'Info.plist'))
 const identity = execFileSync('plutil',['-extract','CFBundleIdentifier','raw',path.join(contents,'Info.plist')],{encoding:'utf8'}).trim()
 if (identity !== 'com.zenray.assets.dashboard') throw new Error('Refusing to overwrite an unrelated application')
} catch (error) { if (error.code !== 'ENOENT') throw error }
await mkdir(path.join(contents,'MacOS'),{recursive:true}); await mkdir(path.join(contents,'Resources'),{recursive:true})
execFileSync('xcrun',['swiftc',path.join(root,'main.swift'),'-o',path.join(contents,'MacOS/ZenRayAssets'),'-framework','AppKit'],{stdio:'inherit'})
// 8 October 2026, 18:34 CEST: let the named menu control size itself so its label stays visible.
// 8 October 2026, 19:46 CEST: keep the idle panel close to its single status line.
// 9 October 2026, 00:41 CEST: keep live rates responsive and give the project bricks room to read.
await writeFile(path.join(contents,'Resources/Settings.json'),JSON.stringify({node:process.execPath,adapter:path.join(root,'Adapter.mjs'),activeInterval:2,idleInterval:20,fontName:'InterVariable',serifFontName:'AnthropicSerif-Regular',width:420,height:560,minimumHeight:64,fontSize:13,childTimeout:35},null,2))
await writeFile(path.join(contents,'Info.plist'),`<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict><key>CFBundleExecutable</key><string>ZenRayAssets</string><key>CFBundleIdentifier</key><string>com.zenray.assets.dashboard</string><key>CFBundleName</key><string>ZenRay Assets</string><key>CFBundleVersion</key><string>1</string><key>LSUIElement</key><true/></dict></plist>`)
execFileSync('codesign',['--force','--sign','-',destination],{stdio:'inherit'})
console.log(JSON.stringify({installed:destination,settings:JSON.parse(await readFile(path.join(contents,'Resources/Settings.json'),'utf8'))}))

const label = 'com.zenray.assets.dashboard'
const launchAgent = path.join(process.env.HOME,'Library/LaunchAgents',label + '.plist')
const executable = path.join(contents,'MacOS/ZenRayAssets')
const escapeXML = value => value.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;')
await mkdir(path.dirname(launchAgent),{recursive:true})
// 8 October 2026, 17:47 CEST: relaunch unexpected exits while preserving the user's normal Quit action.
await writeFile(launchAgent,`<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict><key>Label</key><string>${label}</string><key>ProgramArguments</key><array><string>${escapeXML(executable)}</string></array><key>RunAtLoad</key><true/><key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict></dict></plist>`,{mode:0o600})
execFileSync('plutil',['-lint',launchAgent],{stdio:'inherit'})
console.log(JSON.stringify({launchAgent,activation:'RunAtLoad; relaunch after unexpected exit'}))
