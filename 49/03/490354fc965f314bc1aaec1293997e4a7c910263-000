// 12 October 2026: the data model of the Motion Design tab, green and red cases.
import { describe, expect, it } from 'vitest'
import {
  applyChip, buildIterationPayload, cardsOf, changedOverrides, filterChips, formatDuration, formatFidelity,
  isMotionCatalogue, parameterCategories, versionRows,
} from './motionCatalogue.js'

const POSTER = 'https://cdn.jsdelivr.net/gh/matthieuhuguet/zenrayshards-motion-aaaaaaaaaaaa@0123456/zrmd-0001/v008-16x9/poster.jpg'
const CLOUD = {
  schemaVersion: 1, kind: 'zenray-motion-catalogue', updatedAt: '2026-10-12T09:00:00Z', motionCount: 2,
  motions: [
    { id: 'zrmd-0001', title: 'Caption scale-settle', zmotion: 'pages/ZenRayMotionDesign/zrmd-0001/zrmd-0001.zmotion.json', tags: ['caption', 'shine'], aspects: ['16x9'], status: 'iterating', versionCount: 8,
      latest: { version: 'V_008', media: 'pages/ZenRayMotionDesign/zrmd-0001/versions/zrmd-0001-v008-16x9.media.json', poster: POSTER, durationSec: 1.35, fidelity: { overall: 0.9572, weakest: 'animation' } } },
    { id: 'zrmd-0002', title: 'Orb ignition', zmotion: 'pages/ZenRayMotionDesign/zrmd-0002/zrmd-0002.zmotion.json', tags: ['orb'], aspects: ['16x9', '9x16'], status: 'validated', versionCount: 2,
      latest: { version: 'V_002', media: 'm2', poster: POSTER, durationSec: 68.05, fidelity: { overall: 0.993 } } },
  ],
}

describe('motion catalogue model', () => {
  it('validates both catalogue shapes and refuses anything else', () => {
    expect(isMotionCatalogue(CLOUD)).toBe(true)
    expect(isMotionCatalogue({ motions: [] })).toBe(false)
    expect(cardsOf({ kind: 'other' })).toEqual([])
    const cards = cardsOf(CLOUD)
    expect(cards.map((c) => c.id)).toEqual(['zrmd-0001', 'zrmd-0002'])
    expect(cards[0]).toMatchObject({ version: 'V_008', fidelity: 0.9572, durationSec: 1.35, source: 'cloud' })
    const local = cardsOf({ schema: 'zrmd/catalog@1', motions: [{ id: 'a', title: 'A', latest: 'V_003', versions: ['V_001', 'V_002', 'V_003'], score: 0.991, duration: 1.2, posterUrl: 'http://127.0.0.1:3102/x' }] })
    expect(local[0]).toMatchObject({ source: 'local', versionCount: 3, status: 'validated' })
  })

  it('formats durations and scores with serif numbers in mind', () => {
    expect(formatDuration(68.05)).toBe('1:08')
    expect(formatDuration(1.35)).toBe('0:01')
    expect(formatDuration(3725)).toBe('1:02:05')
    expect(formatDuration(null)).toBe('')
    expect(formatFidelity(0.9572)).toBe('95,7 %')
    expect(formatFidelity(0.9572, 'en')).toBe('95.7 %')
    expect(formatFidelity(undefined)).toBe('')
  })

  it('derives chips from the data present and filters with them', () => {
    const cards = cardsOf(CLOUD)
    const keys = filterChips(cards).map((c) => c.key)
    expect(keys).toEqual(['all', 'validated', 'iterating', 'tag:caption', 'tag:orb', 'tag:shine', 'aspect:16x9', 'aspect:9x16'])
    expect(applyChip(cards, 'validated').map((c) => c.id)).toEqual(['zrmd-0002'])
    expect(applyChip(cards, 'tag:shine').map((c) => c.id)).toEqual(['zrmd-0001'])
    expect(applyChip(cards, 'aspect:9x16').map((c) => c.id)).toEqual(['zrmd-0002'])
    expect(applyChip(cards, 'pending')).toEqual([])
    expect(filterChips([]).map((c) => c.key)).toEqual(['all'])
  })

  it('keeps at most 8 parameters per category and sends only what changed', () => {
    const many = { layout: Array.from({ length: 12 }, (_, i) => ({ key: `k${i}`, kind: 'number', value: i, min: 0, max: 99, step: 1 })), bad: [{ key: 'x', kind: 'script' }] }
    const cats = parameterCategories(many)
    expect(cats.layout).toHaveLength(8)
    expect(cats.bad).toBeUndefined()
    const colour = parameterCategories({ colour: [{ key: 'c', kind: 'color', value: '#ABCDEF' }], layout: [{ key: 'k', kind: 'number', value: 1 }] })
    expect(changedOverrides(colour, { c: '#abcdef', k: 1 })).toEqual({})
    expect(changedOverrides(colour, { c: '#112233', k: '2.5' })).toEqual({ c: '#112233', k: 2.5 })
  })

  it('builds iteration payloads and refuses empty ones', () => {
    expect(buildIterationPayload({ mode: 'params', motionId: 'm', baseVersion: 'V_002', overrides: { k: 1 } })).toEqual({ mode: 'params', motionId: 'm', baseVersion: 'V_002', overrides: { k: 1 } })
    expect(buildIterationPayload({ mode: 'format', motionId: 'm', formats: ['9x16'], fit: 'cover' })).toMatchObject({ formats: ['9x16'], fit: 'cover' })
    expect(() => buildIterationPayload({ mode: 'params', motionId: 'm', overrides: {} })).toThrow('Aucun réglage')
    expect(() => buildIterationPayload({ mode: 'instruction', motionId: 'm', instructions: '  ' })).toThrow('Consigne vide')
    expect(() => buildIterationPayload({ mode: 'shell', motionId: 'm' })).toThrow('mode inconnu')
  })

  it('lists versions newest first with numbers only', () => {
    const rows = versionRows({ versions: [{ version: 'V_001', state: 'published', fidelity: { overall: 0.9 } }, { version: 'V_002', parent: 'V_001', fidelity: { overall: 0.95 }, renders: [{ media: 'm', poster: 'p', durationSec: 1 }] }, { version: 'bad' }] })
    expect(rows.map((r) => r.version)).toEqual(['V_002', 'V_001'])
    expect(rows[0]).toMatchObject({ parent: 'V_001', fidelity: 0.95, media: 'm' })
  })
})
