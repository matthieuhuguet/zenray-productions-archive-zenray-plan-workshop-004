const COL = { todo: '#9b9082', doing: PALETTE.primary, done: PALETTE.green }
const LABEL = { todo: 'À faire', doing: 'En cours', done: 'Fait' }

export default function BuildBoard({ t }) {
  const [items, setItems] = useState(null)
  const [sha, setSha] = useState(null)
  const [status, setStatus] = useState('')
  const [nt, setNt] = useState('')
  const [nsec, setNsec] = useState('Repos consultables (998)')

  useEffect(() => { (async () => {
    const j = await fetch(`/api/page?action=read&path=${PATH}`, { cache: 'no-store' }).then((r) => r.json()).catch(() => null)
    if (j && j.markdown && !j.missing) { setSha(j.sha); try { setItems(JSON.parse(j.markdown).items || SEED) } catch { setItems(SEED) } }
    else { setItems(SEED); persist(SEED, null) }
  })() }, [])

  async function persist(list, curSha) {
    setStatus('…')
    const body = JSON.stringify({ items: list, updatedAt: Date.now() }, null, 1)
    const j = await fetch('/api/page', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ action: 'save', path: PATH, markdown: body, sha: curSha === undefined ? sha : curSha }) }).then((r) => r.json()).catch(() => null)
    if (j && j.ok) { setSha(j.sha); setStatus('enregistré ✓') } else setStatus('erreur')
  }
  const cycle = (id) => { const list = items.map((x) => x.id === id ? { ...x, status: nextStatus(x.status) } : x); setItems(list); persist(list) }
  const del = (id) => { const list = items.filter((x) => x.id !== id); setItems(list); persist(list) }
  const add = () => { if (!nt.trim()) return; const list = [...items, { id: 't' + Date.now(), title: nt.trim(), status: 'todo', section: nsec }]; setItems(list); setNt(''); persist(list) }

  if (!items) return <div style={{ color: t.textSecondary, padding: 20 }}>chargement du chantier…</div>
  const done = items.filter((x) => x.status === 'done').length
  const pct = items.length ? Math.round((100 * done) / items.length) : 0

  return (
    <>
      <SectionLabel t={t}>Roadmap <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', opacity: 0.6 }}>· construction du site en direct · {status}</span></SectionLabel>
      <div style={{ background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: RADII.lg, padding: '20px 22px', marginBottom: 16, boxShadow: SHADOWS.apple }}>
        <div style={{ display: 'flex', alignItems: 'baseline', gap: 14, marginBottom: 10 }}>
          <div style={{ fontFamily: FONTS.sans, fontSize: 40, fontWeight: 700, background: PALETTE.gradient, WebkitBackgroundClip: 'text', backgroundClip: 'text', color: 'transparent' }}>{pct}%</div>
          <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', color: t.textSecondary }}>{done} / {items.length} tâches faites</div>
        </div>
        <div style={{ height: 10, borderRadius: 99, background: t.border, overflow: 'hidden' }}><div style={{ height: '100%', width: `${pct}%`, borderRadius: 99, background: PALETTE.gradient, transition: 'width .5s' }} /></div>
      </div>

      <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', marginBottom: 18 }}>
        <input value={nt} onChange={(e) => setNt(e.target.value)} onKeyDown={(e) => { if (e.key === 'Enter') add() }} placeholder="Nouvelle tâche…"
          style={{ flex: 1, minWidth: 200, background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: '9px 12px', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-lg)', outline: 'none' }} />
        <select value={nsec} onChange={(e) => setNsec(e.target.value)} style={{ background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: '9px 10px', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)' }}>
          {SECTIONS.map((s) => <option key={s} value={s}>{s}</option>)}
        </select>
        <button onClick={add} style={{ background: PALETTE.primary, color: '#fff', border: 'none', borderRadius: RADII.sm, padding: '9px 16px', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-lg)' }}>Ajouter</button>
      </div>

      {SECTIONS.map((sec) => {
        const list = items.filter((x) => x.section === sec)
        if (!list.length) return null
        const d = list.filter((x) => x.status === 'done').length
        return (
          <div key={sec} style={{ marginBottom: 18 }}>
            <div style={{ fontFamily: FONTS.serif, fontSize: 'var(--zr-ui-3xl)', fontWeight: 600, marginBottom: 8 }}>{sec} <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary }}>{d}/{list.length}</span></div>
            <div style={{ background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: RADII.md }}>
              {list.map((x, i) => (
                <div key={x.id} style={{ display: 'flex', alignItems: 'center', gap: 12, padding: '10px 14px', borderBottom: i < list.length - 1 ? `1px solid ${t.border}` : 'none' }}>
                  <button onClick={() => cycle(x.id)} title="changer le statut" style={{ flex: '0 0 auto', cursor: 'pointer', background: 'transparent', border: `1px solid ${COL[x.status]}`, color: COL[x.status], borderRadius: 99, padding: '2px 10px', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', fontWeight: 700, textTransform: 'uppercase', letterSpacing: 0.5, minWidth: 74 }}>{LABEL[x.status]}</button>
                  <span style={{ flex: 1, fontFamily: FONTS.serif, fontSize: 'var(--zr-ui-lg)', color: x.status === 'done' ? t.textSecondary : t.textPrimary, textDecoration: x.status === 'done' ? 'line-through' : 'none' }}>{x.title}</span>
                  <button onClick={() => del(x.id)} style={{ background: 'none', border: 'none', color: t.textSecondary, cursor: 'pointer', fontSize: 'var(--zr-ui-2xl)', lineHeight: 1 }}>×</button>
                </div>
              ))}
            </div>
          </div>
        )
      })}
    </>
  )
}

function SectionLabel({ t, children }) {
  return <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', textTransform: 'uppercase', letterSpacing: 2, color: t.textSecondary, fontWeight: 700, margin: '0 0 14px' }}>{children}</div>
}
