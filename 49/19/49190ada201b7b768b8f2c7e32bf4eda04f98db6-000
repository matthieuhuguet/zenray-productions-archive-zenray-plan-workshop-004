import { describe, expect, it, vi } from 'vitest'
import { collectSubtreeBlobPaths } from './repoSubtree.js'

const blob = (path) => ({ type: 'blob', path })
const jamais = async () => []

describe('collectSubtreeBlobPaths', () => {
  it('rend les blobs du sous-arbre, en chemins relatifs', async () => {
    const readTreeish = vi.fn(async () => ({ ok: true, truncated: false, tree: [blob('a.img.json'), blob('sous/b.img.json'), { type: 'tree', path: 'sous' }] }))
    const r = await collectSubtreeBlobPaths(readTreeish, jamais, 'pages/Photos/Izu')
    expect(r).toEqual({ paths: ['a.img.json', 'sous/b.img.json'], truncated: false })
    expect(readTreeish).toHaveBeenCalledWith('pages/Photos/Izu')
  })

  it('donne au prédicat le chemin ABSOLU, pas le relatif', async () => {
    const vus = []
    const readTreeish = async () => ({ ok: true, truncated: false, tree: [blob('a.img.json')] })
    await collectSubtreeBlobPaths(readTreeish, jamais, 'pages/Photos', (p) => { vus.push(p); return true })
    expect(vus).toEqual(['pages/Photos/a.img.json'])
  })

  it('filtre par le prédicat', async () => {
    const readTreeish = async () => ({ ok: true, truncated: false, tree: [blob('a.img.json'), blob('b.txt')] })
    const r = await collectSubtreeBlobPaths(readTreeish, jamais, 'pages/X', (p) => p.endsWith('.img.json'))
    expect(r.paths).toEqual(['a.img.json'])
  })

  it('bascule sur contents/ quand le sous-arbre est TRONQUÉ, et rend le même genre de résultat', async () => {
    const readTreeish = async () => ({ ok: true, truncated: true, tree: [blob('vu-a-moitie.img.json')] })
    const readDirContents = vi.fn(async (dir) => (dir === 'pages/X'
      ? [{ type: 'file', path: 'pages/X/a.img.json' }, { type: 'dir', path: 'pages/X/sous' }]
      : [{ type: 'file', path: 'pages/X/sous/b.img.json' }]))
    const r = await collectSubtreeBlobPaths(readTreeish, readDirContents, 'pages/X')
    expect(r.paths.sort()).toEqual(['a.img.json', 'sous/b.img.json'])
    expect(r.truncated).toBe(false)
  })

  it('bascule aussi quand la lecture du sous-arbre ÉCHOUE', async () => {
    const readTreeish = async () => ({ ok: false })
    const readDirContents = async () => [{ type: 'file', path: 'pages/X/a.img.json' }]
    const r = await collectSubtreeBlobPaths(readTreeish, readDirContents, 'pages/X')
    expect(r.paths).toEqual(['a.img.json'])
  })

  it('donne au prédicat le chemin absolu AUSSI dans le repli', async () => {
    const vus = []
    const readTreeish = async () => ({ ok: false })
    const readDirContents = async (dir) => (dir === 'pages/X' ? [{ type: 'file', path: 'pages/X/a.img.json' }] : [])
    await collectSubtreeBlobPaths(readTreeish, readDirContents, 'pages/X', (p) => { vus.push(p); return true })
    expect(vus).toEqual(['pages/X/a.img.json'])
  })

  it('n’entre pas dans un dossier écarté par skipDir', async () => {
    const readTreeish = async () => ({ ok: false })
    const visites = []
    const readDirContents = async (dir) => {
      visites.push(dir)
      return dir === 'pages/X' ? [{ type: 'dir', path: 'pages/X/.zr-resources' }, { type: 'dir', path: 'pages/X/ok' }] : []
    }
    await collectSubtreeBlobPaths(readTreeish, readDirContents, 'pages/X', () => true, (d) => d.endsWith('/.zr-resources'))
    expect(visites).toContain('pages/X/ok')
    expect(visites).not.toContain('pages/X/.zr-resources')
  })

  it('ne rend jamais un dossier vide comme une erreur', async () => {
    const readTreeish = async () => ({ ok: true, truncated: false, tree: [] })
    expect(await collectSubtreeBlobPaths(readTreeish, jamais, 'pages/Vide')).toEqual({ paths: [], truncated: false })
  })

  it('signale truncated quand le repli lui-même n’a pas fini', async () => {
    // Une arborescence qui produit sans fin de nouveaux dossiers : la garde coupe, et on le DIT.
    const readTreeish = async () => ({ ok: false })
    let n = 0
    const readDirContents = async () => [{ type: 'dir', path: `d/${n++}` }, { type: 'dir', path: `d/${n++}` }]
    const r = await collectSubtreeBlobPaths(readTreeish, readDirContents, 'd')
    expect(r.truncated).toBe(true)
  })
})
