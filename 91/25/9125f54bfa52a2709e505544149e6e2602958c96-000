// 07 October 2026: email scanner for matth.huguet@gmail.com responses.
// Scans incoming emails every 6 hours, ignores auto-acknowledgments ("we received your application"),
// matches genuine studio replies to studios in store, and advances status to replied or interview.

import {
  MATTHIEU_EMAIL,
  isAutoAckEmail,
  detectReplyIntent,
  matchStudioFromEmail,
  processIncomingEmail,
  processEmailsBatch,
} from '../../../src/lib/freelanceEmailParser.js'
import { isoDay, englishDay } from './Text.mjs'

export {
  MATTHIEU_EMAIL,
  isAutoAckEmail,
  detectReplyIntent,
  matchStudioFromEmail,
  processIncomingEmail,
  processEmailsBatch,
}

/**
 * Scans a batch of incoming emails against the freelance store studios.
 * Pure function: does not mutate store or studios.
 *
 * @param {Object} store The store object { v, studios }
 * @param {Array} emails Array of email objects
 * @param {Object} [options]
 * @param {Date} [options.now] Current date
 * @returns {{ store: Object, report: Object }}
 */
export function scanStoreEmails(store, emails, { now = new Date() } = {}) {
  const currentStudios = Array.isArray(store?.studios) ? store.studios : []
  const today = isoDay(now)
  const batchResult = processEmailsBatch(emails, currentStudios, today)

  return {
    store: {
      ...store,
      studios: batchResult.studios,
    },
    report: {
      scannedAt: now.toISOString(),
      englishDay: englishDay(now),
      recipient: MATTHIEU_EMAIL,
      processed: batchResult.report.total,
      total: batchResult.report.total,
      ignoredAutoAcks: batchResult.report.ignoredAutoAcks,
      unmatched: batchResult.report.unmatched,
      matchedResponses: batchResult.report.updatedCount,
      updatedCount: batchResult.report.updatedCount,
      updatedStudios: batchResult.report.updatedStudios,
    },
  }
}

/**
 * Creates an EmailScanner instance that coordinates periodic checks (every 6 hours)
 * or manual triggers via software or MCP.
 */
export function createEmailScanner({
  config,
  fetchEmails = async () => [],
  log = () => {},
  now = () => new Date(),
}) {
  const emailAddress = config?.emailScanner?.email || MATTHIEU_EMAIL
  const intervalHours = config?.emailScanner?.intervalHours || 6

  let lastScanAt = null
  let lastReport = null

  async function runScan(store) {
    const stamp = now()
    log(`[EmailScanner] Starting scan for ${emailAddress} at ${stamp.toISOString()}`)
    const emails = await fetchEmails()
    const { store: nextStore, report } = scanStoreEmails(store, emails, { now: stamp })
    lastScanAt = stamp.toISOString()
    lastReport = report

    log(`[EmailScanner] Completed scan: ${report.processed} processed, ${report.ignoredAutoAcks} auto-acks ignored, ${report.matchedResponses} matched`)
    return { store: nextStore, report }
  }

  function getStatus() {
    return {
      email: emailAddress,
      intervalHours,
      lastScanAt,
      lastReport,
    }
  }

  return {
    runScan,
    getStatus,
    emailAddress,
    intervalHours,
  }
}
