import { describe, expect, it } from 'vitest'
import { mergePreviousStateCards, stateCardFromManifest } from './state-index.mjs'

describe("fiches de l'index local", () => {
  it('lit un manifeste chunké et son historique', () => {
    expect(stateCardFromManifest('a.zip', {
      size: 42, sha256: 'chunk-sha', versions: [{ ts: 'premier' }, { ts: 'dernier' }],
    })).toMatchObject({ rel: 'a.zip', taille: 42, sha: 'chunk-sha', versions: 2, premier: 'premier', dernier: 'dernier' })
  })

  it('lit aussi les champs source d’une image streamable', () => {
    expect(stateCardFromManifest('photo.png', {
      clearSize: 84, sourceSha256: 'image-sha', addedAt: 'maintenant', type: 'image',
    }, 'photo.png.img.json')).toMatchObject({ rel: 'photo.png', taille: 84, sha: 'image-sha', versions: 1,
      premier: 'maintenant', dernier: 'maintenant', manifeste: 'photo.png.img.json' })
  })

  it("préserve la fiche récente écrite par l'autre voie", () => {
    const courant = new Map([
      ['pair', { rel: 'pair', sha: 'pair-neuf' }],
      ['impair', { rel: 'impair', sha: 'impair-ancien' }],
    ])
    const fusion = mergePreviousStateCards(courant, [
      { rel: 'pair', sha: 'pair-ancien' },
      { rel: 'impair', sha: 'impair-neuf' },
    ], (rel) => rel === 'pair')
    expect(fusion.get('pair').sha).toBe('pair-neuf')
    expect(fusion.get('impair').sha).toBe('impair-neuf')
  })
})
