// 3 October 2026, 13:20 : The documentation, read live from the zenray-postkit skill through the PostKit server, so the dashboard never
// holds a stale copy. Markdown is rendered with the app's SAFE renderer (raw HTML in a document is escaped, never executed). (3 October 2026)
import React, { useEffect, useMemo, useState } from 'react'
import { safeMarkedParse } from '../safeMarked.js'
import { useQuery } from './usePostKit.js'
import { Card, Empty, ErrorLine } from './ui.jsx'

export default function DocsPanel({ client }) {
  const list = useQuery(client, '/v1/docs')
  const [name, setName] = useState(null)
  const docs = list.data?.docs || []
  useEffect(() => { if (!name && docs.length) setName((docs.find((d) => /Reference/.test(d.name)) || docs[0]).name) }, [docs, name])
  const doc = useQuery(client, name ? `/v1/docs/${name}` : null, { enabled: !!name })
  const html = useMemo(() => (doc.data?.markdown ? safeMarkedParse(doc.data.markdown) : ''), [doc.data])
  return (
    <Card title="Documentation" aside={<select value={name || ''} onChange={(e) => setName(e.target.value)} aria-label="Document">{docs.map((d) => <option key={d.name} value={d.name}>{d.name.replace(/\.md$/, '')}</option>)}</select>}>
      <ErrorLine error={list.error || doc.error} />
      {docs.length === 0 && !list.loading && <Empty>No document found. The server reads them from the zenray-postkit skill (set POSTKIT_DOCS_DIR to move it).</Empty>}
      {html && <article className="zr-pk-doc" dangerouslySetInnerHTML={{ __html: html }} />}
    </Card>
  )
}
