// 2 October 2026, 13:25 CEST: combining local projects preserves legacy archives and distinguishes unknown local state.
import { describe, expect, it } from 'vitest'
import { mergeWorkspaceProjects, workspaceSelection, workspaceSnapshotRequest } from './assetsWorkspaceViewModel.js'

describe('workspace project identity', () => {
  // 3 October 2026, 16:34 CEST: merging must not append newly active projects below older archives.
  it('orders merged projects by real file activity rather than insertion or polling time', () => {
    const result = mergeWorkspaceProjects([{ id: 'older', name: 'Old archive', date: '2026-09-01' }], [
      { id: 'ceramic', name: 'Ceramic', files: [{ mtimeMs: Date.parse('2026-10-02T12:00:00Z') }] },
      { id: 'dictate', name: 'Dictate', files: [{ mtimeMs: Date.parse('2026-10-03T12:00:00Z') }] },
      { id: 'unknown', name: 'Unknown', checkedAt: '2099-01-01', sync: { publishedAt: '2099-01-01' }, files: [{ mtimeMs: NaN }] },
    ])
    expect(result.findIndex((project) => project.id === 'dictate')).toBe(0)
    expect(result.findIndex((project) => project.id === 'ceramic')).toBe(1)
    expect(result.findIndex((project) => project.id === 'unknown')).toBeGreaterThan(result.findIndex((project) => project.id === 'older'))
  })
  it('unites a legacy Louisiana archive with current local sources', () => {
    const paths = ['pages/ZenRayAssets/old/scene.hiplc.file.json']
    const projects = mergeWorkspaceProjects([{id:'old-church',name:'Church',folder:'pages/ZenRayAssets/old'}],
      [{id:'louisiana-bayou',name:'Louisiana Bayou',folder:'pages/ZenRayAssets/louisiana-bayou',legacyProjectIds:['old-church'],files:[{id:'workshop:note.md',name:'note.md',sourceId:'workshop',status:'local-only'}]}],paths)
    expect(projects.some((project) => project.id==='old-church')).toBe(false)
    const files = projects.find((project)=>project.id==='louisiana-bayou').files
    expect(files).toHaveLength(2)
    expect(files.find((file)=>file.contentPath)?.status).toBe('cloud-only')
    expect(files[0].status).toBe('local-only')
  })
  it('does not interpret a legacy cloud file as a local restore selection', () => {
    expect(()=>workspaceSelection([{id:'cloud-file'}])).toThrow('Reliez')
    expect(workspaceSelection([])).toBe(null)
  })
  it('fetches only a validated project snapshot with a fresh CDN read', () => {
    expect(workspaceSnapshotRequest('pages/ZenRayAssets/tiles')).toEqual({ path: 'pages/ZenRayAssets/tiles/.workspace.json', fresh: true })
    expect(() => workspaceSnapshotRequest('pages/ZenRayAssets/../other')).toThrow('Workspace snapshot folder is invalid')
  })
})
