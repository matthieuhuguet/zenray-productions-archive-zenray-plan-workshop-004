#!/bin/bash
# Append la doc ZenRayShards canonique aux 3 .md de mémoire. Économe en tokens : texte écrit UNE fois
# (docs/ZENRAYSHARDS.md), recopié tel quel avec en-tête daté. Idempotent par garde-marqueur.
set -e
SRC="/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/docs/ZENRAYSHARDS.md"
MARK="<!-- ZENRAYSHARDS-2026-07-01 -->"
TARGETS=(
  "/Users/zenray/Create/Build/Memory/PROGRESS.md"
  "/Users/zenray/Create/Build/Memory/Identity/Matthieu1.md"
  "/Users/zenray/.claude/projects/-Users-zenray-Create-Build-Memory/memory/streaming-dash-maxrate-solution.md"
)
for f in "${TARGETS[@]}"; do
  if grep -q "$MARK" "$f" 2>/dev/null; then echo "déjà présent: $f"; continue; fi
  { printf '\n\n%s\n## Feature ZenRayShards (snapshot 2026-07-01)\n\n' "$MARK"; cat "$SRC"; } >> "$f"
  echo "appendé: $f"
done
