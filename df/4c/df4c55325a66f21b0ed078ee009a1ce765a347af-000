// 4 October 2026: an offer keeps the identifier of the 30 September collector, is scored from its text only, and is explained.
import { describe, expect, it } from 'vitest'
import config from './FreelanceConfig.json'
import { buildOffer, classify, engineFromNotes, languageOf, offerId, scoreOffer, skillsOf, yearsRequired } from './lib/Offer.mjs'

const NOW = new Date('2026-10-04T10:00:00+02:00')

describe('offerId', () => {
  it('matches the Python collector, so the 244 earlier records are recognised', () => {
    expect(offerId('https://emploi.afjv.com/emploi-jeux-video/SCOM801-29118')).toBe('job_cfb8c5a22afe54aeb8d7')
    expect(offerId('Ubisoft2:abc123')).toBe('job_32b876a542d5320e05bf')
    expect(offerId('keywords:12345')).toBe('job_52dc5383b2a8466106d7')
  })
})

describe('classify and read', () => {
  it('tells freelance, internship, pool and plain offers apart', () => {
    expect(classify({ title: 'Houdini Artist', contract: 'Freelance ad hoc' })).toMatchObject({ freelance: true, kind: 'offer' })
    expect(classify({ title: 'Technical Artist', contract: 'Non freelance' }).freelance).toBe(false)
    expect(classify({ title: 'Stage Technical Artist', contract: '' })).toMatchObject({ trainee: true, kind: 'internship' })
    expect(classify({ title: 'Technical Artist Talent Pool', contract: '' }).kind).toBe('spontaneous')
    expect(classify({ title: 'Level Designer', contract: 'CDI' }).salaried).toBe(true)
  })
  it('reads skills, years and language from the text', () => {
    expect(skillsOf('We use Houdini and UE5, scripts in Python and VEX.')).toEqual(['Houdini', 'Unreal Engine', 'Python', 'VEX'])
    expect(yearsRequired('5+ years of professional experience or 3 years of Houdini')).toBe(3)
    expect(yearsRequired('no number here')).toBeNull()
    expect(languageOf({ country: 'FR', text: 'Vous rejoindrez notre équipe sur ce poste avec une expérience solide' })).toBe('fr')
    expect(languageOf({ country: 'FR', text: 'Join our team' })).toBe('en')
  })
})

describe('scoreOffer', () => {
  const base = { text: 'Houdini, Unreal Engine and Python pipeline work.', contract: 'Full-time', country: '', workplace: '' }
  it('rewards the exact trade and the real overlap, with reasons', () => {
    const verdict = scoreOffer({ ...base, title: 'Technical Artist' }, config)
    expect(verdict.score).toBeGreaterThanOrEqual(config.relevance.highScore)
    expect(verdict.why.some((line) => line.startsWith('Poste proche du métier'))).toBe(true)
    expect(verdict.skills).toEqual(['Houdini', 'Unreal Engine', 'Python'])
  })
  it('punishes a senior title and a long experience demand, and favours a junior one', () => {
    const plain = scoreOffer({ ...base, title: 'Technical Artist' }, config).score
    const seniorScore = scoreOffer({ ...base, title: 'Senior Technical Artist' }, config).score
    expect(seniorScore).toBeLessThan(plain)
    expect(seniorScore).toBeLessThanOrEqual(config.relevance.seniorScoreCeiling)
    expect(scoreOffer({ ...base, title: 'Technical Artist', text: base.text + ' 8 years of experience required.' }, config).score).toBeLessThan(plain)
    expect(scoreOffer({ ...base, title: 'Junior Technical Artist' }, config).score).toBe(plain + config.relevance.juniorBonus)
  })
  it('stays between 0 and 100', () => {
    const score = scoreOffer({ title: 'Principal Game Designer', text: '12 years of experience.', contract: '', country: '', workplace: '' }, config).score
    expect(score).toBeGreaterThanOrEqual(0)
    expect(score).toBeLessThanOrEqual(100)
  })
  it('prioritizes France (+20) over distant countries like Argentina (0)', () => {
    const frVerdict = scoreOffer({ ...base, title: 'Technical Artist', country: 'FR' }, config)
    const arVerdict = scoreOffer({ ...base, title: 'Technical Artist', country: 'Argentina' }, config)
    expect(frVerdict.score).toBe(arVerdict.score + 20)
    expect(frVerdict.why.some((line) => line.includes('France (+20)'))).toBe(true)
  })
})

describe('buildOffer', () => {
  const listing = { sourceKey: 'afjv', sourceLabel: 'AFJV', evidence: 'AFJV, annonce déposée par le studio', name: 'Studio X', title: 'Technical Artist \u2014 Houdini', url: 'https://emploi.afjv.com/emploi-jeux-video/SCOM801-29118', applyUrl: 'https://emploi.afjv.com/postuler/SCOM801-29118', sourceId: 'https://emploi.afjv.com/emploi-jeux-video/SCOM801-29118', location: 'Lyon (69)', country: 'FR', contract: 'CDI', workplace: 'Voir conditions', published: '2026-10-02', text: '<p>Vous maîtrisez Houdini et Unreal Engine. Contact : jobs@studiox.fr</p>' }
  it('produces a studio record the page already understands, plus an engine block', () => {
    const record = buildOffer(listing, config, { now: NOW })
    expect(record).toMatchObject({ id: 'job_cfb8c5a22afe54aeb8d7', name: 'Studio X', status: 'to_contact', createdAt: '2026-10-04', messages: [], history: [] })
    expect(record.role).toBe('Technical Artist, Houdini')
    expect(record.notes).toContain('Recensement vérifié le 4 October 2026. Source : AFJV, annonce déposée par le studio.')
    expect(record.notes).toContain('Contact public : jobs@studiox.fr.')
    expect(record.notes).not.toMatch(/[\u2014\u2013]/)
    expect(record.engine).toMatchObject({ source: 'afjv', kind: 'offer', freelance: false, contactEmails: ['jobs@studiox.fr'], applyUrl: listing.applyUrl, firstSeenAt: '2026-10-04', closedAt: '' })
    expect(record.engine.score).toBeGreaterThan(0)
  })
  it('takes the studio website from the configuration and keeps the careers page the source gave', () => {
    const record = buildOffer({ ...listing, sourceKey: 'lever:larian', employerUrl: '', careersUrl: 'https://jobs.lever.co/larian' }, { ...config, sites: { 'lever:larian': 'https://larian.com' } }, { now: NOW })
    expect(record.engine).toMatchObject({ employerUrl: 'https://larian.com', careersUrl: 'https://jobs.lever.co/larian' })
    expect(buildOffer({ ...listing, employerUrl: 'https://own.example' }, config, { now: NOW }).engine.employerUrl).toBe('https://own.example')
  })

  it('reads the earlier records back from their notes', () => {
    const notes = 'Recensement vérifié le 30 September 2026. Source : Keywords Studios, catalogue officiel et fiche individuelle.\n\nOffre : X. Contrat publié : Non précisé. (30 September 2026)\n\nLieu : Mexico. Pays : Mexico. Organisation : Remote. (30 September 2026)\n\nCompétences citées dans la fiche : Houdini, Unreal Engine. (30 September 2026)\n\nContact public : Aucun mail de recrutement publié relevé ; utiliser le formulaire. (30 September 2026)\n\nCandidature : https://example.com/apply (30 September 2026)'
    const engine = engineFromNotes({ id: 'job_1', role: 'Environment Artist', notes, city: 'Mexico', createdAt: '2026-09-30', link: 'https://example.com/x' }, config)
    expect(engine).toMatchObject({ legacy: true, skills: ['Houdini', 'Unreal Engine'], contactEmails: [], applyUrl: 'https://example.com/apply', country: 'Mexico', language: 'en', firstSeenAt: '2026-09-30' })
  })
})
