#!/bin/bash
# Append le doc archi média canonique aux 3 .md de mémoire. Économe en tokens : le texte est écrit UNE fois
# (docs/ARCHITECTURE-MEDIA.md), ce script le recopie tel quel avec un en-tête daté. Idempotent par garde-marqueur.
set -e
SRC="/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/docs/ARCHITECTURE-MEDIA.md"
MARK="<!-- ARCHI-MEDIA-2026-06-29 -->"
TARGETS=(
  "/Users/zenray/Create/Build/Memory/PROGRESS.md"
  "/Users/zenray/Create/Build/Memory/Identity/Matthieu1.md"
  "/Users/zenray/.claude/projects/-Users-zenray-Create-Build-Memory/memory/streaming-dash-maxrate-solution.md"
)
for f in "${TARGETS[@]}"; do
  if grep -q "$MARK" "$f" 2>/dev/null; then echo "déjà présent: $f"; continue; fi
  { printf '\n\n%s\n## Architecture média (snapshot 2026-06-29)\n\n' "$MARK"; cat "$SRC"; } >> "$f"
  echo "appendé: $f"
done
