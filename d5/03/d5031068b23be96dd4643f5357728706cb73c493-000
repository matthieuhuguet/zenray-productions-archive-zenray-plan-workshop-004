import fs from 'fs'
const src = fs.readFileSync('/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayWebsite/src/App.jsx','utf8')
const start = src.indexOf('const PROJECTS')
const lb = src.indexOf('[', start)
// scan string/comment-aware pour trouver le ] correspondant
let i = lb, depth = 0, s = null, esc = false, line = false, block = false
for (; i < src.length; i++) {
  const c = src[i], n = src[i+1]
  if (line) { if (c === '\n') line = false; continue }
  if (block) { if (c === '*' && n === '/') { block = false; i++ } continue }
  if (s) { if (esc) { esc = false } else if (c === '\\') esc = true; else if (c === s) s = null; continue }
  if (c === '/' && n === '/') { line = true; i++; continue }
  if (c === '/' && n === '*') { block = true; i++; continue }
  if (c === '"' || c === "'" || c === '`') { s = c; continue }
  if (c === '[') depth++
  else if (c === ']') { depth--; if (depth === 0) break }
}
const arrText = src.slice(lb, i+1)
const PROJECTS = eval('(' + arrText + ')')
const slugify = (str) => str.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'')
const BASE = 'https://matthieuhuguet.com'
const out = PROJECTS.filter(p => !p.hidden).map(p => ({
  id: p.id,
  title: p.title,
  brand: p.brand || '',
  image: p.image ? BASE + p.image : null,
  color: p.color || null,
  accent: p.accent || null,
  url: p.externalLink || `${BASE}/reels/${slugify(p.title)}`,
  external: !!p.externalLink,
}))
fs.writeFileSync('/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/src/projects.json', JSON.stringify(out, null, 1))
console.log('projets extraits (visibles):', out.length)
out.forEach(p => console.log(' -', p.title, '->', p.url))
