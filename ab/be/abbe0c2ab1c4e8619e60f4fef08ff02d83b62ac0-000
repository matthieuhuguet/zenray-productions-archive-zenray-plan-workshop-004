// NAMES A GUEST TYPES BECOME PATHS, SO THEY ARE CLEANED HERE, IN ONE PLACE (2 October 2026), by the client (to show the result)
// and by the server (the only one that counts). Isomorphic. A cleaned name never contains a path separator, a dot prefix, a
// control character or any character GitHub paths or our own markers could confuse.
import { GUEST, IMAGE_EXTS } from '../config/guestUpload.js'

const BAD = /[\u0000-\u001f\u007f/\\:*?"<>|#%{}[\]^~`$@!;=]/g

export function cleanGuestName(raw) {
  let s = String(raw == null ? '' : raw).normalize('NFC').replace(BAD, ' ').replace(/\s+/g, ' ').trim()
  s = s.replace(/^[.\- ]+/, '').replace(/[. ]+$/, '')
  s = [...s].slice(0, GUEST.NAME_MAX).join('').trim()
  return s || 'Invité'
}

const cleanSegment = (raw) => {
  let s = String(raw == null ? '' : raw).normalize('NFC').replace(BAD, ' ').replace(/\s+/g, ' ').trim()
  s = s.replace(/^[.\- ]+/, '').replace(/[. ]+$/, '')
  return [...s].slice(0, GUEST.SEGMENT_MAX).join('').trim()
}

/** « Mariage / Soirée » or ['Mariage','Soirée'] -> 'Mariage/Soirée' (depth-limited, empty segments dropped). */
export function cleanSubPath(raw) {
  const parts = Array.isArray(raw) ? raw : String(raw == null ? '' : raw).split('/')
  return parts.map(cleanSegment).filter(Boolean).slice(0, GUEST.DEPTH_MAX).join('/')
}

/** 'IMG_1234.JPG' -> { stem:'IMG_1234', ext:'jpg', extRaw:'JPG', display:'IMG_1234.JPG' } (the drive keeps the original case) or null when it is not a supported image name. */
export function splitImageName(raw) {
  const base = String(raw == null ? '' : raw).split(/[\\/]/).pop() || ''
  const dot = base.lastIndexOf('.')
  if (dot <= 0) return null
  const extRaw = base.slice(dot + 1).replace(/[^A-Za-z0-9]/g, '')
  const ext = extRaw.toLowerCase()
  if (!IMAGE_EXTS.includes(ext)) return null
  let stem = cleanSegment(base.slice(0, dot))
  stem = [...stem].slice(0, GUEST.STEM_MAX).join('').trim() || 'photo'
  return { stem, ext, extRaw, display: `${stem}.${extRaw}` }
}

/** Magic bytes of the first chunk: the browser-declared type is never trusted. */
export function looksLikeImage(u8) {
  if (!u8 || u8.length < 12) return false
  const b = u8
  if (b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff) return true                                   // jpeg
  if (b[0] === 0x89 && b[1] === 0x50 && b[2] === 0x4e && b[3] === 0x47) return true                   // png
  if (b[0] === 0x47 && b[1] === 0x49 && b[2] === 0x46 && b[3] === 0x38) return true                   // gif
  if (b[0] === 0x42 && b[1] === 0x4d) return true                                                    // bmp
  if ((b[0] === 0x49 && b[1] === 0x49 && b[2] === 0x2a && b[3] === 0) || (b[0] === 0x4d && b[1] === 0x4d && b[2] === 0 && b[3] === 0x2a)) return true // tiff
  if (b[0] === 0x52 && b[1] === 0x49 && b[2] === 0x46 && b[3] === 0x46 && b[8] === 0x57 && b[9] === 0x45 && b[10] === 0x42 && b[11] === 0x50) return true // webp
  if (b[4] === 0x66 && b[5] === 0x74 && b[6] === 0x79 && b[7] === 0x70) return true                   // heic / heif / avif (ISO-BMFF ftyp)
  return false
}
