// 9 October 2026 09:21 CEST: Resolve Eagle paths only for node types that already use link resolution.
import React, { useEffect, useState } from 'react'
import { NodeRenderer } from './registry.jsx'
import { resolveEaglePath } from '../lib/eagleLink.js'
import { typeOfPath } from './node.js'

const EAGLE_TYPES = new Set(['image', 'media', 'file', 'canvas', 'embed', 'db'])

function nodeForPath(path, node) {
  return { ...(node || {}), type: typeOfPath(path), contentPath: path }
}

function ResolvedNodeRenderer({ path, ...props }) {
  const [resolved, setResolved] = useState(null)
  useEffect(() => {
    let live = true
    setResolved(null)
    resolveEaglePath(path).then((value) => { if (live) setResolved(value) })
    return () => { live = false }
  }, [path])
  if (!resolved) return <div style={{ padding: 24, color: props.t?.textSecondary || '#888' }}>résolution du lien…</div>
  if (resolved.error) return <div style={{ padding: 24, color: '#ff453a' }}>Lien média indisponible.</div>
  const node = nodeForPath(resolved.path, props.node)
  return <NodeRenderer {...props} node={node} path={resolved.path} />
}

export default function ResolvedUnifiedViewer({ path, ...props }) {
  if (EAGLE_TYPES.has(typeOfPath(path))) return <ResolvedNodeRenderer path={path} {...props} />
  return <NodeRenderer {...props} node={nodeForPath(path, props.node)} path={path} />
}
