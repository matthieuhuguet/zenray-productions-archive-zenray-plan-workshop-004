// SfxQuickListView.test.jsx: tests unitaires pour l'explorateur d'ecoute rapide SFX.
// Teste le montage, le filtrage des sons, et la selection au clic.

import React from 'react'
import { act, cleanup, render, screen, fireEvent } from '@testing-library/react'
import { afterEach, describe, expect, it, vi } from 'vitest'
import SfxQuickListView from './SfxQuickListView.jsx'

describe('SfxQuickListView', () => {
  afterEach(() => cleanup())

  const sampleEntries = [
    { dir: 'pages/Audio/SFX/laser1', name: 'laser_shot_01.wav', contentPath: 'pages/Audio/SFX/laser1.wav.media.json' },
    { dir: 'pages/Audio/SFX/footstep1', name: 'footstep_wood_01.mp3', contentPath: 'pages/Audio/SFX/footstep1.mp3.media.json' },
    { dir: 'pages/Audio/SFX/ambient', name: 'rain_loop.flac', contentPath: 'pages/Audio/SFX/ambient.flac.media.json' },
    { dir: 'pages/Image/photo', name: 'cover.jpg', contentPath: 'pages/Image/cover.img.json' }, // Non audio
  ]

  it('monte le composant et n affiche que les fichiers audio (3 sur 4)', () => {
    render(
      <SfxQuickListView
        open={true}
        onClose={vi.fn()}
        t={{ textPrimary: '#fff', textSecondary: '#aaa', border: '#333' }}
        entries={sampleEntries}
      />
    )

    expect(screen.getByText('Écoute rapide SFX')).toBeDefined()
    expect(screen.getByText('3 sons')).toBeDefined()
    expect(screen.getAllByText('laser_shot_01').length).toBeGreaterThanOrEqual(1)
    expect(screen.getByText('footstep_wood_01')).toBeDefined()
    expect(screen.getByText('rain_loop')).toBeDefined()
    expect(screen.queryByText('cover')).toBeNull()
  })

  it('filtre les sons en direct selon la saisie utilisateur', () => {
    render(
      <SfxQuickListView
        open={true}
        onClose={vi.fn()}
        t={{ textPrimary: '#fff', textSecondary: '#aaa', border: '#333' }}
        entries={sampleEntries}
      />
    )

    const input = screen.getByPlaceholderText('Filtrer les sons…')
    fireEvent.change(input, { target: { value: 'laser' } })

    expect(screen.getAllByText('laser_shot_01').length).toBeGreaterThanOrEqual(1)
    expect(screen.queryByText('footstep_wood_01')).toBeNull()
    expect(screen.queryByText('rain_loop')).toBeNull()
  })

  it('declenche la fermeture sur clic du bouton fermer ou touche Echap', () => {
    const onClose = vi.fn()
    render(
      <SfxQuickListView
        open={true}
        onClose={onClose}
        t={{ textPrimary: '#fff', textSecondary: '#aaa', border: '#333' }}
        entries={sampleEntries}
      />
    )

    const closeBtn = screen.getByTitle('Fermer (Échap)')
    fireEvent.click(closeBtn)
    expect(onClose).toHaveBeenCalled()
  })
})
