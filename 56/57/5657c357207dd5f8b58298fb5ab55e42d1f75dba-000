// LOT TABLES — import / export CSV (valeurs séparées par virgules, standard RFC 4180).

export function toCSV(grid) {
  return grid.map((row) => row.map((c) => {
    const s = c == null ? '' : String(c)
    return /[",\n\r]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s
  }).join(',')).join('\r\n')
}

// Parse robuste : détecte automatiquement le séparateur (virgule ou point-virgule, courant en FR).
export function fromCSV(text) {
  const sep = guessSep(text)
  const rows = []; let row = []; let cell = ''; let q = false
  for (let i = 0; i < text.length; i++) {
    const ch = text[i]
    if (q) {
      if (ch === '"') { if (text[i + 1] === '"') { cell += '"'; i++ } else q = false }
      else cell += ch
    } else if (ch === '"') q = true
    else if (ch === sep) { row.push(cell); cell = '' }
    else if (ch === '\n') { row.push(cell); rows.push(row); row = []; cell = '' }
    else if (ch === '\r') {}
    else cell += ch
  }
  if (cell !== '' || row.length) { row.push(cell); rows.push(row) }
  return rows
}

function guessSep(text) {
  const head = text.slice(0, 2000).split('\n')[0] || ''
  const c = (head.match(/,/g) || []).length, sc = (head.match(/;/g) || []).length
  return sc > c ? ';' : ','
}

export function downloadCSV(filename, grid) {
  const blob = new Blob(['﻿' + toCSV(grid)], { type: 'text/csv;charset=utf-8' })
  const url = URL.createObjectURL(blob)
  const a = document.createElement('a'); a.href = url; a.download = filename.endsWith('.csv') ? filename : filename + '.csv'
  document.body.appendChild(a); a.click(); document.body.removeChild(a); setTimeout(() => URL.revokeObjectURL(url), 1000)
}
