// 14 October 2026: the player choices that follow Matthieu from one video to the next. FR : les choix du lecteur suivent d'une video a l'autre.
import { describe, it, expect } from 'vitest'
import {
  PLAYER_PREF_KEYS, SPEED_RANGE, normalizeLang, trackLang, findByLang, pickLevelByHeight, readPlayerPrefs, writePlayerPref,
} from './playerPrefs.js'

const memory = () => { const m = new Map(); return { getItem: (k) => (m.has(k) ? m.get(k) : null), setItem: (k, v) => m.set(k, String(v)) } }

describe('normalizeLang', () => {
  it.each([
    ['fr', 'fr'], ['fre', 'fr'], ['fra', 'fr'], ['Français', 'fr'], ['French', 'fr'], ['fr-FR', 'fr'],
    ['en', 'en'], ['eng', 'en'], ['English', 'en'], ['en-US', 'en'],
    ['ja', 'ja'], ['jpn', 'ja'], ['Japanese', 'ja'], ['日本語', 'ja'], ['Japonais (ASS)', 'ja'],
    ['und', ''], ['', ''], [null, ''], ['de', 'de'],
  ])('%s -> %s', (input, expected) => expect(normalizeLang(input)).toBe(expected))
})

describe('track selection', () => {
  const tracks = [{ id: 'track-0', lang: 'en', label: 'English' }, { id: 'track-1', lang: 'und', label: 'Français' }, { id: 'track-2', lang: 'jpn' }]
  it('reads the language of a track from its code, then from its label', () => {
    expect(tracks.map(trackLang)).toEqual(['en', 'fr', 'ja'])
  })
  it('finds the track in the saved language, whatever its id', () => {
    expect(findByLang(tracks, 'fr').id).toBe('track-1')
    expect(findByLang(tracks, 'ja').id).toBe('track-2')
  })
  it('returns null when the saved language is missing in this film, so the caller keeps its default', () => {
    expect(findByLang(tracks, 'de')).toBeNull()
    expect(findByLang(tracks, '')).toBeNull()
  })
})

describe('pickLevelByHeight', () => {
  const levels = [{ index: 0, h: 2160 }, { index: 1, h: 1080 }, { index: 2, h: 720 }, { index: 3, h: 360 }]
  it('keeps the same quality when the film has it', () => expect(pickLevelByHeight(levels, 720).index).toBe(2))
  it('falls to the best level below when the exact one is missing', () => expect(pickLevelByHeight(levels, 900).index).toBe(2))
  it('takes the lowest level when every level is above the saved height', () => expect(pickLevelByHeight(levels, 144).index).toBe(3))
  it('returns null for Auto (0) so nothing is forced', () => expect(pickLevelByHeight(levels, 0)).toBeNull())
})

describe('saved preferences', () => {
  it('defaults: subtitles on, speed 1, no language, Auto quality', () => {
    expect(readPlayerPrefs(memory())).toEqual({ subLang: '', subsOn: true, speed: 1, audioLang: '', qualityHeight: 0 })
  })
  it('round trip: what one video writes the next one reads', () => {
    const s = memory()
    writePlayerPref(s, PLAYER_PREF_KEYS.subLang, 'fr')
    writePlayerPref(s, PLAYER_PREF_KEYS.subsOn, '0')
    writePlayerPref(s, PLAYER_PREF_KEYS.speed, 1.5)
    writePlayerPref(s, PLAYER_PREF_KEYS.audioLang, 'ja')
    writePlayerPref(s, PLAYER_PREF_KEYS.qualityHeight, 1080)
    expect(readPlayerPrefs(s)).toEqual({ subLang: 'fr', subsOn: false, speed: 1.5, audioLang: 'ja', qualityHeight: 1080 })
  })
  it('an unknown speed or a broken storage falls back to the defaults', () => {
    const s = memory()
    writePlayerPref(s, PLAYER_PREF_KEYS.speed, 7)
    expect(readPlayerPrefs(s).speed).toBe(1)
    const broken = { getItem() { throw new Error('blocked') }, setItem() { throw new Error('blocked') } }
    expect(readPlayerPrefs(broken).speed).toBe(1)
    expect(() => writePlayerPref(broken, PLAYER_PREF_KEYS.speed, 2)).not.toThrow()
    expect(SPEED_RANGE.min).toBeLessThan(1)
    writePlayerPref(s, PLAYER_PREF_KEYS.speed, 3)
    expect(readPlayerPrefs(s).speed).toBe(3)
  })
})
