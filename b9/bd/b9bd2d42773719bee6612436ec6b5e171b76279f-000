// Miroir CLIENT (sans token) du helper de nommage des shards ZenRay.
// Doit rester EXACTEMENT aligné sur server/shard-naming.js (même schéma, mêmes regex) pour éviter toute
// divergence client/serveur. Ajoute en plus : OWNER (compte GitHub) + buildJsDelivrUrl (URL CDN pinnée).
//
// Schéma générique : zenray-<kind>-<vis>-NN  (kind ∈ img/vid/audio/doc/table/markdown ; vis ∈ public/private).
// Legacy acceptés : zenray-media-NN (= img/private), zenray-vid-NN (= vid/public).

export const OWNER = 'matthieuhuguet' // aligné sur CONTENT_OWNER serveur (et hlsTranscoder.js).

// 12 October 2026: 'motion' added, same list as server/shard-naming.js.
export const KINDS = ['img', 'vid', 'audio', 'doc', 'pdf', 'table', 'markdown', 'blob', 'archive', 'backup', 'motion']
export const VIS = ['public', 'private']

export const shardReV2 = /^zenrayshards-([a-z]+)-[0-9a-f]{8,}$/
export const shardReNew = /^zenray-(img|vid|audio|doc|pdf|table|markdown)-(public|private)-\d{2,}$/
export const legacyMediaRe = /^zenray-media-\d{2,}$/
export const legacyVidRe = /^zenray-vid-\d{2,}$/
export const shardRe = new RegExp(
  '^(?:' +
    'zenrayshards-[a-z]+-[0-9a-f]{8,}' +
    '|zenray-(?:img|vid|audio|doc|pdf|table|markdown)-(?:public|private)-\\d{2,}' +
    '|zenray-media-\\d{2,}' +
    '|zenray-vid-\\d{2,}' +
  ')$'
)

export function shardName(kind, vis, n) {
  const num = Math.max(1, parseInt(n, 10) || 1)
  return `zenray-${kind}-${vis}-${String(num).padStart(2, '0')}`
}

export function parseShard(name) {
  const s = String(name || '')
  let m = shardReV2.exec(s)
  if (m) return { kind: KINDS.includes(m[1]) ? m[1] : 'blob', vis: ['img', 'audio', 'archive', 'motion'].includes(m[1]) ? 'public' : 'private', n: 0, v2: true }
  m = shardReNew.exec(s)
  if (m) return { kind: m[1], vis: m[2], n: parseInt(s.match(/-(\d{2,})$/)[1], 10) }
  if (legacyMediaRe.test(s)) return { kind: 'img', vis: 'private', n: parseInt(s.match(/-(\d{2,})$/)[1], 10), legacy: 'media' }
  if (legacyVidRe.test(s)) return { kind: 'vid', vis: 'public', n: parseInt(s.match(/-(\d{2,})$/)[1], 10), legacy: 'vid' }
  return null
}

// URL jsDelivr PINNÉE sur le commit (cache immuable). Forme exacte :
//   https://cdn.jsdelivr.net/gh/<OWNER>/<repo>@<commit>/<path>
// Le pin sur commit est OBLIGATOIRE pour le public : sans lui jsDelivr sert @latest (mutable, cache cassé,
// risque écran blanc). path est déjà hashé (ab/cd/<sha>.<ext>), aucun nom humain.
export function buildJsDelivrUrl(repo, commit, path) {
  if (!repo || !commit || !path) return null
  return `https://cdn.jsdelivr.net/gh/${OWNER}/${repo}@${commit}/${path}`
}
// URL raw.githubusercontent.com pinnée sur le commit. Sert les MÊMES fichiers que jsDelivr mais SANS la limite
// 20 Mo (raw.github = 100 Mo/fichier). Utilisé pour l'ORIGINAL des images (vignette = jsDelivr/CDN ; original =
// raw.github à l'affichage uniquement -> 1 requête GitHub par image affichée, pas en galerie). CORS '*' OK.
export function buildRawUrl(repo, commit, path) {
  if (!repo || !commit || !path) return null
  return `https://raw.githubusercontent.com/${OWNER}/${repo}/${commit}/${path}`
}
