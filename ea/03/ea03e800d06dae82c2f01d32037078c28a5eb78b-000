import { describe, expect, it } from 'vitest'
import { loadThemeComponents, groupComponents } from './componentCatalog.js'

describe('catalogue de composants', () => {
  it('charge uniquement le registre et les parts du thème actif', async () => {
    const bundle = await loadThemeComponents('T-01-1-3')
    expect(bundle.components).toHaveLength(26)
    expect(bundle.components.find((entry) => entry.id === '11-headline')?.html).toContain('zrm-headline')
    // Vitest neutralise les imports CSS ; le build Vite vérifie séparément leur inclusion.
    expect(typeof bundle.tokensCss).toBe('string')
    expect(bundle.definitionsHtml).toContain('<symbol')
    expect(Object.keys(groupComponents(bundle.components))).toContain('Éditorial')
  })
})
