// 23 October 2026: the index mapping must find a question by any meaningful word, in French, English or Japanese.
import { describe, expect, it } from 'vitest'
import { buildIndexMap, normalize, questionKey, searchIndex, tokenize } from './knowledgeIndex.js'

const entries = [
  { q: "C'est quoi les Cloudflare rules ?", a: ['Des règles appliquées avant le site.'], kw: ['cloudflare', 'cache'], d: 'Tech et drive' },
  { q: 'Comment exporter une image de DaVinci ?', a: ['Grab Still puis Export.'], kw: ['davinci'], d: 'Tech et drive' },
  { q: 'しぬな, c\'est quel vocabulaire ?', a: ['死ぬ + な : ne meurs pas.'], kw: ['impératif'], d: 'Japonais' },
]

describe('knowledgeIndex', () => {
  it('normalizes accents and punctuation', () => { expect(normalize("Réécriture d'en-tête !")).toBe('reecriture d en-tete') })
  it('drops stop words and keeps Japanese bigrams', () => {
    expect(tokenize('Comment exporter une image')).toEqual(['exporter', 'image'])
    expect(tokenize('しぬな')).toEqual(['しぬ', 'ぬな'])
  })
  it('gives the same key to the same question written twice', () => {
    expect(questionKey("C'est quoi les Cloudflare rules ?")).toBe(questionKey('cloudflare RULES, c\'est quoi'))
  })
  it('finds by question word, keyword, prefix and Japanese', () => {
    const map = buildIndexMap(entries)
    expect(searchIndex(map, 'cloudflare')).toEqual([0])
    expect(searchIndex(map, 'davin')).toEqual([1])
    expect(searchIndex(map, 'cache cloudflare')).toEqual([0])
    expect(searchIndex(map, 'しぬ')).toEqual([2])
    expect(searchIndex(map, 'export')).toEqual([1])
  })
  it('requires every word and ranks the question above the answer', () => {
    const map = buildIndexMap(entries)
    expect(searchIndex(map, 'cloudflare davinci')).toEqual([])
    expect(searchIndex(map, '')).toEqual([])
    expect(searchIndex(map, 'tech')).toEqual([0, 1])
  })
})
