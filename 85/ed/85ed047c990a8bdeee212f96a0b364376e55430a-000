// A2 — Viewer d'un nœud .file.json (archive universelle « zenray-productions-archive »).
// Le manifeste décrit UN fichier archivé sur un shard GitHub PUBLIC :
//   { type:'file', name, size, mime, sha256, mode:'raw'|'chunked', repo, commit, path | chunks[], chunkSize }
// - mode raw     : le fichier est tel quel sur le repo -> aperçu direct (img/audio/vidéo/texte) + download direct.
// - mode chunked : >95 Mo, découpé en chunks de 19 Mo -> download = re-concaténation streaming côté client,
//   identique bit à bit (le sha256 du manifeste est la preuve d'intégrité affichée).
// UI : carte liquid glass tinted (langage du projet), texte regular/medium uniquement (jamais de gras).
import React, { useEffect, useState } from 'react'
import { PALETTE, RADII, SHADOWS } from '../theme.js'
import Icon from './Icon.jsx'
import { chunkCount, downloadUrls } from '../lib/archiveChunks.js'
import { streamDownload } from '../lib/fetchAsset.js'

const FONTS = { sans: "var(--zr-police-sans)" }
const fmtSize = (n) => n >= 1e9 ? `${(n / 1e9).toFixed(2)} Go` : n >= 1e6 ? `${(n / 1e6).toFixed(1)} Mo` : `${Math.max(1, Math.round(n / 1024))} Ko`

// Téléchargement : résolution des URLs via archiveChunks.js (source unique, v2/v3/v4 multi-shards), puis
// download STREAMÉ via fetchAsset.js (écrit sur disque chunk par chunk quand l'API le permet -> zéro pic RAM
// sur mobile/gros fichiers ; repli Blob borné sinon). Identique bit à bit, le sha256 du manifeste fait foi.
async function downloadFile(m, onProgress) {
  await streamDownload({ urls: downloadUrls(m), name: m.name, mime: m.mime || 'application/octet-stream', onProgress })
}

export default function FileNodeViewer({ t, path, title }) {
  const [m, setM] = useState(null)
  const [err, setErr] = useState(null)
  const [dlProg, setDlProg] = useState(null) // null = repos ; 0..1 = en cours
  const [text, setText] = useState(null)     // aperçu texte (petits fichiers text/*)
  const [verSel, setVerSel] = useState(null) // index de version choisie (null = dernière). Versionning archive.
  useEffect(() => {
    let live = true
    fetch(`/api/page?action=read&path=${encodeURIComponent(path)}`, { cache: 'no-store' })
      .then((r) => r.json())
      .then((j) => { if (!live) return; if (j && j.markdown) { try { setM(JSON.parse(j.markdown)) } catch { setErr('manifeste illisible') } } else setErr('introuvable') })
      .catch(() => live && setErr('réseau'))
    return () => { live = false }
  }, [path])
  useEffect(() => {
    if (!m || m.mode !== 'raw' || !(m.mime || '').startsWith('text/') || m.size > 2 * 1024 * 1024) return
    let live = true
    fetch(rawUrl(m, m.path)).then((r) => r.text()).then((s) => live && setText(s)).catch(() => {})
    return () => { live = false }
  }, [m])

  const dark = t.textPrimary === PALETTE.textPrimaryDark
  const g = t.glass || {}
  const card = { maxWidth: 860, margin: '0 auto', padding: 22, borderRadius: 18, fontFamily: FONTS.sans, fontWeight: 400, color: t.textPrimary,
    background: `linear-gradient(150deg, ${PALETTE.primary}14, ${PALETTE.primary}07 65%), ${g.bgStrong || 'rgba(253,253,252,.84)'}`,
    backdropFilter: g.filterThick || 'blur(44px) saturate(210%)', WebkitBackdropFilter: g.filterThick || 'blur(44px) saturate(210%)',
    boxShadow: `inset 1.5px 1.5px 1px rgba(255,255,255,${dark ? 0.18 : 0.58}), inset 0 0 0 0.5px rgba(255,255,255,${dark ? 0.1 : 0.4}), 0 22px 60px -24px rgba(20,30,70,.45)` }

  if (err) return <div style={{ ...card, color: PALETTE.red }}>Fichier d'archive : {err}</div>
  if (!m) return <div style={{ ...card, color: t.textSecondary }}>chargement du manifeste…</div>

  const mime = m.mime || ''
  // VERSIONNING : si le manifeste porte versions[], on construit le manifeste EFFECTIF depuis la version choisie
  // (dernière par défaut). Tout (aperçu/téléchargement/provenance) s'appuie sur `eff`, jamais sur la brute.
  const versions = (Array.isArray(m.versions) && m.versions.length) ? m.versions : null
  const vi = versions ? ((verSel != null && verSel >= 0 && verSel < versions.length) ? verSel : versions.length - 1) : null
  const vv = versions ? versions[vi] : null
  const eff = vv ? { ...m, repo: vv.repo, commit: vv.commit, chunks: vv.chunks, parts: vv.parts, size: vv.size, sha256: vv.sha256, chunkSize: vv.chunkSize || m.chunkSize, mode: 'chunked' } : m
  const direct = eff.mode === 'raw' ? rawUrl(eff, eff.path) : null
  const fmtDate = (s) => { try { return new Date(s).toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: '2-digit', hour: '2-digit', minute: '2-digit' }) } catch { return s } }
  return (
    <div style={card}>
      {/* en-tête : icône type + nom + méta */}
      <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginBottom: 16 }}>
        <span style={{ display: 'inline-flex', width: 38, height: 38, borderRadius: 11, alignItems: 'center', justifyContent: 'center', background: PALETTE.primarySoft, color: PALETTE.primary }}>
          <Icon name={mime.startsWith('image/') ? 'photo' : mime.startsWith('video/') ? 'film' : mime.startsWith('audio/') ? 'music.note' : 'doc'} size={19} weight={1.5} />
        </span>
        <div style={{ minWidth: 0 }}>
          <div style={{ fontSize: 'var(--zr-ui-2xl)', fontWeight: 500, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{m.name || title}</div>
          <div style={{ fontSize: 'var(--zr-ui-sm)', color: t.textSecondary, fontFamily: FONTS.sans }}>{fmtSize(eff.size)} · {mime}{eff.mode === 'chunked' ? ` · ${chunkCount(eff)} morceaux` : ''}{versions ? ` · v${vi + 1}/${versions.length}` : ''}</div>
        </div>
        <button onClick={() => { setDlProg(0); downloadFile(eff, setDlProg).then(() => setDlProg(null)).catch(() => setDlProg(null)) }}
          disabled={dlProg !== null && dlProg < 1}
          style={{ marginLeft: 'auto', display: 'inline-flex', alignItems: 'center', gap: 7, padding: '9px 18px', borderRadius: 11, border: 'none', cursor: 'pointer', background: PALETTE.primary, color: '#fff', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', fontWeight: 500, boxShadow: `0 6px 16px -4px ${PALETTE.primary}99` }}>
          <Icon name="arrow.down.right" size={14} color="#fff" weight={1.8} />
          {dlProg !== null && dlProg < 1 ? `Téléchargement ${Math.round(dlProg * 100)}%` : 'Télécharger'}
        </button>
      </div>

      {/* SÉLECTEUR DE VERSION (archive versionnée) : choisir une version antérieure -> aperçu/téléchargement de CELLE-ci. */}
      {versions && versions.length > 1 && (
        <div style={{ display: 'flex', alignItems: 'center', gap: 8, flexWrap: 'wrap', marginBottom: 14, padding: '10px 12px', borderRadius: 12, background: dark ? 'rgba(255,255,255,.05)' : 'rgba(255,255,255,.5)' }}>
          <span style={{ fontSize: 'var(--zr-ui-sm)', color: t.textSecondary, fontFamily: FONTS.sans }}>Versions :</span>
          {versions.map((v, i) => {
            const on = i === vi
            return (
              <button key={i} onClick={() => setVerSel(i)} className="zr-tap"
                style={{ display: 'inline-flex', alignItems: 'center', gap: 5, padding: '4px 10px', borderRadius: 8, border: 'none', cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)',
                  background: on ? PALETTE.primary : (dark ? 'rgba(255,255,255,.08)' : 'rgba(0,0,0,.05)'), color: on ? '#fff' : t.textPrimary }}>
                v{i + 1}{i === versions.length - 1 ? ' (actuelle)' : ''} · {v.ts ? fmtDate(v.ts) : '—'} · {fmtSize(v.size)}
              </button>
            )
          })}
        </div>
      )}

      {/* aperçu selon le type (raw uniquement : un chunked n'est pas consultable en flux, seulement re-téléchargeable) */}
      {direct && mime.startsWith('image/') && <img src={direct} alt={m.name} style={{ maxWidth: '100%', borderRadius: 12, display: 'block', margin: '0 auto' }} />}
      {direct && mime.startsWith('video/') && <video src={direct} controls playsInline style={{ width: '100%', borderRadius: 12, background: '#1C1C1E' }} />}
      {direct && mime.startsWith('audio/') && <audio src={direct} controls style={{ width: '100%' }} />}
      {direct && text != null && <pre style={{ maxHeight: 480, overflow: 'auto', padding: 14, borderRadius: 12, background: dark ? 'rgba(255,255,255,.05)' : 'rgba(255,255,255,.55)', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', lineHeight: 1.5, whiteSpace: 'pre-wrap' }}>{text}</pre>}
      {eff.mode === 'chunked' && (
        <div style={{ padding: '14px 16px', borderRadius: 12, background: dark ? 'rgba(255,255,255,.05)' : 'rgba(255,255,255,.5)', fontSize: 'var(--zr-ui-md)', color: t.textSecondary }}>
          Fichier découpé en {chunkCount(eff)} morceaux de 19 Mo. « Télécharger » le reconstitue à l'identique
          (intégrité : sha256 <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)' }}>{(eff.sha256 || '').slice(0, 16)}…</span>).
        </div>
      )}

      {/* méta basse : provenance (de la version choisie) */}
      <div style={{ display: 'flex', alignItems: 'center', gap: 6, marginTop: 14, paddingTop: 12, borderTop: `1px solid ${PALETTE.primary}1f`, fontSize: 'var(--zr-ui-xs)', color: t.textSecondary, fontFamily: FONTS.sans }}>
        <span style={{ width: 6, height: 6, borderRadius: '50%', background: '#34c759' }} />
        GitHub · {eff.repo} @ {(eff.commit || '').slice(0, 7)}
      </div>
    </div>
  )
}
