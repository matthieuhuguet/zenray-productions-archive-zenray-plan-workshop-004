import { describe, it, expect } from 'vitest'
import { resolveInitialView, persistView } from './viewPersistence.js'

function fakeStorage(initial = {}) {
  const data = { ...initial }
  return {
    getItem: (k) => (k in data ? data[k] : null),
    setItem: (k, v) => { data[k] = v },
    removeItem: (k) => { delete data[k] },
    _raw: data,
  }
}

describe('resolveInitialView', () => {
  it('migre zr:tabs une seule fois puis le supprime', () => {
    const storage = fakeStorage({ 'zr:tabs': JSON.stringify([{ view: 'archives' }]) })
    expect(resolveInitialView(storage)).toBe('archives')
    expect(storage.getItem('zr:tabs')).toBeNull()
  })

  it('ne revient jamais à zr:tabs après la migration, même si zr:view change ensuite (régression 2026-07-16)', () => {
    const storage = fakeStorage({ 'zr:tabs': JSON.stringify([{ view: 'archives' }]) })
    resolveInitialView(storage) // 1er "mount" : migration + suppression de zr:tabs
    persistView(storage, 'pages') // l'utilisateur change de vue
    // 2e "mount" (reload) : zr:tabs est parti, doit lire la vraie vue courante, pas revenir à "archives"
    expect(resolveInitialView(storage)).toBe('pages')
  })

  it('lit zr:view si zr:tabs est absent', () => {
    const storage = fakeStorage({ 'zr:view': 'projects' })
    expect(resolveInitialView(storage)).toBe('projects')
  })

  it('retombe sur "board" si tout est absent', () => {
    const storage = fakeStorage({})
    expect(resolveInitialView(storage)).toBe('board')
  })

  it('ignore un zr:tabs corrompu et lit zr:view', () => {
    const storage = fakeStorage({ 'zr:tabs': 'not json', 'zr:view': 'tables' })
    expect(resolveInitialView(storage)).toBe('tables')
  })
})
