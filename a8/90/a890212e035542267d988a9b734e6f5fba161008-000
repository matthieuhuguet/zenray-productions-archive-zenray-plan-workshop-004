// 16 October 2026: prints the JavaScript to run inside ONE application page: it installs the filler and fills that offer. FR : imprime le script à exécuter dans la page d'UNE offre.
//   node scripts/Freelance/apply/BuildSnippet.mjs --run <dir> --id <studioId>
import path from 'node:path'
import { readFile } from 'node:fs/promises'
import { parseArgs } from '../RecordEmail.mjs'

const args = parseArgs(process.argv.slice(2))
if (!args.run || !args.id) throw new Error('Usage: BuildSnippet.mjs --run <dir> --id <studioId>')
const queue = JSON.parse(await readFile(path.join(args.run, 'queue.json'), 'utf8'))
const item = queue.items.find((i) => i.id === args.id)
if (!item) throw new Error(`No offer ${args.id} in the queue`)
const here = (name) => new URL(name, import.meta.url)
const map = JSON.parse(await readFile(here('./FieldMap.json'), 'utf8'))
delete map._note
const filler = await readFile(here('./FillForm.js'), 'utf8')
process.stdout.write(`${filler}\n;JSON.stringify(window.__zrFill(${JSON.stringify(item.profile)}, ${JSON.stringify(item.letter)}, ${JSON.stringify(map)}))`)
