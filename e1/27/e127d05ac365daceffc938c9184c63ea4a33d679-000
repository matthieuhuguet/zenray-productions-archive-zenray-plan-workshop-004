// 4 October 2026: how a studio name becomes a greeting and a lookup key, shared by the letter engine and the page.
// FR : comment un nom de studio devient une formule de salutation et une cle de recherche, partage entre le moteur et la page.

/** The studio as a greeting wants it: "d3t (Keywords Studios)" greets "d3t". */
export const greetingName = (name) => String(name || '').replace(/\s*\([^)]*\)\s*$/, '').trim() || String(name || '').trim()

/** "Asobo Studio" and "asobo studios" are the same studio: lower case, no accent, no generic word, letters and digits only. */
export const studioKey = (name) => greetingName(name).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\b(studios?|games?|interactive|entertainment)\b/g, '').replace(/[^a-z0-9]+/g, '')
