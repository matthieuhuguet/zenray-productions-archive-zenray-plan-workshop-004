"""Work categories: which cloud folder a film or episode belongs to (14 October 2026).

The table lives in WorkCategories.json (one place to edit). A work found in the table gets its
destination before the upload; an unknown work returns None and the caller must ask Matthieu,
then add the work to the JSON.

FR : table des oeuvres connues (WorkCategories.json). Une oeuvre connue a son dossier avant
l'envoi ; une oeuvre inconnue renvoie None, l'appelant doit demander puis l'ajouter au JSON.
"""
import json
import re
import unicodedata
from pathlib import Path

TABLE_PATH = Path(__file__).with_name('WorkCategories.json')

# Everything after one of these markers is not part of the work name.
# FR : tout ce qui suit un de ces marqueurs ne fait pas partie du nom de l'oeuvre.
CUT_MARKERS = re.compile(
    r'\bs\d{1,2}\s*e\d{1,3}\b'      # S01E05
    r'|\bseason\b|\bsaison\b'       # Season 02
    r'|\b(?:19|20)\d{2}\b'          # 2008
    r'|\b(?:480|576|720|1080|2160)p?\b|\b4k\b'
    r'|\s-\s*\d+\b'                 # " - 04"
    r'|\(\d\)'                      # "(2)"
)
EXTENSIONS = re.compile(r'(\.media\.json|\.mkv|\.mp4|\.avi|\.m4v|\.mov)+$', re.I)
SEASON_FROM_EPISODE = re.compile(r's(\d{1,2})\s*e\d{1,3}', re.I)
SEASON_WORD = re.compile(r'\b(?:season|saison)\s*(\d{1,2})\b', re.I)
SEASON_SHORT_FOLDER = re.compile(r'^s(\d{1,2})$', re.I)


def load_table(path=TABLE_PATH):
    table = json.loads(Path(path).read_text(encoding='utf-8'))
    for key in ('base', 'categories', 'works'):
        if key not in table:
            raise KeyError(f'WorkCategories table is missing "{key}"')
    return table


def work_key(text):
    """Normalise a file or folder name to the key of its work. / Cle normalisee d'une oeuvre."""
    s = unicodedata.normalize('NFKD', str(text))
    s = ''.join(c for c in s if not unicodedata.combining(c)).lower()
    s = EXTENSIONS.sub('', s)
    s = re.sub(r'[._]+', ' ', s)
    match = CUT_MARKERS.search(s)
    if match and match.start() > 0:
        s = s[:match.start()]
    return re.sub(r'[^a-z0-9]+', ' ', s).strip()


def _index(table):
    index = {}
    for category, works in table['works'].items():
        for work in works:
            index[work_key(work)] = (category, work)
    return index


def classify(text, table=None):
    """Return (category, canonicalWork) or None when the work is unknown (ask Matthieu).
    FR : renvoie (categorie, nom canonique) ou None si l'oeuvre est inconnue (demander)."""
    table = table or load_table()
    key = work_key(text)
    if not key:
        return None
    best = None
    for known, value in _index(table).items():
        if key == known or key.startswith(known + ' '):
            if best is None or len(known) > len(best[0]):
                best = (known, value)
    return best[1] if best else None


def season_folder(text):
    """'Saison NN' for an episode or season folder name, else None. / Dossier de saison."""
    name = str(text)
    short = SEASON_SHORT_FOLDER.match(name)
    if short:
        return f'Saison {int(short.group(1)):02d}'
    for pattern in (SEASON_FROM_EPISODE, SEASON_WORD):
        match = pattern.search(name)
        if match:
            return f'Saison {int(match.group(1)):02d}'
    return None


def destination_for(filename, table=None):
    """Cloud folder (relative path under the base) for a media file name, or None if unknown.
    Anime and Series: <Category>/<Work>/<Saison NN>; Movies and Documentaries: <Category>.
    FR : dossier cloud d'un fichier ; None si l'oeuvre est inconnue."""
    table = table or load_table()
    found = classify(filename, table)
    if not found:
        return None
    category, work = found
    if category in ('Movies', 'Documentaries'):
        return f'{category}'
    season = season_folder(filename)
    return f'{category}/{work}/{season}' if season else f'{category}/{work}'


def default_mode(table=None):
    """Default mode of a known work: 'stream' (policy of 14 October 2026). FR : mode par defaut d'une oeuvre connue."""
    table = table or load_table()
    mode = table.get('defaultMode', 'stream')
    if mode not in table.get('modes', ['stream', 'archive']):
        raise ValueError(f'WorkCategories defaultMode {mode!r} is not in modes')
    return mode


def full_destination(filename, table=None):
    """Same as destination_for, prefixed with the base ('pages/...'). / Avec le prefixe base."""
    table = table or load_table()
    relative = destination_for(filename, table)
    return None if relative is None else f"{table['base']}/{relative}"
