export const FORMATS_BY_ID = Object.fromEntries(FORMATS.map((f) => [f.id, f]))

export function getFormat(id) { return FORMATS_BY_ID[id] || FORMATS[0] }

export function isTemporal(format) { return format?.kind === 'video' || format?.kind === 'overlay' }

// Ratio d'affichage du Stage. Un format web n'a pas de hauteur fixe : on rend une page qui coule.
export function aspectOf(format) {
  if (!format?.canvas?.h) return null
  return format.canvas.w / format.canvas.h
}

// Durée totale d'un cut pour un format temporel : somme des durées de beats, bornée par le format.
export function durationOf(cut, format) {
  if (!isTemporal(format)) return 0
  const raw = (cut?.beats || []).reduce((sum, b) => sum + beatDuration(b), 0)
  const { min, max } = format.time
  return Math.min(max, Math.max(min, Math.round(raw * 10) / 10))
}

// Durée d'un beat : le tempo donne la base, le poids module. Déterministe, aucune part d'aléa.
const TEMPO_BASE = { still: 4, calm: 3, drive: 2, snap: 1.2 }

export function beatDuration(beat) {
  const base = TEMPO_BASE[beat?.tempo] ?? TEMPO_BASE.calm
  const weight = typeof beat?.weight === 'number' ? beat.weight : 0.5
  return Math.round(base * (0.7 + weight * 0.6) * 10) / 10
}
