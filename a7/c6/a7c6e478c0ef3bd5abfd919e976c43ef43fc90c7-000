// Embeds Ref : parsing + canonicalisation SÉCURISÉE des URLs (plan §4.4, §10, §13 P1 "Embeds XSS/SSRF").
//
// Règle dure : on ne stocke JAMAIS de HTML brut. On stocke seulement provider + id + url canonique.
// L'iframe (montée à la demande par EmbedNodeViewer) pointe sur youtube-nocookie.com (no-cookie, sandbox).
// Provider allowlist stricte : tout ce qui n'est pas reconnu = refusé (pas de bookmark arbitraire en V1).

import { CANVAS_SCHEMA, newId, nowIso } from './schema.js'
import { saveJson } from './content.js'

export const EMBED_SCHEMA = 'zenray.ref.embed.v1'

// Extrait l'id YouTube de toutes les formes d'URL courantes. Renvoie null si non YouTube.
export function parseYouTube(url) {
  if (typeof url !== 'string') return null
  let u
  try { u = new URL(url.trim()) } catch { return null }
  const host = u.hostname.replace(/^www\./, '').toLowerCase()
  let id = null
  if (host === 'youtu.be') id = u.pathname.slice(1).split('/')[0]
  else if (host === 'youtube.com' || host === 'm.youtube.com' || host === 'youtube-nocookie.com') {
    if (u.pathname === '/watch') id = u.searchParams.get('v')
    else if (u.pathname.startsWith('/embed/')) id = u.pathname.split('/')[2]
    else if (u.pathname.startsWith('/shorts/')) id = u.pathname.split('/')[2]
  }
  if (!id || !/^[\w-]{6,20}$/.test(id)) return null
  // start (t=90 ou t=1m30s) best-effort.
  let start = 0
  const t = u.searchParams.get('t') || u.searchParams.get('start')
  if (t) {
    if (/^\d+$/.test(t)) start = Number(t)
    else { const mm = t.match(/(\d+)m/); const ss = t.match(/(\d+)s/); start = (mm ? Number(mm[1]) * 60 : 0) + (ss ? Number(ss[1]) : 0) }
  }
  return { provider: 'youtube', providerId: id, start }
}

// Reconnaît une URL embeddable (V1 : YouTube uniquement). Renvoie un objet provider ou null.
export function parseEmbedUrl(url) {
  return parseYouTube(url)
}

// Fabrique l'objet .embed.json conforme au schéma (plan §4.4). Aucun HTML.
export function makeEmbed({ provider, providerId, url, start = 0, title = '' }) {
  const t = nowIso()
  const canonicalUrl = provider === 'youtube' ? `https://www.youtube-nocookie.com/embed/${providerId}` : url
  return {
    schema: EMBED_SCHEMA,
    id: newId('embed'),
    provider,
    url,
    canonicalUrl,
    providerId,
    title: title || (provider === 'youtube' ? 'Vidéo YouTube' : 'Embed'),
    thumbnailRef: null,
    start: start || 0,
    createdAt: t,
    updatedAt: t,
    embedPolicy: {
      lazy: true,
      sandbox: true,
      allow: 'accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share',
    },
  }
}

// URL d'iframe lazy (avec start). Sandbox/no-cookie appliqués côté composant.
export function embedIframeUrl(embed) {
  if (!embed || embed.provider !== 'youtube') return embed && embed.canonicalUrl
  const base = `https://www.youtube-nocookie.com/embed/${embed.providerId}`
  return embed.start ? `${base}?start=${embed.start}` : base
}

// Crée un nœud .embed.json dans le dossier Embeds/ d'un projet Ref puis renvoie son chemin (ou null).
// dir = dossier projet (ex "pages/Ref/Moodboard"). Écrit via /api/page (zenray-data), zéro binaire.
export async function createEmbedNode(dir, url) {
  const parsed = parseEmbedUrl(url)
  if (!parsed) return null
  const embed = makeEmbed({ ...parsed, url })
  const slug = `${parsed.provider}-${parsed.providerId}`.replace(/[^\w-]/g, '')
  const path = `${String(dir || 'pages/Ref').replace(/\/$/, '')}/Embeds/${slug}.embed.json`
  const res = await saveJson(path, embed)
  return res && res.ok ? path : null
}

// Garde-fou : un .embed.json minimal valide.
export function isEmbed(data) {
  return !!(data && (data.schema === EMBED_SCHEMA || data.provider) && data.providerId)
}

export const _SCHEMAS = { CANVAS_SCHEMA, EMBED_SCHEMA }
