function* walk(directory) {
  let entries
  try { entries = readdirSync(directory, { withFileTypes: true }) } catch { return }
  for (const entry of entries) {
    if (entry.isDirectory()) {
      if (SKIPPED_DIRECTORIES.has(entry.name) || entry.name.startsWith('.')) continue
      yield* walk(path.join(directory, entry.name))
    } else if (entry.isFile()) {
      if (TEST_FILE.test(entry.name) || /^test_.*\.py$/.test(entry.name)) continue
      if (SCANNED_EXTENSIONS.has(path.extname(entry.name))) yield path.join(directory, entry.name)
    }
  }
}

/**
 * Scans `root` and reports: files that push outside the policy and are not allowlisted, stale allowlist entries, entries without a
 * real reason, and fixed batches written as literals.
 * FR : analyse `root` et rend les ecarts ; une liste vide partout = conforme.
 */
export function scanPushPaths({ root, allowlist = PUSH_ALLOWLIST, roots = SCANNED_ROOTS } = {}) {
  const pushers = new Map()    // relative file -> { routed }
  const pinned = []
  for (const top of roots) {
    const start = path.join(root, top)
    if (!existsSync(start) || !statSync(start).isDirectory()) continue
    for (const file of walk(start)) {
      const relative = path.relative(root, file).split(path.sep).join('/')
      let text
      try { text = readFileSync(file, 'utf8') } catch { continue }
      if (SELF_FILES.has(relative)) continue
      if (PINNED_BATCH.test(text)) pinned.push(relative)
      const code = stripComments(text)
      const pushes = PUSH_LITERAL.test(text) || (relative.endsWith('.sh') && SHELL_PUSH.test(text)) || API_BLOB_PUSH.test(code)
      if (pushes) pushers.set(relative, { routed: POLICY_IMPORT.test(text) && ENGINE_USE.test(code) })
    }
  }
  const listed = new Map(allowlist.map((entry) => [entry.file, entry]))
  const unlisted = []
  for (const [file, info] of pushers) {
    if (!info.routed && !listed.has(file)) unlisted.push(file)
  }
  const stale = []
  const weak = []
  for (const entry of allowlist) {
    const info = pushers.get(entry.file)
    if (!info) stale.push(`${entry.file} (missing or no longer pushes)`)
    else if (info.routed) stale.push(`${entry.file} (now routed through the policy, remove it from the allowlist)`)
    if (!entry.reason || entry.reason.trim().length < 20) weak.push(entry.file)
  }
  return {
    pushers: [...pushers.keys()].sort(),
    routed: [...pushers].filter(([, info]) => info.routed).map(([file]) => file).sort(),
    unlisted: unlisted.sort(),
    stale: stale.sort(),
    weak: weak.sort(),
    pinned: pinned.sort(),
  }
}

/**
 * Scans a DEPLOYED copy of worker scripts that lives outside the repository (for example the running film worker directory) for a
 * pinned fixed batch. Returns the list of files that pin it (F3, 12 October 2026: ResumeMoviesUpload.py and FinishFilteredUploads.py
 * of the deployed worker still set ZR_SHARD_PUSH_BATCH_MB=190, which disables the policy silently).
 * FR : analyse une copie DEPLOYEE de scripts hors depot et rend les fichiers qui figent un lot (la politique est alors coupee).
 */
export function scanPinnedBatches(directory) {
  const pinned = []
  let entries
  try { entries = readdirSync(directory, { withFileTypes: true }) } catch { return pinned }
  for (const entry of entries) {
    if (!entry.isFile() || !SCANNED_EXTENSIONS.has(path.extname(entry.name))) continue
    try { if (PINNED_BATCH.test(readFileSync(path.join(directory, entry.name), 'utf8'))) pinned.push(entry.name) } catch { /* unreadable */ }
  }
  return pinned.sort()
}
