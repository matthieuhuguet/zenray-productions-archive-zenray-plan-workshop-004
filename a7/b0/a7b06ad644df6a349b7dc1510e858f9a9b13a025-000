// push-policy-guard.mjs (12 October 2026): the inventory of every script that runs `git push`, and the rule that none runs outside
// the push batch policy without a written reason.
// EN: a script is OK when it imports lib/push-batch-policy.mjs (routed) or when it is listed in PUSH_ALLOWLIST with a reason. The
//     list is closed on both sides: an unlisted script that pushes fails the guard, and a listed script that no longer pushes (or
//     no longer exists) fails it too, so the list never becomes a graveyard. The guard also refuses a hard coded fixed batch.
// FR : un script est conforme s'il importe la politique (route) ou s'il figure dans PUSH_ALLOWLIST avec une raison ; la liste est
//     fermee des deux cotes (un script qui pousse sans figurer echoue, une entree perimee echoue aussi).
import { readdirSync, readFileSync, statSync, existsSync } from 'node:fs'
import path from 'node:path'

const SCANNED_ROOTS = ['scripts', 'server', 'relay', 'Cloud', 'functions', 'api']
const SCANNED_EXTENSIONS = new Set(['.mjs', '.js', '.cjs', '.py', '.sh', '.ts'])
const SKIPPED_DIRECTORIES = new Set(['node_modules', '_staging', '_archive', '_deprecated', '__fixtures__', 'dist', 'tests', 'release', 'out'])
const TEST_FILE = /\.(test|spec)\.[cm]?[jt]sx?$/
// A quoted `push` word is how every git invocation of this repository names the subcommand (['push', ...], 'push', "push").
const PUSH_LITERAL = /['"]push['"]/
// An actual import of the policy module (a mention in a comment is not routing).
// A shell line `git push ...` / `git -C dir push ...` (the quoted form above does not exist in shell scripts).
const SHELL_PUSH = /^\s*(?:\S+=\S+\s+)*git\s+(?:-[cC]\s+\S+\s+)*push\b/m
// A blob created through the GitHub Git Data API (POST .../git/blobs) is a payload path that has no `push` word (F2, 12 October 2026).
// Reading a blob (GET git/blobs/<sha>) is not matched: the word POST has to sit next to the path.
const API_BLOB_PUSH = /git\/blobs['"`][\s\S]{0,120}?POST|['"]POST['"][\s\S]{0,40}?git\/blobs['"`]/
// Importing the policy is not enough to be routed: the file must USE the engine (a controller or runPushBatch), otherwise it only reads
// numbers from the configuration and runs its own push loop (archive-folder.mjs).
// FR : importer la politique ne suffit pas, il faut utiliser le moteur ; sinon le fichier garde sa propre boucle de push.
const ENGINE_USE = /\b(?:runPushBatch|sharedPushController|createPushController|sharedBatchAdapter)\b/
const stripComments = (text) => text.replace(/\/\*[\s\S]*?\*\//g, '').replace(/^\s*(?:\/\/|#).*$/gm, '')
const POLICY_IMPORT = /(?:\bfrom\s+|\bimport\s*\(\s*)['"][^'"]*push-batch-policy\.mjs['"]/
// The policy and the guard talk about `push` without running it.
const SELF_FILES = new Set(['scripts/lib/push-batch-policy.mjs', 'scripts/lib/push-policy-guard.mjs'])
// A fixed batch written as a literal assignment of the legacy variable (the pin removed from the film worker on 12 October 2026).
const PINNED_BATCH = /ZR_SHARD_PUSH_BATCH_MB['"\]]*\s*(?:\]\s*)?[:=]\s*['"]?\d/

const small = (what) => `${what}: text or a few KiB, never a media payload, far below any push limit.`

