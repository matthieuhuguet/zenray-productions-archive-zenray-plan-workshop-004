export default function FeaturesBoard({ t }) {
  const dark = (t && t.mode === 'dark') || (typeof document !== 'undefined' && document.documentElement.classList.contains('zr-dark'))
  const [open, setOpen] = useState(() => new Set())
  const total = GROUPS.reduce((n, g) => n + g.items.length, 0)
  const card = {
    maxWidth: 980, margin: '0 auto', padding: 'clamp(18px,3vw,34px)',
    background: t.cardBg, borderRadius: 20, boxShadow: SHADOWS.lg, border: `1px solid ${t.border}`,
  }
  return (
    <div style={{ padding: 'clamp(14px,3vw,40px) 8px 80px' }}>
      <div style={card}>
        {/* En-tête hero deux-tons (signature du site) */}
        <div style={{ display: 'flex', alignItems: 'baseline', gap: 10, flexWrap: 'wrap', marginBottom: 4 }}>
          <span style={{ fontFamily: FONTS.sans, fontSize: 30, fontWeight: 800, letterSpacing: '-0.02em', color: t.textPrimary }}>Features</span>
          <span style={{ fontFamily: FONTS.serif, fontSize: 26, fontStyle: 'italic', color: PALETTE.primary }}>tout ce que fait ZenRayProgress</span>
        </div>
        <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: t.textSecondary, marginBottom: 22 }}>{GROUPS.length} domaines · {total} capacités · audit complet du code</div>

        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(300px, 1fr))', gap: 14 }}>
          {GROUPS.map((g, i) => {
            const isOpen = open.has(i)
            return (
              <div key={g.title} className="zr-liquid" style={{ borderRadius: 16, padding: '15px 16px', display: 'flex', flexDirection: 'column', gap: 8 }}>
                <button onClick={() => setOpen((s) => { const n = new Set(s); n.has(i) ? n.delete(i) : n.add(i); return n })}
                  style={{ display: 'flex', alignItems: 'center', gap: 11, width: '100%', textAlign: 'left', background: 'transparent', border: 'none', cursor: 'pointer', padding: 0 }}>
                  <span style={{ display: 'inline-flex', width: 34, height: 34, borderRadius: 10, alignItems: 'center', justifyContent: 'center', background: PALETTE.primarySoft, color: PALETTE.primary, flexShrink: 0 }}><Icon name={g.icon} size={17} weight={1.6} /></span>
                  <span style={{ flex: 1, minWidth: 0 }}>
                    <span style={{ display: 'block', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xl)', fontWeight: 500, color: t.textPrimary }}>{g.title}</span>
                    <span style={{ display: 'block', fontFamily: FONTS.serif, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary, lineHeight: 1.35 }}>{g.desc}</span>
                  </span>
                  <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: t.textSecondary }}>{g.items.length}</span>
                  <Icon name={isOpen ? 'chevron.down' : 'chevron.right'} size={13} weight={1.8} color={t.textSecondary} />
                </button>
                {isOpen && (
                  <div style={{ display: 'flex', flexDirection: 'column', gap: 9, paddingLeft: 45, paddingTop: 2 }}>
                    {g.items.map(([name, what]) => (
                      <div key={name}>
                        <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', fontWeight: 500, color: t.textPrimary }}>{name}</div>
                        <div style={{ fontFamily: FONTS.serif, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary, lineHeight: 1.4 }}>{what}</div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )
          })}
        </div>
      </div>
    </div>
  )
}
