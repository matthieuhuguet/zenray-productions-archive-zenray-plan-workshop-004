describe('video transport configuration', () => {
  it('defaults to the top of the push policy (20 parts, 1 900 MiB) and a fixed batch when the legacy variable is set', () => {
    const partBytes = 95 * 1024 ** 2
    expect(videoRawPushBatchBytes({})).toBe(20 * (partBytes + 16))
    expect(videoRawPushBatchBytes({ ZR_SHARD_PUSH_BATCH_MB: '190' })).toBe(190 * 1024 ** 2)
    expect(videoRawPushBatchBytes({ ZR_SHARD_PUSH_BATCH_MB: '1' }, partBytes)).toBe(partBytes + 16)
  })

  it('caps a repository at 4 096 MiB for new films: 43 parts per repository instead of 21', () => {
    expect(videoRepoCapBytes()).toBe(4096 * 1024 ** 2)
    expect(videoPartsPerShard()).toBe(43)
    expect(Math.floor(videoRepoCapBytes() / (95 * 1024 ** 2 + 16))).toBe(43)
  })

  it('authenticates Git through environment config instead of token-bearing remote URLs', () => {
    const token = 'test-token'
    const env = videoGitAuthEnvironment({ GIT_CONFIG_COUNT: '1', GIT_CONFIG_KEY_0: 'test.key' }, token)
    expect(env.GIT_CONFIG_COUNT).toBe('2')
    expect(env.GIT_CONFIG_KEY_1).toBe('http.https://github.com/.extraheader')
    expect(env.GIT_CONFIG_VALUE_1).toBe(`AUTHORIZATION: basic ${Buffer.from(`x-access-token:${token}`).toString('base64')}`)
  })
})

describe('bounded uploaded transport scratch', () => {
  it('retains pending bytes and rejects paths outside the transport directory', async () => {
    const work = await mkdtemp(path.join(tmpdir(), 'video-scratch-'))
    const dir = path.join(work, 'zenrayshards-vid-test')
    await mkdir(dir)
    const proof = { work, dir, pendingBytes: 1, pendingPaths: [], commit: 'a'.repeat(40) }
    await expect(releaseUploadedShardScratch(proof)).rejects.toThrow('not confirmed')
    await expect(releaseUploadedShardScratch({ ...proof, pendingBytes: 0, dir: path.dirname(work) })).rejects.toThrow('unsafe')
    expect((await stat(dir)).isDirectory()).toBe(true)
    await rm(work, { recursive: true })
  })
  it('releases only the completed transport copy and preserves neighboring source files', async () => {
    const work = await mkdtemp(path.join(tmpdir(), 'video-scratch-'))
    const dir = path.join(work, 'zenrayshards-vid-test')
    await mkdir(dir)
    await writeFile(path.join(work, 'source.mkv'), 'original')
    await releaseUploadedShardScratch({ work, dir, pendingBytes: 0, pendingPaths: [], commit: 'a'.repeat(40) })
    await expect(stat(dir)).rejects.toMatchObject({ code: 'ENOENT' })
    expect((await stat(path.join(work, 'source.mkv'))).size).toBe(8)
    await rm(work, { recursive: true })
  })
})

