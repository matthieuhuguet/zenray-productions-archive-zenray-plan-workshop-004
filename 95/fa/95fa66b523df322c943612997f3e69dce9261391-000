// /api/shared-media — SERVER-SIDE DECRYPTION PROXY, public (no x-zr-auth), for encrypted images.
//
// WHY THIS FILE EXISTS (bug found 2026-07-01): /api/media-key is GATED (x-zr-auth required in prod).
// Image sharing (/view) and shared-gallery thumbnails (/folder) used to decrypt CLIENT-SIDE,
// starting with `fetch('/api/media-key')` — for an anonymous visitor (without the drive code) that
// call returns 401 and the image stays white/broken. Verified in prod: `curl /api/media-key` -> 401.
// Image sharing therefore NEVER actually worked for an external recipient.
//
// FIX: this endpoint decrypts SERVER-SIDE (the key never leaves the server, unlike /api/media-key
// which sends it to the client in clear) and streams the DECRYPTED BYTES directly with the right
// Content-Type. The client (or a WhatsApp/Notion crawler that cannot run JS) no longer needs to
// know the key or do any crypto: a plain <img src="/api/shared-media?path=...&kind=thumb&share=..."> is
// enough. Also serves as the image source for Open Graph meta tags (server/share-og.js).
//
// SECURITY: la route HTTP reste publique (une balise img ne sait pas envoyer x-zr-auth), mais le handler
// exige un jeton de partage valide pour cette image ou un dossier parent. Il n'expose jamais la clé, seulement
// les octets déchiffrés d'une cible explicitement partagée.
import { loadMediaKey } from './media-key.js'
import { createDecipheriv } from 'node:crypto'
import { authorizeShareAccess } from './share-token.js'
import { authorizeShareReach } from './shareReach.js'
import { sansAccent } from './sansAccent.js'
import { readFreshText } from './githubGraphql.js'

const REPO = process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data'
const BRANCH = process.env.CONTENT_BRANCH || 'main'

// AES-GCM: same algo as client-side media/crypto.js (12-byte IV, 16-byte tag at the end of the ciphertext).
function decryptAesGcm(cipherBuf, ivB64, keyB64) {
  const key = Buffer.from(keyB64, 'base64')
  const iv = Buffer.from(ivB64, 'base64')
  const tag = cipherBuf.subarray(cipherBuf.length - 16)
  const data = cipherBuf.subarray(0, cipherBuf.length - 16)
  const decipher = createDecipheriv('aes-256-gcm', key, iv)
  decipher.setAuthTag(tag)
  return Buffer.concat([decipher.update(data), decipher.final()])
}

const mimeForExt = (ext) => ({
  jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', gif: 'image/gif',
  avif: 'image/avif', heic: 'image/heic', bmp: 'image/bmp', tif: 'image/tiff', tiff: 'image/tiff',
}[ext] || 'application/octet-stream')

// jsDelivr can answer 404 or a hiccup for a few seconds after a brand-new commit (a guest's photo, viewed by someone else seconds later):
// retry a little, then ask GitHub itself for the very same pinned file (the shards are public; raw is not rate-limited and has no negative
// cache for a commit that exists). This is only the LAST resort of the viewing proxy: nothing in the upload path touches raw.
const jsdelivrToRaw = (url) => { const m = /^https:\/\/cdn\.jsdelivr\.net\/gh\/([^/]+)\/([^@/]+)@([0-9a-f]{40})\/(.+)$/.exec(url); return m ? `https://raw.githubusercontent.com/${m[1]}/${m[2]}/${m[3]}/${m[4]}` : null }
async function fetchCdn(url, tries = 3) {
  let last = null
  for (let i = 0; i < tries; i++) {
    try { last = await fetch(url); if (last.ok) return last } catch { last = null }
    if (i < tries - 1) await new Promise((r) => setTimeout(r, 600 * (i + 1)))
  }
  const raw = jsdelivrToRaw(url)
  if (raw) { try { const r = await fetch(raw); if (r.ok) return r } catch { /* keep the jsDelivr answer */ } }
  return last || new Response('', { status: 502 })
}

export default async function handler(req, res) {
  if (req.method !== 'GET') { res.setHeader('Allow', 'GET'); return res.status(405).end() }
  const token = process.env.GITHUB_TOKEN
  const path = (req.query.path || '').toString()
  const kind = (req.query.kind || 'full').toString() // 'thumb' | 'full'
  const share = (req.query.share || '').toString()
  if (!token || !path || !/\.img\.json$/.test(path)) return res.status(400).end('bad-request')
  // Le proxy livre des octets DÉCHIFFRÉS : un path deviné ne suffit plus. Le jeton doit viser cette image
  // exactement, ou un dossier parent explicitement partagé. Les anciens liens base64 restent vérifiés ici.
  // Direct scope first; otherwise the image is reachable through a link placed inside the shared folder.
  if (!(await authorizeShareAccess(share, path)) && !(await authorizeShareReach(share, path, { via: (req.query.via || '').toString() }))) return res.status(403).end('invalid-share')
  try {
    const r = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(path)}`, { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })
    // REPLI SANS ACCENT (2026-08-31). Un lien de partage porte le chemin FIGE dans son jeton : les
    // liens emis avant le renommage de pages/Photos visent « 29 Août 2026 » quand le dossier
    // s'appelle desormais « 29 Aout 2026 ». Sans ce repli, le manifeste est introuvable et TOUTES
    // les vignettes de la galerie publique restent vides, sans un message. Meme correctif que dans
    // server/page.js, et pour la meme raison : un identifiant remis a quelqu'un est un contrat.
    let rep = r
    if (!rep.ok) {
      const sans = sansAccent(path)
      if (sans !== path) rep = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(sans)}`, { headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' } })
    }
    let m = null
    if (rep.ok) m = await rep.json()
    // A manifest written minutes ago (a guest's photo) is not on raw.githubusercontent.com yet: read it through GraphQL instead.
    else { const text = await readFreshText(token, path); if (text) { try { m = JSON.parse(text) } catch { m = null } } }
    if (!m) return res.status(404).end('manifest-not-found')
    if (m.vis !== 'public' || !m.cdnRepo || !m.cdnCommit) return res.status(404).end('not-shareable')

    // thumb: m.thumb is already the full jsDelivr URL of the encrypted .webp, never chunked.
    // full: NEW schema (cdnChunks[], 2026-07-07) -> concatenate jsDelivr chunks in order before
    // decrypting (bit-exact). OLD schema (cdnPath, never migrated) -> raw.github, UNCHANGED.
    let iv = null
    let cipherBuf = null
    let chunkBufs = null           // per-chunk encryption (`ivs[]`, photos added by guests): each chunk is its own AES-GCM message
    // kind=thumb-s: the light GRID thumbnail (about 40 KB instead of 300 KB), when the manifest has one; otherwise the standard thumbnail.
    // FR : kind=thumb-s : la vignette légère de grille quand le manifeste en a une, sinon la vignette standard.
    const isThumb = kind === 'thumb' || kind === 'thumb-s'
    const gridThumb = kind === 'thumb-s' && m.thumbS && m.thumbSIv
    if (isThumb && (gridThumb || (m.thumb && m.thumbIv))) {
      const cr = await fetchCdn(gridThumb ? m.thumbS : m.thumb)
      if (!cr.ok) return res.status(404).end('cdn-not-found')
      cipherBuf = Buffer.from(await cr.arrayBuffer())
      iv = gridThumb ? m.thumbSIv : m.thumbIv
    } else if (Array.isArray(m.cdnChunks) && m.cdnChunks.length) {
      iv = m.iv
      const bufs = await Promise.all(m.cdnChunks.map((p) =>
        fetchCdn(`https://cdn.jsdelivr.net/gh/matthieuhuguet/${m.cdnRepo}@${m.cdnCommit}/${p}`).then((x) => (x.ok ? x.arrayBuffer() : Promise.reject(new Error('chunk ' + x.status))))))
      if (Array.isArray(m.ivs) && m.ivs.length === bufs.length) chunkBufs = bufs.map((b) => Buffer.from(b))
      else cipherBuf = Buffer.concat(bufs.map((b) => Buffer.from(b)))
    } else {
      iv = m.iv
      const cdnUrl = `https://raw.githubusercontent.com/matthieuhuguet/${m.cdnRepo}/${m.cdnCommit}/${m.cdnPath}`
      const cr = await fetch(cdnUrl)
      if (!cr.ok) return res.status(404).end('cdn-not-found')
      cipherBuf = Buffer.from(await cr.arrayBuffer())
    }
    if ((!cipherBuf && !chunkBufs) || !iv) return res.status(404).end('no-thumb')

    const key = loadMediaKey()
    const plain = chunkBufs ? Buffer.concat(chunkBufs.map((b, i) => decryptAesGcm(b, m.ivs[i], key))) : decryptAesGcm(cipherBuf, iv, key)

    const ext = isThumb ? 'webp' : (m.ext || 'jpg').toLowerCase()
    res.setHeader('Content-Type', mimeForExt(ext))
    // Hash-addressed content (immutable CDN path) -> long cache is safe.
    res.setHeader('Cache-Control', 'public, max-age=604800, immutable')
    return res.status(200).end(plain)
  } catch (e) {
    return res.status(500).end('decrypt-error: ' + String((e && e.message) || e).slice(0, 120))
  }
}
