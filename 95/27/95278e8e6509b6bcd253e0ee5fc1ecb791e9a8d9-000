import { useCallback, useEffect, useMemo, useRef, useState } from 'react'
import { POSTKIT } from './postkitConfig.js'
import { createClient, loadConfig, saveConfig } from './postkitClient.js'

export function usePostKitConfig() {
  const [config, setConfig] = useState(() => loadConfig())
  const update = useCallback((next) => { setConfig((c) => { const n = { ...c, ...next }; saveConfig(n); return n }) }, [])
  const client = useMemo(() => createClient(config), [config.baseUrl, config.key]) // eslint-disable-line react-hooks/exhaustive-deps (3 October 2026)
  return { config, update, client }
}

// The overview is polled; status is one of connecting | online | offline | unauthorized | error. (3 October 2026)
export function useOverview(client, { refreshMs = POSTKIT.refreshMs } = {}) {
  const [state, setState] = useState({ status: 'connecting', data: null, error: null, loadedAt: null })
  const alive = useRef(true)
  const load = useCallback(async () => {
    if (!client.hasKey) { setState((s) => ({ ...s, status: 'unauthorized', error: null })); return }
    try {
      const data = await client.get('/v1/dashboard')
      if (alive.current) setState({ status: 'online', data, error: null, loadedAt: Date.now() })
    } catch (e) {
      if (!alive.current) return
      setState((s) => ({ ...s, status: e.kind === 'offline' ? 'offline' : e.kind === 'unauthorized' ? 'unauthorized' : 'error', error: e.message }))
    }
  }, [client])
  useEffect(() => { alive.current = true; load(); const id = setInterval(load, refreshMs); return () => { alive.current = false; clearInterval(id) } }, [load, refreshMs])
  return { ...state, reload: load }
}

export function useQuery(client, path, { enabled = true } = {}) {
  const [state, setState] = useState({ data: null, error: null, loading: !!enabled })
  const seq = useRef(0)
  const load = useCallback(async () => {
    if (!enabled || !path) return
    const my = ++seq.current
    setState((s) => ({ ...s, loading: true }))
    try { const data = await client.get(path); if (my === seq.current) setState({ data, error: null, loading: false }) }
    catch (e) { if (my === seq.current) setState({ data: null, error: e.message, loading: false }) }
  }, [client, path, enabled])
  useEffect(() => { load() }, [load])
  return { ...state, reload: load }
}

// Run a write call, track busy and error, then refresh whatever depends on it. (3 October 2026)
export function useAction(after) {
  const [busy, setBusy] = useState(false)
  const [error, setError] = useState(null)
  const run = useCallback(async (fn) => {
    setBusy(true); setError(null)
    try { const r = await fn(); await after?.(); return r } catch (e) { setError(e.message); return null } finally { setBusy(false) }
  }, [after])
  return { run, busy, error, clear: () => setError(null) }
}
