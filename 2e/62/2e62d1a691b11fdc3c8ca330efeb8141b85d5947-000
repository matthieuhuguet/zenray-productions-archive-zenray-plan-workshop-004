// ZenRayMedia — persistance et journal.
//
// Choix assumé pour la V0 : localStorage. Zéro appel réseau, zéro quota GitHub, zéro dépendance
// serveur -> zéro classe de bug entière. La publication vers Create reste une action EXPLICITE
// (bouton), pas un enregistrement implicite : un brouillon raté n'a rien à faire dans le drive.

import { emptyBrief, makeId } from './contracts.js'

const KEY_PROJECTS = 'zrm:projects:v1'
const KEY_CURRENT = 'zrm:current:v1'
const KEY_LOG = 'zrm:log:v1'
const KEY_SERIAL = 'zrm:project-serial:v1'
const LOG_MAX = 60

function read(key, fallback) {
  try {
    const raw = localStorage.getItem(key)
    if (!raw) return fallback
    const parsed = JSON.parse(raw)
    return parsed ?? fallback
  } catch { return fallback }
}

function write(key, value) {
  try { localStorage.setItem(key, JSON.stringify(value)); return true } catch { return false }
}

// --- Projet de démonstration ---------------------------------------------------------------
// Présent au premier lancement pour que l'application ne s'ouvre JAMAIS sur un écran vide :
// une démonstration client commence par quelque chose à regarder, pas par un formulaire.
export const SEED_NOTES = `On croit que le goulot d'étranglement de la création, c'est l'idée. C'est faux : une idée s'écrit en dix minutes.

Ce qui prend des jours, c'est le trajet entre la note et l'objet publiable. Habillage, rythme, typographie, format, export. Ce trajet-là n'est presque jamais fait, et c'est précisément celui qu'une machine sait faire.

Une identité visuelle n'est pas un mystère : c'est un ensemble fini de décisions. Palette, échelle typographique, grille, courbes, texture, rythme de coupe. Un ensemble fini de décisions, c'est un fichier de données.

Donc on ne construit pas un éditeur de plus. On construit une machine à appliquer des directions artistiques à du contenu, et on la nourrit d'un catalogue.

Le résultat tient en une ligne : un brief, mille formes. Change le thème, l'article devient une double page de magazine. Change le format, il devient un vertical de trente secondes.`

// AUDIT — feuille blanche par défaut (2026-08-06, décision de Matthieu) : le tout premier
// lancement (`loadProjects`, aucun projet encore en localStorage) doit ouvrir sur un canevas
// neutre pour reprendre la validation manuelle famille par famille, jamais sur le pitch produit.
// `seedProject()` SANS argument garde intégralement l'ancien comportement (le brief de
// démonstration, SEED_NOTES) : c'est lui que `resetSeed`/« Recharger le brief de démonstration »
// et les fixtures de test continuent d'attendre, un bouton qui promet une démonstration doit
// toujours EN rendre une.
export function seedProject(blank = false) {
  const brief = blank
    ? { ...emptyBrief(), id: makeId('brief', 'seed-zenraymedia', 0), title: 'Sans titre', message: 'Nouveau média.', audience: 'À définir' }
    : {
      ...emptyBrief(),
      id: makeId('brief', 'seed-zenraymedia', 0),
      title: 'Un brief, mille formes',
      message: "Le goulot d'étranglement de la création n'est pas l'idée, c'est la mise en forme.",
      audience: 'Créateurs et studios qui publient trop peu par rapport à ce qu’ils produisent',
      register: 'créateur',
      intent: 'convaincre',
      constraints: { languages: ['fr'], maxDuration: null, mentions: [] },
      evidence: [],
      sources: [],
    }
  // AUDIT P0-T6 · themeId/formatId/docPath/docSha/published APPARTIENNENT au projet, jamais à un
  // état global de la vue : sans ça, passer d'un projet à l'autre garde le contexte du précédent,
  // et ⌘S peut réécrire le fichier Create d'un AUTRE projet avec son SHA.
  return { id: makeId('project', 'seed-zenraymedia', 0), brief, notes: blank ? '' : SEED_NOTES, cut: null, themeId: null, formatId: null, docPath: null, docSha: null, published: null, seed: 1 }
}

export function loadProjects() {
  const list = read(KEY_PROJECTS, null)
  if (Array.isArray(list) && list.length) return list
  const seeded = [seedProject(true)]
  write(KEY_PROJECTS, seeded)
  return seeded
}

export function saveProjects(projects) { return write(KEY_PROJECTS, projects) }

export function loadCurrentId() { return read(KEY_CURRENT, null) }
export function saveCurrentId(id) { return write(KEY_CURRENT, id) }

// AUDIT P0-R8 · un compteur qui ne recule JAMAIS, même après une suppression — exactement le
// rôle que `composition.serial` tient déjà pour les calques (`layers.js`). `list.length` comme
// compteur d'identifiant se reproduit : supprimer le projet du milieu puis en créer un nouveau
// peut redonner la longueur d'un état déjà vu, donc l'identifiant d'un projet encore vivant.
export function nextProjectSerial() {
  const suivant = read(KEY_SERIAL, 0) + 1
  write(KEY_SERIAL, suivant)
  return suivant
}

// --- Journal de fabrication (ZM-L0-11 / ZM-L12-04) --------------------------------------------
// Une ligne par action réelle. Sert la preuve : « ce livrable a été produit, avec ce thème, ce
// format, cette graine ». Le `at` est fourni par l'appelant : ce module ne lit jamais l'horloge
// lui-même, pour rester testable.
export function appendLog(entry) {
  const log = read(KEY_LOG, [])
  const next = [{ ...entry }, ...log].slice(0, LOG_MAX)
  write(KEY_LOG, next)
  return next
}

export function loadLog() { return read(KEY_LOG, []) }
export function clearLog() { write(KEY_LOG, []); return [] }
