    console.error(`  ⚠ cache d'empreintes non écrit, prochaine analyse complète : ${error.message}`)
  }
  finally { if (verrou) await verrou.release() }
}

const skipped = [] // fichiers illisibles/disparus pendant le run : { rel, reason } — JAMAIS silencieux, listés à la fin
const preuveStat = (st) => fileChangeToken({ size: st.size, mtime: st.mtimeMs, ctime: st.ctimeMs })

// ── GROS FICHIERS INSTABLES : ne pas repayer le hachage et l'envoi à chaque passage (2026-08-18) ─────────────
// MESURÉ dans le journal réel : un fichier de 31 Go issu d'un téléchargement torrent encore actif (« The
// Sinking City 2/fg-01.bin ») a été détecté « modifié pendant la lecture » DIX-HUIT FOIS dans la même soirée,
// la dernière quelques minutes avant l'écriture de cette ligne. Chaque tentative hache le fichier en entier,
// le découpe, en pousse parfois plus de vingt gigaoctets, et ne s'aperçoit qu'à la toute fin que le contenu
// avait encore changé pendant l'opération. C'est très exactement ce que Matthieu observait à l'écran : « ça
// dit 13993/13993 fichiers sauvegardés, 100 %, et pourtant ça continue de pousser plusieurs Mo/s ». Le fichier
// n'est pas cassé, il attend la fin d'un téléchargement qui dure des heures ; le hacher en entier pour s'en
// apercevoir après coup est la seule partie qui gaspille, et elle se répétait sans fin.
//
// La parade tient en deux gestes, appliqués aux seuls fichiers assez gros pour que le coût existe.
//
// D'abord un contrôle QUASI GRATUIT avant tout hachage : deux `stat` séparés de quelques secondes, sans lire
// un octet du fichier. Un fichier réellement stable les passe en un instant ; un fichier encore écrit s'y
// trahit sans qu'on ait payé le moindre hachage.
//
// Ensuite un ARRÊT PROGRESSIF pour les fichiers qui échouent malgré ce contrôle — un torrent peut très bien
// écrire entre les deux `stat` et se taire juste après, ce que le contrôle rapide ne peut pas voir. Chaque
// échec, qu'il vienne du contrôle rapide ou de la vérification finale déjà en place plus bas, allonge
// l'attente avant le prochain essai (1, 2, 5, 10, 15 puis 30 minutes), au lieu de retenter à chaque passage
// suivant, parfois quelques minutes plus tard.
const GROS_SEUIL_OCTETS = (Number(process.env.ZR_STABLE_MIN_MO) || 200) * 1024 * 1024
const STABLE_DELAI_MS = Number(process.env.ZR_STABLE_DELAI_MS) || 4000
const BACKOFF_INSTABLE_SEC = [60, 120, 300, 600, 900, 1800]
const CHEMIN_INSTABLES = process.env.ZR_CACHE_INSTABLES
  || (INDEX_ETAT ? path.join(path.dirname(INDEX_ETAT), 'instables-' + path.basename(INDEX_ETAT)) : null)

function lireInstables() {
  if (!CHEMIN_INSTABLES) return new Map()
  try { return new Map(Object.entries(JSON.parse(readFileSync(CHEMIN_INSTABLES, 'utf8')))) }
  catch (error) {
    if (error.code !== 'ENOENT') console.error(`  ⚠ cache d'instabilité illisible, on repart de zéro : ${error.message}`)
    return new Map()
  }
}
async function ecrireInstables(muter) {
  if (!CHEMIN_INSTABLES) return
  let verrou = null
  try {
    verrou = await acquireDirectoryLock(CHEMIN_INSTABLES + '.lock', directoryLockOptions('court', 'cache instabilité ZenRayCloud'))
    const table = lireInstables()
    muter(table)
    await mkdir(path.dirname(CHEMIN_INSTABLES), { recursive: true })
    const temporaire = `${CHEMIN_INSTABLES}.tmp-${process.pid}`
    await writeFile(temporaire, JSON.stringify(Object.fromEntries(table)))
    await rename(temporaire, CHEMIN_INSTABLES)
  } catch (error) {
    // Au pire, le prochain passage retente sans attendre : moins bon, jamais faux.
    console.error(`  ⚠ cache d'instabilité non écrit : ${error.message}`)
  } finally { if (verrou) await verrou.release() }
}
// Chargé UNE SEULE FOIS au début du passage : les échecs que CE passage détecte lui-même ne doivent pas
// s'appliquer à lui-même, sous peine qu'un fichier devienne invisible dès sa première détection au lieu
// d'attendre le vrai backoff au passage suivant.
const tableInstables = lireInstables()
function enAttenteInstable(f) {
  if (f.size < GROS_SEUIL_OCTETS) return false
  const entree = tableInstables.get(f.rel)
  return !!entree && entree.prochainEssai > Date.now()
}
async function noterInstabilite(rel) {
  let fois = 1, delaiMs = BACKOFF_INSTABLE_SEC[0] * 1000
  await ecrireInstables((table) => {
    fois = (table.get(rel)?.fois || 0) + 1
    delaiMs = BACKOFF_INSTABLE_SEC[Math.min(fois - 1, BACKOFF_INSTABLE_SEC.length - 1)] * 1000
    table.set(rel, { fois, prochainEssai: Date.now() + delaiMs })
  })
  return { fois, delaiMs }
}
async function noterStabilite(rel) {
  if (!CHEMIN_INSTABLES || !tableInstables.has(rel)) return   // rien à effacer : on épargne l'écriture disque
  tableInstables.delete(rel)
  await ecrireInstables((table) => table.delete(rel))
}
/** Le contrôle quasi gratuit : deux `stat`, aucune lecture de contenu. `true` si quelque chose a changé entre
 *  les deux, ce qui suffit à prouver qu'un autre processus écrit encore dans ce fichier. */
async function fichierEncoreEnEcriture(f) {
  try {
    const avant = preuveStat(await stat(f.abs))
    await sleep(STABLE_DELAI_MS)
    const apres = preuveStat(await stat(f.abs))
    return avant !== apres
  } catch { return false }   // disparu entre les deux stat : le chemin normal le constatera et le nommera
}

async function hacherTout() {
  if (!files.length) return
  const t0 = Date.now()
  const cache = lireCacheEmpreintes()
  const aHacher = []
  let reutilises = 0, instables = 0
  for (const f of files) {
    // GROS FICHIER DÉJÀ CONNU INSTABLE : le backoff n'est pas écoulé, on ne le hache pas cette passe.
    if (enAttenteInstable(f)) { instables++; continue }
    const c = cache.get(f.rel)
    if (canReuseFingerprint(f, c)) { empreintes.set(f.rel, c.s); reutilises++; continue }
    // GROS FICHIER JAMAIS ENCORE SIGNALÉ INSTABLE : un contrôle quasi gratuit AVANT de payer le hachage complet.
    if (f.size >= GROS_SEUIL_OCTETS && await fichierEncoreEnEcriture(f)) {
      const { delaiMs } = await noterInstabilite(f.rel)
      skipped.push({ rel: f.rel, reason: `fichier volumineux encore en écriture ailleurs, nouvel essai dans ${Math.round(delaiMs / 1000)}s` })
      emit({ ev: 'skip', rel: f.rel, raison: 'instable' })
      console.error(`  ⚠ ENCORE EN ÉCRITURE (contrôle rapide, sans hachage complet) : ${f.rel}`)
      instables++
      continue
    }
    aHacher.push(f)
  }
  if (instables) console.log(`  ${instables} gros fichier(s) instable(s) écarté(s) sans hachage`)
  if (reutilises) console.log(`  ${reutilises} empreinte(s) reprises du cache — ${aHacher.length} à calculer`)
  if (!aHacher.length) {
    // « Rien à hacher » recouvre deux réalités différentes, et les confondre mentirait au journal : soit tout
    // vient du cache (le cas courant), soit une partie a été écartée comme instable (le cas de ce soir-là).
    console.log(instables
      ? `  ${reutilises} empreinte(s) du cache, ${instables} gros fichier(s) instable(s) — rien d'autre à hacher (${(Date.now() - t0) / 1000}s)`
      : `  toutes les empreintes venaient du cache (${(Date.now() - t0) / 1000}s)`)
    emit({ ev: 'progress', seen: files.length, total: files.length, rel: '', size: 0,
      updated: 0, unchanged: reutilises, phase: 'empreintes', lus: 0 })
    return
  }
  const aFaire = aHacher
  const tailleParRel = new Map(aFaire.map((f) => [f.rel, f.size]))
  let suivant = 0, finis = 0, octets = 0
  await new Promise((resolve) => {
    const ouvriers = new Set()
    let resolu = false
    const terminer = () => {
      if (resolu) return
      resolu = true
      for (const w of ouvriers) {
        try { w.postMessage(null) } catch { /* un ouvrier déjà mort ne bloque pas les autres */ }
      }
      resolve()
    }
    const donner = (w) => {
      if (suivant >= aFaire.length) {
        ouvriers.delete(w)
        try { w.postMessage(null) } catch { /* l'ouvrier a déjà quitté */ }
        return
      }
      w.postMessage(aFaire[suivant++])
    }
    const lancerOuvrier = () => {
      const w = new Worker(CODE_OUVRIER, { eval: true })
      ouvriers.add(w)
      w.on('message', (r) => {
        finis++
        if (r.sha) { empreintes.set(r.rel, r.sha); octets += tailleParRel.get(r.rel) || 0 }
        else console.error(`  empreinte à reprendre : ${r.rel} (${r.erreur || 'erreur inconnue'})`)
        if (JSON_OUT && Date.now() - lastEmit > 200) {
          lastEmit = Date.now()
          // LES OCTETS DÉJÀ LUS PARTENT AVEC. Sans eux, l'écran affiche « — Mo/s » pendant toute la phase
          // d'empreintes, qui dure des minutes sur un gros dossier : l'application a l'air arrêtée alors
          // qu'elle lit à plusieurs gigaoctets par seconde. Ce n'est pas le débit RÉSEAU, c'est le débit de
          // lecture, et c'est celui qui a du sens à ce moment-là.
          emit({ ev: 'progress', seen: reutilises + finis, total: files.length, rel: r.rel, size: 0,
            updated: 0, unchanged: reutilises, phase: 'empreintes', lus: octets })
        }
        if (finis % 500 === 0) console.log(`  empreintes ${finis}/${aFaire.length}`)
        if (finis >= aFaire.length) { terminer(); return }
        donner(w)
      })
      w.on('error', (e) => {
        ouvriers.delete(w)
        finis++
        console.error(`  ouvrier d'empreintes arrêté : ${e.message}`)
        if (finis >= aFaire.length) terminer()
        else if (suivant < aFaire.length) lancerOuvrier()
      })
      donner(w)
    }
    for (let i = 0; i < Math.min(HACHE_EN_PARALLELE, aFaire.length); i++) lancerOuvrier()
  })
  // Une erreur de lecture ou la mort d'un thread ne peut pas laisser une empreinte absente en silence. Les
  // rares fichiers concernés sont relus ici, dans le processus principal ; si cette seconde lecture échoue,
  // la passe échoue clairement et sera retentée au lieu d'annoncer une sauvegarde complète.
  const manquantes = aFaire.filter((f) => !empreintes.has(f.rel))
  if (manquantes.length) console.log(`  ${manquantes.length} empreinte(s) reprise(s) après erreur d'ouvrier`)
  for (const f of manquantes) {
    empreintes.set(f.rel, await sha256File(f.abs))
    octets += f.size
  }
  const sec = (Date.now() - t0) / 1000
  console.log(`  ${aFaire.length} empreintes en ${sec.toFixed(1)} s sur ${HACHE_EN_PARALLELE} cœurs (${(octets / 1e9 / Math.max(sec, 0.1)).toFixed(2)} Go/s)`)
  emit({ ev: 'progress', seen: files.length, total: files.length, rel: '', size: 0,
    updated: 0, unchanged: reutilises, phase: 'empreintes', lus: octets })
  // Le cache est réécrit ENTIER à partir de l'état courant : les fichiers disparus en sortent d'eux-mêmes,
  // et il ne peut donc pas grossir indéfiniment ni garder des chemins qui n'existent plus.
  const neuf = new Map()
  for (const f of files) {
    const sha = empreintes.get(f.rel)
    if (sha) neuf.set(f.rel, fingerprintCacheEntry(f, sha))
  }
  await ecrireCacheEmpreintes(neuf)
}
await hacherTout()

// ── 1bis) INDEX DE RÉUTILISATION PAR EMPREINTE ───────────────────────────────
//
// LE CAS QUI COÛTE LE PLUS CHER : déplacer ou renommer un fichier. Pour le script, « Videos/film.mkv » devenu
// « Films/film.mkv » est un chemin inconnu, donc un nouveau fichier : il le redécoupe et le renvoie en entier,
// alors que ses morceaux sont DÉJÀ en ligne, identiques au bit près. Sur un dossier comme Downloads, réorganiser
// une soirée coûterait des dizaines de gigaoctets de téléversement pour zéro octet de contenu nouveau.
//
// LA PARADE : une table empreinte -> manifeste, bâtie une fois depuis les manifestes déjà présents. Quand un
// fichier « nouveau » porte une empreinte déjà connue, on n'envoie RIEN : on écrit un manifeste au nouveau chemin
// qui pointe les mêmes morceaux. Déplacement, renommage, copie et doublon retombent tous sur ce même chemin.
//
// Les `.file.json` alimentent aussi l'index empreinte -> contenu pour réutiliser un binaire déplacé. Les
// manifestes streamables alimentent, eux, chemin -> empreinte source : même preuve, autre schéma de stockage.
const parSha = new Map()
async function indexerManifestes() {
  const racine = path.join(DATA_WORK, DEST)
  const pile = [racine]
  while (pile.length) {
    const dir = pile.pop()
    let entrees = []
    try { entrees = await readdir(dir, { withFileTypes: true }) } catch { continue }
    for (const e of entrees) {
      const abs = path.join(dir, e.name)
      if (e.isDirectory()) { pile.push(abs); continue }
      if (!/\.(file|img|media)\.json$/.test(e.name)) continue
      try {
        const m = JSON.parse(await readFile(abs, 'utf8'))
        if (!m) continue
        if (!e.name.endsWith('.file.json')) {
          const cheminManifeste = path.relative(racine, abs)
          const source = sourceOfStreamManifest(cheminManifeste, m)
          if (source) {
            const precedent = parStreamRel.get(source.rel)
            if (!precedent || source.sha256) {
              parStreamRel.set(source.rel, { ...source, manifest: m, path: `${DEST}/${cheminManifeste}` })
            }
          }
          continue
        }
        // Chemin relatif au dossier surveillé, reconstruit depuis l'emplacement du manifeste ; `m.rel` fait foi
        // quand il est présent, comme partout ailleurs dans ce script.
        const relatif = typeof m.rel === 'string' && m.rel
          ? m.rel
          : path.relative(racine, abs).replace(/\.file\.json$/, '')
        parRel.set(relatif, m)
        if (m.sha256 && !parSha.has(m.sha256)) parSha.set(m.sha256, m)
      } catch { /* manifeste illisible : on l'ignore, le fichier sera simplement re-téléversé, jamais sauté */ }
    }
  }
  if (parSha.size) console.log(`  ${parSha.size} empreinte(s) connue(s) -> déplacements et doublons ne repartiront pas de zéro`)
  if (parStreamRel.size) console.log(`  ${parStreamRel.size} média(s) streamable(s) connu(s) -> aucun renvoi si l'empreinte correspond`)
}
await indexerManifestes()

// ── UN SEUL APPEL REST AVANT DE POUSSER QUOI QUE CE SOIT (2026-08-18, demande de Matthieu) ─────────
//
// LE PROBLÈME QU'IL RÉSOUT. `indexerManifestes()` lit les manifestes sur le DISQUE du clone creux. Ce
// clone est fait avec `--filter=blob:none`, donc les contenus ne descendent qu'à la demande : si le
// sparse-checkout n'a pas tout matérialisé, le moteur ne voit qu'une partie de ce qui existe en ligne,
// conclut que le reste est neuf, et le renvoie. C'est exactement le « les fichiers ont été retraités
// plein de fois successives » que Matthieu observe, et aucune trace d'erreur ne le signale.
//
// LA PARADE TIENT EN UN APPEL. L'API des arbres rend TOUS les chemins d'une destination d'un coup, pour
// une seule lecture de quota — la règle du 2026-07-20 interdit les boucles REST, pas un appel unique.
// On obtient donc la vérité du drive, on la compare à ce que le clone a su lire, et l'écart devient
// visible au lieu de se traduire en gigaoctets renvoyés.
//
// CE QU'ON EN FAIT, ET CE QU'ON N'EN FAIT PAS. Un chemin présent en ligne mais absent du clone est noté
// `presentEnLigne` : le fichier ne sera pas considéré comme neuf. On ne télécharge pas son manifeste
// pour autant, faute de quoi on retomberait dans la boucle REST interdite ; on se contente de savoir
// qu'il existe, ce qui suffit à ne pas le repousser.
const presentEnLigne = new Set()
let dejaEnLigneReleve = 0
const cacheAvantPassage = lireCacheEmpreintes()
async function releverArbreDuDrive() {
  const ref = `main:${DEST.split('/').map(encodeURIComponent).join('/')}`
  const url = `https://api.github.com/repos/${OWNER}/${DATA}/git/trees/${ref}?recursive=1`
  try {
    const r = await fetch(url, {
      headers: { Authorization: `Bearer ${TOKEN}`, 'User-Agent': 'ZenRayCloud' },
      signal: AbortSignal.timeout(60000),
    })
    if (r.status === 404) { console.log('  ⓘ destination jamais écrite : premier passage'); return }
    if (!r.ok) { console.error(`  ⚠ relevé du drive indisponible (${r.status}) — on continue sans lui`); return }
    const j = await r.json()
    if (j.truncated) {
      // Un relevé partiel ferait croire à des absences : on préfère ne rien conclure que conclure faux.
      console.error("  ⚠ arbre tronqué par GitHub — relevé ignoré, aucune conclusion tirée")
      return
    }
    for (const n of j.tree || []) {
      if (n.type !== 'blob' || !n.path.endsWith('.file.json')) continue
      presentEnLigne.add(n.path.replace(/\.file\.json$/, ''))
    }
    const manquants = [...presentEnLigne].filter((rel) => !parRel.has(rel)).length
    console.log(`  ↯ relevé du drive : ${presentEnLigne.size} manifeste(s) en ligne, ${parRel.size} lu(s) dans le clone`)
    if (manquants) {
      console.log(`  ⚠ ${manquants} fichier(s) sont EN LIGNE mais absents du clone creux : ils ne seront pas renvoyés`)
    }
  } catch (e) {
    console.error(`  ⚠ relevé du drive impossible (${(e.message || e).toString().slice(0, 90)}) — on continue sans lui`)
  }
}
await releverArbreDuDrive()

// MIGRATION DES ANCIENS STREAMABLES, SANS RENVOI. Avant `sourceSha256`, leur petit manifeste ne permettait
// pas une comparaison bit à bit. Le journal Git donne cependant une preuve de chronologie : si le manifeste a
// été committé après la dernière écriture locale, il décrit la version encore présente. On ne calcule cette
// table que tant qu'il reste réellement des manifestes anciens à migrer.
if ([...parStreamRel.values()].some((x) => !x.sha256)) {
  const historique = spawnSync('git', ['-C', DATA_WORK, 'log', '--format=ZRC:%ct', '--name-only', '--', `${DEST}/`], {
    encoding: 'utf8', env: GENV, maxBuffer: 64 * 1024 * 1024,
    timeout: LOCAL_GIT_TIMEOUT_MS, killSignal: 'SIGKILL',
  })
  if (historique.status === 0) {
    const dates = parseLatestGitChanges(historique.stdout)
    for (const x of parStreamRel.values()) x.commitAt = dates.get(x.path) || 0
  }
}

// ── 1ter) SUPPRESSIONS (--mark-deleted) ──────────────────────────────────────
// Les manifestes vivent dans le clone sparse de zenray-data sous DEST. Ceux dont le fichier source n'existe
// plus reçoivent `deleted:true` + la date ; on ne touche NI aux versions, NI aux chunks (rien n'est effacé sur
// le drive). Un fichier qui réapparaît plus tard repasse simplement par le chemin normal, qui réécrit son
// manifeste sans le drapeau. Idempotent : un manifeste déjà marqué n'est pas réécrit.
if (MARK_DELETED) {
  const vivants = new Set(files.map((f) => f.rel))
  const ls = git(DATA_WORK, ['ls-files', '--', `${DEST}/`])
  // Les anciens `.media.json` portent parfois un suffixe aléatoire. Leur propre champ `name` permet néanmoins
  // de retrouver la source sans deviner ; les nouveaux écrivent `sourceRel`, qui fait foi directement.
  const suffixes = ['.file.json', '.img.json', '.media.json']
  const aMarquer = []
  for (const p of (ls.stdout || '').split('\n')) {
    const suf = suffixes.find((s) => p.endsWith(s))
    if (!suf) continue
    let m = null
    // Le sparse checkout contient déjà le manifeste. `git show HEAD:<chemin>` lançait un processus par fichier
    // et interprétait les crochets des noms de release comme des motifs ; la lecture disque est directe et exacte.
    try { m = JSON.parse(await readFile(path.join(DATA_WORK, p), 'utf8')) } catch { continue }
    if (!m || m.deleted) continue
    // Le manifeste porte son propre `rel` : il fait foi, l'arithmétique de chemin n'est qu'un repli.
    const relatifManifeste = p.slice(DEST.length + 1)
    const sourceStream = suf === '.file.json' ? null : sourceOfStreamManifest(relatifManifeste, m)
    const rel = typeof m.rel === 'string' && m.rel
      ? m.rel : sourceStream?.rel || (suf === '.media.json' ? null : relatifManifeste.slice(0, -suf.length))
    if (!rel) continue
    // « Exclure » signifie ne pas observer ce sous-arbre, donc ne pas le monter ET ne pas modifier son état
    // distant. Le traiter comme absent marquait supprimés des fichiers qui existent toujours sur le Mac.
    if (estExclu(rel) || (SKIP_NOISE && BRUIT.some((r) => r.test(rel)))) continue
    // Une voie ne juge que sa propre tranche. Comparer sa fraction aux manifestes des autres voies marquerait
    // cinq sixièmes du drive comme supprimés alors que les fichiers existent toujours sur le Mac.
    if (!belongsToPartition(rel, TRANCHE) || vivants.has(rel)) continue
    aMarquer.push({ path: p, content: JSON.stringify({ ...m, deleted: true, deletedAt: new Date().toISOString() }) })
  }
  if (aMarquer.length) {
    for (let i = 0; i < aMarquer.length; i += 600) {
      await commitDataFiles(aMarquer.slice(i, i + 600), `archive ${FOLDER_NAME} : ${aMarquer.length} fichier(s) marqué(s) supprimé(s)`)
    }
    console.log(`  ${aMarquer.length} manifeste(s) marqué(s) deleted:true (aucun chunk effacé)`)
  }
  emit({ ev: 'deleted', count: aMarquer.length })
}

// ── 2) SHARDS LOCAUX (git init + remote public + push incrémental) ──────────
let shardIdx = 0, shard = null, shardDir = null, shardBytes = 0, sincePush = 0, shardCommit = {}
// Octets CONFIRMÉS par un push, et taille de chaque morceau en attente pour pouvoir les additionner.
let octetsPousses = 0
function confirmerTransfert(octets, rail) {
  if (!Number.isFinite(octets) || octets <= 0) return
  octetsPousses += octets
  emit({ ev: 'transfer', envoyes: octetsPousses, bytes: octets, rail })
}
const tailleMorceaux = new Map()
const taillesAttendues = new Map()
// Part du fichier en cours ; elle reste visible jusqu'à la publication finale du dépôt.
let curPart = { shard: null, chunks: [] }
// Le roulement n'a de sens que sur un nom numéroté ; en mono-shard on garde la réouverture historique.
const ROULEMENT = multiShard
// Morceaux écrits depuis le dernier push. Sert à DEUX choses : n'ajouter à l'index que ces chemins-là (jamais un
// `-A` qui rescanne tout l'arbre), et effacer les fichiers du disque une fois qu'ils sont en ligne.
let aPousser = []
// CHAQUE TRANCHE A SES PROPRES DÉPÔTS. Sans cela, trois processus lancés en parallèle visaient le MÊME dépôt de
// morceaux et deux d'entre eux mouraient sur « cannot lock ref refs/heads/main » (mesuré, 2026-08-16). Le suffixe
// de tranche rend toute collision impossible par construction : un dépôt n'a jamais qu'un seul écrivain, donc
// aucun morceau ne peut être confondu ni écrasé, quel que soit le nombre de processus.
const SUFFIXE_TRANCHE = TRANCHE ? `-t${TRANCHE.i + 1}` : ''
function shardName() {
  return multiShard
