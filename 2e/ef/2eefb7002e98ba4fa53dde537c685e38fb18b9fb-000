async function pushChunk() {
  if (!aPousser.length) return true
  // ON N'AJOUTE QUE LES NOUVEAUX CHEMINS. `git add -A` rescanne tout l'arbre de travail à chaque push, ce qui
  // devient absurde passé quelques milliers de morceaux, et surtout empêche d'effacer les morceaux déjà en ligne
  // (ils seraient vus comme des suppressions à committer). En nommant les chemins, on peut libérer le disque.
  const lot = aPousser.slice()
  for (let i = 0; i < lot.length; i += 500) {
    const a = git(shardDir, ['add', '--sparse', '--', ...lot.slice(i, i + 500)])
    if (a.status !== 0) throw new Error('add: ' + (a.stderr || '').slice(-160))
  }
  // Un commit raté avec des morceaux encore staged est fatal. Pousser l'ancien HEAD puis effacer le lot local
  // ferait autrement disparaître des données sans qu'aucune erreur ne soit visible.
  commitStaged(shardDir, '+fichiers', 'morceaux')
  // Résilience push : jusqu'à 40 tentatives, backoff plafonné à 120 s -> survit à une COUPURE INTERNET de ~1 h
  // (incidents 2026-06-12 : push-incr après 4 puis 10 essais, dont une perte DNS « Could not resolve host » de
  // plusieurs minutes, a tué InterviewPablo). Le work dir est PERSISTANT et le commit local est déjà fait : chaque
  // retry repousse le MÊME état (idempotent), donc patienter pendant l'outage puis reprendre est toujours sûr.
  const lotBytes = lot.reduce((n, c) => n + (tailleMorceaux.get(c) || 0), 0)
  const lotTrack = batchPolicy.track(lotBytes, lot.length)
  for (let a = 0; a < PUSH_POLICY.folderMaxAttempts; a++) {
    const pushStartedAt = Date.now()
    const ps = git(shardDir, ['push', '-q', 'origin', 'HEAD:main'], batchPolicy.timeoutMs(lotBytes))
    pushMetrics.recordAttempt({ ok: ps.status === 0, count: lot.length, bytes: lotBytes, durationMs: Date.now() - pushStartedAt, attempt: a + 1 })
    if (ps.status === 0) lotTrack.ok(Date.now() - pushStartedAt)
    else lotTrack.fail(Date.now() - pushStartedAt, (ps.stderr || '') + (ps.stdout || ''))
    if (ps.status === 0) {
      sincePush = 0
      // LE DISQUE NE GONFLE PLUS. Une fois le morceau en ligne et référencé par le commit, sa copie dans l'arbre
      // de travail ne sert plus à rien : on l'efface. Sans cela, sauvegarder 348 Go en exigerait 348 de libre,
      // alors qu'il en reste 420 sur cette machine — on frôlait le disque plein. L'index garde l'entrée, donc
      // rien n'est perdu ni marqué supprimé.
      // LE SEUL INSTANT OÙ DES OCTETS SONT VRAIMENT PARTIS. Le panneau doit compter les morceaux confirmés
      // par Git, y compris lorsqu'un gros fichier n'est pas encore terminé. On additionne
      // donc ce que le push vient de confirmer, ce qui est la définition même d'un octet envoyé.
      confirmerTransfert(lot.reduce((n, c) => n + (tailleMorceaux.get(c) || 0), 0), 'chunk')
      for (const c of lot) tailleMorceaux.delete(c)
      await Promise.all(lot.map((c) => rm(path.join(shardDir, c), { force: true }).catch(() => {})))
      emit({ ev: 'menage', depot: shard, morceaux: lot.length, atelier: shardDir })
      aPousser = aPousser.slice(lot.length)
      // LE COMMIT EST CONNU DÈS MAINTENANT, et il contient TOUS les morceaux poussés jusqu'ici sur ce dépôt,
      // les anciens comme ceux de ce lot. On peut donc publier tout de suite les manifestes des fichiers
      // terminés. Deux gains, et le second vaut plus que le premier : les fichiers apparaissent dans Create au
      // fil de l'envoi au lieu d'attendre la fin, et surtout une interruption ne fait plus rien perdre. Jusqu'ici
      // les manifestes n'étaient écrits qu'à la toute fin : chaque arrêt laissait des morceaux en ligne que plus
      // aucun manifeste ne réclamait, donc du travail entièrement perdu.
      shardCommit[shard] = head(shardDir, shard)
      await publierManifestesPrets()
      return true
    }
    const err = ((ps.stderr || '') + (ps.stdout || '')).toLowerCase()
    // DEUX FAMILLES D'ÉCHEC, ET LES CONFONDRE COÛTAIT LE PASSAGE ENTIER (incident du 2026-08-16).
    // Un échec TRANSITOIRE — DNS perdu, coupure, base en mouvement — se répare en attendant : les quarante
    // tentatives avec attente croissante existent pour cela et elles ont déjà sauvé des envois d'une heure.
    // Un échec DÉFINITIF — dépôt plein, objet trop gros, règle de dépôt violée — ne se répare jamais en
    // réessayant : le même push est refusé quarante fois, puis le script mourait et l'application relançait
    // tout depuis le début, indéfiniment. On distingue donc les deux, et un refus définitif fait ROULER vers
    // un dépôt neuf, ce qui est exactement le geste qui débloque.
    // LE MOTIF ÉTAIT TROP LARGE et se déclenchait sur des messages quasi vides : le journal a montré
    // « refuse définitivement (s) », c'est-à-dire un roulement décidé sur une chaîne d'un caractère. On
    // exige donc un message d'une longueur crédible AVANT de conclure, faute de quoi un hoquet réseau
    // ferait abandonner un dépôt parfaitement sain et fabriquerait des dépôts à l'infini.
    if (isPermanentPushRejection(err)) {
      // 8 October 2026, 21:11 CEST: classify the refusal before writing any diagnostic.
      const rejectionType = classifyPermanentPushRejection(err)
      console.error(`  ⛔ ${shard} refuse définitivement (${rejectionType})`)
      emit({ ev: 'rollover', depot: shard, raison: 'refus définitif ; reprise requise', rejectionType })
      throw new Error(`push-refus-definitif ${shard} ${rejectionType}`)
    }
    console.error(`  push retry ${a + 1}/${PUSH_POLICY.folderMaxAttempts}`, (ps.stderr || '').slice(-140))
    await sleep(Math.min(120000, 4000 * (a + 1)))
  }
  return false
}

async function flushShard() {
