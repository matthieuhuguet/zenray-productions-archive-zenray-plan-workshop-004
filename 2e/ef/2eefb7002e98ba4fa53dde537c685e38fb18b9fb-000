async function publierVraiment(publiables) {
  const blobs = publiables.map(construireBlobManifeste)
  for (let i = 0; i < blobs.length; i += 600) {
    await commitDataFiles(blobs.slice(i, i + 600), `archive ${FOLDER_NAME} (+${blobs.length} au fil de l'envoi)`)
  }
  manifestesPublies += publiables.length
  for (const r of publiables) { const k = prets.indexOf(r); if (k >= 0) prets.splice(k, 1); r.publie = true }
  console.log(`  📤 ${publiables.length} manifeste(s) en ligne (${manifestesPublies} au total) — visibles dans Create`)
  emit({ ev: 'manifests', done: manifestesPublies, total: manifestesPublies + prets.length })
