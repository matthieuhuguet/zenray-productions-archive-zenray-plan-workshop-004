    // recomparée après chaque lecture, y compris sur les rails streamables qui quittaient autrefois la boucle.
    empreinteTemps = fileChangeToken(currentFile)
  } catch (e) { skipped.push({ rel: f.rel, reason: 'disparu (' + (e.code || 'stat') + ')' }); emit({ ev: 'skip', rel: f.rel, raison: 'disparu' }); console.error(`  ⚠ SKIP (source disparue) ${f.rel}`); continue }
  // L'empreinte a déjà été calculée en parallèle plus haut ; on ne relit le fichier que si elle manque
  // OU si le fichier a changé depuis l'inventaire. Sans ce second test, un fichier traité une heure après le
  // hachage pouvait publier ses nouveaux octets avec l'ancienne empreinte.
  let sha = empreintes.get(f.rel)
  if (!canUseInventoryFingerprint(f, currentFile, sha)) {
    sha = await sha256File(f.abs)
    if (!await confirmerSourceStable(f, empreinteTemps)) continue
    empreintes.set(f.rel, sha)
  }
  // VERSIONNING : si le fichier est IDENTIQUE à sa dernière version (même sha256), on ne re-chunke RIEN et on
  // ne réécrit pas son manifeste -> zéro duplication. Sinon (nouveau OU modifié) on ajoute une nouvelle version.
  const existing = readExistingManifest(f.rel)
  const prevVersions = versionsOf(existing)
  const latest = prevVersions[prevVersions.length - 1]
  if (latest && latest.sha256 === sha) {
    // LE FICHIER EST REVENU. Il avait été marqué supprimé, le voilà de nouveau là, identique. On n'envoie rien,
    // mais on RETIRE le drapeau : sans cela il resterait barré à vie dans Create alors qu'il existe sur le disque.
    if (existing && existing.deleted) {
      const propre = { ...existing }
      delete propre.deleted; delete propre.deletedAt
      restaures.push({ path: `${DEST}/${f.rel}.file.json`, content: JSON.stringify(propre) })
      annexesEnAttente.push(restaures[restaures.length - 1])
      console.log(`  ↩ revenu, drapeau supprimé retiré : ${f.rel}`)
      if (annexesEnAttente.length >= BATCH_COMMIT) await flushAnnexes()
    }
    unchanged++; continue
  }

  // LE RELEVÉ REST TRANCHE QUAND LE CLONE EST INCOMPLET (2026-08-18). Le clone creux ne matérialise pas
  // toujours tous les manifestes : un fichier bel et bien EN LIGNE peut donc être absent de `parRel`, et
  // le moteur le renvoyait alors intégralement. C'est la cause du « les fichiers ont été retraités plein
  // de fois successives ». L'unique appel à l'API des arbres, fait au démarrage, connaît la vérité du
  // drive ; on s'y fie plutôt qu'au disque, et on le DIT pour que ce ne soit jamais un saut muet.
  //
  // On ne saute que si l'empreinte locale est INCHANGÉE depuis le cache : un fichier modifié doit repartir,
  // même s'il existe en ligne, sans quoi la nouvelle version ne serait jamais publiée.
  if (!existing && presentEnLigne.has(f.rel) && cacheAvantPassage.get(f.rel)?.s === sha) {
    console.log(`  ⏭ déjà en ligne (relevé du drive), non renvoyé : ${f.rel}`)
    dejaEnLigneReleve++
    unchanged++
    continue
  }

  // IMAGES, VIDÉOS, AUDIO ET PDF ONT LE MÊME CONTRAT D'IDEMPOTENCE. Les anciens rails streamables étaient
  // absents de `parRel`, si bien que chaque balayage recréait des dépôts et renvoyait les mêmes gigaoctets.
  // Une empreinte source identique prouve que le nœud existant correspond exactement aux octets présents.
  const streamExistant = parStreamRel.get(f.rel)
  if (streamExistant?.sha256 === sha) {
    if (streamExistant.manifest.deleted) {
      const propre = { ...streamExistant.manifest }
      delete propre.deleted; delete propre.deletedAt
      streamBlobs.push({ path: streamExistant.path, content: JSON.stringify(propre) })
      console.log(`  ↩ revenu, drapeau supprimé retiré : ${f.rel}`)
    }
    unchanged++
    continue
  }
  if (streamExistant && !streamExistant.sha256
      && canAdoptSourceHash(streamExistant.manifest, curSize, currentMtime, streamExistant.commitAt)) {
    const propre = { ...streamExistant.manifest }
    delete propre.deleted; delete propre.deletedAt
    streamBlobs.push(enrichStreamManifest({ path: streamExistant.path, content: JSON.stringify(propre) }, f.rel, sha))
    migrationsStream++
    unchanged++
    continue
  }

  // DÉPLACÉ, RENOMMÉ, COPIÉ, OU SIMPLE DOUBLON : la même empreinte existe déjà ailleurs sous ce dossier. Ses
  // morceaux sont en ligne, identiques au bit près, et rien ne justifie de les renvoyer. On écrit un manifeste au
  // nouveau chemin qui pointe les mêmes morceaux, et l'ancien sera marqué supprimé par `--mark-deleted` s'il a
  // vraiment disparu. Coût : zéro octet monté. C'est le cas le plus fréquent sur un dossier qu'on réorganise.
  const jumeau = parSha.get(sha)
  const vJumeau = jumeau ? versionsOf(jumeau).slice(-1)[0] : null
  if (vJumeau && (vJumeau.parts || vJumeau.chunks)) {
    const partsJ = Array.isArray(vJumeau.parts) && vJumeau.parts.length
      ? vJumeau.parts
      : [{ repo: vJumeau.repo, commit: vJumeau.commit, chunks: vJumeau.chunks || [] }]
    const premiere = partsJ[0] || { repo: null, commit: null, chunks: [] }
    const cur = { ts: new Date().toISOString(), size: curSize, sha256: sha, chunkSize: vJumeau.chunkSize || CHUNK,
      parts: partsJ, repo: premiere.repo, commit: premiere.commit, chunks: premiere.chunks || [] }
    reutilises.push({
      path: `${DEST}/${f.rel}.file.json`,
      content: JSON.stringify({ type: 'file', v: 4, name: path.basename(f.rel), rel: f.rel, mime: mimeOf(f.rel),
        mode: 'chunked', size: cur.size, sha256: cur.sha256, chunkSize: cur.chunkSize, parts: cur.parts,
        repo: cur.repo, commit: cur.commit, chunks: cur.chunks, versions: [...prevVersions, cur] }),
    })
    parSha.set(sha, { ...jumeau, rel: f.rel })
    // On garde d'où il vient : c'est ce qui permet d'afficher « déplacé depuis … » au lieu de faire croire à un
    // nouveau fichier surgi de nulle part.
    try { const o = JSON.parse(reutilises[reutilises.length - 1].content); o.depuis = jumeau.rel; reutilises[reutilises.length - 1].content = JSON.stringify(o) } catch {}
    annexesEnAttente.push(reutilises[reutilises.length - 1])
    if (annexesEnAttente.length >= BATCH_COMMIT) await flushAnnexes()
    done++
    console.log(`  ⇄ déjà en ligne sous un autre nom, rien à envoyer : ${f.rel}`)
    continue
  }

  // ── ROUTAGE UNIFIÉ (refactor unified-ingest) : AVANT le chunk binaire ───────────────────────────────
  // classify (module pur partagé) décide la pipeline. Tout format OUVRABLE (image/vidéo/audio/pdf) sort du
  // chunk vers son rail streamable. SEUL le binaire non ouvrable (projets/zip/RAW/propriétaire) descend dans
  // le code chunk legacy ci-dessous, INTACT. C'est la garde qui protège les 130 Go .file.json existants :
  // le chemin chunk n'est jamais modifié, on lui retire seulement les fichiers qui n'avaient rien à y faire.
  const { kind, pipeline: railClasse } = classify({ name: f.rel, mime: mimeOf(f.rel) })
  // Le classificateur partagé nomme encore `hls` le rail vidéo du navigateur. L'archive conserve désormais
  // l'original au bit près ; son protocole annonce donc `video`, sans changer le classificateur des captures web.
  const railArchive = normaliserRailArchive(railClasse)
  const pipeline = bornerRailMemoire(railArchive, curSize)
  if (pipeline !== railArchive) console.log(`  ⓘ ${kind} de ${(curSize / 1048576).toFixed(0)} Mio : rail chunké en flux, mémoire protégée`)
  emit({ ev: 'route', pipeline, rel: f.rel, size: curSize, seen, files: files.length })
  if (pipeline === 'img' && imgCtx) {
    let pending = null
    try {
      pending = await ingestImageBulk(f.abs, f.rel, DEST, imgCtx)
    } catch (e) {
      console.error(`  ⚠ image -> repli chunk (${(e.message || e).toString().slice(0, 100)}) ${f.rel}`)
    }
    if (pending) {
      if (!await confirmerSourceStable(f, empreinteTemps)) continue
      pending.sourceRel = f.rel; pending.sourceSha256 = sha
      imgPending.push(pending); streamedImg++; done++
      if (done % 25 === 0) console.log(`  [${done} maj] image -> .img.json (streamable) ${f.rel}`)
      // L'échec de PUBLICATION reste hors du catch d'ingestion : il arrête et rend le passage reprenable, au
      // lieu de rechunker en double la dernière image tout en gardant son manifeste en attente.
      if (streamBatchPret()) await flushStreamBatch()
      continue
    }
    // chute volontaire vers le chunk si l'ingestion image a échoué (jamais perdre le fichier)
  } else if (pipeline === 'video') {
    const res = await ingestVideoBulk(f.abs, f.rel, destDirOf(f.rel), mediaCtx, sha)
    if (res) {
      if (!await confirmerSourceStable(f, empreinteTemps)) continue
      streamBlobs.push(res.manifestBlob); streamedVid++; done++
      if (streamBatchPret()) await flushStreamBatch()
      console.log(`  [${done} maj] vidéo exacte -> .media.json ${f.rel}`)
      continue
    }
    // null = serveur/ffmpeg absent ou échec -> repli chunk (intact)
  } else if (pipeline === 'media') {
    const res = await ingestMediaBulk(f.abs, f.rel, mimeOf(f.rel), kind, destDirOf(f.rel), mediaCtx)
    if (res) {
      if (!await confirmerSourceStable(f, empreinteTemps)) continue
      streamBlobs.push(enrichStreamManifest(res.manifestBlob, f.rel, sha)); streamedMedia++; done++
      console.log(`  [${done} maj] ${kind} -> chunked-media (streamable) ${f.rel}`)
      if (streamBatchPret()) await flushStreamBatch()
      continue
    }
    // null = serveur/clé absent ou échec -> repli chunk (intact)
  }
  // pipeline === 'chunk' (ou repli ci-dessus) : CODE CHUNK LEGACY .file.json, STRICTEMENT INCHANGÉ.
  await assurerShard()
  const fid = fidOf(f.rel)
  // Manifeste v4 : rec.parts[] = [{shard, chunks[]}]. Un GROS fichier traverse plusieurs shards (rollover
  // MID-FILE) -> ses chunks sont répartis en plusieurs parts, chacune sur son shard ≤5 Go. Reassemblage =
  // concaténation des chunks de toutes les parts, dans l'ordre (ci monotone).
  const tailleMorceau = storageChunkFor(curSize)
  const rec = { rel: f.rel, size: curSize, mime: mimeOf(f.rel), sha256: sha, prevVersions, parts: [], chunkSize: tailleMorceau }
  curPart = { shard, chunks: [] }
  const fd = await open(f.abs, 'r')
  const buf = Buffer.alloc(8 * 1024 * 1024)
  let ci = 0, pos = 0
  try {
    do {
      // ROLLOVER MID-FILE : si le shard courant atteint le cap, on le flushe et on en ouvre un nouveau AVANT
      // d'écrire le prochain chunk — y compris au MILIEU d'un fichier. Garantit shard ≤5 Go en toute circonstance.
      if (multiShard && shardBytes >= SHARD_CAP) {
        if (curPart.chunks.length) rec.parts.push(curPart)
        // LE SHARD FINI QUITTE LE DISQUE. Effacer les morceaux de l'arbre de travail après chaque push ne suffit
        // pas : leurs objets restent dans le `.git` du shard, qui pèse donc sa taille pleine, ici quatre gigaoctets
        // et demi. Sur trois cent quarante-huit gigaoctets, cela ferait soixante-dix-sept dossiers et autant de
        // fois quatre gigaoctets et demi, soit le disque plein bien avant la fin. Une fois le shard poussé et son
        // commit noté, il n'a plus aucune utilité locale : on le supprime, et le suivant repart à zéro.
        const ancien = shardDir
        await flushShard()
        await rm(ancien, { recursive: true, force: true }).catch(() => {})
        shardIdx++; await openShard()
        curPart = { shard, chunks: [] }
      }
      const cname = chunkPath(fid, ci)
      const cdst = path.join(shardDir, cname)
      await mkdir(path.dirname(cdst), { recursive: true })
      const out = createWriteStream(cdst)
      let written = 0
      while (written < tailleMorceau && pos < curSize) {
        const { bytesRead } = await fd.read(buf, 0, Math.min(buf.length, tailleMorceau - written), pos)
        if (!bytesRead) break
        await new Promise((res, rej) => out.write(buf.subarray(0, bytesRead), (e) => e ? rej(e) : res()))
        written += bytesRead; pos += bytesRead
      }
      await new Promise((res) => out.end(res))
      curPart.chunks.push(cname); aPousser.push(cname); tailleMorceaux.set(cname, written)
      // Taille attendue, gardée pour la vérification finale : c'est le seul chiffre qui permette de
      // distinguer un morceau complet d'un morceau tronqué servi avec un statut 200.
      taillesAttendues.set(cname, written); ci++
      shardBytes += written; sincePush += written
      // LES OCTETS COMPTENT DÈS QU'ILS SONT ÉCRITS, PAS À LA FIN DU FICHIER. Pendant les vingt minutes que
      // prend un film de sept gigaoctets, le total progresse donc au fil de l'eau, et `pos` cesse d'être
      // ajouté deux fois puisqu'il est désormais inclus dans le cumul.
      // PROGRESSION FINE. Sans elle, un fichier de six gigaoctets fige l'affichage pendant de longues minutes :
      // le compteur de FICHIERS ne bouge pas, et l'app a l'air plantée alors qu'elle travaille. On dit donc où on
      // en est DANS le fichier, bridé à cinq lignes par seconde comme le reste.
      if (JSON_OUT && Date.now() - lastEmit > 200) {
        lastEmit = Date.now()
        emit({ ev: 'chunk', rel: f.rel, done: pos, total: curSize, seen, files: files.length,
          envoyes: octetsPousses, depot: shard, morceau: ci, morceaux: Math.ceil(curSize / tailleMorceau),
          tailleMorceau, atelier: shardDir })
      }
      if (shouldFlushChunkBatch(sincePush, PUSH_CHUNK)) {
        PUSH_CHUNK = Math.min(pushMax(), Math.round(PUSH_CHUNK * PUSH_POLICY.folderPushRampFactor))   // on amortit à mesure qu'on prend le rythme
        if (JSON_OUT) { lastEmit = Date.now(); emit({ ev: 'chunk', rel: f.rel, done: pos, total: curSize, seen,
          files: files.length, envoyes: octetsPousses, depot: shard, morceau: ci,
          morceaux: Math.ceil(curSize / tailleMorceau), tailleMorceau, atelier: shardDir, poussee: true }) }
        if (!await pushChunk()) throw new Error('push-incr')
      }
    } while (pos < curSize)
  } finally { await fd.close().catch(() => {}) }
  if (curPart.chunks.length) rec.parts.push(curPart)
  // LE FICHIER A-T-IL BOUGÉ PENDANT QU'ON LE LISAIT ? Si Matthieu enregistre par-dessus, ou qu'un
  // téléchargement se termine pendant la découpe, les octets envoyés ne correspondent plus à l'empreinte
  // calculée au départ. Publier ce manifeste écrirait un mensonge vérifiable : sha256 annoncé qui ne
  // correspond pas au contenu. On refuse donc de le publier, on le signale, et le passage suivant le refera
  // proprement. Les morceaux déjà poussés restent en ligne sans être référencés : de la place perdue, jamais
  // une archive fausse.
  if (!await confirmerSourceStable(f, empreinteTemps)) continue

  records.push(rec); prets.push(rec); done++
  // Les petits fichiers partent en lot au seuil de données. Le reliquat est toujours envoyé par flushShard,
  // tandis que les gros fichiers continuent de pousser leurs morceaux pendant leur lecture.
  if (done % 25 === 0 || curSize > RAW_MAX) console.log(`  [${done} maj / ${unchanged} inchangés / ${skipped.length} skip / ${files.length}] ${f.rel} (${(curSize / 1048576).toFixed(1)} Mo, ${ci} chunk(s)${rec.parts.length > 1 ? `, ${rec.parts.length} parts` : ''}) [shard ${(shardBytes / 1073741824).toFixed(2)} Go]`)
 } catch (e) {
  // 12 October 2026: a failed repo creation (GitHub secondary rate limit, 403) used to be swallowed here: the next files wrote
  // their chunks, pushed 40 times to a shard WITHOUT a remote (51 min of pauses) and the service killed the run at 900 s.
  // It is fatal now: the service retries the whole run a minute later, from a clean state.
  // FR : un echec de creation de depot est fatal ; avant, 51 minutes de push sans remote avant le kill a 900 s.
  if (/push-|repo-create/.test(e.message)) throw e // erreur réseau/push = fatale, on ne perd pas de données
  skipped.push({ rel: f.rel, reason: e.code || e.message }); console.error(`  ⚠ SKIP (${e.code || e.message}) ${f.rel}`)
 }
}
if (shard) await flushShard()

// ── 3bis) RESTE des manifestes streamables (dernier lot < 256 + manifestes audio en attente). Le gros a déjà
// été committé par lots de 256 PENDANT la boucle (flushStreamBatch) -> visible au fil de l'eau, plus de "vide".
await flushStreamBatch()

// ANNEXES : manifestes écrits sans aucun transfert (réutilisations et restaurations). Committés AVANT le test
// « rien de neuf » plus bas, sinon un run qui n'aurait fait que déplacer des fichiers sortirait sans rien écrire.
await flushAnnexes()
const annexes = [...reutilises, ...restaures]
if (annexes.length) {
  console.log(`  ${reutilises.length} manifeste(s) réutilisé(s) sans transfert, ${restaures.length} restauré(s)`)
}

console.log(`\n${records.length} fichier(s) chunk · ${streamedImg} image(s) · ${streamedVid} vidéo(s) exacte(s) · ${streamedMedia} audio/pdf · ${unchanged} inchangé(s)`)
if (migrationsStream) console.log(`  ${migrationsStream} ancien(s) manifeste(s) streamable(s) enrichi(s) sans renvoi de données`)
if (skipped.length) {
  console.error(`\n⚠ ${skipped.length} fichier(s) IGNORÉS (disparus/illisibles pendant le run) — NON archivés, source à conserver :`)
  for (const s of skipped) console.error(`    - ${s.rel} (${s.reason})`)
}

if (!records.length) {
  // Rien à chunker, mais on a peut-être créé des nœuds streamables (gérés ci-dessus). Reindex éventuel + sortie.
  const totalStreamables = streamPublies.size
  if (totalStreamables && REINDEX) reconstruireIndexRecherche()
  await ecrireIndexEtat(cataloguePourIndex(), [], [...reutilises, ...restaures], DEST)
  console.log(totalStreamables ? `\n=== TERMINÉ — ${totalStreamables} nœud(s) streamable(s), 0 chunk ===` : 'Rien de neuf à archiver — toutes les versions sont à jour.')
if (dejaEnLigneReleve) console.log(`  ⏭ ${dejaEnLigneReleve} fichier(s) déjà en ligne d'après le relevé du drive : aucun octet renvoyé`)
  emit({ ev: 'done', chunked: 0, images: streamedImg, videos: streamedVid, media: streamedMedia, unchanged, reused: reutilises.length, restored: restaures.length, skipped: skipped.map((x) => x.rel), verifyKo: 0 })
  await rm(WORK, WORK_CLEANUP).catch(() => {})
  process.exit(0)
}

// ── 4) MANIFESTES .file.json dans zenray-data (lots de 600, arbre inline) ───
// Manifeste v4 : `parts[]` = [{repo, commit, chunks[]}] (un fichier peut s'étaler sur PLUSIEURS shards ≤5 Go).
// versions[] APPEND-ONLY ; chaque version porte ses propres parts. Top-level repo/commit/chunks = 1re part
// (rétro-compat lecteurs v2/v3 mono-shard : un fichier ≤5 Go a une seule part, donc reste lisible tel quel).
// Il ne reste ici que les fichiers dont le manifeste n'a pas déjà été publié au fil de l'envoi.
const blobs = records.filter((r) => !r.publie).map(construireBlobManifeste)
console.log(`\nmanifestes: ${blobs.length} .file.json -> ${DATA}:${DEST}`)
// LA MÊME FAUTE QU'AILLEURS, COMMISE À UN SECOND ENDROIT (2026-08-18). `publierManifestesPrets` sait déjà
// qu'un manifeste non publié ne justifie pas de mourir : les morceaux sont en ligne, ils portent les données,
// et le manifeste n'est que la carte qui dit où ils se trouvent. Cette boucle-ci, la publication de fin de
// passage, ne portait pas ce garde-fou : une contention sur `zenray-data` y jetait une exception, le
// processus sortait en code 1, et l'application déclarait en échec un passage qui venait de tout sauvegarder
// et de passer sa vérification à seize sur seize.
let manifestesDifferes = 0
for (let i = 0; i < blobs.length; i += 600) {
  const lot = blobs.slice(i, i + 600)
  try {
    await commitDataFiles(lot, `archive ${FOLDER_NAME} (${i + 1}-${Math.min(i + 600, blobs.length)}/${blobs.length})`)
    console.log(`  manifestes ${Math.min(i + 600, blobs.length)}/${blobs.length} ✓`)
    emit({ ev: 'manifests', done: Math.min(i + 600, blobs.length), total: blobs.length })
  } catch (e) {
    manifestesDifferes += lot.length
    console.error(`  ⚠ manifestes non publiés cette fois (${(e.message || e).toString().slice(0, 160)})`)
    console.error('    les morceaux SONT en ligne ; la carte sera réécrite au prochain passage, sans renvoi')
    emit({ ev: 'manifests-differes', combien: lot.length })
    break   // la cause est la même pour les lots suivants : insister ne ferait qu'allonger le passage
  }
}
if (manifestesDifferes) console.log(`ⓘ ${manifestesDifferes} manifeste(s) différé(s) au prochain passage`)

// ── 5) VÉRIF 200 (raw.githubusercontent, parallèle x16) sur TOUT (toutes les parts) ─────────────
const urls = []
for (const r of records) {
  for (const pt of r.parts) { const c = shardCommit[pt.shard]; for (const ch of pt.chunks) urls.push({ chunk: ch, url: `https://raw.githubusercontent.com/${OWNER}/${pt.shard}/${c}/${ch.split('/').map(encodeURIComponent).join('/')}` }) }
}
console.log(`vérification ${urls.length} URLs ...`)
let vi = 0, ko = 0
await Promise.all(Array.from({ length: 16 }, async () => {
  while (vi < urls.length) {
    const { url: u, chunk } = urls[vi++]
    let vu = { status: 0, octets: 0 }
    for (let a = 0; a < 3 && vu.status !== 200; a++) { vu = await headTaille(u); if (vu.status !== 200) await sleep(800 * (a + 1)) }
    if (vu.status !== 200) { ko++; console.error(`  vérif KO (${vu.status}) ${u.slice(-80)}`); continue }
    const attendu = taillesAttendues.get(chunk)
    // On ne juge que ce qu'on connaît : un morceau écrit lors d'un passage antérieur n'a pas sa taille
    // ici, et l'absence de référence n'est pas une preuve d'erreur.
    if (attendu && vu.octets && vu.octets !== attendu) {
      ko++
      console.error(`  vérif KO (taille ${vu.octets} au lieu de ${attendu}) ${u.slice(-80)}`)
    }
  }
}))
console.log(ko === 0 ? `vérif COMPLÈTE : ${urls.length}/${urls.length} OK ✓` : `vérif: ${ko} KO sur ${urls.length} — NE PAS PURGER`)
emit({ ev: 'verify', total: urls.length, ko })

// ── 6) fin : reindex optionnel + consigne de purge (JAMAIS auto) ─────────────
if (REINDEX && ko === 0) {
  console.log('reindex ...')
  reconstruireIndexRecherche()
}
await ecrireIndexEtat(cataloguePourIndex(), records, [...reutilises, ...restaures], DEST)
await rm(WORK, WORK_CLEANUP)
emit({ ev: 'done', chunked: records.length, images: streamedImg, videos: streamedVid, media: streamedMedia, unchanged, reused: reutilises.length, restored: restaures.length, skipped: skipped.map((x) => x.rel), verifyKo: ko })
{
  const pushSummary = pushMetrics.summary()
  if (pushSummary.attempts) console.log(`  push measures: ${pushSummary.batches} push(es), ${pushSummary.failedAttempts} failed attempt(s), average ${(pushSummary.averageThroughputBps / 1048576).toFixed(1)} MiB/s, effective ${(pushSummary.effectiveThroughputBps / 1048576).toFixed(1)} MiB/s`)
}
