async function ecrireIndexEtat(parRelMap, recs, annexesBlobs, dest) {
  if (!INDEX_ETAT) return
  // L'index porte de quoi bâtir un TABLEAU sans toucher au réseau : pour chaque fichier, sa taille, son nombre
  // de versions, la date du premier et du dernier envoi, et son chemin précédent s'il a été déplacé. Tout cela
  // vit déjà dans les manifestes ; on ne fait que le rassembler là où l'app peut le lire instantanément.
  const fiches = new Map()
  const depuisManifeste = (rel, m, cheminManifeste) => {
    fiches.set(rel, stateCardFromManifest(rel, m, cheminManifeste))
  }
  for (const [rel, entree] of parRelMap) depuisManifeste(rel, entree.manifest, entree.path)
  for (const r of recs) fiches.set(r.rel, { rel: r.rel, taille: r.size, sha: r.sha256,
    versions: (r.prevVersions || []).length + 1, premier: ((r.prevVersions || [])[0] || {}).ts || new Date().toISOString(),
    dernier: new Date().toISOString(), supprime: false, depuis: r.depuis || null,
    manifeste: `${r.rel}.file.json` })
  for (const b of annexesBlobs) {
    const cheminManifeste = b.path.slice(dest.length + 1)
    depuisManifeste(cheminManifeste.replace(/\.file\.json$/, ''), JSON.parse(b.content), cheminManifeste)
  }
  let verrou = null
  try {
    verrou = await acquireDirectoryLock(INDEX_ETAT + '.lock', directoryLockOptions('court', 'index ZenRayCloud'))
    // Une voie peut avoir cloné les manifestes avant que sa voisine publie les siens. On reprend donc l'index
    // déjà écrit sous verrou, puis la voie courante remplace uniquement les fiches qu'elle connaît.
    try {
      const precedent = JSON.parse(await readFile(INDEX_ETAT, 'utf8'))
      const fusion = mergePreviousStateCards(fiches, precedent.fiches,
        (rel) => !TRANCHE || belongsToPartition(rel, TRANCHE))
      fiches.clear()
      for (const [rel, fiche] of fusion) fiches.set(rel, fiche)
    } catch (error) {
      if (error.code !== 'ENOENT') console.error(`  ⚠ index précédent illisible, reconstruction : ${error.message}`)
    }
    await mkdir(path.dirname(INDEX_ETAT), { recursive: true })
    const temporaire = `${INDEX_ETAT}.tmp-${process.pid}`
    await writeFile(temporaire, JSON.stringify({ src: SRC, dest, at: new Date().toISOString(),
      rels: [...fiches.keys()], fiches: [...fiches.values()] }))
    await rename(temporaire, INDEX_ETAT)
    console.log(`  index d'état : ${fiches.size} fiche(s)`)
  } finally { if (verrou) await verrou.release() }
}
