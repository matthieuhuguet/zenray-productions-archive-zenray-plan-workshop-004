const SHARD_CFG = [['user.email', 'bot@zenray'], ['user.name', 'zenray-bot'],
  ['gc.auto', '0'], ['gc.autoDetach', 'false'], ['maintenance.auto', 'false'],
  ['core.bigFileThreshold', '1m'], ['core.compression', '0'], ['pack.compression', '0'],
  ['pack.window', '0'], ['pack.depth', '0'], ['pack.threads', '1'], ['pack.windowMemory', '32m'],
  ['http.postBuffer', '524288000'], ['http.version', 'HTTP/1.1']]
async function openShard() {
  shard = shardName(); shardDir = path.join(WORK, shard)
  await rm(shardDir, { recursive: true, force: true })
  const url = `https://github.com/${OWNER}/${shard}.git`
  // Le repo existe-t-il DÉJÀ avec des commits ? Si oui = RE-ARCHIVAGE -> on PRÉSERVE l'historique (versionning).
  const sonde = spawnSync('gh', ['api', `repos/${OWNER}/${shard}/commits?per_page=1`], {
    encoding: 'utf8', env: GENV, timeout: REMOTE_PROBE_TIMEOUT_MS, killSignal: 'SIGKILL',
  })
  const etatDepot = classifyRepoProbe(sonde.status, sonde.stdout, sonde.stderr, sonde.error)
  if (etatDepot.kind === 'error') throw new Error(`sonde ${shard} indéterminée : ${etatDepot.message}`)
  const hasContent = etatDepot.kind === 'content'
  // ROULEMENT PLUTÔT QUE RÉOUVERTURE (bug mesuré le 2026-08-15 sur Downloads). Rouvrir un shard existant passe
  // par un clone partiel `--filter=blob:none`, et git rattrape alors PARESSEUSEMENT les objets manquants : chaque
  // `git commit` déclenchait un `git fetch` vers GitHub et durait plus de quatre minutes, pendant lesquelles rien
  // ne montait. Mesuré : vingt kilo-octets par seconde en sortie, un commit bloqué à 4 min 38 s. Or on n'a AUCUN
  // besoin de l'ancien contenu : les morceaux sont nommés par empreinte et les manifestes pointent (dépôt, commit).
  // On passe donc au shard suivant, vierge, où `git init` + push ne demandent rien à personne.
  if (hasContent && ROULEMENT) {
    console.log(`  ${shard} contient déjà des morceaux -> on passe au suivant (aucun clone, aucun rattrapage paresseux)`)
    shardIdx++
    return openShard()
  }
  if (hasContent) {
    // CLONE PARTIEL (blob:none, no-checkout) : on récupère l'arbre + l'historique SANS tirer les Go de chunks
    // existants. read-tree HEAD remplit l'index avec TOUS les fichiers existants (par sha) -> les commits suivants
    // les préservent (on n'uploade QUE les nouveaux chunks) et l'historique = les versions reste INTACT.
    const cl = spawnSync('git', ['clone', '--quiet', '--filter=blob:none', '--sparse', url, shardDir], { encoding: 'utf8', env: GENV, timeout: 180000, killSignal: 'SIGKILL' })
    if (cl.status !== 0) throw new Error('clone: ' + (cl.stderr || '').slice(-200))
    for (const [k, v] of SHARD_CFG) git(shardDir, ['config', k, v])
    git(shardDir, ['sparse-checkout', 'set', '--no-cone', 'README.md'])
    await writeFile(path.join(shardDir, 'README.md'), README())
    console.log(`\n>>> SHARD ${shard} rouvert (historique préservé -> versions)`)
  } else {
    // NOUVEAU repo : init + 1er commit + push (force OK, repo vide).
    await mkdir(shardDir, { recursive: true })
    git(shardDir, ['init', '-q']); git(shardDir, ['branch', '-M', 'main'])
    for (const [k, v] of SHARD_CFG) git(shardDir, ['config', k, v])
    await writeFile(path.join(shardDir, 'README.md'), README())
    let created = false
    for (let attempt = 1; attempt <= 5 && !created; attempt++) {
      const r = spawnSync('gh', ['repo', 'create', `${OWNER}/${shard}`, '--public', '-d', `ZenRay archive — ${FOLDER_NAME}`], {
        encoding: 'utf8', env: GENV, timeout: REPO_CREATE_TIMEOUT_MS, killSignal: 'SIGKILL',
      })
      if (r.status === 0 || /already exists|Name already/i.test((r.stderr || '') + (r.stdout || ''))) { created = true; break }
      const rest = spawnSync('curl', ['-s', '--max-time', String(Math.ceil(REPO_CREATE_TIMEOUT_MS / 1000)), '-o', '/dev/null', '-w', '%{http_code}', '-X', 'POST', '-H', '@-', 'https://api.github.com/user/repos', '-d', JSON.stringify({ name: shard, private: false, description: `ZenRay archive — ${FOLDER_NAME}` })], {
        encoding: 'utf8', env: GENV, input: `Authorization: Bearer ${TOKEN}\n`, timeout: REPO_CREATE_TIMEOUT_MS, killSignal: 'SIGKILL',
      })
      if (/^(201|422)$/.test((rest.stdout || '').trim())) { created = true; break }
      console.error(`repo create ${attempt}/5 échec (${shard})`); await sleep(3000 * attempt)
    }
    if (!created) throw new Error('repo-create')
    git(shardDir, ['add', '-A']); git(shardDir, ['commit', '-q', '-m', 'init'])
    git(shardDir, ['remote', 'add', 'origin', url])
    const ps = git(shardDir, ['push', '-q', '-f', 'origin', 'HEAD:main'], 120000)
    if (ps.status !== 0) throw new Error('push-init: ' + (ps.stderr || '').slice(-200))
    console.log(`\n>>> SHARD ${shard} ouvert (nouveau)`)
  }
