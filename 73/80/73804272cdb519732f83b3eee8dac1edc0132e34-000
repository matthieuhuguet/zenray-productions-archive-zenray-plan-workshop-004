import React from 'react'
import { PALETTE, RADII, SHADOWS } from '../theme.js'
import { databaseColumnOptions, filterOperationsForColumn, parseDatabaseDate } from './databaseViewModel.js'

const FONTS = { serif: "var(--zr-police-serif)", sans: "var(--zr-police-sans)" }
const DOW = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim']
const pad2 = (value) => String(value).padStart(2, '0')
const ymd = (date) => `${date.getFullYear()}-${pad2(date.getMonth() + 1)}-${pad2(date.getDate())}`
const mondayOf = (base) => {
  const date = new Date(base)
  date.setHours(0, 0, 0, 0)
  date.setDate(date.getDate() - ((date.getDay() + 6) % 7))
  return date
}

function DatabaseSummary({ t, columns, row, excludeColumnId }) {
  return columns.slice(1).filter((column) => column.id !== excludeColumnId).map((column) => {
    const value = row?.cells?.[column.id]
    if (value == null || value === '' || value === false) return null
    const display = column.type === 'checkbox' ? '✓' : (Array.isArray(value) ? value.join(', ') : String(value))
    return <div key={column.id} style={{ fontSize: 'var(--zr-ui-xs)', color: t.textSecondary }}>{column.name}: {display}</div>
  })
}

export function DatabaseFilterBar({
  t,
  columns,
  filters,
  onChange,
  hidden = false,
  categoricalContains = true,
  resultCount,
  totalCount,
}) {
  const operations = (column) => filterOperationsForColumn(column, { categoricalContains })
  const update = (index, fields) => onChange(filters.map((filter, candidate) => candidate === index ? { ...filter, ...fields } : filter))
  const newFilterId = () => `f${Math.random().toString(36).slice(2, 8)}`

  return (
    <div style={{ display: hidden ? 'none' : 'flex', alignItems: 'center', gap: 8, flexWrap: 'wrap', marginBottom: 12 }}>
      {filters.map((filter, index) => {
        const column = columns.find((candidate) => candidate.id === filter.col)
        const choices = operations(column)
        const selectStyle = { background: 'transparent', border: 'none', color: t.textPrimary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', cursor: 'pointer', outline: 'none' }
        return (
          <div key={filter.id} style={{ display: 'flex', alignItems: 'center', gap: 3, background: t.surface, border: `1px solid ${t.border}`, borderRadius: 99, padding: '2px 4px 2px 9px' }}>
            <select value={filter.col} onChange={(event) => update(index, { col: event.target.value })} style={selectStyle}>
              {columns.map((candidate) => <option key={candidate.id} value={candidate.id}>{candidate.name}</option>)}
            </select>
            <select value={filter.op} onChange={(event) => update(index, { op: event.target.value })} style={selectStyle}>
              {choices.map(([value, label]) => <option key={value} value={value}>{label}</option>)}
            </select>
            {!['empty', 'true', 'false'].includes(filter.op) && (
              <input value={filter.val || ''} onChange={(event) => update(index, { val: event.target.value })} placeholder="valeur"
                style={{ background: t.bg, border: `1px solid ${t.border}`, borderRadius: 6, color: t.textPrimary, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', padding: '1px 6px', width: 80, outline: 'none' }} />
            )}
            <button onClick={() => onChange(filters.filter((_, candidate) => candidate !== index))} style={{ background: 'transparent', border: 'none', color: t.textSecondary, cursor: 'pointer', fontSize: 'var(--zr-ui-sm)' }}>✕</button>
          </div>
        )
      })}
      <button onClick={() => {
        const firstColumn = columns[0]
        if (!firstColumn) return
        onChange([...filters, { id: newFilterId(), col: firstColumn.id, op: operations(firstColumn)[0][0], val: '' }])
      }} style={{ background: 'transparent', border: `1px solid ${t.border}`, borderRadius: 99, color: t.textSecondary, cursor: 'pointer', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', padding: '3px 12px' }}>+ Filtre</button>
      {filters.length > 0 && Number.isFinite(resultCount) && Number.isFinite(totalCount) && (
        <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: t.textSecondary }}>{resultCount}/{totalCount}</span>
      )}
    </div>
  )
}

export function DatabaseBoardView({ t, columns, rows, groupBy, onSetCell, emptyMessage = 'Ajoute une colonne « select » pour le Board.' }) {
  if (!groupBy) return <div style={{ opacity: 0.6, padding: 20 }}>{emptyMessage}</div>
  const titleColumnId = columns[0]?.id
  return (
    <div style={{ display: 'flex', gap: 12, overflowX: 'auto', paddingBottom: 8 }}>
      {['', ...databaseColumnOptions(columns, groupBy)].map((option) => {
        const cards = rows.filter((row) => (row?.cells?.[groupBy] || '') === option)
        return (
          <div key={option || '∅'} onDragOver={(event) => event.preventDefault()} onDrop={(event) => {
            const id = event.dataTransfer.getData('text/plain')
            if (id) onSetCell(id, groupBy, option)
          }} style={{ flex: '0 0 240px', background: t.bg, border: `1px solid ${t.border}`, borderRadius: RADII.md, padding: 10, minHeight: 120 }}>
            <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: t.textSecondary, textTransform: 'uppercase', letterSpacing: 0.5, marginBottom: 8 }}>{option || '—'} · {cards.length}</div>
            {cards.map((row) => (
              <div key={row.id} draggable onDragStart={(event) => event.dataTransfer.setData('text/plain', row.id)} style={{ background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: '8px 10px', marginBottom: 6, cursor: 'grab', boxShadow: SHADOWS.sm }}>
                <div style={{ fontWeight: 600, fontFamily: FONTS.serif, fontSize: 'var(--zr-ui-lg)' }}>{row?.cells?.[titleColumnId] || '—'}</div>
                <DatabaseSummary t={t} columns={columns} row={row} excludeColumnId={groupBy} />
              </div>
            ))}
          </div>
        )
      })}
    </div>
  )
}

export function DatabaseGalleryView({ t, columns, rows }) {
  const titleColumnId = columns[0]?.id
  return (
    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill,minmax(220px,1fr))', gap: 12 }}>
      {rows.map((row) => (
        <div key={row.id} style={{ background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: RADII.md, padding: 14 }}>
          <div style={{ fontWeight: 600, fontFamily: FONTS.serif, fontSize: 'var(--zr-ui-xl)', marginBottom: 6 }}>{row?.cells?.[titleColumnId] || '—'}</div>
          <DatabaseSummary t={t} columns={columns} row={row} />
        </div>
      ))}
    </div>
  )
}

export function DatabaseListView({ t, columns, rows }) {
  const titleColumnId = columns[0]?.id
  return (
    <div style={{ border: `1px solid ${t.border}`, borderRadius: RADII.md }}>
      {rows.map((row, index) => (
        <div key={row.id} style={{ display: 'flex', gap: 16, padding: '9px 12px', borderBottom: index < rows.length - 1 ? `1px solid ${t.border}` : 'none', alignItems: 'center', flexWrap: 'wrap' }}>
          <span style={{ fontWeight: 600, fontFamily: FONTS.serif, minWidth: 160 }}>{row?.cells?.[titleColumnId] || '—'}</span>
          <span style={{ display: 'flex', gap: 14, flexWrap: 'wrap' }}><DatabaseSummary t={t} columns={columns} row={row} /></span>
        </div>
      ))}
    </div>
  )
}

export function DatabaseCalendarView({ t, columns, rows, dateColumnId, offset, onOffsetChange }) {
  const base = new Date()
  base.setDate(1)
  base.setMonth(base.getMonth() + offset)
  base.setHours(0, 0, 0, 0)
  const start = mondayOf(base)
  const byDay = {}
  rows.forEach((row) => {
    const date = parseDatabaseDate(row?.cells?.[dateColumnId])
    if (date) (byDay[ymd(date)] = byDay[ymd(date)] || []).push(row)
  })
  const cells = Array.from({ length: 42 }, (_, index) => { const date = new Date(start); date.setDate(date.getDate() + index); return date })
  const today = ymd(new Date())
  const titleColumnId = columns[0]?.id

  return (
    <div>
      <div style={{ display: 'flex', alignItems: 'center', gap: 10, marginBottom: 10 }}>
        <button onClick={() => onOffsetChange(offset - 1)} style={buttonStyle(t)}>‹</button>
        <span style={{ fontFamily: FONTS.serif, fontSize: 'var(--zr-ui-2xl)', fontWeight: 600, minWidth: 170, textAlign: 'center', textTransform: 'capitalize' }}>{base.toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' })}</span>
        <button onClick={() => onOffsetChange(offset + 1)} style={buttonStyle(t)}>›</button>
        {offset !== 0 && <button onClick={() => onOffsetChange(0)} style={buttonStyle(t)}>auj.</button>}
      </div>
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7,1fr)', gap: 1, background: t.border, border: `1px solid ${t.border}`, borderRadius: RADII.md, overflow: 'hidden' }}>
        {DOW.map((day) => <div key={day} style={{ background: t.cardBg, padding: '6px 8px', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: t.textSecondary, textTransform: 'uppercase', textAlign: 'center' }}>{day}</div>)}
        {cells.map((date, index) => {
          const inMonth = date.getMonth() === base.getMonth()
          const day = ymd(date)
          const items = byDay[day] || []
          return (
            <div key={index} style={{ background: t.cardBg, minHeight: 84, padding: 6, opacity: inMonth ? 1 : 0.4 }}>
              <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', fontWeight: day === today ? 700 : 400, color: day === today ? PALETTE.primary : t.textSecondary, marginBottom: 4 }}>{date.getDate()}</div>
              {items.slice(0, 4).map((row) => <div key={row.id} title={row?.cells?.[titleColumnId] || ''} style={{ fontSize: 'var(--zr-ui-xs)', lineHeight: 1.3, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis', background: PALETTE.primarySoft, color: PALETTE.primary, borderRadius: 4, padding: '1px 5px', marginBottom: 2 }}>{row?.cells?.[titleColumnId] || '—'}</div>)}
              {items.length > 4 && <div style={{ fontSize: 'var(--zr-ui-2xs)', color: t.textSecondary }}>+{items.length - 4}</div>}
            </div>
          )
        })}
      </div>
    </div>
  )
}

const buttonStyle = (t) => ({ background: t.btnSecondaryBg, color: t.btnSecondaryText, border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: '7px 12px', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', cursor: 'pointer' })
