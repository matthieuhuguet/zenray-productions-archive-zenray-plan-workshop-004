// Liste tous les fichiers .md d'un repo perso (Memory / .claude) pour le mode « parcourir tout le repo ».
// Un seul appel git/trees recursif (volume négligeable vs la limite REST). Env : GITHUB_TOKEN, MEMORY_REPO/CLAUDE_REPO.
import { documentRepo, visibleDocumentPaths } from './doc-access-policy.js'

export default async function handler(req, res) {
  const token = process.env.GITHUB_TOKEN
  const target = documentRepo(req.query.repo)
  const branch = process.env.MEMORY_BRANCH || 'main'
  if (!target) return res.status(400).json({ files: [], error: 'bad-repo' })
  if (!token) return res.status(200).json({ files: [], error: 'no-token' })
  try {
    const r = await fetch(`https://api.github.com/repos/${target.repo}/git/trees/${branch}?recursive=1`, {
      headers: { Authorization: `Bearer ${token}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zenray-progress' },
    })
    if (!r.ok) return res.status(200).json({ files: [], error: 'github' })
    const j = await r.json()
    const files = visibleDocumentPaths(j.tree)
    res.setHeader('Cache-Control', 'no-store')
    return res.status(200).json({ files })
  } catch {
    return res.status(200).json({ files: [], error: 'fetch' })
  }
}
