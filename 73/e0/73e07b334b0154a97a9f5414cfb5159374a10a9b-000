// 4 October 2026: one pass from the command line, same engine as the service. `--dry` reads everything and publishes nothing.
// FR : une passe en ligne de commande, meme moteur que le service. `--dry` lit tout et ne publie rien.
import path from 'node:path'
import { readFile } from 'node:fs/promises'
import { createHttp } from './lib/Http.mjs'
import { createGh } from './lib/Gh.mjs'
import { createCloudStore } from './CloudStore.mjs'
import { createEngine } from './Engine.mjs'
import { runtimeDirectory } from './Main.mjs'
import { loadEnvFile } from './Env.mjs'

const config = JSON.parse(await readFile(new URL('./FreelanceConfig.json', import.meta.url), 'utf8'))
const args = process.argv.slice(2)
const dryRun = args.includes('--dry')
const only = args.filter((arg) => !arg.startsWith('--'))
const cloud = createCloudStore({ config, directory: path.join(runtimeDirectory(), 'DataClone') })
const env = { ...process.env, ...(await loadEnvFile(runtimeDirectory(), { log: (message) => console.error(message) })) }
const engine = createEngine({ config, cloud, gh: createGh(), http: createHttp(config), log: (message) => console.error(message), env, refreshEnv: async () => { Object.assign(env, await loadEnvFile(runtimeDirectory())) } })
const report = await engine.run({ trigger: 'cli', only: only.length ? only : null, dryRun, onStage: (stage) => console.error(`stage: ${stage}`) })
const { files, ...summary } = report
console.log(JSON.stringify({ ...summary, ...(files ? { files: Object.keys(files).length } : {}) }, null, 2))
