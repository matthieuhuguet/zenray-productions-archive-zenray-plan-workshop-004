import { readFile } from 'node:fs/promises'
import path from 'node:path'
import { categoryFolder } from './lib/film-categories.mjs'

async function getSecret() {
  const envContent = await readFile('.env.local', 'utf8')
  const match = envContent.match(/ZENRAY_API_SECRET=(.+)/)
  return match ? match[1].trim() : ''
}

const secret = await getSecret()
if (!secret) {
  console.error('ZENRAY_API_SECRET not found in .env.local')
  process.exit(1)
}

const DOMAIN = 'https://zenray-progress.pages.dev'

async function issue(kind, targetPath) {
  const res = await fetch(`${DOMAIN}/api/share-token`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'x-zr-auth': secret,
    },
    body: JSON.stringify({ action: 'issue', kind, path: targetPath }),
  })
  if (!res.ok) {
    const err = await res.text()
    throw new Error(`Failed to issue token (${res.status}): ${err}`)
  }
  return res.json()
}

console.log('=== EMISSION DES JETONS DE PARTAGE SECURISES ===')

const folderTarget = `${categoryFolder('Movies')}/Hors Normes`
const videoTarget = `${folderTarget}/Hors Normes.mp4.media.json`

const folderRes = await issue('folder', folderTarget)
const folderUrl = `${DOMAIN}/folder?d=${folderRes.token}`
console.log('Dossier :', folderTarget)
console.log('Jeton   :', folderRes.token)
console.log('Lien    :', folderUrl)

const videoRes = await issue('video', videoTarget)
const videoUrl = `${DOMAIN}/watch?v=${videoRes.token}`
console.log('\nFilm    :', videoTarget)
console.log('Jeton   :', videoRes.token)
console.log('Lien    :', videoUrl)

console.log('\n=== VERIFICATION RESOLUTION PUBLIQUE ===')
const checkFolder = await fetch(`${DOMAIN}/api/share-token?action=resolve&token=${folderRes.token}&kind=folder`).then(r => r.json())
console.log('Resolution dossier :', checkFolder)

const checkVideo = await fetch(`${DOMAIN}/api/share-token?action=resolve&token=${videoRes.token}&kind=video`).then(r => r.json())
