// planOpenOrigin.js (23 October 2026): where the plan card was when a plan was opened, so the Plan can zoom out of it.
// FR : où se trouvait la carte du plan à l'ouverture, pour que le Plan en sorte en zoomant.
const MAX_AGE_MS = 8000 // older than this, the card is no longer what the eye remembers
let origin = null

export function rememberPlanOrigin(path) {
  try {
    const el = [...document.querySelectorAll('[data-plan-card]')].find((n) => n.dataset.planCard === path)
    if (!el) { origin = null; return }
    const r = el.getBoundingClientRect()
    origin = { path, at: Date.now(), rect: { x: r.left, y: r.top, w: r.width, h: r.height } }
  } catch { origin = null }
}

// Read once: a second Plan opening without a card click must not reuse an old rectangle. / lu une seule fois.
export function takePlanOrigin(path) {
  const o = origin
  origin = null
  if (!o || o.path !== path || Date.now() - o.at > MAX_AGE_MS) return null
  return o.rect
}
