import React, { useEffect, useLayoutEffect, useMemo, useRef, useState } from 'react'
import { createPortal } from 'react-dom'
import { liquidGlassNormal, PALETTE, TRANSITIONS } from '../theme.js'

const FONT = "var(--zr-police-sans)"
const MARGIN = 12
const COLUMN_SCROLL_MS = 300

function easeOutExpo(progress) {
  return progress >= 1 ? 1 : 1 - (2 ** (-10 * progress))
}

function viewportSize() {
  if (typeof window === 'undefined') return { width: 1024, height: 768 }
  return {
    width: Math.max(1, window.visualViewport?.width || window.innerWidth || 1024),
    height: Math.max(1, window.visualViewport?.height || window.innerHeight || 768),
  }
}

export function useReducedMotion() {
  const query = '(prefers-reduced-motion: reduce)'
  const [reduced, setReduced] = useState(() => (
    typeof window !== 'undefined' && typeof window.matchMedia === 'function'
      ? window.matchMedia(query).matches
      : false
  ))

  useEffect(() => {
    if (typeof window === 'undefined' || typeof window.matchMedia !== 'function') return undefined
    const media = window.matchMedia(query)
    const update = () => setReduced(media.matches)
    update()
    if (media.addEventListener) media.addEventListener('change', update)
    else media.addListener?.(update)
    return () => {
      if (media.removeEventListener) media.removeEventListener('change', update)
      else media.removeListener?.(update)
    }
  }, [])

  return reduced
}

/**
 * Coque unique des navigateurs en colonnes Create.
 *
 * Les colonnes sont pilotées par le parent et ne changent jamais au hover :
 * seul un clic explicite peut ouvrir/remplacer une colonne. Le portail et le
 * positionnement fixed empêchent tout crop par overflow/backdrop-filter.
 */
export function ColumnMenuShell({
  t,
  anchor,
  columns,
  onClose,
  ariaLabel = 'Menu',
  columnWidth = 238,
  maxHeight = 420,
  minHeight = 160,
  triggerSelector,
  triggerRef,
  id,
  className = '',
}) {
  const ref = useRef(null)
  const scrollRef = useRef(null)
  const reducedMotion = useReducedMotion()
  const [viewport, setViewport] = useState(viewportSize)
  const count = Math.max(1, React.Children.count(columns))

  useEffect(() => {
    if (typeof window === 'undefined') return undefined
    const update = () => setViewport(viewportSize())
    window.addEventListener('resize', update, { passive: true })
    window.visualViewport?.addEventListener?.('resize', update, { passive: true })
    return () => {
      window.removeEventListener('resize', update)
      window.visualViewport?.removeEventListener?.('resize', update)
    }
  }, [])

  useEffect(() => {
    const onPointer = (event) => {
      if (ref.current?.contains(event.target)) return
      if (triggerRef?.current?.contains?.(event.target)) return
      if (triggerSelector && event.target?.closest?.(triggerSelector)) return
      onClose?.()
    }
    const onKey = (event) => { if (event.key === 'Escape') onClose?.() }
    document.addEventListener('pointerdown', onPointer)
    document.addEventListener('keydown', onKey)
    return () => {
      document.removeEventListener('pointerdown', onPointer)
      document.removeEventListener('keydown', onKey)
    }
  }, [onClose, triggerRef, triggerSelector])

  const layout = useMemo(() => {
    const vw = viewport.width
    const vh = viewport.height
    const rawLeft = Number(anchor?.left ?? 0)
    const firstColumnWidth = Math.min(columnWidth, Math.max(1, vw - MARGIN * 2))
    // La position de la première colonne ne dépend JAMAIS du nombre de colonnes.
    // Quand la cascade grandit, seule la largeur de la coque puis son scroller évoluent.
    const left = Math.max(MARGIN, Math.min(rawLeft, vw - firstColumnWidth - MARGIN))
    const desiredWidth = count * columnWidth
    const width = Math.max(1, Math.min(desiredWidth, vw - left - MARGIN))
    const requestedTop = Number(anchor?.top ?? ((anchor?.bottom ?? MARGIN) + 8))
    const belowTop = Math.max(MARGIN, Math.min(requestedTop, vh - MARGIN))
    const triggerTop = Math.max(MARGIN, Math.min(Number(anchor?.triggerTop ?? anchor?.top ?? MARGIN), vh - MARGIN))
    const below = Math.max(0, vh - belowTop - MARGIN)
    const above = Math.max(0, triggerTop - MARGIN * 2)
    const openAbove = below < minHeight && above > below
    const height = Math.max(1, Math.min(maxHeight, openAbove ? above : below))
    return { left, width, height, openAbove, belowTop, bottom: Math.max(MARGIN, vh - triggerTop + 8) }
  }, [anchor, columnWidth, count, maxHeight, minHeight, viewport])

  // Finder : à l'ajout d'une colonne, révéler la nouvelle destination sans déplacer
  // la coque. Reduced motion conserve le résultat mais supprime le mouvement.
  useLayoutEffect(() => {
    const scroller = scrollRef.current
    if (!scroller || count < 2) return undefined
    const target = Math.max(0, scroller.scrollWidth - scroller.clientWidth)
    const startLeft = scroller.scrollLeft
    const distance = target - startLeft
    if (reducedMotion || Math.abs(distance) < 1) {
      scroller.scrollLeft = target
      return undefined
    }

    const start = performance.now()
    let frame = 0
    const animate = (now) => {
      // Sous jsdom, le timestamp rAF peut avoir une origine antérieure à performance.now().
      // Borner aussi à 0 évite un scrollLeft négatif sans changer l'animation navigateur.
      const progress = Math.max(0, Math.min(1, (now - start) / COLUMN_SCROLL_MS))
      scroller.scrollLeft = startLeft + distance * easeOutExpo(progress)
      if (progress < 1) frame = window.requestAnimationFrame(animate)
    }
    frame = window.requestAnimationFrame(animate)
    return () => window.cancelAnimationFrame(frame)
  }, [count, layout.width, reducedMotion])

  if (typeof document === 'undefined') return null

  return createPortal(
    <div
      id={id}
      ref={ref}
      role="menu"
      aria-label={ariaLabel}
      className={`zr-liquid-normal ${className}`.trim()}
      style={{
        position: 'fixed',
        left: layout.left,
        ...(layout.openAbove ? { bottom: layout.bottom } : { top: layout.belowTop }),
        zIndex: 500,
        width: layout.width,
        maxWidth: `calc(100vw - ${MARGIN * 2}px)`,
        height: layout.height,
        maxHeight: layout.height,
        boxSizing: 'border-box',
        overflow: 'hidden',
        borderRadius: 22,
        ...liquidGlassNormal(t),
      }}
    >
      <div
        ref={scrollRef}
        data-zr-column-scroll
        style={{ display: 'flex', width: '100%', height: '100%', overflowX: 'auto', overflowY: 'hidden', scrollbarWidth: 'none', overscrollBehavior: 'contain' }}
      >
        {columns}
      </div>
    </div>,
    document.body,
  )
}

export function ColumnMenuColumn({ t, children, width = 238, label, index = 0 }) {
  const dark = t?.textPrimary === PALETTE.textPrimaryDark
  const divider = dark ? 'rgba(0,0,0,.54)' : 'rgba(60,60,67,.18)'
  return (
    <div
      role="group"
      aria-label={label}
      style={{
        width,
        flex: `0 0 ${width}px`,
        height: '100%',
        overflowY: 'auto',
        padding: '8px 7px',
        boxSizing: 'border-box',
        background: 'transparent',
        borderLeft: index > 0 ? `1px solid ${divider}` : 'none',
        boxShadow: index > 0 ? 'inset 1px 0 rgba(255,255,255,.12)' : 'none',
        display: 'flex',
        flexDirection: 'column',
        gap: 1,
      }}
    >
      {children}
    </div>
  )
}

export function ColumnMenuItem({
  t,
  children,
  icon,
  trailing,
  selected = false,
  current = false,
  danger = false,
  disabled = false,
  onClick,
  title,
}) {
  const dark = t?.textPrimary === PALETTE.textPrimaryDark
  const reducedMotion = useReducedMotion()
  const normalText = dark ? 'rgba(255,255,255,.90)' : 'rgba(24,24,27,.88)'
  const muted = dark ? 'rgba(255,255,255,.48)' : 'rgba(60,60,67,.54)'
  const color = selected ? '#fff' : danger ? PALETTE.red : normalText
  return (
    <button
      type="button"
      role="menuitem"
      aria-current={current ? 'page' : undefined}
      disabled={disabled}
      title={title}
      onClick={onClick}
      style={{
        display: 'flex',
        alignItems: 'center',
        gap: 8,
        width: '100%',
        minHeight: 30,
        padding: '4px 10px',
        border: 'none',
        borderRadius: 8,
        background: selected ? PALETTE.primaryDark : 'transparent',
        color,
        cursor: disabled ? 'default' : 'pointer',
        opacity: disabled ? .45 : 1,
        textAlign: 'left',
        fontFamily: FONT,
        fontSize: 'var(--zr-ui-xl)',
        fontWeight: 400,
        transition: reducedMotion ? 'none' : TRANSITIONS.micro,
      }}
      onPointerEnter={(event) => { if (!selected && !disabled) event.currentTarget.style.background = dark ? 'rgba(255,255,255,.08)' : 'rgba(0,0,0,.055)' }}
      onPointerLeave={(event) => { if (!selected) event.currentTarget.style.background = 'transparent' }}
    >
      {icon && <span aria-hidden="true" style={{ width: 18, display: 'inline-flex', justifyContent: 'center', flexShrink: 0 }}>{icon}</span>}
      <span style={{ minWidth: 0, flex: 1, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{children}</span>
      {trailing && <span aria-hidden="true" style={{ display: 'inline-flex', color: selected ? '#fff' : muted, flexShrink: 0 }}>{trailing}</span>}
    </button>
  )
}
