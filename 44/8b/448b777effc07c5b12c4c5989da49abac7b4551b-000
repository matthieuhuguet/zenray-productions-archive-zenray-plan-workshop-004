// ═══ MESURER L'OUVERTURE DE L'APERÇU, DANS LES DEUX CAS QUI COMPTENT ════════════════════════════
//
// OBJECTIF POSÉ PAR MATTHIEU le 2026-08-31 : « ça devrait s'ouvrir en 0,1 s ». Il en prenait deux.
//
//   npx vite --port 5199 --strictPort &
//   node scripts/mesurer-apercu.mjs
//
// CE QUE CE BANC MESURE, ET CE QU'IL NE MESURE PAS. Il monte le VRAI `QuickLookOverlay` avec un
// `/api/page` bouchonné à 200 ms — la médiane relevée au curl en production le même jour — et
// chronomètre entre l'appui et le premier pixel réellement peint. Il ne mesure pas la vitesse de
// jsDelivr, qui rend son octet immédiatement : ce qu'on cherche est le coût STRUCTUREL de l'app,
// c'est-à-dire le nombre d'allers-retours qu'elle s'impose avant de montrer quoi que ce soit.
//
// LES DEUX CAS SONT MESURÉS SÉPARÉMENT, et c'est la seule façon de ne pas se mentir :
//
//   CHAUD — la grille vient d'afficher cette image, son manifeste est en cache. C'est l'usage réel :
//           on parcourt un dossier qu'on regarde. Mesuré le 2026-08-31 : 8 ms de médiane, 10 au pire.
//   FROID — l'image n'a jamais été vue. Un aller-retour est alors INCOMPRESSIBLE : on ne peut pas
//           afficher ce dont on n'a pas lu le manifeste. Mesuré : 215 ms, soit la latence réseau
//           plus quinze millisecondes de travail.
//
// Le préchauffage ciblé d'`App.jsx` — le manifeste de l'image SÉLECTIONNÉE, et d'elle seule — fait
// que l'appui sur Espace tombe presque toujours dans le cas chaud. C'est lui qui rend la cible
// atteignable sans lire les 748 manifestes d'un dossier.

import { chromium } from '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/node_modules/playwright/index.mjs'
const nav = await chromium.launch()
const page = await nav.newPage({ viewport: { width: 1400, height: 900 } })
await page.goto('http://localhost:5199/ql-bench.html', { waitUntil: 'networkidle' })
await page.waitForTimeout(800)

const ouvrirEtMesurer = async (i) => page.evaluate(async (i) => {
  window.__ouvrir(i)
  const t0 = window.__t0
  for (let k = 0; k < 900; k++) {
    const img = document.querySelector('img[src]:not([src=""])')
    if (img && img.getBoundingClientRect().width > 50) return performance.now() - t0
    await new Promise((r) => requestAnimationFrame(r))
  }
  return -1
}, i)

// ── CAS FROID : aucune image n'a ete vue, le cache est vide ──────────────────────────────────────
const froid = []
for (let i = 0; i < 4; i++) {
  froid.push(await ouvrirEtMesurer(100 + i))   // indices jamais prechauffes
  await page.evaluate(() => window.__fermer()); await page.waitForTimeout(80)
}

// ── CAS CHAUD : la grille a deja affiche ces images, comme dans l'usage reel ─────────────────────
await page.evaluate((n) => window.__prechauffer(n), 8)
await page.waitForTimeout(300)
const chaud = []
for (let i = 0; i < 8; i++) {
  chaud.push(await ouvrirEtMesurer(i))
  await page.evaluate(() => window.__fermer()); await page.waitForTimeout(80)
}
await nav.close()

// UN VERDICT NE SE REND PAS SUR UNE MESURE ABSENTE. La premiere version de ce script rendait -1
// quand tout avait echoue, et « -1 <= 100 » etant vrai, il annoncait « ATTEINT » sur un banc
// entierement casse. Un verificateur qui ment est pire que pas de verificateur : il faut donc
// distinguer « mesure basse » de « pas de mesure », et ARRETER dans le second cas.
const med = (a) => { const o = a.filter((x) => x >= 0).sort((x, y) => x - y); return o.length ? o[Math.floor(o.length / 2)] : null }
const pire = (a) => Math.max(...a.filter((x) => x >= 0))
console.log('  latence reseau simulee : 200 ms par appel a /api/page (mediane relevee en production)')
console.log('')
console.log('  CAS FROID  (image jamais vue, cache vide)')
console.log('    mesures :', froid.map((x) => x < 0 ? 'ECHEC' : x.toFixed(0)).join(' · '), 'ms')
console.log('    mediane :', med(froid) === null ? 'AUCUNE' : med(froid).toFixed(0) + ' ms', '  pire :', med(froid) === null ? '—' : pire(froid).toFixed(0) + ' ms')
console.log('')
console.log('  CAS CHAUD  (la grille a affiche l image — l usage reel)')
console.log('    mesures :', chaud.map((x) => x < 0 ? 'ECHEC' : x.toFixed(0)).join(' · '), 'ms')
console.log('    mediane :', med(chaud) === null ? 'AUCUNE' : med(chaud).toFixed(0) + ' ms', '  pire :', med(chaud) === null ? '—' : pire(chaud).toFixed(0) + ' ms')
console.log('')
console.log('  cible : 100 ms')
const mc = med(chaud), mf = med(froid)
if (mc === null || mf === null) {
  console.log('  MESURE INVALIDE : le banc n a produit aucun chiffre exploitable.')
  console.log('  Regarder la console du navigateur avant de conclure quoi que ce soit.')
  process.exit(1)
}
console.log('  verdict chaud :', mc <= 100 ? 'ATTEINT' : `NON ATTEINT (${mc.toFixed(0)} ms)`)
console.log('  verdict froid :', mf <= 100 ? 'ATTEINT' : `NON ATTEINT (${mf.toFixed(0)} ms)`)
process.exit(mc <= 100 && mf <= 100 ? 0 : 1)
