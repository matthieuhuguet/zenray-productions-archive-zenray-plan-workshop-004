// FolderCommentsFeed.test.jsx: tests unitaires pour le rectangle de commentaire.
// Couvre l'affichage Liquid Glass, l'animation de sortie 0.35s, et l'actualisation immediate.

import React from 'react'
import { cleanup, render, screen, fireEvent } from '@testing-library/react'
import { afterEach, describe, expect, it, vi } from 'vitest'
import FolderCommentsFeed from './FolderCommentsFeed.jsx'

describe('FolderCommentsFeed', () => {
  afterEach(() => {
    cleanup()
    localStorage.clear()
    vi.restoreAllMocks()
  })

  const sampleEntries = [
    {
      dir: 'pages/Audio/SFX/comment1.comment.json',
      contentPath: 'pages/Audio/SFX/comment1.comment.json',
      name: 'son 26 et 13 sont interessant.comment.json',
      createdAt: '2026-10-06T17:00:00Z',
    },
  ]

  it('ne rend rien (null) s il n y a aucun commentaire et pas d edition', () => {
    const { container } = render(
      <FolderCommentsFeed
        folder="pages/Audio/SFX"
        entries={[]}
        t={{ textPrimary: '#fff', textSecondary: '#aaa', border: '#333' }}
        isDark={true}
      />
    )
    expect(container.firstChild).toBeNull()
  })

  it('affiche le rectangle Liquid Glass quand un commentaire est present et joue l animation de sortie au clic sur la croix', async () => {
    global.fetch = vi.fn().mockResolvedValue({
      json: async () => ({
        markdown: JSON.stringify({
          type: 'comment',
          title: 'son 26 et 13 sont interessant',
          body: 'Note importante sur ces sons',
        }),
      }),
    })

    render(
      <FolderCommentsFeed
        folder="pages/Audio/SFX"
        entries={sampleEntries}
        t={{ textPrimary: '#fff', textSecondary: '#aaa', border: '#333' }}
        isDark={true}
      />
    )

    const text = await screen.findByText('Note importante sur ces sons')
    expect(text).toBeDefined()

    // Clic sur la petite croix pour enlever le commentaire
    const closeBtn = screen.getByTitle('Enlever le commentaire')
    fireEvent.click(closeBtn)

    // Pendant les 350ms, l'animation de sortie est active
    const container = screen.getByText('Note importante sur ces sons').closest('.zr-folder-single-comment')
    expect(container.className).toContain('zr-comment-exit')

    // Attente des 350ms (0.35s) pour que la disparition complete s'acheve
    await new Promise((resolve) => setTimeout(resolve, 400))

    expect(screen.queryByText('Note importante sur ces sons')).toBeNull()
  })

  it('ouvre la saisie directe quand forceOpen est declenche et enregistre instantanement le commentaire', async () => {
    const onAdd = vi.fn().mockResolvedValue({
      ok: true,
      path: 'pages/Audio/SFX/new.comment.json',
      comment: { title: '', body: 'Les sons 01 et 05 sont parfaits' },
    })

    render(
      <FolderCommentsFeed
        folder="pages/Audio/SFX"
        entries={[]}
        onAddComment={onAdd}
        t={{ textPrimary: '#fff', textSecondary: '#aaa', border: '#333' }}
        isDark={true}
        forceOpen={1}
      />
    )

    const textarea = screen.getByPlaceholderText('Écrire un commentaire pour ce dossier…')
    fireEvent.change(textarea, { target: { value: 'Les sons 01 et 05 sont parfaits' } })

    const saveBtn = screen.getByText('Enregistrer')
    fireEvent.click(saveBtn)

    expect(onAdd).toHaveBeenCalledWith('Les sons 01 et 05 sont parfaits', '')
    // Affichage instantane (reactivite 0ms)
    expect(screen.getByText('Les sons 01 et 05 sont parfaits')).toBeDefined()
  })
})
