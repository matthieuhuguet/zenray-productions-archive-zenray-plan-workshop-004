import { describe, expect, it } from 'vitest'
import { isRetryableGithubStatus } from './video-mse-lib.mjs'

describe('politique de reprise GitHub Data API', () => {
  it('retente la limitation et les pannes serveur', () => {
    expect(isRetryableGithubStatus(429)).toBe(true)
    expect(isRetryableGithubStatus(500)).toBe(true)
    expect(isRetryableGithubStatus(503)).toBe(true)
  })

  it('arrête les requêtes invalides et les refus définitifs', () => {
    expect(isRetryableGithubStatus(400)).toBe(false)
    expect(isRetryableGithubStatus(401)).toBe(false)
    expect(isRetryableGithubStatus(404)).toBe(false)
    expect(isRetryableGithubStatus(422)).toBe(false)
  })
})
