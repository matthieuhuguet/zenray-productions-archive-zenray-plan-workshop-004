/** Même répartition stable partout où une voie doit décider si un chemin lui appartient. */
export function partitionForPath(rel, total) {
  if (!Number.isInteger(total) || total < 1) throw new Error(`nombre de tranches invalide : ${total}`)
  let h = 2166136261
  for (let k = 0; k < rel.length; k++) { h ^= rel.charCodeAt(k); h = Math.imul(h, 16777619) }
  return Math.abs(h) % total
}

export function belongsToPartition(rel, partition) {
  return !partition || partitionForPath(rel, partition.n) === partition.i
}
