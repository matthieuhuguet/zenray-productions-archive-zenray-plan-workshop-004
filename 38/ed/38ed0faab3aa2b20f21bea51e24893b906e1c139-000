import React from 'react'
import { cleanup, fireEvent, render, waitFor } from '@testing-library/react'
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
import { THEMES } from '../theme.js'

const state = vi.hoisted(() => ({ paths: [], player: null }))

vi.mock('../audio/PlayerContext.jsx', () => ({ usePlayer: () => state.player }))
vi.mock('../audio/spotifyAuth.js', () => ({ hasConfig: () => false, isLoggedIn: () => false, login: vi.fn() }))
vi.mock('../audio/spotifyApi.js', () => ({ spotifyAlbum: vi.fn(), spotifyPlaylist: vi.fn(), spotifyTrack: vi.fn(), me: vi.fn(async () => null), myPlaylists: vi.fn(async () => null), myTracks: vi.fn(async () => null) }))
vi.mock('../lib/saveJson.js', () => ({ saveJsonWithRetry: vi.fn() }))
vi.mock('../search/searchIndexClient.js', () => ({
  loadSearchIndex: vi.fn(async () => null),
  getIndexPaths: () => state.paths,
}))

import ZenRayAudioPanel from './ZenRayAudioPanel.jsx'

const targetPath = 'pages/Music/Psycho-Pass/A World of Contradictions.media.json'
const manifest = { type: 'audio', mediaKind: 'audio', mime: 'audio/mpeg', title: 'A World of Contradictions', duration: 242 }

function playerStub() {
  return {
    current: null, queue: [], idx: -1, playing: false, time: 0, dur: 0, vol: 1,
    seekable: true, sdkReady: true, shuffle: false, repeat: 'off', playError: '',
    playMixedQueue: vi.fn(), playSpotify: vi.fn(), playNext: vi.fn(), addToQueue: vi.fn(),
    setShuffle: vi.fn(), setRepeat: vi.fn(), setVol: vi.fn(), seek: vi.fn(),
    prev: vi.fn(), next: vi.fn(), toggle: vi.fn(),
  }
}

describe('ZenRayAudioPanel targetPath', () => {
  beforeEach(() => {
    state.paths = [targetPath]
    state.player = playerStub()
    vi.spyOn(globalThis, 'fetch').mockResolvedValue({
      ok: true,
      json: async () => ({ missing: false, markdown: JSON.stringify(manifest) }),
    })
  })

  afterEach(() => { cleanup(); vi.restoreAllMocks() })

  it('consomme une intention targetPath une seule fois tant que la vue reste ouverte', async () => {
    const props = { open: true, onClose: vi.fn(), t: THEMES.light, folder: 'pages/Music', entries: [], targetPath }
    const view = render(<ZenRayAudioPanel {...props} />)

    await waitFor(() => expect(state.player.playMixedQueue).toHaveBeenCalledTimes(1))
    view.rerender(<ZenRayAudioPanel {...props} entries={[]} />)
    await new Promise((resolve) => setTimeout(resolve, 0))
    expect(state.player.playMixedQueue).toHaveBeenCalledTimes(1)

    view.rerender(<ZenRayAudioPanel {...props} targetPath={null} />)
    view.rerender(<ZenRayAudioPanel {...props} />)
    await new Promise((resolve) => setTimeout(resolve, 0))
    expect(state.player.playMixedQueue).toHaveBeenCalledTimes(1)
  })

  it('rend les quatre zones fixes sans embarquer l’interface Spotify', async () => {
    render(<ZenRayAudioPanel open t={THEMES.light} folder="pages/Music" entries={[]} />)

    await waitFor(() => expect(document.querySelector('[aria-label="Bibliothèque ZenRay Audio"]')).toBeInTheDocument())
    expect(document.querySelector('[aria-label="Album et titres"]')).toBeInTheDocument()
    expect(document.querySelector('[aria-label="Contexte de lecture"]')).toBeInTheDocument()
    expect(document.querySelector('[aria-label="Lecteur transversal"]')).toBeInTheDocument()
    expect(document.querySelector('iframe[title="Spotify"]')).not.toBeInTheDocument()
  })

  // Retour Matthieu 2026-07-16 : "On ne peut pas drag and drop les fichiers" -- ce test couvre le chemin
  // réel (dragenter affiche l'overlay, un drop de fichiers audio appelle onAddAudio avec le bon scope)
  // sans dépendre d'un vrai glisser OS, que les outils de vérification navigateur ne peuvent pas simuler.
  it('affiche l’overlay au survol et importe les fichiers audio déposés', async () => {
    const onAddAudio = vi.fn().mockResolvedValue(undefined)
    render(<ZenRayAudioPanel open t={THEMES.light} folder="pages/Music" entries={[]} onAddAudio={onAddAudio} />)
    await waitFor(() => expect(document.querySelector('[aria-label="Album et titres"]')).toBeInTheDocument())

    const shell = document.querySelector('.zra-shell')
    const audioFile = new File(['fake'], 'test-drop.mp3', { type: 'audio/mpeg' })
    const dataTransfer = { types: ['Files'], files: [audioFile] }

    fireEvent.dragEnter(shell, { dataTransfer })
    expect(document.querySelector('.zra-drop')).toBeInTheDocument()

    fireEvent.drop(shell, { dataTransfer })
    await waitFor(() => expect(onAddAudio).toHaveBeenCalledTimes(1))
    expect(onAddAudio.mock.calls[0][0]).toEqual([audioFile])
    expect(onAddAudio.mock.calls[0][1]).toBe('pages/Music')
    expect(document.querySelector('.zra-drop')).not.toBeInTheDocument()
  })
})
