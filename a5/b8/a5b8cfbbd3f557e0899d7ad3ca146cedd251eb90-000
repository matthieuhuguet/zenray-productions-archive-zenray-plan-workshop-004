/* 23 October 2026: Single unified theme-adaptive background without double container framing. */
.zr-reference-gallery{max-width:var(--gallery-max-width);margin:0 auto;padding:var(--gallery-inset);background:var(--gallery-background);color:var(--gallery-ink);border-radius:8px;box-sizing:border-box;width:100%;min-height:calc(100vh - 120px);font:var(--gallery-body-weight) var(--gallery-body-size)/1.5 var(--zr-police-serif);transition:background .2s ease,color .2s ease}
.zr-gallery-hero{margin:18px 0 38px;display:flex;align-items:baseline;justify-content:space-between;gap:24px}
.zr-gallery-hero h1{margin:0;font-size:var(--gallery-heading-size);line-height:1.12;letter-spacing:-.025em}
.zr-gallery-hero p{margin:0;color:var(--gallery-muted);font-size:14px}
.zr-gallery-title,.zr-reference-gallery h1,.zr-reference-gallery h2,.zr-reference-gallery h3,.zr-gallery-projects h1,.zr-gallery-projects h2,.zr-gallery-projects h3{font-family:var(--zr-police-gallery-title)!important;font-style:var(--zr-style-gallery-title)!important;font-weight:var(--zr-poids-gallery-title)!important}
.zr-gallery-grid{display:grid;grid-template-columns:repeat(var(--gallery-columns),minmax(0,1fr));gap:var(--gallery-gap);align-items:start}
.zr-gallery-tile{position:relative;min-width:0;grid-column:auto!important}
.zr-gallery-visual{aspect-ratio:var(--gallery-image-ratio)!important;border-radius:var(--gallery-radius)!important;background:var(--gallery-letterbox);outline-offset:5px;isolation:isolate}
.zr-gallery-visual img{object-fit:var(--gallery-image-fit)!important}
.zr-gallery-caption{position:absolute;left:0;right:0;bottom:0;z-index:2;padding:40px 20px 18px;background:linear-gradient(transparent,var(--gallery-overlay));color:var(--gallery-overlayInk);opacity:0;transform:translateY(5px);transition:opacity var(--gallery-motion),transform var(--gallery-motion);pointer-events:none}
.zr-gallery-caption h3{font-size:var(--gallery-title-size);line-height:1.25;margin:0 0 8px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.zr-gallery-caption a,.zr-gallery-caption [role=button]{pointer-events:auto;cursor:pointer}
.zr-gallery-caption a{color:inherit;text-decoration:none;font:400 12px var(--zr-police-sans)}
.zr-gallery-caption p{margin:9px 0 0;font:var(--gallery-body-weight) var(--gallery-body-size)/1.4 var(--zr-police-serif);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.zr-gallery-caption .zr-gallery-count{font:400 12px var(--zr-police-serif);margin-left:12px;white-space:nowrap}
.zr-gallery-visual:hover>.zr-gallery-caption,.zr-gallery-visual:focus-within>.zr-gallery-caption,.zr-gallery-visual:focus>.zr-gallery-caption{opacity:1;transform:none}
.zr-reference-gallery[data-caption-mode=always] .zr-gallery-caption{opacity:1;transform:none}
.zr-reference-gallery .zr-ws-rim::before,.zr-reference-gallery .zr-ws-rim::after{display:none}
.zr-reference-gallery .zr-gallery-remove:focus-visible{opacity:1!important}
.zr-gallery-projects{color:var(--gallery-ink);font:var(--gallery-body-weight) var(--gallery-body-size)/1.5 var(--zr-police-serif)}
.zr-reference-gallery p,.zr-gallery-projects p{font-family:var(--zr-police-serif)!important;font-weight:var(--gallery-body-weight)!important;font-style:normal}
.zr-gallery-project-images{gap:var(--gallery-gap)!important;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))!important}
.zr-gallery-project-image{background:var(--gallery-letterbox)!important}
.zr-gallery-project-images img{object-fit:var(--gallery-image-fit)!important}
.zr-gallery-project-image-label{opacity:0;pointer-events:none;transition:opacity var(--gallery-motion)}
.zr-gallery-project-image:hover .zr-gallery-project-image-label,.zr-gallery-project-image:focus .zr-gallery-project-image-label{opacity:1}
@media(max-width:1100px){.zr-gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.zr-reference-gallery{padding:var(--gallery-mobile-inset)}}
@media(max-width:600px){.zr-gallery-grid{gap:18px;grid-template-columns:repeat(2,minmax(0,1fr))}.zr-gallery-hero{margin:16px 0 28px}.zr-gallery-hero h1{font-size:34px}.zr-gallery-hero p{font-size:12px}.zr-gallery-caption{padding:28px 10px 12px}.zr-gallery-caption h3{font-size:19px}.zr-gallery-caption p{font-size:13px}.zr-gallery-project-images{grid-template-columns:1fr!important}}
@media(hover:none),(pointer:coarse){.zr-gallery-caption{opacity:1;transform:none}.zr-gallery-project-image-label{opacity:1}}
@media(prefers-reduced-motion:reduce){.zr-gallery-caption,.zr-gallery-project-image-label{transition:none;transform:none}}
