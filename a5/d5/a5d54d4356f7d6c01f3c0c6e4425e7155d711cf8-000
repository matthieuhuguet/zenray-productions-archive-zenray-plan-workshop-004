// RÉPARATION ponctuelle : dans les stream.m3u8 déjà poussés, remplace l'URL jsDelivr des segments
// > ~20 Mo (403 CDN) par raw.githubusercontent.com (sert jusqu'à 100 Mo, public). Vérifie par HEAD.
import { execSync } from 'node:child_process'
const TOKEN = process.env.GITHUB_TOKEN
const BASES = process.argv.slice(2)
const H = { Authorization: `Bearer ${TOKEN}`, 'User-Agent': 'zr-fix' }
const head = async (u, auth = false) => { try { const r = await fetch(u, { method: 'HEAD', headers: auth ? H : {} }); return r.status } catch { return 0 } }
for (const b of BASES) {
  const plPath = `pages/Videos/Eagle/${b}/stream.m3u8`
  const r = await fetch(`https://raw.githubusercontent.com/matthieuhuguet/zenray-data/main/${encodeURI(plPath)}`, { headers: H })
  if (!r.ok) { console.log(b, 'playlist absente', r.status); continue }
  const lines = (await r.text()).split('\n')
  let fixed = 0
  // concurrence 16 sur les HEAD jsDelivr
  const idx = lines.map((l, i) => ({ l, i })).filter((x) => x.l.startsWith('https://cdn.jsdelivr.net/') || /URI="https:\/\/cdn\.jsdelivr/.test(x.l))
  let p = 0
  await Promise.all(Array.from({ length: 16 }, async () => {
    while (p < idx.length) {
      const { l, i } = idx[p++]
      const url = l.startsWith('http') ? l.trim() : l.match(/URI="([^"]+)"/)[1]
      if (await head(url) !== 200) {
        const raw = url.replace(/^https:\/\/cdn\.jsdelivr\.net\/gh\/([^/]+)\/([^@]+)@([^/]+)\//, 'https://raw.githubusercontent.com/$1/$2/$3/')
        lines[i] = l.startsWith('http') ? raw : l.replace(url, raw)
        fixed++
      }
    }
  }))
  if (!fixed) { console.log(b, ': tous les segments passent, rien à faire'); continue }
  // push de la playlist réparée (contents API, petit fichier)
  const cur = await fetch(`https://api.github.com/repos/matthieuhuguet/zenray-data/contents/${encodeURI(plPath)}`, { headers: H }).then((x) => x.json())
  const put = await fetch(`https://api.github.com/repos/matthieuhuguet/zenray-data/contents/${encodeURI(plPath)}`, {
    method: 'PUT', headers: { ...H, 'content-type': 'application/json' },
    body: JSON.stringify({ message: `fix: ${fixed} segments >20Mo -> raw.githubusercontent (cap jsDelivr)`, content: Buffer.from(lines.join('\n')).toString('base64'), sha: cur.sha }),
  })
  console.log(b, ':', fixed, 'segments réparés, push', put.status)
}
