import { describe, it, expect } from 'vitest'
import { clampPercent, percentGrid, subtitleBox, readSubtitlePrefs, SUB_KEYS } from './subtitleSettings.js'

const store = (obj) => ({ getItem: (k) => (k in obj ? obj[k] : null) })

describe('subtitleSettings', () => {
  it('100 % is exactly the former small size', () => {
    expect(subtitleBox(100).fontSize).toBe('clamp(14px, 1.8cqi, 40px)')
  })
  it('other percentages scale the former small', () => {
    expect(subtitleBox(50).fontSize).toBe('clamp(7px, 0.9cqi, 20px)')
    expect(subtitleBox(75).borderRadius).toBe('clamp(4.5px, 0.45cqi, 10.5px)')
  })
  it('the percentage is stepped and bounded', () => {
    expect(clampPercent(77)).toBe(75)
    expect(clampPercent(3)).toBe(25)
    expect(clampPercent(900)).toBe(150)
    expect(clampPercent('nope')).toBe(75)
  })
  it('the fine grid goes every 5 %', () => {
    const grid = percentGrid()
    expect(grid[0]).toBe(25); expect(grid[1]).toBe(30); expect(grid.at(-1)).toBe(150); expect(grid.length).toBe(26)
  })
  it('legacy size names become percentages and defaults are sans with a background', () => {
    expect(readSubtitlePrefs(store({ [SUB_KEYS.legacySize]: 'sm' }))).toEqual({ sizePct: 75, font: 'sans', background: true })
    expect(readSubtitlePrefs(store({ [SUB_KEYS.legacySize]: 'lg' })).sizePct).toBe(150)
    expect(readSubtitlePrefs(store({ [SUB_KEYS.size]: '60', [SUB_KEYS.font]: 'serif', [SUB_KEYS.background]: '0' })))
      .toEqual({ sizePct: 60, font: 'serif', background: false })
    expect(readSubtitlePrefs(null)).toEqual({ sizePct: 75, font: 'sans', background: true })
  })
})
