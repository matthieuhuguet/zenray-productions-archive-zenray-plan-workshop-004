// Helpers/composants partagés par la famille de vues LifeOS (Board, WeekCalendar, Archive, Freelance,
// Trash, Projects, Docs, Domains, Sequence, RepoCommandsPanel…) — extraits de App.jsx (batch refactor
// structurel 2026-07-16, "split App.jsx's 30+ components into files"). `card`/`btn`/`btnGhost` sont des
// générateurs de style (pas des composants), `SectionLabel` et `Bar` sont de petits composants de rendu.
// Placés ici (et pas dans un fichier "Board") pour casser le cycle d'import Board <-> Domains (Domains a
// besoin de Bar, Board a besoin de Domains) sans dupliquer aucun de ces helpers.
import { PALETTE, RADII, TRANSITIONS, FONTS } from '../theme.js'
import { pc } from '../lib/lifeosProgress.js'

export const card = (t) => ({ background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: RADII.lg, padding: '20px 22px' })
export const btn = (t) => ({ background: t.btnSecondaryBg, color: t.btnSecondaryText, border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: '7px 12px', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', cursor: 'pointer', transition: TRANSITIONS.base })
export const btnGhost = (t) => ({ background: 'transparent', color: t.textSecondary, border: `1px dashed ${t.border}`, borderRadius: RADII.sm, cursor: 'pointer', fontFamily: FONTS.sans })

export function SectionLabel({ t, color, children, nomargin }) {
  return <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', textTransform: 'uppercase', letterSpacing: 2, color: color || t.textSecondary, fontWeight: 700, margin: nomargin ? 0 : '34px 0 12px' }}>{children}</div>
}

export function Bar({ t, value, height = 10 }) {
  return <div style={{ height, borderRadius: 99, background: t.border, overflow: 'hidden' }}><div style={{ height: '100%', width: `${pc(value)}%`, borderRadius: 99, background: PALETTE.gradient, transition: TRANSITIONS.smooth }} /></div>
}
