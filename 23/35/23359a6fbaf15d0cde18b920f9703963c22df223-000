// 20 October 2026, 15:10 CEST: article errors remain visible; a late read cannot replace another project.
import React, { useEffect, useState } from 'react'
import { PROJECT_ARTICLE_CONFIG, projectArticleDocument } from '../../lib/assetsProjectArticle.js'
import './ProjectArticle.css'

export default function ProjectArticle({ project, file, readArticle }) {
  const [attempt, setAttempt] = useState(0)
  const [state, setState] = useState({ loading: true })
  const identity = `${project.id}:${file?.id || ''}:${file?.changeToken || file?.sha256 || project.article?.sha256 || ''}`
  useEffect(() => {
    let active = true
    setState({ loading: true })
    ;(async () => {
      try {
        if (!file) throw new Error('Le fichier HTML déclaré pour cet article est absent de l’inventaire.')
        if (!readArticle) throw new Error('La lecture de cet article est indisponible.')
        const html = await readArticle(file, project)
        if (!html?.trim()) throw new Error('Cet article est vide.')
        const document = projectArticleDocument(html)
        if (active) setState({ document, identity })
      } catch (error) { if (active) setState({ error: error.message, identity }) }
    })()
    return () => { active = false }
  }, [identity, readArticle, attempt])
  const current = state.identity === identity ? state : { loading: true }
  return <section className="assets-project-article" aria-label="Article récapitulatif du projet">
    {current.loading ? <p role="status">Lecture de l’article…</p> : current.error ? <div role="alert"><p>{current.error}</p><button type="button" className="assets-button" onClick={() => setAttempt(value => value + 1)}>Réessayer la lecture</button></div> : <iframe title={project.article?.title || `Article de ${project.name}`} sandbox={PROJECT_ARTICLE_CONFIG.sandbox} referrerPolicy="no-referrer" srcDoc={current.document} style={{ height: PROJECT_ARTICLE_CONFIG.frameHeight }} />}
  </section>
}
