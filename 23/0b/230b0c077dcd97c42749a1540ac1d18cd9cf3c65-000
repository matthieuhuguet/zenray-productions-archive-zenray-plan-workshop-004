// 14 October 2026: design A "Minimal absolu" of VideoPlayer2. The tokens exist with the delivered defaults and the top row groups the
// icons in the chosen order. FR : jetons presents avec les defauts livres, rangee du haut dans l'ordre choisi.
import { describe, it, expect } from 'vitest'
import fs from 'node:fs'
import path from 'node:path'

const css = fs.readFileSync(path.resolve(__dirname, '../fonts.css'), 'utf8')
const jsx = fs.readFileSync(path.resolve(__dirname, './VideoPlayer2.jsx'), 'utf8')
const DEFAULTS = { 'bar-bottom': '36px', 'bar-side': '48px', 'bar-h': '4px', top: '22px', 'row-gap': '22px', 'vol-w': '90px', icon: '24px', shadow: '1' }

describe('VideoPlayer2 minimal absolu', () => {
  it.each(Object.entries(DEFAULTS))('token --zr-player-%s defaults to %s', (name, value) => {
    expect(css).toMatch(new RegExp(`--zr-player-${name}:\\s*${value}\\b`))
  })
  it('the chrome has no circle: capsules and glass backgrounds are removed in .zr-minimal scope', () => {
    const scope = css.slice(css.indexOf('design A "Minimal absolu"'))
    expect(scope).toMatch(/\.zr-minimal \.zr-video-glass[\s\S]*background: none/)
    expect(scope).toMatch(/\.zr-minimal \.zr-video-bottom\.zr-video-seek-pill[\s\S]*border-radius: 0/)
  })
  it('the player marks its controls zr-minimal and keeps one top row: pip, volume, then the options', () => {
    expect(jsx).toContain('className="zr-video-controls zr-minimal"')
    const row = jsx.indexOf('className="zr-video-top-row"')
    const pip = jsx.indexOf('togglePip', row)
    const volume = jsx.indexOf('className="zr-video-volume-pill"', row)
    const options = jsx.indexOf('className="zr-video-bottom-right"', row)
    const transport = jsx.indexOf('className="zr-video-transport"', row)
    expect(row).toBeGreaterThan(0)
    expect(row < pip && pip < volume && volume < options && options < transport).toBe(true)
  })
  it('RED: the old separate top left, top right and bottom right containers are gone from the controls', () => {
    expect(jsx).not.toContain('className="zr-video-top-left"')
    expect(jsx).not.toContain('className="zr-video-top-right zr-video-volume-pill"')
  })
})
