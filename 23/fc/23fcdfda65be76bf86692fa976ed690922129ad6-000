// 3 October 2026, 16:34 CEST: actual file edits order projects; polling and cloud publication never count as activity.
export function projectActivityTime(project) {
  const timestamp = (value) => {
    if (value === undefined || value === null || value === '') return 0
    const parsed = typeof value === 'number' ? value : Date.parse(value)
    return Number.isFinite(parsed) && parsed > 0 ? parsed : 0
  }
  // 12 October 2026: generated files (ConversationIndex, FileMap...) are not edits; see assetsProjectCover.js.
  return Math.max(...[project?.lastActivityAt, project?.updatedAt, project?.createdAt, project?.date].map(timestamp), lastFileActivity(project?.files))
}

export const compareProjectsByDateDesc = (a, b) => projectActivityTime(b) - projectActivityTime(a) || String(a?.id || '').localeCompare(String(b?.id || ''))

// Fusionne les projets du registre drive avec les projets par defaut indispensables,
// et trie de maniere strictement decroissante (les plus recents en premier comme une boite mail).
export function mergeAssetsProjects(driveProjects) {
  const list = Array.isArray(driveProjects) ? driveProjects.map(normalizeProject).filter(Boolean) : []
  const knownIds = new Set(list.map((p) => p.id))
  const missing = DEFAULT_ASSETS_PROJECTS.filter((p) => !knownIds.has(p.id))
  const merged = [...list, ...missing]
  return merged.sort(compareProjectsByDateDesc)
}

// Schema v2 is English. Projects written before 2026-09-11 used French keys; this single reader
// accepts both, so no project already on the drive is lost. Writers only produce the English keys.
// FR : le schéma v2 est en anglais ; ce lecteur unique accepte encore les anciennes clés françaises.
export function normalizeProject(p) {
  if (!p || typeof p !== 'object') return null
  return {
    id: p.id || p.nom || p.name,
    name: p.name ?? p.nom ?? '',
    category: p.category ?? p.categorie ?? '',
    summary: p.summary ?? p.resume ?? '',
    date: p.date ?? p.depose ?? '',
    demo: !!p.demo,
    folder: p.folder || null,
    cover: p.cover || null,
    sources: Array.isArray(p.sources) ? p.sources : [],
    showcase: (p.showcase ?? p.vitrine ?? []).map((v) => ({ image: v.image, title: v.title ?? v.titre, note: v.note })),
    components: (p.components ?? p.composants ?? []).map((c) => ({
      name: c.name ?? c.nom, group: c.group ?? c.groupe, short: c.short ?? c.court, engine: c.engine ?? c.moteur,
      size: c.size ?? c.poids, date: c.date, link: c.link ?? c.lien,
    })),
  }
}


// Every leaf path under a project folder. `.DS_Store` never counts as an asset.
// FR : tous les chemins feuilles sous le dossier d'un projet.
export function projectPaths(folder, paths) {
  if (!folder) return []
  const prefix = folder.endsWith('/') ? folder : `${folder}/`
  return paths.filter((p) => p.startsWith(prefix) && !/(^|\/)\.DS_Store/.test(p))
}

// The cover of a project, always a real image MANIFEST. A plan may name the source file
// (`carnet/IMG_7160.jpeg`) or its manifest; both resolve, and without either the first image wins.
// FR : la couverture est toujours un manifeste d'image réel, qu'on la nomme par le fichier ou le manifeste.
export function coverPath(project, own) {
  const c = project.cover
  if (c) {
    if (own.includes(c)) return c
    const hit = own.find((p) => p.endsWith('.img.json') && stripLeafExt(p) === c)
    if (hit) return hit
  }
  return own.find((p) => p.endsWith('.img.json')) || null
}

// 2026-09-23 : up to `max` images for a card mosaic, the chosen cover first.
// FR : jusqu'a `max` images pour la mosaique d'une carte, la couverture en premier.
export function coverPaths(project, own, max = 4) {
  const first = coverPath(project, own)
  const rest = own.filter((p) => p.endsWith('.img.json') && p !== first)
  return (first ? [first, ...rest] : rest).slice(0, max)
}

const isFile = (e) => !!e.contentPath && !e.hasKids
const under = (own, dir) => own.filter((p) => p.startsWith(`${dir}/`))

// What one folder of a project shows, INSIDE ZenRay Assets: its own files, then one group per
// sub-folder with that sub-folder's files, and deeper folders as cards that open in place.
// FR : ce qu'un dossier montre dans ZenRay Assets, ses fichiers, puis un groupe par sous-dossier,
// et les dossiers plus profonds en cartes qui s'ouvrent sur place, sans basculer dans Create.
export function folderView(dir, own) {
  const kids = entriesOf(own, dir)
  // 2026-09-11 A folder card shows the folder icon, never the first image inside: that image is often
  // unrelated (the app wallpaper in an HDA history snapshot) and makes a folder look like a file.
  // FR : une carte de dossier montre l'icône dossier, jamais la première image trouvée dedans.
  const card = (f) => ({ dir: f.dir, name: f.name, count: under(own, f.dir).length })
  return {
    files: kids.filter(isFile),
    groups: kids.filter((e) => e.hasKids).map((sub) => {
      const k = entriesOf(own, sub.dir)
      return { dir: sub.dir, title: sub.name, count: under(own, sub.dir).length, files: k.filter(isFile), folders: k.filter((e) => e.hasKids).map(card) }
    }),
  }
}

// The breadcrumb from the project folder down to the open folder. FR : le fil d'Ariane du projet.
export function crumbs(root, dir) {
  if (!dir || dir === root || !dir.startsWith(`${root}/`)) return []
  const parts = dir.slice(root.length + 1).split('/')
  return parts.map((name, i) => ({ name, dir: `${root}/${parts.slice(0, i + 1).join('/')}` }))
}

// Project-level storage state: orange as soon as one source still sits on the Mac.
// FR : état du projet, orange dès qu'une source est encore sur le Mac.
export function storageState(project) {
  const sources = project.sources || []
  if (!sources.length) return null
  // A `keep` source is versioned elsewhere (Git): it stays on the Mac by design and never counts as
  // space to free. FR : une source `keep` est versionnée ailleurs, elle reste sur le Mac et ne compte pas.
  const local = sources.filter((s) => s.present && !s.keep)
  const bytes = local.reduce((n, s) => n + (Number(s.bytes) || 0), 0)
  return local.length
    ? { color: UI.orange, label: `Aussi sur ce Mac${bytes ? ` · ${readableSize(bytes)}` : ''}` }
    : { color: UI.green, label: 'Uniquement sur le cloud' }
}

// The colour and label of ONE source line. FR : couleur et libellé d'une ligne de source.
export function sourceState(s) {
  if (s.keep) return { color: UI.blue, label: 'versionné, reste sur le Mac' }
  return s.present ? { color: UI.orange, label: readableSize(s.bytes) || 'sur le Mac' } : { color: UI.green, label: 'supprimé du Mac' }
}

// A speaking thumbnail for a text file: its title and first lines, read from the file itself.
// Markdown keeps its words without the syntax, HTML its <title> and visible text, code its first lines.
// FR : la vignette parlante d'un fichier texte, son titre et ses premières lignes, lus dans le fichier.
export function excerptOf(name, text, maxLines = 9) {
  const ext = (/\.([a-z0-9]+)$/i.exec(name || '') || [])[1]?.toLowerCase() || ''
  const src = String(text || '')
  if (ext === 'md' || ext === 'markdown') {
    const lines = src.split('\n').map((l) => l.trim()).filter((l) => l && !/^(-{3,}|```|\|?[-:| ]+\|?)$/.test(l))
    const heading = lines.find((l) => /^#{1,6}\s/.test(l))
    const clean = (l) => l.replace(/^#{1,6}\s+|^>\s?|^[-*+]\s+|^\d+\.\s+/, '').replace(/[*_`]/g, '').replace(/\[([^\]]*)\]\([^)]*\)/g, '$1').replace(/\|/g, ' ').trim()
    const body = lines.filter((l) => l !== heading).map(clean).filter(Boolean)
    return { title: heading ? clean(heading) : '', lines: body.slice(0, maxLines), mono: false }
  }
  if (ext === 'html' || ext === 'htm') {
    const title = (/<title[^>]*>([\s\S]*?)<\/title>/i.exec(src) || [])[1]?.trim() || ''
    const body = src.replace(/<(script|style|head)[\s\S]*?<\/\1>/gi, ' ')
      .replace(/<\/(p|div|h[1-6]|li|section|article|header|footer|tr)>|<br\s*\/?>/gi, '\n')
      .replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&[a-z#0-9]+;/gi, ' ')
    const lines = body.split('\n').map((l) => l.replace(/\s+/g, ' ').trim()).filter((l) => l.length > 1)
    return { title, lines: lines.slice(0, maxLines), mono: false }
  }
  const lines = src.split('\n').map((l) => l.replace(/\t/g, '  ').replace(/\s+$/, '')).filter((l) => l.trim())
  return { title: '', lines: lines.slice(0, maxLines + 3), mono: true }
}
