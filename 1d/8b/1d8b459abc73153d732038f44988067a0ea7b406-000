// Chrome en verre (sidebar, toolbar, panneaux). Le CONTENU reste opaque (card()).
export const glassPanel = (t) => {
  const g = (t && t.glass) || THEMES.light.glass;
  return {
    background: g.bg,
    backdropFilter: g.filter,
    WebkitBackdropFilter: g.filter,
    boxShadow: `${g.edge}, ${SHADOWS.apple}`,
  };
};

// Apple Liquid Glass — preset NORMAL, migré le 2026-07-19 vers la recette V9 unique du reste du site
// (fonts.css :root/.zr-dark, `--g9-*`, ratio de liseré 0.20) : clic droit, fil d'ariane, menu "...", menu
// "New" utilisaient encore l'ANCIEN verre (rgba fixes, jamais mis à jour depuis la V9 -- retour Matthieu
// 2026-07-19, captures des 4 menus). Valeurs recopiées ICI en dur plutôt que lues via var(--g9-*) : ce
// composant se porte dans document.body (ColumnMenuShell -> createPortal), HORS de la div .zr-dark posée
// sur la racine de l'app (App.jsx) -- des var(--g9-*) y résoudraient TOUJOURS les valeurs :root (clair),
// jamais .zr-dark, quel que soit le thème réellement actif. `t` (déjà passé par tous les appelants) reste
// donc la seule source fiable de dark/light ici. Chiffres = exactement ceux de fonts.css à ratio 0.20 (le
// défaut actuel de --g9-rim-ratio) : une divergence du curseur global n'est PAS suivie par ce menu (portail
// hors arbre), mais les DEUX presets restent synchronisés avec la valeur de référence du jour.
export const liquidGlassNormal = (t) => {
  const dark = t && t.textPrimary === PALETTE.textPrimaryDark;
  return {
    background: dark
      ? "linear-gradient(135deg, rgba(255,255,255,.20), rgba(255,255,255,.065))"
      : "linear-gradient(135deg, rgba(255,255,255,.76), rgba(229,233,239,.42))",
    backdropFilter: "blur(27px) saturate(169%)",
    WebkitBackdropFilter: "blur(27px) saturate(169%)",
    border: "none",
    boxShadow: dark
      ? [
          "0 0 0 .72px rgba(0,0,0,.132)",
          "inset 0 1px 0 rgba(255,255,255,.144)",
          "inset 0 -1px 0 rgba(255,255,255,.144)",
          "inset 0 2px 0 rgba(255,255,255,.032)",
          "inset 0 -2px 0 rgba(255,255,255,.032)",
          "inset 1px 0 0 rgba(255,255,255,.017)",
          "inset -1px 0 0 rgba(255,255,255,.017)",
          "0 14px 36px rgba(0,0,0,.27)",
          "0 3px 11px rgba(0,0,0,.15)",
        ].join(", ")
      : [
          "0 0 0 0 transparent",
          "inset 0 1px 0 rgba(34,37,43,.092)",
          "inset 0 -1px 0 rgba(34,37,43,.092)",
          "inset 0 2px 0 rgba(34,37,43,.036)",
          "inset 0 -2px 0 rgba(34,37,43,.036)",
          "inset 1px 0 0 rgba(34,37,43,.020)",
          "inset -1px 0 0 rgba(34,37,43,.020)",
          "0 14px 38px rgba(62,67,78,.13)",
          "0 3px 12px rgba(62,67,78,.08)",
        ].join(", "),
  };
};
