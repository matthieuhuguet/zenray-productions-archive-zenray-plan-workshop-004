const CPU = Math.max(1, (os.cpus() || []).length || 8)

if (!TOKEN) { console.error('no GITHUB_TOKEN'); process.exit(1) }

// URL jsDelivr PINNÉE commit (alignée sur shardNaming.js buildJsDelivrUrl côté client).
const buildJsDelivrUrl = (repo, commit, p) => (!repo || !commit || !p) ? null : `https://cdn.jsdelivr.net/gh/${OWNER}/${repo}@${commit}/${p}`
const toWebp = (p) => (typeof p === 'string' ? p.replace(/\.[^./]+$/, '.webp') : null)

// Valeur thumbs pour un manifeste .img.json, RÉUTILISE EXACTEMENT la logique de shardThumbUrl
// (ImageNodeViewer.jsx) : public + cdnRepo/cdnPath/cdnCommit -> {u} jsDelivr .webp ; sinon repo+path
// (privé/legacy) -> {r,p} avec path.webp ; sinon (rien de constructible) -> null (omis).
// search-8 : MIROIR de thumbEntry (server/page.js index-add) et de shardThumbUrl (ImageNodeViewer.jsx).
// Ces TROIS implémentations encodent le même invariant « manifeste -> vignette vis-aware ». Si la règle
// de visibilité change, garder les trois synchronisées (sinon vignettes incohérentes selon le chemin).
//
// E (chiffrement public) : un thumb public peut désormais être CHIFFRÉ (modèle "public + chiffré + jsDelivr").
// Dans ce cas l'URL jsDelivr pointe sur du CIPHERTEXT inutilisable tel quel dans <img> : la recherche doit
// fetch + déchiffrer (AES-GCM) avec l'IV de la VIGNETTE avant d'afficher. On joint donc `iv` à l'entrée -> {u, iv}.
// L'IV de la vignette est `thumbIv` (IV propre au .webp chiffré, distinct de l'IV du binaire plein). Rétro-compat :
// un manifeste public NON chiffré (pas de thumbIv/alg) reste `{u}` seul -> URL servie directement à <img> (clair),
// comportement inchangé. L'IV n'est PAS secret (juste unique par chiffrement) : aucune fuite à le publier dans l'index.
function thumbEntry(m) {
  if (!m || typeof m !== 'object') return null
  // Gate élargi (2026-07-07) : ancien schéma mono-fichier (cdnPath) ET nouveau découpé en morceaux ≤19 Mo
  // (cdnChunks[]) — la vignette n'est jamais chunkée, seul ce test doit reconnaître les deux formes.
  const hasChunks = Array.isArray(m.cdnChunks) && m.cdnChunks.length > 0
  if (m.vis === 'public' && m.cdnRepo && (m.cdnPath || hasChunks) && m.cdnCommit) {
    // La VIGNETTE a son PROPRE hash de contenu (≠ hash de l'original = cdnPath). Le manifeste porte l'URL
    // jsDelivr CORRECTE dans m.thumb -> l'utiliser telle quelle. toWebp(cdnPath) donnait le hash de l'original
    // + .webp (404). Repli (vieux manifestes sans thumb) : toWebp(cdnPath), uniquement possible côté cdnPath.
    const u = m.thumb || (m.cdnPath ? buildJsDelivrUrl(m.cdnRepo, m.cdnCommit, toWebp(m.cdnPath)) : null)
    if (!u) return null
    // Vignette chiffrée -> joindre l'IV du .webp (thumbIv) pour permettre le déchiffrement client.
    if (m.thumbIv && m.alg) return { u, iv: m.thumbIv }
    return { u }
  }
  if (m.repo) {
    // Vignette = chemin haché + .webp (vérité unique ; aucun champ `thumb` n'est jamais écrit au manifest).
    const p = toWebp(m.path)
    if (p) return { r: m.repo, p }
  }
  return null
}

// Marche récursive de l'arbre disque (sous pages/) -> chemins de nœuds (relatifs à la racine du repo).
async function walk(absRoot, relDir, out) {
  const abs = path.join(absRoot, relDir)
  let entries
  try { entries = await readdir(abs, { withFileTypes: true }) } catch { return }
  const subdirs = []
  for (const e of entries) {
    const rel = relDir ? `${relDir}/${e.name}` : e.name
    if (e.isDirectory()) subdirs.push(rel)
    else if (e.isFile() && RE_NOEUD.test(e.name)) out.push(rel)
  }
  for (const d of subdirs) await walk(absRoot, d, out)
}

// CONTENU PLEIN-TEXTE (recherche par mot-clé dans les markdowns ET les tables).
// .md  : on dégraisse la syntaxe markdown (liens/images/marqueurs) -> texte brut.
// .db.json : noms de colonnes + toutes les valeurs de cellules concaténés.
// Normalisé (minuscules, accents retirés, espaces compactés) + tronqué (~6 Ko) pour garder l'index léger.
const normTxt = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\s+/g, ' ').trim().slice(0, 6000)
const mdToText = (md) => (md || '')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ') // images
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1') // liens -> texte
  .replace(/[#>*_`~|-]+/g, ' ') // marqueurs
  .replace(/<[^>]+>/g, ' ')
const dbToText = (json) => {
  try {
    const j = JSON.parse(json)
    const heads = (j.columns || []).map((c) => c.name).join(' ')
    const cells = (j.rows || []).map((r) => Object.values(r.cells || r || {}).map((v) => (v && typeof v === 'object') ? '' : String(v ?? '')).join(' ')).join(' ')
    return `${j.name || ''} ${heads} ${cells}`
  } catch { return '' }
}
async function buildContent(absRoot, textPaths) {
  const content = {}
  let i = 0
  async function worker() {
    while (i < textPaths.length) {
      const rel = textPaths[i++]
      try {
        const raw = await readFile(path.join(absRoot, rel), 'utf8')
        const txt = normTxt(rel.endsWith('.db.json') ? dbToText(raw) : mdToText(raw))
        if (txt) content[rel] = txt
      } catch { /* illisible -> omis */ }
    }
  }
  await Promise.all(Array.from({ length: Math.min(CPU, 16) }, worker))
  return content
}

// ═══ LES LIENS EAGLE ONT AUSSI UNE VIGNETTE, ET IL FAUT ALLER LA CHERCHER (2026-08-31) ══════════
//
// LE SYMPTÔME, signalé par Matthieu : « aucune miniature des médias isolés en mode liens », et une
// pastille de provenance orange au lieu de verte.
//
// LA CAUSE. Un lien Eagle est un `.img.json` qui ne contient QUE `{ v, type, resourceId, title,
// createdAt }` — c'est tout son intérêt, cent cinquante octets au lieu d'une photo. Il n'a donc ni
// `thumb`, ni `cdnRepo`, ni `size`, ni `mime`. `thumbEntry` rendait `null`, l'index n'avait aucune
// vignette à servir, et la tuile affichait une case vide. La pastille, qui lit la provenance dans
// les mêmes champs, tombait sur « aucune source connue » et virait à l'orange.
//
// LA RÉSOLUTION SE FAIT ICI ET NON DANS L'INTERFACE, et c'est le point important. Faire résoudre
// chaque lien par la grille coûterait un appel réseau PAR TUILE — trois pour trois liens, mais sept
// cent quarante-huit pour un dossier de photos, sur un quota de cinq mille par heure déjà épuisé
// deux fois sur ce dépôt. L'index, lui, est construit une fois et lu par tout le monde : c'est
// exactement ce pour quoi la carte `thumbs` existe.
//
// TOUT SE LIT SUR DISQUE. Le clone contient `pages/`, donc aussi `pages/.zr-resources/` où vivent
// les registres. Zéro octet de réseau ajouté.

// Carte `resourceId -> chemin du manifeste canonique`, construite en une passe.
async function lireRegistres(absRoot) {
  const carte = new Map()
  const dir = path.join(absRoot, 'pages/.zr-resources')
  let noms = []
  try { noms = await readdir(dir) } catch { return carte }   // aucun lien encore créé : rien à faire
  for (const nom of noms) {
    if (!nom.endsWith('.json')) continue
    try {
      const r = JSON.parse(await readFile(path.join(dir, nom), 'utf8'))
      if (r && typeof r.resourceId === 'string' && typeof r.sourcePath === 'string') carte.set(r.resourceId, r.sourcePath)
    } catch { /* registre illisible -> le lien restera sans vignette, pas de fausse vignette */ }
  }
  return carte
}

const estLienEagle = (m) => !!(m && m.type === 'zenray-eagle-link/v1' && typeof m.resourceId === 'string')

// Lecture + parse parallélisée (CPU cœurs) des .img.json -> remplit la carte thumbs.
async function buildThumbs(absRoot, imgPaths, registres) {
  const thumbs = {}
  // Un manifeste canonique sert souvent plusieurs liens : on ne le relit qu'une fois.
  const cacheCanonique = new Map()
  let i = 0
  async function worker() {
    while (i < imgPaths.length) {
      const idx = i++
      const rel = imgPaths[idx]
      try {
        const txt = await readFile(path.join(absRoot, rel), 'utf8')
        const m = JSON.parse(txt)
        if (estLienEagle(m)) {
          const source = registres.get(m.resourceId)
          if (!source) continue                      // registre absent : pas de fausse vignette
          if (!cacheCanonique.has(source)) {
            try { cacheCanonique.set(source, JSON.parse(await readFile(path.join(absRoot, source), 'utf8'))) }
            catch { cacheCanonique.set(source, null) }
          }
          const canon = cacheCanonique.get(source)
          const v = canon ? thumbEntry(canon) : null
          if (v) thumbs[rel] = v
          continue
        }
        const v = thumbEntry(m)
        if (v) thumbs[rel] = v
      } catch { /* manifeste illisible -> omis (placeholder propre) */ }
    }
  }
  await Promise.all(Array.from({ length: Math.min(CPU, 16) }, worker))
  return thumbs
}

const t0 = Date.now()
