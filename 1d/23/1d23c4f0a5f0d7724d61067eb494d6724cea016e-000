// ── SHARDS CHIFFRÉS PAR DOSSIER RACINE -> repo PUBLIC (servi par raw, 0 quota API GitHub) ────────────
// Modèle "public + chiffré + jsDelivr/raw" (même clé maître que les médias). On découpe l'index en UN shard
// par dossier de 1er niveau sous pages/, chiffré AES-GCM. head.json (clair, sans noms : dossiers hachés)
// liste les shards + le builtAt. Le client lit head.json + le(s) shard(s) via raw@main (cache ~5 min, hors
// quota REST), déchiffre avec la clé maître. Scalable : ouvrir un dossier = 1 shard, indépendant du total.
const SCRIPT_DIR = path.dirname(fileURLToPath(import.meta.url))
const loadKeyB64 = () => { const e = process.env.ZENRAY_MEDIA_KEY; if (e && /^[A-Za-z0-9+/=]{40,}$/.test(e)) return e.trim(); return readFileSync(path.join(SCRIPT_DIR, '..', '.zenray-media-key'), 'utf8').trim() }
const rootOf = (p) => { const parts = p.split('/'); return parts.length > 2 ? parts[1] : '_root' } // parts[0]='pages'
const hashRoot = (r) => createHash('sha256').update(r).digest('hex').slice(0, 16)
async function encStr(key, str) {
  const iv = webcrypto.getRandomValues(new Uint8Array(12))
  const ct = new Uint8Array(await webcrypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, new TextEncoder().encode(str)))
  return { iv: Buffer.from(iv).toString('base64'), ct: Buffer.from(ct).toString('base64') }
}
console.log('\n--apply : shards chiffrés par dossier -> zenray-index-public (raw, 0 API) ...')
const cryptoKey = await webcrypto.subtle.importKey('raw', Uint8Array.from(Buffer.from(loadKeyB64(), 'base64')), { name: 'AES-GCM' }, false, ['encrypt'])
const groups = new Map()
for (const p of paths) { const r = rootOf(p); if (!groups.has(r)) groups.set(r, { paths: [], thumbs: {}, content: {}, sizes: {}, mimes: {} }); const g = groups.get(r); g.paths.push(p); if (thumbs[p]) g.thumbs[p] = thumbs[p]; if (content[p]) g.content[p] = content[p]; if (sizes[p] != null) g.sizes[p] = sizes[p]; if (mimes[p]) g.mimes[p] = mimes[p] }
const IREPO = `${OWNER}/zenray-index-public`
try { execFileSync('gh', ['repo', 'view', IREPO], { stdio: 'ignore' }) } catch { execFileSync('gh', ['repo', 'create', IREPO, '--public', '-d', 'ZenRay search index — shards chiffrés (AES-GCM), servis par CDN'], { stdio: 'inherit' }) }
const W2 = path.join(os.tmpdir(), 'zr_index_public')
await rm(W2, { recursive: true, force: true }).catch(() => {})
execFileSync('git', ['clone', '--quiet', '--depth=1', `https://x-access-token:${TOKEN}@github.com/${IREPO}.git`, W2], { stdio: 'inherit' })
await rm(path.join(W2, 's'), { recursive: true, force: true }).catch(() => {}) // repart d'un set de shards propre
await mkdir(path.join(W2, 's'), { recursive: true })
// Un dossier énorme (ex. References, 117k images) dépasserait la limite 50 Mo/fichier jsDelivr -> on le
// re-découpe en TRANCHES de PART nœuds. Fichier `s/<h>-<part>.json`, head liste chaque tranche {h, part, n}.
const shardList = []
let maxShard = 0
const PART = 20000
for (const [r, g] of groups) {
  const h = hashRoot(r)
  const nParts = Math.max(1, Math.ceil(g.paths.length / PART))
  for (let pi = 0; pi < nParts; pi++) {
    const slice = g.paths.slice(pi * PART, (pi + 1) * PART)
    const sub = { paths: slice, thumbs: {}, content: {}, sizes: {}, mimes: {} }
    for (const p of slice) { if (g.thumbs[p]) sub.thumbs[p] = g.thumbs[p]; if (g.content[p]) sub.content[p] = g.content[p]; if (g.sizes[p] != null) sub.sizes[p] = g.sizes[p]; if (g.mimes[p]) sub.mimes[p] = g.mimes[p] }
    const blob = await encStr(cryptoKey, JSON.stringify(sub))
    maxShard = Math.max(maxShard, blob.ct.length)
    await writeFile(path.join(W2, 's', `${h}-${pi}.json`), JSON.stringify(blob))
    shardList.push({ h, part: pi, n: slice.length })
  }
}
await writeFile(path.join(W2, 'head.json'), JSON.stringify({ v: 1, builtAt: index.builtAt, count: paths.length, shards: shardList }))
// Le rebuild complet replie tout dans les shards -> on REMET LE DELTA À ZÉRO (ajouts déjà inclus ci-dessus).
const emptyDelta = await encStr(cryptoKey, JSON.stringify({ paths: [], thumbs: {}, content: {} }))
await writeFile(path.join(W2, 'delta.json'), JSON.stringify({ v: 1, builtAt: index.builtAt, ...emptyDelta }))
const g2 = (...a) => execFileSync('git', ['-C', W2, ...a], { stdio: 'inherit' })
g2('add', '-A')
g2('-c', 'user.email=index@zenray', '-c', 'user.name=zr-index', 'commit', '-m', `index shards: ${groups.size} dossiers, ${paths.length} noeuds`)
g2('push', 'origin', 'HEAD:main')
await rm(W2, { recursive: true, force: true }).catch(() => {})
console.log(`shards poussés: ${groups.size} dossiers -> ${IREPO} (plus gros shard ~${(maxShard / 1048576).toFixed(1)} Mo)`)

await rm(WORK, { recursive: true, force: true }).catch(() => {})
