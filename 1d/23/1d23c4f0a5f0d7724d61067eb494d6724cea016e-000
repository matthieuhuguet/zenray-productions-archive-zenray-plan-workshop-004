// TAILLES par nœud (octets) -> l'app affiche la taille de N'IMPORTE quel fichier SANS appel API.
// Manifestes (img/media/file) : champ `size` du JSON. Autres (.md/.db/.canvas/.embed) : taille sur disque.
// Lecture locale parallèle, hors quota. Couvre archive (.file.json) ET drag-drop/bulk (.media/.img.json).
// Récupère AUSSI le mime des nœuds média/fichier (mimes) -> l'app choisit la bonne icône (ex: PDF) depuis
// l'index, sans fetch runtime fragile. mimes ne contient QUE les .media/.file (pas les images : icône déjà connue).
async function buildSizes(absRoot, all, registres) {
  const sizes = {}, mimes = {}; let i = 0
  async function w() {
    while (i < all.length) {
      const rel = all[i++]
      try {
        if (/\.(img|media|file)\.json$/.test(rel)) {
          let m = JSON.parse(await readFile(path.join(absRoot, rel), 'utf8'))
          // Un lien porte 172 octets ; sa TAILLE affichée doit être celle du média, pas celle du
          // lien, sinon l'app annonce « 172 o » pour une photo de dix-huit mégaoctets.
          if (estLienEagle(m)) {
            const source = registres.get(m.resourceId)
            if (!source) continue
            try { m = JSON.parse(await readFile(path.join(absRoot, source), 'utf8')) } catch { continue }
          }
          if (Number.isFinite(m.size)) sizes[rel] = m.size
          if (m.mime && /\.(media|file)\.json$/.test(rel)) mimes[rel] = m.mime
        } else sizes[rel] = (await stat(path.join(absRoot, rel))).size
      } catch { /* illisible -> omis */ }
    }
  }
  await Promise.all(Array.from({ length: Math.min(CPU, 16) }, w))
  return { sizes, mimes }
}
console.log(`tailles + mimes par nœud (manifestes + disque) ...`)
