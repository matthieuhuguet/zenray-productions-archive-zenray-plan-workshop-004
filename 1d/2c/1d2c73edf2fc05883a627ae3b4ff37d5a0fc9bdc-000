#!/usr/bin/env node
// ZenRayMedia — associe une police à chacune des 128 sous-familles de thèmes.
//
//   node scripts/zrm-map-fonts.mjs
//
// LE CALCUL, posé une fois : le catalogue compte 16 familles x 8 sous-familles = 128 SOUS-FAMILLES.
// Les huit variantes d'une sous-famille PARTAGENT leur police — elles se distinguent par la
// graisse, l'échelle, la casse et l'interlettrage, jamais par la famille typographique. Donc
// 128 polices installées = exactement une par sous-famille, sans doublon et sans manque.
// C'est pour cela que le catalogue de `zrm-fonts.mjs` en compte 128 et pas un nombre rond choisi
// au hasard.

import { readFile, writeFile } from 'node:fs/promises'
import { readdir } from 'node:fs/promises'
import path from 'node:path'
import { FONTS } from '../src/zenraymedia/fonts.js'

const ROOT = path.resolve(import.meta.dirname, '..')
const DOCS = path.join(ROOT, 'docs', 'zenraymedia')
const OUT = path.join(ROOT, 'src', 'zenraymedia', 'themeFonts.js')

// Affinité famille de thèmes -> archétypes typographiques, par ordre de préférence.
// Ce n'est pas du goût : une chaîne d'info a besoin d'un condensé, une maison de couture d'un
// didone, un trailer de jeu d'une famille technique. L'archétype vient du métier.
const AFFINITY = {
  '01': ['labeur', 'humaniste'],   // Presse & éditorial
  '02': ['condense', 'display'],   // Télévision & broadcast
  '03': ['didone', 'display'],     // Cinéma & trailer
  '04': ['technique', 'mono'],     // Jeu vidéo
  '05': ['display', 'grotesque'],  // Publicité & retail
  '06': ['didone', 'script'],      // Luxe & mode
  '07': ['grotesque', 'display'],  // Social vertical
  '08': ['grotesque', 'humaniste'],// Créateur & YouTube
  '09': ['display', 'technique'],  // Musique & sound
  '10': ['grotesque', 'mono'],     // Tech & produit
  '11': ['grotesque', 'labeur'],   // Corporate & institution
  '12': ['humaniste', 'labeur'],   // Science & pédagogie
  '13': ['condense', 'technique'], // Sport & compétition
  '14': ['display', 'script'],     // Événement & affiche
  '15': ['humaniste', 'didone'],   // Architecture, design & art
  '16': ['labeur', 'didone'],      // Japon & Asie (le CJK n'est pas installé par défaut)
}

async function readSubfamilies() {
  const files = (await readdir(DOCS)).filter((f) => /^05-THEMES-1024-[A-D]\.md$/.test(f)).sort()
  const subs = []
  for (const file of files) {
    const text = await readFile(path.join(DOCS, file), 'utf8')
    let familyLabel = null
    for (const line of text.split('\n')) {
      const fam = /^# Famille (\d\d) — (.+)$/.exec(line.trim())
      if (fam) { familyLabel = fam[2]; continue }
      const sub = /^## (\d\d)-([1-8]) — (.+)$/.exec(line.trim())
      if (sub) subs.push({ id: `${sub[1]}-${sub[2]}`, family: sub[1], familyLabel, label: sub[3] })
    }
  }
  return subs
}

async function main() {
  const subs = await readSubfamilies()
  if (subs.length !== 128) throw new Error(`attendu 128 sous-familles, trouvé ${subs.length}`)

  const pool = {}
  for (const f of FONTS) (pool[f.archetype] ||= []).push(f.family)

  const used = new Set()
  const mapping = {}
  for (const sub of subs) {
    const candidates = (AFFINITY[sub.family] || ['grotesque']).flatMap((a) => pool[a] || [])
    if (!candidates.length) throw new Error(`aucune police pour la famille ${sub.family}`)
    // Première non encore prise : garantit 128 polices DISTINCTES tant que le vivier suffit.
    const pick = candidates.find((c) => !used.has(c)) || candidates[0]
    used.add(pick)
    mapping[sub.id] = { font: pick, label: sub.label, family: sub.familyLabel }
  }

  const distinct = new Set(Object.values(mapping).map((v) => v.font)).size
  const rows = Object.entries(mapping)
    .map(([k, v]) => `  ${JSON.stringify(k)}: { font: ${JSON.stringify(v.font)}, label: ${JSON.stringify(v.label)}, family: ${JSON.stringify(v.family)} },`)
    .join('\n')

  const code = `// ZenRayMedia — police par défaut de chacune des 128 sous-familles. GÉNÉRÉ, ne pas éditer.
// Regénérer : node scripts/zrm-map-fonts.mjs
//
// 16 familles x 8 sous-familles = 128 sous-familles. Les huit variantes d'une sous-famille
// partagent leur police : elles se distinguent par la graisse, l'échelle, la casse et
// l'interlettrage, jamais par la famille typographique. 128 polices = une par sous-famille.
//
// L'affectation suit l'affinité d'archétype (presse -> labeur, télévision -> condensé,
// luxe -> didone, jeu video -> technique), pas le goût. Un gabarit reste libre de déclarer une
// autre police dans son en-tête zr-theme : cette table est un point de départ, pas une prison.

export const SUBFAMILY_FONTS = {
${rows}
}

/** Police par défaut d'un thème, dérivée de son identifiant T-FF-S-V. */
export function defaultFontFor(themeId) {
  const m = /^T-(\\d{2})-([1-8])-[1-8]$/.exec(String(themeId || ''))
  return m ? (SUBFAMILY_FONTS[m[1] + '-' + m[2]]?.font || null) : null
}

/** Les sous-familles servies par une police donnée. */
export function subfamiliesUsing(font) {
  return Object.entries(SUBFAMILY_FONTS).filter(([, v]) => v.font === font).map(([k]) => k)
}

/** Nombre de polices distinctes réellement employées. */
export const DISTINCT_FONTS = ${distinct}
`

  try { new Function(code.replace(/^export /gm, '')) }
  catch (err) { throw new Error(`table générée invalide (${err.message}) — rien n'a été écrit`) }

  await writeFile(OUT, code, 'utf8')
  console.log(`${subs.length} sous-familles mappées · ${distinct} polices distinctes · ${FONTS.length} installées`)
  const unused = FONTS.map((f) => f.family).filter((f) => !used.has(f))
  if (unused.length) console.log(`non employées (${unused.length}) : ${unused.slice(0, 8).join(', ')}${unused.length > 8 ? '…' : ''}`)
}

main().catch((err) => { console.error(err.message); process.exit(1) })
