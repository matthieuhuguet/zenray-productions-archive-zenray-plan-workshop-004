import React from 'react'
import { createRoot } from 'react-dom/client'
import { inject } from '@vercel/analytics'
import './fonts.css'
import App from './App.jsx'
import { installApiAuth } from './lib/apiAuth.js'
import { lazyRetry } from './lib/lazyRetry.js'

installApiAuth() // injecte x-zr-auth sur les appels /api/* (no-op si aucun secret stocké / gate serveur désactivé)
inject()

// SERVICE WORKER « range-shim » vidéo brute : enregistré au démarrage pour qu'il CONTRÔLE la page avant toute
// lecture (sinon la 1re vidéo après un chargement à froid pourrait nécessiter un reload). Sert /zr-stream/<id>
// en recollant les parts 95 Mo de raw.github. Best-effort : un échec n'impacte rien d'autre.
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => { navigator.serviceWorker.register('/zr-stream-sw.js', { scope: '/' }).catch(() => {}) })
}

// ERROR BOUNDARY GLOBAL — un crash de render (n'importe quelle vue) ne doit JAMAIS blanchir toute l'app.
// On affiche un message récupérable + l'erreur, et un bouton qui RÉINITIALISE la vue active (zr:tabs/zr:view)
// pour échapper une vue qui plante en boucle, puis recharge. Sans ça, une erreur composant = écran blanc total
// (vu 2x : BUG-CRIT page blanche). Cette barrière rend tout crash futur visible et non bloquant.
class ErrorBoundary extends React.Component {
  constructor(p) { super(p); this.state = { err: null } }
  static getDerivedStateFromError(err) { return { err } }
  componentDidCatch(err, info) { try { console.error('[zr] render crash', err, info && info.componentStack) } catch {} }
  render() {
    if (!this.state.err) return this.props.children
    const msg = String((this.state.err && this.state.err.message) || this.state.err || 'erreur inconnue')
    const resetView = () => { try { ['zr:tabs', 'zr:view', 'zr:activeTab', 'zr:create:cur'].forEach((k) => localStorage.removeItem(k)) } catch {}; location.reload() }
    return (
      <div style={{ minHeight: '100vh', display: 'grid', placeItems: 'center', padding: 24, fontFamily: "var(--zr-police-sans)", color: '#1F1F1E' }}>
        <div style={{ maxWidth: 520, width: '100%', padding: '26px 28px', borderRadius: 18, background: 'rgba(253,253,252,0.9)', backdropFilter: 'blur(30px) saturate(180%)', WebkitBackdropFilter: 'blur(30px) saturate(180%)', boxShadow: 'inset 1.5px 1.5px 1px rgba(255,255,255,0.6), 0 22px 60px -24px rgba(20,30,70,0.45)' }}>
          <div style={{ fontSize: 'var(--zr-ui-3xl)', fontWeight: 500, marginBottom: 8 }}>Une vue a rencontré une erreur</div>
          <div style={{ fontSize: 'var(--zr-ui-md)', color: '#6b6b69', lineHeight: 1.5, marginBottom: 14 }}>Le reste de l'app fonctionne. Reviens à l'accueil pour échapper la vue qui plante.</div>
          <pre style={{ fontSize: 'var(--zr-ui-xs)', fontFamily: 'var(--zr-police-mono)', background: 'rgba(0,0,0,0.05)', padding: '10px 12px', borderRadius: 10, overflow: 'auto', maxHeight: 160, whiteSpace: 'pre-wrap', margin: '0 0 16px' }}>{msg}</pre>
          <div style={{ display: 'flex', gap: 10 }}>
            <button onClick={resetView} style={{ padding: '9px 18px', borderRadius: 11, border: 'none', cursor: 'pointer', background: '#0A84FF', color: '#fff', fontSize: 'var(--zr-ui-md)', fontWeight: 500, fontFamily: 'inherit' }}>Revenir à l'accueil</button>
            <button onClick={() => location.reload()} style={{ padding: '9px 16px', borderRadius: 11, border: '1px solid rgba(0,0,0,0.12)', cursor: 'pointer', background: 'transparent', color: '#1F1F1E', fontSize: 'var(--zr-ui-md)', fontFamily: 'inherit' }}>Recharger</button>
          </div>
        </div>
      </div>
    )
  }
}

// ROUTE PUBLIQUE de partage vidéo : /watch?v=<token> -> page autonome « vidéo only » (lecteur + téléchargement,
// AUCUN accès au drive, pas de PinGate, pas de sidebar). Court-circuite App entièrement.
const LazyShareVideoPage = lazyRetry(() => import('./components/ShareVideoPage.jsx'))
// ROUTE PUBLIQUE de partage DOSSIER/GALERIE : /folder?d=<token> -> galerie autonome du dossier (vignettes +
// ouverture des médias), UI cachée, navigation bornée SOUS la racine partagée. Court-circuite App.
const LazySharedFolderPage = lazyRetry(() => import('./components/SharedFolderPage.jsx'))
// ROUTE PUBLIQUE de partage IMAGE SEULE : /view?v=<token> -> page autonome « image only » (affichage +
// téléchargement de l'original, AUCUN accès au drive, pas de PinGate, pas de sidebar). Même patron que /watch.
const LazyShareImagePage = lazyRetry(() => import('./components/ShareImagePage.jsx'))
const pathName = typeof window !== 'undefined' ? window.location.pathname : ''
const isShare = pathName === '/watch'
const isFolderShare = pathName === '/folder'
const isImageShare = pathName === '/view'
createRoot(document.getElementById('root')).render(
  <ErrorBoundary>
    {isShare
      ? <React.Suspense fallback={null}><LazyShareVideoPage /></React.Suspense>
      : isFolderShare
        ? <React.Suspense fallback={null}><LazySharedFolderPage /></React.Suspense>
        : isImageShare
          ? <React.Suspense fallback={null}><LazyShareImagePage /></React.Suspense>
          : <App />}
  </ErrorBoundary>
)
