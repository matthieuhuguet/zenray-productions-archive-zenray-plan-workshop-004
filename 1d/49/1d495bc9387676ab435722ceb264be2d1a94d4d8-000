// ═══ LA FAÇADE PUBLIQUE DE L'ÉTAGÈRE, EN LECTURE SEULE ═══════════════════════════════════════════
//
// Demande de Matthieu (2026-08-27) : montrer son étagère sur matthieuhuguet.com sans réuploader un
// seul média, « tout visible mais en mode watch only, jamais d'edit possible ».
//
// LE TERME EXACT, PUISQU'IL L'A DEMANDÉ : c'est un PROXY DE LECTURE À SURFACE RESTREINTE, ou en une
// formule, une FAÇADE PUBLIQUE EN LECTURE SEULE SUR LISTE BLANCHE. Trois mots qui portent chacun une
// garantie : façade, parce qu'elle ne fait que présenter ce qui vit ailleurs ; lecture seule, parce
// qu'aucun verbe d'écriture n'y arrive ; liste blanche, parce qu'elle n'expose PAS un chemin
// paramétrable mais une liste finie de quatre fichiers, écrits ici, en clair.
//
// POURQUOI CETTE FORME ET PAS UN CHEMIN LIBRE. Une route qui accepterait `?path=` deviendrait une
// lecture publique de tout le drive au premier oubli de validation, et un `../` bien placé suffirait.
// Ici il n'y a rien à valider : la catégorie demandée est cherchée dans une table, et ce qui n'y est
// pas rend 404 sans jamais toucher au réseau.
//
// CE QU'ELLE NE PEUT PAS FAIRE, par construction et non par vigilance : écrire, puisque le gate
// applicatif n'ouvre les routes publiques qu'aux verbes GET et HEAD ; lire autre chose, puisque le
// chemin ne vient jamais de la requête ; fuiter le jeton, puisque celui-ci reste côté serveur et ne
// figure dans aucune réponse.
const REPO = process.env.CONTENT_REPO || 'matthieuhuguet/zenray-data'
const BRANCH = process.env.CONTENT_BRANCH || 'main'

// LA LISTE BLANCHE. Quatre entrées, écrites en clair, et c'est tout ce que cette route saura servir.
const ETAGERES = {
  games: 'shelf/games.json',
  'anime-manga': 'shelf/anime-manga.json',
  movies: 'shelf/movies.json',
  books: 'shelf/books.json',
}

export default async function handler(req, res) {
  // Ceinture ET bretelles : le gate applicatif limite déjà les routes publiques à GET et HEAD, mais
  // cette route ne doit jamais dépendre d'une garantie posée ailleurs pour rester en lecture seule.
  const methode = String(req.method || 'GET').toUpperCase()
  if (methode !== 'GET' && methode !== 'HEAD') {
    res.setHeader('Allow', 'GET, HEAD')
    return res.status(405).json({ error: 'read-only' })
  }

  // CORS : le site qui consomme cette route vit sur un autre domaine, donc le navigateur exige
  // l'autorisation explicite. `*` convient puisque la réponse ne contient rien de personnel au sens
  // d'un secret, et qu'aucun cookie ni jeton ne voyage avec.
  res.setHeader('Access-Control-Allow-Origin', '*')
  res.setHeader('Access-Control-Allow-Methods', 'GET, HEAD')
  // Cinq minutes de cache d'edge : l'étagère bouge quelques fois par semaine, et sans ce répit chaque
  // visiteur du site déclencherait une lecture GitHub avec le jeton du drive.
  res.setHeader('Cache-Control', 'public, max-age=60, s-maxage=300')

  const cat = String((req.query && req.query.cat) || '').replace(/\.json$/, '')
  const chemin = ETAGERES[cat]
  if (!chemin) return res.status(404).json({ error: 'unknown-shelf', connues: Object.keys(ETAGERES) })

  const token = process.env.GITHUB_TOKEN
  if (!token) return res.status(503).json({ error: 'no-token' })

  try {
    // `raw.githubusercontent.com` plutôt que l'API contents : la lecture ne compte pas dans le quota
    // REST de 5 000 par heure, ce qui est la règle du dépôt depuis l'incident du 2026-07-20 où une
    // boucle de lectures avait épuisé le quota et fait tomber le site entier en 403.
    const r = await fetch(`https://raw.githubusercontent.com/${REPO}/${BRANCH}/${encodeURI(chemin)}?zr=${Date.now()}`, {
      cache: 'no-store',
      headers: { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress' },
    })
    if (r.status === 404) return res.status(404).json({ error: 'missing' })
    if (!r.ok) return res.status(502).json({ error: 'upstream' })
    const texte = await r.text()
    res.setHeader('Content-Type', 'application/json; charset=utf-8')
    return res.status(200).send(texte)
  } catch {
    return res.status(502).json({ error: 'upstream' })
  }
}
