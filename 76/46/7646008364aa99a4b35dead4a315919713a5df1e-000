const COMPLETED_STATUSES = new Set(['done', 'late-complete'])

export function planScore(tasks = []) {
  return tasks.reduce((score, task) => {
    if (!COMPLETED_STATUSES.has(task?.status)) return score
    // Events imported from Google Calendar (17 October 2026) are history, not effort: they never earn points. / les evenements importes de l'agenda ne rapportent pas de points.
    if (task?.source === 'gcal') return score
    return score + (task.publish ? 20 : 10)
  }, 0)
}

const bezierCoordinate = (t, first, second) => {
  const inverse = 1 - t
  return 3 * inverse * inverse * t * first + 3 * inverse * t * t * second + t * t * t
}

export function scoreEase(progress) {
  const target = Math.min(1, Math.max(0, progress))
  let parameter = target
  for (let iteration = 0; iteration < 6; iteration++) {
    const x = bezierCoordinate(parameter, .16, .3)
    const slope = 3 * (1 - parameter) ** 2 * .16 + 6 * (1 - parameter) * parameter * (.3 - .16) + 3 * parameter ** 2 * .7
    if (Math.abs(slope) < 0.0001) break
    parameter = Math.min(1, Math.max(0, parameter - (x - target) / slope))
  }
  return bezierCoordinate(parameter, 1, 1)
}

export function interpolatedScore(from, to, progress) {
  return from + (to - from) * scoreEase(progress)
}
