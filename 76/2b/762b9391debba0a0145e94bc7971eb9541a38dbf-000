// ZenRayMedia — OÙ VIVENT LES CHOSES. Un seul fichier le sait.
//
// Avant ce module, six scripts construisaient leurs chemins à la main. La matière d'un thème
// vivait sous quatre noms différents (`_work`, `_reference`, `components`, `references-jpeg`) et
// dans deux racines (`src/` et `docs/`), si bien qu'on ne savait plus, en ouvrant un dossier, si
// l'on regardait le produit ou l'outillage. Un dossier illisible finit par être un dossier qu'on
// n'ouvre plus.
//
// LA RÈGLE, désormais : le LIVRABLE vit dans `src/`, la MATIÈRE vit dans `docs/`, et rien ne
// traverse.
//
//   src/zenraymedia/themes/T-FF-S-V--slug/     ce que l'éditeur charge, et RIEN d'autre
//       theme.json  tokens.css  component-registry.json  parts/
//
//   docs/zenraymedia/ateliers/T-FF-S-V--Media/  tout le reste, par thème
//       captures/     les captures d'écran d'origine
//       work/         regions.json, regions/, crops/, check/, source-vs-rendu.html
//       doc/          les pages de documentation autonomes, home.html, component-lab.html
//       deprecated/   ce qui a été abandonné, avec son POURQUOI.md
//
// L'atelier se trouve par le PRÉFIXE `T-FF-S-V`, jamais par le nom complet : le slug d'archétype
// vit dans `src/` et le média de calibrage dans `docs/`, les deux peuvent être renommés
// indépendamment sans casser le lien. Chercher par préfixe rend cette indépendance possible.

import { readdir } from 'node:fs/promises'
import { existsSync, readdirSync } from 'node:fs'
import path from 'node:path'

export const ROOT = path.resolve(import.meta.dirname, '..')
export const THEMES_DIR = path.join(ROOT, 'src', 'zenraymedia', 'themes')
export const ATELIERS_DIR = path.join(ROOT, 'docs', 'zenraymedia', 'ateliers')

/** `T-04-1-1--revelation-cinematique` -> `T-04-1-1` */
export function themeKey(id) {
  const m = /^(T-\d\d-\d-\d)/.exec(id)
  if (!m) throw new Error(`identifiant de thème hors contrat (T-FF-S-V--slug attendu) : ${id}`)
  return m[1]
}

export function themeDir(id) {
  return path.join(THEMES_DIR, id)
}

/**
 * Le dossier d'atelier d'un thème, trouvé par préfixe. Renvoie `null` quand aucun atelier
 * n'existe : c'est un état normal (un thème peut être écrit avant que sa matière n'arrive), et
 * l'appelant doit le traiter plutôt que de recevoir un chemin qui n'existe pas.
 */
export function atelierDir(id) {
  const key = themeKey(id)
  if (!existsSync(ATELIERS_DIR)) return null
  const found = readdirSync(ATELIERS_DIR).find((d) => d.startsWith(`${key}--`) || d === key)
  return found ? path.join(ATELIERS_DIR, found) : null
}

export const capturesDir = (id) => { const a = atelierDir(id); return a && path.join(a, 'captures') }
export const workDir = (id) => { const a = atelierDir(id); return a && path.join(a, 'work') }
export const docDir = (id) => { const a = atelierDir(id); return a && path.join(a, 'doc') }

/** Le chemin de `regions.json`, ou une erreur qui dit quoi faire plutôt qu'un chemin absent. */
export function regionsPath(id) {
  const w = workDir(id)
  if (!w) throw new Error(`aucun atelier pour ${themeKey(id)} sous docs/zenraymedia/ateliers/`)
  return path.join(w, 'regions.json')
}

/** Tous les ateliers connus, pour les scripts qui balayent le catalogue. */
export async function listAteliers() {
  if (!existsSync(ATELIERS_DIR)) return []
  return (await readdir(ATELIERS_DIR))
    .filter((d) => /^T-\d\d-\d-\d/.test(d))
    .sort()
    .map((d) => ({ dir: path.join(ATELIERS_DIR, d), name: d, key: themeKey(d) }))
}
