// DIAGNOSTIC DU BOARD REF — à coller dans la console, board ouvert, puis lire le résultat.
//
// Pourquoi cet outil plutôt qu'une correction devinée : « fond gris sans rien » a AU MOINS quatre
// causes possibles, et elles demandent quatre correctifs opposés. Corriger la mauvaise, c'est ajouter
// un défaut à celui qu'on n'a pas trouvé. Ces mesures les séparent en une fois.
//
//   A. le conteneur a une hauteur nulle          -> tldraw n'a pas de place, rien ne peut s'afficher
//   B. tldraw n'est pas monté du tout            -> le problème est en amont (chargement, données)
//   C. tldraw est monté mais le board est VIDE   -> ce n'est pas un bug, il n'y a rien dedans
//   D. la barre d'outils est là mais INVISIBLE   -> son verre translucide est neutralisé par un
//                                                   ancêtre (piège documenté : un ancêtre qui filtre
//                                                   change les règles de ses descendants)
(() => {
  const q = (s) => document.querySelector(s)
  const boite = (el) => { if (!el) return null; const r = el.getBoundingClientRect(); return { l: Math.round(r.width), h: Math.round(r.height), visible: r.width > 0 && r.height > 0 } }

  const editeur = q('.tl-container') || q('[data-tldraw]') || q('.tl-canvas')
  const barre = q('.zr-ref-toolbar')
  const canevas = q('.tl-canvas')

  // Un ancêtre porteur de transform/filter/backdrop-filter/perspective/contain devient une racine de
  // fond : le backdrop-filter d'un descendant n'a alors plus rien à flouter, et un verre translucide
  // devient une vitre. C'est le piège de la PRIORITÉ 0 du CLAUDE.md global.
  const ancetresFiltrants = []
  let n = barre
  while (n && n !== document.documentElement) {
    const cs = getComputedStyle(n)
    const causes = []
    if (cs.transform && cs.transform !== 'none') causes.push('transform')
    if (cs.filter && cs.filter !== 'none') causes.push('filter')
    if (cs.backdropFilter && cs.backdropFilter !== 'none') causes.push('backdrop-filter')
    if (cs.perspective && cs.perspective !== 'none') causes.push('perspective')
    if (cs.contain && cs.contain !== 'none') causes.push('contain:' + cs.contain)
    if (causes.length) ancetresFiltrants.push({ el: n.className || n.tagName, causes })
    n = n.parentElement
  }

  const styleBarre = barre ? getComputedStyle(barre) : null
  const themeSombre = !!document.querySelector('.zr-dark')
  const fgResolu = styleBarre ? styleBarre.color : null

  let formes = 'inconnu'
  try { formes = window.__zrRefEditor ? window.__zrRefEditor.getCurrentPageShapes().length : 'éditeur non exposé' } catch { formes = 'erreur' }

  const r = {
    A_conteneur: boite(editeur),
    B_tldraw_monte: !!editeur,
    B_canevas_present: !!canevas,
    C_nb_formes: formes,
    D_barre_presente: !!barre,
    D_barre_boite: boite(barre),
    D_barre_couleur_texte: fgResolu,
    D_barre_fond: styleBarre ? styleBarre.backgroundImage.slice(0, 60) : null,
    D_ancetres_qui_neutralisent_le_verre: ancetresFiltrants,
    theme_sombre_actif: themeSombre,
    g9_fg_resolu: getComputedStyle(document.documentElement).getPropertyValue('--g9-fg').trim() || '(vide)',
  }
  const verdict = !editeur ? 'B — tldraw non monté, chercher en amont'
    : (r.A_conteneur && !r.A_conteneur.visible) ? 'A — conteneur de hauteur nulle'
    : !barre ? 'D — barre absente du DOM'
    : (r.D_barre_boite && !r.D_barre_boite.visible) ? 'D — barre présente mais de taille nulle'
    : ancetresFiltrants.length ? 'D probable — un ancêtre neutralise le verre de la barre'
    : formes === 0 ? 'C — board réellement vide, ce n’est pas un bug'
    : 'aucune anomalie évidente, envoyer le rapport complet'
  console.log('%cVERDICT : ' + verdict, 'font-weight:bold')
  console.log(r)
  return { verdict, ...r }
})()
