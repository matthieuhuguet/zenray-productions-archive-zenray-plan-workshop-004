// ZenRayMedia — LES SOUS-COMPOSANTS (2026-08-04, demande centrale de Matthieu).
//
// « Tu me fais des templates, mais ces templates ne sont pas modifiables par rapport aux
// components. Donc tu prends un seul template et tu le sous-divises en components afin que je
// puisse vraiment dans la hiérarchie avoir accès à tous les composants. »
//
// LE RAISONNEMENT, parce qu'il décide de tout le reste. Un composant de thème est un fragment de
// HTML écrit à la main : un en-tête de journal contient son logo, sa date, ses onglets, son bouton
// d'abonnement. Jusqu'ici la hiérarchie n'en voyait qu'UNE ligne, « Masthead », et le panneau de
// droite n'offrait que les champs que l'auteur du fragment avait pensé à déclarer. Tout le reste
// était hors d'atteinte.
//
// Or ce découpage existe déjà, et il n'a pas à être réinventé : c'est l'arbre du DOM. Chaque
// élément du fragment EST un sous-composant. Il suffit de le lire.
//
// CHAQUE NŒUD PORTE UN CHEMIN D'INDICES, « 0.2.1 », et non un sélecteur CSS. Un sélecteur se casse
// dès qu'une classe change ; un chemin d'indices ne dépend que de la structure, laquelle est
// justement ce que l'utilisateur voit dans l'arbre. Le chemin sert de clef de réglage, et il
// survit à l'enregistrement puisqu'il n'est qu'une chaîne.
//
// CE MODULE NE TOUCHE JAMAIS AU DOM DE LA PAGE. Il lit une chaîne, il rend une chaîne. C'est ce
// qui le rend testable sans navigateur et c'est ce qui garantit que l'export reste une page morte.

// Les éléments qui ne sont pas des sous-composants : ils n'ont ni surface ni contenu propre, et
// les afficher noierait l'arbre sous du bruit.
const IGNORES = new Set(['STYLE', 'SCRIPT', 'DEFS', 'SYMBOL', 'BR', 'HR'])

// Les réglages qu'un sous-composant accepte. Volontairement COURT : douze propriétés couvrent ce
// qu'on retouche réellement sur une maquette, et une liste fermée permet de les écrire en style en
// ligne sans jamais construire de CSS à partir d'une saisie libre.
export const NODE_STYLES = [
  { key: 'color', label: 'Couleur', type: 'color' },
  { key: 'backgroundColor', label: 'Fond', type: 'color' },
  { key: 'fontSize', label: 'Corps', type: 'text', hint: '18px' },
  { key: 'fontWeight', label: 'Graisse', type: 'text', hint: '600' },
  { key: 'letterSpacing', label: 'Interlettre', type: 'text', hint: '.02em' },
  { key: 'lineHeight', label: 'Interligne', type: 'text', hint: '1.3' },
  { key: 'textAlign', label: 'Alignement', type: 'select', options: ['', 'left', 'center', 'right', 'justify'] },
  { key: 'padding', label: 'Marge int.', type: 'text', hint: '8px 12px' },
  { key: 'margin', label: 'Marge ext.', type: 'text', hint: '0 0 12px' },
  { key: 'borderRadius', label: 'Rayon', type: 'text', hint: '10px' },
  { key: 'opacity', label: 'Opacité', type: 'text', hint: '1' },
  { key: 'display', label: 'Affichage', type: 'select', options: ['', 'block', 'flex', 'inline-block', 'grid', 'none'] },
]

const CLEFS_STYLE = new Set(NODE_STYLES.map((s) => s.key))

function disponible() {
  return typeof DOMParser !== 'undefined'
}

// Le nom lisible d'un nœud. On préfère TOUJOURS ce que l'auteur a écrit à ce que la machine
// devine : un attribut `data-zrm-name`, puis une classe parlante, puis la balise. Un arbre dont
// les vingt lignes s'appellent « div » ne sert à rien.
function nommer(el) {
  const explicite = el.getAttribute?.('data-zrm-name')
  if (explicite) return explicite
  const classe = (el.getAttribute?.('class') || '')
    .split(/\s+/)
    .filter(Boolean)
    .find((c) => c.startsWith('zrm-') && c.length > 6)
  if (classe) return classe.replace(/^zrm-/, '').replace(/-/g, ' ')
  const tag = el.tagName.toLowerCase()
  const titres = { h1: 'Titre 1', h2: 'Titre 2', h3: 'Titre 3', h4: 'Titre 4', p: 'Paragraphe', a: 'Lien', img: 'Image', ul: 'Liste', li: 'Élément', button: 'Bouton', nav: 'Navigation', header: 'En-tête', footer: 'Pied', section: 'Section', figure: 'Figure', time: 'Date', span: 'Texte', svg: 'Icône', use: 'Icône' }
  return titres[tag] || tag
}

// Le texte propre d'un nœud, c'est-à-dire celui qu'il porte LUI-MÊME et non celui de ses enfants.
// La distinction est ce qui rend l'édition sûre : modifier le texte d'un conteneur effacerait
// toute sa descendance, ce que personne n'attend en tapant dans un champ.
function texteDirect(el) {
  let out = ''
  for (const enfant of el.childNodes) {
    if (enfant.nodeType === 3) out += enfant.nodeValue
  }
  return out.trim()
}

function noeudsEnfants(el) {
  return [...el.children].filter((c) => !IGNORES.has(c.tagName.toUpperCase()))
}

function construire(el, chemin, profondeur) {
  // Une profondeur maximale, parce qu'un tableau SVG imbriqué produirait des centaines de nœuds
  // pour une seule icône, et qu'un arbre qu'on ne peut pas parcourir ne vaut pas mieux qu'aucun.
  const enfants = profondeur >= 6 ? [] : noeudsEnfants(el).map((c, i) => construire(c, chemin ? `${chemin}.${i}` : String(i), profondeur + 1))
  return {
    path: chemin,
    tag: el.tagName.toLowerCase(),
    name: nommer(el),
    text: texteDirect(el),
    editable: texteDirect(el).length > 0,
    children: enfants,
  }
}

/**
 * L'arbre des sous-composants d'une page compilée, indexé par identifiant d'instance.
 * @returns {Record<string, {path:string,tag:string,name:string,text:string,children:any[]}[]>}
 */
export function parseTree(html) {
  if (!disponible() || typeof html !== 'string' || !html) return {}
  const doc = new DOMParser().parseFromString(html, 'text/html')
  const out = {}
  for (const hote of doc.querySelectorAll('[data-zrm-instance]')) {
    const id = hote.getAttribute('data-zrm-instance')
    out[id] = noeudsEnfants(hote).map((c, i) => construire(c, String(i), 0))
  }
  return out
}

/** Le nœud désigné par son chemin, ou null. */
export function findNode(arbre, instanceId, path) {
  let liste = arbre?.[instanceId]
  if (!Array.isArray(liste) || !path) return null
  const indices = String(path).split('.').map(Number)
  let noeud = null
  for (const i of indices) {
    noeud = liste?.[i]
    if (!noeud) return null
    liste = noeud.children
  }
  return noeud
}

/** Le chemin d'un élément DANS son hôte, calculé exactement comme `construire` le numérote. */
export function pathOfElement(el, hote) {
  const indices = []
  let courant = el
  while (courant && courant !== hote) {
    const parent = courant.parentElement
    if (!parent) return null
    const fratrie = [...parent.children].filter((c) => !IGNORES.has(c.tagName.toUpperCase()))
    const i = fratrie.indexOf(courant)
    if (i < 0) return null
    indices.unshift(i)
    courant = parent
  }
  return courant === hote ? indices.join('.') : null
}

function styleEnLigne(reglages) {
  return Object.entries(reglages || {})
    .filter(([clef, valeur]) => CLEFS_STYLE.has(clef) && typeof valeur === 'string' && valeur.trim())
    // camelCase vers tiret : `fontSize` devient `font-size`.
    .map(([clef, valeur]) => `${clef.replace(/[A-Z]/g, (m) => `-${m.toLowerCase()}`)}:${valeur.replace(/[;<>"']/g, '')}`)
    .join(';')
}

/**
 * Applique les réglages de sous-composants à une page compilée.
 *
 * Les réglages arrivent sous la forme `{ [instanceId]: { [path]: { text, style } } }`, exactement
 * la forme sous laquelle ils sont enregistrés dans `item.props.__nodes`. Un chemin devenu
 * introuvable, parce que le composant a changé, est IGNORÉ sans bruit : un réglage orphelin ne doit
 * jamais empêcher une page de se rendre.
 */
export function applyOverrides(html, reglagesParInstance) {
  if (!disponible() || !reglagesParInstance || !Object.keys(reglagesParInstance).length) return html
  const doc = new DOMParser().parseFromString(html, 'text/html')
  let touche = false

  for (const [instanceId, reglages] of Object.entries(reglagesParInstance)) {
    const hote = doc.querySelector(`[data-zrm-instance="${CSS.escape ? CSS.escape(instanceId) : instanceId}"]`)
    if (!hote) continue
    for (const [path, reglage] of Object.entries(reglages || {})) {
      const el = elementAuChemin(hote, path)
      if (!el) continue
      if (typeof reglage.text === 'string' && reglage.text !== '') {
        // On ne remplace QUE les nœuds de texte directs, jamais les enfants : sans cela, régler le
        // texte d'un conteneur effacerait toute sa descendance en un caractère.
        let pose = false
        for (const enfant of [...el.childNodes]) {
          if (enfant.nodeType !== 3) continue
          if (pose) { enfant.nodeValue = '' } else { enfant.nodeValue = reglage.text; pose = true }
        }
        if (!pose) el.textContent = reglage.text
        touche = true
      }
      const style = styleEnLigne(reglage.style)
      if (style) {
        el.setAttribute('style', `${el.getAttribute('style') || ''};${style}`)
        touche = true
      }
    }
  }
  if (!touche) return html
  return `<!doctype html>${doc.documentElement.outerHTML}`
}

function elementAuChemin(hote, path) {
  let courant = hote
  for (const i of String(path).split('.').map(Number)) {
    const enfants = noeudsEnfants(courant)
    courant = enfants[i]
    if (!courant) return null
  }
  return courant
}

/** Le nombre de sous-composants d'une instance, replié pour l'affichage. */
export function countNodes(liste) {
  if (!Array.isArray(liste)) return 0
  return liste.reduce((n, noeud) => n + 1 + countNodes(noeud.children), 0)
}

/**
 * TOUS LES TEXTES MODIFIABLES d'un sous-arbre, à plat.
 *
 * Matthieu : « le plus important, si je clique sur un élément de texte, c'est de pouvoir modifier
 * le texte à droite, ça me semble évident. » Il a raison, et le panneau ne le permettait pas dans
 * le cas le plus fréquent : on clique rarement PILE sur le nœud qui porte le texte, on clique sur
 * la boîte qui le contient. Le panneau affichait alors « ce nœud n'a pas de texte propre », ce qui
 * est exact et parfaitement inutile.
 *
 * Cette fonction remonte donc les textes de toute la descendance, à plat et dans l'ordre de
 * lecture. Le panneau les offre tous, et le premier champ est toujours un champ de texte.
 */
export function collectTexts(liste, max = 24) {
  const out = []
  const marcher = (noeuds) => {
    for (const noeud of noeuds || []) {
      if (out.length >= max) return
      if (noeud.editable) out.push({ path: noeud.path, name: noeud.name, tag: noeud.tag, text: noeud.text })
      marcher(noeud.children)
    }
  }
  marcher(Array.isArray(liste) ? liste : [liste].filter(Boolean))
  return out
}

/** Tous les chemins d'un sous-arbre, pour déplier ou replier d'un seul geste. */
export function allPaths(liste) {
  const out = []
  const marcher = (noeuds) => {
    for (const noeud of noeuds || []) { out.push(noeud.path); marcher(noeud.children) }
  }
  marcher(Array.isArray(liste) ? liste : [liste].filter(Boolean))
  return out
}
