import { describe, expect, it } from 'vitest'
import { coteVise, planifierLacher, propsRangee, SEUIL_BORD } from './imageRowDrop.js'

describe('coteVise', () => {
  it('rend gauche pres du bord gauche et droite pres du bord droit', () => {
    expect(coteVise(10, 1000)).toBe('gauche')
    expect(coteVise(990, 1000)).toBe('droite')
  })
  it('rend null au centre, ou le lacher garde son sens habituel', () => {
    expect(coteVise(500, 1000)).toBeNull()
  })
  it('garde la MEME proportion quelle que soit la largeur', () => {
    const dedans = SEUIL_BORD / 2
    expect(coteVise(300 * dedans, 300)).toBe('gauche')
    expect(coteVise(900 * dedans, 900)).toBe('gauche')
  })
  it('ne decide rien sur une largeur nulle', () => {
    expect(coteVise(5, 0)).toBeNull()
  })
})

describe('planifierLacher', () => {
  it('transforme une image simple en rangee quand on vise un bord', () => {
    expect(planifierLacher({ typeBloc: 'image', propsBloc: { url: 'a.webp', caption: 'A' }, x: 5, largeur: 800 }))
      .toMatchObject({ action: 'creerRangee', urlExistante: 'a.webp', legendeExistante: 'A', cote: 'gauche' })
  })
  it('ne fait rien au centre', () => {
    expect(planifierLacher({ typeBloc: 'image', propsBloc: { url: 'a.webp' }, x: 400, largeur: 800 })).toBeNull()
  })
  it('ne fait rien sur une image vide', () => {
    expect(planifierLacher({ typeBloc: 'image', propsBloc: { url: '' }, x: 5, largeur: 800 })).toBeNull()
  })
  it('remplace un cote sur une rangee existante', () => {
    expect(planifierLacher({ typeBloc: 'zenrayImageRow', propsBloc: {}, x: 795, largeur: 800 }))
      .toMatchObject({ action: 'remplacerCote', cote: 'droite' })
  })
  it('ignore les blocs qui ne sont ni image ni rangee', () => {
    expect(planifierLacher({ typeBloc: 'paragraph', propsBloc: {}, x: 5, largeur: 800 })).toBeNull()
  })
})

describe('propsRangee', () => {
  it('met l’image deposee du cote vise et pousse l’existante de l’autre', () => {
    expect(propsRangee({ urlExistante: 'a', legendeExistante: 'A', urlDeposee: 'b', legendeDeposee: 'B', cote: 'gauche' }))
      .toEqual({ gauche: 'b', droite: 'a', legendeGauche: 'B', legendeDroite: 'A' })
    expect(propsRangee({ urlExistante: 'a', legendeExistante: 'A', urlDeposee: 'b', legendeDeposee: 'B', cote: 'droite' }))
      .toEqual({ gauche: 'a', droite: 'b', legendeGauche: 'A', legendeDroite: 'B' })
  })
})

import { estImage, fusionner, fusionnerAvecVoisine } from './imageRowDrop.js'

const img = (id, url, caption = '') => ({ id, type: 'image', props: { url, caption } })
const para = (id) => ({ id, type: 'paragraph', props: {} })

describe('fusionner deux images du document', () => {
  it('reconnait une image seulement si elle porte une URL', () => {
    expect(estImage(img('a', 'a.webp'))).toBe(true)
    expect(estImage(img('a', ''))).toBe(false)
    expect(estImage(para('p'))).toBe(false)
  })

  it('range gauche a gauche, droite a droite, et garde les legendes', () => {
    const r = fusionner(img('a', 'a.webp', 'A'), img('b', 'b.webp', 'B'))
    expect(r.rangee.props).toEqual({ gauche: 'a.webp', droite: 'b.webp', legendeGauche: 'A', legendeDroite: 'B' })
    expect(r.aSupprimer.map((b) => b.id)).toEqual(['a', 'b'])
  })

  it('refuse de fusionner un bloc avec lui-meme', () => {
    const a = img('a', 'a.webp')
    expect(fusionner(a, a)).toBeNull()
  })

  it('prend l’image SUIVANTE en priorite', () => {
    const doc = [img('a', 'a.webp'), img('b', 'b.webp'), img('c', 'c.webp')]
    expect(fusionnerAvecVoisine(doc, 'b').rangee.props).toMatchObject({ gauche: 'b.webp', droite: 'c.webp' })
  })

  it('se rabat sur la precedente, et garde alors l’ordre de lecture', () => {
    const doc = [img('a', 'a.webp'), img('b', 'b.webp'), para('p')]
    expect(fusionnerAvecVoisine(doc, 'b').rangee.props).toMatchObject({ gauche: 'a.webp', droite: 'b.webp' })
  })

  it('ne fait rien quand aucune voisine n’est une image', () => {
    expect(fusionnerAvecVoisine([para('x'), img('b', 'b.webp'), para('y')], 'b')).toBeNull()
    expect(fusionnerAvecVoisine([img('a', 'a.webp')], 'inconnu')).toBeNull()
  })
})

import { sourceDeGlisse } from './imageRowDrop.js'

describe('sourceDeGlisse', () => {
  it('reconnait un fichier venu du disque', () => {
    expect(sourceDeGlisse(['Files'], null)).toBe('fichier')
  })
  it('reconnait un bloc glisse depuis le document, qui n’annonce JAMAIS Files', () => {
    expect(sourceDeGlisse(['blocknote/html', 'text/html'], img('a', 'a.webp'))).toBe('interne')
  })
  it('ne reconnait rien sans fichier et sans bloc en main', () => {
    expect(sourceDeGlisse(['blocknote/html'], null)).toBeNull()
    expect(sourceDeGlisse([], null)).toBeNull()
    expect(sourceDeGlisse(undefined, null)).toBeNull()
  })
  it('accepte une DataTransferItemList, qui n’est pas un tableau', () => {
    expect(sourceDeGlisse({ length: 1, 0: 'Files', [Symbol.iterator]: function* () { yield 'Files' } }, null)).toBe('fichier')
  })
})
