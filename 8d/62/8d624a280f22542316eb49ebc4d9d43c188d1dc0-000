import path from 'node:path'

export function sourceHashOfStreamManifest(manifest) {
  if (!manifest || typeof manifest !== 'object') return null
  let sha256 = typeof manifest.sourceSha256 === 'string' && /^[a-f0-9]{64}$/i.test(manifest.sourceSha256)
    ? manifest.sourceSha256.toLowerCase() : null
  // Les anciennes vidéos étaient remuxées avant leur découpe. Une empreinte ajoutée après coup depuis le
  // fichier local ne prouve donc pas que les octets distants sont ceux de la source. Seuls les nouveaux
  // manifestes, écrits par le rail bit à bit, portent cette preuve explicite.
  if (manifest.type === 'video-raw' && manifest.sourceExact !== true) sha256 = null
  // Pour les images historiques, le chemin de contenu porte déjà l'empreinte du clair original.
  if (!sha256 && manifest.type === 'image') {
    const premier = Array.isArray(manifest.cdnChunks) ? manifest.cdnChunks[0] : manifest.cdnPath
    const match = /(?:^|\/)([a-f0-9]{64})(?:-\d+)?(?:\.[^/]*)?$/i.exec(premier || '')
    if (match) sha256 = match[1].toLowerCase()
  }
  return sha256
}

/** Retrouve le fichier source d'un manifeste image, audio, PDF ou vidéo sans dépendre du suffixe aléatoire
 *  des anciens `.media.json`. Les nouveaux manifestes portent aussi l'empreinte entière de leur source. */
export function sourceOfStreamManifest(relativeManifestPath, manifest) {
  if (!manifest || typeof manifest !== 'object') return null
  let rel = typeof manifest.sourceRel === 'string' && manifest.sourceRel ? manifest.sourceRel : null
  if (!rel && relativeManifestPath.endsWith('.img.json')) {
    rel = relativeManifestPath.slice(0, -'.img.json'.length)
  }
  if (!rel && relativeManifestPath.endsWith('.media.json') && typeof manifest.name === 'string' && manifest.name) {
    const dir = path.dirname(relativeManifestPath)
    rel = dir === '.' ? manifest.name : `${dir}/${manifest.name}`
  }
  if (!rel) return null

  const sha256 = sourceHashOfStreamManifest(manifest)
  return { rel, sha256 }
}

export function enrichStreamManifest(blob, rel, sha256) {
  const manifest = JSON.parse(blob.content)
  return { ...blob, content: JSON.stringify({ ...manifest, sourceRel: rel, sourceSha256: sha256 }) }
}

/** Un manifeste ancien peut recevoir l'empreinte locale sans renvoyer ses données si son commit est postérieur
 *  à la dernière écriture du fichier et si le rail historique conservait déjà les octets exacts. */
export function canAdoptSourceHash(manifest, sourceSize, sourceMtimeMs, manifestCommitMs) {
  if (!Number.isFinite(manifestCommitMs) || manifestCommitMs < sourceMtimeMs) return false
  if (manifest?.type === 'video-raw') return false
  return Number(manifest?.size) === sourceSize
}

export function parseLatestGitChanges(output) {
  const changes = new Map()
  let at = 0
  for (const line of String(output || '').split('\n')) {
    if (line.startsWith('ZRC:')) { at = Number(line.slice(4)) * 1000; continue }
    if (at && line && !changes.has(line)) changes.set(line, at)
  }
  return changes
}
