import { extOf } from './fileKinds.js'
import { readableSize } from './assetsProjects.js'

// 3 October 2026, 15:41 CEST: totals describe logical file bytes, with missing sizes explicitly counted.
export function fileSizeLabel(files) {
  let bytes = 0, unknown = 0
  for (const file of files) {
    if (Number.isFinite(file.size) && file.size >= 0) bytes += file.size
    else unknown++
  }
  const known = readableSize(bytes) || '0 octet'
  return unknown ? `${known} connus · ${unknown} taille${unknown > 1 ? 's' : ''} inconnue${unknown > 1 ? 's' : ''}` : known
}

export const FILE_QUERY_DEFAULTS = { kind: 'all', extension: 'all', searchScope: 'all', dateFrom: '', dateTo: '', sizeMin: '', sizeMax: '', sort: 'name', direction: 'asc' }
export const FILE_KIND_LABELS = { image: 'Images', video: 'Vidéos', audio: 'Audio', text: 'Documents et code', pdf: 'PDF', houdini: 'Houdini', '3d-lib': '3D', 'image-lib': 'Textures', archive: 'Archives', binary: 'Autres' }
export function fileDate(file) {
  if (Number.isFinite(file.mtimeMs)) return file.mtimeMs
  const date = file.modifiedAt || file.updatedAt
  const value = date ? new Date(date).getTime() : NaN
  return Number.isFinite(value) ? value : null
}
const bound = (value, date = false) => {
  if (value === '' || value === null || value === undefined) return null
  const number = date ? new Date(value).getTime() : Number(value)
  return Number.isFinite(number) ? number : null
}
export function queryAssetsFiles(files, options = {}) {
  const q = { ...FILE_QUERY_DEFAULTS, ...options }
  const search = (q.search || '').trim().toLocaleLowerCase('fr')
  const from = bound(q.dateFrom, true), to = bound(q.dateTo, true), min = bound(q.sizeMin), max = bound(q.sizeMax)
  const result = files.filter((file) => {
    const haystack = q.searchScope === 'name' ? file.name : `${file.name} ${file.relativePath} ${file.localPath || ''} ${file.cloudPath || ''} ${file.expectedCloudPath || ''}`
    const extension = extOf(file.name).toLowerCase()
    const date = fileDate(file), size = Number.isFinite(file.size) ? file.size : null
    return (!search || String(haystack || '').toLocaleLowerCase('fr').includes(search))
      && (q.kind === 'all' || file.kind === q.kind)
      && (q.extension === 'all' || (extension || 'none') === q.extension)
      && (from === null || (date !== null && date >= from)) && (to === null || (date !== null && date <= to))
      && (min === null || (size !== null && size >= min)) && (max === null || (size !== null && size <= max))
  })
  const value = (file) => q.sort === 'size' ? Number.isFinite(file.size) ? file.size : null : q.sort === 'date' ? fileDate(file) : q.sort === 'kind' ? `${file.kind || 'binary'}:${extOf(file.name)}` : file.name
  return result.sort((left, right) => {
    const a = value(left), b = value(right)
    if (a === null || a === undefined) return b === null || b === undefined ? String(left.id).localeCompare(String(right.id)) : 1
    if (b === null || b === undefined) return -1
    const order = typeof a === 'number' ? a - b : String(a).localeCompare(String(b), 'fr', { numeric: true, sensitivity: 'base' })
    return order ? order * (q.direction === 'desc' ? -1 : 1) : String(left.id).localeCompare(String(right.id), 'fr', { numeric: true })
  })
}
