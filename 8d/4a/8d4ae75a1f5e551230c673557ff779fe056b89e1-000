// 7 October 2026: the template text was updated by Matthieu (2 NDA projects, no Cursor/Claude line); the Asobo fixture follows it.
// 4 October 2026: the letter must reproduce Matthieu's own Asobo letter word for word, and never invent a claim.
import { describe, expect, it } from 'vitest'
import config from './FreelanceConfig.json'
import { SEED_TEMPLATE, composeLetter, letterKind, updateArchive, greetingName, studioKey } from './Letters.mjs'

const cv = {
  skills: [{ name: 'Houdini' }, { name: 'Unreal Engine 5' }, { name: 'Python' }, { name: 'Substance Designer' }],
  projects: [
    { id: 1, title: 'Ceramic Tiles - Made with Houdini Copernicus and Unreal Lumen', url: 'https://matthieuhuguet.com/reels/ceramic', description: { en: 'Ceramic.', fr: 'Céramique.' } },
    { id: 2, title: 'HDA Stairs Component', url: 'https://matthieuhuguet.com/reels/stairs', description: { en: 'Stairs.', fr: 'Escalier.' } },
    { id: 3, title: 'UV Texture Variation Offset', url: 'https://matthieuhuguet.com/reels/uv', description: { en: 'UV.', fr: 'UV.' } },
  ],
  pdf: { en: 'https://cdn.example/cv-en.pdf', fr: 'https://cdn.example/cv-fr.pdf', contentHash: 'abc' }, fingerprint: 'fp1',
}

const ASOBO_LETTER = `À l’attention de l’équipe recrutement,

Bonjour Asobo,

Je m’appelle Matthieu Huguet, j’ai 25 ans et je travaille en freelance comme Technical Artist, basé à Aix-en-Provence.

J’ai suivi un Bachelor Game Design à LISAA Paris, un Master à ARTFX Montpellier, puis des formations en technical art chez Gnomon et via Harvard CS50, avant de me lancer en freelance début 2025.

En production, j’ai travaillé comme Technical Artist freelance avec Meerkat Studio sur trois jeux de simulation : Santa Simulator (sorti sur Steam), Bakery Coffee Simulator (sorti sur Steam) et Pet Grooming Simulator (contrat rémunéré). Plus tôt durant mes études, j’ai co-développé Noyes (jeu étudiant). J’ai également réalisé un projet d’archviz pour un client privé à Aix-en-Provence. Tout mon travail est visible sur matthieuhuguet.com.

En ce moment, je travaille à intégrer et construire des solutions avec Houdini et Unreal, qui génèrent du level design via des HDA et me permettent d’itérer rapidement dessus.

J’ai pris le temps de regarder le travail d’Asobo sur vos jeux narratifs avant de vous écrire. C’est ce qui m’a décidé à prendre contact directement.

J’ai évidemment joué à A Plague Tale: Requiem, dont la fin m’a profondément ému et m’a convaincu de la force de ce média. J’apprécie vraiment votre studio. J’ai beaucoup étudié Requiem visuellement, notamment à travers une importante bibliothèque de références.

Ce que je recherche aujourd’hui, c’est un contrat, avec une équipe engagée sur un projet ambitieux. J’ai besoin de travailler avec des professionnels expérimentés et de m’inscrire dans une dynamique collective, quelque chose que le travail en solo, aussi formateur soit-il, ne permet pas de retrouver.

Je prends rarement le temps de postuler spontanément, mais votre message « lance-toi » m’a décidé à vous écrire.

Je serais heureux de pouvoir échanger avec vous par téléphone ou en visioconférence, selon votre disponibilité.

Matthieu Huguet`

describe('composeLetter', () => {
  it('reproduces the Asobo letter word for word when no latest work is added', () => {
    const asobo = { id: 'asobo', name: 'Asobo Studio', role: 'Level Designer', link: 'https://lnkd.in/ezXz3B3s', status: 'declined' }
    const letter = composeLetter({ template: SEED_TEMPLATE, studio: asobo, cv, config: { ...config, latestWork: { ...config.latestWork, publishedCount: 0 } } })
    expect(letter.text).toBe(ASOBO_LETTER)
    expect(letter.hookSource).toBe('saved')
    expect(letter.kind).toBe('spontaneous')
  })

  it('adds the latest published work, from the site, to the same paragraph', () => {
    const letter = composeLetter({ template: SEED_TEMPLATE, studio: { id: 'asobo', name: 'Asobo Studio', link: 'x' }, cv, config })
    expect(letter.text).toContain('Mes derniers travaux publiés : Ceramic Tiles, HDA Stairs Component et UV Texture Variation Offset.')
    expect(letter.latestWork.map((item) => item.url)[0]).toBe('https://matthieuhuguet.com/reels/ceramic')
  })

  it('writes an offer letter with the real overlap and nothing the CV does not state', () => {
    const studio = { id: 'job_1', name: 'd3t (Keywords Studios)', role: 'Technical Artist', link: 'https://x', engine: { source: 'keywords', kind: 'offer', skills: ['Houdini', 'Unreal Engine', 'Unity', 'Blender'], language: 'en' } }
    const letter = composeLetter({ template: SEED_TEMPLATE, studio, cv, config })
    expect(letter.lang).toBe('en')
    expect(letter.text).toContain('Hello d3t,')
    expect(letter.text).toContain('Your opening for Technical Artist lines up with my day-to-day work: Houdini and Unreal Engine.')
    expect(letter.text).not.toMatch(/Unity|Blender/)
    expect(letter.text).not.toMatch(/played|joué/i)
    expect(letter.translated).toBe(true)
  })

  it('puts the reason right after the greeting for an offer and last for a spontaneous letter', () => {
    const offer = composeLetter({ template: SEED_TEMPLATE, studio: { id: 'job_2', name: 'Ubisoft', role: 'Tech Artist', link: 'https://x', engine: { source: 'smartrecruiters:Ubisoft2', kind: 'offer', skills: [], language: 'fr' } }, cv, config })
    expect(offer.text.split('\n\n')[2]).toBe('Je vous écris au sujet de votre offre « Tech Artist ».')
    expect(composeLetter({ template: SEED_TEMPLATE, studio: { id: 'prospect_x', name: 'X', engine: { source: 'prospect', kind: 'spontaneous', language: 'fr', skills: [] } }, cv, config }).text).toContain('Je vous écris spontanément, sans offre précise')
    const pool = composeLetter({ template: SEED_TEMPLATE, studio: { id: 'job_3', name: 'Keywords Studios', role: 'Vivier de candidatures : Technical Artist', link: 'https://x', engine: { source: 'keywords', kind: 'spontaneous', skills: [], language: 'fr' } }, cv, config })
    expect(pool.kind).toBe('pool')
    expect(pool.text).toContain('votre vivier de candidatures « Technical Artist »')
    expect(pool.subject).toBe('Candidature spontanée : Matthieu Huguet, Technical Artist')
  })

  it('is freelance aware and never uses a long dash', () => {
    const letter = composeLetter({ template: SEED_TEMPLATE, studio: { id: 'job_4', name: 'Voodoo', role: 'Technical Artist \u2014 Houdini', link: 'https://x', engine: { source: 'lever:voodoo', kind: 'offer', freelance: true, skills: ['Houdini'], language: 'fr' } }, cv, config })
    expect(letter.kind).toBe('freelance')
    expect(letter.text + letter.subject).not.toMatch(/[\u2014\u2013]/)
  })

  it('fails loud on an unknown parameter instead of shipping a hole', () => {
    const broken = { ...SEED_TEMPLATE, fr: { ...SEED_TEMPLATE.fr, blocks: { ...SEED_TEMPLATE.fr.blocks, closing: 'Merci {unknown}' } } }
    expect(() => composeLetter({ template: broken, studio: { id: 'job_5', name: 'A', role: 'B', link: 'x', engine: { source: 's', skills: [] } }, cv, config })).toThrow(/\{unknown\}/)
  })
})

describe('letter helpers', () => {
  it('names studios for a greeting and a lookup key', () => {
    expect(greetingName('d3t (Keywords Studios)')).toBe('d3t')
    expect(studioKey('Asobo Studio')).toBe('asobo')
    expect(letterKind({ id: 'x1', name: 'N' })).toBe('spontaneous')
  })

  it('archives versions append-only and parks a suggestion when Matthieu edited', () => {
    const studio = { id: 'job_6', name: 'Studio', role: 'Tech Artist', link: 'https://x', engine: { source: 's', skills: [], language: 'fr' } }
    const first = composeLetter({ template: SEED_TEMPLATE, studio, cv, config })
    const a = updateArchive(null, first, { at: '2026-10-04T10:00:00Z', studioId: 'job_6', templateStatus: 'seed' })
    expect(a.archive.versions).toHaveLength(1)
    expect(updateArchive(a.archive, first, { at: 'later', studioId: 'job_6' }).changed).toBe(false)
    const edited = { ...a.archive, versions: [...a.archive.versions, { at: 'e', by: 'matthieu', text: 'mine', fingerprint: 'mine' }] }
    const second = composeLetter({ template: SEED_TEMPLATE, studio, cv: { ...cv, fingerprint: 'fp2' }, config })
    const b = updateArchive(edited, second, { at: 'new', studioId: 'job_6' })
    expect(b.archive.versions).toHaveLength(2)
    expect(b.archive.versions.at(-1).text).toBe('mine')
    expect(b.archive.suggested.cvFingerprint).toBe('fp2')
  })
})

describe('seeking paragraph by kind', () => {
  it('asks for a stage or a mission instead of a contract when the vacancy is one', () => {
    const base = { id: 'job_9', name: 'Studio', role: 'VFX Artist', link: 'https://x', engine: { source: 's', skills: [], language: 'fr' } }
    expect(composeLetter({ template: SEED_TEMPLATE, studio: { ...base, engine: { ...base.engine, kind: 'internship' } }, cv, config }).text).toContain('c’est un stage, avec une équipe')
    expect(composeLetter({ template: SEED_TEMPLATE, studio: { ...base, engine: { ...base.engine, freelance: true } }, cv, config }).text).toContain('c’est une mission, avec une équipe')
    expect(composeLetter({ template: SEED_TEMPLATE, studio: base, cv, config }).text).toContain('c’est un contrat, avec une équipe')
  })
  it('does not read a plain "Pipeline" job as a talent pool', async () => {
    const { classify } = await import('./lib/Offer.mjs')
    expect(classify({ title: 'Technical Artist - Pipeline & Tools' }).kind).toBe('offer')
    expect(classify({ title: 'Environment Artist - Talent Pipeline' }).kind).toBe('spontaneous')
  })
})
