#!/usr/bin/env node
// PublishMotions.mjs (12 October 2026, 11:20 CEST): publishes rendered ZenRay Motion Design versions to the site
// (R06 section 4.2). The render is packaged in CMAF by stream copy (scripts/lib/cmaf-packaging.mjs), its segments and
// poster go to a public shard of the 'motion' family under NEUTRAL paths (zrmd-0001/v008-16x9/), then ONE commit in
// zenray-data writes the playlists, the version manifest, the numbers-only fidelity report, the motion card, the
// catalogue, the id map and the shard counter together. Without --push nothing leaves the Mac (dry run).
//
// Usage:
//   node scripts/Motion/PublishMotions.mjs [--motion <localId>] [--version V_008] [--push]
//        [--workshop <dir>] [--clone <dir>] [--private-remote <url>] [--public-remote-template <url with {repo}>]
//        [--skip-cdn-check] [--no-create-repo]
// Prints one JSON line; exit 0 on success, 2 on refusal, 1 on failure.
// FR : publie les versions rendues ; sans --push rien ne quitte le Mac.
import fs from 'node:fs'
import path from 'node:path'
import crypto from 'node:crypto'
import { execFileSync } from 'node:child_process'
import { probeStreams, packageCmafDashHls, mergeAudioGroups } from '../lib/cmaf-packaging.mjs'
import { rewriteMediaPlaylist, rewriteMasterPlaylist, rewriteDashMpd, verifyJsDelivrSegment } from '../lib/cmaf-rewrite.mjs'
import { PUBLIC_SHARD, ensurePublicShardRepo, resolveToken } from '../lib/public-shard.mjs'
import { FILM_POSTER, makeFilmPoster, verifyPublicPoster } from '../lib/film-poster.mjs'
import { openVideoGitShard } from '../lib/video-git-shard.mjs'
import { createCloudStore } from '../Freelance/CloudStore.mjs'
import { shardName } from '../../server/shard-naming.js'
import {
  MOTION_CONFIG, assignPublicIds, buildCatalogue, buildVersionManifest, catalogueRow, checkCatalogue, cloudPath,
  fidelityNumbers, isNeutralPublicPath, mergeZmotion, rightsBlocker, versionPaths,
} from './MotionPublish.mjs'

const cfg = MOTION_CONFIG
const argv = process.argv.slice(2)
const flag = (n) => argv.includes(n)
const opt = (n, d) => { const i = argv.indexOf(n); return i >= 0 && argv[i + 1] && !argv[i + 1].startsWith('--') ? argv[i + 1] : d }
const readJson = (file, fallback = null) => { try { return JSON.parse(fs.readFileSync(file, 'utf8')) } catch { return fallback } }
const done = (code, value) => { console.log(JSON.stringify(value)); process.exit(code) }

const workshop = path.resolve(opt('--workshop', cfg.workshop))
const push = flag('--push')
const cloneDir = path.resolve(opt('--clone', cfg.clone))
const workRoot = path.resolve(opt('--work', cfg.work))
const privateRemote = opt('--private-remote', null)
const publicTemplate = opt('--public-remote-template', null)
const now = new Date().toISOString()

function localMotions() {
  const root = path.join(workshop, 'motions')
  const only = opt('--motion', null)
  const ids = fs.existsSync(root) ? fs.readdirSync(root).filter((n) => fs.existsSync(path.join(root, n, 'motion.json'))) : []
  return ids.filter((id) => !only || id === only).sort().map((id) => {
    const folder = path.join(root, id)
    const motion = readJson(path.join(folder, 'motion.json'), {})
    const versions = fs.readdirSync(folder).filter((n) => /^V_\d{3}$/.test(n) && fs.existsSync(path.join(folder, n, 'render.mp4'))).sort()
    // The latest COMPLETE version (render present); motion.latest may name one still rendering.
    const version = opt('--version', null) || (versions.includes(motion.latest) ? motion.latest : versions.at(-1))
    return { id, folder, motion, version, versionDir: version ? path.join(folder, version) : null }
  })
}

function exposedOf(id, version) {
  try {
    const out = execFileSync(cfg.engine.python, ['-I', '-m', 'zrmd.cli', 'exposed', id, '--version', version],
      { cwd: cfg.engine.root, encoding: 'utf8', timeout: 60000, env: { ...process.env, ZRMD_PATH_WORKSHOP: workshop } })
    const json = JSON.parse(out)
    return json.ok ? json.categories : {}
  } catch { return {} }
}

function packageVersion(item) {
  const render = path.join(item.versionDir, 'render.mp4')
  const workDir = path.join(workRoot, `${item.id}-${item.version}`)
  const probe = probeStreams(render)
  let mode = 'copy4'
  let packaged = packageCmafDashHls(render, workDir, probe, mode)
  for (const next of ['copy2', 'transcode']) { if (packaged.ok) break; mode = next; packaged = packageCmafDashHls(render, workDir, probe, mode) }
  if (!packaged.ok) throw new Error(`CMAF packaging failed: ${packaged.reason}`)
  let poster = path.join(item.versionDir, 'poster.jpg')
  if (!fs.existsSync(poster) || fs.statSync(poster).size < FILM_POSTER.minBytes) {
    poster = path.join(workDir, 'poster-made.jpg')
    if (!makeFilmPoster(render, poster, probe.duration)) throw new Error('poster extraction failed')
  }
  const sha256 = crypto.createHash('sha256').update(fs.readFileSync(render)).digest('hex')
  return { render, workDir, probe, mode, packaged, poster, posterBytes: fs.statSync(poster).size, sha256, bytes: fs.statSync(render).size }
}

/** Every zenray-data file of one publication, built from the freshest tree (re-run after a refused push). */
async function planFiles(tree, items, idsState, shardState) {
  const files = {}
  const ids = assignPublicIds(idsState, items.map((i) => i.id))
  const rows = []
  for (const item of items) {
    const publicId = ids.ids[item.id]
    const p = versionPaths(publicId, item.version)
    const pk = item.pkg
    const mediaPlaylists = fs.readdirSync(pk.workDir).filter((n) => /^media_\d+\.m3u8$/i.test(n)).sort()
    for (const name of mediaPlaylists) files[`${p.streamDir}/${name}`] = rewriteMediaPlaylist(fs.readFileSync(path.join(pk.workDir, name), 'utf8'), item.urlMap)
    const vCodec = pk.mode === 'transcode' ? 'h264' : String(pk.probe.video?.codec_name || 'h264').toLowerCase()
    const merged = mergeAudioGroups(fs.readFileSync(path.join(pk.workDir, 'master.m3u8'), 'utf8'), pk.probe.audios)
    files[`${p.streamDir}/master.m3u8`] = rewriteMasterPlaylist(merged.text, p.streamDir, vCodec)
    files[`${p.streamDir}/manifest.mpd`] = rewriteDashMpd(fs.readFileSync(path.join(pk.workDir, 'manifest.mpd'), 'utf8'), item.cdnBase)
    const canvas = readJson(path.join(item.versionDir, 'params.json'), {})?.canvas || {}
    const manifest = buildVersionManifest({
      publicId, version: item.version, masterPath: `${p.streamDir}/master.m3u8`, mpdPath: `${p.streamDir}/manifest.mpd`,
      posterUrl: item.posterUrl, publicRepo: item.shard, commitPublic: item.commitPublic, duration: pk.probe.duration,
      width: pk.probe.video?.width ?? canvas.width, height: pk.probe.video?.height ?? canvas.height, fps: canvas.fps, sha256: pk.sha256,
      bytes: pk.packaged.totalBytes, segments: pk.packaged.names.length, audio: pk.probe.audios.map((t) => ({ lang: t.lang, label: t.label, default: t.default })),
      publishedAt: now,
    })
    files[p.media] = JSON.stringify(manifest, null, 2) + '\n'
    const fid = fidelityNumbers(readJson(path.join(item.versionDir, 'fidelity.json')))
    files[p.verify] = JSON.stringify({ schemaVersion: 1, kind: 'zenray-motion-verify', id: publicId, version: item.version, fidelity: fid }, null, 2) + '\n'
    const meta = readJson(path.join(item.versionDir, 'version.json'), {})
    const entry = {
      version: item.version, parent: meta.parent || null, state: 'published', createdAt: meta.created || null, publishedAt: now, note: meta.note || '',
      changes: meta.overrides || {}, renders: [{ aspect: '16x9', media: p.media, poster: item.posterUrl, durationSec: manifest.duration, fps: canvas.fps ?? null,
        width: manifest.width, height: manifest.height, bytes: pk.bytes, sha256: pk.sha256 }], fidelity: fid ? { ...fid, report: p.verify } : null,
    }
    const prev = files[p.zmotion] ? JSON.parse(files[p.zmotion]) : await tree.json(p.zmotion)
    const zmotion = mergeZmotion(prev, { publicId, local: { ...item.motion, id: item.id }, version: item.version, entry, exposed: item.exposed, now })
    files[p.zmotion] = JSON.stringify(zmotion, null, 2) + '\n'
    rows.push(catalogueRow(publicId, zmotion))
  }
  const catalogue = buildCatalogue(await tree.json(cloudPath(cfg.files.catalogue)), rows, now)
  files[cloudPath(cfg.files.catalogue)] = JSON.stringify(catalogue, null, 1) + '\n'
  files[cloudPath(cfg.files.ids)] = JSON.stringify(ids, null, 2) + '\n'
  files[cloudPath(cfg.files.shard)] = JSON.stringify(shardState, null, 2) + '\n'
  return { files, catalogue, ids }
}

async function main() {
  const items = localMotions().filter((i) => i.version)
  if (!items.length) done(2, { ok: false, error: 'aucune version rendue à publier', code: 'refused' })
  const blockers = items.map((i) => ({ id: i.id, version: i.version, reason: rightsBlocker(i.motion) })).filter((b) => b.reason)
  if (push && blockers.length) done(2, { ok: false, error: blockers.map((b) => `${b.id} ${b.version} : ${b.reason}`).join(' | '), code: 'refused', blockers })

  const store = createCloudStore({ config: { cloud: cfg.cloud }, directory: cloneDir })
  if (privateRemote) {
    // Tests and rehearsals: point the private clone at another remote (a local bare repository).
    if (!fs.existsSync(path.join(cloneDir, '.git'))) {
      execFileSync('git', ['clone', '--quiet', '--sparse', '--branch', cfg.cloud.branch, privateRemote, cloneDir])
      execFileSync('git', ['-C', cloneDir, 'sparse-checkout', 'set', cfg.cloud.folder])
    }
  }
  const tree = store.tree
  if (push) await store.sync()
  const idsState = (await tree.json(cloudPath(cfg.files.ids)).catch(() => null)) || null
  const ids = assignPublicIds(idsState, items.map((i) => i.id))
  for (const item of items) {
    const p = versionPaths(ids.ids[item.id], item.version)
    const card = await tree.json(p.zmotion).catch(() => null)
    item.alreadyPublished = !!card?.versions?.some((v) => v.version === item.version && v.state === 'published')
  }
  const todo = items.filter((i) => !i.alreadyPublished)
  if (!todo.length) done(0, { ok: true, published: 0, skipped: items.map((i) => `${ids.ids[i.id]} ${i.version}`), note: 'déjà publié (versions immuables)' })

  for (const item of todo) { item.pkg = packageVersion(item); item.exposed = exposedOf(item.id, item.version) }
  const addBytes = todo.reduce((s, i) => s + i.pkg.packaged.totalBytes + i.pkg.posterBytes, 0)
  let shardState = (await tree.json(cloudPath(cfg.files.shard)).catch(() => null)) || { active: null, bytes: 0 }
  if (!shardState.active || shardState.bytes + addBytes > PUBLIC_SHARD.binBytes) shardState = { active: shardName(cfg.shard.kind, 'public', 0), bytes: 0 }
  shardState = { ...shardState, bytes: shardState.bytes + addBytes, updatedAt: now }

  if (!push) {
    for (const item of todo) {
      const p = versionPaths(ids.ids[item.id], item.version)
      item.shard = shardState.active; item.commitPublic = '0000000'
      item.cdnBase = `${FILM_POSTER.cdnBase}/${PUBLIC_SHARD.owner}/${item.shard}@${item.commitPublic}/${p.publicDir}/`
      item.posterUrl = `${item.cdnBase}${FILM_POSTER.fileName}`
      item.urlMap = Object.fromEntries(item.pkg.packaged.names.map((n) => [n, `${item.cdnBase}${n}`]))
    }
    const { files, catalogue } = await planFiles(tree, todo, idsState, shardState)
    const problems = checkCatalogue(catalogue, (rel) => rel in files || fs.existsSync(path.join(cloneDir, rel)))
    const publicPaths = todo.flatMap((i) => [FILM_POSTER.fileName, ...i.pkg.packaged.names].map((n) => `${versionPaths(ids.ids[i.id], i.version).publicDir}/${n}`))
    done(0, { ok: true, dryRun: true, blockers, versions: todo.map((i) => ({ local: i.id, public: ids.ids[i.id], version: i.version, mode: i.pkg.mode,
      segments: i.pkg.packaged.names.length, bytes: i.pkg.packaged.totalBytes })), shard: shardState.active, publicFiles: publicPaths.length,
      publicPathsNeutral: publicPaths.every((x) => isNeutralPublicPath(x)), privateFiles: Object.keys(files), catalogueProblems: problems })
  }

  const token = publicTemplate ? 'local-test' : resolveToken()
  if (!publicTemplate && !flag('--no-create-repo')) await ensurePublicShardRepo(token, shardState.active, { description: cfg.shard.description })
  const shard = await openVideoGitShard({ owner: PUBLIC_SHARD.owner, repo: shardState.active, workDir: path.join(workRoot, 'shards'), token,
    remoteUrl: publicTemplate ? publicTemplate.replace('{repo}', shardState.active) : undefined })
  try {
    for (const item of todo) {
      const p = versionPaths(ids.ids[item.id], item.version)
      const list = [{ path: `${p.publicDir}/${FILM_POSTER.fileName}`, sourcePath: item.pkg.poster, size: item.pkg.posterBytes },
        ...item.pkg.packaged.names.map((n) => ({ path: `${p.publicDir}/${n}`, sourcePath: path.join(item.pkg.workDir, n), size: fs.statSync(path.join(item.pkg.workDir, n)).size }))]
      if (!list.every((f) => isNeutralPublicPath(f.path))) throw new Error('public path not neutral')
      const res = await shard.pushFiles(list, { message: cfg.commitMessages.public })
      item.shard = shardState.active; item.commitPublic = res.commit
      item.cdnBase = `${FILM_POSTER.cdnBase}/${PUBLIC_SHARD.owner}/${item.shard}@${res.commit}/${p.publicDir}/`
      item.posterUrl = `${item.cdnBase}${FILM_POSTER.fileName}`
      item.urlMap = Object.fromEntries(item.pkg.packaged.names.map((n) => [n, `${item.cdnBase}${n}`]))
      if (!flag('--skip-cdn-check')) {
        const check = await verifyPublicPoster(item.posterUrl)
        if (!check.ok) throw new Error(`poster not served by jsDelivr: ${check.reason}`)
      }
    }
  } finally { fs.rmSync(shard.directory, { recursive: true, force: true }) }

  let planned
  const result = await store.commit(cfg.commitMessages.private, async (freshTree) => {
    const fresh = await freshTree.json(cloudPath(cfg.files.ids)).catch(() => null)
    planned = await planFiles(freshTree, todo, fresh, shardState)
    return { files: planned.files, report: null }
  })
  const problems = checkCatalogue(planned.catalogue, (rel) => fs.existsSync(path.join(cloneDir, rel)))
  if (problems.length) done(1, { ok: false, error: 'catalogue invariants red after commit', problems, commit: result.commit })
  if (!flag('--skip-cdn-check')) {
    for (const item of todo) {
      const seg = await verifyJsDelivrSegment(item.urlMap[item.pkg.packaged.names[0]])
      if (!seg.ok) done(1, { ok: false, error: `segment not served by jsDelivr: ${seg.url}` })
    }
  }
  done(0, { ok: true, published: todo.length, commit: result.commit, shard: shardState.active,
    versions: todo.map((i) => ({ public: planned.ids.ids[i.id], version: i.version, poster: i.posterUrl })), catalogueProblems: problems })
}

main().catch((error) => done(1, { ok: false, error: error.message }))
