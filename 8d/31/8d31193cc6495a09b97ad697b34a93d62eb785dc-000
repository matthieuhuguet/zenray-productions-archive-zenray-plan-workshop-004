// ═══ LA PASTILLE, CE QUI RESTE DU MINUTEUR QUAND ON EST AILLEURS (2026-08-27) ════════════════════
//
// Demande de Matthieu : « en bas à gauche, sans afficher les secondes pour que ce soit subtil, mais
// avec un effet de respiration pour que ce soit doux ». Trois contraintes, et la première est la plus
// intéressante parce qu'elle a l'air d'un caprice et n'en est pas un.
//
// POURQUOI RETIRER LES SECONDES AMÉLIORE VRAIMENT LA CHOSE. Un nombre qui change chaque seconde
// capture le regard, c'est le principe même du mouvement périphérique, et un minuteur censé protéger
// la concentration se mettrait alors à la voler. En minutes, l'affichage ne bouge qu'une fois par
// minute : on peut le regarder quand on le décide, jamais parce qu'il a bougé. La respiration, elle,
// suffit à dire que la chose est vivante, sans rien annoncer.
//
// `Math.ceil` ET NON `Math.round`, ET C'EST DÉLIBÉRÉ. À trente secondes de la fin, un arrondi
// afficherait « 0 » pendant une demi-minute, ce qui se lit comme un minuteur en panne. Le plafond
// affiche « 1 » jusqu'à la dernière seconde, ce qui est à la fois plus juste à l'usage et plus honnête :
// il reste bien quelque chose.
import React, { useEffect, useState } from 'react'
import RoueCyber from './RoueCyber.jsx'
import { useSidebarRect, useZoneContenu } from '../lib/useSidebarRect.js'
import { TB, useTimer } from './TimerContext.jsx'
import { formaterDuree } from './dureeSaisie.js'
import './TimerBadge.css'

// Retrait de la pastille dans le coin du panneau, identique horizontalement et verticalement : c'est
// l'égalité des deux qui rend les courbes concentriques, donc c'est UN nombre et pas deux.
const NID = 16

export default function TimerBadge({ visible, onOuvrir }) {
  const tm = useTimer()
  // « EN BAS À GAUCHE », MAIS À GAUCHE DE QUOI. Posée au coin de la fenêtre, la pastille tombait sur la
  // barre latérale : celle-ci mesure 936 pixels de haut pour une fenêtre de 720, donc elle DÉBORDE sous
  // l'écran et le coin bas gauche lui appartient entièrement. Mesuré, pas supposé, et c'est la mesure
  // qui a corrigé le placement : la pastille recouvrait « ZenRayShards » et « Learn ».
  // Elle s'ancre donc au coin bas gauche de la ZONE DE CONTENU, et sur ses deux bords : bord gauche sur
  // celui du panneau, bas sur le sien. Le premier jet la posait à un écart fixe du bord droit de la
  // barre, ce qui la laissait flotter dans la gouttière, alignée sur rien, et se lisait comme un objet
  // posé de travers quel que soit l'espace autour. Mesuré sur des vues sans mise en page commune, cette
  // ligne de contenu existe partout, donc la suivre vaut mieux que s'en écarter de quelques pixels.
  // Quand rien ne se mesure (mode immersif, barre repliée), on retombe sur la barre puis sur le coin de
  // la fenêtre, qui est alors réellement libre.
  // La pastille ne se retire pas au moment où le bloc finit : elle montre son anneau plein quelques
  // secondes, le temps qu'on le voie. Sans ce délai, la seule preuve visible d'une réussite serait
  // partie avant qu'on ait tourné la tête.
  const [survitFin, setSurvitFin] = useState(false)
  useEffect(() => {
    if (!tm?.finiA) { setSurvitFin(false); return undefined }
    setSurvitFin(true)
    const id = setTimeout(() => setSurvitFin(false), TB.pastille.survieApresFin)
    return () => clearTimeout(id)
  }, [tm?.finiA])

  const barre = useSidebarRect()
  const zone = useZoneContenu()
  if (!tm) return null
  const { enCours, fini, reste, avance, minutes, titre } = tm
  if (!visible || !(enCours || (fini && survitFin))) return null

  const minutesRestantes = Math.ceil(Math.max(0, reste) / 60)
  // AU-DELÀ DE L'HEURE, ON COMPTE EN HEURES. Depuis que la durée libre monte à la journée, « 1440 »
  // pouvait s'afficher au centre d'un cercle de cinquante-quatre pixels, où quatre chiffres ne tiennent
  // pas et où, même s'ils tenaient, personne ne lit une durée en minutes à ce niveau-là.
  const centre = fini ? '0' : minutesRestantes < 60 ? String(minutesRestantes) : `${Math.ceil(minutesRestantes / 60)}h`
  const urgent = enCours && reste <= 60
  const libelle = titre.trim().replace(/\s*-\s*$/, '') || `Bloc de ${formaterDuree(Math.round(minutes * 60))}`

  return (
    <button type="button" className={`zrtb${fini ? ' zrtb-fini' : ''}`} onClick={onOuvrir}
      style={zone
        ? { left: zone.gauche + NID, bottom: zone.insetBas + NID }
        : { left: barre ? `calc(${barre.right}px + var(--zrtb-air))` : undefined }}
      title="Revenir au minuteur"
      aria-label={fini ? `Bloc terminé : ${libelle}` : `${formaterDuree(minutesRestantes * 60)} restantes sur ${libelle}`}>
      <span className="zrtb-roue">
        <RoueCyber taille={54} avance={fini ? 1 : avance} urgent={urgent} />
        {/* Le nombre est POSÉ sur la roue plutôt que dessiné dedans : les chiffres de l'interface se
            composent en serif selon la règle du dépôt, et une police servie par le produit se rend plus
            fidèlement en HTML qu'en `<text>` SVG, où le calage vertical dépend du dessin de la fonte. */}
        <span className={`zrtb-nombre${centre.length > 2 ? ' zrtb-nombre-long' : ''}`}>{centre}</span>
      </span>
      {/* L'étiquette ne se déploie qu'au survol. En permanence, elle ferait de la pastille un bandeau,
          et « subtil » était la consigne : ce qu'on a besoin de savoir sans y penser, c'est combien de
          temps il reste ; sur quoi on travaille, on le sait déjà, on est en train de le faire. */}
      <span className="zrtb-etiquette">
        <span className="zrtb-titre">{libelle}</span>
        <span className="zrtb-sous">{fini ? 'terminé' : minutesRestantes > 1 ? `${formaterDuree(minutesRestantes * 60)} restantes` : 'dernière minute'}</span>
      </span>
    </button>
  )
}
