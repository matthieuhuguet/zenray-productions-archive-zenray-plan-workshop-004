// ShareImagePage.jsx — PAGE PUBLIQUE « image only » (lien de partage /view?v=<token>).
//
// EN CLAIR : même patron que ShareVideoPage.jsx (/watch). Quand on ouvre un lien de partage image, on
// n'affiche QUE cette image en grand — pas la sidebar, pas le drive, pas d'auth. Celui qui a le lien peut
// regarder ET télécharger l'original, mais n'a accès à rien d'autre.
// Le token v1 est opaque, signé, expirant et révocable. Les anciens chemins encodés en base64url restent lus.
//
// Données : le manifeste .img.json est lu via /api/page (déjà public en lecture pour .img.json/.media.json,
// voir authOk dans api/[...route].js). L'image est chiffrée sur le CDN (public+chiffré, voir
// ImageNodeViewer.jsx) : le déchiffrement se fait ici via resolveFullUrl, exactement comme dans le Drive.
// Aucun secret serveur requis (le contenu est déjà public par conception, seule la clé de déchiffrement
// voyage dans le manifeste public — même modèle que pour toutes les images publiques du drive).
import React, { useEffect, useState } from 'react'
import { PALETTE, THEMES } from '../theme.js'
import { RADII, SHADOWS } from '../theme.js'
import { useT } from '../i18n/useT.js'
import LanguageSwitcher from './LanguageSwitcher.jsx'
import { appendShareCredential, decodeShare, encodeShare, resolveShareToken, SHARE_KIND } from '../lib/shareLinks.js'
import { isEncrypted, shardImgUrl } from './ImageNodeViewer.jsx'

export { encodeShare, decodeShare }

export default function ShareImagePage() {
  const t = THEMES.light
  const i18nT = useT()
  const [path, setPath] = useState('')
  const [m, setM] = useState(null)
  const [url, setUrl] = useState(null)
  const [err, setErr] = useState(null)
  const [busy, setBusy] = useState(false)
  const [shareToken, setShareToken] = useState('')

  useEffect(() => {
    const v = new URLSearchParams(window.location.search).get('v') || ''
    const controller = new AbortController()
    setShareToken(v)
    ;(async () => {
      try {
        const resolved = await resolveShareToken(v, SHARE_KIND.image, { signal: controller.signal })
        if (controller.signal.aborted) return
        setPath(resolved.path)
        const response = await fetch(appendShareCredential(`/api/page?action=read&path=${encodeURIComponent(resolved.path)}`, v), { cache: 'no-store', signal: controller.signal })
        if (!response.ok) throw new Error('manifest')
        const j = await response.json()
        let mm = null; try { mm = JSON.parse(j.markdown) } catch {}
        if (mm) setM(mm); else setErr('share.imageNotFound')
      } catch (error) {
        if (!controller.signal.aborted) setErr(error && error.code ? 'share.invalidLink' : 'share.imageNotFound')
      }
    })()
    return () => controller.abort()
  }, [])

  useEffect(() => {
    if (!m) return
    // FIX (2026-07-01) : resolveFullUrl faisait un déchiffrement CÔTÉ CLIENT (fetch /api/media-key, gaté ->
    // 401 pour tout visiteur anonyme sans le code du drive) -> l'image restait bloquée sur "Déchiffrement…"
    // pour QUICONQUE recevait ce lien. /api/shared-media déchiffre CÔTÉ SERVEUR (public, sans exposer la clé)
    // et streame directement l'image — zéro crypto client nécessaire, marche pour n'importe quel visiteur.
    if (isEncrypted(m)) { setUrl(appendShareCredential(`/api/shared-media?path=${encodeURIComponent(path)}&kind=full`, shareToken)) } else { setUrl(shardImgUrl(m)) }
  }, [m, path, shareToken])

  const download = async () => {
    if (!path || !url || busy) return
    setBusy(true)
    try {
      const response = await fetch(url)
      if (!response.ok) throw new Error('download')
      const objectUrl = URL.createObjectURL(await response.blob())
      const anchor = document.createElement('a')
      anchor.href = objectUrl; anchor.download = (m && m.name) || 'image'; document.body.appendChild(anchor); anchor.click(); anchor.remove()
      setTimeout(() => URL.revokeObjectURL(objectUrl), 30000)
    } finally { setBusy(false) }
  }

  return (
    <div style={{ minHeight: '100vh', background: 'transparent', color: t.textPrimary, fontFamily: "var(--zr-police-sans)", display: 'flex', flexDirection: 'column' }}>
      <header style={{ display: 'flex', alignItems: 'center', gap: 10, padding: '16px 22px' }}>
        <img src="/favicon.png" alt="ZenRay" style={{ width: 28, height: 28, borderRadius: 8 }} />
        <span style={{ fontFamily: "var(--zr-police-serif)", fontStyle: 'italic', fontSize: 'var(--zr-ui-3xl)', color: t.textPrimary }}>ZenRay</span>
        <span style={{ marginLeft: 'auto' }}><LanguageSwitcher t={t} /></span>
      </header>

      <main style={{ flex: 1, width: '100%', maxWidth: 1120, margin: '0 auto', padding: '12px 16px 60px', boxSizing: 'border-box', display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 16 }}>
        {err && <div className="zr-liquid" style={{ color: PALETTE.red, fontSize: 'var(--zr-ui-lg)', padding: 40, textAlign: 'center', borderRadius: 18 }}>{i18nT(err)}</div>}
        {!err && !m && <div style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-lg)', padding: 40, textAlign: 'center' }}>{i18nT('share.loadingImage')}</div>}
        {!err && m && (
          <>
            <div className="zr-stage" style={{ borderRadius: RADII.lg, padding: 14, maxWidth: '100%', boxShadow: SHADOWS.apple }}>
              {url
                ? <img src={url} alt={m.name || 'image'} decoding="async" style={{ maxWidth: '100%', maxHeight: '74vh', display: 'block', borderRadius: RADII.md, objectFit: 'contain' }} />
                : <div style={{ color: t.textSecondary, padding: 40, textAlign: 'center' }}>{i18nT('share.decryptingImage')}</div>}
            </div>
            <button onClick={download} disabled={busy} style={{ padding: '9px 18px', borderRadius: 11, border: 'none', cursor: busy ? 'default' : 'pointer', opacity: busy ? 0.6 : 1, background: '#0A84FF', color: '#fff', fontSize: 'var(--zr-ui-md)', fontWeight: 500, fontFamily: 'inherit' }}>{busy ? i18nT('share.downloading') : i18nT('share.downloadOriginal')}</button>
          </>
        )}
      </main>
    </div>
  )
}
