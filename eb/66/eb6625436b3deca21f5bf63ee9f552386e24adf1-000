// IndexView.jsx — vue INDEX (sidebar "Index", 2026-07-05, demande explicite de Matthieu).
//
// EN CLAIR : une radiographie du stockage. À gauche, l'arborescence complète de pages/ (chargée dossier par
// dossier à la demande — chaque niveau est SON PROPRE appel JSON, donc profondeur infinie sans jamais tout
// charger). Au clic sur un fichier média : son manifeste est lu et le panneau de droite montre OÙ il vit sur
// GitHub (repo(s), nombre de parts, tailles), s'il est chiffré/privé, et à quelle FEATURE du site il
// correspond. En tête : les stats des repos de stockage (mapping du rename zenrayshards, lu depuis
// zenray-data:pages/_index/storage-repos.json, généré par scripts/rename-shards.mjs).
import React, { useCallback, useEffect, useState } from 'react'
import { List } from 'masonic'
import Icon from './Icon.jsx'
import { storageOf, fmtBytes } from '../lib/storageInfo.js'

const SANS = "var(--zr-police-sans)"

// Au-delà de ce nombre d'enfants DIRECTS (un dossier avec des milliers de fichiers, ex. import Eagle), on
// virtualise avec masonic (même lib que Gallery.jsx) au lieu de monter chaque ligne — la profondeur de
// l'arbre reste, elle, naturellement bornée par les dossiers ouverts un par un, donc pas de virtualisation
// nécessaire à CE niveau-là.
const VIRTUALIZE_ABOVE = 200

function KidRow({ t, e, depth, onPick, picked }) {
  if (e.type === 'dir') return <Folder t={t} dir={e.path} depth={depth + 1} onPick={onPick} picked={picked} />
  if (!/\.(media|img|file)\.json$/.test(e.name)) return null
  return (
    <button onClick={() => onPick(e.path)} style={{ display: 'flex', alignItems: 'center', gap: 6, width: '100%', textAlign: 'left', background: picked === e.path ? t.hoverBg || 'rgba(120,120,128,0.12)' : 'none', border: 'none', cursor: 'pointer', padding: '4px 6px', paddingLeft: 6 + (depth + 1) * 14, borderRadius: 7, color: t.textPrimary, fontFamily: SANS, fontSize: 'var(--zr-ui-sm)', whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>
      <Icon name={/\.img\.json$/.test(e.name) ? 'photo' : /\.file\.json$/.test(e.name) ? 'archivebox' : 'film'} size={14} color={t.textSecondary} />
      <span style={{ overflow: 'hidden', textOverflow: 'ellipsis' }}>{e.name.replace(/\.(media|img|file)\.json$/, '')}</span>
    </button>
  )
}

function Folder({ t, dir, depth, onPick, picked }) {
  const [open, setOpen] = useState(depth === 0)
  const [kids, setKids] = useState(null) // null = pas encore chargé
  useEffect(() => {
    if (!open || kids !== null) return
    let dead = false
    fetch(`/api/page?action=children&dir=${encodeURIComponent(dir)}`, { cache: 'no-store' }).then((r) => r.json())
      .then((j) => { if (!dead) setKids(Array.isArray(j.entries) ? j.entries : []) })
      .catch(() => { if (!dead) setKids([]) })
    return () => { dead = true }
  }, [open, dir, kids])
  const name = dir.split('/').pop()
  const Row = useCallback(({ data }) => <KidRow t={t} e={data} depth={depth} onPick={onPick} picked={picked} />, [t, depth, onPick, picked])
  return (
    <div>
      {depth > 0 && (
        <button onClick={() => setOpen((v) => !v)} style={{ display: 'flex', alignItems: 'center', gap: 6, width: '100%', textAlign: 'left', background: 'none', border: 'none', cursor: 'pointer', padding: '4px 6px', paddingLeft: 6 + depth * 14, borderRadius: 7, color: t.textPrimary, fontFamily: SANS, fontSize: 'var(--zr-ui-md)' }}>
          <Icon name={open ? 'chevron.down' : 'chevron.right'} size={11} color={t.textSecondary} weight={2} />
          <Icon name="folder" size={15} /> {name}
        </button>
      )}
      {open && kids === null && <div style={{ paddingLeft: 6 + (depth + 1) * 14, color: t.textSecondary, fontSize: 'var(--zr-ui-sm)', padding: '3px 6px' }}>chargement…</div>}
      {open && kids && (kids.length > VIRTUALIZE_ABOVE
        ? <List items={kids} rowGutter={0} overscanBy={6} itemKey={(e) => e.path} render={Row} />
        : kids.map((e) => <KidRow key={e.path} t={t} e={e} depth={depth} onPick={onPick} picked={picked} />))}
    </div>
  )
}

export default function IndexView({ t }) {
  const [repoStats, setRepoStats] = useState(null)
  const [picked, setPicked] = useState(null)
  const [detail, setDetail] = useState(null) // { path, manifest, storage } | { path, error }
  useEffect(() => {
    let dead = false
    fetch('/api/page?action=read&path=' + encodeURIComponent('pages/_index/storage-repos.json'))
      .then((r) => r.json()).then((j) => {
        if (dead) return
        try {
          const d = JSON.parse(j.markdown)
          const byType = {}
          for (const k of Object.keys(d.repos || {})) { const ty = d.repos[k].type || '?'; byType[ty] = (byType[ty] || 0) + 1 }
          setRepoStats({ total: Object.keys(d.repos || {}).length, byType, updatedAt: d.updatedAt })
        } catch { setRepoStats({ total: 0, byType: {} }) }
      }).catch(() => { if (!dead) setRepoStats({ total: 0, byType: {} }) })
    return () => { dead = true }
  }, [])
  useEffect(() => {
    if (!picked) return
    let dead = false
    setDetail(null)
    fetch('/api/page?action=read&path=' + encodeURIComponent(picked)).then((r) => r.json())
      .then((j) => {
        if (dead) return
        try { const m = JSON.parse(j.markdown); setDetail({ path: picked, manifest: m, storage: storageOf(m, picked) }) }
        catch { setDetail({ path: picked, error: 'manifeste illisible' }) }
      }).catch(() => { if (!dead) setDetail({ path: picked, error: 'lecture impossible' }) })
    return () => { dead = true }
  }, [picked])

  const card = { background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: 14, padding: 14 }
  return (
    <div style={{ padding: '18px 22px', maxWidth: 1240, margin: '0 auto' }}>
      <div style={{ fontFamily: SANS, fontSize: 21, fontWeight: 600, color: t.textPrimary, marginBottom: 4 }}>Index du stockage</div>
      <div style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary, marginBottom: 14 }}>
        Chaque fichier du drive, son ou ses dépôts GitHub (zenrayshards), son nombre de parts et la feature qui le sert.
      </div>
      {/* stats des repos (mapping rename) */}
      <div style={{ ...card, marginBottom: 14, display: 'flex', gap: 22, flexWrap: 'wrap', alignItems: 'baseline' }}>
        {repoStats === null ? <span style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-sm)' }}>chargement des stats…</span> : (
          <>
            <span style={{ fontFamily: SANS, fontSize: 20, color: t.textPrimary }}>{repoStats.total}<span style={{ fontSize: 'var(--zr-ui-xs)', color: t.textSecondary }}> repos de stockage</span></span>
            {Object.entries(repoStats.byType).sort((a, b) => b[1] - a[1]).map(([ty, n]) => (
              <span key={ty} style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-md)', color: t.textSecondary }}>{ty} <span style={{ color: t.textPrimary }}>{n}</span></span>
            ))}
          </>
        )}
      </div>
      <div style={{ display: 'flex', gap: 14, alignItems: 'flex-start' }}>
        {/* arborescence (entrées infinies : chaque dossier = son propre JSON à l'ouverture) */}
        <div style={{ ...card, flex: '0 0 380px', maxHeight: 'calc(100vh - 250px)', overflowY: 'auto' }}>
          <Folder t={t} dir="pages" depth={0} onPick={setPicked} picked={picked} />
        </div>
        {/* détail stockage du fichier sélectionné */}
        <div style={{ ...card, flex: 1, minWidth: 0, minHeight: 220 }}>
          {!picked && <div style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-md)' }}>Sélectionne un fichier à gauche pour voir où il est stocké.</div>}
          {picked && !detail && <div style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-md)' }}>lecture du manifeste…</div>}
          {detail && detail.error && <div style={{ color: '#FF3B30', fontSize: 'var(--zr-ui-md)' }}>{detail.error}</div>}
          {detail && detail.storage && (
            <div style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-md)', color: t.textPrimary, display: 'flex', flexDirection: 'column', gap: 10 }}>
              <div style={{ fontSize: 'var(--zr-ui-xl)', fontWeight: 600 }}>{picked.split('/').pop().replace(/\.(media|img|file)\.json$/, '')}</div>
              <div style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-xs)', color: t.textSecondary, wordBreak: 'break-all' }}>{picked}</div>
              <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
                <Chip t={t}>{detail.storage.feature}</Chip>
                {detail.storage.size > 0 && <Chip t={t}>{fmtBytes(detail.storage.size)}</Chip>}
                {detail.storage.totalParts > 0 && <Chip t={t}>{detail.storage.totalParts} part{detail.storage.totalParts > 1 ? 's' : ''}</Chip>}
                {detail.storage.enc && <Chip t={t}>chiffré AES-GCM</Chip>}
                {detail.storage.priv && <Chip t={t}>repo privé</Chip>}
              </div>
              {detail.storage.repos.length > 0 ? (
                <div>
                  <div style={{ fontSize: 'var(--zr-ui-xs)', textTransform: 'uppercase', letterSpacing: 0.8, color: t.textSecondary, margin: '4px 0 6px' }}>Dépôts GitHub</div>
                  {detail.storage.repos.map((r) => (
                    <div key={r.repo} style={{ display: 'flex', alignItems: 'baseline', gap: 10, padding: '5px 0', borderBottom: `1px solid ${t.border}` }}>
                      <a href={`https://github.com/matthieuhuguet/${r.repo}`} target="_blank" rel="noreferrer" style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-sm)', color: t.textPrimary, textDecoration: 'none' }}>{r.repo}</a>
                      <span style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-xs)', color: t.textSecondary }}>{r.parts} part{r.parts > 1 ? 's' : ''}{r.bytes ? ` · ${fmtBytes(r.bytes)}` : ''}</span>
                    </div>
                  ))}
                </div>
              ) : <div style={{ color: t.textSecondary, fontSize: 'var(--zr-ui-sm)' }}>Aucun octet stocké chez nous ({detail.storage.feature}).</div>}
            </div>
          )}
        </div>
      </div>
    </div>
  )
}

const Chip = ({ t, children }) => (
  <span style={{ fontFamily: "var(--zr-police-sans)", fontSize: 'var(--zr-ui-xs)', padding: '3px 9px', borderRadius: 99, border: `1px solid ${t.border}`, color: t.textSecondary }}>{children}</span>
)
