import React, { useState } from 'react'
import { useEditor, useValue } from 'tldraw'
import Icon from '../components/Icon.jsx'
import { useRefUi } from './refUiContext.js'

// Toolbar verticale gauche du board ZenRay Ref (2026-07-19) — remplace la toolbar tldraw par les
// outils Figma/Miro demandés, en matériau V9 (classes zr-ref-*, src/ref/ref.css). Montée DANS
// <Tldraw> via components.Toolbar : useEditor/useValue sont disponibles, et le contexte RefUi
// (créé par RefBoard autour de <Tldraw>) fournit le toggle du picker d'images.
//
// Ids d'outils tldraw v5 : select, hand, text, note (sticky), geo (formes — la forme précise se
// choisit dans le style panel conservé), arrow (connecteur), line, draw, eraser, frame, laser.

const TOOLS = [
  { id: 'select', icon: 'cursorarrow', label: 'Sélectionner et déplacer (V)' },
  { id: 'hand', icon: 'hand.raised', label: 'Main — naviguer (H)' },
  { id: 'text', icon: 'textformat', label: 'Texte (T)' },
  { id: 'note', icon: 'note.text', label: 'Post-it (N)' },
  { id: 'geo', icon: 'square.on.circle', label: 'Formes (R)' },
  { id: 'arrow', icon: 'arrow.up.right', label: 'Connexion — flèche (A)' },
  { id: 'line', icon: 'line.diagonal', label: 'Ligne (L)' },
  { id: 'draw', icon: 'pencil', label: 'Dessin à main levée (D)' },
]

const MORE_TOOLS = [
  { id: 'eraser', icon: 'eraser', label: 'Gomme' },
  { id: 'frame', icon: 'rectangle.dashed', label: 'Cadre' },
  { id: 'laser', icon: 'laser.burst', label: 'Pointeur laser' },
]

export default function RefToolbar() {
  const editor = useEditor()
  const { pickerOpen, setPickerOpen } = useRefUi()
  const [moreOpen, setMoreOpen] = useState(false)
  const current = useValue('ref current tool', () => editor.getCurrentToolId(), [editor])
  const canUndo = useValue('ref can undo', () => editor.getCanUndo(), [editor])
  const canRedo = useValue('ref can redo', () => editor.getCanRedo(), [editor])

  const pick = (id) => { editor.setCurrentTool(id); setMoreOpen(false) }
  const inMore = MORE_TOOLS.some((tool) => tool.id === current)

  return (
    <div className="zr-ref-toolbar zr-ref-glass" onPointerDown={(e) => e.stopPropagation()}>
      {TOOLS.map((tool) => (
        <button key={tool.id} className={`zr-ref-tool${current === tool.id ? ' active' : ''}`} title={tool.label}
          onClick={() => pick(tool.id)}>
          <Icon name={tool.icon} size={19} />
        </button>
      ))}
      <div className="zr-ref-sep" />
      <button className={`zr-ref-tool${pickerOpen ? ' active' : ''}`} title="Images du drive ZenRay" onClick={() => setPickerOpen(!pickerOpen)}>
        <Icon name="photo" size={19} />
      </button>
      <div style={{ position: 'relative' }}>
        <button className={`zr-ref-tool${moreOpen || inMore ? ' active' : ''}`} title="Plus d’outils" onClick={() => setMoreOpen((v) => !v)}>
          <Icon name="ellipsis" size={19} />
        </button>
        {moreOpen && (
          <div className="zr-ref-more zr-ref-glass">
            {MORE_TOOLS.map((tool) => (
              <button key={tool.id} className={current === tool.id ? 'active' : ''} onClick={() => pick(tool.id)}>
                <Icon name={tool.icon} size={16} /> {tool.label}
              </button>
            ))}
          </div>
        )}
      </div>
      <div className="zr-ref-sep" />
      <button className="zr-ref-tool" title="Annuler (Cmd+Z)" disabled={!canUndo} onClick={() => editor.undo()}>
        <Icon name="arrow.uturn.backward" size={18} />
      </button>
      <button className="zr-ref-tool" title="Rétablir (Cmd+Maj+Z)" disabled={!canRedo} onClick={() => editor.redo()}>
        <Icon name="arrow.uturn.forward" size={18} />
      </button>
    </div>
  )
}
