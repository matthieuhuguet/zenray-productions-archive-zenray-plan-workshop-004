// 4 October 2026: one public vacancy becomes one studio record (schema v2) plus an `engine` block.
// Port of the verified 30 September collector (same ids, same notes) with a structured, scored layer on top.
// FR : une annonce publique devient une fiche studio (schema v2) plus un bloc `engine`, avec les memes
// identifiants et les memes notes que le collecteur verifie du 30 septembre.
import { createHash } from 'node:crypto'
import { clean, dateLabel, englishDay, noLongDash, recruiterEmails } from './Text.mjs'

export const ROLE_PATTERN = /technical.{0,16}art|tech.{0,4}artist|environment.{0,20}(artist|art|supervisor)|artiste.{0,12}(technique|environnement)|level.{0,14}(design|art)|game.{0,10}(design|director)|gameplay.{0,8}design|concepteur.{0,12}(jeu|niveau)|narrative.{0,12}(design|director)|vfx.{0,12}(artist|art|engineer)|houdini|procedural.{0,15}(art|tool|engineer)|material.{0,8}artist|texture.{0,8}artist|lighting.{0,8}artist|prop.{0,8}artist|3d.{0,8}artist|graphiste.{0,8}3d|technical.{0,10}(animator|designer)|\bc?fx\b.{0,14}(artist|td\b|technical)|crowd.{0,10}(artist|td\b)/i

// 5 October 2026: the second lane, outside video games. Same person, other buyers: studios of film and series VFX, visualisation,
// digital twins, simulation, XR, motion, and public tenders. A listing matches either lane, never both (games wins).
// FR : la seconde voie, hors jeu video : VFX cinema, visualisation, jumeaux numeriques, simulation, XR, motion, appels d'offres publics.
export const OTHER_ROLE_PATTERN = /houdini|technical.{0,16}art|tech.{0,4}artist|procedural|pipeline.{0,6}td|real.?time.{0,20}(3d|graphics|render|visuali|artist|developer|engineer)|unreal engine|\bunity\b.{0,20}(developer|artist|engineer|3d)|3d.{0,12}(artist|visuali[sz]|developer|generalist|model|animat|designer|configurator)|visuali[sz]ation.{0,12}(3d|artist|specialist)|archviz|digital.{0,3}twin|jumeau.{0,3}num|\b(xr|vr|ar|mixed reality|augmented reality|virtual reality|r[ée]alit[ée] (virtuelle|augment[ée]e))\b.{0,20}(developer|artist|engineer|d[ée]veloppeur|designer)|creative.{0,3}technologist|three\.?js|webgl|motion.{0,3}(design|graphics)|vfx.{0,12}(artist|supervisor|td|engineer)|simulation.{0,12}(engineer|artist|developer)|mod[ée]lisation 3d|infographiste 3d/i
export const TENDER_PATTERN = /3d|virtual reality|augmented reality|r[ée]alit[ée] (virtuelle|augment[ée]e)|digital twin|jumeau num|unreal|houdini|real.?time|temps r[ée]el|visuali[sz]ation|visualisation|simulation|serious game|motion design|animation|immersi|game engine|moteur de jeu|maquette num[ée]rique|modelling|modeling|mod[ée]lisation/i

export const SKILLS = {
  Houdini: /\bhoudini\b/i, 'Unreal Engine': /\bunreal\b|\bue[45]\b/i, Python: /\bpython\b/i, VEX: /\bvex\b/i, HDA: /\bhda[s]?\b|digital assets/i, PCG: /\bpcg\b/i,
  Blueprints: /\bblueprints?\b/i, HLSL: /\bhlsl\b/i, Niagara: /\bniagara\b/i, Unity: /\bunity\b/i, Substance: /\bsubstance\b/i, Blender: /\bblender\b/i,
  Maya: /\bmaya\b/i, 'C++': /c\+\+/i, 'C#': /c#/i,
}

const SPONTANEOUS = /open application|candidature spontan|talent pool|talent pipe(?:line)?|candidate pipe(?:line)?|vivier|speculative/i
const TRAINEE = /stage|intern|apprentice|alternance/i
const FREELANCE = /freelance|\bb2b\b|independent contractor/i
const NOT_FREELANCE = /freelance\s+(?:non|not)|non\s+freelance|not\s+(?:a\s+)?freelance/i

export const offerId = (sourceId) => 'job_' + createHash('sha256').update(String(sourceId)).digest('hex').slice(0, 20)

export function classify({ title = '', contract = '' }) {
  const text = `${contract} ${title}`
  const spontaneous = SPONTANEOUS.test(title)
  const freelance = FREELANCE.test(text) && !NOT_FREELANCE.test(text)
  const trainee = TRAINEE.test(text)
  const tender = /appel d.offre|tender|avis de march/i.test(contract)
  return { kind: tender ? 'tender' : spontaneous ? 'spontaneous' : trainee ? 'internship' : 'offer', freelance: freelance || tender, trainee, spontaneous, tender, salaried: !tender && !freelance && !trainee && !spontaneous }
}

export function skillsOf(text) { return Object.entries(SKILLS).filter(([, pattern]) => pattern.test(text)).map(([name]) => name) }

/** Years explicitly demanded, the smallest plausible figure first (an "or" in the text usually lowers the bar). */
export function yearsRequired(text) {
  const found = [...String(text).matchAll(/\b(\d{1,2})\s*\+?\s*(?:years|ans)\b/gi)].map((match) => Number(match[1])).filter((years) => years >= 1 && years <= 15)
  return found.length ? Math.min(...found) : null
}

const FRENCH_WORDS = /\b(vous|nous|votre|notre|poste|expérience|compétences|rejoindre|studio de|mission|profil|candidature|équipe)\b/gi
export function languageOf({ country = '', text = '' }) {
  if (/^(FR|BE|CH|LU)$/i.test(country) && (String(text).match(FRENCH_WORDS) || []).length >= 3) return 'fr'
  return (String(text).match(FRENCH_WORDS) || []).length >= 6 ? 'fr' : 'en'
}

function remoteNote(text, workplace, location) {
  if (/only able to hire.*canada|reside within canada|legally eligible to work in canada/i.test(text)) return 'Canada : résidence et autorisation de travail requises ; remote limité au Canada'
  if (/full.time.*(?:in.office|onsite|on.site)|relocat.{0,80}copenhagen|based in our.{0,30}copenhagen/i.test(text)) return 'Présence locale ou relocalisation à confirmer ; ne pas supposer le télétravail international'
  if (/eligible to work.{0,20}uk|right to work.{0,20}uk/i.test(text)) return 'Éligibilité à travailler au Royaume-Uni demandée'
  if (/remote/i.test(workplace) || /télétravail/i.test(location)) return 'Télétravail annoncé ; pays autorisés et fuseaux à confirmer'
  return 'Non précisé ; demander avant de candidater'
}

/** 0 to 100 from the published text only; every point is explained so the number can be argued with. */
/** A published date in any shape the sources use (ISO, "Jul 23, 2026", epoch milliseconds) as a timestamp, or null. */
export function publishedMs(value) {
  const raw = String(value || '').trim()
  if (!raw) return null
  if (/^\d{12,14}$/.test(raw)) return Number(raw)
  const ms = Date.parse(raw)
  return Number.isNaN(ms) ? null : ms
}

export function scoreOffer({ title, text, contract, country, workplace, published = '', now = new Date(), lane = 'games' }, config, flags = classify({ title, contract })) {
  const rel = config.relevance
  const why = []
  let score = 0
  const tier = (lane === 'other' ? rel.otherRoleTiers : rel.roleTiers).find((entry) => new RegExp(entry.pattern, 'i').test(title))
  if (tier) { score += tier.weight; why.push(`Poste proche du métier (+${tier.weight})`) }
  const skills = skillsOf(`${title} ${text}`)
  let skillPoints = 0
  for (const name of skills) skillPoints += rel.skillWeights[name] || 0
  skillPoints = Math.min(skillPoints, 38)
  if (skillPoints) { score += skillPoints; why.push(`Compétences citées : ${skills.join(', ')} (+${skillPoints})`) }
  const kind = flags.freelance ? 'freelance' : flags.trainee ? 'trainee' : flags.salaried ? 'salaried' : null
  if (kind && rel.contractBonus[kind]) { score += rel.contractBonus[kind]; why.push(`Contrat : ${kind} (+${rel.contractBonus[kind]})`) }
  if (new RegExp(rel.seniorTitlePattern, 'i').test(title)) { score -= rel.seniorTitlePenalty; why.push(`Poste senior (-${rel.seniorTitlePenalty})`) }
  else if (new RegExp(rel.juniorTitlePattern, 'i').test(title)) { score += rel.juniorBonus; why.push(`Poste junior ou stage (+${rel.juniorBonus})`) }
  const years = yearsRequired(text)
  if (years && years > config.profile.yearsOfProfessionalExperience + 1) {
    const penalty = Math.min(rel.seniorityPenaltyCap, Math.round((years - config.profile.yearsOfProfessionalExperience - 1) * rel.seniorityPenaltyPerYearAbove))
    score -= penalty; why.push(`${years} ans d’expérience demandés (-${penalty})`)
  }
  const cUpper = String(country || '').trim().toUpperCase()
  const prioBonuses = rel.countryPriorityBonus
  if (prioBonuses) {
    if (cUpper === 'FR' || /^(FRANCE)$/i.test(country)) {
      const b = prioBonuses.FR ?? 20
      score += b
      why.push(`France (+${b}) : priorité géographique`)
    } else if (cUpper === 'JP' || /^(JAPAN|JAPON)$/i.test(country)) {
      const b = prioBonuses.JP ?? 15
      score += b
      why.push(`Japon (+${b}) : priorité Cap 2027`)
    } else if (cUpper === 'GB' || cUpper === 'UK' || /^(ROYAUME-UNI|UNITED KINGDOM|ENGLAND|ANGLETERRE)$/i.test(country)) {
      const b = prioBonuses.GB ?? 10
      score += b
      why.push(`Royaume-Uni (+${b}) : priorité anglophone Europe`)
    } else if (cUpper === 'US' || cUpper === 'USA' || /^(UNITED STATES|ÉTATS-UNIS|ETATS-UNIS)$/i.test(country)) {
      const b = prioBonuses.US ?? 8
      score += b
      why.push(`États-Unis (+${b}) : marché majeur`)
    } else if (config.profile?.countriesOpen?.includes(cUpper)) {
      const b = prioBonuses.open ?? rel.countryBonus ?? 4
      score += b
      why.push(`Pays ouvert (+${b})`)
    }
  } else if (country && config.profile.countriesOpen.includes(cUpper)) {
    score += rel.countryBonus
    why.push(`Pays ouvert (+${rel.countryBonus})`)
  }
  if (/remote|télétravail/i.test(`${workplace} ${text.slice(0, 600)}`) && config.profile.remoteOk) { score += rel.remoteBonus; why.push(`Télétravail (+${rel.remoteBonus})`) }
  const publishedAt = publishedMs(published)
  if (publishedAt) {
    const age = (now.getTime() - publishedAt) / 86400000
    if (age > rel.veryStaleAfterDays) { score -= rel.veryStalePenalty; why.push(`Annonce publiée il y a plus d’un an (-${rel.veryStalePenalty})`) }
    else if (age > rel.staleAfterDays) { score -= rel.stalePenalty; why.push(`Annonce publiée il y a plus de ${rel.staleAfterDays} jours (-${rel.stalePenalty})`) }
  }
  if (new RegExp(rel.seniorTitlePattern, 'i').test(title) && score > rel.seniorScoreCeiling) { score = rel.seniorScoreCeiling; why.push(`Poste senior : jamais classé « fort » (plafond ${rel.seniorScoreCeiling})`) }
  score = Math.max(0, Math.min(100, score))
  return { score, tier: score >= rel.highScore ? 'high' : score >= rel.mediumScore ? 'medium' : 'low', why, skills, years }
}

/**
 * Listing (what a source published) -> studio record with notes + engine block.
 * `now` is injected so the record is reproducible in tests.
 */
export function buildOffer(listing, config, { now = new Date() } = {}) {
  const { name, url, applyUrl = '', sourceId = url, sourceKey, sourceLabel, location = '', country = '', contract = '', workplace = '', published = '', extra = '', evidence = '' } = listing
  const title = noLongDash(String(listing.title || '').trim())
  const text = clean(listing.text)
  const today = englishDay(now)
  const flags = classify({ title, contract })
  const lane = listing.lane === 'other' ? 'other' : 'games'
  const verdict = scoreOffer({ title, text, contract, country, workplace, published, now, lane }, config, flags)
  const emails = recruiterEmails(text)
  const priority = flags.freelance ? 'P1 : mission freelance explicite' : flags.trainee ? 'P4 : stage, signal studio' : verdict.skills.some((s) => s === 'Houdini' || s === 'Unreal Engine') ? 'P2 : besoin Houdini ou Unreal confirmé' : 'P3 : métier proche, besoin à qualifier'
  const constraints = text.split(/(?<=[.!?])\s+/).filter((sentence) => /right to work|work permit|visa sponsorship|legally eligible|reside|days per week|remote.*(?:only|within)|hybrid.*(?:only|studio)|\brelocat/i.test(sentence))
  const lines = [
    `Recensement vérifié le ${today}. Source : ${evidence || sourceLabel}.`,
    `Priorité commerciale estimée : ${priority}. (${today})`,
    `Offre : ${title}. Contrat publié : ${contract || 'Non précisé'}. (${today})`,
    `Lieu : ${location || 'Non précisé'}. Pays : ${country || 'Non précisé'}. Organisation : ${workplace || 'Non précisée'}. (${today})`,
    `Publication : ${dateLabel(published)}. Annonce présente dans la liste active de la source à la vérification. (${today})`,
    `Compétences citées dans la fiche : ${verdict.skills.join(', ') || 'À confirmer'}. (${today})`,
    `Expérience explicitement citée : ${verdict.years ? `${verdict.years} ans` : 'Non extraite ; consulter la fiche'}. (${today})`,
    `Conditions : ${remoteNote(text, workplace, location)}. (${today})`,
    `Salaire et TJM : ${/Rémunération publiée/.test(extra) ? 'rémunération publiée ci-dessous' : 'non relevés'} ; ne pas déduire un TJM freelance d’un salaire salarié. (${today})`,
    `Contact public : ${emails.join(', ') || 'Aucun mail de recrutement publié relevé ; utiliser le formulaire'}. (${today})`,
    `Source exacte : ${url} (${today})`,
    `Candidature : ${applyUrl || url} (${today})`,
    `Action : ${flags.freelance ? 'proposer la prestation demandée' : 'demander si un renfort freelance est envisageable ; le contrat publié ne garantit pas son acceptation'}. (${today})`,
    `Suivi : aucun envoi effectué ; brouillon uniquement. (${today})`,
  ]
  if (extra) lines.push(`${extra} (${today})`)
  if (constraints.length) lines.push(`Extraits des conditions publiées : ${constraints.slice(0, 4).map((s) => s.slice(0, 450)).join(' / ')}. (${today})`)
  const day = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`
  return {
    id: offerId(sourceId), name, role: title, link: url, city: location, status: 'to_contact', createdAt: day, contactedAt: '', messages: [], history: [],
    notes: noLongDash(lines.join('\n\n')),
    engine: {
      lane, source: sourceKey, sourceLabel, externalId: String(sourceId), kind: flags.kind, freelance: flags.freelance, trainee: flags.trainee,
      contract: contract || '', country: country || '', workplace: workplace || '', publishedAt: published ? String(published) : '',
      skills: verdict.skills, yearsRequired: verdict.years, score: verdict.score, tier: verdict.tier, scoreWhy: verdict.why,
      applyUrl: applyUrl || url, employerUrl: listing.employerUrl || config.sites?.[sourceKey] || '', careersUrl: listing.careersUrl || '', contactEmails: emails, language: languageOf({ country, text }),
      countryPriorityApplied: true,
      firstSeenAt: day, lastSeenAt: day, missedRuns: 0, closedAt: '',
    },
  }
}

/**
 * Vacancies written by the 30 September collector carry no `engine` block; their notes do hold the facts.
 * This reads those notes back so the 244 earlier records are as usable as new ones (letter, career link, contact).
 * FR : les annonces ecrites par le collecteur du 30 septembre n'ont pas de bloc `engine` ; leurs notes portent les faits.
 */
export function engineFromNotes(studio, config) {
  const notes = String(studio.notes || '')
  const take = (pattern) => (notes.match(pattern) || [])[1]?.trim() || ''
  const emails = take(/Contact public : (.*?)\. \(/)
  const skills = take(/Compétences citées dans la fiche : (.*?)\. \(/)
  const country = take(/Pays : (.*?)\. Organisation/)
  const contract = take(/Contrat publié : (.*?)\. \(/)
  const apply = take(/Candidature : (\S+) \(/)
  const flags = classify({ title: studio.role || '', contract })
  const skillList = skills && !/^À confirmer/.test(skills) ? skills.split(',').map((item) => item.trim()).filter(Boolean) : []
  const verdict = scoreOffer({ title: studio.role || '', text: `${skillList.join(' ')} ${notes}`, contract, country, workplace: take(/Organisation : (.*?)\. \(/) }, config, flags)
  return {
    source: '', sourceLabel: take(/^Recensement vérifié le [^.]+\. Source : (.*?)\.?$/m) || '', externalId: '', kind: flags.kind, freelance: flags.freelance, trainee: flags.trainee,
    contract, country: /^Non précisé/.test(country) ? '' : country, workplace: '', publishedAt: '', skills: skillList, yearsRequired: null, score: verdict.score, tier: verdict.tier, scoreWhy: verdict.why,
    applyUrl: apply || studio.link || '', employerUrl: '', contactEmails: /^Aucun/.test(emails) ? [] : emails.split(',').map((item) => item.trim()).filter(Boolean),
    language: /^(FR|BE|CH|LU|France|Belgique|Suisse|Luxembourg)$/i.test(country) || /\(\d{2}\)\s*$/.test(studio.city || '') ? 'fr' : 'en', firstSeenAt: studio.createdAt || '', lastSeenAt: '', missedRuns: 0, closedAt: '', legacy: true,
  }
}

/** Legacy records re-read their derived facts from the notes every pass; the bookkeeping the engine already tracks is kept. */
// FR : les fiches heritees relisent leurs faits derives des notes a chaque passe ; le suivi deja tenu par le moteur est garde.
export function refreshLegacyEngine(studio, config) {
  const fresh = engineFromNotes(studio, config)
  const old = studio.engine || {}
  const keep = {}
  for (const key of ['source', 'sourceLabel', 'externalId', 'publishedAt', 'firstSeenAt', 'lastSeenAt', 'closedAt', 'missedRuns']) if (old[key]) keep[key] = old[key]
  return { ...fresh, ...keep }
}
