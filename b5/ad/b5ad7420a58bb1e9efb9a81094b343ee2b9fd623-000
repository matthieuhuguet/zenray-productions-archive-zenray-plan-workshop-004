<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 2026-09-23 : journal relay, starts at login and restarts if it dies. Install: relay/install.sh -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zenray.journal-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress/relay/journal-relay.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>StandardOutPath</key>
  <string>/Users/zenray/Library/Logs/zenray-journal-relay.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zenray/Library/Logs/zenray-journal-relay.log</string>
</dict>
</plist>
