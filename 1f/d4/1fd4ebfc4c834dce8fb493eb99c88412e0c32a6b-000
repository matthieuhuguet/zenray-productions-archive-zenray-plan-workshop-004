// LOT IMAGES — prefetch plein-format via la file priorisée bornée.
//
// EN CLAIR POUR TOUS : une fois les petites vignettes posées, on tire tranquillement les VRAIES
// images pleines en tâche de fond (sans noyer le réseau), pour que l'aperçu plein écran (touche
// Espace) ou le défilement gauche/droite soient INSTANTANÉS. La 1re image passe en priorité.
//
// TECHNIQUE : on délègue à imageQueue (concurrence 6, annulable, dédoublonné par le cache LRU).
// On ne réinvente pas de boucle : la file gère déjà priorité, idle, abort.

import { imageQueue } from './imageQueue.js'

// Précharge en priorité une image pleine précise (au survol d'une tuile, ou à l'ouverture du
// Quick Look). Idempotent : le cache LRU ignore une URL déjà chargée.
export function prefetchOne(url, { priority = true, signal } = {}) {
  if (url) imageQueue.enqueue(url, { priority, signal })
}

// Précharge en fond une liste d'URLs pleines (1re en priorité haute, le reste en normal).
export function prefetchMany(urls, { signal } = {}) {
  imageQueue.enqueueMany(urls, { signal, firstHighPriority: true })
}
