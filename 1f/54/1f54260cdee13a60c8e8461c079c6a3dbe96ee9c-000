// 14 October 2026, 11:25 CEST: confirmed writes only; corrupt or missing state never means success.
export function createStudyClient(fetchImpl = fetch) {
  async function request(body) {
    const response = await fetchImpl('/api/japanese', body ? { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) } : { cache: 'no-store' })
    const result = await response.json()
    if (!response.ok || result.error) throw new Error(result.error || `Memory indisponible (${response.status}).`)
    if (result.state?.schemaVersion !== 1 || !result.state.progress || !Array.isArray(result.state.eventIds) || !Array.isArray(result.state.gaps)) throw new Error('État des révisions illisible, aucune écriture autorisée.')
    return result
  }
  return { load: () => request(), save: event => request(event) }
}
