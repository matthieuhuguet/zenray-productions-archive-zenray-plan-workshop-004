import React from 'react'

// Vite names lazy chunks with a content hash. An already-open tab can therefore
// reference a chunk that disappeared after a Vercel redeploy. Retry once for a
// transient network failure, then reload the no-cache index exactly once so the
// tab receives the current asset graph instead of crashing the whole view.
export function lazyRetry(factory) {
  // MÉMOIRE DU MORCEAU. `factory()` est un `import()` dynamique : le navigateur dédoublonne déjà les
  // appels répétés, mais on garde quand même la promesse pour que `precharger()` soit gratuit à
  // appeler cent fois (survol d'une liste, par exemple) sans allouer cent fermetures.
  let enVol = null

  const Composant = React.lazy(() => factory().catch(async (firstError) => {
    try {
      await new Promise((resolve) => setTimeout(resolve, 600))
      return await factory()
    } catch {
      if (typeof window !== 'undefined') {
        const message = firstError && firstError.message ? firstError.message : 'unknown-chunk'
        const key = `zr:chunkReloaded:${message.slice(0, 160)}`
        try {
          const lastReload = Number(window.sessionStorage.getItem(key)) || 0
          // A short TTL prevents an immediate reload loop if the fresh page is
          // genuinely broken, while still allowing the same Safari-style
          // generic error message to recover after a future deployment.
          if (Date.now() - lastReload > 30_000) {
            window.sessionStorage.setItem(key, String(Date.now()))
            window.location.reload()
            return new Promise(() => {})
          }
        } catch {
          // sessionStorage can be unavailable in strict privacy modes. In that
          // case the error boundary remains the safe, non-looping fallback.
        }
      }
      throw firstError
    }
  }))

  // ═══ PRÉCHARGER EST UNE PROPRIÉTÉ DE LA DÉFINITION, JAMAIS UNE SECONDE MÉCANIQUE ════════════════
  //
  // POURQUOI ICI ET NULLE PART AILLEURS. Un morceau paresseux ne se télécharge qu'au moment où on en
  // a besoin, ce qui est le bon défaut : le premier chargement de l'app reste léger. Mais pour un
  // morceau LOURD, ce moment est aussi le pire — l'utilisateur vient de cliquer, il attend, et il ne
  // voit rien. `RefBoardHost` pèse 1 415 Ko à lui seul (tout tldraw), ce qui fait deux secondes de
  // rectangle muet à chaque ouverture de board, signalé par Matthieu le 2026-08-30.
  //
  // La parade est de tirer le morceau PENDANT que l'utilisateur regarde autre chose : la liste des
  // boards, le survol d'une ligne. Quand il clique, l'octet est déjà là.
  //
  // Écrire cette mécanique dans le composant du board aurait fabriqué une seconde vérité : le
  // prochain morceau lourd l'aurait recopiée, et les deux auraient divergé. Elle vit donc dans la
  // DÉFINITION, si bien que tout `lazyRetry(...)` du projet en hérite sans une ligne de plus.
  //
  // `requestIdleCallback` cède le pas à ce que fait le navigateur : le préchargement ne vole jamais
  // une image d'animation à un défilement en cours. Le repli `setTimeout` couvre Safari, qui ne
  // l'implémente toujours pas.
  Composant.precharger = () => {
    if (enVol) return enVol
    const tirer = () => { enVol = factory().catch(() => { enVol = null }) }
    if (typeof requestIdleCallback === 'function') requestIdleCallback(tirer, { timeout: 2000 })
    else setTimeout(tirer, 200)
    return enVol
  }

  return Composant
}
