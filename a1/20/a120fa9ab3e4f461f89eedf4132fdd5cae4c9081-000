import { describe, it, expect } from 'vitest'
import { summarizeUploadTiming, formatDuration, formatUploadMessage, UPLOAD_TIMING } from './upload-timing.mjs'

const MiB = 1048576
const row = (at, bytes, durationMs, extra = {}) => ({ at, type: 'attempt', ok: true, bytes, durationMs, waitMs: 1, level: 20, ...extra })

describe('upload timing', () => {
  it('computes throughput, wall time, idle share and gain over the baseline', () => {
    const rows = [row('2026-10-13T22:35:56.000Z', 1900 * MiB, 180000), row('2026-10-13T22:36:03.700Z', 57 * MiB, 7300)]
    const s = summarizeUploadTiming(rows, { totalBytes: 3800 * MiB })
    expect(s.pushes).toBe(2)
    expect(s.bytes).toBe(1957 * MiB)
    expect(s.transferSeconds).toBeCloseTo(187.3, 1)
    expect(s.throughputMBps).toBeGreaterThan(10.9)
    expect(s.wallSeconds).toBeCloseTo(187.7, 1)
    expect(s.progress).toBeCloseTo(1957 / 3800, 3)
    expect(s.gainVsBaselinePercent).toBeGreaterThan(70)
  })
  it('counts failures and leaves them out of the throughput (red control)', () => {
    const s = summarizeUploadTiming([row('2026-10-13T22:00:10.000Z', 100 * MiB, 10000), { at: '2026-10-13T22:00:20.000Z', type: 'attempt', ok: false, bytes: 1900 * MiB, durationMs: 60000 }])
    expect(s.failures).toBe(1)
    expect(s.bytes).toBe(100 * MiB)
  })
  it('is zero on no data instead of NaN', () => {
    const s = summarizeUploadTiming([])
    expect(s.throughputMBps).toBe(0)
    expect(s.wallSeconds).toBe(0)
    expect(s.progress).toBeNull()
  })
  it('formats durations and the message', () => {
    expect(formatDuration(45)).toBe('45 s')
    expect(formatDuration(372)).toBe('6 min 12 s')
    expect(formatDuration(3720)).toBe('1 h 02 min')
    expect(() => formatDuration(Number.NaN)).toThrow(/seconds/)
    const s = summarizeUploadTiming([row('2026-10-13T22:35:56.000Z', 1900 * MiB, 180000)])
    expect(formatUploadMessage('Bleach S17E25', s, { done: true })).toMatch(/^Bleach S17E25 envoyé en 3 min 00 s, 1900 Mio à 11,1 Mo\/s \(\+7\d % contre 6,2 Mo\/s avant\)$/)
    expect(UPLOAD_TIMING.baselineMBps).toBe(6.2)
  })
})
