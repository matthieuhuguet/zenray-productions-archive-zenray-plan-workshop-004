// 12 October 2026: one refusal lands on its exact listing, whole, dated, and nothing else in the store moves.
import { describe, expect, it } from 'vitest'
import { applyEmail, parseArgs } from './RecordEmail.mjs'

const REFUSAL = `Hello Matthieu,

Thank you for taking the time to apply to Tech Artist - Portfolio team's position and for your interest in joining our team.

After carefully reviewing your application, we've decided not to move forward with your profile at this time. ${'More words. '.repeat(70)}

Best regards,
Voodoo`

const store = () => ({
  v: 2,
  studios: [
    { id: 'job_a', name: 'Voodoo', role: 'Technical Artist (AI), Portfolio Games Team, Freelance', status: 'contacted', contactedAt: '2026-10-06', messages: [{ at: '2026-10-06', channel: 'mail', text: 'sent' }], history: [{ at: '2026-10-06', from: 'to_contact', to: 'contacted', note: 'premier message' }], notes: '', engine: { language: 'en' } },
    { id: 'job_b', name: 'Voodoo', role: 'Level Designer', status: 'to_contact', messages: [], history: [], notes: '' },
  ],
})

describe('RecordEmail', () => {
  it('records the whole refusal on the chosen listing and declines only that one', () => {
    const { store: next, result } = applyEmail(store(), 'job_a', { from: 'Voodoo', subject: '', date: '2026-10-12', body: REFUSAL }, '2026-10-12')
    expect(result).toMatchObject({ studioId: 'job_a', intent: 'declined', status: 'declined', before: 'contacted' })
    const a = next.studios[0]
    expect(a.status).toBe('declined')
    expect(a.history.at(-1)).toMatchObject({ at: '2026-10-12', from: 'contacted', to: 'declined' })
    expect(a.messages).toHaveLength(2)
    const received = a.messages.at(-1)
    expect(received.at).toBe('2026-10-12')
    expect(received.text.startsWith('[Réponse e-mail de Voodoo]')).toBe(true)
    expect(received.text).toContain('Best regards,\nVoodoo')
    expect(received.text.length).toBeGreaterThan(700)
    expect(next.studios[1]).toEqual(store().studios[1])
  })

  it('refuses an unknown id, and an automatic acknowledgment is not recorded as a reply', () => {
    expect(() => applyEmail(store(), 'job_zzz', { from: 'Voodoo', date: '2026-10-12', body: REFUSAL }, '2026-10-12')).toThrow(/No studio with id job_zzz/)
    const ack = { from: 'no-reply@ashbyhq.com', subject: 'We received your application', date: '2026-10-12', body: 'Thank you for applying.' }
    expect(() => applyEmail(store(), 'job_a', ack, '2026-10-12')).toThrow(/auto_acknowledgment/)
  })

  it('reads --key value pairs and --flags and rejects a loose word', () => {
    expect(parseArgs(['--studio', 'job_a', '--dry', '--date', '2026-10-12'])).toEqual({ studio: 'job_a', dry: true, date: '2026-10-12' })
    expect(() => parseArgs(['job_a'])).toThrow(/Unexpected argument/)
  })
})
