const coverUrl = (value) => !value ? '' : (/^(https?:|data:|blob:|\/)/.test(value) ? value : `/api/img?path=${encodeURIComponent(value)}`)
const fmt = (seconds) => {
  const value = Number(seconds) || 0
  return `${Math.floor(value / 60)}:${String(Math.floor(value % 60)).padStart(2, '0')}`
}
const trackId = (track) => track?.manifestPath || track?.streamPath || track?.uri || track?.videoId || track?.title || ''

// État "fermable en fondu" (retour Matthieu 2026-07-20 : "le widget devrait disparaître avec une
// élimination de fade out... pareil quand je clique à côté") : hide() garde la valeur montée 350ms avec
// closing=true (le CSS .zra-closing joue zra-pop-out), puis démonte. show() annule toute fermeture en
// vol -- rouvrir pendant le fondu de sortie ne laisse jamais un timer périmé démonter le menu frais.
function useFading(ms = 350) {
  const [value, setValue] = useState(null)
  const [closing, setClosing] = useState(false)
  const timer = useRef(null)
  useEffect(() => () => clearTimeout(timer.current), [])
  const show = (v) => { clearTimeout(timer.current); setClosing(false); setValue(v) }
  const hide = () => {
    setClosing(true)
    clearTimeout(timer.current)
    timer.current = setTimeout(() => { setValue(null); setClosing(false) }, ms)
  }
  return [value, closing, show, hide]
}

