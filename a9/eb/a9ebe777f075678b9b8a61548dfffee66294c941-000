// 3 October 2026, 12:46 : Posts: composer (draft, schedule, publish now) and the full list with per-target status, retry, delete, unpublish
// and the manual last step of handoff targets. Limits per platform come from the connector rules, so the counter is never a guess. (3 October 2026)
import React, { useMemo, useState } from 'react'
import { useAction, useQuery } from './usePostKit.js'
import { qs } from './postkitClient.js'
import { Badge, Btn, Card, Empty, ErrorLine, Field, PlatformDot, StatusBadge, when } from './ui.jsx'
import { HandoffCard } from './OverviewPanel.jsx'

const FILTERS = ['all', 'draft', 'scheduled', 'published', 'partial', 'failed', 'awaiting_manual']
const localTz = () => { try { return Intl.DateTimeFormat().resolvedOptions().timeZone } catch { return 'UTC' } }

function Composer({ client, overview, reload, onCreated }) {
  const { accounts, profiles, platforms } = overview.data
  const [profileId, setProfileId] = useState(profiles[0]?.id || '')
  const [picked, setPicked] = useState({})
  const [content, setContent] = useState('')
  const [title, setTitle] = useState('')
  const [media, setMedia] = useState('')
  const [when_, setWhen] = useState('')
  const [tz, setTz] = useState(localTz())
  const [opts, setOpts] = useState({ asStory: false, privacy: '', software: '', category: '', subtitle: '' })
  const act = useAction(async () => { await reload(); onCreated?.() })
  const usable = accounts.filter((a) => a.profileId === profileId && a.status === 'CONNECTED' && a.capabilities?.publish)
  const selected = usable.filter((a) => picked[a.id])
  const rules = (a) => platforms.find((p) => p.platform === a.platform)?.rules || {}
  const limit = selected.length ? Math.min(...selected.map((a) => rules(a).maxChars || Infinity)) : null
  const needsTitle = selected.some((a) => rules(a).titleRequired)
  const set = (k) => (e) => setOpts({ ...opts, [k]: e.target.type === 'checkbox' ? e.target.checked : e.target.value })

  function body(mode) {
    const urls = media.split('\n').map((s) => s.trim()).filter(Boolean)
    const b = { profileId, content, accountIds: selected.map((a) => a.id), ...(title ? { title } : {}), ...(urls.length ? { mediaItems: urls.map((url) => ({ url })) } : {}) }
    if (opts.asStory) b.asStory = true
    if (opts.privacy) b.privacy = opts.privacy
    if (selected.some((a) => a.platform === 'artstation')) b.artstation = { software: opts.software.split(',').map((s) => s.trim()).filter(Boolean), category: opts.category || undefined }
    if (selected.some((a) => a.platform === 'website')) b.website = { subtitle: opts.subtitle || undefined }
    if (mode === 'publish') b.publishNow = true
    if (mode === 'schedule') { b.scheduledFor = when_; b.timezone = tz }
    return b
  }
  async function upload(e) {
    const file = e.target.files[0]; if (!file) return
    await act.run(async () => { const j = await client.upload(file); setMedia((m) => (m ? `${m}\n` : '') + j.url) })
  }
  const go = (mode) => act.run(() => { if (!selected.length) throw new Error('Pick at least one account.'); return client.post('/v1/posts', body(mode)) })

  if (!profiles.length) return <Card title="Compose"><Empty>Add an account first (Accounts tab).</Empty></Card>
  return (
    <Card title="Compose" aside={limit && Number.isFinite(limit) ? <Badge tone={content.length > limit ? 'bad' : 'muted'}>{content.length} / {limit}</Badge> : null}>
      <div className="zr-pk-grid2">
        <Field label="Profile"><select value={profileId} onChange={(e) => { setProfileId(e.target.value); setPicked({}) }}>{profiles.map((p) => <option key={p.id} value={p.id}>{p.name}</option>)}</select></Field>
        <div className="zr-pk-chips" aria-label="Targets">{usable.length === 0 ? <span className="zr-pk-meta">No publishing account in this profile.</span> : usable.map((a) => <label key={a.id} className={`zr-pk-pick${picked[a.id] ? ' is-on' : ''}`}><input type="checkbox" checked={!!picked[a.id]} onChange={(e) => setPicked({ ...picked, [a.id]: e.target.checked })} /><PlatformDot platform={a.platform} label={a.username} /></label>)}</div>
      </div>
      {needsTitle && <Field label="Title"><input value={title} onChange={(e) => setTitle(e.target.value)} placeholder="Required by YouTube, ArtStation and the website" /></Field>}
      <Field label="Text"><textarea rows={5} value={content} onChange={(e) => setContent(e.target.value)} placeholder="What do you want to say?" /></Field>
      <Field label="Media URLs, one per line" hint="Platforms fetch these from the URL. Or upload a file to PostKit."><textarea rows={2} value={media} onChange={(e) => setMedia(e.target.value)} /></Field>
      <div className="zr-pk-inline"><input type="file" onChange={upload} aria-label="Upload a file" /></div>
      <details className="zr-pk-details"><summary>Options</summary>
        <div className="zr-pk-grid3">
          <label className="zr-pk-check"><input type="checkbox" checked={opts.asStory} onChange={set('asStory')} /> Story (Instagram, Facebook)</label>
          <Field label="Privacy (YouTube, TikTok)"><select value={opts.privacy} onChange={set('privacy')}><option value="">default</option><option value="public">public</option><option value="unlisted">unlisted</option><option value="private">private</option></select></Field>
          {selected.some((a) => a.platform === 'artstation') && <><Field label="ArtStation software"><input value={opts.software} onChange={set('software')} placeholder="Houdini, Unreal Engine" /></Field><Field label="ArtStation category"><input value={opts.category} onChange={set('category')} /></Field></>}
          {selected.some((a) => a.platform === 'website') && <Field label="Website subtitle"><input value={opts.subtitle} onChange={set('subtitle')} /></Field>}
        </div>
      </details>
      <div className="zr-pk-inline">
        <input type="datetime-local" value={when_} onChange={(e) => setWhen(e.target.value)} aria-label="Schedule at" /><input value={tz} onChange={(e) => setTz(e.target.value)} aria-label="Timezone" className="zr-pk-narrow" />
        <Btn busy={act.busy} disabled={!when_} onClick={() => go('schedule')}>Schedule</Btn>
        <Btn busy={act.busy} onClick={() => go('draft')}>Save draft</Btn>
        <Btn tone="primary" busy={act.busy} onClick={() => go('publish')} title="Public and immediate">Publish now</Btn>
      </div>
      <ErrorLine error={act.error} />
    </Card>
  )
}

function PostCard({ post, client, reload }) {
  const act = useAction(reload)
  const unpublishable = post.targets.some((t) => t.status === 'published')
  return (
    <li className="zr-pk-li">
      <div className="zr-pk-row"><StatusBadge status={post.status} /><strong className="zr-pk-excerpt">{post.title || post.content || '(no text)'}</strong><span className="zr-pk-when">{post.scheduledFor ? `scheduled ${when(post.scheduledFor)}` : when(post.createdAt)}</span></div>
      {post.title && post.content && <p className="zr-pk-meta">{post.content.slice(0, 220)}</p>}
      <div className="zr-pk-chips">{post.targets.map((t) => <span key={t.accountId} className="zr-pk-chip"><PlatformDot platform={t.platform} /><StatusBadge status={t.status} />{t.platformPostUrl && <a className="zr-pk-link" href={t.platformPostUrl} target="_blank" rel="noreferrer">open</a>}{t.error && <span className="zr-pk-bad">{t.error.slice(0, 120)}</span>}</span>)}</div>
      {post.targets.filter((t) => t.status === 'awaiting_manual').map((t) => <HandoffCard key={t.accountId} post={post} target={t} client={client} onDone={reload} />)}
      <div className="zr-pk-inline">
        {['draft', 'scheduled', 'failed', 'partial'].includes(post.status) && <Btn busy={act.busy} onClick={() => act.run(() => client.post(`/v1/posts/${post.id}/publish`))}>Publish now</Btn>}
        {unpublishable && <Btn tone="danger" busy={act.busy} onClick={() => confirm('Take this post back off the platforms that allow it?') && act.run(() => client.post(`/v1/posts/${post.id}/unpublish`))}>Unpublish</Btn>}
        <Btn tone="danger" busy={act.busy} onClick={() => confirm('Delete on PostKit (it does not unpublish anything already live)?') && act.run(() => client.del(`/v1/posts/${post.id}`))}>Delete</Btn>
      </div>
      <ErrorLine error={act.error} />
    </li>
  )
}

export default function PostsPanel({ client, overview, reload }) {
  const [filter, setFilter] = useState('all')
  const list = useQuery(client, `/v1/posts${qs({ status: filter === 'all' ? '' : filter, limit: 50 })}`)
  const refresh = async () => { await reload(); await list.reload() }
  return (
    <>
      <Composer client={client} overview={overview} reload={reload} onCreated={list.reload} />
      <Card title="All posts" aside={<div className="zr-pk-chips">{FILTERS.map((f) => <button key={f} className={`zr-pk-tab${filter === f ? ' is-on' : ''}`} onClick={() => setFilter(f)}>{f.replace('_', ' ')}</button>)}</div>}>
        <ErrorLine error={list.error} />
        {list.data?.posts?.length ? <ul className="zr-pk-list">{list.data.posts.map((p) => <PostCard key={p.id} post={p} client={client} reload={refresh} />)}</ul> : <Empty>{list.loading ? 'Loading…' : 'No post here.'}</Empty>}
      </Card>
    </>
  )
}
