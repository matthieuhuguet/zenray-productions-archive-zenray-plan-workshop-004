// SettingsMenu.jsx — RÉGLAGES GLOBAUX regroupés sous UN engrenage dans l'en-tête de la sidebar
// (2026-07-21, demande Matthieu). Remplace l'ancien cluster fixe en haut à droite (#zr-topcluster) :
// langue + œil (visibilité) + thème clair/sombre y vivaient séparément ; ils sont désormais ENFANTS d'un
// seul menu (hiérarchie parent -> enfant, façon rig). Le bouton de REPLI de la sidebar y est intégré aussi
// (4 entrées), toujours atteignable au clavier (Tab). Contenu APLATI (pas de popover-dans-popover) : on
// réutilise les primitives (Pop, GOLD, HIDEABLES, useUiPref, useLang) mais on rend les contrôles en lignes.
import React from 'react'
import Icon from './Icon.jsx'
import { Pop, GOLD, HIDEABLES, useUiPref } from '../lib/uiPrefs.jsx'
import { useLang, SUPPORTED_LANGS } from '../i18n/useT.js'

const SANS = "var(--zr-police-sans)"
const SHORT = { fr: 'FR', en: 'EN', ja: 'JP' }

// En-tête de section (petit label mono gris), même grammaire visuelle que EyeMenu.
function SectionLabel({ t, children }) {
  return <div style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-2xs)', letterSpacing: 0.4, color: t.textSecondary, padding: `0 ${GOLD.s1}px`, marginTop: GOLD.s1 }}>{children}</div>
}

// Interrupteur iOS miniature (état persisté localStorage via uiPrefs). Repris de LanguageSwitcher.EyeMenu.
function Toggle({ t, id }) {
  const [on, setOn] = useUiPref(id, true)
  return (
    <button onClick={() => setOn(!on)} title={on ? 'Cacher' : 'Afficher'}
      style={{ width: 34, height: 20, borderRadius: 999, border: 'none', cursor: 'pointer', padding: 2, background: on ? '#30a46c' : (t.border || 'rgba(0,0,0,0.18)'), transition: 'background .18s', display: 'inline-flex', flexShrink: 0 }}>
      <span style={{ width: 16, height: 16, borderRadius: 999, background: '#fff', transform: on ? 'translateX(14px)' : 'translateX(0)', transition: 'transform .18s', boxShadow: '0 1px 2px rgba(0,0,0,0.25)' }} />
    </button>
  )
}

// Ligne d'action générique (libellé à gauche, contrôle à droite).
function Row({ t, children }) {
  return <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: GOLD.s2, padding: `${GOLD.s1 - 2}px ${GOLD.s1}px`, borderRadius: GOLD.s1, fontFamily: SANS, fontSize: 'var(--zr-ui-md)', color: t.textPrimary }}>{children}</div>
}

export default function SettingsMenu({ t, theme, setTheme, onCollapse, floating }) {
  const [lang, setLang] = useLang()
  const dark = theme === 'dark'
  return (
    <Pop t={t} align="left" width={244} title="Réglages" trigger={<Icon name="gear" size={18} weight={1.8} color="currentColor" />}>
      {(close) => (
        <div style={{ display: 'flex', flexDirection: 'column', gap: GOLD.s1 - 4 }}>
          {/* 1. BARRE LATÉRALE — l'ancienne fonction du bouton de repli, déplacée ici (Tab-accessible). */}
          <SectionLabel t={t}>BARRE LATÉRALE</SectionLabel>
          <Row t={t}>
            <span>{floating ? 'Ancrer la barre latérale' : 'Replier la barre latérale'}</span>
            <button onClick={() => { onCollapse && onCollapse(); close() }} title={floating ? 'Ancrer' : 'Replier'} className="zr-tap"
              style={{ display: 'inline-flex', alignItems: 'center', justifyContent: 'center', width: 30, height: 26, borderRadius: GOLD.s1, border: `1px solid ${t.border}`, background: 'transparent', color: t.textSecondary, cursor: 'pointer' }}>
              <Icon name="sidebar.left" size={16} />
            </button>
          </Row>

          {/* 2. LANGUE — segmenté iOS 3 colonnes (aplati depuis LanguageSwitcher). */}
          <SectionLabel t={t}>LANGUE</SectionLabel>
          <div style={{ display: 'grid', gridTemplateColumns: 'repeat(3, 1fr)', gap: GOLD.s1, padding: `0 ${GOLD.s1}px` }}>
            {SUPPORTED_LANGS.map((l) => {
              const on = lang === l
              return (
                <button key={l} onClick={() => setLang(l)}
                  style={{ fontFamily: SANS, fontSize: 'var(--zr-ui-xs)', fontWeight: 600, letterSpacing: 0.3, padding: `${GOLD.s1}px 0`, textAlign: 'center', borderRadius: GOLD.s1, border: 'none', cursor: 'pointer', transition: 'background .15s, color .15s',
                    background: on ? (t.textPrimary || '#111') : 'transparent', color: on ? (t.cardBg || '#fff') : (t.textPrimary || '#111') }}>
                  {SHORT[l] || l}
                </button>
              )
            })}
          </div>

          {/* 3. INTERFACE — visibilité persistée (aplati depuis EyeMenu). Point de restauration des éléments cachés. */}
          <SectionLabel t={t}>INTERFACE</SectionLabel>
          {HIDEABLES.map((h) => (
            <Row t={t} key={h.id}>
              <span style={{ minWidth: 0, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{h.label}</span>
              <Toggle t={t} id={h.id} />
            </Row>
          ))}

          {/* 4. THÈME — toggle clair/sombre (déplacé du cluster haut-droite). */}
          <SectionLabel t={t}>THÈME</SectionLabel>
          <Row t={t}>
            <span>{dark ? 'Sombre' : 'Clair'}</span>
            <button onClick={() => setTheme(dark ? 'light' : 'dark')} title={dark ? 'Passer en clair' : 'Passer en sombre'} className="zr-tap"
              style={{ display: 'inline-flex', alignItems: 'center', justifyContent: 'center', width: 30, height: 26, borderRadius: GOLD.s1, border: `1px solid ${t.border}`, background: 'transparent', color: t.textSecondary, cursor: 'pointer' }}>
              <Icon name={dark ? 'sun.max' : 'moon'} size={16} weight={1.8} />
            </button>
          </Row>
        </div>
      )}
    </Pop>
  )
}
