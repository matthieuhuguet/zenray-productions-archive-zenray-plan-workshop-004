# 14 October 2026: RestructureCloud moves everything under <base>/<Category>, merges duplicated work folders, rewrites references,
# keeps both files on a collision, and its validator is RED when a stream reference is broken.
# FR : le rangement deplace, fusionne, reecrit les references, garde les deux fichiers en collision ; le validateur est rouge si une reference casse.
import json, os, sys, tempfile
from pathlib import Path
HERE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HERE))
import RestructureCloud as rc
import WorkCategories as wc

table = wc.load_table()
tmp = Path(tempfile.mkdtemp())
legacy = tmp / table['legacyBase']

def put(rel, content):
    path = legacy / rel
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content if isinstance(content, str) else json.dumps(content), encoding='utf-8')

L = table['legacyBase']
stream = f'{L}/Bleach/Saison 17/.streams/Bleach_S17E41-aaaa'
put('Bleach/Saison 17/Bleach S17E41.mkv.media.json', {'master': f'{stream}/master.m3u8', 'mpd': f'{stream}/manifest.mpd'})
put('Bleach/Saison 17/.streams/Bleach_S17E41-aaaa/master.m3u8',
    '#EXTM3U\n/api/hls?path=' + 'pages%2FAnime_Movies_Series%2FBleach%2FSaison%2017%2F.streams%2FBleach_S17E41-aaaa%2Fmedia_0.m3u8\n')
put('Bleach/Saison 17/.streams/Bleach_S17E41-aaaa/media_0.m3u8', '#EXTM3U\n')
put('Bleach/Saison 17/.streams/Bleach_S17E41-aaaa/manifest.mpd', '<MPD/>')
put('Anime/Bleach/S17/Bleach S17E41.mkv.media.json', {'poster': 'https://cdn.example/p.jpg'})   # collides, archive only
put('Anime/Bleach/S17/Bleach S17E50.mkv.media.json', {'poster': 'x'})
put('Black Panther.mkv.media.json', {'poster': 'y'})
put('Some Unknown Show S01E01.mkv.media.json', {'poster': 'z'})
put('.zrfolder.json', {'folder': True})

job = rc.Restructure(tmp, table)
job.scan(); moves = job.plan()
base = table['base']
assert moves['Bleach/Saison 17/Bleach S17E41.mkv.media.json'] == 'Anime/Bleach/Saison 17/Bleach S17E41.mkv.media.json'   # streaming wins the plain name
assert moves['Anime/Bleach/S17/Bleach S17E41.mkv.media.json'] == 'Anime/Bleach/Saison 17/Bleach S17E41 (2).mkv.media.json'
assert moves['Anime/Bleach/S17/Bleach S17E50.mkv.media.json'] == 'Anime/Bleach/Saison 17/Bleach S17E50.mkv.media.json'
assert moves['Black Panther.mkv.media.json'] == 'Movies/Black Panther.mkv.media.json'
assert moves['Some Unknown Show S01E01.mkv.media.json'] == 'Some Unknown Show S01E01.mkv.media.json'  # unknown stays at root, flagged
assert any('unknown work kept at root' in f for f in job.flags)
assert len(set(moves.values())) == len(moves)

job.apply()
after = rc.validate(tmp, base)
assert after['manifests'] == 5 and not after['badJson'] and not after['missingStreams'], after
moved = json.loads((tmp / base / 'Anime/Bleach/Saison 17/Bleach S17E41.mkv.media.json').read_text())
assert moved['master'] == f'{base}/Anime/Bleach/Saison 17/.streams/Bleach_S17E41-aaaa/master.m3u8'
playlist = (tmp / base / 'Anime/Bleach/Saison 17/.streams/Bleach_S17E41-aaaa/master.m3u8').read_text()
assert 'pages%2FAnime_Movies_Series_Documentaries%2FAnime%2FBleach%2FSaison%2017%2F' in playlist and 'Anime_Movies_Series%2F' not in playlist
assert not legacy.exists()  # nothing left behind

# RED case: a broken stream reference must be reported, not hidden
(tmp / base / 'Anime/Bleach/Saison 17/.streams/Bleach_S17E41-aaaa/manifest.mpd').unlink()
broken = rc.validate(tmp, base)
assert len(broken['missingStreams']) == 1, broken
print('restructure tests OK')
