import { describe, it, expect } from 'vitest'
import { posterCandidates, edgePosterUrl } from './posterFallback.js'
import handler, { parseShelfPosterUrl } from '../../server/shelf-poster.js'

const CDN = 'https://cdn.jsdelivr.net/gh/matthieuhuguet/zenray-shelf-img@359f121dc3b2decc9b0e9aa173aa9d42bda87bca/god-of-war-ragnarok-b5aa.jpg'
const RAW = 'https://raw.githubusercontent.com/matthieuhuguet/zenray-shelf-img/359f121dc3b2decc9b0e9aa173aa9d42bda87bca/god-of-war-ragnarok-b5aa.jpg'

describe('shelf poster origins', () => {
  it('edge route first, jsDelivr second', () => {
    expect(posterCandidates(CDN)).toEqual([`/api/shelf-poster?u=${encodeURIComponent(CDN)}`, CDN])
  })
  it('other urls keep a single origin, null stays null', () => {
    expect(posterCandidates('https://image.tmdb.org/t/p/w500/a.jpg')).toEqual(['https://image.tmdb.org/t/p/w500/a.jpg', null])
    expect(posterCandidates('/api/img?path=x')).toEqual(['/api/img?path=x', null])
    expect(posterCandidates(null)).toEqual([null, null])
    expect(edgePosterUrl('https://example.com/a.jpg')).toBe(null)
  })
})

describe('parseShelfPosterUrl is not an open proxy', () => {
  it('accepts a pinned poster of the shelf repo and maps it to raw', () => {
    expect(parseShelfPosterUrl(CDN)).toEqual({ raw: RAW, mime: 'image/jpeg' })
  })
  it('accepts one posters/ sub folder level', () => {
    const u = CDN.replace('/god-of-war', '/posters/god-of-war')
    expect(parseShelfPosterUrl(u).raw).toBe(RAW.replace('/god-of-war', '/posters/god-of-war'))
    expect(parseShelfPosterUrl(CDN.replace('/god-of-war', '/a/b/god-of-war'))).toBe(null)
  })
  it('refuses other owners, other repos, branches, paths, queries and non images', () => {
    const bad = [
      CDN.replace('matthieuhuguet', 'someone'),
      CDN.replace('zenray-shelf-img', 'zenray-data'),
      CDN.replace('@359f121dc3b2decc9b0e9aa173aa9d42bda87bca', '@main'),
      CDN.replace('/god-of-war', '/a/../god-of-war'),
      CDN + '?x=1',
      CDN.replace('.jpg', '.json'),
      'https://raw.githubusercontent.com/matthieuhuguet/zenray-shelf-img/359f121/a.jpg',
    ]
    for (const u of bad) expect(parseShelfPosterUrl(u), u).toBe(null)
  })
  it('handler answers 400 for a refused url without any network call', async () => {
    const out = { headers: {} }
    const res = { setHeader: (k, v) => { out.headers[k] = v }, status: (c) => { out.code = c; return res }, end: () => res }
    await handler({ method: 'GET', query: { u: 'https://example.com/a.jpg' } }, res)
    expect(out.code).toBe(400)
  })
})
