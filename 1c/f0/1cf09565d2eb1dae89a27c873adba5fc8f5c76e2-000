// subtitleParser.js : parser universel de sous-titres (SRT, WebVTT et fallback ASS).
// Produit des repères temporels (cues) avec début, fin et texte nettoyé pour rendu en police Inter (small).

export function parseTimestamp(str) {
  if (!str) return 0
  const clean = str.trim().replace(',', '.')
  const parts = clean.split(':')
  if (parts.length === 3) {
    const hours = parseFloat(parts[0]) || 0
    const minutes = parseFloat(parts[1]) || 0
    const seconds = parseFloat(parts[2]) || 0
    return hours * 3600 + minutes * 60 + seconds
  }
  if (parts.length === 2) {
    const minutes = parseFloat(parts[0]) || 0
    const seconds = parseFloat(parts[1]) || 0
    return minutes * 60 + seconds
  }
  return parseFloat(clean) || 0
}

export function cleanSubtitleText(text) {
  if (!text) return ''
  return text
    .replace(/<[^>]+>/g, '') // supprime balises HTML (<font>, <b>, <i>, etc.)
    .replace(/\{[^}]+\}/g, '') // supprime balises ASS ({\an8}, {\pos(..)}, etc.)
    .replace(/\r\n/g, '\n')
    .replace(/\r/g, '\n')
    // 14 October 2026: ASS escapes that survive in SRT/VTT text. \N is the hard line break, \n a soft one (a space, libass ignores it
    // outside wrap style 2), \h a no-break space. Left alone they print as "and\N Kuchiki" on screen.
    // FR : echappements ASS restes dans le texte ; \N = retour a la ligne, \n = espace, \h = espace insecable.
    .replace(/\\N/g, '\n')
    .replace(/\\n/g, ' ')
    .replace(/\\h/g, '\u00a0')
    .replace(/[ \t]*\n[ \t]*/g, '\n') // no space left at the edge of a line, the text is centred
    .trim()
}

export function parseSrt(srtContent) {
  if (!srtContent || typeof srtContent !== 'string') return []
  const normalized = srtContent.replace(/\r\n/g, '\n').replace(/\r/g, '\n').trim()
  const blocks = normalized.split(/\n\s*\n/)
  const cues = []

  for (const block of blocks) {
    const lines = block.trim().split('\n')
    if (lines.length < 2) continue
    // Ligne de timecode
    let timeIndex = 0
    if (!lines[0].includes('-->') && lines.length > 1 && lines[1].includes('-->')) {
      timeIndex = 1
    }
    const timeLine = lines[timeIndex]
    if (!timeLine || !timeLine.includes('-->')) continue

    const [startStr, endStr] = timeLine.split('-->').map((s) => s.trim().split(' ')[0])
    const start = parseTimestamp(startStr)
    const end = parseTimestamp(endStr)
    const textLines = lines.slice(timeIndex + 1).join('\n')
    const text = cleanSubtitleText(textLines)

    if (end > start && text) {
      cues.push({ id: cues.length + 1, start, end, text })
    }
  }

  return cues.sort((a, b) => a.start - b.start)
}

export function parseVtt(vttContent) {
  if (!vttContent || typeof vttContent !== 'string') return []
  const normalized = vttContent.replace(/^WEBVTT[^\n]*\n+/i, '').replace(/\r\n/g, '\n').replace(/\r/g, '\n').trim()
  return parseSrt(normalized)
}

export function parseAss(assContent) {
  if (!assContent || typeof assContent !== 'string') return []
  const lines = assContent.split(/\r?\n/)
  const cues = []

  for (const line of lines) {
    if (!line.startsWith('Dialogue:')) continue
    const parts = line.slice(9).split(',')
    if (parts.length < 10) continue
    const start = parseTimestamp(parts[1])
    const end = parseTimestamp(parts[2])
    const text = cleanSubtitleText(parts.slice(9).join(','))
    if (end > start && text) {
      cues.push({ id: cues.length + 1, start, end, text })
    }
  }

  return cues.sort((a, b) => a.start - b.start)
}

export function parseSubtitles(rawText, formatHint) {
  if (!rawText || typeof rawText !== 'string') return []
  const trimmed = rawText.trim()
  if (formatHint === 'ass' || formatHint === 'ssa' || trimmed.startsWith('[Script Info]') || trimmed.includes('[Events]')) {
    return parseAss(trimmed)
  }
  if (formatHint === 'vtt' || trimmed.startsWith('WEBVTT')) {
    return parseVtt(trimmed)
  }
  return parseSrt(trimmed)
}

export function findActiveCue(cues, currentTime) {
  if (!Array.isArray(cues) || cues.length === 0 || currentTime == null || currentTime < 0) return null
  // Recherche rapide du cue actif
  for (let i = 0; i < cues.length; i++) {
    const cue = cues[i]
    if (cue.start <= currentTime && currentTime <= cue.end) {
      return cue
    }
    if (cue.start > currentTime + 1) {
      // Les cues sont triés par start
      break
    }
  }
  return null
}

