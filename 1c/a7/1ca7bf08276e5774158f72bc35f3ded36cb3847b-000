// 4 October 2026: a file above 1 MiB comes back EMPTY from the contents API with a valid sha; it must be read through its blob, never as empty.
import { afterEach, describe, expect, it, vi } from 'vitest'
import { contentsText } from './page.js'

const b64 = (text) => Buffer.from(text, 'utf8').toString('base64')
afterEach(() => vi.unstubAllGlobals())

describe('contentsText', () => {
  it('decodes a normal contents answer without any further request', async () => {
    const fetch = vi.fn()
    vi.stubGlobal('fetch', fetch)
    expect(await contentsText('t', { content: b64('{"a":1}'), encoding: 'base64', sha: 's' })).toBe('{"a":1}')
    expect(fetch).not.toHaveBeenCalled()
  })

  it('reads the blob when the body is empty and the encoding is none, as GitHub answers above 1 MiB', async () => {
    const big = JSON.stringify({ studios: Array.from({ length: 5 }, (_, i) => ({ id: `s${i}`, notes: 'é'.repeat(50) })) })
    const fetch = vi.fn().mockResolvedValue({ ok: true, status: 200, json: async () => ({ content: b64(big), encoding: 'base64' }) })
    vi.stubGlobal('fetch', fetch)
    expect(await contentsText('t', { content: '', encoding: 'none', sha: 'abc123' })).toBe(big)
    expect(String(fetch.mock.calls[0][0])).toContain('/git/blobs/abc123')
  })

  it('raises instead of returning an empty body when the blob cannot be read, so nobody saves over a file that looked empty', async () => {
    vi.stubGlobal('fetch', vi.fn().mockResolvedValue({ ok: false, status: 502, json: async () => ({}) }))
    await expect(contentsText('t', { content: '', encoding: 'none', sha: 'abc' })).rejects.toThrow(/blob-502/)
    await expect(contentsText('t', { content: '', encoding: 'none' })).rejects.toThrow(/without-sha/)
  })
})
