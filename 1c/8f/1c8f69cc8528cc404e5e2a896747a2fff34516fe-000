/* 14 October 2026, 11:30 CEST: scoped parameters, inherited ZenRay fonts and light/dark tokens. */
.jps { --jps-base:17px; --jps-gap:1.25em; --jps-radius:22px; --jps-pink:#bc347a; --jps-purple:#7562be; --jps-green:#37826d; --jps-orange:#a7732f; --jps-panel:color-mix(in srgb,var(--g9-fg) 4%,var(--g9-bg)); --jps-line:color-mix(in srgb,var(--g9-fg) 14%,transparent); font-family:var(--zr-police-sans); font-weight:var(--zr-poids-sans,400); font-size:var(--jps-base); color:var(--g9-fg); padding:var(--jps-gap) 0; }
.jps *,.jps *::before,.jps *::after { box-sizing:border-box; }
.jps h2,.jps h3,.jps h4,.jps .jps-prompt,.jps .jps-card-title { font-family:var(--zr-police-serif); font-weight:var(--zr-poids-serif,350); }
.jps h2 { font-size:2em; margin:.3em 0; line-height:1.2; }
.jps h3 { font-size:1.5em; }
.jps p { line-height:1.7; }
.jps .jps-number,.jps strong { font-family:var(--zr-police-serif); font-weight:var(--zr-poids-nombres,400); }
.jps button,.jps input { font:inherit; color:inherit; border:1px solid var(--jps-line); border-radius:12px; background:var(--jps-panel); padding:.7em 1em; }
.jps button { cursor:pointer; }
.jps button:disabled { cursor:default; opacity:.5; }
.jps button:focus-visible,.jps input:focus-visible { outline:2px solid var(--jps-purple); outline-offset:3px; }
.jps a { color:inherit; text-underline-offset:4px; }
.jps-heading,.jps-lesson header { display:flex; align-items:center; justify-content:space-between; gap:var(--jps-gap); }
.jps-eyebrow { font-size:.85em; color:var(--g9-muted); }
.jps-actions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:var(--jps-gap); margin:1.6em 0 1em; }
.jps .jps-action { display:flex; flex-direction:column; align-items:start; text-align:left; gap:.7em; padding:1.5em; border:1px solid color-mix(in srgb,var(--jps-purple) 30%,var(--jps-line)); border-radius:var(--jps-radius); background:color-mix(in srgb,var(--jps-purple) 10%,var(--jps-panel)); }
.jps .jps-new { background:color-mix(in srgb,var(--jps-pink) 10%,var(--jps-panel)); border-color:color-mix(in srgb,var(--jps-pink) 30%,var(--jps-line)); }
.jps .jps-mastered { background:color-mix(in srgb,var(--jps-green) 9%,var(--jps-panel)); border-color:color-mix(in srgb,var(--jps-green) 30%,var(--jps-line)); }
.jps-action strong { font-size:3em; line-height:1; }
.jps-action small,.jps-honest { font-size:.8em; color:var(--g9-muted); }
.jps-tabs,.jps-levels,.jps-grade,.jps-stage-summary { display:flex; flex-wrap:wrap; gap:.7em; margin:1.5em 0; }
.jps button[aria-pressed=true] { border-color:var(--jps-purple); background:color-mix(in srgb,var(--jps-purple) 13%,var(--jps-panel)); }
.jps-filter,.jps-settings label,.jps-coverage label { display:flex; flex-direction:column; gap:.6em; margin:1em 0; }
.jps-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:.8em; margin:1.5em 0; }
.jps .jps-card { display:flex; flex-direction:column; gap:.8em; text-align:left; min-height:150px; padding:1.2em; border-radius:var(--jps-radius); border-top:3px solid var(--jps-pink); }
.jps-card-title { font-size:1.15em; line-height:1.5; }
.jps-card small { font-size:.75em; color:var(--g9-muted); }
.jps .jps-card[data-stage=locked],.jps .jps-card[data-stage=suspended] { border-top-color:var(--jps-line); }
.jps .jps-card[data-stage=orange] { border-top-color:var(--jps-orange); }
.jps .jps-card[data-stage=green],.jps .jps-card[data-stage=mastered] { border-top-color:var(--jps-green); }
.jps-stage-summary span { font-size:.85em; }
.jps-message,.jps-review,.jps-lesson,.jps-coverage,.jps-settings { padding:1.6em; border:1px solid var(--jps-line); border-radius:var(--jps-radius); background:var(--jps-panel); margin:1.5em 0; overflow-wrap:anywhere; }
.jps-review { max-width:900px; margin-inline:auto; text-align:center; }
.jps-prompt { font-size:2em; padding:1em 0; }
.jps-answer { padding:1em; border-radius:var(--jps-radius); background:color-mix(in srgb,var(--jps-purple) 8%,var(--jps-panel)); }
.jps-answer p[lang=ja] { font-size:1.5em; }
.jps-review .jps-grade { justify-content:center; }
.jps table { width:100%; table-layout:fixed; border-collapse:collapse; margin:1.5em 0; font-family:var(--zr-police-serif); }
.jps th,.jps td { padding:1em; text-align:left; border-bottom:1px solid var(--jps-line); vertical-align:top; font-weight:var(--zr-poids-serif,350); }
.jps td p { margin:.5em 0 0; }
.jps details { padding:.7em 0; }
.jps summary { cursor:pointer; }
.jps-settings { max-width:750px; }
@media(max-width:700px) { .jps-heading { flex-direction:column; align-items:start; } .jps-actions { grid-template-columns:1fr; } .jps .jps-action { padding:1em; } .jps-action strong { font-size:2em; } .jps h2 { font-size:1.6em; } .jps-grid { grid-template-columns:1fr; } .jps-lesson,.jps-coverage,.jps-review { padding:1em; } .jps-prompt { font-size:1.5em; } .jps th,.jps td { padding:.6em; } }

/* 16 October 2026 14:35 Europe/Paris: a bounded editor using the existing study typography and spacing. */
.jps-notebook { display: grid; gap: 16px; min-width: 0; }
.jps-notebook form,.jps-notebook label { display: grid; gap: 8px; min-width: 0; }
.jps-notebook textarea { width: 100%; box-sizing: border-box; resize: vertical; font: inherit; line-height: 1.6; color: inherit; background: transparent; border: 1px solid color-mix(in srgb,currentColor 20%,transparent); border-radius: 12px; padding: 12px; }
.jps-notebook input:not([type=checkbox]) { max-width: 100%; box-sizing: border-box; }

.jps fieldset { display: grid; gap: 12px; min-width: 0; margin: 0; padding: 0; border: 0; }

.jps select { font: inherit; color: inherit; background: var(--jps-panel); border: 1px solid var(--jps-line); border-radius: 12px; padding: .7em; max-width: 100%; }
