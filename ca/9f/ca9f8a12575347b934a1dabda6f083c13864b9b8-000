import { describe, it, expect } from 'vitest'
import { titreOnglet } from './titreOnglet.js'
import { libelleDeVue, NAV } from '../components/Sidebar.jsx'
import { readFileSync } from 'node:fs'

describe('le titre de l’onglet nomme la section courante', () => {
  it('rend « ZenRayProgress - Create »', () => {
    expect(titreOnglet('Create')).toBe('ZenRayProgress - Create')
  })

  it('sans section, il reste le nom du produit seul', () => {
    expect(titreOnglet('')).toBe('ZenRayProgress')
    expect(titreOnglet(null)).toBe('ZenRayProgress')
  })

  it('AUCUN TIRET CADRATIN, jamais — c’est une priorité 0 du projet', () => {
    for (const l of ['Create', 'Timer', 'Plan', 'Goals', 'Media', 'Notes', 'Skills', 'Audio', 'Shelf', 'Ref', 'Dashboard', 'Projects', 'Freelance']) {
      expect(titreOnglet(l)).not.toMatch(/[—–]/)
    }
    // Et si un libellé en contenait un, il est corrigé au lieu d’être propagé.
    expect(titreOnglet('Un — titre')).toBe('ZenRayProgress - Un - titre')
  })

  it('le titre statique de index.html n’en porte plus non plus', () => {
    // C’est lui qui s’affichait avant que React ne monte, et il portait l’em-dash signalé.
    const titre = readFileSync('index.html', 'utf8').match(/<title>([^<]*)<\/title>/)?.[1] || ''
    expect(titre).not.toMatch(/[—–]/)
  })
})

describe('les libellés viennent de la sidebar, jamais d’une copie', () => {
  it('les sections de Create sont toutes nommables', () => {
    for (const cle of ['pages', 'timer', 'plan', 'goals', 'sport', 'media', 'motion', 'notes', 'skills', 'audio', 'shelf', 'ref-library', 'houdini', 'board', 'projects', 'freelance']) {
      expect(libelleDeVue(cle), `${cle} n’a pas de libellé`).toBeTruthy()
    }
  })

  it('« pages » s’appelle bien Create, « board » Dashboard et « houdini » Houdini', () => {
    expect(libelleDeVue('pages')).toBe('Create')
    expect(libelleDeVue('board')).toBe('Dashboard')
    expect(libelleDeVue('ref-library')).toBe('Ref')
    expect(libelleDeVue('houdini')).toBe('Houdini')
  })

  it('« motion » s’appelle Motion Design et suit Media (12 October 2026)', () => {
    expect(libelleDeVue('motion')).toBe('Motion Design')
    const keys = NAV.map((n) => n.key)
    expect(keys.indexOf('motion')).toBe(keys.indexOf('media') + 1)
  })

  it('une clé inconnue rend null — on garde le titre nu plutôt qu’un nom faux', () => {
    expect(libelleDeVue('nexistepas')).toBe(null)
    expect(titreOnglet(libelleDeVue('nexistepas'))).toBe('ZenRayProgress')
  })

  it('AUCUNE section n’est perdue : la liste exportée est bien celle de la sidebar', () => {
    expect(NAV.length).toBeGreaterThan(12)
    expect(NAV.every((n) => n.key && n.label)).toBe(true)
  })
})
