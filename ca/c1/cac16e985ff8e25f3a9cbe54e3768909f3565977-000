// LE MARKDOWN AU PREMIER PLAN (demandé par Matthieu le 2026-08-07).
//
// Le besoin, dans ses mots : réduire la page Markdown ouverte dans Create en une petite capsule en
// bas à droite, naviguer ailleurs dans le site, puis la rouvrir EN SURCOUCHE là où l'on se trouve,
// sans repasser par Create. C'est une fenêtre macOS miniature : trois pastilles, un état réduit, un
// état ouvert.
//
// POURQUOI CE COMPOSANT VIT À LA RACINE DE `App` ET NON DANS `Pages` : une surcouche montée dans la
// vue Create disparaîtrait avec elle au premier changement de vue, ce qui est exactement ce que la
// demande interdit. Monté à la racine, il survit à toute navigation, puisque c'est la racine qui
// reste montée.
//
// LA COMMUNICATION PASSE PAR UN ÉVÉNEMENT (`zr:page-float`), convention déjà en place dans ce
// dépôt (`zr:create-music`, `zr:media-open`) : la vue Create émet, la racine écoute. Aucun contexte
// neuf, aucun magasin global à faire vivre pour trois champs.
import React from 'react'
import { PALETTE, SHADOWS, THEMES, FONTS } from '../theme.js'
import { pgPretty } from '../lib/pgPretty.js'
import Icon from './Icon.jsx'
import { lazyRetry } from '../lib/lazyRetry.js'

const LazyPageEditor = lazyRetry(() => import('./PageEditorBN.jsx'))

const baseName = (p) => String(p || '').split('/').pop().replace(/\.md$/, '')

// LES TROIS PASTILLES DE macOS, à l'identique dans leur SENS et non seulement dans leur couleur :
// rouge ferme, jaune réduit, vert agrandit. Les teintes sont celles du système (Big Sur), reprises
// telles quelles parce que c'est précisément la citation visuelle que Matthieu demande.
const FEUX = { rouge: '#ff5f57', jaune: '#febc2e', vert: '#28c840' }

// LES TROIS PASTILLES S'ADAPTENT À L'ÉTAT (2026-08-07, précision de Matthieu après une première
// question posée pour ne pas deviner à tort : « bulle 3, grand uniquement le jaune, moyen les trois
// aussi, faut que t'adaptes les comportements »). Chaque pastille n'est rendue QUE si son handler
// est fourni : c'est le contrôle du nombre affiché, un état passe `null` pour celles qu'il ne veut
// pas montrer plutôt qu'un drapeau de visibilité séparé à tenir synchronisé.
export function Pastilles({ onFermer, onReduire, onAgrandir, agrandi, titreVert, titreJaune, jauneDesactivee }) {
  // Le glyphe n'apparaît qu'au survol du GROUPE, jamais d'une seule pastille : c'est le
  // comportement exact de macOS, et il évite trois symboles permanents dans un en-tête déjà chargé.
  const [survol, setSurvol] = React.useState(false)
  const pastille = (couleur, titre, action, glyphe, desactivee) => (
    <button type="button" title={titre} aria-label={titre} disabled={desactivee}
      onClick={(e) => { e.stopPropagation(); if (!desactivee) action() }}
      style={{
        width: 12, height: 12, padding: 0, borderRadius: 999, cursor: desactivee ? 'default' : 'pointer',
        background: couleur, border: '1px solid rgba(0,0,0,.14)', opacity: desactivee ? .38 : 1,
        display: 'inline-flex', alignItems: 'center', justifyContent: 'center',
        font: '700 9px/1 ui-monospace, monospace', color: 'rgba(0,0,0,.55)',
        transition: 'opacity .12s ease',
      }}>
      <span style={{ opacity: survol && !desactivee ? 1 : 0, transition: 'opacity .12s ease', pointerEvents: 'none' }}>{glyphe}</span>
    </button>
  )
  return (
    <div onMouseEnter={() => setSurvol(true)} onMouseLeave={() => setSurvol(false)}
      style={{ display: 'inline-flex', alignItems: 'center', gap: 8 }}>
      {onFermer && pastille(FEUX.rouge, 'Fermer', onFermer, '×')}
      {onReduire && pastille(FEUX.jaune, titreJaune || 'Réduire en capsule', onReduire, '–', jauneDesactivee)}
      {onAgrandir && pastille(FEUX.vert, titreVert || (agrandi ? 'Rétrécir la fenêtre' : 'Agrandir'), onAgrandir, agrandi ? '−' : '+')}
    </div>
  )
}

export default function PageFloat({ t }) {
  const [page, setPage] = React.useState(null)      // { path } — null = rien en vol
  const [reduit, setReduit] = React.useState(false)
  const [agrandi, setAgrandi] = React.useState(false)

  React.useEffect(() => {
    const onFloat = (e) => {
      const path = e?.detail?.path
      if (!path) return
      setPage({ path })
      setReduit(!!e.detail.reduit)
      setAgrandi(false)
    }
    window.addEventListener('zr:page-float', onFloat)
    return () => window.removeEventListener('zr:page-float', onFloat)
  }, [])

  // Échap referme la fenêtre ouverte, jamais la capsule : le geste le plus courant d'une surcouche,
  // et le seul qui ne détruise pas ce que Matthieu a mis de côté exprès.
  React.useEffect(() => {
    if (!page || reduit) return
    const onKey = (e) => { if (e.key === 'Escape') setReduit(true) }
    window.addEventListener('keydown', onKey)
    return () => window.removeEventListener('keydown', onKey)
  }, [page, reduit])

  if (!page) return null
  const titre = pgPretty(baseName(page.path))

  // ÉTAT RÉDUIT · la capsule. Rayon 999 comme demandé, en bas à droite, au-dessus de tout le reste
  // sauf les dialogues modaux (le pavé PIN monte à 2000, on reste dessous exprès).
  if (reduit) {
    // BULLE · trois pastilles (précision de Matthieu). Le CORPS de la capsule reste cliquable et
    // rouvre en moyen, exactement le geste déjà pris ; la pastille verte offre le même résultat en
    // raccourci direct, sans devoir viser le corps entier. Rouge ferme sans repasser par l'ouverture
    // — la capsule n'avait aucun moyen de fermer avant ce jour. Jaune, elle, n'a nulle part où
    // « réduire » de plus : bulle est déjà le plancher des trois états, donc visible pour la
    // symétrie des trois pastilles demandée, mais désactivée plutôt que de mimer une action fictive.
    const rouvrirEnMoyen = () => { setAgrandi(false); setReduit(false) }
    return (
      <div onClick={rouvrirEnMoyen} role="button" tabIndex={0}
        onKeyDown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); rouvrirEnMoyen() } }}
        title={`Rouvrir « ${titre} » au premier plan`}
        style={{
          position: 'fixed', right: 16, bottom: 16, zIndex: 1200, cursor: 'pointer',
          display: 'inline-flex', alignItems: 'center', gap: 9, maxWidth: 320,
          padding: '9px 13px', borderRadius: 999,
          background: t.cardBg, color: t.textPrimary, border: `1px solid ${t.border}`,
          boxShadow: SHADOWS.lg || '0 12px 32px -10px rgba(0,0,0,.4)',
          font: `500 12.5px/1 ${FONTS.sans}`,
          backdropFilter: 'blur(18px)', WebkitBackdropFilter: 'blur(18px)',
        }}>
        <Pastilles
          onFermer={() => setPage(null)}
          onReduire={() => {}} jauneDesactivee titreJaune="Déjà réduit"
          onAgrandir={rouvrirEnMoyen} titreVert="Rouvrir" />
        <span style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{titre}</span>
      </div>
    )
  }

  // ÉTAT OUVERT · la fenêtre. Elle FLOTTE (position fixe) sans voile derrière elle, et c'est
  // délibéré : la demande est de continuer à naviguer dans le site pendant qu'elle reste visible.
  // Un voile modal interdirait précisément cet usage.
  const large = agrandi
  return (
    <div role="dialog" aria-label={`Page ${titre}`}
      style={{
        position: 'fixed', right: 16, bottom: 16, zIndex: 1200,
        width: large ? 'min(980px, calc(100vw - 32px))' : 'min(560px, calc(100vw - 32px))',
        height: large ? 'calc(100vh - 96px)' : 'min(620px, calc(100vh - 120px))',
        display: 'flex', flexDirection: 'column', overflow: 'hidden',
        background: t.bg, color: t.textPrimary,
        border: `1px solid ${t.border}`, borderRadius: 16,
        boxShadow: '0 26px 70px -18px rgba(0,0,0,.55)',
        transition: 'width .18s ease, height .18s ease',
      }}>
      {/* La barre de titre : pastilles à DROITE, comme Matthieu l'a demandé (macOS les met à
          gauche ; sa consigne prime sur la convention du système). */}
      <div style={{
        flex: '0 0 auto', display: 'flex', alignItems: 'center', gap: 10,
        padding: '9px 12px', borderBottom: `1px solid ${t.border}`, background: t.cardBg,
      }}>
        <Icon name="doc.text" size={13} color={t.textSecondary} />
        <span style={{ flex: 1, minWidth: 0, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', font: `600 12.5px/1.2 ${FONTS.sans}` }}>{titre}</span>
        {large ? (
          // GRAND · uniquement la jaune (précision de Matthieu). Son seul rôle possible ici est de
          // redescendre d'un cran vers moyen — rouge et vert disparaissent : pour fermer ou pour
          // rouvrir en bulle depuis le grand, il faut d'abord repasser par moyen. Un état maximal
          // à geste unique, plutôt que trois raccourcis qui redisent tous « quitte ce format ».
          <Pastilles onReduire={() => setAgrandi(false)} titreJaune="Rétrécir vers la vue moyenne" />
        ) : (
          // MOYEN · les trois, comportement inchangé depuis la première version de ce composant.
          <Pastilles agrandi={agrandi}
            onFermer={() => setPage(null)}
            onReduire={() => setReduit(true)}
            onAgrandir={() => setAgrandi(true)} titreVert="Agrandir" />
        )}
      </div>
      <div style={{ flex: '1 1 auto', overflow: 'auto', overscrollBehavior: 'contain' }}>
        <React.Suspense fallback={<div style={{ padding: 20, color: t.textSecondary, font: `400 12.5px/1.4 ${FONTS.sans}` }}>chargement…</div>}>
          <LazyPageEditor key={page.path} path={page.path} theme={t === THEMES.dark ? 'dark' : 'light'} hideTitle maxW="100%" />
        </React.Suspense>
      </div>
    </div>
  )
}
