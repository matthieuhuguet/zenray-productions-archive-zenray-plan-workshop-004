// 14 October 2026: a branch listed in `initialChain` is open as soon as the menu opens, and a `header` node is not clickable.
// FR : une branche de `initialChain` est ouverte des l'ouverture, et un noeud `header` n'est pas cliquable.
import React from 'react'
import { afterEach, describe, it, expect, vi } from 'vitest'
import { cleanup, render, screen, fireEvent } from '@testing-library/react'
import { ActionColumnPopover } from './ActionColumnMenu.jsx'

const t = { textPrimary: '#111', textSecondary: '#666', border: '#ddd', cardBg: '#fff' }
const nodes = [
  { id: 'mode', label: 'Mode d’envoi', children: [
    { id: 'h1', header: true, label: 'Archive seule', count: 2 },
    { id: 'f1', label: 'Film A', action: vi.fn() },
  ] },
  { id: 'open', label: 'Ouvrir', action: vi.fn() },
]

afterEach(() => cleanup())

afterEach(() => cleanup()) // the menu is a portal on document.body: without cleanup the first test leaks into the second

describe('ActionColumnMenu initialChain and header', () => {
  it('shows the second column right away and renders the header as text', () => {
    render(<ActionColumnPopover t={t} open anchor={{ left: 20, top: 20, triggerTop: 20 }} onClose={() => {}} nodes={nodes} initialChain={['mode']} />)
    expect(screen.getByText('Film A')).toBeTruthy()
    expect(screen.getByText('Archive seule')).toBeTruthy()
    expect(screen.getByText('· 2')).toBeTruthy()
    fireEvent.click(screen.getByText('Archive seule'))
    expect(screen.getByText('Film A')).toBeTruthy() // a header click does nothing, the column stays
  })
  it('RED: without initialChain the second column is closed', () => {
    render(<ActionColumnPopover t={t} open anchor={{ left: 20, top: 20, triggerTop: 20 }} onClose={() => {}} nodes={nodes} />)
    expect(screen.queryByText('Film A')).toBeNull()
  })
})
