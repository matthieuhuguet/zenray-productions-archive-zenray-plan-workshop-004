// 3 October 2026, 15:05 CEST: unknown metadata sorts last and restrictive bounds never admit unknown values.
import { expect, it } from 'vitest'
import { fileSizeLabel, queryAssetsFiles } from './assetsFileQuery.js'
const files = [
  { id: 'a', name: 'tile2.png', relativePath: 'ref/tile2.png', kind: 'image', size: 0, mtimeMs: Date.parse('2026-10-03T10:01:00Z') },
  { id: 'b', name: 'tile10.PNG', relativePath: 'renders/tile10.PNG', kind: 'image', size: 500, mtimeMs: Date.parse('2026-10-03T10:02:00Z') },
  { id: 'c', name: 'note.md', relativePath: 'tile/note.md', kind: 'text' },
]
it('combines type, extension, name, exact time and size constraints', () => {
  expect(queryAssetsFiles(files, { search: 'tile', searchScope: 'name', kind: 'image', extension: 'png', dateFrom: '2026-10-03T10:01:30Z', dateTo: '2026-10-03T10:02:00Z', sizeMin: '500', sizeMax: '500' }).map(f => f.id)).toEqual(['b'])
  expect(queryAssetsFiles(files, { search: 'tile', searchScope: 'name', kind: 'text' })).toEqual([])
  expect(queryAssetsFiles(files, { search: 'tile', kind: 'text' }).map(f => f.id)).toEqual(['c'])
  expect(queryAssetsFiles(files, { dateFrom: '2026-10-04', dateTo: '2026-10-03' })).toEqual([])
})
it('sorts naturally in both directions, keeps unknowns last and admits zero bytes', () => {
  expect(queryAssetsFiles(files, { sort: 'name' }).map(f => f.id)).toEqual(['c', 'a', 'b'])
  expect(queryAssetsFiles(files, { sort: 'name', direction: 'desc' }).map(f => f.id)).toEqual(['b', 'a', 'c'])
  for (const sort of ['size', 'date']) {
    expect(queryAssetsFiles(files, { sort }).map(f => f.id)).toEqual(['a', 'b', 'c'])
    expect(queryAssetsFiles(files, { sort, direction: 'desc' }).map(f => f.id)).toEqual(['b', 'a', 'c'])
  }
  expect(queryAssetsFiles(files, { sizeMax: '0' }).map(f => f.id)).toEqual(['a'])
  expect(queryAssetsFiles(files, { kind: 'audio' })).toEqual([])
})

// 3 October 2026, 15:42 CEST: unknown sizes are not presented as a complete measured total.
it('sums known file sizes and distinguishes zero from missing metadata', () => {
  expect(fileSizeLabel([{ size: 1_000_000 }, { size: 2_000_000 }])).toBe('3,0 Mo')
  expect(fileSizeLabel([{ size: 0 }])).toBe('0 octet')
  expect(fileSizeLabel([{ size: 1_000_000 }, {}, { size: -1 }])).toBe('1,0 Mo connus · 2 tailles inconnues')
  expect(fileSizeLabel([])).toBe('0 octet')
})
