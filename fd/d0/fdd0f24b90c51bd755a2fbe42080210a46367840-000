// Recherche YouTube via l'API OFFICIELLE Data v3 (retour Matthieu 2026-07-17 : feature "sidebar YouTube ->
// Create", distincte de server/youtube-search.js qui reste l'endpoint keyless (innertube) utilisé par ZenRay
// Audio pour l'ajout musical. ICI, la vidéo est réellement JOUÉE dans un lecteur embarqué avec des garanties
// de comportement (rel=0/modestbranding) : l'API officielle + une vraie clé est le choix explicite de
// Matthieu pour cette feature, pas un contournement -- les deux endpoints coexistent, chacun pour son usage.
// Clé : YOUTUBE_API_KEY (variable d'environnement, jamais en dur). Sans elle, renvoie proprement ok:false.
const KEY = process.env.YOUTUBE_API_KEY || ''

export default async function handler(req, res) {
  const q = ((req.query && req.query.q) || '').toString().trim()
  const type = ((req.query && req.query.type) || 'video').toString() // 'video' | 'channel'
  if (!q) return res.status(200).json({ ok: false, error: 'no-query', results: [] })
  if (!KEY) return res.status(200).json({ ok: false, error: 'not-configured', results: [] })
  try {
    const url = `https://www.googleapis.com/youtube/v3/search?part=snippet&maxResults=20&type=${encodeURIComponent(type)}&q=${encodeURIComponent(q)}&key=${KEY}`
    const r = await fetch(url)
    if (!r.ok) return res.status(200).json({ ok: false, error: `youtube-${r.status}`, results: [] })
    const json = await r.json()
    const results = (json.items || []).map((item) => ({
      videoId: item.id?.videoId || null,
      channelId: item.id?.channelId || null,
      title: item.snippet?.title || '',
      channel: item.snippet?.channelTitle || '',
      thumbnail: item.snippet?.thumbnails?.medium?.url || item.snippet?.thumbnails?.default?.url || '',
    })).filter((r) => r.videoId || r.channelId)
    res.setHeader('Cache-Control', 'public, max-age=60')
    return res.status(200).json({ ok: true, results })
  } catch (e) {
    return res.status(200).json({ ok: false, error: e && e.message, results: [] })
  }
}
