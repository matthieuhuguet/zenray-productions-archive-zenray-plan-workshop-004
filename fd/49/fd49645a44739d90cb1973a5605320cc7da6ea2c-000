// CHIFFREMENT MÉDIA (clé maître unique) — fondation du modèle "public + chiffré + jsDelivr".
//
// EN UNE PHRASE : les binaires média sont poussés CHIFFRÉS sur des repos PUBLICS (servis par jsDelivr,
// CDN illimité). N'importe qui peut lire les octets sur GitHub, mais ce sont du ciphertext inutilisable
// sans la clé maître — gardée HORS des repos publics et servie une seule fois via /api/media-key (gaté).
//
// ALGO : AES-GCM 256 bits (WebCrypto). IV aléatoire de 12 octets PAR fichier, stocké dans le manifest
// (l'IV n'est pas secret ; il doit juste être unique par chiffrement avec la même clé). GCM ajoute un tag
// d'authentification (intégrité) en plus de la confidentialité.
//
// La clé est récupérée UNE fois puis cachée en mémoire (et importée en CryptoKey non-extractible).

let _keyPromise = null

// Récupère + importe la clé maître (CryptoKey AES-GCM). Cachée pour toute la session.
export function getMediaKey() {
  if (_keyPromise) return _keyPromise
  _keyPromise = (async () => {
    const r = await fetch('/api/media-key', { cache: 'no-store' }).then((x) => x.json()).catch(() => null)
    if (!r || !r.key) throw new Error('media-key indisponible')
    const raw = Uint8Array.from(atob(r.key), (c) => c.charCodeAt(0)) // base64 -> 32 octets
    return crypto.subtle.importKey('raw', raw, { name: 'AES-GCM' }, false, ['encrypt', 'decrypt'])
  })()
  return _keyPromise
}

const b64FromBytes = (u8) => { let s = ''; const CH = 0x8000; for (let i = 0; i < u8.length; i += CH) s += String.fromCharCode.apply(null, u8.subarray(i, i + CH)); return btoa(s) }
const bytesFromB64 = (b64) => Uint8Array.from(atob(b64), (c) => c.charCodeAt(0))

// Chiffre un ArrayBuffer -> { cipher: Uint8Array, iv: base64 }. IV aléatoire 12 octets.
export async function encryptBytes(arrayBuffer) {
  const key = await getMediaKey()
  const iv = crypto.getRandomValues(new Uint8Array(12))
  const cipher = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, arrayBuffer)
  return { cipher: new Uint8Array(cipher), iv: b64FromBytes(iv) }
}

// Déchiffre (ciphertext ArrayBuffer/Uint8Array + iv base64) -> ArrayBuffer clair.
export async function decryptBytes(cipher, ivB64) {
  const key = await getMediaKey()
  const iv = bytesFromB64(ivB64)
  return crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, cipher)
}

// Pratique : déchiffre un ciphertext déjà fetch (Response/ArrayBuffer) -> objectURL d'un Blob du bon type.
export async function decryptToObjectUrl(cipher, ivB64, mime = 'application/octet-stream') {
  const clear = await decryptBytes(cipher, ivB64)
  return URL.createObjectURL(new Blob([clear], { type: mime }))
}
