// 4 October 2026: the visual primitives of ZenRay Freelance, shared by the view and its panels.
// Every value judged by eye lives in `P` and nowhere else; the look follows ZenRay Assets (serif titles, quiet cards, liquid glass pills).
// FR : les primitives visuelles de ZenRay Freelance. Toute valeur jugee a l'oeil vit dans `P`, l'esthetique suit ZenRay Assets.
import React from 'react'
import { DOT, FREELANCE_BATCH_PASTELS } from '../../config/colors.js'
import { statusColor, statusLabel } from '../../lib/freelanceStudios.js'

export const P = {
  serif: 'var(--zr-police-serif)',
  sans: 'var(--zr-police-sans)',
  mono: 'var(--zr-police-mono)',
  serifWeight: 350,
  numberWeight: 400,
  column: 1240,
  studioGrid: 'repeat(auto-fill, minmax(min(100%, 300px), 1fr))',
  radius: 8,
  cardPadding: '16px 18px',
  gap: 14,
  batchPastels: FREELANCE_BATCH_PASTELS,
  messageLines: 3,
  letterWidth: 760,
  letterLines: 1.6,
  letterMinHeight: 360,
}

export const glassStyle = (t, color) => ({
  display: 'inline-flex', alignItems: 'center', gap: DOT.gap,
  padding: '4px 11px', borderRadius: 999,
  background: (t.glass && t.glass.bg) || t.surface,
  backdropFilter: (t.glass && t.glass.filter) || 'none',
  WebkitBackdropFilter: (t.glass && t.glass.filter) || 'none',
  boxShadow: (t.glass && t.glass.edge) || 'none',
  border: `1px solid ${t.border}`,
  color: t.textPrimary, fontFamily: P.sans, fontSize: 12.5, whiteSpace: 'nowrap',
  ...(color ? { borderColor: color + '55' } : null),
})

export function Dot({ color }) {
  return <span aria-hidden="true" style={{ width: DOT.size, height: DOT.size, borderRadius: 999, background: color, flex: '0 0 auto' }} />
}

/** The liquid glass pill: a state or a filter, readable in one glance. */
export function GlassPill({ t, statusKey, color, children, onClick, active, title }) {
  const dot = color || (statusKey ? statusColor(statusKey) : null)
  const Tag = onClick ? 'button' : 'span'
  return (
    <Tag type={onClick ? 'button' : undefined} onClick={onClick} title={title} aria-pressed={onClick && active !== undefined ? Boolean(active) : undefined}
      style={{ ...glassStyle(t, dot), cursor: onClick ? 'pointer' : 'default', opacity: active === false ? 0.55 : 1, fontWeight: active ? 600 : 400, font: 'inherit', fontSize: 12.5, fontFamily: P.sans }}>
      {dot && <Dot color={dot} />}{children || (statusKey ? statusLabel(statusKey) : null)}
    </Tag>
  )
}

export function Field({ t, value, onChange, placeholder, width = 180, onKeyDown, label }) {
  return (
    <input value={value} onChange={(e) => onChange(e.target.value)} placeholder={placeholder} onKeyDown={onKeyDown} aria-label={label || placeholder}
      style={{ flex: `1 1 ${width}px`, minWidth: 120, background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: P.radius, padding: '9px 12px', fontFamily: P.sans, fontSize: 13.5, outline: 'none' }} />
  )
}

export function Button({ t, onClick, children, primary, disabled, title, small }) {
  return (
    <button type="button" onClick={onClick} disabled={disabled} title={title}
      style={{ background: primary ? t.textPrimary : 'transparent', color: primary ? t.bg : t.textPrimary, border: primary ? 'none' : `1px solid ${t.border}`, borderRadius: P.radius, padding: small ? '6px 11px' : '9px 15px', cursor: disabled ? 'default' : 'pointer', opacity: disabled ? 0.5 : 1, fontFamily: P.sans, fontSize: small ? 12.5 : 13.5 }}>{children}</button>
  )
}

export function SectionTitle({ t, title, count, aside }) {
  return (
    <div style={{ display: 'flex', alignItems: 'baseline', gap: 12, margin: '0 0 14px' }}>
      <h3 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 20, letterSpacing: '-0.015em', margin: 0 }}>{title}</h3>
      {count !== undefined && count !== '' && <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 12.5, color: t.textSecondary }}>{count}</span>}
      <span style={{ flex: 1, height: 1, background: t.border }} />
      {aside}
    </div>
  )
}

export const textareaStyle = (t, extra = {}) => ({ width: '100%', background: t.surface, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: P.radius, padding: 12, fontFamily: P.sans, fontSize: 13, resize: 'vertical', outline: 'none', boxSizing: 'border-box', ...extra })

/** A quiet panel: a titled card that opens and closes, closed panels cost nothing to read. */
export function Panel({ t, title, aside, open, onToggle, children }) {
  return (
    <section style={{ border: `1px solid ${t.border}`, borderRadius: P.radius, background: t.surface, marginBottom: 18 }}>
      <button type="button" onClick={onToggle} aria-expanded={open}
        style={{ display: 'flex', width: '100%', alignItems: 'baseline', gap: 12, background: 'none', border: 'none', cursor: 'pointer', color: 'inherit', padding: '14px 18px', textAlign: 'left' }}>
        <span style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 19 }}>{title}</span>
        <span style={{ marginLeft: 'auto', fontFamily: P.sans, fontSize: 12.5, color: t.textSecondary }}>{aside}</span>
        <span aria-hidden="true" style={{ color: t.textSecondary, fontSize: 12 }}>{open ? '▾' : '▸'}</span>
      </button>
      {open && <div style={{ padding: '0 18px 18px' }}>{children}</div>}
    </section>
  )
}
