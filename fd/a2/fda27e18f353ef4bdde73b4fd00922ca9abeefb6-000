}

/* "Compact search sidebar" V9 (design ui-components-zenray-v9.html) : recherche multi-source de la
   sidebar. Surfaces search + drop en matériau V9 (verre dégradé + rim + élévations, deux thèmes via
   --g9-*). Un seul jeu de classes pour les deux états replié/déplié (SearchGroup) : seule la liste de
   résultats + la pagination + le sens du chevron changent, jamais le style. */
.zr-sbs-search,
.zr-sbs-drop {
  position: relative;
  color: var(--g9-fg);
  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%);
  -webkit-backdrop-filter: blur(27px) saturate(169%);
}
.zr-sbs-search { display: flex; align-items: center; gap: 7px; height: 36px; padding: 0 12px; border-radius: 999px; overflow: hidden; }
.zr-sbs-search input { position: relative; z-index: 1; min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--g9-fg); font: 400 var(--zr-ui-lg)/1 var(--zr-police-sans); }
.zr-sbs-search input::placeholder { color: var(--g9-muted); }
.zr-sbs-drop { margin-top: 4px; padding: 10px 8px; border-radius: 16px; display: flex; flex-direction: column; overflow: hidden; max-height: 320px; overflow-y: auto; }
.zr-sbs-group { position: relative; z-index: 1; padding: 7px 4px; }
.zr-sbs-group + .zr-sbs-group { border-top: 1px solid color-mix(in srgb, var(--g9-fg) 10%, transparent); }
.zr-sbs-group-head { display: flex; align-items: center; justify-content: space-between; padding: 0 2px 3px; }
.zr-sbs-group-head h4 { margin: 0; color: var(--g9-soft); font: 400 var(--zr-ui-sm)/1 var(--zr-police-sans); text-transform: uppercase; letter-spacing: .05em; }
.zr-sbs-chevron { width: 22px; height: 20px; display: grid; place-items: center; background: transparent; border: 0; cursor: pointer; color: var(--g9-muted); transition: transform var(--g9-timing) var(--g9-ease); }
.zr-sbs-chevron.up { transform: rotate(180deg); }
.zr-sbs-row { display: grid; grid-template-columns: 34px minmax(0,1fr) 22px; align-items: center; gap: 9px; width: 100%; padding: 5px 2px; border-radius: 8px; border: 0; background: transparent; text-align: left; cursor: pointer; color: inherit; transition: background-color var(--g9-timing) var(--g9-ease); }
.zr-sbs-row:hover { background: color-mix(in srgb, var(--g9-fg) 8%, transparent); }
.zr-sbs-thumb { width: 34px; height: 20px; border-radius: 4px; object-fit: cover; background: color-mix(in srgb, var(--g9-fg) 14%, transparent); flex-shrink: 0; }
.zr-sbs-thumb.round { width: 22px; height: 22px; border-radius: 5px; }
.zr-sbs-row strong { display: block; color: var(--g9-fg); font: 400 var(--zr-ui-md)/1.25 var(--zr-police-sans); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zr-sbs-row small { display: block; color: var(--g9-muted); font: 400 var(--zr-ui-sm)/1.3 var(--zr-police-sans); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zr-sbs-add { width: 22px; height: 22px; border-radius: 999px; display: grid; place-items: center; background: transparent; border: 0; color: var(--g9-muted); cursor: pointer; transition: background-color var(--g9-timing) var(--g9-ease), color var(--g9-timing) var(--g9-ease); }
.zr-sbs-add:hover { background: color-mix(in srgb, var(--g9-fg) 14%, transparent); color: var(--g9-fg); }
.zr-sbs-note { padding: 4px 2px; color: var(--g9-muted); font: 400 var(--zr-ui-sm)/1.3 var(--zr-police-sans); }
.zr-sbs-pagination { display: flex; align-items: center; justify-content: flex-end; gap: 8px; padding: 6px 4px 0; color: var(--g9-muted); font: 400 var(--zr-ui-sm)/1 var(--zr-police-mono); }
.zr-sbs-page-btn { width: 22px; height: 20px; display: grid; place-items: center; background: transparent; border: 0; color: inherit; cursor: pointer; }
.zr-sbs-page-btn:disabled { opacity: .35; cursor: default; }
/* Variante pilule de recherche de la Sidebar left (design workspace-search : h48, gap 12, icône 18). */
/* HAUTEUR RAMENÉE À CELLE DE LA CLASSE DE BASE (2026-07-31, retour Matthieu « la search bar reste
   trop grosse »). Cette variante imposait 48px là où `.zr-sbs-search` en vaut 36 : un tiers de plus
   que la même barre partout ailleurs dans l'application, sans raison écrite nulle part. L'écart se
   voyait surtout à côté de l'engrenage, qui paraissait alors désaligné ; corriger l'alignement seul
   ne réglait rien, puisque la cause était la hauteur. Gap et padding suivent la même proportion. */
.zr-sbs-search--sidebar { height: 36px; gap: 10px; padding: 0 14px; background: linear-gradient(135deg, var(--g9-toolbar-glass-a), var(--g9-toolbar-glass-b)); }
.zr-sbs-search--sidebar input { font-size: var(--zr-ui-sm); font-weight: 400; }

/* ── "Sidebar left" V9 (design ui-components-zenray-v9.html, section workspace-sidebar) ──────────
   La classe s'AJOUTE à .zr-liquid sur l'aside (l'ancrage du PlayerBar cherche aside.zr-liquid — ne
   jamais retirer cette classe) et surcharge son verre : dégradé NEUTRE charbon en dark (fix V9
   anti-vert : glass-a .135 / glass-b .045), laiteux en light. Le liseré ::before de zr-liquid est
   remplacé par le rim V9 en box-shadow. */
aside.zr-ws-sidebar {
  --ws-side-a: rgba(255,255,255,.78);
  --ws-side-b: rgba(226,230,235,.54);
  color: var(--g9-fg);
  background: linear-gradient(135deg, var(--ws-side-a), var(--ws-side-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-a),
    var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%);
  -webkit-backdrop-filter: blur(27px) saturate(169%);
}
/* DARK : redéclarer background + box-shadow ICI, pas seulement les variables. Diagnostic DOM
   2026-07-19 : `.zr-dark .zr-liquid` (index.html, spécificité 0,2,0) BAT `aside.zr-ws-sidebar`
   (0,1,1) et imposait ses vieux insets 1.5px + fond plat rgba(31,31,30,.5) -> liserés haut/bas
   faux en dark. Ce sélecteur (0,2,1) reprend la main sans toucher aux autres .zr-liquid. */
.zr-dark aside.zr-ws-sidebar,
aside.zr-ws-sidebar.zr-ws-sidebar--dark {
  --ws-side-a: rgba(255,255,255,.135);
  --ws-side-b: rgba(255,255,255,.045);
  background: linear-gradient(135deg, var(--ws-side-a), var(--ws-side-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-a),
    var(--g9-elev-b);
}
aside.zr-ws-sidebar::before { display: none; }

/* ── LE LISERÉ DE LA SIDEBAR, SEUL (2026-08-21) ──────────────────────────────────────────────────
   Matthieu voulait ce liseré-ci sur les groupes de la galerie, et j'avais posé `zr-liquid-rim` à la
   place : « tu commences à ajouter plein d'effet c'est moche ». Il avait raison, ce sont deux
   familles opposées. `zr-liquid-rim` est un BISEAU pour carte opaque — highlight 1,5px, ombre
   interne, halo, plus une ombre portée de 32px. Celui-ci est un FILET, et rien d'autre : à
   --g9-rim-ratio 0.20, la ligne du haut vaut rgba(255,255,255,.144) en sombre. On le voit à peine,
   et c'est exactement le but.

   Extrait de `aside.zr-ws-sidebar` SANS ses deux ombres d'élévation (--g9-elev-a/-b, 14px et 3px de
   diffusion) : elles font sens sous un panneau qui flotte au-dessus de toute la page, jamais sous
   une tuile de 200px posée dans une grille, où elles salissent la grille entière. Le reste est
   identique au caractère près, et les jetons --g9-rim-* vivant sur :root et .zr-dark, le liseré
   suit le thème tout seul. */
.zr-ws-rim {
  /* LE TRAIT EXTÉRIEUR EST LA SEULE DIFFÉRENCE ASSUMÉE AVEC LA SIDEBAR, et elle a une raison
     mesurée. `--g9-outer-line` vaut `0 0 0 0 transparent` en thème CLAIR : la sidebar s'en passe
     parce que son fond est un dégradé de verre qui détache déjà sa silhouette. Une tuile de groupe,
     elle, est une carte PLATE en #FDFDFC posée sur un fond clair — avec les seuls filets internes à
     rgba(34,37,43,.09), elle n'avait plus aucun bord visible en clair. C'est exactement le défaut
     que le CLAUDE.md décrit : un liseré juste dans un thème et faux dans l'autre. On garde donc les
     sept filets de la sidebar au caractère près, et on redonne au trait extérieur une valeur qui
     existe dans les DEUX thèmes. */
  box-shadow:
    0 0 0 .72px rgb(34 37 43 / calc(0.50 * var(--g9-rim-ratio))),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side);
}
.zr-dark .zr-ws-rim {
  /* En sombre, le trait extérieur de la sidebar convient tel quel : il est déjà noir et visible. */
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side);
}
.zr-ws-top { min-height: 25px; display: flex; justify-content: flex-end; align-items: center; padding: 0 4px; }
.zr-ws-bare { width: 28px; height: 28px; padding: 0; display: grid; place-items: center; border: 0; border-radius: 8px; color: var(--g9-muted); background: transparent; cursor: pointer; transition: background-color var(--g9-timing) var(--g9-ease), color var(--g9-timing) var(--g9-ease); }
.zr-ws-bare:hover { background: color-mix(in srgb, var(--g9-fg) 7%, transparent); color: var(--g9-fg); }
/* Typo sidebar : consigne Matthieu 2026-07-19 (PRIME sur le design 17px/400) — fonts beaucoup
   plus petites et fines : items 13.5px/300 (jamais plus gras que 300), headings mono 10px. */
.zr-ws-heading { min-height: 24px; display: flex; align-items: center; gap: 8px; width: 100%; text-align: left; padding: 0 10px; margin: 9px 0 2px; border: 0; background: transparent; cursor: pointer; color: var(--g9-soft); font: 600 var(--zr-ui-xs)/1 var(--zr-police-sans); letter-spacing: .04em; text-transform: uppercase; }
/* Le chevron passe APRÈS le texte (2026-08-16). Il ouvrait la ligne et décalait donc chaque rubrique
   d'une quinzaine de pixels vers la droite, si bien qu'aucune ne s'alignait sur les items qu'elle coiffe.
   Une seule règle suffit et ne touche pas au JSX, qui déclare ce bouton à deux endroits : le libellé est
   un nœud de texte nu, donc un flex item anonyme d'ordre 0 que rien ne peut réordonner ; il suffit de
   pousser le seul élément réel de la ligne, l'icône, en ordre 1. Le texte démarre alors au padding de
   10 px, exactement celui des items. */
.zr-ws-heading > * { order: 1; }
/* Les RUBRIQUES de la sidebar (TOOLS, CREATE, GALLERY, APPS, SYSTEM), style simple et définitif après un
   passage par le mono puis par la serif : la même police que les items, en petites capitales. Trois valeurs
   seulement, et chacune répond à une raison. La graisse 600 détache la rubrique de ses items en 400 sans
   avoir besoin d'être plus grande. La taille descend d'un palier sous celle des items, ce qui suffit à dire
   la hiérarchie. Et l'interlettrage reste à .04em, juste de quoi aérer des capitales, là où les .16em hérités
   du mono écartaient les lettres au point qu'on lisait le mot par morceaux. */
.zr-ws-item { min-height: 26px; display: flex; align-items: center; gap: 7px; width: 100%; text-align: left; padding: 0 10px; border: 0; border-radius: 11px; background: transparent; cursor: pointer; color: var(--g9-fg); font-family: var(--zr-police-sans); font-size: var(--zr-ui-md); font-weight: 400; letter-spacing: -.015em; transition: background-color var(--g9-timing) var(--g9-ease), color var(--g9-timing) var(--g9-ease); }
.zr-ws-item:hover { background: color-mix(in srgb, var(--g9-fg) 6%, transparent); }
.zr-ws-item.active { color: #0a84ff; background: rgba(10, 132, 255, .13); }

/* ══ THÈME GALERIE SUR LA SIDEBAR (2026-09-05, direction 02) ═══════════════════════════════════
   Valeurs relevées dans templates/zenray-assets-mockups/02-galerie.html du skill, jamais devinées.

   LE VERRE RESTE. Première version : un crème OPAQUE posé sur la sidebar, ce qui tuait le
   Liquid Glass que Matthieu voulait garder. La teinte est donc un VOILE à 15 pour cent posé
   par-dessus le verre, jamais un fond plein : on voit toujours au travers.

   LES DEUX THÈMES. Première version encore : des couleurs fixes en !important, donc une sidebar
   cassée dès qu'on passait en sombre. Chaque jeton a maintenant sa valeur sous .zr-dark. */
:root {
  --gal-voile: rgba(244, 242, 237, .15);
  --gal-encre: rgba(34, 33, 30, .92);
  --gal-encre-2: rgba(34, 33, 30, .62);
  --gal-encre-3: rgba(34, 33, 30, .40);
  --gal-filet: rgba(34, 33, 30, .13);
  --gal-marque: #9A5B3C;
  --gal-survol: rgba(34, 33, 30, .045);
}
.zr-dark {
  --gal-voile: rgba(38, 36, 32, .15);
  --gal-encre: rgba(255, 255, 255, .92);
  --gal-encre-2: rgba(255, 255, 255, .62);
  --gal-encre-3: rgba(255, 255, 255, .40);
  --gal-filet: rgba(255, 255, 255, .13);
  --gal-marque: #D89B76;
  --gal-survol: rgba(255, 255, 255, .06);
}

/* Le voile se pose en calque, pas en fond : le backdrop-filter du verre continue d'agir. */
.zr-ws-sidebar { position: relative; }
.zr-ws-sidebar::after {
  content: ''; position: absolute; inset: 0; z-index: 0;
  background: var(--gal-voile); border-radius: inherit; pointer-events: none;
}
.zr-ws-sidebar > * { position: relative; z-index: 1; }

/* La marque, en tête du drawer. Le nom en serif, le mot Progress en italique plus clair :
   c'est la signature de la maquette, et elle manquait entièrement. */
.zr-ws-marque {
  display: flex; align-items: baseline; gap: 7px;
  padding: 2px 10px 16px; user-select: none;
  font-family: var(--zr-police-serif); font-weight: 350;
  font-size: var(--zr-ui-2xl); letter-spacing: -.01em; color: var(--gal-encre);
}
.zr-ws-marque em { font-style: italic; font-weight: 300; color: var(--gal-encre-3); }

/* Family titles (23 October 2026, Matthieu, design « V2 espace et GT Sectra italique »): no rule between families,
   space instead (Gestalt proximity), GT Sectra LCG Regular italic. All values are the tokens just below.
   FR : titres de famille sans filet, de l'espace à la place, GT Sectra LCG Regular italique ; valeurs = jetons ci-dessous. */
:root {
  --zr-nav-zone-gap: 34px;   /* space between two families, about twice the item pitch */
  --zr-nav-head-gap: 2px;    /* space between a family title and its first entry */
  --zr-police-nav-titre: 'GT Sectra LCG', var(--zr-police-serif);
  --zr-style-nav-titre: italic;
}
@font-face { font-family: 'GT Sectra LCG'; src: url('/fonts/GT-Sectra-LCGV-Regular-Italic.woff2') format('woff2'); font-weight: 400; font-style: italic; font-display: swap; }
.zr-ws-heading {
  color: var(--gal-encre) !important;
  font-family: var(--zr-police-nav-titre) !important;
  font-style: var(--zr-style-nav-titre) !important;
  font-size: var(--zr-ui-lg) !important;
  font-weight: 400 !important;
  letter-spacing: -.01em !important;
  text-transform: none !important;
  border-top: 0;
  padding-top: 0 !important;
  margin: var(--zr-nav-zone-gap) 0 var(--zr-nav-head-gap) !important;
}
.zr-ws-sidebar .zr-ws-heading:first-child, .zr-ws-sidebar > div > .zr-ws-heading:first-child { margin-top: 0 !important; }

.zr-ws-subheading {
  display: flex; align-items: center; gap: 9px;
  min-height: 14px; padding: 2px 8px 5px; margin: 6px 0 0;
  color: var(--gal-encre-3);
  font: 400 var(--zr-ui-3xs)/1 var(--zr-police-sans);
  letter-spacing: .16em; text-transform: uppercase; user-select: none;
}
.zr-ws-subheading::after { content: ''; flex: 1; height: 1px; background: var(--gal-filet); }

/* L'accent est employé au FILET et jamais à l'aplat : une barre de 2 px sur 15 de haut,
   c'est tout le parti pris de la Galerie. */
.zr-ws-item {
  position: relative;
  min-height: 31px !important;
  padding: 0 8px 0 12px !important;
  color: var(--gal-encre-2) !important;
}
.zr-ws-item:hover { background: var(--gal-survol) !important; color: var(--gal-encre) !important; }
.zr-ws-item::before {
  content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  width: 2px; height: 0; border-radius: 2px; background: var(--gal-marque);
  transition: height .34s cubic-bezier(.16, 1, .3, 1);
}
.zr-ws-item.active {
  color: var(--gal-encre) !important; background: transparent !important; font-weight: 500;
}
.zr-ws-item.active::before { height: 15px; }

/* ══ LA FUSION, SUR ZENRAY ASSETS SEULEMENT (2026-09-07) ═══════════════════════════════════════
   Sa demande : la barre latérale et le contenu ne forment plus qu'un bloc, en 0,35 seconde, et
   « ça doit rester comme dans Create le scrolling à droite, tu dois couper et ajuster les bords
   en bas, tout doit être parfaitement ajusté ».

   CE QUI ÉTAIT FAUX DANS MA PREMIÈRE VERSION, et il l'a vu tout de suite. Je n'avais fermé que
   le padding gauche et arrondi deux coins : cosmétique. Mesuré, le panneau d'Assets faisait
   5 195 px de haut et descendait sous la fenêtre, parce que sa vue ne reçoit qu'un `minHeight`
   sans borne, là où Create pose `height: calc(100vh - 132px)` avec `overflow: hidden` et laisse
   le défilement à un enfant. Deux surfaces qui ne se terminent pas au même endroit ne fusionnent
   jamais, quel que soit le soin mis aux rayons.

   LA GÉOMÉTRIE EST DONC RECOPIÉE DE CREATE, mesurée sur lui : haut à 70, bas à 42, soit une
   hauteur de 100vh moins 112. Les deux surfaces partagent exactement ces bornes, se touchent au
   pixel, et seuls les quatre coins EXTÉRIEURS restent arrondis. Le bloc se lit alors comme une
   seule pièce, et c'est la div racine, leur parent commun, qui les tient alignées.

   LE DÉFILEMENT PASSE À L'INTÉRIEUR, comme dans Create : le panneau est borné et ne déborde
   plus, c'est le contenu qui glisse dedans. La barre latérale reçoit le même traitement, avec sa
   barre de défilement masquée : la règle du projet interdit une scrollbar VISIBLE dans le
   drawer, et elle reste tenue. */
:root { --zr-fusion-haut: 70px; --zr-fusion-bas: 42px; --zr-fusion-rayon: 26px; }

aside.zr-ws-sidebar,
.zr-scene,
.zr-stage {
  transition: padding var(--zr-fusion-duree, .35s) cubic-bezier(.16, 1, .3, 1),
              margin var(--zr-fusion-duree, .35s) cubic-bezier(.16, 1, .3, 1),
              border-radius var(--zr-fusion-duree, .35s) cubic-bezier(.16, 1, .3, 1),
              box-shadow var(--zr-fusion-duree, .35s) cubic-bezier(.16, 1, .3, 1);
}

/* Tout est borne, donc la scene n'a plus rien a faire glisser : sans ce verrou, deux
   defilements se superposent et le bloc entier peut se decoller du haut. */
/* 3 October 2026, 15:49 CEST: one shared top and bottom anchor; only docked panels join along their inner edge. */
.zr-fusion .zr-scene { padding-top: var(--zr-fusion-haut) !important; padding-bottom: var(--zr-fusion-bas) !important; overflow-y: hidden !important; }
.zr-fusion-docked .zr-scene { padding-left: 0 !important; }
.zr-fusion.zr-fusion-docked aside.zr-ws-sidebar { position: relative !important; top: auto !important; margin-top: var(--zr-fusion-haut) !important; height: calc(100dvh - var(--zr-fusion-haut) - var(--zr-fusion-bas)); overflow-x: hidden; overflow-y: auto; scrollbar-width: thin; }
.zr-fusion.zr-fusion-docked aside.zr-ws-sidebar::-webkit-scrollbar { width: 6px; }
.zr-fusion:not(.zr-fusion-docked) .zr-stage { border-radius: var(--zr-fusion-rayon) !important; }

/* 9 October 2026, 01:22 CEST: Keep the anchored sidebar independently scrollable in every view. */
aside.zr-ws-sidebar.zr-sidebar-docked {
  box-sizing: border-box;
  max-height: calc(100dvh - 82px);
  overflow-x: hidden;
  overflow-y: auto;
  overscroll-behavior-y: contain;
  scrollbar-width: thin;
}
aside.zr-ws-sidebar.zr-sidebar-docked::-webkit-scrollbar { width: 6px; }

.zr-fusion-docked aside.zr-ws-sidebar {
  /* BORDER-BOX, sans quoi le padding s'AJOUTE a la hauteur calculee : la barre laterale
     depassait de 39 px et le panneau de 50, exactement leurs paddings verticaux. Un plafond
     pose en content-box ne plafonne rien, il decale. */
  box-sizing: border-box;
  margin-bottom: var(--zr-fusion-bas) !important;
  max-height: calc(100dvh - var(--zr-fusion-haut) - var(--zr-fusion-bas));
  overflow-y: auto;
  scrollbar-width: none;
  border-radius: var(--zr-fusion-rayon) 0 0 var(--zr-fusion-rayon) !important;
}
.zr-fusion-docked aside.zr-ws-sidebar::-webkit-scrollbar { width: 0; height: 0; }
.zr-fusion-docked aside.zr-ws-sidebar::after {
  border-radius: var(--zr-fusion-rayon) 0 0 var(--zr-fusion-rayon);
}

/* 9 October 2026, 01:40 CEST: Expose a small draggable thumb on the docked sidebar scroll area. */
aside.zr-ws-sidebar.zr-sidebar-docked {
  scrollbar-color: color-mix(in srgb, var(--g9-fg) 40%, transparent) transparent;
}
aside.zr-ws-sidebar.zr-sidebar-docked::-webkit-scrollbar { width: 8px; height: 8px; }
aside.zr-ws-sidebar.zr-sidebar-docked::-webkit-scrollbar-track { background: transparent; }
aside.zr-ws-sidebar.zr-sidebar-docked::-webkit-scrollbar-thumb {
  background-color: color-mix(in srgb, var(--g9-fg) 38%, transparent);
  background-clip: padding-box;
  border: 2px solid transparent;
  border-radius: 999px;
}
aside.zr-ws-sidebar.zr-sidebar-docked::-webkit-scrollbar-thumb:hover {
  background-color: color-mix(in srgb, var(--g9-fg) 58%, transparent);
}
.zr-fusion-docked aside.zr-ws-sidebar.zr-sidebar-docked { scrollbar-width: thin; }
.zr-fusion-docked aside.zr-ws-sidebar.zr-sidebar-docked::-webkit-scrollbar { width: 8px; height: 8px; }

.zr-fusion .zr-stage {
  box-sizing: border-box;
  height: calc(100dvh - var(--zr-fusion-haut) - var(--zr-fusion-bas));
  min-height: 0 !important;
  overflow: hidden !important;
  display: flex;
  flex-direction: column;
  border-radius: 0 var(--zr-fusion-rayon) var(--zr-fusion-rayon) 0 !important;
}
/* Le contenu prend toute la place restante et défile DEDANS, jamais la page. */
.zr-fusion .zr-stage > * { flex: 1 1 auto; min-height: 0; overflow-y: auto; }

@media (prefers-reduced-motion: reduce) { :root { --zr-fusion-duree: 0s; } }

/* ── "Create path bar + empty folders overlay" V9 (design workspace-shell/toolbar/blank) ─────────
   Le stage Finder devient le shell (verre teinté par thème, radius 26, padding 10) ; la barre est une
   GRILLE de quatre surfaces séparées (path pill · searchbar pill · bouton ⋯ · bouton + New bleu),
   plus une pilule englobante ; la zone dossiers est le "blank" (verre atténué, radius 20). */
.zr-ws-shell {
  /* MÊMES valeurs de verre que aside.zr-ws-sidebar (retour Matthieu 2026-07-20 : "le fond de Create et
     celui de la sidebar devraient logiquement être identiques puisque le HTML les traite pareil" -- le
     :is() du fichier v14 donne à workspace-sidebar ET workspace-shell le même glass-a/-b). Avant : le
     shell avait son propre couple (dark charbon opaque .48/.76) très différent de la sidebar. */
  --ws-shell-a: rgba(255,255,255,.78);
  --ws-shell-b: rgba(226,230,235,.54);
  border-radius: 26px !important;
  color: var(--g9-fg);
  background: linear-gradient(135deg, var(--ws-shell-a), var(--ws-shell-b)) !important;
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-a),
    var(--g9-elev-b) !important;
  backdrop-filter: blur(27px) saturate(169%) !important;
  -webkit-backdrop-filter: blur(27px) saturate(169%) !important;
}
.zr-dark .zr-ws-shell { --ws-shell-a: rgba(255,255,255,.135); --ws-shell-b: rgba(255,255,255,.045); }
.zr-ws-toolbar { display: grid; grid-template-columns: minmax(0,1fr) minmax(140px,300px) 42px auto; align-items: center; gap: 9px; }
.zr-ws-path,
.zr-ws-searchbar {
  box-sizing: border-box;
  height: 42px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  min-width: 0;
  color: var(--g9-muted);
  font-size: var(--zr-ui-md);
  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%);
  -webkit-backdrop-filter: blur(27px) saturate(169%);
}
.zr-ws-path { padding: 0 13px 0 16px; gap: 9px; background: linear-gradient(135deg, var(--g9-toolbar-glass-a), var(--g9-toolbar-glass-b)); }
.zr-ws-searchbar { padding: 0 15px; gap: 9px; background: linear-gradient(135deg, var(--g9-toolbar-glass-a), var(--g9-toolbar-glass-b)); }
.zr-ws-searchbar input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--g9-fg); font-size: var(--zr-ui-xs); font-weight: 400; }
.zr-ws-searchbar input::placeholder { color: var(--g9-muted); opacity: .8; }
/* Toggle "Search" cachable (2026-07-19) : chevron discret dans la pilule ouverte ; pilule compacte
   texte "Search" quand repliée -- même logique cachable que les zones Create/Apps/System. */
.zr-ws-search-toggle { flex-shrink: 0; display: inline-flex; align-items: center; gap: 6px; border: 0; background: transparent; color: var(--g9-muted); cursor: pointer; padding: 0; }
.zr-ws-search-toggle:hover { color: var(--g9-fg); }
.zr-ws-search-toggle-closed { justify-self: start; width: fit-content; height: 42px; padding: 0 15px; border-radius: 999px; color: var(--g9-fg); font-family: var(--zr-police-sans); font-size: var(--zr-ui-xs); font-weight: 400;
  background: linear-gradient(135deg, var(--g9-toolbar-glass-a), var(--g9-toolbar-glass-b));
  box-shadow: var(--g9-outer-line), inset 0 1px 0 var(--g9-rim-main), inset 0 -1px 0 var(--g9-rim-main), inset 0 2px 0 var(--g9-rim-soft), inset 0 -2px 0 var(--g9-rim-soft), inset 1px 0 0 var(--g9-rim-side), inset -1px 0 0 var(--g9-rim-side), var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%); -webkit-backdrop-filter: blur(27px) saturate(169%);
}
/* Cartes Skills (App.jsx SkillCardRow, 2026-07-19) : vivaient encore sur l'ancien .zr-liquid (verre
   générique hors du système à un seul paramètre) -- retour Matthieu "cohérence design", même recette
   V9/rim 20% que le reste (Create path bar, sidebar, players). */
.zr-skill-card {
  border: 0; cursor: pointer; border-radius: 22px; padding: 14px 16px;
  color: var(--g9-fg);
  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-a),
    var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%);
  -webkit-backdrop-filter: blur(27px) saturate(169%);
  transition: transform var(--g9-timing) var(--g9-ease);
}
.zr-skill-card:hover { transform: scale(1.008); }
.zr-skill-card:active { transform: scale(.992); }
.zr-ws-more-btn {
  box-sizing: border-box;
  width: 42px; height: 42px; min-height: 42px; padding: 0; flex: 0 0 42px;
  display: grid; place-items: center;
  border: 0; border-radius: 999px; cursor: pointer;
  color: var(--g9-fg);
  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%);
  -webkit-backdrop-filter: blur(27px) saturate(169%);
  transition: transform var(--g9-timing) var(--g9-ease), filter var(--g9-timing) var(--g9-ease);
}
.zr-ws-more-btn:hover { filter: brightness(1.06); }
.zr-ws-more-btn:active { transform: scale(.95); }
/* + New : bleu exact du design (#3b82f7), contenu réellement centré, rim par thème. */
.zr-ws-new-btn {
  box-sizing: border-box;
  width: 112px; min-width: 112px; height: 42px; min-height: 42px; padding: 0 15px; flex: 0 0 112px;
  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
  border: 0; border-radius: 999px; cursor: pointer;
  line-height: 1; white-space: nowrap;
  color: #fff !important;
  background: #3b82f7 !important;
  font-size: var(--zr-ui-md); font-weight: 400;
  box-shadow:
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    0 8px 23px rgba(59,130,247,.24);
  transition: transform var(--g9-timing) var(--g9-ease), filter var(--g9-timing) var(--g9-ease);
}
.zr-dark .zr-ws-new-btn {
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.46),
    inset 0 -1px 0 rgba(255,255,255,.46),
    inset 0 2px 0 rgba(255,255,255,.14),
    inset 0 -2px 0 rgba(255,255,255,.14),
    0 8px 23px rgba(59,130,247,.28);
}
.zr-ws-new-btn:hover { filter: brightness(1.07); }
.zr-ws-new-btn:active { transform: scale(.97); }
.zr-ws-blank {
  --ws-blank-a: rgba(255,255,255,.55);
  --ws-blank-b: rgba(230,233,238,.42);
  border-radius: 20px;
  overflow: hidden;
  background: linear-gradient(135deg, var(--ws-blank-a), var(--ws-blank-b));
  box-shadow:
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    0 10px 28px rgba(62,67,78,.08),
    0 2px 8px rgba(62,67,78,.05);
}
.zr-dark .zr-ws-blank {
  --ws-blank-a: rgba(27,32,35,.72);
  --ws-blank-b: rgba(25,22,20,.78);
  box-shadow:
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    0 10px 28px rgba(0,0,0,.16),
    0 2px 8px rgba(0,0,0,.11);
}
@media (max-width: 900px) {
  .zr-ws-toolbar { grid-template-columns: minmax(0,1fr) 42px auto; }
  .zr-ws-searchbar { display: none; }
}

/* ── Badge play des tuiles audio/playlist (Create, 2026-07-20) ────────────────────────────────────
   Clic = lecture immédiate dans le mini-player global (pas d'ouverture de ZenRay Audio). Au survol,
   un arc blanc tourne autour du rond façon aiguille de chargement -- un tour en 0.35s (la durée
   d'animation standard du site), en boucle tant que le curseur reste dessus. Arc blanc dans les deux
   thèmes : le badge lui-même est toujours sombre (rgba(18,18,20,.62)). */
.zr-play-badge { position: relative; }
.zr-play-badge::after {
  content: '';
  position: absolute;
  inset: -3px;
  border-radius: 999px;
  border: 1.5px solid transparent;
  border-top-color: #fff;
  opacity: 0;
  pointer-events: none;
  transition: opacity .15s ease;
}
.zr-play-badge:hover::after { opacity: 1; animation: zr-play-badge-spin .35s linear infinite; }
@keyframes zr-play-badge-spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .zr-play-badge:hover::after { animation: none; } }


/* ── LE CORPS DE PAGE ─────────────────────────────────────────────────────────
   Deux fautes payées ici, écrites pour ne pas les rejouer. La première : une garde « si la classe n'est pas
   déjà dans le fichier » a sauté l'écriture de la règle, parce que `.bn-block-content` y figurait ailleurs —
   la variable existait donc sans que rien ne la consomme. La seconde : BlockNote pose lui-même `font-size`
   sur `.bn-block-content`, et une règle de même spécificité perdait en silence. On cible donc les blocs PAR
   LEUR TYPE, l'attribut apportant la spécificité qui manquait, et on laisse les TITRES tranquilles, qui
   tirent leur taille de leur niveau. Le markdown déjà rendu suit la même variable, sinon un aperçu et sa page
   n'auraient pas la même taille de texte. */
.bn-block-content[data-content-type="paragraph"],
.bn-block-content[data-content-type="bulletListItem"],
.bn-block-content[data-content-type="numberedListItem"],
.bn-block-content[data-content-type="checkListItem"],
.bn-block-content[data-content-type="quote"],
.bn-block-content[data-content-type="toggleListItem"] { font-size: var(--zr-corps-editeur); line-height: 1.62; font-weight: var(--zr-corps-poids); }

.md-body, .md-body p, .md-body li, .md-body blockquote { font-size: var(--zr-corps-editeur); line-height: 1.62;
  font-weight: var(--zr-corps-poids); }

/* ── LES PALIERS D'ÉCRAN ────────────────────────────────────────────────────────
   UN SEUL nombre change par palier, et toute l'échelle suit. Ces règles vivent ICI et pas dans le bloc de
   premier rendu d'index.html pour une raison de cascade : ce fichier est chargé APRÈS lui, donc sa déclaration
   simple `:root { --zr-corps-editeur: 18px }` écraserait n'importe quelle media query écrite là-bas. C'est
   d'ailleurs ce qui se passait : l'ancien `.md-body { font-size: var(--zr-ui-2xl) }` de la media query mobile était mort,
   et le téléphone affichait bel et bien le corps de bureau. */
@media (max-width: 1024px) { :root { --zr-corps-editeur: 16px; } }
@media (max-width: 640px) {
  :root {
    /* La taille reste celle du palier précédent ; seule l'ÉCHELLE se resserre, le titre restant dominant
       sans occuper trois lignes sur une colonne de 390 px. */
    --zr-echelle-1: 1.72;
    --zr-echelle-2: 1.42;
    --zr-echelle-3: 1.22;
    --zr-echelle-4: 1.08;
  }
}

/* ── LES TITRES DE L'ÉDITEUR, ALIGNÉS SUR CEUX DE LA PAGE ───────────────────────
   BlockNote pilote la taille de ses titres par une propriété personnalisée `--level` (3em, 2em, 1.3em, 1em,
   .9em, .8em) que consomme sa propre règle `font-size: var(--level)`. On se branche donc sur CE paramètre
   plutôt que d'écrire une taille par-dessus : la mécanique reste la sienne, les valeurs deviennent les nôtres.
   Le préfixe `.bn-editor` ajoute la classe qui fait gagner la spécificité quel que soit l'ordre des feuilles.
   Deux défauts corrigés au passage, tous deux hérités des valeurs par défaut : un h4 exactement de la taille
   du corps, et des h5/h6 plus PETITS que lui, donc des titres qui n'en avaient plus l'air. */
.bn-editor .bn-block-content[data-content-type="heading"] { --level: var(--zr-titre-1); }
.bn-editor .bn-block-content[data-content-type="heading"][data-level="2"] { --level: var(--zr-titre-2); }
.bn-editor .bn-block-content[data-content-type="heading"][data-level="3"] { --level: var(--zr-titre-3); }
.bn-editor .bn-block-content[data-content-type="heading"][data-level="4"] { --level: var(--zr-titre-4); }
.bn-editor .bn-block-content[data-content-type="heading"][data-level="5"],
.bn-editor .bn-block-content[data-content-type="heading"][data-level="6"] { --level: var(--zr-corps-editeur); }
/* Le `font-weight: 700` de BlockNote vit sur un sélecteur à cinq classes : `!important` est ici le moyen le
   plus court de reprendre la main, et c'est déjà la convention du fichier pour l'éditeur. 600 plutôt que 700
   parce que la fonte est variable et que le demi-gras suffit à détacher un titre sans l'alourdir. */
.bn-editor .bn-block-content[data-content-type="heading"] { font-weight: var(--zr-titre-poids) !important; }

/* ===== VideoPlayer2, design A "Minimal absolu" (14 October 2026, choix de Matthieu) =====
   EN: no circle, no capsule. Icons only, with a drop shadow. The progress bar FLOATS above the bottom edge between two side margins; the
   volume bar sits in the top row, aligned with the other icons. Scoped to .zr-minimal (VideoPlayer2 only): StreamVideo and StreamVideoMSE
   keep their own look. Every number is a token, changed in ONE place (HDA rule), defaults = the delivered look.
   FR : aucun cercle ni capsule, icones seules avec ombre portee ; barre de progression flottante entre deux marges ; volume en haut aligne.
   Portee .zr-minimal (VideoPlayer2 seulement). Chaque nombre est un jeton. */
:root {
  --zr-player-bar-bottom: 36px;  /* height of the progress bar above the bottom edge */
  --zr-player-bar-side: 48px;    /* left and right margin of the bar and of the top row */
  --zr-player-bar-h: 4px;        /* thickness of the progress and volume bars */
  --zr-player-top: 22px;         /* distance of the top row from the top edge */
  --zr-player-row-gap: 22px;     /* space between the icons of the top row */
  --zr-player-vol-w: 90px;       /* length of the volume bar */
  --zr-player-icon: 24px;        /* size of the icons (the play icon is 2.5 times larger) */
  --zr-player-shadow: 1;         /* strength of the drop shadow, 0 = none */
}
.zr-video-controls.zr-minimal { padding: 0; }
.zr-minimal svg {
  filter:
    drop-shadow(0 calc(1px * var(--zr-player-shadow)) calc(2px * var(--zr-player-shadow)) rgba(0, 0, 0, calc(.85 * var(--zr-player-shadow))))
    drop-shadow(0 calc(2px * var(--zr-player-shadow)) calc(8px * var(--zr-player-shadow)) rgba(0, 0, 0, calc(.55 * var(--zr-player-shadow))));
}
/* the capsules and circles disappear, the controls keep their size through the icon only */
.zr-minimal .zr-video-glass,
.zr-minimal .zr-video-volume-pill,
.zr-minimal .zr-video-options-pill,
.zr-minimal .zr-video-option-button,
.zr-minimal .zr-video-volume-toggle {
  background: none; border: 0; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; border-radius: 0;
  width: auto; height: auto; padding: 4px; color: rgba(255, 255, 255, .92); overflow: visible;
}
.zr-minimal .zr-video-glass:hover,
.zr-minimal .zr-video-glass:active { background: none; border-color: transparent; transform: none; color: #fff; }
.zr-minimal .zr-video-option-button:hover,
.zr-minimal .zr-video-volume-toggle:hover { background: none; color: #fff; }
.zr-minimal .zr-video-top-row {
  position: absolute; top: var(--zr-player-top); right: var(--zr-player-bar-side);
  display: flex; align-items: center; gap: var(--zr-player-row-gap);
}
.zr-minimal .zr-video-top-row svg { width: var(--zr-player-icon); height: var(--zr-player-icon); }
.zr-minimal .zr-video-volume-pill { display: flex; align-items: center; gap: 8px; padding: 0; }
.zr-minimal .zr-video-volume { width: var(--zr-player-vol-w); flex: none; }
.zr-minimal .zr-video-bottom-right { position: relative; right: auto; bottom: auto; gap: 0; }
.zr-minimal .zr-video-options-pill { display: flex; align-items: center; gap: var(--zr-player-row-gap); padding: 0; }
.zr-minimal .zr-video-settings-menu { top: calc(100% + 12px); bottom: auto; right: 0; }
.zr-minimal .zr-video-settings-menu svg { filter: none; }
/* centre: the play icon is large, the 10 second jumps stay discreet */
.zr-minimal .zr-video-play-center { width: auto; height: auto; padding: 0; }
.zr-minimal .zr-video-play-center svg { width: calc(var(--zr-player-icon) * 2.5); height: calc(var(--zr-player-icon) * 2.5); }
.zr-minimal .zr-video-control-md { opacity: .75; padding: 0; }
.zr-minimal .zr-video-control-md:hover { opacity: 1; }
.zr-minimal .zr-video-control-md svg { width: calc(var(--zr-player-icon) * 1.15); height: calc(var(--zr-player-icon) * 1.15); }
/* the floating progress bar: no capsule, detached from the bottom edge, anchored toward the bottom */
.zr-minimal .zr-video-bottom.zr-video-seek-pill {
  left: var(--zr-player-bar-side); right: var(--zr-player-bar-side); bottom: var(--zr-player-bar-bottom);
  height: auto; padding: 0; gap: 16px; grid-template-columns: auto minmax(0, 1fr) auto;
  background: none; border: 0; border-radius: 0; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none;
}
.zr-minimal .zr-video-time { text-shadow: 0 calc(1px * var(--zr-player-shadow)) 2px rgba(0, 0, 0, .9), 0 2px 8px rgba(0, 0, 0, .6); }
.zr-minimal .zr-video-seek::-webkit-slider-runnable-track,
.zr-minimal .zr-video-volume::-webkit-slider-runnable-track { height: var(--zr-player-bar-h); box-shadow: 0 1px 3px rgba(0, 0, 0, .6); }
.zr-minimal .zr-video-seek::-webkit-slider-thumb,
.zr-minimal .zr-video-volume::-webkit-slider-thumb { margin-top: calc((var(--zr-player-bar-h) - 12px) / 2); }
.zr-minimal .zr-video-seek::-moz-range-track,
.zr-minimal .zr-video-volume::-moz-range-track,
.zr-minimal .zr-video-seek::-moz-range-progress,
.zr-minimal .zr-video-volume::-moz-range-progress { height: var(--zr-player-bar-h); }
@media (max-width: 700px) {
  .zr-video-controls.zr-minimal { --zr-player-bar-side: 16px; --zr-player-bar-bottom: 18px; --zr-player-top: 12px; --zr-player-row-gap: 12px; --zr-player-vol-w: 64px; --zr-player-icon: 22px; }
}
