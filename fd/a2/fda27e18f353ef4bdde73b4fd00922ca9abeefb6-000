.zr-video-volume::-moz-range-progress { height: 3px; }
.zr-video-seek::-moz-range-thumb,
.zr-video-volume::-moz-range-thumb { width: 12px; height: 12px; border: 0; border-radius: 999px; opacity: 0; background: #ffffff; box-shadow: 0 1px 6px rgba(0,0,0,.4); }
.zr-video-seek:hover::-moz-range-thumb,
.zr-video-seek:focus-visible::-moz-range-thumb,
.zr-video-volume:hover::-moz-range-thumb,
.zr-video-volume:focus-visible::-moz-range-thumb { opacity: 1; }
.zr-video-control-row { display: flex; min-width: 0; align-items: center; gap: 8px; color: rgba(255, 255, 255, 0.85); }
.zr-video-control-sm { width: 44px; height: 44px; }
.zr-video-control-md { width: 58px; height: 58px; }
.zr-video-volume-pill { display: flex; align-items: center; gap: 12px; width: 240px; height: 44px; padding: 0 14px 0 16px; border-radius: 999px; }
