/* ── Matériau V9 (Memory/Design/ui-design/ui-components-zenray-v9.html, 2026-07-19) ──────────────
   Système Liquid Glass UNIQUE pour tous les composants refondus : lecteurs vidéo, players audio,
   recherche compacte, sidebar, barre Create, preview markdown. LIGHT est le défaut (:root),
   DARK vit sous .zr-dark (classe posée par App.jsx sur le conteneur racine — les portails montés
   hors de ce div doivent la reposer eux-mêmes). Rim light = gris-noir inversé, mêmes valeurs
   haut/bas (comportement V7 confirmé dans le fichier de design). --g9-timing 0.35s = durée
   par défaut des transitions de boutons/clics ("Fast interaction range", UI lente et premium).

   Liseré piloté par UN SEUL paramètre (2026-07-19, cf. Memory/Design/ui-design/ui-components-zenray-v10.html
   et son slider "Rim opacity") : --g9-rim-ratio (0 à 1) est l'unique valeur à changer pour retoucher
   l'intensité du liseré partout à la fois — plus jamais de rgba() individuels à traquer composant par
   composant. Les nombres de base (.72/.16/.085/.66 dark ; .46/.18/.10 light) sont ceux du fichier V10 à
   ratio=1 (100%), multipliés ici par calc(). Défaut de production = 0.20 (slider V10 par défaut = 0.35,
   Matthieu a demandé 20% pour l'UI réelle). En light, seul le liseré gris-noir varie avec le ratio ; le
   liseré noir extérieur (--g9-outer-line) n'existe qu'en dark et reste toujours transparent en light. */
:root {
  --g9-rim-ratio: 0.20;
  --g9-fg: rgba(25,27,31,.92);
  /* Fond du thème (2026-07-22) : sert la paire d'état ACTIF contrastée des boutons toggle (fond = --g9-fg,
     icône = --g9-bg) -> cercle sombre + icône claire en light, cercle blanc + icône sombre en dark. */
  --g9-bg: #fff;
  --g9-muted: rgba(25,27,31,.56);
  --g9-soft: rgba(25,27,31,.40);
  --g9-rail: rgba(25,27,31,.16);
  --g9-fill: rgba(25,27,31,.78);
  --g9-glass-a: rgba(255,255,255,.76);
  --g9-glass-b: rgba(229,233,239,.42);
  --g9-rim-main: rgb(34 37 43 / calc(0.46 * var(--g9-rim-ratio)));
  --g9-rim-soft: rgb(34 37 43 / calc(0.18 * var(--g9-rim-ratio)));
  --g9-rim-side: rgb(34 37 43 / calc(0.10 * var(--g9-rim-ratio)));
  --g9-outer-line: 0 0 0 0 transparent;
  --g9-elev-a: 0 14px 38px rgba(62,67,78,.13);
  --g9-elev-b: 0 3px 12px rgba(62,67,78,.08);
  --g9-timing: 0.35s;
  --g9-ease: cubic-bezier(.16,1,.3,1);
  /* Toolbars à contraste renforcé (Create path bar, Create searchbar, sidebar searchbar) : même verre
     que --g9-glass-a/-b, teinté gris-noir plus sombre pour mieux se détacher du fond. Un seul endroit
     à retoucher (le % de mix) pour ajuster les 3 surfaces à la fois -- retour Matthieu 2026-07-20. */
  --g9-toolbar-glass-a: color-mix(in srgb, var(--g9-glass-a) 80%, #1b1d21 20%);
  --g9-toolbar-glass-b: color-mix(in srgb, var(--g9-glass-b) 80%, #1b1d21 20%);
}
.zr-dark {
  --g9-fg: #fff;
  --g9-bg: #1c1c1e;
  --g9-muted: rgba(255,255,255,.62);
  --g9-soft: rgba(255,255,255,.46);
  --g9-rail: rgba(255,255,255,.26);
  --g9-fill: #fff;
  --g9-glass-a: rgba(255,255,255,.20);
  --g9-glass-b: rgba(255,255,255,.065);
  --g9-rim-main: rgb(255 255 255 / calc(0.72 * var(--g9-rim-ratio)));
  --g9-rim-soft: rgb(255 255 255 / calc(0.16 * var(--g9-rim-ratio)));
  --g9-rim-side: rgb(255 255 255 / calc(0.085 * var(--g9-rim-ratio)));
  --g9-outer-line: 0 0 0 .72px rgb(0 0 0 / calc(0.66 * var(--g9-rim-ratio)));
  --g9-elev-a: 0 14px 36px rgba(0,0,0,.27);
  --g9-elev-b: 0 3px 11px rgba(0,0,0,.15);
  --g9-toolbar-glass-a: color-mix(in srgb, var(--g9-glass-a) 68%, #000 32%);
  --g9-toolbar-glass-b: color-mix(in srgb, var(--g9-glass-b) 68%, #000 32%);
}

/* Crossfade play/pause 0.35s (section "Fast interaction range" du design) : les deux glyphes
   Apple restent montés, empilés dans une grille 1x1 ; l'état .is-playing ne fait varier que
   opacité + échelle, JAMAIS le layout — la taille du bouton est donc invariante entre lecture
   et pause (corrige aussi le "pop" de hauteur du mini-player signalé le 2026-07-19). */
.zr-pp { display: inline-grid; place-items: center; }
.zr-pp > span { grid-area: 1/1; display: grid; place-items: center; transition: opacity var(--g9-timing) var(--g9-ease), transform var(--g9-timing) var(--g9-ease); }
.zr-pp .zr-pp-play { opacity: 1; transform: scale(1); }
.zr-pp .zr-pp-pause { opacity: 0; transform: scale(.72); }
.zr-pp.is-playing .zr-pp-play { opacity: 0; transform: scale(.72); }
.zr-pp.is-playing .zr-pp-pause { opacity: 1; transform: scale(1); }
@media (prefers-reduced-motion: reduce) { .zr-pp > span { transition-duration: .01ms !important; } }

/* Lecteurs vidéo : style semi-transparent blur haute performance (06 October 2026).
   Remplacement du verre opaque V9 par des capsules translucides légères avec flou d'arrière-plan,
   icônes semi-transparentes blanches (85% repos, 100% survol) et liseré fin. */
.zr-video-glass,
.zr-video-seek-pill,
.zr-video-volume-pill,
.zr-video-options-pill,
.zr-video-settings-menu {
  color: rgba(255, 255, 255, 0.85);
  background: rgba(14, 15, 18, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}
.zr-video-glass {
  display: inline-grid;
  place-items: center;
