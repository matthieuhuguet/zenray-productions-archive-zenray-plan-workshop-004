  background: transparent;
}
.zr-video-seek::-webkit-slider-runnable-track,
.zr-video-volume::-webkit-slider-runnable-track {
  height: 4px;
  border-radius: 999px;
  background:
    linear-gradient(to right, rgba(255, 255, 255, 0.95) 0 var(--zr-video-played, var(--zr-video-volume, 0%)), transparent var(--zr-video-played, var(--zr-video-volume, 0%)) 100%),
    linear-gradient(to right, rgba(255, 255, 255, 0.35) 0 var(--zr-video-buffered, var(--zr-video-volume, 0%)), rgba(255, 255, 255, 0.15) var(--zr-video-buffered, var(--zr-video-volume, 0%)) 100%);
}
.zr-video-volume::-webkit-slider-runnable-track { height: 3px; }
.zr-video-seek::-webkit-slider-thumb,
.zr-video-volume::-webkit-slider-thumb {
  width: 12px;
  height: 12px;
  margin-top: -4px;
  border: 0;
  border-radius: 999px;
  appearance: none;
  -webkit-appearance: none;
  background: #ffffff;
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  opacity: 0;
  transition: opacity 0.2s ease;
}
.zr-video-volume::-webkit-slider-thumb { margin-top: -4.5px; }
.zr-video-seek:hover::-webkit-slider-thumb,
.zr-video-seek:focus-visible::-webkit-slider-thumb,
.zr-video-volume:hover::-webkit-slider-thumb,
.zr-video-volume:focus-visible::-webkit-slider-thumb { opacity: 1; }
.zr-video-seek::-moz-range-track,
.zr-video-volume::-moz-range-track { height: 4px; border-radius: 999px; background: rgba(255, 255, 255, 0.15); }
