// PERF (App.jsx loadPaths, poll 25 s) : comparaison de CONTENU bon marché entre l'ancien et le nouveau
// tableau de chemins. `paths` étant une dépendance de plusieurs useMemo (pathNorms, nonEmptyDirs…),
// remplacer sa RÉFÉRENCE à chaque tick même quand rien n'a changé forçait ces dérivés (normalisation regex
// de ~100k+ chemins + parcours d'ancêtres) à se refaire en entier toutes les 25 s pour rien.
//
// Longueur d'abord (rejet instantané dans le cas fréquent), puis comparaison élément par élément (sortie
// dès le premier écart) : bien moins coûteux que la normalisation/le Set que ce court-circuit évite.
export function sameStringArray(a, b) {
  if (a === b) return true
  if (!Array.isArray(a) || !Array.isArray(b) || a.length !== b.length) return false
  for (let i = 0; i < a.length; i++) { if (a[i] !== b[i]) return false }
  return true
}
