// 9 October 2026, 01:30 CEST: Render indexed project images without copying cloud files into a gallery.
import React from 'react'
import Icon from './Icon.jsx'
import QuickLookOverlay from './QuickLookOverlay.jsx'
import { useInView } from '../media/useImageThumb.js'
import { loadSearchIndex, subscribeSearchIndex, getNodeMime } from '../search/searchIndexClient.js'
import { browseLinkedProjectImages, linkedProjectImageFiles, linkedProjectImageFolderSegments } from '../lib/linkedGalleryAssets.js'
import { loadLinkedGalleryImagePreview } from '../lib/linkedGalleryImagePreview.js'

const SOURCE_LABELS = { tmp: 'Atelier', memory: 'Mémoire', houdini: 'Houdini', unreal: 'Unreal', legacy: 'Archives' }
const labelForSource = (value) => SOURCE_LABELS[value] || value.charAt(0).toUpperCase() + value.slice(1)
const readableFileDirectory = (file) => linkedProjectImageFolderSegments(file).map((segment, index) => index === 0 ? labelForSource(segment) : segment).join(' › ')

function LinkedImageTile({ file, NodeThumb, t, onOpen }) {
  const { ref, inView } = useInView()
  const [preview, setPreview] = React.useState(null)

  React.useEffect(() => {
    if (!inView || !file.contentPath.endsWith('.file.json')) return undefined
    let live = true
    let objectUrl = null
    setPreview({ status: 'loading' })
    loadLinkedGalleryImagePreview(file).then((result) => {
      if (!live) return
      const src = result.status === 'generated' ? URL.createObjectURL(result.blob) : result.src
      if (result.status === 'generated') objectUrl = src
      setPreview({ status: result.status, src })
    }).catch(() => { if (live) setPreview({ status: 'unavailable' }) })
    return () => {
      live = false
      if (objectUrl) URL.revokeObjectURL(objectUrl)
    }
  }, [file, inView])

  const archiveImage = file.contentPath.endsWith('.file.json')
  const previewTitle = preview?.status === 'too-large' ? 'Image trop grande pour une vignette, ouvrir pour l’aperçu complet' : file.name
  return (
    <button type="button" onClick={onOpen} title={previewTitle} style={{ minWidth: 0, padding: 0, border: 0, background: 'transparent', color: t.textPrimary, textAlign: 'left', cursor: 'pointer' }}>
      <span ref={ref} style={{ display: 'grid', placeItems: 'center', width: '100%', aspectRatio: '4 / 3', overflow: 'hidden', border: `1px solid ${t.border}`, borderRadius: 8, background: t.cardBg || 'rgba(128,128,128,.08)' }}>
        {inView && archiveImage && preview?.src ? <img src={preview.src} alt="" loading="lazy" decoding="async" style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block' }} />
          : inView && !archiveImage && NodeThumb ? <NodeThumb e={file} size={168} />
            : <Icon name="photo" size={22} color={t.textSecondary} />}
      </span>
      <span style={{ display: 'block', padding: '7px 2px 0', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', font: '400 12px var(--zr-police-sans)' }}>{file.name}</span>
      {/* 9 October 2026, 07:31 CEST: Keep cloud folder labels readable on desktop. */}
      <span style={{ display: 'block', padding: '3px 2px 0', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', color: t.textSecondary, font: '400 12px var(--zr-police-sans)' }}>{readableFileDirectory(file)}</span>
    </button>
  )
}

export default function LinkedAssetsGallery({ project, NodeThumb, t }) {
  const [paths, setPaths] = React.useState([])
  const [status, setStatus] = React.useState('loading')
  const [folderPath, setFolderPath] = React.useState([])
  const [search, setSearch] = React.useState('')
  const [selectedPath, setSelectedPath] = React.useState(null)

  React.useEffect(() => {
    let live = true
    const updateIndex = (index) => {
      if (!live) return
      if (!index || !Array.isArray(index.paths)) { setStatus('error'); return }
      setPaths(index.paths)
      setStatus('ready')
    }
    const unsubscribe = subscribeSearchIndex(updateIndex)
    loadSearchIndex().then((index) => {
      updateIndex(index)
    }).catch(() => { if (live) setStatus('error') })
    return () => { live = false; unsubscribe() }
  }, [project.id])

  const allFiles = React.useMemo(() => linkedProjectImageFiles(project, paths, getNodeMime), [project, paths])
  const sources = React.useMemo(() => [...new Set(allFiles.map((file) => file.source))].sort((left, right) => labelForSource(left).localeCompare(labelForSource(right), 'fr')), [allFiles])
  const source = folderPath[0] || ''
  const folderView = React.useMemo(() => browseLinkedProjectImages(allFiles, { path: folderPath, source, search }), [allFiles, folderPath, source, search])
  const { folders, files } = folderView
  const visibleFolders = React.useMemo(() => [...folders].sort((left, right) => {
    const leftName = folderPath.length === 0 ? labelForSource(left.name) : left.name
    const rightName = folderPath.length === 0 ? labelForSource(right.name) : right.name
    return leftName.localeCompare(rightName, 'fr')
  }), [folders, folderPath.length])
  React.useEffect(() => {
    if (!folderPath.length || !allFiles.length) return
    for (let index = 0; index < folderPath.length; index += 1) {
      const parentPath = folderPath.slice(0, index)
      const parentView = browseLinkedProjectImages(allFiles, { path: parentPath, source: folderPath[0] })
      if (!parentView.folders.some((folder) => folder.name === folderPath[index])) {
        setFolderPath([])
        return
      }
    }
  }, [allFiles, folderPath])
  const selectedIndex = files.findIndex((file) => file.contentPath === selectedPath)
  const selected = selectedIndex >= 0 ? files[selectedIndex] : null
  const openInCreate = () => {
    const parent = selected?.contentPath.slice(0, selected.contentPath.lastIndexOf('/'))
    if (!parent) return
    const url = new URL(window.location.href)
    url.search = `?folder=${encodeURIComponent(parent)}`
    window.location.assign(url.toString())
  }

  return (
    <section aria-label={`Fichiers cloud de ${project.name}`} style={{ margin: '0 0 18px', padding: '10px 0 18px' }}>
      <header style={{ display: 'flex', alignItems: 'baseline', gap: 10, flexWrap: 'wrap' }}>
        <Icon name="photo" size={16} color={t.textSecondary} />
        <h2 style={{ margin: 0, color: t.textPrimary, font: '400 20px var(--zr-police-gallery-title)', fontStyle: 'var(--zr-style-gallery-title)' }}>{project.name}</h2>
        <span style={{ color: t.textSecondary, font: '400 12px var(--zr-police-sans)' }}>Images locales sauvegardées dans le cloud</span>
        {status === 'ready' && <span style={{ marginLeft: 'auto', color: t.textSecondary, font: '400 13px var(--zr-police-serif)' }}>{allFiles.length} images au total</span>}
      </header>

      <nav aria-label="Chemin des fichiers cloud" style={{ display: 'flex', alignItems: 'center', gap: 4, minWidth: 0, overflowX: 'auto', padding: '8px 0 3px', font: '400 12px var(--zr-police-sans)' }}>
        <button type="button" aria-current={folderPath.length === 0 ? 'page' : undefined} onClick={() => setFolderPath([])} style={crumbStyle(t, folderPath.length === 0)}>{project.name}</button>
        {folderPath.map((segment, index) => (
          <React.Fragment key={`${segment}-${index}`}>
            <span aria-hidden="true" style={{ color: t.textSecondary, flexShrink: 0 }}>›</span>
            <button type="button" aria-current={index === folderPath.length - 1 ? 'page' : undefined} onClick={() => setFolderPath(folderPath.slice(0, index + 1))} style={crumbStyle(t, index === folderPath.length - 1)}>{index === 0 ? labelForSource(segment) : segment}</button>
          </React.Fragment>
        ))}
      </nav>

      <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', marginTop: 12 }}>
        <select aria-label="Filtrer par source" value={source} onChange={(event) => setFolderPath(event.target.value ? [event.target.value] : [])} style={filterStyle(t)}>
          <option value="">Toutes les sources</option>
          {sources.map((value) => <option key={value} value={value}>{labelForSource(value)}</option>)}
        </select>
        <input type="search" aria-label="Rechercher dans les fichiers du projet" placeholder="Rechercher dans ce dossier…" value={search} onChange={(event) => setSearch(event.target.value)} style={{ ...filterStyle(t), flex: '1 1 180px' }} />
      </div>

      {status === 'loading' ? <p style={emptyStyle(t)}>Lecture de l’index cloud…</p>
        : status === 'error' ? <p role="status" style={emptyStyle(t)}>L’index cloud est indisponible pour le moment.</p>
        : allFiles.length === 0 ? <p style={emptyStyle(t)}>Aucune image de ce projet n’est indexée dans le cloud.</p>
        : visibleFolders.length === 0 && files.length === 0 ? <p style={emptyStyle(t)}>Aucun fichier ne correspond dans ce dossier.</p>
          : <>
            {visibleFolders.length > 0 && <section aria-label="Dossiers" style={{ marginTop: 12 }}>
              <h3 style={sectionHeadingStyle(t)}>Dossiers <span style={{ color: t.textSecondary }}>({visibleFolders.length})</span></h3>
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(190px, 1fr))', gap: 8 }}>
                {visibleFolders.map((folder) => (
                  <button key={folder.name} type="button" aria-label={`Ouvrir le dossier ${folderPath.length === 0 ? labelForSource(folder.name) : folder.name}`} onClick={() => setFolderPath([...folderPath, folder.name])} style={folderCardStyle(t)}>
                    <Icon name="folder" size={22} />
                    <span style={{ display: 'grid', gap: 3, minWidth: 0, textAlign: 'left' }}>
                      <span style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', color: t.textPrimary }}>{folderPath.length === 0 ? labelForSource(folder.name) : folder.name}</span>
                      <span style={{ color: t.textSecondary, fontSize: 12 }}>{folder.count} {folder.count === 1 ? 'image' : 'images'}</span>
                    </span>
                    <Icon name="chevron.right" size={12} color={t.textSecondary} />
                  </button>
                ))}
              </div>
            </section>}
            {files.length > 0 && <section aria-label="Images du dossier" style={{ marginTop: visibleFolders.length ? 18 : 12 }}>
              <h3 style={sectionHeadingStyle(t)}>Images <span style={{ color: t.textSecondary }}>({files.length})</span></h3>
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(138px, 1fr))', gap: '10px 12px' }}>
                {files.map((file) => <LinkedImageTile key={file.contentPath} file={file} NodeThumb={NodeThumb} t={t} onOpen={() => setSelectedPath(file.contentPath)} />)}
              </div>
            </section>}
          </>}

      {selected && <QuickLookOverlay t={t} item={selected} prettyName={(name) => name}
        onPrev={() => setSelectedPath(files[(selectedIndex - 1 + files.length) % files.length].contentPath)}
        onNext={() => setSelectedPath(files[(selectedIndex + 1) % files.length].contentPath)}
        onClose={() => setSelectedPath(null)} onOpen={openInCreate} />}
    </section>
  )
}

function crumbStyle(t, active) {
  return { flexShrink: 0, maxWidth: 220, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', padding: '4px 9px', border: 0, borderRadius: 999, background: active ? (t.surface || 'rgba(128,128,128,.12)') : 'transparent', color: active ? t.textPrimary : t.textSecondary, cursor: active ? 'default' : 'pointer', font: '400 12px var(--zr-police-sans)' }
}

function sectionHeadingStyle(t) {
  return { margin: '0 0 8px', color: t.textPrimary, font: '400 14px var(--zr-police-sans)' }
}

function folderCardStyle(t) {
  return { display: 'flex', alignItems: 'center', gap: 10, minWidth: 0, padding: '10px 12px', border: `1px solid ${t.border}`, borderRadius: 10, background: t.cardBg || 'rgba(128,128,128,.05)', cursor: 'pointer', textAlign: 'left', font: '400 13px var(--zr-police-sans)' }
}

function filterStyle(t) {
  return { minWidth: 140, maxWidth: '100%', height: 32, padding: '0 9px', border: `1px solid ${t.border}`, borderRadius: 8, color: t.textPrimary, background: t.cardBg || 'transparent', font: '400 12px var(--zr-police-sans)' }
}

function emptyStyle(t) {
  return { margin: '12px 0 0', color: t.textSecondary, font: '400 13px/1.5 var(--zr-police-sans)' }
}
