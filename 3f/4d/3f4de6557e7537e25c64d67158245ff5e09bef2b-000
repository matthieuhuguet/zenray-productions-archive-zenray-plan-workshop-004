import { describe, expect, it } from 'vitest'
import { MEDIA_VIEWER, VIDEO_ENGINE, isPlayableInlineMime, resolveMediaViewerRoute } from './mediaViewerRoute.js'

const route = (manifest, options) => resolveMediaViewerRoute(manifest, options)

describe('mediaViewerRoute manifest contract', () => {
  it.each([
    ['video-raw', { type: 'video-raw', mime: 'video/mp4', parts: [{ url: 'https://cdn/0', size: 10 }] }],
    ['dash', { type: 'dash', mime: 'application/dash+xml', mpd: 'media/id/manifest.mpd' }],
    ['hls', { type: 'hls', mime: 'application/vnd.apple.mpegurl', master: 'media/id/master.m3u8' }],
    ['youtube', { type: 'youtube', mime: 'video/youtube', videoId: 'abcdefghijk' }],
  ])('routes %s through the unified player', (_name, manifest) => {
    expect(route(manifest)).toMatchObject({ viewer: MEDIA_VIEWER.video, engine: VIDEO_ENGINE.unified, immersive: true, mediaKind: 'video' })
  })

  it('routes a complete mse-av manifest to the MSE engine even without relying on its MIME', () => {
    const manifest = { type: 'mse-av', video: { manifest: 'v.media.json' }, audio: [{ manifest: 'a.media.json' }] }
    expect(route(manifest)).toMatchObject({ viewer: MEDIA_VIEWER.video, engine: VIDEO_ENGINE.mse, mediaKind: 'video' })
  })

  it.each([
    [{ type: 'chunked-media', mime: 'video/mp4' }, VIDEO_ENGINE.native],
    [{ type: 'chunked-media', mime: 'video/webm' }, VIDEO_ENGINE.native],
    [{ type: 'chunked-media', mime: 'video/x-matroska' }, VIDEO_ENGINE.legacyWasm],
  ])('selects the expected local video engine', (manifest, engine) => {
    expect(route(manifest)).toMatchObject({ viewer: MEDIA_VIEWER.video, engine })
  })

  it('switches a failed legacy video to the download route', () => {
    expect(route({ type: 'chunked-media', mime: 'video/x-matroska' }, { forceDownload: true })).toMatchObject({ viewer: MEDIA_VIEWER.download, mediaKind: 'video' })
  })

  it.each([
    [{ type: 'chunked-media', mime: 'audio/mpeg' }, MEDIA_VIEWER.audio],
    [{ type: 'chunked-media', mime: 'image/jpeg' }, MEDIA_VIEWER.image],
    [{ type: 'chunked-media', mime: 'application/pdf' }, MEDIA_VIEWER.pdf],
    [{ type: 'playlist' }, MEDIA_VIEWER.playlist],
    [{ type: 'gmaps', embedUrl: 'https://www.google.com/maps/embed?x=1' }, MEDIA_VIEWER.gmaps],
    [{ type: 'blob-raw', mime: 'application/zip' }, MEDIA_VIEWER.download],
  ])('routes non-video manifests without mounting a video engine', (manifest, viewer) => {
    expect(route(manifest)).toMatchObject({ viewer, engine: null })
  })

  it.each([
    { type: 'video-raw', mime: 'video/mp4', parts: [] },
    { type: 'dash', mime: 'application/dash+xml' },
    { type: 'hls', mime: 'application/vnd.apple.mpegurl' },
    { type: 'youtube', mime: 'video/youtube' },
    { type: 'mse-av', video: {}, audio: [] },
    { type: 'gmaps' },
  ])('rejects an incomplete typed manifest instead of falling into another engine', (manifest) => {
    expect(route(manifest)).toMatchObject({ viewer: MEDIA_VIEWER.invalid })
  })

  it('keeps a transcoding placeholder out of every player', () => {
    expect(route({ type: 'chunked-media', mime: 'video/mp4', transcoding: true })).toMatchObject({ viewer: MEDIA_VIEWER.transcoding, transcoding: true, engine: null })
  })

  it('does not mount a viewer before metadata is ready', () => {
    expect(route({ type: 'youtube', mime: 'video/youtube', videoId: 'abcdefghijk' }, { phase: 'meta' }).viewer).toBe(MEDIA_VIEWER.empty)
  })

  it('keeps the native MIME allow-list explicit', () => {
    expect(isPlayableInlineMime('video/mp4')).toBe(true)
    expect(isPlayableInlineMime('audio/flac')).toBe(true)
    expect(isPlayableInlineMime('image/avif')).toBe(true)
    expect(isPlayableInlineMime('video/x-matroska')).toBe(false)
    expect(isPlayableInlineMime('application/dash+xml')).toBe(false)
  })
})
