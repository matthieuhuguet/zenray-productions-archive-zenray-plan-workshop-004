// LiveTransfersPanel.jsx (11 October 2026): one clear card for the running upload, plus a toggle listing the media
// uploaded in the last 24 h, each one opening where it lives in Create.
// FR : une carte claire pour l'upload en cours, et un volet des nouveaux medias (24 h) qui ouvre chacun dans Create.
import React, { useEffect, useMemo, useRef, useState } from 'react'
import { activityPercent, createActivitySource, isActivityFresh, readableFileName, readableThroughput } from '../../progress/activitySource.js'
import './LiveTransfersPanel.css'

// 11 October 2026: every tunable value of the panel in one place.
const PANEL = {
  tickMs: 5000,
  recentVisible: 60,
  gib: 1024 ** 3,
  jobIdPattern: /^(sequential|upload)-/,
  pausePattern: /pause/i,
  stepPrefix: /^\[\d+\/\d+\]\s*/,
  // 11 October 2026: keep the last seen upload this long when one poll comes back empty.
  holdMs: 3 * 60 * 1000,
}

const numberFormat = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 1, minimumFractionDigits: 1 })
const intFormat = new Intl.NumberFormat('fr-FR')

function useLiveTransfers() {
  const [live, setLive] = useState({ mode: 'connecting', active: [], recentFiles: [] })
  useEffect(() => {
    const source = createActivitySource({ onChange: setLive })
    source.start()
    return () => source.stop()
  }, [])
  return live
}

function gib(bytes) {
  return typeof bytes === 'number' && Number.isFinite(bytes) ? numberFormat.format(bytes / PANEL.gib) : null
}

function relativeTime(iso, now) {
  const minutes = Math.max(0, Math.round((now - Date.parse(iso)) / 60000))
  if (minutes < 1) return "à l'instant"
  if (minutes < 60) return `il y a ${minutes} min`
  return `il y a ${Math.round(minutes / 60)} h`
}

function displayName(name) {
  // 11 October 2026: drop release tags ([Trix], [WEBRip 1080p AV1], (Dual Audio...)) but keep a (2019) year.
  const clean = readableFileName(name).replace(/\.(mkv|mp4|mov|webm|m4v)$/i, '')
    .replace(/\[[^\]]*\]/g, ' ').replace(/\((?!\d{4}\))[^)]*\)/g, ' ')
    .replace(/[._]+/g, ' ').replace(/\s+-\s*$/, '').replace(/\s+/g, ' ').trim()
  return clean || readableFileName(name)
}

// 11 October 2026: a real link (?page= / ?folder=), read by App.jsx at load. Dispatching zr:open-page from Assets was
// lost because Create is not mounted yet when the event fires. FR : un vrai lien-pointeur, ouvrable dans un onglet.
function pointer(kind, path) {
  return `/?${kind}=${encodeURIComponent(path)}`
}

function JobCard({ job }) {
  const percent = activityPercent(job)
  const paused = PANEL.pausePattern.test(String(job.currentStep || ''))
  const done = gib(job.completedBytes)
  const total = gib(job.totalBytes)
  const speed = readableThroughput(job.bytesPerSecond)
  const step = String(job.currentStep || '').replace(PANEL.stepPrefix, '')
  const current = displayName(job.currentItem || '')
  return (
    <article className="zr-live-job" aria-label={`Progression : ${job.title || 'Upload'}`}>
      <header className="zr-live-job-head">
        <div>
          <span className={`zr-live-pill${paused ? ' is-paused' : ''}`}>{paused ? 'En pause' : 'En cours'}</span>
          <h3>{job.title || 'Upload en cours'}</h3>
        </div>
        <strong className="assets-number zr-live-percent">{percent === null ? '…' : `${percent} %`}</strong>
      </header>
      <div className="zr-live-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" {...(percent === null ? {} : { 'aria-valuenow': percent })}>
        <span style={{ width: `${percent ?? 0}%` }} />
      </div>
      <dl className="zr-live-stats">
        {Number.isInteger(job.completedUnits) && Number.isInteger(job.totalUnits) && (
          <div><dt>Fichiers</dt><dd className="assets-number">{intFormat.format(job.completedUnits)} / {intFormat.format(job.totalUnits)}</dd></div>
        )}
        {done && total && <div><dt>Volume</dt><dd className="assets-number">{done} / {total} Go</dd></div>}
        {speed && <div><dt>Débit</dt><dd className="assets-number">{speed}</dd></div>}
      </dl>
      {(current || step) && (
        <p className="zr-live-now">
          {current && <span className="zr-live-now-name" title={job.currentItem}>{current}</span>}
          {step && <span className="zr-live-now-step">{step}</span>}
        </p>
      )}
    </article>
  )
}

export default function LiveTransfersPanel() {
  const live = useLiveTransfers()
  const [now, setNow] = useState(() => Date.now())
  const [showRecent, setShowRecent] = useState(false)
  useEffect(() => {
    const id = setInterval(() => setNow(Date.now()), PANEL.tickMs)
    return () => clearInterval(id)
  }, [])

  const active = live.active.filter((item) => isActivityFresh(item, now))
  const seenJobs = active.filter((item) => PANEL.jobIdPattern.test(String(item.id || '')))
  // 11 October 2026: one empty poll must not erase a running upload; show the last card for PANEL.holdMs.
  const lastJobs = useRef({ jobs: [], at: 0 })
  if (seenJobs.length) lastJobs.current = { jobs: seenJobs, at: now }
  const jobs = seenJobs.length ? seenJobs : (now - lastJobs.current.at < PANEL.holdMs ? lastJobs.current.jobs : [])
  const pushes = active.filter((item) => item.kind === 'push')
  const recent = useMemo(() => live.recentFiles
    .filter((file) => isActivityFresh(file, now) && readableFileName(file.name))
    .sort((a, b) => Date.parse(b.updatedAt) - Date.parse(a.updatedAt)), [live.recentFiles, now])

  if (live.mode !== 'online' && !jobs.length && !recent.length) return null

  return (
    <section className="zr-live" aria-label="Uploads en cours et nouveaux médias" aria-live="polite">
      {jobs.length ? jobs.map((job) => <JobCard key={job.id} job={job} />) : (
        <p className="zr-live-idle">Aucun upload en cours sur ce Mac.</p>
      )}
      {pushes.length > 0 && (
        <p className="zr-live-pushes"><span className="assets-number">{pushes.length}</span> envoi{pushes.length > 1 ? 's' : ''} Git en arrière-plan</p>
      )}
      {recent.length > 0 && (
        <div className="zr-live-recent">
          <button type="button" className="zr-live-toggle" aria-expanded={showRecent} onClick={() => setShowRecent((v) => !v)}>
            <span>Nouveaux médias · 24 h</span>
            <span className="assets-number zr-live-count">{recent.length}</span>
            <span className="zr-live-chevron" aria-hidden="true">{showRecent ? '▾' : '▸'}</span>
          </button>
          {showRecent && (
            <ul className="zr-live-recent-list">
              {recent.slice(0, PANEL.recentVisible).map((file) => (
                <li key={`${file.path || file.name}-${file.updatedAt}`}>
                  <a className="zr-live-media" href={file.path ? pointer('page', file.path) : undefined} title={file.name}>
                    <span className="zr-live-media-name">{displayName(file.name)}</span>
                    <span className="zr-live-media-time">{relativeTime(file.updatedAt, now)}</span>
                  </a>
                  {file.folder && (
                    <a className="zr-live-folder" href={pointer('folder', file.folder)} title={`Ouvrir le dossier ${file.folder}`}>Dossier</a>
                  )}
                </li>
              ))}
            </ul>
          )}
        </div>
      )}
    </section>
  )
}
