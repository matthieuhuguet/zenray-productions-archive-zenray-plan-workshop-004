import React from 'react'
import { act, cleanup, render } from '@testing-library/react'
import { afterEach, beforeEach, describe, expect, it } from 'vitest'
import { usePersistedState } from './usePersistedState.js'

let hook

function Probe({ k, def, options }) {
  hook = usePersistedState(k, def, options)
  return null
}

function mount(k, def, options) {
  return render(<Probe k={k} def={def} options={options} />)
}

describe('usePersistedState', () => {
  beforeEach(() => { hook = null; localStorage.clear() })
  afterEach(() => cleanup())

  it('retombe sur defaultValue quand la clé est absente', () => {
    mount('zr:test:missing', 'icons')
    expect(hook[0]).toBe('icons')
  })

  it('relit une string déjà persistée', () => {
    localStorage.setItem('zr:test:str', 'gallery')
    mount('zr:test:str', 'icons')
    expect(hook[0]).toBe('gallery')
  })

  it('persiste une string au setter et la relit après remontage', () => {
    mount('zr:test:str2', 'icons')
    act(() => hook[1]('list'))
    expect(localStorage.getItem('zr:test:str2')).toBe('list')
    cleanup()
    mount('zr:test:str2', 'icons')
    expect(hook[0]).toBe('list')
  })

  it('encode un boolean en 1/0 (convention existante du code, ex. split/pageWide/eagleInsp)', () => {
    mount('zr:test:bool', false)
    act(() => hook[1](true))
    expect(localStorage.getItem('zr:test:bool')).toBe('1')
    cleanup()
    mount('zr:test:bool', false)
    expect(hook[0]).toBe(true)
  })

  it('un boolean par défaut à true respecte la même convention (favOpen)', () => {
    mount('zr:test:boolTrue', true)
    expect(hook[0]).toBe(true) // absent -> defaultValue
    act(() => hook[1](false))
    expect(localStorage.getItem('zr:test:boolTrue')).toBe('0')
  })

  it('encode/décode un number (ex. zoom)', () => {
    mount('zr:test:num', 132)
    act(() => hook[1](200))
    expect(localStorage.getItem('zr:test:num')).toBe('200')
    cleanup()
    mount('zr:test:num', 132)
    expect(hook[0]).toBe(200)
  })

  it('retombe sur defaultValue si la valeur number persistée est corrompue', () => {
    localStorage.setItem('zr:test:numBad', 'not-a-number')
    mount('zr:test:numBad', 132)
    expect(hook[0]).toBe(132)
  })

  it('json:true (dé)sérialise objets/tableaux', () => {
    mount('zr:test:json', {}, { json: true })
    act(() => hook[1]({ a: 1 }))
    expect(localStorage.getItem('zr:test:json')).toBe(JSON.stringify({ a: 1 }))
    cleanup()
    mount('zr:test:json', {}, { json: true })
    expect(hook[0]).toEqual({ a: 1 })
  })

  it('json:true retombe sur defaultValue si le JSON persisté est corrompu', () => {
    localStorage.setItem('zr:test:jsonBad', '{not json')
    mount('zr:test:jsonBad', [], { json: true })
    expect(hook[0]).toEqual([])
  })

  it('accepte un updater fonctionnel comme setState classique', () => {
    mount('zr:test:fnUpdate', { a: 1 }, { json: true })
    act(() => hook[1]((prev) => ({ ...prev, b: 2 })))
    expect(hook[0]).toEqual({ a: 1, b: 2 })
    expect(JSON.parse(localStorage.getItem('zr:test:fnUpdate'))).toEqual({ a: 1, b: 2 })
  })

  it('validate() auto-répare une valeur persistée invalide (garde façon validView/validFolder)', () => {
    localStorage.setItem('zr:test:validated', 'trash/whatever')
    const validate = (v) => (v === 'pages' || (typeof v === 'string' && v.startsWith('pages/'))) ? v : 'pages'
    mount('zr:test:validated', 'pages', { validate })
    expect(hook[0]).toBe('pages')
  })

  it('validate() sanitize aussi les valeurs écrites par le setter', () => {
    const validate = (v) => (v === 'list' || v === 'icons' || v === 'gallery') ? v : 'icons'
    mount('zr:test:validatedSet', 'icons', { validate })
    act(() => hook[1]('bogus'))
    expect(hook[0]).toBe('icons')
    expect(localStorage.getItem('zr:test:validatedSet')).toBe('icons')
  })
})
