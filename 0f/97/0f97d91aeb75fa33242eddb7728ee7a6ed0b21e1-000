// 10 October 2026, 14:34 UTC: Read local transfer activity without contacting any cloud endpoint.

export const ACTIVITY_SOURCE = Object.freeze({
  url: 'http://127.0.0.1:47831/activity',
  pollMs: 5000,
  maxAgeMs: 24 * 60 * 60 * 1000,
})

export function createActivitySource({ onChange, fetchImpl = (...args) => fetch(...args), documentImpl = globalThis.document, config = ACTIVITY_SOURCE } = {}) {
  let state = { mode: 'connecting', active: [], recentFiles: [], error: '' }
  let timer = null
  let controller = null
  let generation = 0
  let stopped = false

  const emit = (patch) => {
    state = { ...state, ...patch }
    onChange?.(state)
  }
  const isVisible = () => !documentImpl || documentImpl.visibilityState !== 'hidden'

  async function refresh() {
    if (stopped || !isVisible() || controller) return
    const requestGeneration = generation
    controller = new AbortController()
    const requestController = controller
    try {
      const response = await fetchImpl(config.url, { cache: 'no-store', signal: requestController.signal })
      if (!response.ok) throw new Error(`activity ${response.status}`)
      const body = await response.json()
      if (stopped || requestGeneration !== generation) return
      emit({
        mode: 'online',
        active: Array.isArray(body?.active) ? body.active.filter((item) => item && typeof item === 'object') : [],
        recentFiles: Array.isArray(body?.recentFiles) ? body.recentFiles.filter((item) => item && typeof item === 'object') : [],
        uploadTiming: body?.uploadTiming && typeof body.uploadTiming === 'object' ? body.uploadTiming : null,
        uploadQueue: body?.uploadQueue && typeof body.uploadQueue === 'object' ? body.uploadQueue : null,
        error: '',
      })
    } catch (error) {
      if (stopped || requestGeneration !== generation || error?.name === 'AbortError') return
      emit({ mode: 'offline', active: [], recentFiles: [], error: error?.message || 'unavailable' })
    } finally {
      if (controller === requestController) controller = null
    }
  }

  function stopTimer() {
    if (timer !== null) clearInterval(timer)
    timer = null
  }

  function updateVisibility() {
    if (stopped) return
    if (!isVisible()) {
      stopTimer()
      generation += 1
      controller?.abort()
      controller = null
      return
    }
    if (timer === null) timer = setInterval(() => { void refresh() }, config.pollMs)
    void refresh()
  }

  function start() {
    stopped = false
    emit({ mode: 'connecting', active: [], recentFiles: [], error: '' })
    documentImpl?.addEventListener?.('visibilitychange', updateVisibility)
    updateVisibility()
  }

  function stop() {
    stopped = true
    generation += 1
    stopTimer()
    controller?.abort()
    controller = null
    documentImpl?.removeEventListener?.('visibilitychange', updateVisibility)
  }

  return { start, stop, refresh, get state() { return state } }
}

export function isActivityFresh(item, now, maxAgeMs = ACTIVITY_SOURCE.maxAgeMs) {
  const updatedAt = Date.parse(item?.updatedAt || '')
  return Number.isFinite(updatedAt) && updatedAt <= now && now - updatedAt <= maxAgeMs
}

export function activityPercent(item) {
  for (const [completedKey, totalKey] of [['completedUnits', 'totalUnits'], ['completedBytes', 'totalBytes']]) {
    const completed = item?.[completedKey]
    const total = item?.[totalKey]
    if (typeof completed === 'number' && Number.isFinite(completed) && completed >= 0 &&
        typeof total === 'number' && Number.isFinite(total) && total > 0 && completed <= total) {
      return Math.round((completed / total) * 100)
    }
  }
  return null
}

export function readableFileName(value) {
  if (typeof value !== 'string' || !value.trim()) return ''
  return value.trim().split(/[\\/]/).filter(Boolean).at(-1) || value.trim()
}

// Formatage lisible du debit temps reel en Mo/s ou Ko/s (10 October 2026)
export function readableThroughput(bytesPerSecond) {
  const bps = Number(bytesPerSecond)
  if (!Number.isFinite(bps) || bps <= 0) return ''
  const mbps = bps / (1024 * 1024)
  if (mbps >= 1) return `${mbps.toFixed(1).replace('.', ',')} Mo/s`
  const kbps = Math.max(1, Math.round(bps / 1024))
  return `${kbps} Ko/s`
}

