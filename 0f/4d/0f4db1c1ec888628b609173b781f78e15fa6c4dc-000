import { describe, expect, it } from 'vitest'
import { cleanGuestName, cleanSubPath, splitImageName, looksLikeImage } from './guestNames.js'
import { packFrame, unpackFrame, sliceParts } from './guestFrame.js'

describe('cleanGuestName', () => {
  it('garde les accents, retire les séparateurs et les points de tête', () => {
    expect(cleanGuestName('  Marie-Éloïse  ')).toBe('Marie-Éloïse')
    expect(cleanGuestName('../../etc/passwd')).toBe('etc passwd')
    expect(cleanGuestName('.hidden')).toBe('hidden')
    expect(cleanGuestName('Anne: "la" <belle>')).toBe('Anne la belle')
  })
  it('un nom vide devient « Invité », un nom long est coupé', () => {
    expect(cleanGuestName('   ')).toBe('Invité')
    expect(cleanGuestName('///')).toBe('Invité')
    expect([...cleanGuestName('x'.repeat(200))].length).toBe(40)
  })
  it('normalise en NFC (macOS écrit les accents décomposés)', () => {
    expect(cleanGuestName('Rémi')).toBe('Rémi')
  })
})

describe('cleanSubPath', () => {
  it('limite la profondeur, retire les segments vides, .. et .', () => {
    expect(cleanSubPath('Mariage/ /../Soirée/./Photos/Extra/Plus')).toBe('Mariage/Soirée/Photos')
    expect(cleanSubPath(['A', 'B'])).toBe('A/B')
    expect(cleanSubPath('')).toBe('')
  })
})

describe('splitImageName / looksLikeImage', () => {
  it('accepte les images, refuse le reste', () => {
    expect(splitImageName('IMG_1234.JPG')).toEqual({ stem: 'IMG_1234', ext: 'jpg', extRaw: 'JPG', display: 'IMG_1234.JPG' })
    expect(splitImageName('a/b/c photo.HEIC').ext).toBe('heic')
    expect(splitImageName('notes.pdf')).toBeNull()
    expect(splitImageName('noext')).toBeNull()
  })
  it('reconnaît les signatures, pas les extensions', () => {
    const jpg = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 0, 16, 0x4a, 0x46, 0x49, 0x46, 0, 1])
    const txt = new TextEncoder().encode('hello world, not an image')
    expect(looksLikeImage(jpg)).toBe(true)
    expect(looksLikeImage(txt)).toBe(false)
  })
})

describe('frame', () => {
  it('aller-retour exact, et refus d’un cadre tronqué', () => {
    const a = new Uint8Array([1, 2, 3]), b = new Uint8Array([4, 5])
    const frame = packFrame({ parts: [{ len: 3 }, { len: 2 }] }, [a, b])
    const { header, payload } = unpackFrame(frame)
    const [pa, pb] = sliceParts(header.parts, payload)
    expect(Array.from(pa)).toEqual([1, 2, 3]); expect(Array.from(pb)).toEqual([4, 5])
    expect(() => unpackFrame(frame.subarray(0, 5))).toThrow('bad-frame')
    expect(() => sliceParts([{ len: 9 }], payload)).toThrow('bad-frame')
  })
})
