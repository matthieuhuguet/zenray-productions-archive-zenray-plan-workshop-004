import React, { useEffect, useRef, useState, useMemo } from 'react'
import * as THREE from 'three'
import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js'
import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js'
import { OBJLoader } from 'three/examples/jsm/loaders/OBJLoader.js'
import { STLLoader } from 'three/examples/jsm/loaders/STLLoader.js'
import { FBXLoader } from 'three/examples/jsm/loaders/FBXLoader.js'

// Visualiseur WebGL pour meshes 3D (Static Meshes & Skeletal Meshes).
// Concu pour Unreal Engine 5 et Houdini HDA.
// Modes : Ombre, Filaire (Wireframe), Normales, MatCap Clay.
// Respect strict des regles de typographie ZenRay (InterVariable, AnthropicSerif, AnthropicMono).
// Zero tiret cadratin.

const P = {
  serif: 'var(--zr-police-serif)',
  sans: 'var(--zr-police-sans)',
  mono: 'var(--zr-police-mono)',
  serifWeight: 350,
  numberWeight: 400,
  accent: '#9A5B3C',
  radius: 8,
}

// Fonction de repli creant une geometrie de demonstration elegante si l'URL est distante ou en chargement
function createSampleGeometry(type = 'church-component') {
  if (type === 'stairs') {
    const group = new THREE.Group()
    const stepGeo = new THREE.BoxGeometry(2.0, 0.2, 0.4)
    const mat = new THREE.MeshStandardMaterial({ color: 0x9a8876, roughness: 0.8, metalness: 0.1 })
    for (let i = 0; i < 8; i++) {
      const step = new THREE.Mesh(stepGeo, mat)
      step.position.set(0, i * 0.2, -i * 0.4)
      group.add(step)
    }
    return group
  } else if (type === 'shutters') {
    const group = new THREE.Group()
    const frameGeo = new THREE.BoxGeometry(1.2, 2.2, 0.1)
    const mat = new THREE.MeshStandardMaterial({ color: 0x5a7a50, roughness: 0.7, metalness: 0.1 })
    const frame = new THREE.Mesh(frameGeo, mat)
    group.add(frame)
    return group
  }

  // Defaut : composant architectural classique
  const geo = new THREE.CylinderGeometry(0.8, 1.1, 2.4, 16)
  const mat = new THREE.MeshStandardMaterial({ color: 0x8a7a6a, roughness: 0.75, metalness: 0.15 })
  return new THREE.Mesh(geo, mat)
}

export default function MeshViewer3D({ meshItem, t, onBack }) {
  const mountRef = useRef(null)
  const [displayMode, setDisplayMode] = useState('shaded') // 'shaded', 'wireframe', 'normals', 'clay'
  const [wireframeOverlay, setWireframeOverlay] = useState(false)
  const [autoRotate, setAutoRotate] = useState(true)
  const [stats, setStats] = useState({
    triangles: meshItem.polycount || 32130,
    vertices: meshItem.vertices || 18450,
    dimensions: meshItem.dimensions || '457 × 863 × 633 cm',
    submeshes: meshItem.submeshes || 4,
  })

  const sceneRef = useRef(null)
  const rootObjectRef = useRef(null)
  const rendererRef = useRef(null)
  const controlsRef = useRef(null)
  const cameraRef = useRef(null)
  const animIdRef = useRef(0)

  // Initialisation Three.js
  useEffect(() => {
    const container = mountRef.current
    if (!container) return

    const width = container.clientWidth || 640
    const height = container.clientHeight || 480

    const scene = new THREE.Scene()
    scene.background = new THREE.Color(t.bg === '#ffffff' ? 0xf5f5f7 : 0x141416)
    sceneRef.current = scene

    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000)
    camera.position.set(3, 2.5, 4.5)
    cameraRef.current = camera

    const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' })
    renderer.setSize(width, height)
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2))
    renderer.toneMapping = THREE.ACESFilmicToneMapping
    renderer.toneMappingExposure = 1.1
    container.innerHTML = ''
    container.appendChild(renderer.domElement)
    rendererRef.current = renderer

    const controls = new OrbitControls(camera, renderer.domElement)
    controls.enableDamping = true
    controls.dampingFactor = 0.05
    controls.maxDistance = 20
    controls.minDistance = 0.5
    controlsRef.current = controls

    // Eclairage studio 3 points + hemisphere
    const hemiLight = new THREE.HemisphereLight(0xffffff, 0x334455, 0.9)
    hemiLight.position.set(0, 20, 0)
    scene.add(hemiLight)

    const dirLight1 = new THREE.DirectionalLight(0xfffaf0, 1.8)
    dirLight1.position.set(6, 10, 8)
    scene.add(dirLight1)

    const dirLight2 = new THREE.DirectionalLight(0xccddff, 0.8)
    dirLight2.position.set(-6, 4, -6)
    scene.add(dirLight2)

    // Chargement du modele 3D ou creation de repli
    let loadedRoot = null
    const fitObject = (obj) => {
      const box = new THREE.Box3().setFromObject(obj)
      const size = box.getSize(new THREE.Vector3())
      const center = box.getCenter(new THREE.Vector3())
      obj.position.sub(center)

      const maxDim = Math.max(size.x, size.y, size.z) || 1
      camera.position.set(maxDim * 1.5, maxDim * 1.0, maxDim * 2.0)
      camera.lookAt(0, 0, 0)
      controls.target.set(0, 0, 0)

      // Calcul des statistiques geometriques reelles
      let triCount = 0
      let vertCount = 0
      let meshCount = 0
      obj.traverse((child) => {
        if (child.isMesh && child.geometry) {
          meshCount++
          const geo = child.geometry
          if (geo.index) {
            triCount += geo.index.count / 3
          } else if (geo.attributes.position) {
            triCount += geo.attributes.position.count / 3
          }
          if (geo.attributes.position) {
            vertCount += geo.attributes.position.count
          }
        }
      })

      if (triCount > 0) {
        setStats({
          triangles: Math.round(triCount),
          vertices: Math.round(vertCount),
          dimensions: `${(size.x * 100).toFixed(1)} × ${(size.y * 100).toFixed(1)} × ${(size.z * 100).toFixed(1)} cm`,
          submeshes: meshCount,
        })
      }
    }

    const loadMesh = async () => {
      const url = meshItem.modelUrl
      const ext = (meshItem.name || '').split('.').pop()?.toLowerCase() || ''

      try {
        if (url && (ext === 'glb' || ext === 'gltf')) {
          const loader = new GLTFLoader()
          const gltf = await loader.loadAsync(url)
          loadedRoot = gltf.scene
        } else if (url && ext === 'obj') {
          const loader = new OBJLoader()
          loadedRoot = await loader.loadAsync(url)
        } else if (url && ext === 'stl') {
          const loader = new STLLoader()
          const geo = await loader.loadAsync(url)
          const mat = new THREE.MeshStandardMaterial({ color: 0x909090, roughness: 0.6, metalness: 0.2 })
          loadedRoot = new THREE.Mesh(geo, mat)
        } else if (url && ext === 'fbx') {
          const loader = new FBXLoader()
          loadedRoot = await loader.loadAsync(url)
        } else {
          // Repli procedurale d'inspection
          loadedRoot = createSampleGeometry(meshItem.sampleType || 'church-component')
        }
      } catch {
        loadedRoot = createSampleGeometry('church-component')
      }

      if (loadedRoot) {
        scene.add(loadedRoot)
        rootObjectRef.current = loadedRoot
        fitObject(loadedRoot)
      }
    }
    loadMesh()

    // Boucle d'animation
    let isDisposed = false
    const animate = () => {
      if (isDisposed) return
      animIdRef.current = requestAnimationFrame(animate)

      if (autoRotate && rootObjectRef.current) {
        rootObjectRef.current.rotation.y += 0.006
      }

      controls.update()
      renderer.render(scene, camera)
    }
    animate()

    const handleResize = () => {
      if (!container || !renderer || !camera) return
      const w = container.clientWidth
      const h = container.clientHeight
      camera.aspect = w / h
      camera.updateProjectionMatrix()
      renderer.setSize(w, h)
    }
    window.addEventListener('resize', handleResize)

    return () => {
      isDisposed = true
      cancelAnimationFrame(animIdRef.current)
      window.removeEventListener('resize', handleResize)
      controls.dispose()
      renderer.dispose()
      if (container.contains(renderer.domElement)) {
        container.removeChild(renderer.domElement)
      }
    }
  }, [meshItem, t.bg])

  // Application des modes de rendu (Shaded, Wireframe, Normales, MatCap Clay)
  useEffect(() => {
    const root = rootObjectRef.current
    if (!root) return

    root.traverse((child) => {
      if (!child.isMesh) return

      if (displayMode === 'shaded') {
        child.material = new THREE.MeshStandardMaterial({
          color: 0x8e8275,
          roughness: 0.65,
          metalness: 0.15,
          wireframe: false,
        })
      } else if (displayMode === 'wireframe') {
        child.material = new THREE.MeshBasicMaterial({
          color: 0x9A5B3C,
          wireframe: true,
        })
      } else if (displayMode === 'normals') {
        child.material = new THREE.MeshNormalMaterial({
          wireframe: false,
        })
      } else if (displayMode === 'clay') {
        child.material = new THREE.MeshStandardMaterial({
          color: 0xb5a797,
          roughness: 0.9,
          metalness: 0.05,
          wireframe: false,
        })
      }
    })
  }, [displayMode])

  // Cadrage automatique (Reset Camera)
  const resetCamera = () => {
    const root = rootObjectRef.current
    const camera = cameraRef.current
    const controls = controlsRef.current
    if (!root || !camera || !controls) return

    const box = new THREE.Box3().setFromObject(root)
    const size = box.getSize(new THREE.Vector3())
    const maxDim = Math.max(size.x, size.y, size.z) || 1
    camera.position.set(maxDim * 1.5, maxDim * 1.0, maxDim * 2.0)
    controls.target.set(0, 0, 0)
    root.rotation.set(0, 0, 0)
    controls.update()
  }

  const modes = [
    { id: 'shaded', label: 'Rendu ombré', desc: 'Éclairage standard PBR' },
    { id: 'wireframe', label: 'Filaire', desc: 'Inspection de la topologie' },
    { id: 'normals', label: 'Normales', desc: 'Vecteurs de surface' },
    { id: 'clay', label: 'MatCap Clay', desc: 'Volume pur sans texture' },
  ]

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 20, fontFamily: P.sans, color: t.textPrimary }}>
      {/* En-tete du visualiseur avec navigation retour */}
      <div style={{ display: 'flex', alignItems: 'baseline', gap: 16, flexWrap: 'wrap', borderBottom: `1px solid ${t.border}`, paddingBottom: 14 }}>
        <button type="button" onClick={onBack}
          style={{ border: 0, background: 'transparent', padding: 0, cursor: 'pointer', color: t.textSecondary, fontFamily: P.sans, fontSize: 13 }}>
          ← Retour aux meshes
        </button>
        <span style={{ fontSize: 10.5, letterSpacing: '0.13em', textTransform: 'uppercase', color: P.accent }}>
          {meshItem.meshType || 'Static Mesh'}
        </span>
        <h2 style={{ fontFamily: P.serif, fontWeight: P.serifWeight, fontSize: 24, margin: 0, letterSpacing: '-0.015em' }}>
          {meshItem.name}
        </h2>
        <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 13, color: t.textSecondary, marginLeft: 'auto' }}>
          {meshItem.targetEngine || 'Unreal Engine 5'}
        </span>
      </div>

      {/* Grille principale : Viewport WebGL + Panneau d'inspection technique */}
      <div style={{ display: 'grid', gridTemplateColumns: 'minmax(0, 1fr) 320px', gap: 24, alignItems: 'start' }}>
        {/* Conteneur WebGL Three.js */}
        <div style={{ position: 'relative', width: '100%', height: 540, borderRadius: P.radius, overflow: 'hidden', border: `1px solid ${t.border}`, background: t.cardBg || t.bg }}>
          <div ref={mountRef} style={{ width: '100%', height: '100%', display: 'block', cursor: 'grab' }} />

          {/* Badge du mode actif */}
          <div style={{ position: 'absolute', top: 14, left: 14, background: 'rgba(20, 20, 24, 0.75)', backdropFilter: 'blur(10px)',
            color: '#ffffff', padding: '5px 12px', borderRadius: 999, fontSize: 11.5, letterSpacing: '0.08em', textTransform: 'uppercase', pointerEvents: 'none' }}>
            Mode : <strong style={{ color: P.accent }}>{modes.find((m) => m.id === displayMode)?.label}</strong>
          </div>

          {/* Boutons rapides en bas a droite */}
          <div style={{ position: 'absolute', bottom: 14, right: 14, display: 'flex', gap: 8 }}>
            <button type="button" onClick={resetCamera}
              style={{ background: 'rgba(20, 20, 24, 0.75)', backdropFilter: 'blur(10px)', color: '#ffffff', border: `1px solid ${t.border}`,
                borderRadius: 6, padding: '5px 10px', fontSize: 11.5, cursor: 'pointer', fontFamily: P.sans }}>
              Recadrer
            </button>
            <button type="button" onClick={() => setAutoRotate((v) => !v)}
              style={{ background: 'rgba(20, 20, 24, 0.75)', backdropFilter: 'blur(10px)', color: autoRotate ? '#ffffff' : 'rgba(255, 255, 255, 0.5)',
                border: `1px solid ${autoRotate ? P.accent : 'transparent'}`, borderRadius: 6, padding: '5px 10px', fontSize: 11.5, cursor: 'pointer', fontFamily: P.sans }}>
              {autoRotate ? 'Turntable actif' : 'Turntable arrêté'}
            </button>
          </div>
        </div>

        {/* Panneau lateral d'inspection et de sauvegarde */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: 20 }}>
          {/* Section 1 : Modes d'affichage */}
          <div style={{ padding: '16px 18px', borderRadius: P.radius, border: `1px solid ${t.border}`, background: t.cardBg || t.bg }}>
            <div style={{ fontSize: 11, letterSpacing: '0.12em', textTransform: 'uppercase', color: t.textSecondary, marginBottom: 12 }}>
              Mode d'affichage 3D
            </div>
            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: 8 }}>
              {modes.map((m) => {
                const on = displayMode === m.id
                return (
                  <button key={m.id} type="button" onClick={() => setDisplayMode(m.id)}
                    style={{ border: `1px solid ${on ? P.accent : t.border}`, borderRadius: 6, background: on ? 'rgba(154, 91, 60, 0.12)' : 'transparent',
                      color: on ? P.accent : t.textPrimary, padding: '8px 10px', cursor: 'pointer', textAlign: 'left', fontFamily: P.sans, fontSize: 12 }}>
                    <div style={{ fontWeight: on ? 500 : 400 }}>{m.label}</div>
                    <div style={{ fontSize: 10.5, color: t.textSecondary, marginTop: 2 }}>{m.desc}</div>
                  </button>
                )
              })}
            </div>
          </div>

          {/* Section 2 : Fiche technique et Polycount */}
          <div style={{ padding: '16px 18px', borderRadius: P.radius, border: `1px solid ${t.border}`, background: t.cardBg || t.bg }}>
            <div style={{ fontSize: 11, letterSpacing: '0.12em', textTransform: 'uppercase', color: t.textSecondary, marginBottom: 12 }}>
              Statistiques géométriques
            </div>
            <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', fontSize: 13, borderBottom: `1px solid ${t.border}`, paddingBottom: 6 }}>
                <span style={{ color: t.textSecondary }}>Triangles :</span>
                <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 15, color: t.textPrimary }}>
                  {stats.triangles.toLocaleString('fr-FR')}
                </span>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', fontSize: 13, borderBottom: `1px solid ${t.border}`, paddingBottom: 6 }}>
                <span style={{ color: t.textSecondary }}>Sommets (Vertices) :</span>
                <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 15, color: t.textPrimary }}>
                  {stats.vertices.toLocaleString('fr-FR')}
                </span>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', fontSize: 13, borderBottom: `1px solid ${t.border}`, paddingBottom: 6 }}>
                <span style={{ color: t.textSecondary }}>Dimensions :</span>
                <span style={{ fontFamily: P.mono, fontSize: 12, color: t.textPrimary }}>
                  {stats.dimensions}
                </span>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', fontSize: 13 }}>
                <span style={{ color: t.textSecondary }}>Slots de matériaux :</span>
                <span style={{ fontFamily: P.serif, fontWeight: P.numberWeight, fontSize: 14 }}>
                  {stats.submeshes}
                </span>
              </div>
            </div>
          </div>

          {/* Section 3 : Sauvegarde et fichiers sources */}
          <div style={{ padding: '16px 18px', borderRadius: P.radius, border: `1px solid ${t.border}`, background: t.cardBg || t.bg }}>
            <div style={{ fontSize: 11, letterSpacing: '0.12em', textTransform: 'uppercase', color: t.textSecondary, marginBottom: 10 }}>
              Sauvegarde et fichiers
            </div>
            <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
              {meshItem.sourceFile && (
                <div style={{ display: 'flex', alignItems: 'baseline', gap: 8, fontSize: 12 }}>
                  <span style={{ color: t.textSecondary }}>Source :</span>
                  <span style={{ fontFamily: P.mono, fontSize: 11.5, color: t.textPrimary }}>{meshItem.sourceFile}</span>
                </div>
              )}
              <div style={{ display: 'flex', alignItems: 'baseline', gap: 8, fontSize: 12 }}>
                <span style={{ color: t.textSecondary }}>Formats :</span>
                <span>FBX, OBJ, GLTF, HDA</span>
              </div>

              <div style={{ display: 'flex', gap: 8, marginTop: 12 }}>
                {meshItem.downloadUrl ? (
                  <a href={meshItem.downloadUrl} download
                    style={{ flex: 1, textAlign: 'center', background: P.accent, color: '#ffffff', textDecoration: 'none',
                      borderRadius: 6, padding: '7px 12px', fontSize: 12, fontWeight: 500 }}>
                    Télécharger le modèle 3D
                  </a>
                ) : (
                  <button type="button" onClick={() => alert('Modèle 3D sauvegardé sur le drive ZenRay Assets')}
                    style={{ flex: 1, border: `1px solid ${t.border}`, borderRadius: 6, background: 'transparent',
                      color: t.textPrimary, padding: '7px 12px', fontSize: 12, cursor: 'pointer', fontFamily: P.sans }}>
                    Sauvegardé sur ZenRay Assets
                  </button>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}
