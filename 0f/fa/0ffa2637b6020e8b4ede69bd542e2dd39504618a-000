import { useEffect, useState } from 'react'
import { SHADOWS } from '../theme.js'

// Badge quota GitHub (restant / 5000 req·h), bas-droite. AUTONOME : fetch son propre quota (aucune dépendance
// au scope de App) -> ne peut pas casser le render. Important depuis la vidéo brute : les parts raw.github +
// l'index puisent dans le budget de requêtes GitHub.
// Extrait de App.jsx (batch refactor structurel 2026-07-16).
export default function GitHubQuotaBadge({ t }) {
  const [rl, setRl] = useState(null)
  useEffect(() => {
    let live = true
    const tick = () => fetch('/api/page?action=ratelimit', { cache: 'no-store' }).then((r) => r.json()).then((j) => { if (live && j && typeof j.remaining === 'number') setRl(j) }).catch(() => {})
    tick(); const id = setInterval(tick, 20000)
    const onFocus = () => tick(); window.addEventListener('focus', onFocus)
    return () => { live = false; clearInterval(id); window.removeEventListener('focus', onFocus) }
  }, [])
  // RÉDUIT À UNE PASTILLE (2026-07-06, plan UX validé) : plus de texte permanent à l'écran — un point de
  // statut couleur (vert/orange/rouge selon le quota restant) ; le détail complet s'affiche au clic/tap
  // dans une mini-bulle (re-clic ou clic ailleurs pour fermer). Cachable via le menu œil (id 'ghquota').
  const [open, setOpen] = useState(false)
  useEffect(() => {
    if (!open) return
    const away = () => setOpen(false)
    const id = setTimeout(() => document.addEventListener('click', away), 0)
    return () => { clearTimeout(id); document.removeEventListener('click', away) }
  }, [open])
  if (!rl || typeof rl.remaining !== 'number') return null
  const lim = rl.limit || 5000
  const color = rl.remaining < 500 ? '#e5484d' : rl.remaining < 1500 ? '#f5a623' : '#30a46c'
  return (
    <div style={{ position: 'fixed', right: 12, bottom: 12, zIndex: 40, display: 'flex', flexDirection: 'column', alignItems: 'flex-end', gap: 8 }}>
      {open && (
        <div style={{ fontFamily: "var(--zr-police-sans)", fontSize: 'var(--zr-ui-xs)', color: t.textSecondary, background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: 999, padding: '4px 10px', boxShadow: SHADOWS.sm }}>
          GitHub {rl.remaining}/{lim} req·h{rl.reset ? ` · reset ${new Date(rl.reset * 1000).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}` : ''}
        </div>
      )}
      <button onClick={(e) => { e.stopPropagation(); setOpen((v) => !v) }} title="Quota API GitHub (clic pour le détail)"
        style={{ width: 14, height: 14, borderRadius: '50%', border: `1px solid ${t.border}`, background: color, cursor: 'pointer', padding: 0, boxShadow: SHADOWS.sm, opacity: 0.92 }} />
    </div>
  )
}
