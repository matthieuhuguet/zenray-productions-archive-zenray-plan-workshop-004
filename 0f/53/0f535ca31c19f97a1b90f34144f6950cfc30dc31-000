import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
import { prefetchFullImages, readImgManifestCached, clearManifestCache } from './ImageNodeViewer.jsx'

// ═══ LE PRÉCHARGEMENT NE DOIT JAMAIS EMPOISONNER LE CACHE PARTAGÉ ════════════════════════════════
//
// Cause RÉELLE de la pastille orange, mesurée le 2026-08-31. `prefetchFullImages` lisait le corps
// BRUT d'un raccourci (`readImgManifest`) — c'est-à-dire le manifeste du LIEN, 172 octets sans
// `cdnRepo` — et le rangeait dans le cache PARTAGÉ sous le chemin du lien. La tuile lisait ensuite
// ce cache pollué et affichait un lien non résolu : `onCdn` faux -> pastille orange, aucune vignette.
//
// La donnée était parfaite (prouvé sur le drive). Le seul défaut était ce cache partagé corrompu.

const LIEN = { v: 1, type: 'zenray-eagle-link/v1', resourceId: 'zr_x', title: 'IMG.jpeg' }
const CANON = { type: 'image', vis: 'public', cdnRepo: 'zenrayshards-img-e7aa34', cdnCommit: 'deadbeef', cdnChunks: ['a'], thumb: 'https://cdn/x.webp' }
const rep = (corps) => ({ ok: true, status: 200, json: async () => ({ markdown: JSON.stringify(corps), sha: null }) })

beforeEach(() => { clearManifestCache() })
afterEach(() => { vi.unstubAllGlobals() })

const attendre = (ms) => new Promise((r) => setTimeout(r, ms))

describe('prefetchFullImages partage le manifeste RÉSOLU, jamais le lien brut', () => {
  it('LE BUG : après préchargement, la tuile obtient le canonique (vert), pas le lien (orange)', async () => {
    vi.stubGlobal('fetch', vi.fn(async (url) => {
      const u = String(url)
      if (u.includes('action=read')) return u.includes('tri') ? rep(LIEN) : rep(CANON)
      if (u.includes('resolve-link')) return { ok: true, status: 200, json: async () => ({ ok: true, path: 'pages/A/IMG.jpeg.img.json' }) }
      return { ok: false, status: 404, json: async () => ({}) }
    }))
    globalThis.requestAnimationFrame = globalThis.requestAnimationFrame || ((cb) => setTimeout(cb, 0))

    const lien = 'pages/A/tri/IMG.jpeg.img.json'
    // Le préchargement passe EN PREMIER, comme quand une image est sous le pli.
    prefetchFullImages([lien])
    // On laisse le préchargement remplir le cache (setTimeout 200 de _ric + les fetchs).
    await attendre(600)

    // La tuile lit ensuite le cache partagé. Elle DOIT obtenir le manifeste canonique.
    const m = await readImgManifestCached(lien)
    expect(m, 'le cache partagé doit contenir le canonique résolu').toBeTruthy()
    // C'est exactement ce que la pastille regarde : onCdn = vis public + cdnRepo + cdnCommit.
    const onCdn = m && m.vis === 'public' && m.cdnRepo && m.cdnCommit
    expect(onCdn, 'sans cdnRepo la pastille est ORANGE et la vignette absente — le bug').toBeTruthy()
    // Et ce n'est SURTOUT pas le corps du lien.
    expect(m.type).not.toBe('zenray-eagle-link/v1')
  }, 10000)
})
