// 9 October 2026 08:16 CEST: Keep fresh tree nodes and the complete search index in one global view.
export function mergeTreeAndIndexPaths(treePaths, indexPaths) {
  const tree = Array.isArray(treePaths) ? treePaths : []
  if (!Array.isArray(indexPaths)) return tree
  return [...new Set([...tree, ...indexPaths])]
}
