// La porte de la mosaïque d'aperçu (2026-08-05).

import { describe, it, expect } from 'vitest'
import { readFileSync } from 'node:fs'
import { COVER_FILE, mosaicPathFor, composeMosaic } from './folderMosaic.js'

describe('la couverture d’un dossier partagé', () => {
  it('le nom du fichier est le MÊME des deux côtés, client et serveur', () => {
    // Un littéral en double finit toujours par se désynchroniser : le client écrirait la couverture
    // à un endroit où le serveur ne la chercherait pas, et l'aperçu retomberait en silence sur la
    // première photo — un défaut invisible, donc coûteux.
    const serveur = readFileSync('server/share-cover.js', 'utf8')
    expect(serveur).toContain(`export const COVER_FILE = '${COVER_FILE}'`)
  })

  it('le fichier commence par un point, pour ne jamais apparaître comme une tuile', () => {
    // `isExposedTreeNode` n'expose que des extensions connues ; un point en tête garantit en plus
    // qu'aucun listing ne le montre à l'utilisateur.
    expect(COVER_FILE.startsWith('.')).toBe(true)
    expect(mosaicPathFor('pages/Photos/DJI')).toBe(`pages/Photos/DJI/${COVER_FILE}`)
  })

  it('refuse de composer en dessous de quatre images, plutôt que de rendre une mosaïque trouée', () => {
    // La règle posée par Matthieu : quatre, ou une seule. Trois photos et un carré vide se lisent
    // comme un bogue.
    expect(composeMosaic(['a', 'b', 'c'])).resolves.toBe(null)
    expect(composeMosaic([])).resolves.toBe(null)
    expect(composeMosaic(null)).resolves.toBe(null)
  })
})
