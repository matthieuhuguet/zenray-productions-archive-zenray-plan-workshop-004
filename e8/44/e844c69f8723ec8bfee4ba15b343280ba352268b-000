/* MiniPlayerCard — matériau V9 (Memory/Design/ui-design/ui-components-zenray-v9.html, 2026-07-19).
   Deux compositions du design : "Horizontal player · V2" (footer ZenRay Audio) et "Vertical player · V2"
   (PlayerBar global). La matière (verre en dégradé + rim principal/doux/latéral + double élévation) vit
   sur la CARTE entière, jamais par bouton. Thèmes : variables --g9-* (light sur :root, dark sous
   .zr-dark) définies dans fonts.css — aucune couleur en dur ici. */

.zr-mp-card {
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  border: 0;
  color: var(--g9-fg);
  font-family: var(--zr-police-sans);
  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-a),
    var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%);
  -webkit-backdrop-filter: blur(27px) saturate(169%);
}
.zr-mp-card--h { display: flex; align-items: center; justify-content: space-between; gap: 20px; width: 100%; padding: 10px 18px; border-radius: 22px; }
.zr-mp-card--v { width: 100%; padding: 18px 20px 16px; border-radius: 30px; }

/* Boutons nus (la matière est sur la carte) — transitions 0.35s var(--g9-ease), "UI lente et premium". */
.zr-mp-btn { background: transparent; border: 0; padding: 4px; border-radius: 8px; color: var(--g9-fg); cursor: pointer; display: grid; place-items: center; transition: color var(--g9-timing) var(--g9-ease), transform var(--g9-timing) var(--g9-ease); }
.zr-mp-btn:active { transform: scale(.9); }
.zr-mp-btn--dim { color: var(--g9-muted); }
.zr-mp-btn--dim:hover { color: var(--g9-fg); }
/* ÉTAT ACTIF (shuffle on, repeat all/one) : fond cercle contrasté auto-thème (2026-07-22). --g9-fg/--g9-bg
   s'inversent par thème -> cercle sombre+icône claire en light, cercle blanc+icône sombre en dark. Toggle pur,
   aucun hover requis pour le signaler. */
.zr-mp-btn--on { background: var(--g9-fg); color: var(--g9-bg); border-radius: 999px; }

/* Égaliseur 4 barres (mini-eq du design) : animé en lecture, figé en pause. */
@keyframes zr-eq { 0%, 100% { transform: scaleY(.35); } 50% { transform: scaleY(1); } }
.zr-eq rect { transform-origin: center; animation: zr-eq 1s ease-in-out infinite; }
.zr-eq rect:nth-child(2) { animation-delay: .18s; }
.zr-eq rect:nth-child(3) { animation-delay: .36s; }
.zr-eq rect:nth-child(4) { animation-delay: .1s; }
.zr-eq.zr-eq-static rect { animation: none; }
@media (prefers-reduced-motion: reduce) { .zr-eq rect { animation: none; } }

/* ── Horizontal player · V2 ─────────────────────────────────────────────── */
.zr-mp2-now { position: relative; z-index: 1; display: flex; align-items: center; gap: 12px; min-width: 0; flex: 0 1 260px; }
.zr-mp2-cover { flex: 0 0 48px; width: 48px; height: 48px; border-radius: 10px; overflow: hidden; display: grid; place-items: center; background-color: color-mix(in srgb, var(--g9-fg) 7%, transparent); background-size: contain; background-repeat: no-repeat; background-position: center; }
.zr-mp2-title { display: flex; align-items: center; gap: 8px; font-size: var(--zr-ui-lg); font-weight: 400; min-width: 0; }
.zr-mp2-title > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zr-mp2-sub { margin-top: 2px; font-size: var(--zr-ui-sm); font-weight: 400; color: var(--g9-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: left; }
/* Nom d'artiste cliquable (2026-07-19) : reset des styles <button> par défaut (hérite intégralement de
   .zr-mp2-sub/.zr-mpv2-sub, appliquée en second sur le même élément) + surlignage au survol/focus qui
   PROUVE à l'utilisateur que le clic va fonctionner, comme demandé. display:block + width:100% pour que
   text-overflow:ellipsis (hérité) continue de tronquer proprement un nom trop long. */
.zr-mp-artist-link { display: block; width: 100%; padding: 0; border: none; background: transparent; font: inherit; color: inherit; cursor: pointer; }
.zr-mp-artist-link:hover, .zr-mp-artist-link:focus-visible { color: var(--g9-fg); text-decoration: underline; text-underline-offset: 2px; }
/* Multi-artistes (2026-07-20) : défilement en boucle façon Pac-Man (droite -> gauche, le texte ressort
   de l'autre côté), transform LENT, en pause au survol pour pouvoir cliquer un artiste précis -- le
   surlignage ne couvre que l'artiste visé (liens inline séparés), jamais toute la ligne. */
.zr-mp-artists-marquee { display: block; overflow: hidden; white-space: nowrap; }
.zr-mp-artists-track { display: inline-flex; width: max-content; animation: zr-mp-artists-scroll 14s linear infinite; will-change: transform; }
.zr-mp-artists-marquee:hover .zr-mp-artists-track { animation-play-state: paused; }
.zr-mp-artists-run { display: inline-flex; align-items: baseline; }
.zr-mp-artists-sep { white-space: pre; }
.zr-mp-artists-gap { display: inline-block; width: 34px; }
.zr-mp-artist-link--inline { display: inline; width: auto; }
@keyframes zr-mp-artists-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) { .zr-mp-artists-track { animation: none; } }
/* Centre ABSOLU sur la carte entière : pile centré quel que soit le poids des blocs gauche/droite. */
.zr-mp2-center { position: absolute; z-index: 1; left: 50%; top: 50%; transform: translate(-50%, -50%); display: flex; flex-direction: column; align-items: center; gap: 7px; width: min(360px, calc(100% - 520px)); min-width: 220px; }
.zr-mp2-transport { display: flex; align-items: center; gap: 20px; }
.zr-mp2-progress { display: flex; align-items: center; gap: 9px; width: 100%; font: 400 var(--zr-ui-3xs)/1 var(--zr-police-sans); font-variant-numeric: tabular-nums; color: var(--g9-muted); }
.zr-mp2-tools { position: relative; z-index: 1; display: flex; align-items: center; justify-content: flex-end; gap: 14px; flex: 0 0 auto; }
.zr-mp2-volume { display: flex; align-items: center; gap: 7px; }

/* ── Vertical player · V2 ───────────────────────────────────────────────── */
.zr-mpv2-cover { width: 100%; aspect-ratio: 1; border-radius: 26px; margin-bottom: 14px; overflow: hidden; display: grid; place-items: center; background-color: color-mix(in srgb, var(--g9-fg) 7%, transparent); background-size: contain; background-repeat: no-repeat; background-position: center; box-shadow: 0 16px 34px rgba(0, 0, 0, .3); }
/* Bouton queue.playlist à la place de l'ancien égaliseur "waveform" (retour Matthieu 2026-07-20) --
   même position exacte (top:18/right:18), même taille de cible que les autres .zr-mp-btn. */
.zr-mpv2-queue { position: absolute; z-index: 1; top: 12px; right: 12px; }
.zr-mpv2-title { position: relative; z-index: 1; padding: 0 22px; text-align: center; font-size: var(--zr-ui-2xl); font-weight: 400; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zr-mpv2-sub { position: relative; z-index: 1; margin-top: 3px; text-align: center; font-size: var(--zr-ui-sm); font-weight: 400; color: var(--g9-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zr-mpv2-progress { position: relative; z-index: 1; margin-top: 15px; display: flex; align-items: center; gap: 11px; font: 400 var(--zr-ui-sm)/1 var(--zr-police-sans); font-variant-numeric: tabular-nums; color: var(--g9-muted); }
/* Transport à hauteur FIXE (34px, design) + groupe centré en absolu : la hauteur de la carte ne varie
   JAMAIS entre lecture et pause — corrige le "pop" vertical signalé le 2026-07-19 au clic play/pause. */
.zr-mpv2-transport { position: relative; z-index: 1; margin-top: 16px; height: 34px; }
.zr-mpv2-group { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: flex; align-items: center; gap: 34px; }

/* ── Rails seek/volume ──────────────────────────────────────────────────── */
/* Un <input type=range> nu, une fois appearance:none posé, n'affiche plus RIEN par défaut — track fin
   rempli jusqu'à --zr-mp-level (couleurs thème V9), thumb masqué hors survol/focus.
   Hauteurs design : 4px en horizontal (mini-h2-rail), 5px en vertical (mini-rail). */
.zr-mp-seek, .zr-mp-volume {
  appearance: none; -webkit-appearance: none; cursor: pointer; background: transparent; margin: 0;
}
.zr-mp-seek::-webkit-slider-runnable-track, .zr-mp-volume::-webkit-slider-runnable-track {
  height: 4px; border-radius: 999px;
  background: linear-gradient(90deg, var(--g9-fill) 0 var(--zr-mp-level, 0%), var(--g9-rail) var(--zr-mp-level, 0%) 100%);
}
.zr-mp-seek--v::-webkit-slider-runnable-track { height: 5px; }
.zr-mp-seek::-moz-range-track, .zr-mp-volume::-moz-range-track { height: 4px; border-radius: 999px; background: var(--g9-rail); }
.zr-mp-seek--v::-moz-range-track { height: 5px; }
.zr-mp-seek::-moz-range-progress, .zr-mp-volume::-moz-range-progress { height: 4px; border-radius: 999px; background: var(--g9-fill); }
.zr-mp-seek--v::-moz-range-progress { height: 5px; }
.zr-mp-seek::-webkit-slider-thumb, .zr-mp-volume::-webkit-slider-thumb {
  appearance: none; -webkit-appearance: none; width: 11px; height: 11px; margin-top: -3.5px; border: 0; border-radius: 999px;
  background: var(--g9-fill); box-shadow: 0 1px 4px rgba(0, 0, 0, .24); opacity: 0; transition: opacity var(--g9-timing) var(--g9-ease);
}
.zr-mp-seek--v::-webkit-slider-thumb { margin-top: -3px; }
.zr-mp-seek::-moz-range-thumb, .zr-mp-volume::-moz-range-thumb {
  width: 11px; height: 11px; border: 0; border-radius: 999px; background: var(--g9-fill); box-shadow: 0 1px 4px rgba(0, 0, 0, .24); opacity: 0;
}
.zr-mp-seek:hover::-webkit-slider-thumb, .zr-mp-seek:focus-visible::-webkit-slider-thumb,
.zr-mp-volume:hover::-webkit-slider-thumb, .zr-mp-volume:focus-visible::-webkit-slider-thumb,
.zr-mp-seek:hover::-moz-range-thumb, .zr-mp-seek:focus-visible::-moz-range-thumb,
.zr-mp-volume:hover::-moz-range-thumb, .zr-mp-volume:focus-visible::-moz-range-thumb { opacity: 1; }
