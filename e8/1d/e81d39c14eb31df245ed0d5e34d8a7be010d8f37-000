// La porte des trois formes de vignette. Le défaut corrigé le 2026-08-04 tenait à n'en lire qu'une.

import { describe, it, expect, vi, beforeEach } from 'vitest'
import { thumbUrlOf, thumbIvOf, resolveThumbUrl } from './thumbUrl.js'

describe('l’adresse d’une vignette', () => {
  it('une image publique en clair s’utilise telle quelle', () => {
    expect(thumbUrlOf({ u: 'https://cdn.jsdelivr.net/x.webp' })).toBe('https://cdn.jsdelivr.net/x.webp')
    expect(thumbIvOf({ u: 'https://cdn.jsdelivr.net/x.webp' })).toBeUndefined()
  })

  it('une image PRIVÉE passe par le relais, au lieu d’être écartée en silence', () => {
    // C'est le cas que ZenRayMedia ignorait : pas de `u`, donc aucune image privée du drive
    // n'apparaissait dans sa palette.
    expect(thumbUrlOf({ r: 'zenray/img-07', p: 'a/b c.webp' }))
      .toBe('/api/shard?repo=zenray%2Fimg-07&path=a%2Fb%20c.webp')
  })

  it('une image publique CHIFFRÉE annonce son vecteur, pour qu’on n’affiche pas le ciphertext', () => {
    expect(thumbIvOf({ u: 'https://cdn/x.webp', iv: 'AAAA' })).toBe('AAAA')
  })

  it('une entrée vide ou inconnue ne rend rien plutôt que de fabriquer une adresse fausse', () => {
    expect(thumbUrlOf(null)).toBeUndefined()
    expect(thumbUrlOf({})).toBeUndefined()
  })

  it('accepte encore une chaîne nue, forme des anciens index', () => {
    expect(thumbUrlOf('https://cdn/x.webp')).toBe('https://cdn/x.webp')
  })

  it('résout une image en clair sans aucun appel réseau', async () => {
    const fetchSpy = vi.fn()
    global.fetch = fetchSpy
    expect(await resolveThumbUrl({ u: 'https://cdn/x.webp' })).toBe('https://cdn/x.webp')
    expect(fetchSpy).not.toHaveBeenCalled()
  })

  it('rend null si le ciphertext est introuvable, sans jamais lever', async () => {
    global.fetch = vi.fn(async () => ({ ok: false }))
    expect(await resolveThumbUrl({ u: 'https://cdn/x.webp', iv: 'AAAA' })).toBe(null)
  })
})
