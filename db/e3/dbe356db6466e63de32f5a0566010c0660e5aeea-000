import { useState } from 'react'

// État + logique de soumission partagés par les modales « colle un lien par ligne » (Liens YouTube, Liens
// audio YouTube, Liens Google Maps — menu New > Importer). AVANT cette extraction, chacune des 3 dupliquait
// le même quintuplet useState (modalOpen/linksText/busy/progress + éventuellement un flag de mode) ET la
// même fonction async submitXLinks (appeler le batch creator, fusionner les nouveaux chemins dans l'index de
// recherche global `paths`, invalider le cache du dossier courant + recharger, fermer+vider la modale) —
// seul le batch creator appelé et le texte de la notification finale changeaient réellement.
//
// Ce hook porte le quintuplet + la mécanique de soumission ; l'appelant ne garde que sa propre notify() (via
// `onImported`, invoqué une fois le refresh optimiste déjà fait) et le rendu visuel (icône/couleur/texte),
// lui aussi partagé par le composant frère `LinkImportModal.jsx`.
//
// @param createBatchFn (text, folder, onProgress) => Promise<Array<{ok:boolean, nodePath?:string}>>
//   Déjà lié aux options propres à sa variante (ex. {audioOnly:true} pour Liens audio YouTube — cf. App.jsx).
// @param ctx.folder        dossier courant (destination du batch), relu à chaque submit (pas figé à l'ouverture).
// @param ctx.pathsRef       miroir synchrone de `paths` (même convention que le reste d'App.jsx).
// @param ctx.setPaths       setter React de `paths`.
// @param ctx.dropDirCache   invalide le cache SWR du dossier de destination.
// @param ctx.loadDir        recharge le dossier de destination depuis le serveur.
// @param ctx.onImported(okList, failList)  appelé après le refresh optimiste — l'appelant y construit sa
//   propre notify() (icône/tint/libellé diffèrent par type de lien).
export function useLinkImportModal(createBatchFn, ctx = {}) {
  const { folder, pathsRef, setPaths, dropDirCache, loadDir, onImported } = ctx
  const [open, setOpen] = useState(false)
  const [text, setText] = useState('')
  const [busy, setBusy] = useState(false)
  const [progress, setProgress] = useState(0)

  const submit = async () => {
    const value = text.trim()
    if (!value || busy) return
    setBusy(true); setProgress(0)
    try {
      const results = await createBatchFn(value, folder, setProgress)
      const okList = results.filter((r) => r.ok)
      const failList = results.filter((r) => !r.ok)
      setOpen(false); setText('')
      if (okList.length) {
        const newPaths = okList.map((r) => r.nodePath)
        const merged = Array.from(new Set([...(pathsRef.current || []), ...newPaths]))
        pathsRef.current = merged
        setPaths(merged)
        dropDirCache(folder)
        loadDir(folder)
      }
      if (onImported) onImported(okList, failList)
    } finally { setBusy(false); setProgress(0) }
  }

  return { open, setOpen, text, setText, busy, progress, submit }
}
