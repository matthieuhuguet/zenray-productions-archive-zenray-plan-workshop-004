async function captureVideoLocalCmd(file, folder, onProgress, reason) {
  const dest = destFolder(folder)
  if (onProgress) onProgress(1)
  try {
    const r = await fetch(`/api/upload-cmd?dest=${encodeURIComponent(dest)}&name=${encodeURIComponent(file.name)}`)
      .then((x) => x.json()).catch(() => null)
    if (r && r.ok && r.cmd) {
      const copied = copyToClipboard(r.cmd)
      const why = reason ? ' (' + reason + ')' : ''
      notify({
        icon: 'film', tint: '#d97757', label: 'Vidéo · transcodage local', big: true,
        title: copied ? 'Vidéo — 2 étapes pour l’importer' : 'Copie auto bloquée — clique Copier',
        body: `« ${file.name} »${why}\n\n1. Place le fichier dans ~/Downloads (s'il n'y est pas déjà).\n2. Colle la commande ci-dessous dans le Terminal${copied ? ' (déjà copiée dans le presse-papier)' : ' (utilise le bouton Copier)'}.\n\nLa vidéo apparaîtra dans « ${dest} » dès que le transcodage HLS est poussé.`,
        cmd: r.cmd,
        actions: [{ label: copied ? 'Recopier la commande' : 'Copier la commande', primary: true, onClick: () => copyToClipboard(r.cmd) }],
      })
    } else {
      notify({ icon: 'exclamationmark.triangle', tint: '#FF3B30', label: 'Vidéo · transcodage local', title: 'Commande indisponible', body: `${file.name} : impossible de générer la commande (${(r && r.error) || 'endpoint injoignable'}).`, ttl: 14000 })
    }
  } catch (e) {
    notify({ icon: 'exclamationmark.triangle', tint: '#FF3B30', label: 'Vidéo · transcodage local', title: 'Commande indisponible', body: `${file.name} : erreur lors de la génération de la commande. ${(e && e.message) || String(e)}`, ttl: 14000 })
  }
  // No node created -> no buggy placeholder, nothing to index. Dedicated type for the App.jsx toast.
  return { ok: true, type: 'video-cmd', name: file.name }
}

// Robust shared clipboard copy. Tries the modern API (needs HTTPS + focus), falls back to
// textarea + execCommand when blocked (http://localhost, lost focus, permission). Returns a
// best-effort 'copied' boolean. navigator.clipboard.writeText is async: fire the modern attempt
// without awaiting (so the notification renders immediately) and guarantee the synchronous fallback.
function copyToClipboard(text) {
  const s = String(text || '')
  try {
    if (typeof navigator !== 'undefined' && navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(s).catch(() => fallbackCopy(s))
      return true
    }
  } catch { /* fall through */ }
  return fallbackCopy(s)
}
function fallbackCopy(s) {
  try {
    const ta = document.createElement('textarea')
    ta.value = s
    ta.style.position = 'fixed'; ta.style.opacity = '0'
    document.body.appendChild(ta); ta.select()
    const ok = document.execCommand('copy')
    ta.remove()
    return !!ok
  } catch { return false }
}

// Guess artist / title from an "Artist - Title.ext" filename.
function guessMeta(name = '') {
  const base = name.replace(/\.[^.]+$/, '')
  const m = base.match(/^\s*(.+?)\s*-\s*(.+?)\s*$/)
  if (m) return { artist: m[1], title: m[2] }
  return { artist: '', title: base }
}

// AUDIO (mp3/wav/flac/m4a/opus/ogg…): nouvelles écritures au contrat v3 unique.
// Music découvre les nœuds .media.json via l'index public ; l'ancien audio/manifest.json plat
// n'est plus écrit (deux sources de vérité et un commit supplémentaire par import).
async function captureAudio(file, folder, mime, onProgress) {
  if (!file || !Number.isSafeInteger(file.size) || file.size <= 0) throw new Error('fichier audio vide ou invalide')
  const realMime = mime || file.type || 'audio/mpeg'
  if (!String(realMime).startsWith('audio/')) throw new Error(`type audio invalide: ${realMime}`)
  const duration = await audioDuration(file)
  const { cdnRepo, cdnCommit, dir, parts, size, ivs, chunkSize } = await uploadBinaryChunksEncrypted(file, 'audio', onProgress)
  const { artist, title } = guessMeta(file.name)
  // chunkSize RÉEL (19 MiB/95 Mo, politique 2026-07-21) -- plus jamais CHUNK_SIZE transport (3 Mo).
  const manifest = buildAudioManifestV3({ name: file.name, title, artist, mime: realMime, size, chunkSize, cdnRepo, cdnCommit, dir, parts, ivs, duration })
  const nodePath = `${destFolder(folder)}/${sanitize(file.name)}.${rand()}.media.json`
  await writeNode(nodePath, JSON.stringify(manifest))

  if (onProgress) onProgress(1)
  return { ok: true, type: 'audio', nodePath, name: file.name }
}

// Generic binary media (pdf, other): chunked + .media.json node (fitting mime).
async function captureBinaryMedia(file, folder, mime, onProgress, kind = 'doc', onStage) {
  const { cdnRepo, cdnCommit, dir, parts, count, size, ivs, chunkSize } = await uploadBinaryChunksEncrypted(file, kind, onProgress, onStage)
  const manifest = {
    type: 'chunked-media', v: 1, name: file.name, mime: mime || file.type || 'application/octet-stream',
    size, chunkSize, count, dir, parts,
    vis: 'public', cdnRepo, cdnCommit, alg: 'AES-GCM', ivs,
    probe: { duration: 0, audio: [], subs: [] },
  }
  const nodePath = `${destFolder(folder)}/${sanitize(file.name)}.${rand()}.media.json`
  onStage?.('saving')
  await writeNode(nodePath, JSON.stringify(manifest))
  if (onProgress) onProgress(1)
  return { ok: true, type: 'media', nodePath, name: file.name }
}

// TEXT (.md/.txt, text/markdown): create a .md page with the raw text.
async function captureText(file, folder, onProgress) {
  const text = await file.text()
