// --- main router ---------------------------------------------------------------

async function routeFile(file, folder, onProgress, mode, vis) {
  const mime = file.type || ''
  const ext = extOf(file.name, mime)

  // CLASSIFICATION: delegated 100% to classify.js (pure module, single source of truth, shared
  // with bulk Node and mobile). routeFile no longer contains a decision cascade — it only PLUGS
  // the pipeline into the right capturer. All side effects (localhost gating, notify, vis) stay
  // HERE, because they cannot live in an isomorphic module (Node has neither location nor notify).
  const { kind, pipeline } = classify({ name: file.name, mime })

  switch (pipeline) {
    case 'img':
      return captureImage(file, folder, onProgress, vis)

    case 'hls': {
      // VIDEO = ONE local path: NATIVE DRAG-DROP. The local server transcodes with native ffmpeg
      // (remux/VideoToolbox) and streams live progress. Outside localhost (no native server),
      // video import is not possible: clear message. This gating + notify ARE side effects: they
      // stay in routeFile, never in classify (Node has neither location nor notify -> would break
      // bulk import).
      const onLocal = typeof location !== 'undefined' && /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname)
      if (onLocal) return captureVideoServerHls(file, folder, onProgress)
      notify({ icon: 'film', tint: '#FF9F0A', label: 'Vidéo', title: 'Import vidéo : app locale requise', body: `${file.name} : le transcodage vidéo se fait par le serveur local (localhost). Ouvre l'app en local pour importer des vidéos.`, ttl: 12000 })
      return { ok: false, type: 'video-skipped', name: file.name }
    }

    case 'media':
      // The 'media' pipeline covers TWO kinds: audio and pdf. Distinguished by `kind` (from classify).
      if (kind === 'pdf') {
        return captureBinaryMedia(file, folder, 'application/pdf', onProgress, 'pdf') // dedicated pdf/public family
      }
      // AUDIO: if the MIME is not audio/* (bare .wav/.flac/.ogg extension), derive it from the
      // extension. Otherwise (audio/* mime already present) pass it through — identical to the old cascade.
      return captureAudio(file, folder, mime.startsWith('audio/') ? mime : (AUDIO_MIME_BY_EXT[ext] || 'audio/mpeg'), onProgress)

    case 'text':
      return captureText(file, folder, onProgress)

    case 'chunk':
    default:
      // ONLY case producing raw binary pieces: non-openable formats (projects, zip, RAW, proprietary).
      return captureBinaryMedia(file, folder, mime || 'application/octet-stream', onProgress)
  }
}

// Add freshly created node paths to the search index (pages/.zr-search-index.json), in ONE commit
// for the whole dropped batch. Best-effort: a failure never invalidates the import (the node is
// already written and visible in the Finder via the current-folder refresh). Without this, the
// global SEARCH would only see the new file after a manual index rebuild.
async function addToSearchIndex(paths) {
  const list = (paths || []).filter(Boolean)
  if (!list.length) return
  try {
    await fetch('/api/page', {
      method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ action: 'index-add', paths: list }),
    })
  } catch (e) {
    // Best-effort (the node is already written and visible in the Finder), but LEAVE A TRACE:
    // without it, a failure would leave the file invisible to global search until the next manual
    // rebuild, with no usable signal.
    console.warn('[capture] mise à jour de l’index de recherche échouée', e)
  }
}

// Public API: processes each File, resilient, returns an array of results.
// results[i] = { ok, type, nodePath?, name, error? }
// P2 — Files are processed IN PARALLEL by a small pool (FILE_CONCURRENCY). This is SAFE because:
// the server already handles concurrent commits/rollover/counters (fast-forward retry + 5 GB
// margin, see upload-shard.js), the global putBlob semaphore caps blob writes, every audio writes
// its own .media.json, and the search index is updated only once after the batch. The win comes from
// OVERLAPPING per-file network round-trips (activeShard, commitShard, writeNode) and
// hash/thumbnail work. results[i] stays
// indexed by i -> input order PRESERVED whatever the completion order. Progress is AGGREGATED
// (mean of per-file ratios) -> smooth 0-to-1 bar over the whole batch instead of repeated 0->1 jumps.
export async function captureFiles(files, { folder, onProgress, mode, vis } = {}) {
  const list = Array.from(files || [])
  const results = new Array(list.length)
  const ratios = new Array(list.length).fill(0)
  const report = () => {
    if (!onProgress) return
    let s = 0; for (let k = 0; k < list.length; k++) s += ratios[k]
    onProgress(s / (list.length || 1))
  }
  let next = 0
  const worker = async () => {
    while (next < list.length) {
      const i = next++
      const file = list[i]
      try {
        const res = await routeFile(file, folder, (r) => { ratios[i] = typeof r === 'number' ? r : ratios[i]; report() }, mode, vis)
        results[i] = res
      } catch (e) {
        // 1 RETRY (2026-07-02): an isolated failure mid-batch is often transient (network blip,
        // GitHub conflict not covered by an internal retry). Before giving up on the file, retry
        // ONCE after a short delay — GitHub rate-limits are already handled upstream (shardApi),
        // this covers the rest.
        try {
          await new Promise((r) => setTimeout(r, 2500))
          const res2 = await routeFile(file, folder, (r) => { ratios[i] = typeof r === 'number' ? r : ratios[i]; report() }, mode, vis)
          results[i] = res2
        } catch (e2) {
          results[i] = { ok: false, type: 'error', name: file && file.name, error: (e2 && e2.message) || (e && e.message) || String(e2 || e) }
        }
      }
      ratios[i] = 1; report() // file finished (success OR failure): its share is 1, the bar moves decisively
    }
  }
  const FILE_CONCURRENCY = 4
  await Promise.all(Array.from({ length: Math.min(FILE_CONCURRENCY, list.length) }, worker))
  // Search index: 1 commit for ALL nodes created in this batch. In the background (no blocking
  // await: the function returns immediately, the Finder refreshes without waiting for the index).
  const nodePaths = results.filter((r) => r && r.ok && r.nodePath).map((r) => r.nodePath)
  if (nodePaths.length) addToSearchIndex(nodePaths)
  return results
}

// Preserve every attachment as its original bytes, including text and video. (19 October 2026, 00:32 Paris)
export async function captureAttachment(file, { folder, onProgress, onStage } = {}) {
  validateAttachment(file)
  const result = await captureBinaryMedia(file, folder, file.type, onProgress, 'doc', onStage)
  addToSearchIndex([result.nodePath])
  return result
}
