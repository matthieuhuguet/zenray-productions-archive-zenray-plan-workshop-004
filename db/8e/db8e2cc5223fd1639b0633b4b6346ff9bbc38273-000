import { afterEach, describe, expect, it, vi } from 'vitest'
import {
  appendShareCredential,
  createShareLink,
  decodeLegacyShare,
  encodeLegacyShare,
  resolveShareToken,
  SHARE_KIND,
} from './shareLinks.js'

afterEach(() => vi.restoreAllMocks())

describe('shareLinks client contract', () => {
  it('round-trips old UTF-8 links without a network request', async () => {
    const path = 'pages/Photos/29 Juin 2026/Été.jpg.img.json'
    const token = encodeLegacyShare(path)
    expect(decodeLegacyShare(token)).toBe(path)
    const fetchMock = vi.spyOn(globalThis, 'fetch')
    await expect(resolveShareToken(token, SHARE_KIND.image)).resolves.toMatchObject({ path, legacy: true })
    expect(fetchMock).not.toHaveBeenCalled()
  })

  it('resolves opaque tokens through the public endpoint', async () => {
    const fetchMock = vi.spyOn(globalThis, 'fetch').mockResolvedValue({
      ok: true, status: 200,
      json: async () => ({ path: 'pages/Videos/demo.mp4.media.json', kind: 'video', expiresAt: '2026-08-01T00:00:00.000Z' }),
    })
    await expect(resolveShareToken('zrs1.id.signature', SHARE_KIND.video)).resolves.toMatchObject({ path: 'pages/Videos/demo.mp4.media.json' })
    expect(fetchMock.mock.calls[0][0]).toContain('/api/share-token?')
  })

  it('creates new URLs only from a server-issued opaque token', async () => {
    vi.spyOn(globalThis, 'fetch').mockResolvedValue({
      ok: true, status: 201,
      json: async () => ({ token: 'zrs1.id.signature', expiresAt: '2026-08-01T00:00:00.000Z' }),
    })
    const result = await createShareLink(SHARE_KIND.folder, 'pages/Photos/Trip')
    expect(result.url).toBe('http://localhost:3000/folder?d=zrs1.id.signature')
    expect(result.url).not.toContain('Photos')
  })

  it('adds the credential without dropping existing query parameters', () => {
    expect(appendShareCredential('/api/page?action=read', 'abc')).toBe('/api/page?action=read&share=abc')
  })
})

// Permanence is opt-in for Calendar viewers. (19 October 2026, 01:14 Paris)
it('passes the permanent option to the signed share endpoint', async () => {
  const request = vi.spyOn(globalThis, 'fetch').mockResolvedValue({ ok: true, json: async () => ({ token: 'signed', expiresAt: null }) })
  await createShareLink('video', 'pages/Movies/movie.media.json', { permanent: true })
  expect(JSON.parse(request.mock.calls[0][1].body)).toMatchObject({ kind: 'video', permanent: true })
})
