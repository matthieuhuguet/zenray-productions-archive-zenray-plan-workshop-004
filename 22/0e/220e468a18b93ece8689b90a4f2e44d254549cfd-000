// 10 October 2026, 21:06 CEST: Restore a verified private cloud video from its recovery receipt and verify SHA-256.
import fs from 'node:fs'
import { restoreVideoCloud } from './lib/video-cloud-recovery.mjs'

const [receiptPath, destination] = process.argv.slice(2)
if (!receiptPath) {
  throw new Error('Usage: RestoreVideoCloud.mjs <receiptPath> [destination]')
}
const receipt = JSON.parse(fs.readFileSync(receiptPath, 'utf8'))
if (!receipt.manifestPath) {
  throw new Error('Receipt is missing manifestPath')
}
await restoreVideoCloud({
  receiptPath,
  manifestPath: receipt.manifestPath,
  destination: destination || receipt.source,
})
