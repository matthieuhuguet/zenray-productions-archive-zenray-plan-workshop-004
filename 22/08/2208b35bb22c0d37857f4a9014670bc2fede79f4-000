                          onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { pathStrokeColor: e.target.value }))} />
                        <span />
                      </div>
                      <div className="zrm-det-row">
                        <span className="zrm-det-lab">Épaisseur</span>
                        <input className="zrm-det-in" type="range" min="0.5" max="20" step="0.5" aria-label="Épaisseur du contour du tracé"
                          value={calqueSelectionne.pathStrokeWidth} style={{ accentColor: UI.blue }}
                          onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { pathStrokeWidth: Number(e.target.value) }))} />
                        <span className="zrm-tree-tag">{calqueSelectionne.pathStrokeWidth}px</span>
                      </div>
                      <div className="zrm-det-row">
                        <span className="zrm-det-lab">Tracé fermé</span>
                        <button className="zrm-tool" style={{ height: 22 }} data-on={calqueSelectionne.pathClosed}
                          title="Fermer ou rouvrir le tracé"
                          onClick={() => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { pathClosed: !calqueSelectionne.pathClosed }))}>
                          {calqueSelectionne.pathClosed ? 'Fermé' : 'Ouvert'}
                        </button>
                        <span />
                      </div>
                    </>
                  )}
                </>
              )}
            </>
          )}

          {deckTab === 'details' && !modeGroupe && !noeudSelectionne && !calqueSelectionne && (!pieceSelectionnee ? (
            preflightOuvert ? (() => {
              // FAMILLE INDESIGN D8 · LE PANNEAU DE CONTRÔLE EN AMONT. Porte sur la diapositive
              // ACTIVE, celle réellement rendue à l'écran (même portée que le texte en excès,
              // carte D3) : balayer les diapositives une à une contrôle tout le document, comme on
              // les parcourt déjà pour les prévisualiser. Cliquer un point sélectionne le calque en
              // cause, exactement comme n'importe quelle autre pièce de la Hiérarchie.
              const LIBELLES = {
                'texte-en-exces': 'Texte en excès',
                'source-manquante': 'Image sans source',
                'lien-rompu': 'Le lien de cette image ne charge pas',
                'basse-resolution': 'Résolution trop basse pour la taille affichée',
              }
              const points = preflightPoints
              return (
                <div className="zrm-det-empty" style={{ textAlign: 'left' }}>
                  <div className="zrm-det-obj">
                    <span className="zrm-tree-glyph">{points.length ? '!' : '✓'}</span>
                    <span style={{ fontWeight: 600 }}>Contrôle en amont</span>
                  </div>
                  {points.length === 0 ? (
                    <p style={{ opacity: .7, margin: '4px 0 0', lineHeight: 1.5 }}>
                      Rien à signaler : cette diapositive est prête pour l’export.
                    </p>
                  ) : points.map((point, i) => {
                    const calque = findLayer(composition, point.id)
                    return (
                      <button key={`${point.id}-${i}`} className="zrm-tree-row" style={{ width: '100%' }}
                        onClick={() => { setSelectedComponent(point.id); setDeckTab('details') }}>
                        <span className="zrm-tree-glyph">!</span>
                        <span className="zrm-tree-name">{calque?.name || point.id}</span>
                        <span className="zrm-tree-tag">{LIBELLES[point.kind] || point.kind}</span>
                      </button>
                    )
                  })}
                </div>
              )
            })() : objetHerite ? (
              // FAMILLE INDESIGN D1 · LE PANNEAU D'UN OBJET HÉRITÉ. Volontairement DISTINCT du
              // panneau générique d'un calque : un remplacement local ne touche que la POSITION,
              // la TAILLE, l'OPACITÉ et la VISIBILITÉ sur cette diapositive — un sous-ensemble
              // assumé par écrit (KANBAN.md), pas la totalité des réglages qu'un vrai calque porte.
              <div className="zrm-det-empty" style={{ textAlign: 'left', lineHeight: 1.5 }}>
                <div className="zrm-det-obj">
                  <span className="zrm-tree-glyph">{{ text: 'T', image: '▣', shape: '◼', component: '◈', table: '▦' }[objetHerite.kind]}</span>
                  <span style={{ fontWeight: 600 }}>{objetHerite.name}</span>
                  <span className="zrm-tree-tag">{objetHerite.overridden ? 'remplacé ici' : 'hérité'}</span>
                </div>
                <p style={{ opacity: .75, margin: '4px 0 10px' }}>
                  Objet de la page parente. Un remplacement local ne change que CETTE diapositive :
                  les autres, et la page parente elle-même, restent intactes.
                </p>
                {[['x', 'Position X'], ['y', 'Position Y'], ['w', 'Largeur'], ['h', 'Hauteur']].map(([clef, libelle]) => (
                  <div key={clef} className="zrm-det-row">
                    <span className="zrm-det-lab">{libelle}</span>
                    <input className="zrm-det-in" type="number" aria-label={libelle} value={objetHerite[clef]}
                      onChange={(e) => patchObjetHerite({ [clef]: (clef === 'w' || clef === 'h') ? Math.max(1, Number(e.target.value)) : Number(e.target.value) })} />
                    <span />
                  </div>
                ))}
                <div className="zrm-det-row">
                  <span className="zrm-det-lab">Opacité</span>
                  <input className="zrm-det-in" type="range" min="0" max="1" step="0.01" aria-label="Opacité"
                    value={objetHerite.opacity} style={{ accentColor: UI.blue }}
                    onChange={(e) => patchObjetHerite({ opacity: Number(e.target.value) })} />
                  <span className="zrm-tree-tag">{Math.round(objetHerite.opacity * 100)}%</span>
                </div>
                <div className="zrm-det-row">
                  <span className="zrm-det-lab">Sur cette diapositive</span>
                  <button className="zrm-tool" style={{ height: 22 }} data-on={objetHerite.hidden}
                    title="Masquer cet objet SEULEMENT ici, sans toucher à la page parente"
                    onClick={() => patchObjetHerite({ hidden: !objetHerite.hidden })}>
                    {objetHerite.hidden ? 'Masqué ici' : 'Visible'}
                  </button>
                  <span />
                </div>
                <div className="zrm-det-row" style={{ gap: 6 }}>
                  {objetHerite.overridden && (
                    <button className="zrm-tool" onClick={retablirObjetHerite} title="Effacer le remplacement local, revenir à la page parente">
                      Rétablir l’état hérité
                    </button>
                  )}
                  <button className="zrm-tool" onClick={detacherObjetHerite} title="Rompre tout lien : devient un calque réel et indépendant sur cette diapositive">
                    Détacher
                  </button>
                </div>
              </div>
            ) : selectedTextStyleId ? (() => {
              // FAMILLE INDESIGN D4 · LE PANNEAU D'UN STYLE DE TEXTE. Règle la DÉFINITION partagée
              // elle-même (`patchTextStyle`), jamais un calque précis : c'est ce qui distingue ce
              // panneau du panneau générique Typographie d'un calque, lequel écrit toujours dans
              // un remplacement LOCAL. Les deux se lisent avec le même vocabulaire de champs
              // (`TEXT_STYLE_KEYS`) pour ne jamais surprendre en passant de l'un à l'autre.
              const style = readTextStyles(composition).find((s) => s.id === selectedTextStyleId)
              if (!style) return (
                <div className="zrm-det-empty">Aucune pièce sélectionnée.<br />Clique une pièce dans la Hiérarchie ou dans l’aperçu.</div>
              )
              return (
                <div className="zrm-det-empty" style={{ textAlign: 'left' }}>
                  <div className="zrm-det-obj">
                    <span className="zrm-tree-glyph">Aa</span>
                    <input value={style.name} aria-label="Nom du style de texte"
                      onChange={(e) => patchComposition((c) => patchTextStyle(c, style.id, { name: e.target.value }))} />
                    <span>style de texte</span>
                  </div>
                  {LAYER_STYLES.filter((champ) => TEXT_STYLE_KEYS.includes(champ.key)).map((champ) => {
                    const pose = style.style[champ.key] || ''
                    return (
                      <div key={champ.key} className="zrm-det-row">
                        <span className="zrm-det-lab">{champ.label}</span>
                        {champ.type === 'select' ? (
                          <select className="zrm-det-in" aria-label={champ.label} value={pose}
                            onChange={(e) => patchComposition((c) => patchTextStyle(c, style.id, { style: { [champ.key]: e.target.value } }))}>
                            {champ.options.map((o) => <option key={o} value={o}>{o || '—'}</option>)}
                          </select>
                        ) : (
                          <input className="zrm-det-in" type={champ.type === 'color' ? 'color' : 'text'}
                            aria-label={champ.label} placeholder={champ.hint || ''} value={pose}
                            onChange={(e) => patchComposition((c) => patchTextStyle(c, style.id, { style: { [champ.key]: e.target.value } }))} />
                        )}
                        {pose ? (
                          <button className="zrm-det-revert" title="Retirer ce réglage du style"
                            onClick={() => patchComposition((c) => patchTextStyle(c, style.id, { style: { [champ.key]: '' } }))}>
                            <Icon name="arrow.uturn.backward" size={10} />
                          </button>
                        ) : <span />}
                      </div>
                    )
                  })}
                  <p style={{ opacity: .7, margin: '8px 0 0', lineHeight: 1.5 }}>
                    Chaque champ réglé ici change TOUS les calques qui appliquent ce style, sauf ceux
                    qui l’ont remplacé localement sur ce point précis.
                  </p>
                </div>
              )
            })() : selectedObjectStyleId ? (() => {
              // FAMILLE INDESIGN D7 · LE PANNEAU D'UN STYLE D'OBJET, même principe que celui d'un
              // style de texte : règle la DÉFINITION partagée (`patchObjectStyle`), jamais un calque
              // précis. `OBJECT_STYLE_KEYS` filtre les MÊMES `LAYER_STYLES` sur le sous-ensemble
              // apparence, disjoint de celui de la typographie.
              const style = readObjectStyles(composition).find((s) => s.id === selectedObjectStyleId)
              if (!style) return (
                <div className="zrm-det-empty">Aucune pièce sélectionnée.<br />Clique une pièce dans la Hiérarchie ou dans l’aperçu.</div>
              )
              return (
                <div className="zrm-det-empty" style={{ textAlign: 'left' }}>
                  <div className="zrm-det-obj">
                    <span className="zrm-tree-glyph">▥</span>
                    <input value={style.name} aria-label="Nom du style d’objet"
                      onChange={(e) => patchComposition((c) => patchObjectStyle(c, style.id, { name: e.target.value }))} />
                    <span>style d’objet</span>
                  </div>
                  {LAYER_STYLES.filter((champ) => OBJECT_STYLE_KEYS.includes(champ.key)).map((champ) => {
                    const pose = style.style[champ.key] || ''
                    return (
                      <div key={champ.key} className="zrm-det-row">
                        <span className="zrm-det-lab">{champ.label}</span>
                        {champ.type === 'select' ? (
                          <select className="zrm-det-in" aria-label={champ.label} value={pose}
                            onChange={(e) => patchComposition((c) => patchObjectStyle(c, style.id, { style: { [champ.key]: e.target.value } }))}>
                            {champ.options.map((o) => <option key={o} value={o}>{o || '—'}</option>)}
                          </select>
                        ) : (
                          <input className="zrm-det-in" type={champ.type === 'color' ? 'color' : 'text'}
                            aria-label={champ.label} placeholder={champ.hint || ''} value={pose}
                            onChange={(e) => patchComposition((c) => patchObjectStyle(c, style.id, { style: { [champ.key]: e.target.value } }))} />
                        )}
                        {pose ? (
                          <button className="zrm-det-revert" title="Retirer ce réglage du style"
                            onClick={() => patchComposition((c) => patchObjectStyle(c, style.id, { style: { [champ.key]: '' } }))}>
                            <Icon name="arrow.uturn.backward" size={10} />
                          </button>
                        ) : <span />}
                      </div>
                    )
                  })}
                  <p style={{ opacity: .7, margin: '8px 0 0', lineHeight: 1.5 }}>
                    Chaque champ réglé ici change TOUS les calques qui appliquent ce style, sauf ceux
                    qui l’ont remplacé localement sur ce point précis.
                  </p>
                </div>
              )
            })() : composition.activeSlideId ? (() => {
              // FAMILLE INDESIGN D1 · LE PANNEAU D'UNE DIAPOSITIVE ACTIVE, sans rien sélectionné
              // dessus : c'est ici, et nulle part ailleurs, qu'on choisit SA page parente.
              const diapo = readSlides(composition).find((s) => s.id === composition.activeSlideId)
              if (!diapo) return (
                <div className="zrm-det-empty">Aucune pièce sélectionnée.<br />Clique une pièce dans la Hiérarchie ou dans l’aperçu.</div>
              )
              return (
                <div className="zrm-det-empty" style={{ textAlign: 'left' }}>
                  <div className="zrm-det-obj">
                    <span className="zrm-tree-glyph">▦</span>
                    <span style={{ fontWeight: 600 }}>{diapo.name}</span>
                  </div>
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Page parente</span>
                    <select className="zrm-det-in" aria-label="Page parente de la diapositive" value={diapo.parentPageId || ''}
                      onChange={(e) => patchComposition((c) => setSlideParent(c, diapo.id, e.target.value || null))}>
                      <option value="">[Sans]</option>
                      {readParentPages(composition).map((p) => <option key={p.id} value={p.id}>{p.name}</option>)}
                    </select>
                    <span />
                  </div>
                  {diapo.parentPageId && (
                    <div className="zrm-det-row">
                      <span className="zrm-det-lab">Éléments hérités</span>
                      <button className="zrm-tool" style={{ height: 22 }} data-on={diapo.masquerParent}
                        title="Masquer TEMPORAIREMENT tous les éléments hérités sur cette diapositive, sans détacher ni désappliquer la page parente"
                        onClick={() => patchComposition((c) => setSlideParentHidden(c, diapo.id, !diapo.masquerParent))}>
                        {diapo.masquerParent ? 'Masqués' : 'Visibles'}
                      </button>
                      <span />
                    </div>
                  )}
                  <p style={{ opacity: .7, margin: '8px 0 0', lineHeight: 1.5 }}>
                    Clique un objet en pointillés sur le canevas pour le remplacer localement ou le détacher.
                  </p>
                </div>
              )
            })() : (
              <div className="zrm-det-empty">
                Aucune pièce sélectionnée.<br />Clique une pièce dans la Hiérarchie ou dans l’aperçu.
              </div>
            )
          ) : (
            <>
              <div className="zrm-det-obj">
                <span className="zrm-tree-glyph">{pieceSelectionnee.kind === 'image' ? '▣' : 'T'}</span>
                <input value={pieceSelectionnee.name} aria-label="Nom de la pièce"
                  onChange={(e) => patchComposition((current) => patchItem(current, pieceSelectionnee.id, { name: e.target.value }))} />
                <span>{pieceSelectionnee.componentId || pieceSelectionnee.kind}</span>
                <VerrouPanneau verrouille={panelLockedId === idPourPanneau} onClick={() => setPanelLockedId((v) => (v ? null : idPourPanneau))} />
              </div>

              {[
                ['emplacement', 'Emplacement', null],
                ['contenu', 'Contenu', champsDeclares.filter((c) => c.type !== 'color')],
                ['apparence', 'Apparence', champsDeclares.filter((c) => c.type === 'color')],
              ].map(([cle, titre, champs]) => {
                if (champs && champs.length === 0) return null
                const ouvert = detSections[cle] !== false
                return (
                  <div key={cle}>
                    <button className="zrm-det-sec" onClick={() => setDetSections((s) => ({ ...s, [cle]: !ouvert }))}>
                      <span className="zrm-twist" data-open={ouvert}><Icon name="chevron.right" size={9} /></span>{titre}
                    </button>
                    {ouvert && cle === 'emplacement' && (
                      <>
                        {/* Ces trois-là se LISENT et ne s'écrivent pas : la place d'une pièce se
                            change en la faisant glisser par ses quatre côtés, et un champ qui
                            dupliquerait ce geste ouvrirait deux vérités pour une seule position. */}
                        <div className="zrm-det-row"><span className="zrm-det-lab">Rangée</span>
                          <span className="zrm-det-lab" style={{ opacity: .8 }}>{composition.rows.findIndex((r) => r.items.some((it) => it.id === pieceSelectionnee.id)) + 1}</span><span /></div>
                        <div className="zrm-det-row"><span className="zrm-det-lab">Visible</span>
                          <input className="zrm-det-in" type="checkbox" style={{ width: 14, height: 14, accentColor: UI.blue }} checked={!pieceSelectionnee.hidden}
                            onChange={() => patchComposition((c) => patchItem(c, pieceSelectionnee.id, { hidden: !pieceSelectionnee.hidden }))} /><span /></div>
                        <div className="zrm-det-row"><span className="zrm-det-lab">Verrouillé</span>
                          <input className="zrm-det-in" type="checkbox" style={{ width: 14, height: 14, accentColor: UI.blue }} checked={!!pieceSelectionnee.locked}
                            onChange={() => patchComposition((c) => patchItem(c, pieceSelectionnee.id, { locked: !pieceSelectionnee.locked }))} /><span /></div>
                      </>
                    )}
                    {ouvert && champs && champs.map((champ) => {
                      const pose = pieceSelectionnee.props?.[champ.key]
                      return (
                        <div key={champ.key} className="zrm-det-row">
                          <span className="zrm-det-lab" title={champ.key}>{champ.label || champ.key}</span>
                          <input
                            className="zrm-det-in"
                            type={champ.type === 'color' ? 'color' : champ.type === 'number' ? 'number' : 'text'}
                            value={pose ?? ''}
                            placeholder="hérité du brief"
                            onChange={(e) => {
                              const valeur = e.target.value
                              patchComposition((current) => patchItem(current, pieceSelectionnee.id, {
                                props: { ...(pieceSelectionnee.props || {}), [champ.key]: valeur },
                              }))
                            }} />
                          {/* La flèche de retour n'apparaît QUE si la valeur diffère de l'héritage.
                              Vingt flèches grises en permanence ne signaleraient plus rien. */}
                          {pose ? (
                            <button className="zrm-det-revert" title="Revenir à la valeur du brief"
                              onClick={() => patchComposition((current) => patchItem(current, pieceSelectionnee.id, {
                                props: { ...(pieceSelectionnee.props || {}), [champ.key]: '' },
                              }))}><Icon name="arrow.uturn.backward" size={10} /></button>
                          ) : <span />}
                        </div>
                      )
                    })}
                  </div>
                )
              })}
              {champsDeclares.length === 0 && (
                <p className="zrm-det-empty">Ce composant ne déclare aucun champ modifiable. Il se règle par le thème.</p>
              )}
            </>
          ))}
          {/* L'onglet « Contenu », qui recueille le formulaire descendu de la Hiérarchie. Il est
              posé ICI et non ailleurs parce que c'est la place de la section « Content » chez
              Unreal : ce qu'on écrit, à côté de ce qui le met en forme. */}
          {deckTab === 'contenu' && (
            <>
          <div className="zrm-brief-divider"><span>Contenu de l’article</span></div>
          <label className="zrm-field">
            <span className="zrm-label">Titre</span>
            <input className="zrm-input" aria-label="Titre de travail" value={project.brief.title} onChange={(e) => patchBrief({ title: e.target.value })} />
            {errorFor('title') && <span className="zrm-error">{errorFor('title')}</span>}
          </label>

          <label className="zrm-field">
            <span className="zrm-label">Message — une seule phrase</span>
            <textarea className="zrm-textarea" aria-label="Message" style={{ minHeight: 58 }} value={project.brief.message} onChange={(e) => patchBrief({ message: e.target.value })} />
            {errorFor('message') && <span className="zrm-error">{errorFor('message')}</span>}
          </label>

          <label className="zrm-field">
            <span className="zrm-label">Public</span>
            <input className="zrm-input" aria-label="Public" value={project.brief.audience} onChange={(e) => patchBrief({ audience: e.target.value })} />
            {errorFor('audience') && <span className="zrm-error">{errorFor('audience')}</span>}
          </label>

          {/* Les blocs de l'article, modifiables ici même. */}
          <div style={{ display: 'flex', alignItems: 'center', gap: 8, margin: '16px 0 8px' }}>
            <span className="zrm-label" style={{ margin: 0 }}>Blocs{cut ? ` · ${cut.beats.length}` : ''}</span>
            <span className="zrm-head-spacer" />
            {cut && <button className="zrm-btn zrm-btn-sm" onClick={() => withCut((c) => refitCut(c, theme))} disabled={cut.locked} title="Réajuster le nombre de blocs au thème">Réajuster</button>}
            {cut && <button className="zrm-btn zrm-btn-sm" data-on={cut.locked} onClick={() => withCut((c) => ({ ...c, locked: !c.locked }))} title="Un article verrouillé ne bouge plus quand on essaie d’autres thèmes">{cut.locked ? 'Verrouillé' : 'Verrouiller'}</button>}
          </div>

          {!cut ? (
            <p className="zrm-note">Aucun bloc. Colle tes notes plus bas puis « Monter l’article ».</p>
          ) : cut.beats.map((beat, i) => (
            <div key={beat.id} className="zrm-beat" data-on={i === selectedBeat} onFocusCapture={() => setSelectedBeat(i)}
              onDragOver={(e) => { if (e.dataTransfer.types.includes('Files')) { e.preventDefault(); e.currentTarget.dataset.drop = 'true' } }}
              onDragLeave={(e) => { delete e.currentTarget.dataset.drop }}
              onDrop={(e) => { if (e.dataTransfer.files?.length) { e.preventDefault(); delete e.currentTarget.dataset.drop; attachImages(i, e.dataTransfer.files) } }}>
              <div className="zrm-beat-top">
                <select className="zrm-beat-role" aria-label={`Rôle du bloc ${i + 1}`} value={beat.role} disabled={cut.locked} onChange={(e) => withCut((c) => updateBeat(c, i, { role: e.target.value }))}>
                  {BEAT_ROLES.map((r) => <option key={r} value={r}>{ROLE_LABELS[r]}</option>)}
                </select>
                <span className="zrm-beat-meta">
                  {i + 1}/{cut.beats.length}
                  {isTemporal(format) ? ` · ${beatDuration(beat)}s` : ''}
                </span>
              </div>
              <textarea className="zrm-beat-text" aria-label={`Texte du bloc ${i + 1}`} value={beat.text} disabled={cut.locked} onChange={(e) => withCut((c) => updateBeat(c, i, { text: e.target.value }))} />
              {(beat.slots || []).length > 0 && (
                <div className="zrm-slots-strip">
                  {beat.slots.map((slot, si) => (
                    <div key={si} className="zrm-slot-thumb" title={slot.label || 'image'}>
                      {slot.dataUrl ? <img src={slot.dataUrl} alt={slot.label || ''} /> : <span>{slot.kind}</span>}
                      <button className="zrm-slot-remove" title="Retirer l’image" disabled={cut.locked} onClick={() => withCut((c) => removeSlot(c, i, si))}>×</button>
                    </div>
                  ))}
                </div>
              )}
              <div className="zrm-beat-actions">
                <label className="zrm-btn zrm-btn-sm" title={`Ajouter une image (${(beat.slots || []).length}/${MAX_SLOTS})`} style={{ cursor: cut.locked || (beat.slots || []).length >= MAX_SLOTS ? 'not-allowed' : 'pointer' }}>
                  <Icon name="photo" size={12} />
                  <input type="file" accept="image/*" multiple aria-label={`Images du bloc ${i + 1}`} style={{ display: 'none' }}
                    disabled={cut.locked || (beat.slots || []).length >= MAX_SLOTS || busy === 'image'}
                    onChange={(e) => { attachImages(i, e.target.files); e.target.value = '' }} />
                </label>
                <button className="zrm-btn zrm-btn-sm" title="Monter" onClick={() => withCut((c) => moveBeat(c, i, Math.max(0, i - 1)))} disabled={cut.locked || i === 0}>↑</button>
                <button className="zrm-btn zrm-btn-sm" title="Descendre" onClick={() => withCut((c) => moveBeat(c, i, Math.min(cut.beats.length - 1, i + 1)))} disabled={cut.locked || i === cut.beats.length - 1}>↓</button>
                {/* AUDIT P1-R11 : `mergeBeats` refuse désormais la fusion qui dépasserait MAX_SLOTS —
                    le bouton s'efface pour ce cas précis plutôt que de laisser un clic n'aboutir à
                    rien de visible, la même « boîte qui ment » que R4 fermait pour les poignées. */}
                <button className="zrm-btn zrm-btn-sm" onClick={() => withCut((c) => mergeBeats(c, i))}
                  disabled={cut.locked || i >= cut.beats.length - 1 || ((beat.slots || []).length + (cut.beats[i + 1]?.slots || []).length) > MAX_SLOTS}>Fusionner</button>
                <button className="zrm-btn zrm-btn-sm" onClick={() => withCut((c) => splitBeat(c, i))} disabled={cut.locked}>Scinder</button>
                <button className="zrm-btn zrm-btn-sm" title="Insérer un bloc après" onClick={() => withCut((c) => addBeat(c, i))} disabled={cut.locked}>+</button>
                <button className="zrm-btn zrm-btn-sm" onClick={() => withCut((c) => removeBeat(c, i))} disabled={cut.locked || cut.beats.length <= 1}>Retirer</button>
              </div>
            </div>
          ))}

          <details style={{ marginTop: 14 }}>
            <summary className="zrm-label" style={{ cursor: 'pointer', marginBottom: 8 }}>Notes source</summary>
            <textarea className="zrm-textarea" aria-label="Notes" style={{ minHeight: 130 }} value={project.notes} onChange={(e) => patchProject({ notes: e.target.value })} />
            <div className="zrm-row" style={{ marginTop: 8 }}>
              <button className="zrm-btn zrm-btn-sm" onClick={buildCutNow} disabled={!theme}>Monter l’article</button>
              <button className="zrm-btn zrm-btn-sm" onClick={() => patchProject({ notes: SEED_NOTES })}>Notes d’exemple</button>
            </div>
            <p className="zrm-note" style={{ marginTop: 6 }}>Une ligne vide sépare deux blocs. Remonter l’article écrase les blocs modifiés à la main.</p>
          </details>
            </>
          )}

          {deckTab === 'create' && (
            <>
              {published && (
                <div className="zrm-verdict" data-ok="true" style={{ display: 'block' }}>
                  <div style={{ marginBottom: 6 }}>Publié · {published.indexed ? 'indexé' : 'indexation en attente'} · {formatBytes(published.bytes)}</div>
                  <div className="zrm-mono" style={{ wordBreak: 'break-all', marginBottom: 8 }}>{published.url}</div>
                  <div className="zrm-row">
                    <button className="zrm-btn zrm-btn-sm" onClick={async () => notify(await copyText(published.url) ? 'Adresse copiée.' : 'Copie refusée.', 'ok')}>Copier l’adresse</button>
                    <button className="zrm-btn zrm-btn-sm" onClick={() => window.dispatchEvent(new CustomEvent('zr:open-page', { detail: { path: published.path } }))}>Ouvrir la page</button>
                  </div>
                </div>
              )}
              <p className="zrm-note" style={{ marginBottom: 10 }}>
                <strong style={{ fontWeight: 500 }}>Enregistrer</strong> range la source dans ton index Create, à l’endroit que tu choisis, pour la rouvrir et continuer.
                {' '}<strong style={{ fontWeight: 500 }}>Publier l’article</strong> (bouton en bas de l’écran) écrit une page de texte figée à partir du Brief et du Cut — pas encore le média visuel composé ici. Même arborescence, deux gestes différents.
              </p>
              <CreateBrowser
                mode={browser === 'open' ? 'open' : 'save'}
                startDir={docPath ? dirOf(docPath) : DEFAULT_MEDIA_DIR}
                defaultName={docPath ? docPath.split('/').pop().replace('.zmedia.json', '') : slugify(project.brief.title)}
                busy={busy === 'save' || busy === 'open'}
                onCancel={() => setBrowser(null)}
                onConfirm={persist}
                onOpen={openDocument}
              />
              <div className="zrm-row" style={{ marginTop: 10 }}>
                <button className="zrm-btn zrm-btn-sm" data-on={browser !== 'open'} onClick={() => setBrowser('save')}>Enregistrer</button>
                <button className="zrm-btn zrm-btn-sm" data-on={browser === 'open'} onClick={() => setBrowser('open')}>Ouvrir</button>
              </div>
            </>
          )}

          {deckTab === 'sorties' && (
            <>
              <div className="zrm-verdict" data-ok={treeSummary.blocking === 0}>
                <Icon name={treeSummary.blocking === 0 ? 'checkmark' : 'hand.raised'} size={15} />
                {treeSummary.ready}/{treeSummary.total} sorties prêtes
                {treeSummary.blocking > 0 ? ` · ${treeSummary.blocking} défaut(s) bloquant(s)` : ''}
              </div>
              <p className="zrm-note" style={{ marginBottom: 10 }}>
                Le même article, décliné. Chaque branche porte son état réel : ce qu'elle montre, ce qu'elle laisse de côté, et le verdict du Critique — avant d'avoir cliqué.
              </p>
              {tree.map((group) => (
                <div key={group.id} className="zrm-family" data-open="true">
                  <div className="zrm-family-head" style={{ cursor: 'default' }}>
                    {group.label}<span className="zrm-family-count">{group.ready}/{group.total}</span>
                  </div>
                  {group.branches.map((b) => {
                    const advice = trimAdvice(cut, getFormat(b.formatId))
                    return (
                      <button key={b.formatId} className="zrm-theme" data-on={b.formatId === formatId}
                        onClick={() => { changeFormat(b.formatId); setActionCount((n) => n + 1) }}
                        title={b.declared ? b.label : `${b.label} — non déclaré par ce thème`}>
                        <span className="zrm-theme-chip" style={{ color: b.ready ? '#30d158' : '#ff453a' }}>{b.short}</span>
                        <span style={{ minWidth: 0 }}>
                          <span className="zrm-theme-name">{b.label}{b.declared ? '' : ' ·'}</span>
                          <span className="zrm-theme-sub">
                            {b.shown}/{b.total} blocs
                            {b.duration ? ` · ${b.duration}s` : ''}
                            {b.blocking ? ` · ${b.blocking} bloquant` : (b.warnings ? ` · ${b.warnings} avert.` : ' · prêt')}
                            {advice ? ` · ${advice.words} mots hors cadre` : ''}
                          </span>
                        </span>
                      </button>
                    )
                  })}
                </div>
              ))}
              {treeSummary.undeclared.length > 0 && (
                <p className="zrm-note" style={{ marginTop: 8 }}>
                  Les sorties marquées « · » ne sont pas déclarées par « {theme?.name} » : elles rendront, mais approximativement.
                </p>
              )}
            </>
          )}

          {/* L'onglet « Thèmes » a quitté ce panneau pour la palette le 2026-08-04 : on choisit une
              matière dans la palette, on règle dans les détails. Le laisser aux deux endroits
              aurait été le troisième doublon de la journée. */}
          {deckTab === 'critic' && (
            <>
              <div className="zrm-verdict" data-ok={verdict.canPublish}>
                <Icon name={verdict.canPublish ? 'checkmark' : 'hand.raised'} size={15} />
                {verdict.canPublish
                  ? `Publiable. ${verdict.warnings.length} avertissement(s), ${verdict.infos.length} remarque(s).`
                  : `${verdict.blocking.length} défaut(s) bloquant(s). Publication refusée.`}
              </div>
              {issues.length === 0 && <p className="zrm-note">Aucun défaut. Le Critique a mesuré la page réellement rendue : débordement, zones de sécurité, contraste, lisibilité, durée.</p>}
              {issues.map((issue, i) => (
                <div key={`${issue.code}-${i}`} className="zrm-issue" data-sev={issue.severity}>
                  <span className="zrm-issue-dot" />
                  <span style={{ minWidth: 0 }}>
                    {issue.message}
                    {issue.fix && <><br /><button className="zrm-btn zrm-btn-sm" style={{ marginTop: 5 }} onClick={() => applyFix(issue)}>Corriger</button></>}
                  </span>
                </div>
              ))}
            </>
          )}

          {deckTab === 'forge' && (
            plan ? (
              <>
                <p className="zrm-note" style={{ marginBottom: 8 }}>
                  {plan.frames} images à {plan.fps} i/s ({plan.duration}s). Écrire ces images sur le disque coûterait{' '}
                  <strong style={{ fontWeight: 500 }}>{formatBytes(plan.rawBytesIfWrittenToDisk)}</strong> : le pipeline les transmet directement à l’encodeur.
                </p>
                <span className="zrm-label">Commande d’encodage</span>
                <pre className="zrm-pre">{plan.command}</pre>
                <div className="zrm-row" style={{ margin: '8px 0 12px' }}>
                  <button className="zrm-btn zrm-btn-sm" onClick={async () => notify(await copyText(plan.command) ? 'Commande copiée.' : 'Copie refusée.', 'ok')}>Copier la commande</button>
                  <button className="zrm-btn zrm-btn-sm" onClick={async () => notify(await copyText(plan.script) ? 'Script de rendu copié.' : 'Copie refusée.', 'ok')}>Copier le script</button>
                </div>
                <span className="zrm-label">Sonde de vérification</span>
                <pre className="zrm-pre">{plan.probe}</pre>
                <span className="zrm-label" style={{ marginTop: 10 }}>Marche à suivre</span>
                <ol className="zrm-note" style={{ paddingLeft: 16, margin: '4px 0 0' }}>
                  {plan.steps.map((s, i) => <li key={i} style={{ marginBottom: 3 }}>{s}</li>)}
                </ol>
              </>
            ) : (
              <p className="zrm-note">
                La Forge s’active sur un format temporel (Vidéo 16:9 ou Habillage alpha). Le rendu vidéo ne tourne pas dans le navigateur :
                une image RGBA 4K pèse 33,18 Mo et la réponse serverless du projet plafonne à ~4,5 Mo. La Forge produit ici le pipeline local exact, reproductible.
              </p>
            )
          )}

          {deckTab === 'log' && (
            <>
              {log.length === 0 && <p className="zrm-note">Aucun livrable produit pour l’instant. Chaque export écrit sa ligne ici : thème, format, poids, empreinte.</p>}
              {log.map((entry, i) => (
                <div key={i} className="zrm-issue" data-sev="info" style={{ display: 'block' }}>
                  <div style={{ fontSize: 11.5 }}>{entry.title} — {entry.kind.toUpperCase()}</div>
                  <div className="zrm-mono" style={{ marginTop: 2 }}>{entry.theme} · {entry.format} · {formatBytes(entry.bytes)} · {entry.checksum}</div>
                </div>
              ))}
              {log.length > 0 && <button className="zrm-btn zrm-btn-sm" onClick={() => setLog(clearLog())}>Vider le journal</button>}
            </>
          )}
        </div>
      </section>

      {/* ---- BIBLIOTHÈQUE : famille → thème actif → groupes → composants ---- */}
      {/* ═══ ZONE 3 · PALETTE ═════════════════════════════════════════════════════════════════════
          Elle affichait des cartes de cent-vingt pixels de large, disposées en grille, ce qui la
          faisait ressembler à une boutique et non à une palette : dans une colonne de deux cents
          pixels, trois cartes remplissaient déjà l'écran. Les mêmes composants deviennent ici des
          RANGÉES d'arbre de vingt-deux pixels, groupées par catégorie repliable, exactement comme
          les rubriques COMMON / PANEL / USER CREATED d'Unreal. Une trentaine tient désormais à
          l'écran là où trois tenaient hier.

          Le glisser-déposer et le clic conservent leurs deux gestes d'origine, à l'identique. */}
      <section className="zrm-panel zrm-library zrm-zone-palette">
        <header className="zrm-head">
          <Icon name="square.grid.2x2" size={11} />
          <span className="zrm-head-title">Palette</span>
          <span className="zrm-head-spacer" />
          {[['components', 'Comp.'], ['themes', 'Thèmes'], ['images', 'Img'], ['icons', 'Icô.']].map(([cle, libelle]) => (
            <button key={cle} className="zrm-tool" style={{ height: 18, padding: '0 6px', fontSize: 10 }}
              data-on={libraryTab === cle} onClick={() => setLibraryTab(cle)}>{libelle}</button>
          ))}
        </header>
        <div className="zrm-find">
          <Icon name="magnifyingglass" size={11} />
          <input aria-label="Rechercher dans la bibliothèque" value={libraryQuery}
            placeholder={libraryTab === 'images' ? 'Rechercher une image…' : 'Rechercher un composant…'}
            onChange={(e) => setLibraryQuery(e.target.value)} />
        </div>

        <div className="zrm-body" style={{ padding: '0 2px 6px' }}>
          {libraryTab === 'themes' ? (
            /* LES THÈMES REVIENNENT DANS LA PALETTE. « Je sais même plus où retrouver mes thèmes » :
               ils vivaient dans un onglet du panneau de droite, c'est-à-dire à l'endroit où l'on
               règle et non à celui où l'on choisit. Un thème est une matière qu'on pose, comme un
               composant ; sa place est la palette. */
            <div className="zrm-tree">
              {Object.entries(grouped).map(([famille, liste]) => {
                const ouvert = openFamilies[famille] !== false
                return (
                  <React.Fragment key={famille}>
                    <button className="zrm-tree-cat" onClick={() => setOpenFamilies((st) => ({ ...st, [famille]: !ouvert }))}>
                      <span className="zrm-twist" data-open={ouvert}><Icon name="chevron.right" size={9} /></span>
                      {FAMILIES[famille] || famille}<span>{liste.length}</span>
                    </button>
                    {ouvert && liste.map((entree) => (
                      <button key={entree.id} className="zrm-tree-row" data-on={entree.id === themeId}
                        title={`${entree.name} — ${entree.id}`}
                        onClick={() => { changeTheme(entree.id); setActionCount((n) => n + 1) }}>
                        <span className="zrm-tree-glyph">{entree.source === 'html' ? '</>' : 'T'}</span>
                        <span className="zrm-tree-name">{entree.name}</span>
                        <span className="zrm-tree-tag">{entree.id}</span>
                      </button>
                    ))}
                  </React.Fragment>
                )
              })}
              {/* Le mode d'emploi du dépôt reste DANS le produit et non seulement dans la doc :
                  c'est la seule façon qu'il soit lu le jour où l'on ajoute un gabarit. */}
              <p className="zrm-det-empty" style={{ textAlign: 'left', lineHeight: 1.5 }}>
                {themes.length} thème{themes.length > 1 ? 's' : ''} sur les 1024 du catalogue. Dépose un fichier{' '}
                <span className="zrm-mono">T-FF-S-V--slug.html</span> dans <span className="zrm-mono">src/zenraymedia/themes/</span> : il apparaît ici.
              </p>
            </div>
          ) : libraryTab === 'images' ? (
            <>
              {!imageIndexReady && <div className="zrm-det-empty">Chargement de l’index d’images…</div>}
              {imageIndexReady && imageResults.length === 0 && <div className="zrm-det-empty">Aucune image trouvée.</div>}
              <div className="zrm-library-images">
                {imageResults.map((image) => (
                  <button key={image.path} className="zrm-library-image" title={image.path}
                    draggable
                    onDragStart={(e) => e.dataTransfer.setData('application/x-zenray-image', image.path)}
                    onClick={() => addLibraryImage(image)}>
                    <VignetteIndex image={image} />
                    <span>{image.name}</span>
                  </button>
                ))}
              </div>
            </>
          ) : (
            <div className="zrm-tree">
              {/* LA RUBRIQUE QUI PORTE LE PRODUIT (carte L3). Quatre types de calques, posés d'un
                  clic sur le canevas, empilés comme dans Photoshop. Les composants du thème
                  restent en dessous : ils deviennent eux aussi des calques quand on les pose. */}
              {libraryTab === 'components' && (
                <>
                  <div className="zrm-tree-cat" style={{ cursor: 'default' }}>
                    <span style={{ width: 13 }} />Calques<span>{countLayers(composition)}</span>
                  </div>
                  {[['text', 'Texte', 'T'], ['image', 'Image', '▣'], ['shape', 'Forme', '◼'], ['component', 'Composant', '◈'], ['table', 'Tableau', '▦']].map(([kind, nom, glyphe]) => (
                    <button key={kind} className="zrm-tree-row" title={`Poser un calque ${nom}`}
                      onClick={() => poserCalque(kind, kind === 'text' ? { source: 'Nouveau texte' } : {})}>
                      <span className="zrm-tree-glyph">{glyphe}</span>
                      <span className="zrm-tree-name">{nom}</span>
                      <span className="zrm-tree-tag">+</span>
                    </button>
                  ))}
                  {/* FAMILLE MIRO 5 · LE POST-IT. Une simple PRÉSÉLECTION du calque texte (fond
                      coloré, marge intérieure, texte centré) : aucun type de calque neuf, aucune
                      donnée neuve — juste le geste le plus fréquent de Miro rendu accessible en un
                      clic, plutôt que fond + marge + centrage réglés à la main à chaque fois. */}
                  <button className="zrm-tree-row" title="Poser un Post-it"
                    onClick={() => poserCalque('text', {
                      source: 'Post-it', w: 200, h: 200,
                      style: { backgroundColor: '#fff59d', padding: '20px', textAlign: 'center', justifyContent: 'center' },
                      effects: { shadow: '2px 6px 16px rgba(0,0,0,.18)' },
                    })}>
                    <span className="zrm-tree-glyph">▧</span>
                    <span className="zrm-tree-name">Post-it</span>
                    <span className="zrm-tree-tag">+</span>
                  </button>
                  {/* FAMILLE ILLUSTRATOR I2 · LA PLUME. Un BASCULE, pas une pose immédiate comme les
                      rangées au-dessus : l'activer laisse la main au canevas, où chaque clic pose un
                      point (carte `onStageDown`). Échap la referme, ou un second clic ici. */}
                  <button className="zrm-tree-row" data-on={outilPlumeActif} title={outilPlumeActif ? 'Quitter la Plume (Échap)' : 'Activer la Plume : clic pour un point d’angle, glisser pour un point lisse'}
                    onClick={() => setOutilPlumeActif((v) => !v)}>
                    <span className="zrm-tree-glyph">✒</span>
                    <span className="zrm-tree-name">Plume</span>
                    <span className="zrm-tree-tag">{outilPlumeActif ? 'active' : ''}</span>
                  </button>
                </>
              )}
              {Object.entries(componentGroups).map(([groupe, entrees]) => {
                const ouvert = openComponentGroups[groupe] !== false
                return (
                  <React.Fragment key={groupe}>
                    <button className="zrm-tree-cat" onClick={() => setOpenComponentGroups((etat) => ({ ...etat, [groupe]: !ouvert }))}>
                      <span className="zrm-twist" data-open={ouvert}><Icon name="chevron.right" size={9} /></span>
                      {groupe}<span>{entrees.length}</span>
                    </button>
                    {ouvert && entrees.map((entree) => (
                      <button key={entree.id} className="zrm-tree-row" draggable
                        title={`Ajouter ${entree.name} — ${entree.id}`}
                        onDragStart={(e) => {
                          e.dataTransfer.effectAllowed = 'copy'
                          e.dataTransfer.setData('application/x-zenray-component', entree.id)
                        }}
                        onClick={() => addLibraryComponent(entree)}>
                        <span className="zrm-tree-glyph">{libraryTab === 'icons' ? '◇' : 'T'}</span>
                        <span className="zrm-tree-name">{entree.name}</span>
                      </button>
                    ))}
                  </React.Fragment>
                )
              })}

              {/* LES CONTENEURS SONT MONTRÉS ÉTEINTS, ET C'EST UN CHOIX PLUTÔT QU'UN OUBLI. Le plan
                  V1 les écarte par écrit : ils rouvriraient le contrat de `composition.js` que
                  l'étape 2 vient de refermer, et le rouvrir deux fois dans la même version est la
                  façon la plus sûre de casser les documents déjà enregistrés. Les taire aurait
                  laissé croire à un trou dans la hiérarchie ; les afficher marqués « V2 » dit à la
                  fois ce qui existe et ce qui vient. */}
              {libraryTab === 'components' && (
                <>
                  <div className="zrm-tree-cat" style={{ cursor: 'default' }}><span style={{ width: 13 }} />Conteneurs<span>V2</span></div>
                  {['Canvas', 'Grille', 'Superposition', 'Boîte d’échelle', 'Boîte de défilement', 'Boîte de taille', 'Pile', 'Grille uniforme'].map((nom) => (
                    <div key={nom} className="zrm-tree-row" data-mute="true" title="Conteneur imbriqué — hors V1 par décision écrite du plan">
                      <span className="zrm-tree-glyph">⊞</span>
                      <span className="zrm-tree-name">{nom}</span>
                      <span className="zrm-tree-tag">V2</span>
                    </div>
                  ))}
                </>
              )}
            </div>
          )}
        </div>
      </section>



      {/* ═══ LE MENU CONTEXTUEL (famille 4, doc Slate « menus contextuels ») ═════════════════════
          Un clic droit sur la hiérarchie ouvre le MÊME répertoire d'actions que les icônes en
          ligne — masquer, verrouiller, dupliquer, retirer — plus les actions propres aux calques
          (rang, cadrage) et le geste de sélection de groupe déjà posé dans `surLaSelection`. Se
          ferme au clic extérieur, à Échap, ou après avoir choisi une action : jamais les trois
          modes de fermeture d'un menu de la barre du haut n'auraient de raison de différer ici. */}
      {menuContextuel && (
        <div className="zrm-ctx-voile" onClick={() => setMenuContextuel(null)} onContextMenu={(e) => { e.preventDefault(); setMenuContextuel(null) }}>
          <div className="zrm-menu-pop" style={{ position: 'fixed', top: menuContextuel.y, left: menuContextuel.x, minWidth: 190 }} onClick={(e) => e.stopPropagation()}>
            {selection.length > 1 && (
              <div className="zrm-menu-item" style={{ opacity: .55, cursor: 'default' }}>{selection.length} éléments sélectionnés</div>
            )}
            {menuContextuel.estCalque && (
              <>
                <button className="zrm-menu-item" onClick={() => { patchComposition((c) => reorderLayer(c, menuContextuel.id, 'up')); setMenuContextuel(null) }}>Monter d’un rang</button>
                <button className="zrm-menu-item" onClick={() => { patchComposition((c) => reorderLayer(c, menuContextuel.id, 'down')); setMenuContextuel(null) }}>Descendre d’un rang</button>
                {/* FAMILLE POWERPOINT 2 · un saut direct à l'extrême, distinct du rang unique
                    ci-dessus — les quatre commandes que PowerPoint, Figma et Miro rangent tous
                    dans un second niveau plutôt qu'en boutons permanents, exactement ce menu. */}
                <button className="zrm-menu-item" onClick={() => { patchComposition((c) => bringToFront(c, menuContextuel.id)); setMenuContextuel(null) }}>Mettre au premier plan</button>
                <button className="zrm-menu-item" onClick={() => { patchComposition((c) => sendToBack(c, menuContextuel.id)); setMenuContextuel(null) }}>Mettre à l’arrière-plan</button>
                <div className="zrm-menu-sep" />
                <button className="zrm-menu-item" onClick={() => { setPanelLockedId(menuContextuel.id); setDeckTab('details'); setMenuContextuel(null) }}>Verrouiller le panneau dessus<small>Famille 1</small></button>
                <button className="zrm-menu-item" onClick={() => { setSelectedComponent(menuContextuel.id); cadrerLaSelection(); setMenuContextuel(null) }}>Cadrer la sélection<small>Maj+F</small></button>
                <div className="zrm-menu-sep" />
              </>
            )}
            <button className="zrm-menu-item" onClick={() => { const v = !findLayer(composition, menuContextuel.id)?.hidden && !(composition.rows||[]).some(r=>r.items.some(it=>it.id===menuContextuel.id&&it.hidden)); surLaSelection((c, id) => (menuContextuel.estCalque ? patchLayer(c, id, { hidden: !v }) : patchItem(c, id, { hidden: !v })), menuContextuel.id); setMenuContextuel(null) }}>Afficher / masquer</button>
            <button className="zrm-menu-item" onClick={() => { surLaSelection((c, id) => (menuContextuel.estCalque ? duplicateLayer(c, id) : duplicateItem(c, id)), menuContextuel.id); setMenuContextuel(null) }}>Dupliquer</button>
            <div className="zrm-menu-sep" />
            <button className="zrm-menu-item" onClick={() => { surLaSelection((c, id) => (menuContextuel.estCalque ? removeLayer(c, id) : removeItem(c, id)), menuContextuel.id); setSelection([]); setSelectedComponent(null); setMenuContextuel(null) }}>Retirer<small>{selection.length > 1 ? `${selection.length}` : ''}</small></button>
          </div>
        </div>
      )}

      {toast && <div className="zrm-toast" data-kind={toast.kind}>{toast.message}</div>}
      {/* ZONE 8 · BARRE DU BAS. Elle dit l'état, elle ne commande rien : le document, sa
          sauvegarde, le thème et le format. C'est la ligne qu'on lit sans la chercher. */}
      {/* ═══ ZONE 8 · BARRE D'ÉTAT ════════════════════════════════════════════════════════════════
          À gauche ce qu'on LIT sans le chercher, à droite ce qu'on DÉCLENCHE : c'est la répartition
          d'Unreal, dont le coin bas-droit porte « All Saved » et « Check-in Changes ». Les boutons
          de rendu descendent ici depuis le pied de la Palette, qu'ils encombraient : dans une
          colonne de deux cents pixels, cinq boutons pleine largeur mangeaient le tiers de la
          hauteur réservée aux composants.

          Le sélecteur de format en pastilles disparaît, sans perte : il vit désormais dans la barre
          d'outils, et le même réglage offert à deux endroits finit toujours par en contredire un. */}
      <div className="zrm-panel zrm-zone-status">
        <Icon name={docPath ? 'checkmark' : 'pencil'} size={11} />
        <span title={docPath || 'jamais enregistré'}>{docPath || 'document non enregistré'}</span>
        <button className="zrm-status-btn" data-on={deckTab === 'critic'} onClick={() => setDeckTab('critic')}
          style={{ color: verdict.canPublish ? undefined : UI.red }}>
          <Icon name={verdict.canPublish ? 'checkmark' : 'hand.raised'} size={11} />
          {issues.length ? `${issues.length} remarque(s)` : 'aucune remarque'}
        </button>

        <span className="zrm-head-spacer" />
        {busy && <div className="zrm-progress" style={{ width: 60 }}><i style={{ width: '65%' }} /></div>}
        <button className="zrm-status-btn" onClick={() => setDeckTab('log')}><Icon name="list.bullet" size={11} />Journal</button>
        <button className="zrm-status-btn" onClick={() => runExport('text')} disabled={!compiled || !!busy}>Copier le texte</button>
        {format.kind === 'print' && <button className="zrm-status-btn" onClick={() => runExport('pdf')} disabled={!compiled || !!busy}>PDF</button>}
        {['still', 'video', 'overlay'].includes(format.kind) && <button className="zrm-status-btn" onClick={() => runExport('png')} disabled={!compiled || !!busy}>Image PNG</button>}
        {/* FAMILLE POWERPOINT 8 · n'apparaît que si la Structure porte au moins une diapositive :
            un bouton d'export de carrousel sans carrousel serait un bouton mort. */}
        {readSlides(composition).length > 1 && <button className="zrm-status-btn" onClick={() => runExport('png-toutes-diapositives')} disabled={!compiled || !!busy}>Toutes les diapositives</button>}
        <button className="zrm-status-btn" onClick={() => runExport('html')} disabled={!compiled || !!busy}>Fichier HTML</button>
        <span className="zrm-mono" style={{ fontSize: 10, opacity: .5 }} title="Règle des trois actions : note → thème → rendre">{actionCount} action{actionCount > 1 ? 's' : ''}</span>
        <button className="zrm-btn zrm-btn-primary" style={{ minHeight: 22, padding: '0 12px', fontSize: 11 }}
          onClick={publishNow} disabled={!compiled || !!busy} title="Écrit une page de TEXTE dans Create depuis le Brief et le Cut, l’indexe et copie son adresse — pas le média visuel composé ici">
          {busy === 'publish' ? 'Publication…' : 'Publier l’article'}
        </button>
      </div>
    </div>
  )
}

// UNE RANGÉE DE SOUS-COMPOSANT, récursive.
//
// Elle est écrite HORS de `MediaApp` et non en ligne dans son rendu, et c'est une précaution qui a
// déjà été payée sur ce projet : un composant défini à l'intérieur d'un autre est recréé à chaque
// rendu, donc démonté et remonté, ce qui fait clignoter l'arbre au survol et perd le focus des
// champs. La règle est notée dans le CLAUDE.md global depuis le 2026-07-22.
function RangeeNoeud({ noeud, niveau, instanceId, selectedComponent, selectedNode, onSelect, ouverts, onToggle }) {
  const ouvert = !!ouverts[`${instanceId}:${noeud.path}`]
  const choisi = selectedComponent === instanceId && selectedNode === noeud.path
  const aDesEnfants = noeud.children.length > 0
  return (
    <>
      <div className="zrm-tree-row" style={{ '--zrm-indent': `${42 + niveau * 11}px` }} data-on={choisi}
        onClick={(e) => { e.stopPropagation(); onSelect(noeud.path) }} title={`<${noeud.tag}> · ${noeud.path}`}>
        {aDesEnfants ? (
          <span className="zrm-twist" data-open={ouvert} title="Clic : ce nœud · Maj-clic : toute la descendance"
            onClick={(e) => { e.stopPropagation(); onToggle(noeud.path, e.shiftKey) }}>
            <Icon name="chevron.right" size={9} />
          </span>
        ) : <span style={{ width: 9, flex: '0 0 auto' }} />}
        <span className="zrm-tree-name">{noeud.name}</span>
        {noeud.text ? <span className="zrm-tree-tag" style={{ maxWidth: 54, overflow: 'hidden' }}>{noeud.text.slice(0, 12)}</span> : null}
      </div>
      {ouvert && noeud.children.map((enfant) => (
        <RangeeNoeud key={enfant.path} noeud={enfant} niveau={niveau + 1} instanceId={instanceId}
          selectedComponent={selectedComponent} selectedNode={selectedNode} onSelect={onSelect}
          ouverts={ouverts} onToggle={onToggle} />
      ))}
    </>
  )
}

// UNE VIGNETTE DE LA PALETTE, qui sait attendre son déchiffrement.
//
// Écrite hors de `MediaApp` pour la même raison que `RangeeNoeud` : un composant défini à
// l'intérieur d'un autre est recréé à chaque rendu, donc démonté et remonté, et une vignette
// remontée recommence son déchiffrement à chaque frappe dans le champ de recherche.
function VignetteIndex({ image }) {
  const [src, setSrc] = React.useState(null)
  React.useEffect(() => {
    let vivant = true
    resolveThumbUrl(image.thumb || image.url).then((u) => { if (vivant) setSrc(u) })
    return () => { vivant = false }
  }, [image.path, image.thumb, image.url])
  // Tant que l'adresse n'est pas résolue, on ne pose AUCUN <img> : un <img> sans source affiche
  // l'icône d'image cassée, et l'utilisateur conclut que sa bibliothèque est vide.
  return src ? <img src={src} alt="" /> : <span style={{ opacity: .35, fontSize: 10 }}>…</span>
}

// LE BOUTON DE VERROU D'UN PANNEAU (famille 1 — sélection et propriétés).
//
// Écrit hors de `MediaApp` pour la même raison que `RangeeNoeud` et `VignetteIndex` : un composant
// défini en ligne est recréé à chaque rendu et démonté à chaque frappe, ce qui aurait perdu le
// focus du champ d'à côté.
function VerrouPanneau({ verrouille, onClick }) {
  return (
    <button className="zrm-det-revert" style={{ color: verrouille ? undefined : 'inherit' }}
      data-on={verrouille || undefined}
      title={verrouille ? 'Déverrouiller — le panneau suivra de nouveau la sélection' : 'Verrouiller ce panneau sur cet objet'}
      onClick={onClick}>
      <Icon name={verrouille ? 'lock' : 'lock.icloud'} size={11} />
    </button>
  )
}

// LES HUIT ICÔNES D'ALIGNEMENT (famille Photoshop 2), dessinées à la main.
//
// Aucune des icônes SF Symbols du projet ne couvre ces huit sens précis. Deux barres de largeurs
// DIFFÉRENTES, posées contre un guide, sont la convention visuelle que Figma et Photoshop
// partagent pour l'alignement : la différence de longueur est ce qui rend l'alignement lisible,
// deux barres identiques ne montreraient rien. La distribution reprend trois carrés égaux séparés
// de courts traits, pour signifier « des vides rendus égaux ».
function AlignIcon({ mode }) {
  if (mode === 'dist-x' || mode === 'dist-y') {
    const x = mode === 'dist-x'
    return (
      <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        {x ? <>
          <rect x="1" y="4" width="3" height="6" rx="0.5" fill="currentColor" />
          <rect x="5.5" y="4" width="3" height="6" rx="0.5" fill="currentColor" opacity=".55" />
          <rect x="10" y="4" width="3" height="6" rx="0.5" fill="currentColor" />
        </> : <>
          <rect x="4" y="1" width="6" height="3" rx="0.5" fill="currentColor" />
          <rect x="4" y="5.5" width="6" height="3" rx="0.5" fill="currentColor" opacity=".55" />
          <rect x="4" y="10" width="6" height="3" rx="0.5" fill="currentColor" />
        </>}
      </svg>
    )
  }
  const vertical = mode === 'left' || mode === 'hcenter' || mode === 'right'
  const guide = { left: 1, hcenter: 7, right: 13 }[mode] ?? { top: 1, vcenter: 7, bottom: 13 }[mode]
  const barre = (taille, decalage) => {
    const debut = mode.endsWith('center') || mode === 'hcenter' || mode === 'vcenter'
      ? guide - taille / 2
      : (mode === 'right' || mode === 'bottom') ? guide - taille : guide
    return vertical ? { x: debut, y: decalage, w: taille, h: 3 } : { x: decalage, y: debut, w: 3, h: taille }
  }
  const b1 = barre(9, 2), b2 = barre(5, 9)
  return (
    <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      {vertical
        ? <line x1={guide} y1="0.5" x2={guide} y2="13.5" stroke="currentColor" strokeWidth="1.1" opacity=".5" />
        : <line x1="0.5" y1={guide} x2="13.5" y2={guide} stroke="currentColor" strokeWidth="1.1" opacity=".5" />}
      <rect x={b1.x} y={b1.y} width={b1.w} height={b1.h} rx="0.5" fill="currentColor" />
      <rect x={b2.x} y={b2.y} width={b2.w} height={b2.h} rx="0.5" fill="currentColor" opacity=".7" />
    </svg>
  )
}
