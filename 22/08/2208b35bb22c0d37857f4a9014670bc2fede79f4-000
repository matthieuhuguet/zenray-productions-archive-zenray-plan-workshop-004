function useDebounced(value, delay) {
  const [debounced, setDebounced] = React.useState(value)
  React.useEffect(() => {
    const id = setTimeout(() => setDebounced(value), delay)
    return () => clearTimeout(id)
  }, [value, delay])
  return debounced
}

// Mise à l'échelle du Stage : le canevas garde sa taille RÉELLE (les mesures du Critique se font
// dedans, en pixels de sortie) et c'est l'affichage qui est réduit par transform. Redimensionner
// l'iframe fausserait toutes les mesures.
function useFitScale(ref, canvasW, canvasH) {
  const [fit, setFit] = React.useState({ scale: 1, availH: 900 })
  React.useEffect(() => {
    const el = ref.current
    if (!el || !canvasW) return undefined
    const measure = () => {
      const box = el.getBoundingClientRect()
      const availW = Math.max(120, box.width - 32)
      const availH = Math.max(240, box.height - 32)
      const next = canvasH > 0 ? Math.min(availW / canvasW, availH / canvasH, 1) : Math.min(availW / canvasW, 1)
      setFit({ scale: Math.max(0.08, Math.round(next * 1000) / 1000), availH })
    }
    measure()
    const observer = new ResizeObserver(measure)
    observer.observe(el)
    return () => observer.disconnect()
  }, [ref, canvasW, canvasH])
  return fit
}

