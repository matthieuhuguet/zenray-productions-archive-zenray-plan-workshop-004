    // un bogue de fermeture périmée découvert en écrivant le test de la carte S4, pas en le devinant.
  }, [menuContextuel, cadrerLaSelection, naviguerHierarchie, ordreHierarchie, selection, composition, patchComposition, annuler, retablir, copierSelection, couperSelection, collerSelection, outilPlumeActif, terminerTrace, pointSelectionne, calqueSelectionne, chainageDepuisId, annulerGeste, toutSelectionner, inverserSelection, grouperSelection])

