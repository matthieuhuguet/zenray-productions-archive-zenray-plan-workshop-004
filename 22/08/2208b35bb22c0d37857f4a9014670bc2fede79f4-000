  const tlTotal = tlParts.reduce((sum, part) => sum + part, 0)
  const tlOffsets = tlParts.reduce((acc, part, i) => { acc.push(i === 0 ? 0 : acc[i - 1] + tlParts[i - 1]); return acc }, [])
