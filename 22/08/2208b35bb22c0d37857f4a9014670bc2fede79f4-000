      // doc « présentation » qui survit à la traduction — pointeur laser, minuteur,
      // enregistrement caméra et vue Présentateur deux écrans n'ont pas d'équivalent réel dans
      // un compositeur d'affiches (portée écarte et écrite dans KANBAN.md).
      else if (e.code === 'PageDown' || e.code === 'PageUp') {
        const diapositives = readSlides(composition)
        if (diapositives.length) {
          e.preventDefault()
          const i = diapositives.findIndex((s) => s.id === composition.activeSlideId)
          const cible = e.code === 'PageDown' ? diapositives[i + 1] : diapositives[i - 1]
          if (cible) patchComposition((c) => setActiveSlide(c, cible.id))
        }
