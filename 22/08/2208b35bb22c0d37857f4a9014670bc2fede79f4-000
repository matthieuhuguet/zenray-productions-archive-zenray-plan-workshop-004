      // d'Illustrator distingue les deux portées du même raccourci selon ce qui est actif. Sans
      // point sélectionné, ce raccourci ne touche à rien ici (retirer un calque entier reste un
      // geste du menu contextuel, jamais surpris par une frappe).
      else if ((e.code === 'Backspace' || e.code === 'Delete') && pointSelectionne !== null && estUnTrace(calqueSelectionne)) {
        e.preventDefault()
        patchComposition((c) => patchLayer(c, calqueSelectionne.id, { pathPoints: removePathPoint(calqueSelectionne.pathPoints, pointSelectionne) }))
        setPointSelectionne(null)
        setActionCount((n) => n + 1)
      }
      else if (e.code === 'ArrowDown') { e.preventDefault(); naviguerHierarchie(1) }
      else if (e.code === 'ArrowUp') { e.preventDefault(); naviguerHierarchie(-1) }
