                  return (
                    <div key={beat.id} className="zrm-tl-track">
                      <div className="zrm-tl-clip" style={{ width: `${Math.max(2, (part / (tlTotal || 1)) * 100)}%`, marginLeft: `${(tlOffsets[i] / (tlTotal || 1)) * 100}%` }}>
                        {Math.round(part * 10) / 10}{tlUnit}
                      </div>
                    </div>
                  )
                })}
              </div>
              <div className="zrm-tl-head" style={{ left: `${((tlOffsets[selectedBeat] || 0) / (tlTotal || 1)) * 100}%` }} />
            </div>
          </div>
        )}
      </section>

      {/* ═══ ZONE 6 · HIÉRARCHIE ══════════════════════════════════════════════════════════════════
          Cette zone portait le FORMULAIRE du brief : titre, message, public, blocs, notes. Un
          formulaire n'est pas une hiérarchie, et c'est la raison pour laquelle l'écran ne
          ressemblait à aucun éditeur malgré ses huit zones. Le formulaire n'est pas supprimé pour
          autant, il descend intact dans l'onglet « Contenu » du panneau de droite, à la place que
          la section « Content » occupe chez Unreal.

          LES QUATRE CÔTÉS SONT PRÉSERVÉS, et c'est le seul acquis que Matthieu ait nommé :
          `placementAt` mesure une proportion et non des pixels, si bien que déposer sur le bord
          haut, bas, gauche ou droite d'une RANGÉE d'arbre marche exactement comme sur une carte. */}
      <section className="zrm-panel zrm-pane-structure zrm-zone-hier">
        <header className="zrm-head">
          <Icon name="list.bullet" size={11} />
          <span className="zrm-head-title">Hiérarchie</span>
          <span className="zrm-head-spacer" />
          {selection.length > 1 && <span className="zrm-tree-tag" style={{ marginRight: 4 }}>{selection.length} sél.</span>}
          <button className="zrm-tool" style={{ height: 17, padding: '0 5px' }} title="Tout déplier" onClick={toutDeplier}><Icon name="plus" size={10} /></button>
          <button className="zrm-tool" style={{ height: 17, padding: '0 5px' }} title="Tout replier" onClick={toutReplier}><Icon name="minus" size={10} /></button>
        </header>
        <div className="zrm-find">
          <Icon name="magnifyingglass" size={11} />
          <input aria-label="Rechercher une pièce" value={hierQuery} placeholder="Rechercher une pièce ou un calque…" onChange={(e) => setHierQuery(e.target.value)} />
        </div>
        <div className="zrm-body" style={{ padding: '0 2px 6px' }}
          onDragOver={(e) => { if (!composition.rows.length) e.preventDefault() }}
          onDrop={onEmptyStructureDrop}
          onDragLeave={(e) => { if (!e.currentTarget.contains(e.relatedTarget)) setDropTarget(null) }}>
          <div className="zrm-structure" style={{ display: 'contents' }}>
            {/* La racine, comme le `[test]` d'Unreal : elle donne son nom au document et sert de
                cible de désélection, sans quoi on ne peut jamais revenir à « rien de sélectionné ». */}
            <button className="zrm-tree-row" style={{ '--zrm-indent': '4px' }} data-on={!selectedComponent}
              title="Clic : replier tout l’arbre" onClick={() => replier('racine')}>
              <span className="zrm-twist" data-open={!groupesReplies.racine}><Icon name="chevron.right" size={9} /></span>
              <span className="zrm-tree-glyph">◻</span>
              <span className="zrm-tree-name">[{project.brief.title || 'Sans titre'}]</span>
              <span className="zrm-tree-tag">{format.short || format.label}</span>
            </button>
            {/* FAMILLE POWERPOINT 1 · DIAPOSITIVES. Une diapositive est un groupe dédié (carte P5) :
                ses membres ne s'affichent QUE si elle est active ; tout calque sans diapositive agit
                comme un MASQUE, visible sur toutes — traduit en carrousel Instagram (VISION.md). */}
            <button className="zrm-tree-cat" style={{ paddingLeft: 16 }} onClick={() => replier('diapositives')}>
              <span className="zrm-twist" data-open={!groupesReplies.diapositives}><Icon name="chevron.right" size={9} /></span>
              <span>Diapositives</span><span>{readSlides(composition).length}</span>
            </button>
            {!groupesReplies.diapositives && (
              <>
                {readSlides(composition).map((slide, i) => (
                  <div key={slide.id} className="zrm-tree-row zrm-slide-row" style={{ '--zrm-indent': '28px' }}
                    data-on={composition.activeSlideId === slide.id}
                    onClick={() => patchComposition((c) => setActiveSlide(c, slide.id))}>
                    {/* AUDIT P2-V1 · une vraie vignette, pas un simple numéro : le même canevas
                        compilé, réduit par transform plutôt que par un second moteur de rendu.
                        `pointer-events:none` laisse le CLIC atterrir sur la ligne, jamais dans le
                        cadre — cliquer la vignette doit choisir la diapositive, pas son contenu. */}
                    <span className="zrm-slide-thumb">
                      <span className="zrm-slide-thumb-num">{i + 1}</span>
                      <iframe title={`Vignette — ${slide.name}`} srcDoc={slideThumbnails[slide.id] || ''}
                        style={{
                          width: format.canvas?.w || 800, height: (format.canvas?.h > 0 ? format.canvas.h : (format.canvas?.w || 800) * 0.7),
                          transform: `scale(${44 / (format.canvas?.w || 800)})`, transformOrigin: 'top left',
                        }} tabIndex={-1} />
                    </span>
                    <span className="zrm-tree-name">{slide.name}</span>
                    <span className="zrm-tree-acts">
                      <button title="Monter d’un rang" onClick={(e) => { e.stopPropagation(); patchComposition((c) => reorderSlide(c, slide.id, 'up')) }}>↑</button>
                      <button title="Descendre d’un rang" onClick={(e) => { e.stopPropagation(); patchComposition((c) => reorderSlide(c, slide.id, 'down')) }}>↓</button>
                      <button title="Dupliquer la diapositive" onClick={(e) => { e.stopPropagation(); patchComposition((c) => duplicateSlide(c, slide.id)) }}><Icon name="doc.text" size={10} /></button>
                      <button title="Supprimer la diapositive" onClick={(e) => { e.stopPropagation(); patchComposition((c) => removeSlide(c, slide.id)) }}><Icon name="trash" size={10} /></button>
                    </span>
                  </div>
                ))}
                <button className="zrm-tree-row" style={{ '--zrm-indent': '28px', opacity: .65 }}
                  onClick={() => patchComposition((c) => addSlide(c))}>
                  <span className="zrm-tree-glyph">+</span>
                  {/* PAS `.zrm-tree-name` ICI : dans toute la suite de tests, cette classe signifie
                      « ceci est un nom de calque ou de pièce », et un libellé d'action neuf la
                      polluerait pour chaque test qui recense les calques par ce sélecteur. */}
                  <span className="zrm-tree-add-label">Ajouter une diapositive</span>
                </button>
              </>
            )}
            {/* FAMILLE INDESIGN D1 · PAGES PARENTES. Un gabarit NOMMÉ et RÉUTILISABLE, distinct du
                masque universel (calque sans diapositive) : plusieurs diapositives peuvent
                appliquer la MÊME page parente, et la modifier une fois la répercute partout. Le
                bouton « Éditer » entre dans son contexte propre (`activePageParentId`), exactement
                comme cliquer une diapositive entre dans la sienne — les deux sont exclusifs. */}
            <button className="zrm-tree-cat" style={{ paddingLeft: 16 }} onClick={() => replier('pagesParentes')}>
              <span className="zrm-twist" data-open={!groupesReplies.pagesParentes}><Icon name="chevron.right" size={9} /></span>
              <span>Pages parentes</span><span>{readParentPages(composition).length}</span>
            </button>
            {!groupesReplies.pagesParentes && (
              <>
                {composition.activePageParentId && (
                  <div className="zrm-tree-row" style={{ '--zrm-indent': '28px', opacity: .75, cursor: 'default' }}>
                    <span className="zrm-tree-glyph">✎</span>
                    <span className="zrm-tree-add-label">
                      Édition de « {readParentPages(composition).find((p) => p.id === composition.activePageParentId)?.name} »
                    </span>
                    <span className="zrm-tree-acts">
                      <button title="Quitter l’édition de la page parente" onClick={() => patchComposition((c) => setActivePageParent(c, null))}>
                        <Icon name="xmark" size={10} />
                      </button>
                    </span>
                  </div>
                )}
                {readParentPages(composition).map((page) => (
                  <div key={page.id} className="zrm-tree-row" style={{ '--zrm-indent': '28px' }}
                    data-on={composition.activePageParentId === page.id}
                    title={page.basedOnId ? `Fondée sur « ${readParentPages(composition).find((b) => b.id === page.basedOnId)?.name} »` : 'Aucune base'}
                    onClick={() => patchComposition((c) => setActivePageParent(c, page.id))}>
                    <span className="zrm-tree-glyph">▤</span>
                    <span className="zrm-tree-name">{page.name}</span>
                    {page.basedOnId && <span className="zrm-tree-tag">fondée</span>}
                    <span className="zrm-tree-acts">
                      <button title="Supprimer la page parente (les diapositives qui l’appliquent reviennent à [Sans])"
                        onClick={(e) => { e.stopPropagation(); patchComposition((c) => removeParentPage(c, page.id)) }}>
                        <Icon name="trash" size={10} />
                      </button>
                    </span>
                  </div>
                ))}
                <button className="zrm-tree-row" style={{ '--zrm-indent': '28px', opacity: .65 }}
                  onClick={() => patchComposition((c) => addParentPage(c))}>
                  <span className="zrm-tree-glyph">+</span>
                  <span className="zrm-tree-add-label">Ajouter une page parente</span>
                </button>
              </>
            )}
            {/* FAMILLE INDESIGN D4 · STYLES DE TEXTE NOMMÉS. Une définition partagée par plusieurs
                calques texte à la fois : la modifier ici les change TOUS d'un coup, sans qu'aucun
                ne soit ouvert individuellement — c'est tout l'intérêt d'un style par rapport à un
                réglage local répété calque par calque. */}
            <button className="zrm-tree-cat" style={{ paddingLeft: 16 }} onClick={() => replier('stylesTexte')}>
              <span className="zrm-twist" data-open={!groupesReplies.stylesTexte}><Icon name="chevron.right" size={9} /></span>
              <span>Styles de texte</span><span>{readTextStyles(composition).length}</span>
            </button>
            {!groupesReplies.stylesTexte && (
              <>
                {readTextStyles(composition).map((style) => (
                  <div key={style.id} className="zrm-tree-row" style={{ '--zrm-indent': '28px' }}
                    data-on={selectedTextStyleId === style.id}
                    title="Régler la définition de ce style — le panneau Détails affiche ses champs"
                    onClick={() => { setSelectedTextStyleId(style.id); setSelectedObjectStyleId(null); setSelectedComponent(null); setSelectedInheritedLayerId(null); setDeckTab('details') }}>
                    <span className="zrm-tree-glyph">Aa</span>
                    <span className="zrm-tree-name">{style.name}</span>
                    <span className="zrm-tree-acts">
                      <button title="Supprimer ce style (les calques qui l’appliquent reviennent à [Aucun], sans changer d’apparence)"
                        onClick={(e) => { e.stopPropagation(); patchComposition((c) => removeTextStyle(c, style.id)) }}>
                        <Icon name="trash" size={10} />
                      </button>
                    </span>
                  </div>
                ))}
                <button className="zrm-tree-row" style={{ '--zrm-indent': '28px', opacity: .65 }}
                  title={calqueSelectionne?.kind === 'text' ? 'Amorcé depuis la typographie du calque texte sélectionné' : 'Un style vide, à régler ensuite'}
                  onClick={() => patchComposition((c) => addTextStyle(c, null, calqueSelectionne?.kind === 'text' ? calqueSelectionne.id : null))}>
                  <span className="zrm-tree-glyph">+</span>
                  <span className="zrm-tree-add-label">Ajouter un style de texte</span>
                </button>
              </>
            )}
            {/* FAMILLE INDESIGN D7 · STYLES D'OBJET NOMMÉS. Le pendant de « Styles de texte » pour
                L'APPARENCE (fond, marge intérieure, rayon, bordure) plutôt que la typographie —
                s'applique à N'IMPORTE QUEL calque, texte compris, puisque les deux listes de champs
                ne se recouvrent jamais : un bloc de texte peut porter les deux styles à la fois. */}
            <button className="zrm-tree-cat" style={{ paddingLeft: 16 }} onClick={() => replier('stylesObjet')}>
              <span className="zrm-twist" data-open={!groupesReplies.stylesObjet}><Icon name="chevron.right" size={9} /></span>
              <span>Styles d’objet</span><span>{readObjectStyles(composition).length}</span>
            </button>
            {!groupesReplies.stylesObjet && (
              <>
                {readObjectStyles(composition).map((style) => (
                  <div key={style.id} className="zrm-tree-row" style={{ '--zrm-indent': '28px' }}
                    data-on={selectedObjectStyleId === style.id}
                    title="Régler la définition de ce style — le panneau Détails affiche ses champs"
                    onClick={() => { setSelectedObjectStyleId(style.id); setSelectedTextStyleId(null); setSelectedComponent(null); setSelectedInheritedLayerId(null); setDeckTab('details') }}>
                    <span className="zrm-tree-glyph">▥</span>
                    <span className="zrm-tree-name">{style.name}</span>
                    <span className="zrm-tree-acts">
                      <button title="Supprimer ce style (les calques qui l’appliquent reviennent à [Aucun], sans changer d’apparence)"
                        onClick={(e) => { e.stopPropagation(); patchComposition((c) => removeObjectStyle(c, style.id)) }}>
                        <Icon name="trash" size={10} />
                      </button>
                    </span>
                  </div>
                ))}
                <button className="zrm-tree-row" style={{ '--zrm-indent': '28px', opacity: .65 }}
                  title={calqueSelectionne ? 'Amorcé depuis l’apparence du calque sélectionné' : 'Un style vide, à régler ensuite'}
                  onClick={() => patchComposition((c) => addObjectStyle(c, null, calqueSelectionne?.id || null))}>
                  <span className="zrm-tree-glyph">+</span>
                  <span className="zrm-tree-add-label">Ajouter un style d’objet</span>
                </button>
              </>
            )}
            {/* FAMILLE INDESIGN D6 · MARGES, COLONNES, REPÈRES ET GRILLE. « Générer les repères »
                REMPLACE le jeu actuel par les marges/colonnes réglées ci-dessous ; les repères
                obtenus redeviennent ensuite des repères ordinaires, glissables ou supprimables un
                par un sur le canevas, exactement comme ceux posés directement depuis la règle. */}
            <button className="zrm-tree-cat" style={{ paddingLeft: 16 }} onClick={() => replier('reperes')}>
              <span className="zrm-twist" data-open={!groupesReplies.reperes}><Icon name="chevron.right" size={9} /></span>
              <span>Repères</span><span>{readGuides(composition).length}</span>
            </button>
            {!groupesReplies.reperes && (() => {
              const marges = readMarginSettings(composition)
              const grille = readGridSettings(composition)
              const champ = (label, value, onChange, extra = {}) => (
                <label style={{ display: 'flex', flexDirection: 'column', gap: 2, fontSize: 10, opacity: .8 }}>
                  {label}
                  <input className="zrm-det-in" type="number" value={value} onChange={onChange} {...extra} />
                </label>
              )
              return (
                <div style={{ padding: '4px 12px 10px 28px', display: 'flex', flexDirection: 'column', gap: 8 }}>
                  <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 6 }}>
                    {champ('Haut', marges.top, (e) => patchComposition((c) => patchMarginSettings(c, { top: Number(e.target.value) })), { min: 0 })}
                    {champ('Bas', marges.bottom, (e) => patchComposition((c) => patchMarginSettings(c, { bottom: Number(e.target.value) })), { min: 0 })}
                    {champ('Gauche', marges.left, (e) => patchComposition((c) => patchMarginSettings(c, { left: Number(e.target.value) })), { min: 0 })}
                    {champ('Droite', marges.right, (e) => patchComposition((c) => patchMarginSettings(c, { right: Number(e.target.value) })), { min: 0 })}
                    {champ('Colonnes', marges.columns, (e) => patchComposition((c) => patchMarginSettings(c, { columns: Number(e.target.value) })), { min: 1, max: 12 })}
                    {champ('Gouttière', marges.gutter, (e) => patchComposition((c) => patchMarginSettings(c, { gutter: Number(e.target.value) })), { min: 0 })}
                  </div>
                  <div style={{ display: 'flex', gap: 6 }}>
                    <button className="zrm-tool" style={{ flex: 1 }}
                      onClick={() => patchComposition((c) => generateMarginGuides(c, { w: format.canvas.w, h: format.canvas.h }))}>
                      Générer les repères
                    </button>
                    <button className="zrm-tool" title="Retirer tous les repères"
                      onClick={() => patchComposition((c) => clearGuides(c))}>
                      <Icon name="trash" size={11} />
                    </button>
                  </div>
                  <label style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', fontSize: 11 }}>
                    <span>Afficher la grille</span>
                    <input type="checkbox" checked={grille.show} onChange={(e) => patchComposition((c) => setGridSettings(c, { show: e.target.checked }))} />
                  </label>
                  {grille.show && champ('Pas de la grille', grille.size, (e) => patchComposition((c) => setGridSettings(c, { size: Number(e.target.value) })), { min: 4, max: 200 })}
                </div>
              )
            })()}
            {/* LA PILE DE CALQUES (carte L4, enrichie carte P5). Elle se lit du HAUT, c'est-à-dire
                du plus proche de l'œil, comme dans Photoshop : `stackOrder` est l'inverse de
                l'ordre de peinture. `groupLayers` garantit que les membres d'un même dossier sont
                CONTIGUS dans cet ordre : la boucle peut donc afficher un dossier une seule fois,
                dès son premier membre rencontré, puis avaler les suivants sans jamais avoir à
                fermer et rouvrir la même icône de dossier. */}
            {!groupesReplies.racine && countLayers(composition) > 0 && (
              <>
                <button className="zrm-tree-cat" style={{ paddingLeft: 16 }} onClick={() => replier('calques')}>
                  <span className="zrm-twist" data-open={!groupesReplies.calques}><Icon name="chevron.right" size={9} /></span>
                  <span>Calques</span><span>{countLayers(composition)}</span>
                </button>
                {!groupesReplies.calques && (() => {
                  const pile = stackOrder(composition)
                  const groupes = readGroups(composition)
                  const dejaRendu = new Set()
                  // FAMILLE SLATE 6 · LA RECHERCHE DE LA HIÉRARCHIE NE FILTRAIT QUE LES PIÈCES,
                  // JAMAIS LES CALQUES : « recherche dans une collection » est une sous-fonctionnalité
                  // documentée de cette famille, et la moitié de l'arbre y échappait entièrement.
                  const aiguille = hierQuery.trim().toLowerCase()
                  const correspond = (nom) => !aiguille || nom.toLowerCase().includes(aiguille)
                  return pile.map((layer) => {
                    if (layer.groupId) {
                      if (dejaRendu.has(layer.groupId)) return null   // déjà rendu par le premier membre
                      dejaRendu.add(layer.groupId)
                      const groupe = groupes.find((g) => g.id === layer.groupId)
                      const tousMembres = pile.filter((l) => l.groupId === layer.groupId)
                      // Si le NOM DU DOSSIER correspond, on montre tout son contenu sans le filtrer
                      // une deuxième fois — chercher « titre » et trouver un dossier « Titre » vide
                      // de tout élément visible serait un résultat qui se contredit lui-même.
                      const nomDossierCorrespond = correspond(groupe?.name || 'Groupe')
                      const membres = nomDossierCorrespond ? tousMembres : tousMembres.filter((m) => correspond(m.name))
                      if (aiguille && !membres.length) return null   // ni le dossier ni aucun membre ne correspond
                      const clefRepli = `grp:${layer.groupId}`
                      return (
                        <React.Fragment key={layer.groupId}>
                          <div className="zrm-tree-row" style={{ '--zrm-indent': '28px' }} data-hidden={groupe?.hidden}>
                            <span className="zrm-twist" data-open={!groupesReplies[clefRepli]} onClick={() => replier(clefRepli)}>
                              <Icon name="chevron.right" size={9} />
                            </span>
                            <span className="zrm-tree-glyph"><Icon name="folder" size={10} /></span>
                            <span className="zrm-tree-name" style={{ fontWeight: 500 }}>{groupe?.name || 'Groupe'}</span>
                            <span className="zrm-tree-tag">{membres.length}</span>
                            <span className="zrm-tree-acts">
                              <button title={groupe?.hidden ? 'Afficher le groupe' : 'Masquer le groupe'}
                                onClick={(e) => { e.stopPropagation(); patchComposition((c) => patchGroup(c, layer.groupId, { hidden: !groupe?.hidden })) }}><Icon name="eye" size={10} /></button>
                              <button title={groupe?.locked ? 'Déverrouiller le groupe' : 'Verrouiller le groupe'}
                                onClick={(e) => { e.stopPropagation(); patchComposition((c) => patchGroup(c, layer.groupId, { locked: !groupe?.locked })) }}><Icon name="lock" size={10} /></button>
                              {/* FAMILLE FIGMA 4 · le parent réagit désormais tout seul au contenu : ranger les
                                  membres en ligne ou en colonne au lieu de les déplacer un par un à la main. */}
                              <button title={groupe?.autoLayout ? 'Désactiver Auto Layout' : 'Activer Auto Layout (colonne)'}
                                data-on={!!groupe?.autoLayout || undefined}
                                onClick={(e) => { e.stopPropagation(); patchComposition((c) => toggleAutoLayout(c, layer.groupId)) }}><Icon name="rectangle.grid.1x2" size={10} /></button>
                              {groupe?.autoLayout && (
                                <button title={groupe.autoLayout.direction === 'row' ? 'Passer en colonne' : 'Passer en ligne'}
                                  onClick={(e) => { e.stopPropagation(); patchComposition((c) => setAutoLayoutProp(c, layer.groupId, { direction: groupe.autoLayout.direction === 'row' ? 'column' : 'row' })) }}>
                                  <Icon name="arrow.up.arrow.down" size={10} /></button>
                              )}
                              {/* AUDIT P1-R9 · le conteneur SYSTÈME d'une diapositive ou d'une page
                                  parente n'offre jamais Dissoudre ni Supprimer depuis ici : un
                                  bouton qui n'aurait plus aucun effet (les deux fonctions refusent
                                  déjà ce groupe précis) resterait un bouton mensonger — la page se
                                  retire par sa PROPRE vignette, jamais par ce dossier générique. */}
                              {!isSystemGroupId(composition, layer.groupId) && (
                                <>
                                  <button title="Dissoudre le groupe" onClick={(e) => { e.stopPropagation(); patchComposition((c) => ungroupLayers(c, layer.groupId)) }}><Icon name="doc.text" size={10} /></button>
                                  <button title="Retirer le groupe et son contenu" onClick={(e) => { e.stopPropagation(); patchComposition((c) => removeGroup(c, layer.groupId)); setSelection([]); setSelectedComponent(null) }}><Icon name="trash" size={10} /></button>
                                </>
                              )}
                            </span>
                          </div>
                          {!groupesReplies[clefRepli] && membres.map((m) => (
                            <div key={m.id} className="zrm-tree-row" style={{ '--zrm-indent': '42px' }}
                              data-on={selection.includes(m.id) || selectedComponent === m.id} data-hidden={m.hidden}
                              onClick={(e) => choisir(m.id, e)}
                              onContextMenu={(e) => ouvrirMenuContextuel(e, m.id, true)}>
                              <span className="zrm-tree-glyph">{{ text: 'T', image: '▣', shape: '◼', component: '◈', table: '▦' }[m.kind]}</span>
                              <span className="zrm-tree-name">{m.name}</span>
                              <span className="zrm-tree-acts">
                                <button title={m.hidden ? 'Afficher' : 'Masquer'} onClick={(e) => { e.stopPropagation(); const v = !m.hidden; surLaSelection((c, id) => patchLayer(c, id, { hidden: v }), m.id) }}><Icon name="eye" size={10} /></button>
                                <button title="Retirer" onClick={(e) => { e.stopPropagation(); surLaSelection((c, id) => removeLayer(c, id), m.id); setSelection([]); setSelectedComponent(null) }}><Icon name="trash" size={10} /></button>
                              </span>
                            </div>
                          ))}
                        </React.Fragment>
                      )
                    }
                    if (!correspond(layer.name)) return null
                    return (
                      <React.Fragment key={layer.id}>
                      <div className="zrm-tree-row" style={{ '--zrm-indent': '28px' }}
                        data-on={selection.includes(layer.id) || selectedComponent === layer.id} data-hidden={layer.hidden}
                        onClick={(e) => choisir(layer.id, e)}
                        onContextMenu={(e) => ouvrirMenuContextuel(e, layer.id, true)}>
                        <span className="zrm-tree-glyph">{{ text: 'T', image: '▣', shape: '◼', component: '◈', table: '▦' }[layer.kind]}</span>
                        <span className="zrm-tree-name">{layer.name}</span>
                        <span className="zrm-tree-acts">
                          {/* FAMILLE FIGMA 8 · un calque composant est une INSTANCE : elle s'ouvre sur
                              les pièces HTML qui la composent, chacune modifiable, comme le fait déjà
                              une pièce Lego classique. Seul le composant a une vraie sous-arborescence
                              à déplier ; texte/image/forme sont des primitives déjà réglables telles quelles. */}
                          {layer.kind === 'component' && (
                            <button title="Déplier les sous-composants" onClick={(e) => { e.stopPropagation(); setOpenNodes((o) => ({ ...o, [layer.id]: !o[layer.id] })) }}><Icon name="chevron.right" size={10} /></button>
                          )}
                          <button title="Monter d’un rang" onClick={(e) => { e.stopPropagation(); patchComposition((c) => reorderLayer(c, layer.id, 'up')) }}>↑</button>
                          <button title="Descendre d’un rang" onClick={(e) => { e.stopPropagation(); patchComposition((c) => reorderLayer(c, layer.id, 'down')) }}>↓</button>
                          <button title={layer.hidden ? 'Afficher' : 'Masquer'} onClick={(e) => { e.stopPropagation(); const v = !layer.hidden; surLaSelection((c, id) => patchLayer(c, id, { hidden: v }), layer.id) }}><Icon name="eye" size={10} /></button>
                          <button title="Dupliquer" onClick={(e) => { e.stopPropagation(); patchComposition((c) => duplicateLayer(c, layer.id)) }}><Icon name="doc.text" size={10} /></button>
                          <button title="Retirer" onClick={(e) => { e.stopPropagation(); surLaSelection((c, id) => removeLayer(c, id), layer.id); setSelection([]); setSelectedComponent(null) }}><Icon name="trash" size={10} /></button>
                        </span>
                      </div>
                      {layer.kind === 'component' && openNodes[layer.id] && (arbreNoeuds[layer.id] || []).map((noeud) => (
                        <RangeeNoeud key={noeud.path} noeud={noeud} niveau={0} instanceId={layer.id}
                          selectedComponent={selectedComponent} selectedNode={selectedNode}
                          ouverts={ouverts} onToggle={(chemin, avec) => basculerNoeud(layer.id, chemin, avec)}
                          onSelect={(chemin) => { setSelectedComponent(layer.id); setSelectedNode(chemin); setDeckTab('details') }} />
                      ))}
                      </React.Fragment>
                    )
                  })
                })()}
              </>
            )}
            {composition.rows.length === 0 && countLayers(composition) === 0 && (
              <div className="zrm-det-empty">Aucune pièce posée. Fais glisser un composant de la Palette, ou clique-le.</div>
            )}
            {!groupesReplies.racine && composition.rows.map((row, ri) => (
              <React.Fragment key={row.id}>
                <button className="zrm-tree-cat" style={{ paddingLeft: 16 }} onClick={() => replier(`row:${row.id}`)}>
                  <span className="zrm-twist" data-open={!groupesReplies[`row:${row.id}`]}><Icon name="chevron.right" size={9} /></span>
                  <span>Rangée {ri + 1}</span><span>{row.items.length}</span>
                </button>
                {!groupesReplies[`row:${row.id}`] && row.items
                  .filter((item) => !hierQuery || item.name.toLowerCase().includes(hierQuery.toLowerCase()))
                  .map((item) => (
                  <React.Fragment key={item.id}>
                  <div className="zrm-tree-row zrm-structure-item" style={{ '--zrm-indent': '28px' }}
                    draggable={!item.locked}
                    data-on={selection.includes(item.id) || selectedComponent === item.id}
                    data-hidden={item.hidden}
                    data-drop={dropTarget?.id === item.id ? dropTarget.placement : undefined}
                    onClick={(e) => choisir(item.id, e)}
                    onContextMenu={(e) => ouvrirMenuContextuel(e, item.id, false)}
                    onDragStart={(e) => { e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('application/x-zenray-instance', item.id) }}
                    onDragOver={(e) => onStructureDragOver(e, item.id)}
                    onDrop={(e) => onStructureDrop(e, item.id)}>
                    <span className="zrm-tree-glyph">{item.kind === 'image' ? '▣' : 'T'}</span>
                    <span className="zrm-tree-name">{item.name}</span>
                    <span className="zrm-tree-acts">
                      <button title="Déplier les sous-composants" onClick={(e) => { e.stopPropagation(); setOpenNodes((o) => ({ ...o, [item.id]: !o[item.id] })) }}><Icon name="chevron.right" size={10} /></button>
                      <button title={item.hidden ? 'Afficher' : 'Masquer'} onClick={(e) => { e.stopPropagation(); const v = !item.hidden; surLaSelection((c, id) => patchItem(c, id, { hidden: v }), item.id) }}><Icon name="eye" size={10} /></button>
                      <button title={item.locked ? 'Déverrouiller' : 'Verrouiller'} onClick={(e) => { e.stopPropagation(); patchComposition((current) => patchItem(current, item.id, { locked: !item.locked })) }}><Icon name="lock" size={10} /></button>
                      <button title="Dupliquer" onClick={(e) => { e.stopPropagation(); patchComposition((current) => duplicateItem(current, item.id)) }}><Icon name="doc.text" size={10} /></button>
                      <button title="Retirer" onClick={(e) => { e.stopPropagation(); surLaSelection((c, id) => removeItem(c, id), item.id); setSelection([]); setSelectedComponent(null) }}><Icon name="trash" size={10} /></button>
                    </span>
                  </div>
                  {openNodes[item.id] && (arbreNoeuds[item.id] || []).map((noeud) => (
                    <RangeeNoeud key={noeud.path} noeud={noeud} niveau={0} instanceId={item.id}
                      selectedComponent={selectedComponent} selectedNode={selectedNode}
                      ouverts={ouverts} onToggle={(chemin, avec) => basculerNoeud(item.id, chemin, avec)}
                      onSelect={(chemin) => { setSelectedComponent(item.id); setSelectedNode(chemin); setDeckTab('details') }} />
                  ))}
                  </React.Fragment>
                ))}
              </React.Fragment>
            ))}
          </div>
        </div>
      </section>

      {/* ---- STAGE ---- */}
      {/* ═══ ZONE 4 · APERÇU ══════════════════════════════════════════════════════════════════════
          Le mobilier qui manquait : règles graduées sur les deux axes, barre flottante au-dessus
          du canevas, et les trois mentions de coin qui, chez Unreal, disent l'échelle, la
          définition et la sélection. Ce sont elles qui font qu'un aperçu se lit comme un plan de
          travail mesuré plutôt que comme une image posée au centre d'un cadre. Elles ne coûtent
          rien : les graduations sont un dégradé répété, donc zéro nœud dans l'arbre. */}
      <section className="zrm-panel zrm-zone-viewport">
        <header className="zrm-head">
          <Icon name="square.on.circle" size={11} />
          <span className="zrm-head-title">Aperçu</span>
          <span className="zrm-head-spacer" />
          <span className="zrm-mono" style={{ fontSize: 10, opacity: .6 }}>
            {compiled?.meta?.omitted > 0 ? `${compiled.meta.shown}/${compiled.meta.shown + compiled.meta.omitted} blocs` : ''}
            {isTemporal(format) && cut ? ` · ${durationOf(cut, format)}s` : ''}
          </span>
        </header>

        <div className="zrm-stage-body zrm-vp" ref={stageRef} onWheel={onStageWheel}
          onPointerDown={onStageDown} onPointerMove={onStagePan} onPointerUp={onStageUp} onPointerLeave={onStageUp}
          onDoubleClick={(e) => { if (e.target === e.currentTarget) replacerLaVue() }}>
          {/* FAMILLE INDESIGN D6 · cliquer une règle pose un repère au CENTRE du canevas sur cet
              axe — une position de départ raisonnable, à affiner ensuite en le glissant. Une vraie
              règle laisse le glisser choisir la position d'un coup ; ce clic simple reste le seul
              geste FIABLEMENT vérifiable ici (un glisser depuis la règle n'aurait pas de position
              d'arrivée mesurable dans l'environnement de test, voir la Plume et le récupérateur). */}
          <div className="zrm-ruler" data-axis="x" title="Cliquer pour poser un repère vertical"
            onClick={() => { patchComposition((c) => addGuide(c, 'x', format.canvas.w / 2)); setActionCount((n) => n + 1) }} />
          <div className="zrm-ruler" data-axis="y" title="Cliquer pour poser un repère horizontal"
            onClick={() => { patchComposition((c) => addGuide(c, 'y', format.canvas.h / 2)); setActionCount((n) => n + 1) }} />
          <div className="zrm-vp-bar">
            <button className="zrm-tool" style={{ height: 20 }} data-on={showSafe} disabled={!format.safe}
              title="Zones de sécurité" onClick={() => setShowSafe((v) => !v)}><Icon name="rectangle.dashed" size={11} /></button>
            {/* FAMILLE INDESIGN D3 · AFFICHER LES LIAISONS. Des traits reliant les blocs chaînés,
                pour lire le chemin réel d'une histoire même quand la mise en page ne le montre pas. */}
            <button className="zrm-tool" style={{ height: 20 }} data-on={afficherLiaisons}
              title={afficherLiaisons ? 'Masquer les liaisons de texte' : 'Afficher les liaisons de texte'}
              onClick={() => setAfficherLiaisons((v) => !v)}><Icon name="link" size={11} /></button>
            {/* FAMILLE INDESIGN D8 · CONTRÔLE EN AMONT. Un simple indicateur d'état (jamais un
                blocage d'export, Matthieu reste libre d'exporter avec des points ouverts) : coche
                si rien à signaler, triangle sinon, avec le compte en survol. */}
            <button className="zrm-tool" style={{ height: 20 }} data-on={preflightOuvert}
              title={preflightPoints.length > 0 ? `Contrôle en amont : ${preflightPoints.length} point(s) à vérifier` : 'Contrôle en amont : rien à signaler'}
              onClick={() => setPreflightOuvert((v) => !v)}>
              <Icon name={preflightPoints.length > 0 ? 'triangle.fill' : 'checkmark'} size={11} />
            </button>
            <button className="zrm-tool" style={{ height: 20 }} data-on={renderDark}
              title={renderDark ? 'Rendu en clair' : 'Rendu en sombre'} onClick={() => setRenderDark((v) => !v)}>
              <Icon name={renderDark ? 'sun.max' : 'moon'} size={11} /></button>
            <span className="zrm-tool-sep" />
            <button className="zrm-tool" style={{ height: 20 }} data-on={!!selectedComponent}
              title="Désélectionner" onClick={() => { setSelectedComponent(null); setSelectedNode(null) }}><Icon name="cursorarrow" size={11} /></button>
            <span className="zrm-tool-sep" />
            <button className="zrm-tool" style={{ height: 20 }} title="Réduire" onClick={() => setZoom((z) => Math.max(0.1, z / 1.25))}><Icon name="minus" size={11} /></button>
            <button className="zrm-tool" style={{ height: 20 }} title="Replacer la vue (double-clic sur le fond)" onClick={replacerLaVue}>{Math.round(zoom * 100)} %</button>
            <button className="zrm-tool" style={{ height: 20 }} title="Agrandir" onClick={() => setZoom((z) => Math.min(8, z * 1.25))}><Icon name="plus" size={11} /></button>
            {calqueSelectionne && (
              <button className="zrm-tool" style={{ height: 20 }} title="Cadrer la sélection (Maj+F)" onClick={cadrerLaSelection}>
                <Icon name="rectangle.dashed" size={11} />
              </button>
            )}
          </div>
          <div className="zrm-vp-note" data-at="tl">
            Échelle {Math.round(fitScale * 100)} %{zoom !== 1 ? ' · vue déplacée' : ''}<br />
            Sélection : {pieceSelectionnee ? pieceSelectionnee.name : 'aucune'}
          </div>
          <div className="zrm-vp-note" data-at="bl">
            Densité de contenu {compiled?.meta?.scale || 1}<br />
            {format.safe ? 'Zone de sécurité déclarée' : 'Aucune zone de sécurité'}<br />
            {format.canvas.w}{format.canvas.h ? ` × ${format.canvas.h}` : ' × libre'} ({format.label})
          </div>
          <div className="zrm-vp-note" data-at="br">{countItems(composition)} pièce(s)</div>
          {themeError ? (
            <p className="zrm-stage-empty">{themeError}</p>
          ) : !compiled ? (
            <p className="zrm-stage-empty">Complète le titre, le message d’une phrase et le public. L’aperçu est la page réelle, pas une approximation.</p>
          ) : compiled.error ? (
            <p className="zrm-stage-empty">{compiled.error}</p>
          ) : (
            <div className="zrm-canvas" ref={canvasRef} style={{ width: format.canvas.w * fitScale, height: stageHeight * fitScale, transform: `translate(${pan.x}px, ${pan.y}px)` }}>
              <iframe
                ref={frameRef}
                title="Aperçu ZenRayMedia"
                onLoad={onFrameLoad}
                srcDoc={debouncedHtml}
                sandbox="allow-same-origin"
                style={{ width: format.canvas.w, height: stageHeight, transform: `scale(${fitScale})`, transformOrigin: '0 0' }}
              />
              {/* FAMILLE INDESIGN D6 · LA GRILLE. Un quadrillage RÉGULIER purement visuel — à la
                  différence des repères ci-dessous, elle n'accroche rien : une référence à l'œil,
                  jamais un second système de magnétisme à maintenir en plus de `snapMove`. */}
              {readGridSettings(composition).show && (
                <div className="zrm-grid-overlay" style={{
                  backgroundSize: `${readGridSettings(composition).size * fitScale}px ${readGridSettings(composition).size * fitScale}px`,
                }} />
              )}
              {/* La couche de manipulation. Elle ne capte le pointeur que sur les boîtes, si bien
                  que le reste de l'aperçu reste cliquable par le pont de sélection. Compte aussi
                  les calques HÉRITÉS (carte InDesign D1) : une diapositive qui n'a QUE du contenu
                  de page parente, sans le moindre calque propre, doit quand même pouvoir les
                  sélectionner. */}
              {(countLayers(composition) > 0 || (composition.activeSlideId && effectiveSlideLayers(composition, composition.activeSlideId).length > 0)) && (
                <div className="zrm-lay-layer" onPointerMove={onPoigneeMove} onPointerUp={onPoigneeUp} onPointerCancel={onPoigneeUp}>
                  {/* AUDIT P1-R4 : même prédicat que `compile.js` (`isEffectivelyHidden`), jamais un
                      `!l.hidden` séparé qui laisserait la boîte d'un calque d'une autre diapositive
                      ou d'un groupe masqué visible et cliquable à l'écran. */}
                  {stackOrder(composition).filter((l) => !isEffectivelyHidden(composition, l)).map((layer) => (
                    <div key={layer.id} className="zrm-lay-box" data-on={selectedComponent === layer.id} data-locked={isEffectivelyLocked(composition, layer) || undefined}
                      style={{ left: layer.x * fitScale, top: layer.y * fitScale, width: layer.w * fitScale, height: layer.h * fitScale,
                        // Le contour de sélection SUIT la rotation du calque, sinon les poignées ne
                        // désignent plus les bons coins dès que le calque a tourné.
                        transform: layer.rotation ? `rotate(${layer.rotation}deg)` : undefined }}
                      onPointerDown={(e) => onPoigneeDown(e, layer, 'move')}
                      onDoubleClick={(e) => { if (layer.kind === 'text' && !isEffectivelyLocked(composition, layer)) { e.stopPropagation(); setEditionTexteId(layer.id) } }}>
                      {/* AUDIT P1-R4 : verrouillé PAR SON GROUPE doit cacher les poignées exactement
                          comme verrouillé soi-même — sinon elles restent visibles et cliquables pour
                          un geste que `onPoigneeDown` refuse de toute façon, une boîte qui ment. */}
                      {selectedComponent === layer.id && !isEffectivelyLocked(composition, layer) && ['nw', 'n', 'ne', 'e', 'se', 's', 'sw', 'w'].map((coin) => (
                        <i key={coin} className="zrm-lay-h" data-at={coin} onPointerDown={(e) => onPoigneeDown(e, layer, coin)} />
                      ))}
                      {/* LA POIGNÉE DE ROTATION, détachée au-dessus du calque comme dans Figma et
                          Photoshop : un huitième point l'aurait confondue avec un redimensionnement. */}
                      {selectedComponent === layer.id && !isEffectivelyLocked(composition, layer) && (
                        <i className="zrm-lay-rot" title="Glisser pour pivoter" onPointerDown={(e) => onPoigneeRotation(e, layer)} />
                      )}
                      {/* FAMILLE INDESIGN D2 · LE RÉCUPÉRATEUR DE CONTENU. Toujours AU CENTRE du
                          cadre, jamais au point focal actuel (les deux divergent dès qu'on l'a
                          déjà déplacé) : glisser ce contrôle repositionne directement le point
                          focal, un second point d'entrée sur l'image sans changer d'outil. */}
                      {layer.kind === 'image' && selectedComponent === layer.id && !isEffectivelyLocked(composition, layer) && (
                        <i className="zrm-lay-grabber" title="Glisser pour repositionner le contenu dans le cadre"
                          onPointerDown={(e) => onGrabberDown(e, layer)} />
                      )}
                      {/* FAMILLE INDESIGN D3 · LES PORTS D'UN BLOC DE TEXTE. Détachés HORS de la
                          boîte (comme la poignée de rotation), jamais sur son bord : les huit
                          poignées de redimensionnement occupent déjà chaque coin et chaque côté, un
                          port au même endroit s'y superposerait. Le port de SORTIE porte, en plus,
                          le signe rouge du texte en excès quand ce bloc déborde et n'a personne à
                          qui le passer — jamais affiché sans un débordement RÉELLEMENT mesuré. */}
                      {layer.kind === 'text' && selectedComponent === layer.id && !isEffectivelyLocked(composition, layer) && (
                        <>
                          <i className="zrm-lay-port" data-at="entree" data-relie={!!layer.threadPrevId}
                            title={layer.threadPrevId ? 'Point d’entrée — chaîné depuis un bloc précédent' : 'Point d’entrée — début d’histoire'} />
                          <i className="zrm-lay-port" data-at="sortie" data-relie={!!layer.threadNextId}
                            title={layer.threadNextId ? 'Point de sortie — chaîné vers un bloc suivant' : 'Glisser (ou cliquer puis choisir un bloc) pour chaîner vers un autre texte'}
                            onPointerDown={(e) => onPortSortieDown(e, layer)}>
                            {overflowingLayerIds.has(layer.id) && !layer.threadNextId && <b className="zrm-lay-port-excess" title="Texte en excès : cette portion n’est affichée dans aucun bloc" />}
                          </i>
                        </>
                      )}
                      {/* FAMILLE INDESIGN D5 · LA ZONE D'HABILLAGE. Le rectangle que le texte évite
                          réellement, calculé EN DIRECT depuis l'obstacle choisi — la MÊME fonction
                          pure qui pose le flottant invisible dans le HTML compilé. Nichée dans la
                          boîte du calque texte lui-même : ses coordonnées sont déjà RELATIVES à
                          cette boîte, exactement ce que rend `textWrapFloat`. */}
                      {layer.kind === 'text' && selectedComponent === layer.id && layer.wrapAroundId && (() => {
                        const habillage = textWrapFloat(composition, layer)
                        if (!habillage) return null
                        return (
                          <i className="zrm-wrap-zone" title="Zone d’habillage : le texte évite cet espace"
                            style={{
                              left: (habillage.side === 'left' ? 0 : layer.w - habillage.width) * fitScale,
                              top: habillage.marginTop * fitScale,
                              width: habillage.width * fitScale,
                              height: habillage.height * fitScale,
                            }} />
                        )
                      })()}
                      {/* FAMILLE ILLUSTRATOR I2 · UN TRACÉ SÉLECTIONNÉ EXPOSE SES POINTS, sans second
                          outil séparé : c'est ce que montre la sélection d'un calque tracé, comme les
                          huit poignées le sont déjà pour tout calque. Les ANCRES (carrés) restent
                          toutes visibles ; les POIGNÉES DE COURBE (cercles), seulement pour le point
                          sélectionné, sinon un tracé à quinze points se noierait sous ses propres fils. */}
                      {estUnTrace(layer) && selectedComponent === layer.id && !isEffectivelyLocked(composition, layer) && (
                        <>
                          <svg className="zrm-path-svg" viewBox={`0 0 ${layer.w} ${layer.h}`} preserveAspectRatio="none">
                            <path className="zrm-path-hit" d={pathD(pathPointsInPixels(layer), layer.pathClosed)} fill="none" stroke="transparent" strokeWidth="12" vectorEffect="non-scaling-stroke"
                              onDoubleClick={(e) => onTraceDouble(e, layer)} style={{ cursor: 'copy' }} />
                            <path d={pathD(pathPointsInPixels(layer), layer.pathClosed)} fill="none" stroke="var(--zrm-accent)" strokeWidth="1.5" vectorEffect="non-scaling-stroke" style={{ pointerEvents: 'none' }} />
                          </svg>
                          {pathPointsInPixels(layer).map((p, i) => (
                            <React.Fragment key={i}>
                              {pointSelectionne === i && (
                                <>
                                  <i className="zrm-path-handle-line" style={ligneEntrePoints(p.x * fitScale, p.y * fitScale, p.inX * fitScale, p.inY * fitScale)} />
                                  <i className="zrm-path-handle-line" style={ligneEntrePoints(p.x * fitScale, p.y * fitScale, p.outX * fitScale, p.outY * fitScale)} />
                                  <i className="zrm-path-handle" style={{ left: p.inX * fitScale, top: p.inY * fitScale }}
                                    onPointerDown={(e) => onPointPoigneeDown(e, layer, i, 'in')} />
                                  <i className="zrm-path-handle" style={{ left: p.outX * fitScale, top: p.outY * fitScale }}
                                    onPointerDown={(e) => onPointPoigneeDown(e, layer, i, 'out')} />
                                </>
                              )}
                              <i className="zrm-path-anchor" data-on={pointSelectionne === i} data-point-index={i} title="Glisser pour déplacer, double-clic pour convertir angle ↔ lisse"
                                style={{ left: p.x * fitScale, top: p.y * fitScale }}
                                onPointerDown={(e) => onPointAncreDown(e, layer, i)}
                                onDoubleClick={(e) => onPointAncreDouble(e, layer, i)} />
                            </React.Fragment>
                          ))}
                        </>
                      )}
                      {/* FAMILLE FIGMA 5 · le double-clic ouvre l'édition LÀ où le texte s'affiche,
                          au lieu de forcer un aller-retour par le panneau Détails. */}
                      {editionTexteId === layer.id && (
                        <textarea className="zrm-lay-edit" aria-label="Éditer le texte sur le canevas" autoFocus
                          value={layer.source}
                          onPointerDown={(e) => e.stopPropagation()}
                          onChange={(e) => patchComposition((c) => patchLayer(c, layer.id, { source: e.target.value }))}
                          onBlur={() => setEditionTexteId(null)}
                          onKeyDown={(e) => { if (e.key === 'Escape') { e.currentTarget.blur() } }} />
                      )}
                    </div>
                  ))}
                  {/* FAMILLE INDESIGN D1 · LES OBJETS HÉRITÉS DE LA PAGE PARENTE. Contour en
                      pointillés, jamais draguable comme un calque ordinaire : un clic les
                      sélectionne dans leur propre panneau (remplacer localement, détacher,
                      rétablir), exactement le comportement qu'InDesign réserve aux éléments
                      parents non remplacés. */}
                  {composition.activeSlideId && effectiveSlideLayers(composition, composition.activeSlideId).map((layer) => (
                    <div key={`herite-${layer.id}`} className="zrm-lay-box zrm-lay-inherited"
                      data-on={selectedInheritedLayerId === layer.id} data-overridden={layer.overridden || undefined}
                      title={layer.overridden ? 'Objet hérité, remplacé localement' : 'Objet hérité de la page parente'}
                      style={{ left: layer.x * fitScale, top: layer.y * fitScale, width: layer.w * fitScale, height: layer.h * fitScale,
                        transform: layer.rotation ? `rotate(${layer.rotation}deg)` : undefined }}
                      onPointerDown={(e) => onInheriteDown(e, layer)} />
                  ))}
                </div>
              )}
              {/* FAMILLE INDESIGN D3 · AFFICHER LES LIAISONS. Une ligne par paire chaînée, calculée
                  EN DIRECT depuis la position réelle des deux calques (même géométrie que les
                  connecteurs Miro 6, `connectorGeometry`, mais purement visuelle ici : aucun calque
                  connecteur n'est créé, la ligne disparaît avec le bouton qui l'affiche). */}
              {afficherLiaisons && stackOrder(composition).filter((l) => l.kind === 'text' && l.threadNextId).map((depuis) => {
                const vers = findLayer(composition, depuis.threadNextId)
                if (!vers) return null
                const geo = connectorGeometry(depuis, vers)
                return (
                  <svg key={depuis.id} className="zrm-thread-line-svg"
                    style={{ position: 'absolute', left: geo.x * fitScale, top: geo.y * fitScale, width: Math.max(1, geo.w) * fitScale, height: Math.max(1, geo.h) * fitScale, overflow: 'visible', pointerEvents: 'none' }}
                    viewBox={`0 0 ${geo.w} ${geo.h}`} preserveAspectRatio="none">
                    <line x1={geo.connectorX1} y1={geo.connectorY1} x2={geo.connectorX2} y2={geo.connectorY2}
                      stroke="var(--zrm-accent)" strokeWidth="1.5" strokeDasharray="5 4" vectorEffect="non-scaling-stroke" />
                  </svg>
                )
              })}
              {/* LES GUIDES DE MAGNÉTISME, un trait par axe accroché, dans le référentiel du
                  canevas — ils ne suivent PAS la rotation, un guide reste toujours horizontal ou
                  vertical, c'est ce qui en fait un repère. */}
              {guides.x !== null && <i className="zrm-guide zrm-guide-v" style={{ left: guides.x * fitScale }} />}
              {guides.y !== null && <i className="zrm-guide zrm-guide-h" style={{ top: guides.y * fitScale }} />}
              {/* FAMILLE INDESIGN D6 · LES REPÈRES PERSISTANTS. Posés depuis la règle ou générés
                  d'un coup depuis les marges/colonnes, ils restent jusqu'à ce qu'on les retire —
                  contrairement aux guides de magnétisme ci-dessus, qui ne vivent QUE pendant un
                  glisser. Glisser en déplace un ; double-clic le retire. */}
              {readGuides(composition).map((g) => (
                <i key={g.id} className="zrm-manual-guide" data-axis={g.axis}
                  title="Glisser pour repositionner, double-clic pour retirer"
                  style={g.axis === 'x' ? { left: g.position * fitScale } : { top: g.position * fitScale }}
                  onPointerDown={(e) => onGuideDown(e, g)}
                  onDoubleClick={(e) => { e.stopPropagation(); patchComposition((c) => removeGuide(c, g.id)); setActionCount((n) => n + 1) }} />
              ))}
              {marqueeBox && (
                <i className="zrm-marquee" style={{
                  left: Math.min(marqueeBox.x1, marqueeBox.x2) * fitScale,
                  top: Math.min(marqueeBox.y1, marqueeBox.y2) * fitScale,
                  width: Math.abs(marqueeBox.x2 - marqueeBox.x1) * fitScale,
                  height: Math.abs(marqueeBox.y2 - marqueeBox.y1) * fitScale,
                }} />
              )}
              {/* FAMILLE ILLUSTRATOR I2 · L'APERÇU DU TRACÉ EN COURS. `traceApercu` vit en pixels
                  ABSOLUS du canevas (pas encore de calque, donc pas encore de boîte à qui rapporter
                  un pourcentage) — un tireté distingue d'un coup d'œil ce qui se dessine encore de ce
                  qui est déjà posé. */}
              {traceApercu && traceApercu.length > 0 && (
                <>
                  <svg className="zrm-trace-live-svg"
                    style={{ position: 'absolute', inset: 0, width: format.canvas.w * fitScale, height: stageHeight * fitScale, overflow: 'visible', pointerEvents: 'none' }}
                    viewBox={`0 0 ${format.canvas.w} ${stageHeight}`} preserveAspectRatio="none">
                    <path d={pathD(traceApercu, false)} fill="none" stroke="var(--zrm-accent)" strokeWidth="1.5" strokeDasharray="4 3" vectorEffect="non-scaling-stroke" />
                  </svg>
                  {traceApercu.map((p, i) => (
                    <i key={i} className="zrm-path-anchor" style={{ left: p.x * fitScale, top: p.y * fitScale, pointerEvents: 'none' }} />
                  ))}
                </>
              )}
              {showSafe && format.safe && (
                <div className="zrm-safe-overlay">
                  <i style={{ left: 0, right: 0, top: 0, height: format.safe.top * fitScale }} />
                  <i style={{ left: 0, right: 0, bottom: 0, height: format.safe.bottom * fitScale }} />
                  <i style={{ top: 0, bottom: 0, left: 0, width: format.safe.sides * fitScale }} />
                  <i style={{ top: 0, bottom: 0, right: 0, width: format.safe.sides * fitScale }} />
                </div>
              )}
            </div>
          )}
        </div>
      </section>

      {/* ---- DECK ---- */}
      <section className="zrm-panel zrm-pane-details zrm-zone-details">
        <header className="zrm-head" style={{ gap: 4 }}>
          {DECK_TABS.map((tab) => (
            <button key={tab.key} className="zrm-tool" style={{ height: 20, padding: '0 6px' }} data-on={deckTab === tab.key}
              title={tab.label} aria-label={tab.label} onClick={() => setDeckTab(tab.key)}>
              <Icon name={tab.icon} size={12} />
              {tab.key === 'critic' && issues.length ? <b style={{ fontWeight: 400, fontSize: 9 }}>{issues.length}</b> : null}
            </button>
          ))}
        </header>
        <div className="zrm-body">
          {/* DÉTAILS DE LA PIÈCE SÉLECTIONNÉE. Vider un champ le fait REVENIR au brief au lieu de
              l'effacer : `resolveItemData` ne retient que les chaînes non vides, et c'est ce qui
              distingue « jamais renseigné » de « renseigné puis vidé » dans une interface où le
              modèle, lui, ne les distingue pas. */}
          {/* ═══ ZONE 5 · LE PANNEAU DE PROPRIÉTÉS ══════════════════════════════════════════════
              La forme d'Unreal, à la lettre : en-tête d'objet, sections repliables, rangées dont
              les libellés s'alignent sur une colonne commune. L'ancienne version empilait des
              champs pleine largeur, ce qui rendait vingt propriétés illisibles.

              LES SECTIONS SONT DÉDUITES DU TYPE DÉCLARÉ, jamais inventées : une couleur va dans
              « Apparence », le reste dans « Contenu ». Le thème déclare ses champs, l'interface se
              contente de les ranger, si bien qu'un thème neuf n'oblige à toucher à rien ici. */}
          {/* ═══ CARTE L5 · LES PROPRIÉTÉS D'UN CALQUE ══════════════════════════════════════════
              La géométrie s'écrit ici ET se manipule au canevas : deux chemins vers la même valeur,
              ce qui est acceptable parce qu'ils écrivent tous deux dans le modèle, contrairement au
              format qui vivait à trois endroits sans source commune. Un champ numérique reste
              indispensable, puisqu'aucune souris ne pose un calque exactement à 120 pixels. */}
          {/* ═══ LES TEXTES D'ABORD, TOUJOURS ══════════════════════════════════════════════════════
              « Le plus important, si je clique sur un élément de texte, c'est de pouvoir modifier
              le texte à droite, ça me semble évident. » Il a raison, et le panneau ratait le cas le
              plus fréquent : on clique rarement PILE sur le nœud qui porte le texte, on clique sur
              la boîte qui le contient, et le panneau répondait « ce nœud n'a pas de texte propre »,
              ce qui est exact et parfaitement inutile.

              Le bloc remonte donc TOUS les textes de la sélection, du nœud choisi ou de la pièce
              entière à défaut, à plat et dans l'ordre de lecture. Le premier champ du panneau est
              désormais toujours un champ de texte. */}
          {deckTab === 'details' && textesDeLaSelection.length > 0 && (
            <>
              <div className="zrm-det-sec" style={{ marginTop: 0 }}>
                <span style={{ width: 9 }} />Textes<span style={{ marginLeft: 'auto', opacity: .5 }}>{textesDeLaSelection.length}</span>
              </div>
              {textesDeLaSelection.map((t) => {
                const pose = reglagePour(t.path).text
                return (
                  <div key={t.path} className="zrm-det-row" data-on={selectedNode === t.path}>
                    <span className="zrm-det-lab" title={`${t.name} · ${t.tag}`}>{t.name}</span>
                    <input className="zrm-det-in" aria-label={`Texte ${t.name}`} value={pose ?? t.text}
                      onFocus={() => setSelectedNode(t.path)}
                      onChange={(e) => reglerChemin(t.path, { text: e.target.value })} />
                    {pose ? (
                      <button className="zrm-det-revert" title="Revenir au texte du composant" onClick={() => reglerChemin(t.path, { text: '' })}>
                        <Icon name="arrow.uturn.backward" size={10} />
                      </button>
                    ) : <span />}
                  </div>
                )
              })}
            </>
          )}

          {/* ═══ LES RÉGLAGES D'UN SOUS-COMPOSANT ════════════════════════════════════════════════
              « Quand je clique sur un éditeur je n'ai pas forcément accès à modifier le texte
              parce que ça créerait des comportements bizarres, mais dans le panel de droite je
              devrais pouvoir modifier tout ce que je veux. » C'est exactement le partage retenu :
              l'aperçu DÉSIGNE, il n'édite pas ; le panneau de droite édite tout.

              Le texte proposé est le texte PROPRE du nœud, jamais celui de ses enfants : régler
              le texte d'un conteneur effacerait sa descendance entière en un caractère. */}
          {/* ═══ ÉDITION GROUPÉE ET VALEURS MIXTES (famille 1) ═══════════════════════════════════
              Le Details Panel d'Unreal, sur une sélection multiple homogène, propose les
              propriétés COMMUNES et affiche « Multiple Values » là où elles divergent ; modifier
              un champ commun le propage à tous les objets sélectionnés. C'est exactement ce
              comportement, borné aux calques puisque ce sont eux qui partagent un terrain sûr :
              opacité, fusion, effets et typographie. Les propriétés de pièces sont déclarées par
              le thème et hétérogènes d'une famille à l'autre — les imposer en groupe casserait
              plus qu'il n'aiderait, donc l'édition groupée ne s'ouvre pas sur elles. */}
          {deckTab === 'details' && modeGroupe && (
            <>
              <div className="zrm-det-obj">
                <span className="zrm-tree-glyph">{calquesSelectionnes.length}</span>
                <span style={{ flex: 1, opacity: .7 }}>{calquesSelectionnes.length} calques sélectionnés</span>
                <span>édition groupée</span>
              </div>

              {/* ═══ FAMILLE PHOTOSHOP 2 · ALIGNEMENT ET DISTRIBUTION ═══════════════════════════
                  Aligne les calques les uns SUR LES AUTRES, sur leur boîte englobante commune —
                  jamais sur le canevas, comportement par défaut de Photoshop dès que plusieurs
                  calques sont choisis. Une seule rangée d'icônes, six alignements puis deux
                  distributions, cette dernière grisée sous trois calques puisqu'il n'y a alors
                  rien « entre » deux objets à égaliser. */}
              <div className="zrm-det-sec"><span style={{ width: 9 }} />Alignement</div>
              <div className="zrm-det-row" style={{ gridTemplateColumns: 'none' }}>
                <div className="zrm-align-row">
                  {[
                    ['left', 'Aligner à gauche', 'view.align.left'],
                    ['hcenter', 'Centrer horizontalement', 'view.align.left'],
                    ['right', 'Aligner à droite', 'view.align.left'],
                    ['top', 'Aligner en haut', 'view.align.left'],
                    ['vcenter', 'Centrer verticalement', 'view.align.left'],
                    ['bottom', 'Aligner en bas', 'view.align.left'],
                  ].map(([mode, titre]) => (
                    <button key={mode} className="zrm-tool" title={titre}
                      onClick={() => {
                        const patches = alignPatch(calquesSelectionnes, mode)
                        patchComposition((c) => patches.reduce((etat, p) => patchLayer(etat, p.id, p), c))
                      }}>
                      <AlignIcon mode={mode} />
                    </button>
                  ))}
                  <span className="zrm-tool-sep" />
                  {[['x', 'Distribuer horizontalement'], ['y', 'Distribuer verticalement']].map(([axe, titre]) => (
                    <button key={axe} className="zrm-tool" title={titre} disabled={calquesSelectionnes.length < 3}
                      onClick={() => {
                        const patches = distributePatch(calquesSelectionnes, axe)
                        patchComposition((c) => patches.reduce((etat, p) => patchLayer(etat, p.id, p), c))
                      }}>
                      <AlignIcon mode={`dist-${axe}`} />
                    </button>
                  ))}
                </div>
              </div>

              {/* FAMILLE MIRO 6 · CONNECTEURS. Relier exactement deux calques : le connecteur suit
                  leurs déplacements ensuite (recalculé par `applyConnectors` à chaque mutation),
                  jamais une ligne posée une fois pour toutes. Grisé au-delà de deux, une ligne ne
                  relie que deux points, jamais un groupe entier à la fois. */}
              <div className="zrm-det-sec"><span style={{ width: 9 }} />Connecteur</div>
              <div className="zrm-det-row">
                <button className="zrm-btn zrm-btn-sm" disabled={calquesSelectionnes.length !== 2}
                  title={calquesSelectionnes.length !== 2 ? 'Sélectionne exactement deux calques' : 'Relier ces deux calques par un connecteur'}
                  onClick={() => {
                    patchComposition((c) => createConnector(c, calquesSelectionnes[0].id, calquesSelectionnes[1].id))
                  }}>Relier par un connecteur</button>
                <span />
              </div>

              <div className="zrm-det-sec"><span style={{ width: 9 }} />Apparence commune</div>
              <div className="zrm-det-row">
                <span className="zrm-det-lab">Opacité</span>
                {(() => { const { valeur, mixte } = valeurGroupee((l) => l.opacity)
                  return <input className="zrm-det-in" type="range" min="0" max="1" step="0.01" aria-label="Opacité"
                    value={mixte ? 0 : valeur} title={mixte ? 'Plusieurs valeurs' : undefined}
                    style={{ accentColor: UI.blue, opacity: mixte ? .4 : 1 }}
                    onChange={(e) => { const v = Number(e.target.value); surLaSelection((c, id) => patchLayer(c, id, { opacity: v })) }} /> })()}
                <span className="zrm-tree-tag">{valeurGroupee((l) => l.opacity).mixte ? '—' : `${Math.round(valeurGroupee((l) => l.opacity).valeur * 100)}%`}</span>
              </div>
              <div className="zrm-det-row">
                <span className="zrm-det-lab">Fusion</span>
                {(() => { const { valeur, mixte } = valeurGroupee((l) => l.blend)
                  return <select className="zrm-det-in" aria-label="Mode de fusion" value={mixte ? '' : valeur}
                    onChange={(e) => { const v = e.target.value; surLaSelection((c, id) => patchLayer(c, id, { blend: v })) }}>
                    {mixte && <option value="">— plusieurs valeurs —</option>}
                    {BLEND_MODES.map((m) => <option key={m} value={m}>{m}</option>)}
                  </select> })()}
                <span />
              </div>
              {[['blur', 'Flou'], ['brightness', 'Luminosité'], ['contrast', 'Contraste'], ['saturate', 'Saturation']].map(([clef, libelle]) => {
                const { valeur, mixte } = valeurGroupee((l) => l.effects?.[clef] ?? (clef === 'blur' ? 0 : 1))
                return (
                  <div key={clef} className="zrm-det-row">
                    <span className="zrm-det-lab">{libelle}</span>
                    <input className="zrm-det-in" type="range" min="0" max={clef === 'blur' ? 40 : 3} step={clef === 'blur' ? 1 : 0.01}
                      aria-label={libelle} value={mixte ? 0 : valeur} style={{ accentColor: UI.blue, opacity: mixte ? .4 : 1 }}
                      onChange={(e) => { const v = Number(e.target.value); surLaSelection((c, id) => patchLayer(c, id, { effects: { [clef]: v } })) }} />
                    <span className="zrm-tree-tag">{mixte ? '—' : valeur}</span>
                  </div>
                )
              })}
              <div className="zrm-det-sec"><span style={{ width: 9 }} />Typographie commune</div>
              {LAYER_STYLES.map((champ) => {
                const { valeur, mixte } = valeurGroupee((l) => l.style?.[champ.key] || '')
                return (
                  <div key={champ.key} className="zrm-det-row">
                    <span className="zrm-det-lab">{champ.label}</span>
                    {champ.type === 'select' ? (
                      <select className="zrm-det-in" aria-label={champ.label} value={mixte ? '' : valeur}
                        onChange={(e) => { const v = e.target.value; surLaSelection((c, id) => patchLayer(c, id, { style: { [champ.key]: v } })) }}>
                        {mixte && <option value="">— plusieurs valeurs —</option>}
                        {champ.options.map((o) => <option key={o} value={o}>{o || '—'}</option>)}
                      </select>
                    ) : (
                      <input className="zrm-det-in" type={champ.type === 'color' ? 'color' : 'text'} aria-label={champ.label}
                        placeholder={mixte ? 'plusieurs valeurs' : (champ.hint || '')} value={mixte ? '' : valeur}
                        onChange={(e) => { const v = e.target.value; surLaSelection((c, id) => patchLayer(c, id, { style: { [champ.key]: v } })) }} />
                    )}
                    <span />
                  </div>
                )
              })}
            </>
          )}

          {deckTab === 'details' && !modeGroupe && noeudSelectionne && (
            <>
              <div className="zrm-det-obj">
                <span className="zrm-tree-glyph">{'<>'}</span>
                <input value={noeudSelectionne.name} readOnly aria-label="Sous-composant" />
                <span>{noeudSelectionne.tag}</span>
                <VerrouPanneau verrouille={panelLockedId === idPourPanneau} onClick={() => setPanelLockedId((v) => (v ? null : idPourPanneau))} />
              </div>
              <div className="zrm-det-row">
                <span className="zrm-det-lab">Chemin</span>
                <span className="zrm-det-lab" style={{ opacity: .7 }}>{selectedNode}</span>
                <button className="zrm-det-revert" title="Revenir à la pièce entière" onClick={() => setSelectedNode(null)}>
                  <Icon name="arrow.uturn.backward" size={10} />
                </button>
              </div>

              <div className="zrm-det-sec"><span style={{ width: 9 }} />Apparence</div>
              {NODE_STYLES.map((champ) => {
                const pose = reglageCourant.style?.[champ.key] || ''
                return (
                  <div key={champ.key} className="zrm-det-row">
                    <span className="zrm-det-lab">{champ.label}</span>
                    {champ.type === 'select' ? (
                      <select className="zrm-det-in" aria-label={champ.label} value={pose}
                        onChange={(e) => reglerNoeud({ style: { [champ.key]: e.target.value } })}>
                        {champ.options.map((o) => <option key={o} value={o}>{o || '—'}</option>)}
                      </select>
                    ) : (
                      <input className="zrm-det-in" type={champ.type === 'color' ? 'color' : 'text'}
                        aria-label={champ.label} placeholder={champ.hint || ''} value={pose}
                        onChange={(e) => reglerNoeud({ style: { [champ.key]: e.target.value } })} />
                    )}
                    {pose ? (
                      <button className="zrm-det-revert" title="Retirer ce réglage" onClick={() => reglerNoeud({ style: { [champ.key]: '' } })}>
                        <Icon name="arrow.uturn.backward" size={10} />
                      </button>
                    ) : <span />}
                  </div>
                )
              })}
            </>
          )}

          {deckTab === 'details' && !modeGroupe && !noeudSelectionne && calqueSelectionne && (
            <>
              <div className="zrm-det-obj">
                <span className="zrm-tree-glyph">{{ text: 'T', image: '▣', shape: '◼', component: '◈', table: '▦' }[calqueSelectionne.kind]}</span>
                <input value={calqueSelectionne.name} aria-label="Nom du calque"
                  onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { name: e.target.value }))} />
                <span>calque · {calqueSelectionne.kind}</span>
                <VerrouPanneau verrouille={panelLockedId === idPourPanneau} onClick={() => setPanelLockedId((v) => (v ? null : idPourPanneau))} />
              </div>

              <button className="zrm-det-sec" onClick={() => setDetSections((st) => ({ ...st, geo: detSections.geo === false }))}>
                <span className="zrm-twist" data-open={detSections.geo !== false}><Icon name="chevron.right" size={9} /></span>Géométrie
              </button>
              {detSections.geo !== false && [['x', 'Position X'], ['y', 'Position Y'], ['w', 'Taille X'], ['h', 'Taille Y'], ['rotation', 'Rotation']].map(([clef, libelle]) => (
                <div key={clef} className="zrm-det-row">
                  <span className="zrm-det-lab">{libelle}</span>
                  <input className="zrm-det-in" type="number" aria-label={libelle} value={calqueSelectionne[clef]}
                    onChange={(e) => {
                      const v = Number(e.target.value)
                      if (!Number.isFinite(v)) return
                      patchComposition((c) => patchLayer(c, calqueSelectionne.id, { [clef]: (clef === 'w' || clef === 'h') ? Math.max(1, v) : v }))
                    }} />
                  <span className="zrm-tree-tag">{clef === 'rotation' ? '°' : 'px'}</span>
                </div>
              ))}
              {/* FAMILLE FIGMA 3 · CONTRAINTES. Comment ce calque réagit au changement de FORMAT,
                  le seul redimensionnement de cadre que connaisse ce produit. */}
              {detSections.geo !== false && (
                <>
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Contrainte X</span>
                    <select className="zrm-det-in" aria-label="Contrainte horizontale" value={calqueSelectionne.constrainH}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { constrainH: e.target.value }))}>
                      <option value="left">Gauche</option>
                      <option value="center">Centre</option>
                      <option value="right">Droite</option>
                      <option value="scale">Échelle</option>
                    </select>
                    <span />
                  </div>
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Contrainte Y</span>
                    <select className="zrm-det-in" aria-label="Contrainte verticale" value={calqueSelectionne.constrainV}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { constrainV: e.target.value }))}>
                      <option value="top">Haut</option>
                      <option value="center">Centre</option>
                      <option value="bottom">Bas</option>
                      <option value="scale">Échelle</option>
                    </select>
                    <span />
                  </div>
                </>
              )}

              {/* FAMILLE POWERPOINT 2 · ALIGNER SUR LE CANEVAS. Un calque SEUL n'a rien à aligner
                  sur lui-même (l'alignement mutuel, ci-dessus dans la sélection groupée, exige au
                  moins deux calques) ; PowerPoint, Figma et Miro alignent alors sur le CANEVAS —
                  centrer un logo ou un titre sur le format est l'usage le plus courant du geste. */}
              {detSections.geo !== false && (
                <div className="zrm-det-row" style={{ gridTemplateColumns: 'none' }}>
                  <div className="zrm-align-row">
                    {[
                      ['left', 'Aligner à gauche du canevas'],
                      ['hcenter', 'Centrer horizontalement sur le canevas'],
                      ['right', 'Aligner à droite du canevas'],
                      ['top', 'Aligner en haut du canevas'],
                      ['vcenter', 'Centrer verticalement sur le canevas'],
                      ['bottom', 'Aligner en bas du canevas'],
                    ].map(([mode, titre]) => (
                      <button key={mode} className="zrm-tool" title={titre}
                        onClick={() => {
                          const patches = alignPatch([calqueSelectionne], mode, format.canvas)
                          patchComposition((c) => patches.reduce((etat, p) => patchLayer(etat, p.id, p), c))
                        }}>
                        <AlignIcon mode={mode} />
                      </button>
                    ))}
                  </div>
                </div>
              )}

              {/* RETOURNEMENT HORIZONTAL ET VERTICAL (famille Photoshop 2). Deux bascules, pas
                  deux boutons à effet unique : un second clic revient à l'état d'origine, comme
                  Photoshop où le retournement est un INTERRUPTEUR et non une action à sens unique. */}
              {detSections.geo !== false && (
                <div className="zrm-det-row">
                  <span className="zrm-det-lab">Retourner</span>
                  <span style={{ display: 'flex', gap: 4 }}>
                    <button className="zrm-tool" style={{ height: 22 }} data-on={calqueSelectionne.flipX} title="Retourner horizontalement"
                      onClick={() => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { flipX: !calqueSelectionne.flipX }))}>
                      <Icon name="arrow.up.arrow.down" size={11} style={{ transform: 'rotate(90deg)' }} />
                    </button>
                    <button className="zrm-tool" style={{ height: 22 }} data-on={calqueSelectionne.flipY} title="Retourner verticalement"
                      onClick={() => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { flipY: !calqueSelectionne.flipY }))}>
                      <Icon name="arrow.up.arrow.down" size={11} />
                    </button>
                  </span>
                  <span />
                </div>
              )}

              <button className="zrm-det-sec" onClick={() => setDetSections((st) => ({ ...st, contenu: detSections.contenu === false }))}>
                <span className="zrm-twist" data-open={detSections.contenu !== false}><Icon name="chevron.right" size={9} /></span>Contenu
              </button>
              {detSections.contenu !== false && (
                <div className="zrm-det-row">
                  <span className="zrm-det-lab">{calqueSelectionne.kind === 'text' ? 'Texte' : calqueSelectionne.kind === 'image' ? 'Adresse' : calqueSelectionne.kind === 'component' ? 'Composant' : calqueSelectionne.kind === 'table' ? 'Tableau' : 'Sans contenu'}</span>
                  {calqueSelectionne.kind === 'table' ? (
                    <span style={{ opacity: .6, fontSize: 11 }}>Réglages ci-dessous</span>
                  ) : calqueSelectionne.kind === 'component' ? (
                    <select className="zrm-det-in" aria-label="Composant du calque" value={calqueSelectionne.source}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { source: e.target.value }))}>
                      <option value="">—</option>
                      {(componentBundle?.components || []).map((e2) => <option key={e2.id} value={e2.id}>{e2.name}</option>)}
                    </select>
                  ) : calqueSelectionne.kind === 'shape' ? (
                    // FAMILLE PHOTOSHOP 4 · LE TYPE DE FORME. Rectangle, ellipse ou ligne : la
                    // seule propriété qu'un calque de forme n'avait jamais pu régler.
                    <select className="zrm-det-in" aria-label="Type de forme" value={calqueSelectionne.shapeType}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { shapeType: e.target.value }))}>
                      <option value="rectangle">Rectangle</option>
                      <option value="ellipse">Ellipse</option>
                      <option value="line">Ligne</option>
                      <option value="polygon">Polygone</option>
                      <option value="star">Étoile</option>
                    </select>
                  ) : calqueSelectionne.kind === 'text' ? (
                    // Un champ d'une ligne pour un calque de titre est une infirmité : un titre se
                    // coupe, et la coupe fait partie du dessin. Le retour à la ligne est conservé
                    // jusque dans la page rendue, où il devient un <br>.
                    <textarea className="zrm-det-in" aria-label="Contenu du calque" rows={3}
                      style={{ height: 'auto', minHeight: 46, resize: 'vertical', lineHeight: 1.4, padding: '4px 6px' }}
                      value={calqueSelectionne.source}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { source: e.target.value }))} />
                  ) : (
                    <input className="zrm-det-in" aria-label="Contenu du calque" value={calqueSelectionne.source}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { source: e.target.value }))} />
                  )}
                  <span />
                </div>
              )}

              {/* FAMILLE POWERPOINT 3 · LISTE ET LIEN. Une liste est une ligne par retour à la
                  ligne (portée assumée au-dessus de LIST_STYLES, jamais des niveaux imbriqués) ;
                  le lien passe par `safeHref`, qui refuse tout protocole dangereux à l'écriture. */}
              {detSections.contenu !== false && calqueSelectionne.kind === 'text' && (
                <>
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Liste</span>
                    <select className="zrm-det-in" aria-label="Type de liste" value={calqueSelectionne.listStyle}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { listStyle: e.target.value }))}>
                      <option value="none">Aucune</option>
                      <option value="bullet">À puces</option>
                      <option value="number">Numérotée</option>
                    </select>
                    <span />
                  </div>
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Lien</span>
                    <input className="zrm-det-in" aria-label="Lien du texte" placeholder="https://…"
                      value={calqueSelectionne.href}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { href: e.target.value }))} />
                    <span />
                  </div>
                  {/* FAMILLE INDESIGN D3 · CHAÎNAGE. Chaque bloc garde son propre texte (`source`) ;
                      ce qui se lit ici est SEULEMENT la relation structurelle avec ses voisins de
                      la même histoire, jamais un contenu recopié d'un bloc à l'autre. */}
                  {(calqueSelectionne.threadPrevId || calqueSelectionne.threadNextId) && (
                    <div className="zrm-det-row">
                      <span className="zrm-det-lab">Histoire</span>
                      <span style={{ fontSize: 11, opacity: .8, lineHeight: 1.4 }}>
                        {calqueSelectionne.threadPrevId && <>Chaîné depuis « {findLayer(composition, calqueSelectionne.threadPrevId)?.name} ».<br /></>}
                        {calqueSelectionne.threadNextId && <>Chaîné vers « {findLayer(composition, calqueSelectionne.threadNextId)?.name} ».</>}
                      </span>
                      <span />
                    </div>
                  )}
                  {calqueSelectionne.threadNextId && (
                    <div className="zrm-det-row">
                      <span className="zrm-det-lab" />
                      <button className="zrm-tool" onClick={() => patchComposition((c) => unthreadTextLayer(c, calqueSelectionne.id))}
                        title="Rompre le lien vers le bloc suivant, sans toucher au contenu d’aucun des deux">
                        Déchaîner
                      </button>
                      <span />
                    </div>
                  )}
                  {overflowingLayerIds.has(calqueSelectionne.id) && !calqueSelectionne.threadNextId && (
                    <p style={{ color: '#e5484d', fontSize: 11, margin: '4px 0 0', lineHeight: 1.4 }}>
                      Texte en excès : une partie de ce texte dépasse le cadre et n’est affichée dans aucun bloc. Chaîne ce bloc (port de sortie) vers un autre pour la montrer ailleurs, ou agrandis le cadre.
                    </p>
                  )}
                  {/* FAMILLE INDESIGN D5 · HABILLAGE. Le texte évite l'obstacle choisi (mode boîte
                      englobante) via un flottant invisible calculé par `textWrapFloat` — jamais une
                      forme réelle ni une trajectoire de détourage, hors de portée d'un rendu CSS. */}
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Habillage</span>
                    <select className="zrm-det-in" aria-label="Éviter un objet" value={calqueSelectionne.wrapAroundId}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { wrapAroundId: e.target.value }))}>
                      <option value="">[Aucun]</option>
                      {readLayers(composition).filter((l) => l.id !== calqueSelectionne.id).map((l) => (
                        <option key={l.id} value={l.id}>{l.name}</option>
                      ))}
                    </select>
                    <span />
                  </div>
                  {calqueSelectionne.wrapAroundId && (
                    <div className="zrm-det-row">
                      <span className="zrm-det-lab">Marge</span>
                      <input className="zrm-det-in" type="number" min="0" max="80" aria-label="Marge d’habillage"
                        value={calqueSelectionne.wrapGap}
                        onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { wrapGap: Number(e.target.value) }))} />
                      <span />
                    </div>
                  )}
                </>
              )}

              {/* FAMILLE POWERPOINT 5 · LE TABLEAU. Lignes et colonnes bornées 1-8 ; redimensionner
                  conserve le contenu déjà saisi (`resizeTableCells`), jamais un effacement surprise.
                  La grille de cellules reste un tableau À PLAT, jamais imbriqué (voir layers.js). */}
              {detSections.contenu !== false && calqueSelectionne.kind === 'table' && (
                <>
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Lignes</span>
                    <input className="zrm-det-in" type="number" min="1" max="8" aria-label="Nombre de lignes"
                      value={calqueSelectionne.tableRows}
                      onChange={(e) => {
                        const lignes = Math.min(8, Math.max(1, Math.round(Number(e.target.value)) || 1))
                        patchComposition((c) => patchLayer(c, calqueSelectionne.id, {
                          tableRows: lignes,
                          tableCells: resizeTableCells(calqueSelectionne.tableCells, calqueSelectionne.tableRows, calqueSelectionne.tableCols, lignes, calqueSelectionne.tableCols),
                        }))
                      }} />
                    <span />
                  </div>
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Colonnes</span>
                    <input className="zrm-det-in" type="number" min="1" max="8" aria-label="Nombre de colonnes"
                      value={calqueSelectionne.tableCols}
                      onChange={(e) => {
                        const colonnes = Math.min(8, Math.max(1, Math.round(Number(e.target.value)) || 1))
                        patchComposition((c) => patchLayer(c, calqueSelectionne.id, {
                          tableCols: colonnes,
                          tableCells: resizeTableCells(calqueSelectionne.tableCells, calqueSelectionne.tableRows, calqueSelectionne.tableCols, calqueSelectionne.tableRows, colonnes),
                        }))
                      }} />
                    <span />
                  </div>
                  <div className="zrm-det-row" style={{ gridTemplateColumns: 'none' }}>
                    <div style={{ display: 'grid', gridTemplateColumns: `repeat(${calqueSelectionne.tableCols}, 1fr)`, gap: 4, width: '100%' }}>
                      {calqueSelectionne.tableCells.map((valeur, i) => (
                        <input key={i} className="zrm-det-in" aria-label={`Cellule ${Math.floor(i / calqueSelectionne.tableCols) + 1}-${(i % calqueSelectionne.tableCols) + 1}`}
                          value={valeur}
                          onChange={(e) => {
                            const cellules = [...calqueSelectionne.tableCells]
                            cellules[i] = e.target.value
                            patchComposition((c) => patchLayer(c, calqueSelectionne.id, { tableCells: cellules }))
                          }} />
                      ))}
                    </div>
                  </div>
                </>
              )}

              {/* FAMILLE FIGMA 6 · POLYGONE ET ÉTOILE, les deux formes PARAMÉTRIQUES de Figma :
                  un nombre de côtés, et pour l'étoile un ratio de rayon interne. Jamais un tracé à
                  points qu'on déplace un par un, portée assumée et écrite au-dessus de SHAPE_TYPES. */}
              {detSections.contenu !== false && calqueSelectionne.kind === 'shape' && (calqueSelectionne.shapeType === 'polygon' || calqueSelectionne.shapeType === 'star') && (
                <>
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Côtés</span>
                    <input className="zrm-det-in" type="range" min="3" max="12" step="1" aria-label="Nombre de côtés"
                      value={calqueSelectionne.shapeSides} style={{ accentColor: UI.blue }}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { shapeSides: Number(e.target.value) }))} />
                    <span className="zrm-tree-tag">{calqueSelectionne.shapeSides}</span>
                  </div>
                  {calqueSelectionne.shapeType === 'star' && (
                    <div className="zrm-det-row">
                      <span className="zrm-det-lab">Ratio</span>
                      <input className="zrm-det-in" type="range" min="0.1" max="0.9" step="0.05" aria-label="Ratio de l’étoile"
                        value={calqueSelectionne.shapeStarRatio} style={{ accentColor: UI.blue }}
                        onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { shapeStarRatio: Number(e.target.value) }))} />
                      <span className="zrm-tree-tag">{Math.round(calqueSelectionne.shapeStarRatio * 100)}%</span>
                    </div>
                  )}
                </>
              )}

              {/* FAMILLE PHOTOSHOP 6 · LE POINT FOCAL. La boîte du calque agit déjà comme un
                  cadre de recadrage (`object-fit:cover`, hérité depuis la carte L1) ; ce qui
                  manquait est de choisir QUELLE partie de l'image y reste visible, exactement ce
                  que fait glisser le cadre de recadrage dans Photoshop, sans retailler le fichier
                  source ni construire un outil de recadrage séparé. */}
              {detSections.contenu !== false && calqueSelectionne.kind === 'image' && (
                <>
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Focale X</span>
                    <input className="zrm-det-in" type="range" min="0" max="100" step="1" aria-label="Focale X"
                      value={calqueSelectionne.focalX} style={{ accentColor: UI.blue }}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { focalX: Number(e.target.value) }))} />
                    <span className="zrm-tree-tag">{calqueSelectionne.focalX}%</span>
                  </div>
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Focale Y</span>
                    <input className="zrm-det-in" type="range" min="0" max="100" step="1" aria-label="Focale Y"
                      value={calqueSelectionne.focalY} style={{ accentColor: UI.blue }}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { focalY: Number(e.target.value) }))} />
                    <span className="zrm-tree-tag">{calqueSelectionne.focalY}%</span>
                  </div>
                </>
              )}

              {/* TYPOGRAPHIE ET SURFACE. C'est ce qui manquait pour que « la fonction texte » en
                  soit une : corps, police, graisse, casse, alignement horizontal ET vertical. Les
                  quatorze réglages écrivent dans `layer.style`, liste fermée, style en ligne. */}
              <button className="zrm-det-sec" onClick={() => setDetSections((st) => ({ ...st, typo: detSections.typo === false }))}>
                <span className="zrm-twist" data-open={detSections.typo !== false}><Icon name="chevron.right" size={9} /></span>Typographie et surface
              </button>
              {/* FAMILLE INDESIGN D4 · STYLE DE TEXTE. Une définition PARTAGÉE, réutilisable par
                  plusieurs calques — le signe « + » dit qu'au moins un réglage ci-dessous a été
                  remplacé localement sur CE calque précis, sans affecter les autres qui appliquent
                  le même style. « Effacer les remplacements » les efface TOUS d'un coup. */}
              {detSections.typo !== false && calqueSelectionne.kind === 'text' && (
                <div className="zrm-det-row">
                  <span className="zrm-det-lab">Style de texte</span>
                  <select className="zrm-det-in" aria-label="Style de texte" value={calqueSelectionne.textStyleId}
                    onChange={(e) => patchComposition((c) => setLayerTextStyle(c, calqueSelectionne.id, e.target.value))}>
                    <option value="">[Aucun]</option>
                    {readTextStyles(composition).map((s) => <option key={s.id} value={s.id}>{s.name}</option>)}
                  </select>
                  {calqueSelectionne.textStyleId && hasTextStyleOverride(calqueSelectionne) ? (
                    <button className="zrm-det-revert" title="Effacer les remplacements : revenir exactement au style"
                      onClick={() => patchComposition((c) => clearTextStyleOverrides(c, calqueSelectionne.id))}>
                      <Icon name="arrow.uturn.backward" size={10} />
                    </button>
                  ) : <span />}
                </div>
              )}
              {/* FAMILLE INDESIGN D7 · STYLE D'OBJET. Le pendant du style de texte ci-dessus pour
                  l'APPARENCE : s'affiche pour N'IMPORTE QUEL calque, jamais restreint au texte. */}
              {detSections.typo !== false && (
                <div className="zrm-det-row">
                  <span className="zrm-det-lab">Style d’objet</span>
                  <select className="zrm-det-in" aria-label="Style d’objet" value={calqueSelectionne.objectStyleId}
                    onChange={(e) => patchComposition((c) => setLayerObjectStyle(c, calqueSelectionne.id, e.target.value))}>
                    <option value="">[Aucun]</option>
                    {readObjectStyles(composition).map((s) => <option key={s.id} value={s.id}>{s.name}</option>)}
                  </select>
                  {calqueSelectionne.objectStyleId && hasObjectStyleOverride(calqueSelectionne) ? (
                    <button className="zrm-det-revert" title="Effacer les remplacements : revenir exactement au style"
                      onClick={() => patchComposition((c) => clearObjectStyleOverrides(c, calqueSelectionne.id))}>
                      <Icon name="arrow.uturn.backward" size={10} />
                    </button>
                  ) : <span />}
                </div>
              )}
              {detSections.typo !== false && LAYER_STYLES.map((champ) => {
                const local = calqueSelectionne.style?.[champ.key] || ''
                // La valeur AFFICHÉE est la valeur EFFECTIVE (locale si réglée, sinon héritée du
                // style de texte OU du style d'objet appliqué, selon lequel des deux gouverne ce
                // champ précis — les deux listes ne se recouvrent jamais) : modifier ce champ écrit
                // toujours dans le remplacement local, jamais dans une définition partagée.
                const pose = calqueSelectionne.kind === 'text' && calqueSelectionne.textStyleId && TEXT_STYLE_KEYS.includes(champ.key)
                  ? (resolvedTextStyle(composition, calqueSelectionne)[champ.key] || '')
                  : calqueSelectionne.objectStyleId && OBJECT_STYLE_KEYS.includes(champ.key)
                  ? (resolvedObjectStyle(composition, calqueSelectionne)[champ.key] || '')
                  : local
                return (
                  <div key={champ.key} className="zrm-det-row">
                    <span className="zrm-det-lab">{champ.label}</span>
                    {champ.type === 'select' ? (
                      <select className="zrm-det-in" aria-label={champ.label} value={pose}
                        onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { style: { [champ.key]: e.target.value } }))}>
                        {champ.options.map((o) => <option key={o} value={o}>{o || '—'}</option>)}
                      </select>
                    ) : (
                      <input className="zrm-det-in" type={champ.type === 'color' ? 'color' : 'text'}
                        aria-label={champ.label} placeholder={champ.hint || ''} value={pose}
                        onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { style: { [champ.key]: e.target.value } }))} />
                    )}
                    {local ? (
                      <button className="zrm-det-revert" title="Retirer ce réglage"
                        onClick={() => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { style: { [champ.key]: '' } }))}>
                        <Icon name="arrow.uturn.backward" size={10} />
                      </button>
                    ) : <span />}
                  </div>
                )
              })}

              <button className="zrm-det-sec" onClick={() => setDetSections((st) => ({ ...st, app: detSections.app === false }))}>
                <span className="zrm-twist" data-open={detSections.app !== false}><Icon name="chevron.right" size={9} /></span>Apparence
              </button>
              {detSections.app !== false && (
                <>
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Opacité</span>
                    <input className="zrm-det-in" type="range" min="0" max="1" step="0.01" aria-label="Opacité"
                      value={calqueSelectionne.opacity} style={{ accentColor: UI.blue }}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { opacity: Number(e.target.value) }))} />
                    <span className="zrm-tree-tag">{Math.round(calqueSelectionne.opacity * 100)}%</span>
                  </div>
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Fusion</span>
                    <select className="zrm-det-in" aria-label="Mode de fusion" value={calqueSelectionne.blend}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { blend: e.target.value }))}>
                      {BLEND_MODES.map((m) => <option key={m} value={m}>{m}</option>)}
                    </select>
                    <span />
                  </div>
                  {[['blur', 'Flou', 0, 40, 1], ['brightness', 'Luminosité', 0, 2, 0.01], ['contrast', 'Contraste', 0, 2, 0.01], ['saturate', 'Saturation', 0, 3, 0.01]].map(([clef, libelle, min, max, pas]) => (
                    <div key={clef} className="zrm-det-row">
                      <span className="zrm-det-lab">{libelle}</span>
                      <input className="zrm-det-in" type="range" min={min} max={max} step={pas} aria-label={libelle}
                        value={calqueSelectionne.effects?.[clef] ?? (clef === 'blur' ? 0 : 1)} style={{ accentColor: UI.blue }}
                        onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { effects: { [clef]: Number(e.target.value) } }))} />
                      <span className="zrm-tree-tag">{calqueSelectionne.effects?.[clef] ?? (clef === 'blur' ? 0 : 1)}</span>
                    </div>
                  ))}
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Ombre</span>
                    <input className="zrm-det-in" aria-label="Ombre portée" placeholder="0 10px 30px rgba(0,0,0,.4)"
                      value={calqueSelectionne.effects?.shadow || ''}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { effects: { shadow: e.target.value } }))} />
                    <span />
                  </div>
                  {/* FAMILLE FIGMA 7 · REMPLISSAGE DÉGRADÉ, l'ajout réel de cette carte. Un fond uni
                      (réglage « Fond » ci-dessus, dans Typographie et surface) ou un dégradé, jamais
                      les deux à la fois : le sélecteur bascule l'un pour l'autre sans les cumuler. */}
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Remplissage</span>
                    <select className="zrm-det-in" aria-label="Type de remplissage" value={calqueSelectionne.fillType}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { fillType: e.target.value }))}>
                      <option value="solid">Uni</option>
                      <option value="gradient">Dégradé</option>
                    </select>
                    <span />
                  </div>
                  {calqueSelectionne.fillType === 'gradient' && (
                    <>
                      <div className="zrm-det-row">
                        <span className="zrm-det-lab">Dégradé, départ</span>
                        <input className="zrm-det-in" type="color" aria-label="Couleur de départ du dégradé"
                          value={calqueSelectionne.gradientFrom}
                          onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { gradientFrom: e.target.value }))} />
                        <span />
                      </div>
                      <div className="zrm-det-row">
                        <span className="zrm-det-lab">Dégradé, arrivée</span>
                        <input className="zrm-det-in" type="color" aria-label="Couleur d’arrivée du dégradé"
                          value={calqueSelectionne.gradientTo}
                          onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { gradientTo: e.target.value }))} />
                        <span />
                      </div>
                      <div className="zrm-det-row">
                        <span className="zrm-det-lab">Angle</span>
                        <input className="zrm-det-in" type="range" min="0" max="359" step="1" aria-label="Angle du dégradé"
                          value={calqueSelectionne.gradientAngle} style={{ accentColor: UI.blue }}
                          onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { gradientAngle: Number(e.target.value) }))} />
                        <span className="zrm-tree-tag">{calqueSelectionne.gradientAngle}°</span>
                      </div>
                    </>
                  )}
                  {/* FAMILLE POWERPOINT 6 · ENTRÉE ANIMÉE. Sert l'aperçu interactif et un futur
                      export vidéo/GIF d'un seul canevas ; les transitions entre diapositives sont
                      écartées par écrit (KANBAN.md), aucun mode présentation n'existe ici. */}
                  <div className="zrm-det-row">
                    <span className="zrm-det-lab">Entrée animée</span>
                    <select className="zrm-det-in" aria-label="Style d’entrée animée" value={calqueSelectionne.animationStyle}
                      onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { animationStyle: e.target.value }))}>
                      <option value="none">Aucune</option>
                      <option value="fade">Fondu</option>
                      <option value="rise">Montée</option>
                      <option value="zoom">Zoom</option>
                    </select>
                    <span />
                  </div>
                  {calqueSelectionne.animationStyle !== 'none' && (
                    <div className="zrm-det-row">
                      <span className="zrm-det-lab">Délai</span>
                      <input className="zrm-det-in" type="range" min="0" max="3000" step="50" aria-label="Délai de l’entrée animée"
                        value={calqueSelectionne.animationDelay} style={{ accentColor: UI.blue }}
                        onChange={(e) => patchComposition((c) => patchLayer(c, calqueSelectionne.id, { animationDelay: Number(e.target.value) }))} />
                      <span className="zrm-tree-tag">{calqueSelectionne.animationDelay} ms</span>
                    </div>
                  )}
                  {/* FAMILLE ILLUSTRATOR I2 · LE CONTOUR DU TRACÉ. Un tracé peint son fond et son
                      contour SUR le <path> lui-même (`compile.js`), jamais via les réglages Fond/
                      Ombre ci-dessus qui restent rectangulaires — d'où des réglages dédiés, ici,
