  // pour que le relâchement sache s'il y a réellement quelque chose à empiler.
  const patchComposicionEnDirect = React.useCallback((nextOrFactory) => {
    if (gesteTransactionRef.current) gesteTransactionRef.current.sale = true
    patchProject((p) => {
      const current = normalizeComposition(p.compositions?.[themeId], themeId)
      const brut = typeof nextOrFactory === 'function' ? nextOrFactory(current) : nextOrFactory
      const next = applyConnectors(applyAutoLayout(brut))
      return { compositions: { ...(p.compositions || {}), [themeId]: next } }
    })
  }, [patchProject, themeId])

  // Instantané pris à l'OUVERTURE d'un geste (AUDIT P1-R1) : la composition d'avant, pour que
  // `onPoigneeUp` empile une transaction unique et qu'Échap puisse y revenir intégralement. Fonction
  // simple, jamais mémorisée : recréée à chaque rendu comme les gestionnaires `onPoignee*` qui
  // l'appellent, elle lit donc toujours `project`/`themeId` à jour, sans risque de fermeture périmée.
  const commencerGeste = () => {
    gesteTransactionRef.current = { avant: normalizeComposition(project?.compositions?.[themeId], themeId), sale: false }
  }

  // COMMIT DE LA TRANSACTION (AUDIT P1-R1) : une seule entrée d'historique pour tout le geste, jamais
  // une par `pointermove` — rien n'est empilé si le clic n'a produit aucun mouvement (`sale` reste
  // `false`), exactement le comportement d'avant pour un simple clic. Partagée par tous les relâchés
  // de geste (`onPoigneeUp`, `onStageUp`) : un repère se glisse par un chemin de canevas distinct des
  // poignées de calque, mais commet sa transaction de la même façon.
  const commiterGeste = () => {
    const transaction = gesteTransactionRef.current
    if (!transaction) return
    gesteTransactionRef.current = null
    if (transaction.sale) {
      setPileAnnuler((pile) => [...pile.slice(-(HISTORIQUE_MAX - 1)), transaction.avant])
      setPileRetablir([])
    }
  }

  const annuler = React.useCallback(() => {
    if (!pileAnnuler.length) return
    const precedent = pileAnnuler[pileAnnuler.length - 1]
    const actuel = normalizeComposition(project?.compositions?.[themeId], themeId)
    setPileAnnuler((pile) => pile.slice(0, -1))
    setPileRetablir((pile) => [...pile, actuel])
    patchProject((p) => ({ compositions: { ...(p.compositions || {}), [themeId]: precedent } }))
  }, [pileAnnuler, patchProject, themeId, currentId, project])

  const retablir = React.useCallback(() => {
    if (!pileRetablir.length) return
    const suivant = pileRetablir[pileRetablir.length - 1]
    const actuel = normalizeComposition(project?.compositions?.[themeId], themeId)
    setPileRetablir((pile) => pile.slice(0, -1))
    setPileAnnuler((pile) => [...pile, actuel])
    patchProject((p) => ({ compositions: { ...(p.compositions || {}), [themeId]: suivant } }))
  }, [pileRetablir, patchProject, themeId, currentId, project])

  // ═══ FAMILLE FIGMA 3 · LES CONTRAINTES S'APPLIQUENT AU CHANGEMENT DE FORMAT ═══════════════════
  //
  // Le canevas change de taille à chaque format choisi — carré, 9:16, A4 — et c'est le SEUL
  // moment où « la frame est redimensionnée » a un sens dans ce produit. `canevasPrecedentRef`
  // porte les dimensions d'AVANT le changement, pour que `applyConstraintsToAll` sache de combien
  // le cadre a bougé. Elle se réinitialise sur un changement de document ou de thème, pour la même
  // raison que l'historique juste au-dessus : un format qui change de sens sur un autre document
  // ne doit jamais faire bouger les calques de celui qu'on regarde maintenant.
  const canevasPrecedentRef = React.useRef({ w: format.canvas.w, h: format.canvas.h })
  React.useEffect(() => { canevasPrecedentRef.current = { w: format.canvas.w, h: format.canvas.h } }, [currentId, themeId])
  React.useEffect(() => {
    const avant = canevasPrecedentRef.current
    const apres = { w: format.canvas.w, h: format.canvas.h }
    if (avant.w === apres.w && avant.h === apres.h) return
    patchComposition((c) => applyConstraintsToAll(c, avant, apres))
    canevasPrecedentRef.current = apres
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [format.canvas.w, format.canvas.h])

  const buildCutNow = React.useCallback(() => {
    if (!project) return
    const next = buildCut(project.brief, project.notes, theme)
    patchProject({ cut: next })
    setSelectedBeat(0)
    setActionCount((n) => n + 1)
    notify(`Partition montée : ${next.beats.length} beats.`, 'ok')
  }, [project, theme, patchProject, notify])

  // Premier montage automatique : l'application ne s'ouvre jamais sur un écran vide.
  // AUDIT P0-T9 · `loadedThemeId === themeId` EN PLUS de `theme` : sans cette garde, ouvrir un
  // document sans Cut pendant qu'un AUTRE thème achève encore son chargement pouvait monter la
  // toute première partition avec les règles typographiques du thème PRÉCÉDENT, silencieusement.
  React.useEffect(() => {
    if (project && !project.cut && theme && loadedThemeId === themeId) {
      patchProject({ cut: buildCut(project.brief, project.notes, theme) })
    }
  }, [project, theme, themeId, loadedThemeId, patchProject])

  // --- Compilation ----------------------------------------------------------------------------
  const compiled = React.useMemo(() => {
    if (!project || !cut || !theme) return null
    if (validate('brief', project.brief).length || validate('cut', cut).length) return null
    try {
      return compile({ brief: project.brief, cut, theme, format, dark: renderDark, seed: project.seed ?? 1, fitScale: contentScale, composition, componentBundle })
    } catch (err) {
      return { html: '', meta: {}, error: err.message }
    }
  }, [project, cut, theme, format, renderDark, contentScale, composition, componentBundle])

  // DEUX RENDUS, ET C'EST DELIBERE. `compiled` sert AUSSI a l'export (HTML et PNG), qui doit rester
  // sans script : le pont de selection n'y a donc pas sa place. L'apercu recoit un second rendu, le
  // meme au pont pres. Le cout est un assemblage de chaine, pas un travail reseau.
  const previewHtml = React.useMemo(() => {
    if (!project || !cut || !theme) return ''
    try {
      return compile({ brief: project.brief, cut, theme, format, dark: renderDark, seed: project.seed ?? 1, fitScale: contentScale, composition, componentBundle, interactive: true }).html
    } catch { return compiled?.html || '' }
  }, [project, cut, theme, format, renderDark, contentScale, composition, componentBundle, compiled])

  // AUDIT P2-V1 (première tranche) · UNE VRAIE VIGNETTE par diapositive, pas la liste textuelle
  // d'avant (« les diapositives apparaissent comme une liste textuelle, sans vignette », 04-UX-UI-
  // PARCOURS.md). Même technique que l'export « toutes les diapositives » juste plus haut dans ce
  // fichier : recompiler la MÊME composition avec CETTE diapositive seule active — c'est déjà ce
  // que `isEffectivelyHidden` (R4, plus tôt dans cette session) filtre pour l'aperçu principal, la
  // vignette ne fait que rejouer la même règle sur une diapositive qui n'est pas la courante.
  const slideThumbnails = React.useMemo(() => {
    if (!project || !cut || !theme) return {}
    const map = {}
    for (const slide of readSlides(composition)) {
      try {
        map[slide.id] = compile({ brief: project.brief, cut, theme, format, dark: renderDark, seed: project.seed ?? 1, fitScale: contentScale, composition: setActiveSlide(composition, slide.id), componentBundle }).html
      } catch { map[slide.id] = '' }
    }
    return map
  }, [project, cut, theme, format, renderDark, contentScale, composition, componentBundle])

  const debouncedHtml = useDebounced(previewHtml, 220)
  // LA PIÈCE SÉLECTIONNÉE ET SES CHAMPS DÉCLARÉS (carte C1, volet interface).
  //
  // Le compilateur sait lire `item.props` depuis l'étape 2, mais rien ne permettait d'en SAISIR une
  // valeur : C1 existait sans surface. C'est ici qu'elle en reçoit une, et c'est le geste
  // fondamental d'un éditeur de widgets — sélectionner une pièce, éditer ses propriétés.
  // LES TROIS SÉLECTEURS DE PANNEAU LISENT `idPourPanneau`, PAS `selectedComponent` DIRECTEMENT.
  // C'est tout ce que demande le verrou : le reste de l'interface (surlignage dans la hiérarchie,
  // pont de sélection depuis l'aperçu) continue de suivre `selectedComponent` sans changement.
  const pieceSelectionnee = React.useMemo(() => {
    if (!idPourPanneau) return null
    for (const row of composition?.rows || []) for (const item of row.items || []) if (item.id === idPourPanneau) return item
    return null
  }, [composition, idPourPanneau])

  // L'ARBRE DES SOUS-COMPOSANTS, lu sur la page réellement compilée et non sur le gabarit source.
  // C'est ce qui le rend juste : ce que l'arbre montre est ce que la page contient, pas ce que
  // l'auteur du fragment avait prévu. On le recalcule sur le HTML DÉBOUNCÉ, celui de l'aperçu,
  // afin qu'il ne se reconstruise pas à chaque frappe.
  const arbreNoeuds = React.useMemo(() => parseTree(debouncedHtml), [debouncedHtml])

  // Le geste d'Unreal, et celui de Photoshop : un clic ouvre le nœud, un shift-clic ouvre ou ferme
  // toute sa descendance d'un coup. Le sens du basculement est décidé par l'état du nœud cliqué,
  // sans quoi une descendance à moitié ouverte se replierait par moitiés à chaque clic.
  const basculerNoeud = React.useCallback((instanceId, chemin, avecDescendance) => {
    setOuverts((etat) => {
      const clef = `${instanceId}:${chemin}`
      const ouvrir = !etat[clef]
      if (!avecDescendance) return { ...etat, [clef]: ouvrir }
      const racine = findNode(arbreNoeuds, instanceId, chemin)
      const suite = { ...etat, [clef]: ouvrir }
      for (const p of allPaths(racine ? [racine] : [])) suite[`${instanceId}:${p}`] = ouvrir
      return suite
    })
  }, [arbreNoeuds])

  // Tout replier, y compris les pièces : le bouton que Matthieu cherchait dans la hiérarchie.
  const toutReplier = React.useCallback(() => {
    setOuverts({}); setOpenNodes({})
    const g = { calques: true }
    for (const row of composition.rows || []) g[`row:${row.id}`] = true
    setGroupesReplies(g)
  }, [composition])
  const toutDeplier = React.useCallback(() => {
    const suite = {}
    const pieces = {}
    for (const [instanceId, liste] of Object.entries(arbreNoeuds)) {
      pieces[instanceId] = true
      for (const p of allPaths(liste)) suite[`${instanceId}:${p}`] = true
    }
    setOuverts(suite); setOpenNodes(pieces); setGroupesReplies({})
  }, [arbreNoeuds])

  // L'ordre visible de la hiérarchie : les calques du premier plan vers le fond, puis les pièces
  // rangée par rangée. Maj-clic sélectionne « de l'ancre jusqu'ici » DANS CET ORDRE, sans quoi la
  // plage choisie ne correspondrait pas à ce que l'œil voit.
  const ordreHierarchie = React.useMemo(() => [
    ...stackOrder(composition).map((l) => l.id),
    ...(composition.rows || []).flatMap((r) => (r.items || []).map((it) => it.id)),
  ], [composition])

  const choisir = React.useCallback((id, event) => {
    const multiple = event?.metaKey || event?.ctrlKey
    const plage = event?.shiftKey
    setSelection((avant) => {
      if (plage && ancreRef.current) {
        const a = ordreHierarchie.indexOf(ancreRef.current)
        const b = ordreHierarchie.indexOf(id)
        if (a >= 0 && b >= 0) return ordreHierarchie.slice(Math.min(a, b), Math.max(a, b) + 1)
      }
      if (multiple) return avant.includes(id) ? avant.filter((x) => x !== id) : [...avant, id]
      return [id]
    })
    if (!plage) ancreRef.current = id
    setSelectedComponent(id)
    setSelectedNode(null)
    setDeckTab('details')
  }, [ordreHierarchie])

  // AUDIT P1-R4 : `ordreHierarchie` reste volontairement GLOBAL (toutes diapositives confondues) —
  // c'est ce que la pile de Calques affiche réellement, la portée juste pour son propre clic-plage.
  // La navigation clavier, elle, se produit depuis le CANEVAS : sauter vers un calque d'une autre
  // diapositive y afficherait une sélection invisible à l'écran, exactement l'ensemble divergent que
  // ce lot ferme pour le marquee et le magnétisme. Elle prend donc son propre ordre, visible seul.
  const ordreVisible = React.useMemo(() => [
    // `stackOrder`, PAS `readVisibleLayers` : celle-ci garde l'ordre BRUT du tableau (insertion),
    // quand la navigation doit suivre l'ordre de PILE affiché à l'écran (le calque du dessus
    // d'abord) — le même ordre que la boîte de sélection et le clic Tab utilisent déjà.
    ...stackOrder(composition).filter((l) => !isEffectivelyHidden(composition, l)).map((l) => l.id),
    ...(composition.rows || []).flatMap((r) => (r.items || []).map((it) => it.id)),
  ], [composition])

  const naviguerHierarchie = React.useCallback((direction) => {
    if (!ordreVisible.length) return
    const i = ordreVisible.indexOf(selectedComponent)
    const suivant = i < 0 ? 0 : Math.max(0, Math.min(ordreVisible.length - 1, i + direction))
    choisir(ordreVisible[suivant], {})
  }, [ordreVisible, selectedComponent, choisir])


  // Une action de groupe s'applique à TOUTE la sélection, jamais au seul objet cliqué : c'est le
  // seul comportement qui rende la sélection multiple utile.
  // Agir sur une rangée QUI N'EST PAS dans la sélection n'agit que sur elle : c'est le
  // comportement du Finder comme de Photoshop, et l'inverse serait dangereux, puisqu'on
  // supprimerait quinze objets en croyant en supprimer un.
  const surLaSelection = React.useCallback((agir, idClique) => {
    const cibles = idClique && !selection.includes(idClique)
      ? [idClique]
      : (selection.length ? selection : (idClique ? [idClique] : []))
    patchComposition((c) => cibles.reduce((etat, id) => agir(etat, id), c))
  }, [selection])

  // ═══ FAMILLE PHOTOSHOP 8 · COPIER, COUPER, COLLER ═══════════════════════════════════════════
  //
  // Bornées aux CALQUES, comme l'alignement (P2) et les groupes (P5) : les pièces Lego déclarent
  // des propriétés propres au thème, un copier-coller générique entre deux familles de composants
  // produirait des pièces à moitié vides plutôt qu'un vrai duplicata.
  //
  // LE PRESSE-PAPIERS EST INTERNE, une simple réf, pas le presse-papiers du SYSTÈME : Photoshop
  // lui-même distingue le presse-papiers applicatif du presse-papiers système, et un calque n'a
  // aucun format d'échange universel à offrir à une autre application.
  const pressePapiersRef = React.useRef([])
  const decalageCollageRef = React.useRef(0)

  const copierSelection = React.useCallback(() => {
    const calques = readLayers(composition).filter((l) => selection.includes(l.id) || l.id === selectedComponent)
    if (!calques.length) return false
    // Clonage par aller-retour JSON : un calque ne porte que des données sérialisables (nombres,
    // chaînes, booléens, objets plats), donc ce tour suffit à en garantir une copie INDÉPENDANTE,
    // que des modifications ultérieures du document ne pourront plus jamais atteindre.
    pressePapiersRef.current = JSON.parse(JSON.stringify(calques))
    decalageCollageRef.current = 0
    return true
  }, [composition, selection, selectedComponent])

  // AUDIT P1-R5 · coller retirait TOUJOURS `groupId`, quelle que soit la page active : la copie
  // devenait un masque global visible sur toutes les diapositives, y compris collée depuis et vers
  // la MÊME diapositive. Aucune référence interne n'était non plus remise à jour, si bien qu'un
  // connecteur ou un chaînage collé continuait de viser les calques ORIGINAUX plutôt que ses
  // propres copies. Portée assumée : colle toujours dans le contexte ACTIF (diapositive, page
  // parente, ou masque si aucun des deux), même convention que `poserCalque` partout ailleurs dans
  // le produit — aucun choix explicite Page/Masque séparé, qu'aucun autre geste de ce produit
  // n'offre non plus.
  const collerSelection = React.useCallback(() => {
    if (!pressePapiersRef.current.length) return
    decalageCollageRef.current += 16
    const decalage = decalageCollageRef.current
    let nouveaux = []
    patchComposition((c) => {
      const parentActif = readParentPages(c).find((p) => p.id === c.activePageParentId)
      const slideActive = readSlides(c).find((s) => s.id === c.activeSlideId)
      const groupIdCible = parentActif?.groupId ?? slideActive?.groupId ?? null
      let etat = c
      nouveaux = []
      // PASSE 1 · poser chaque copie sur la page active, retenir ANCIEN identifiant -> NOUVEAU.
      const correspondance = new Map()
      for (const source of pressePapiersRef.current) {
        // Décomposé plutôt que mis à `undefined` : `makeLayer` étale son patch EN DERNIER, donc
        // un champ à `undefined` y écraserait l'id et le rang tout juste calculés au lieu de les
        // laisser vivre — mieux vaut ne jamais poser la question que la reposer à `undefined`.
        const { id: idSource, serial: _serial, z: _z, groupId: _groupId, ...reste } = source
        etat = addLayer(etat, source.kind, { ...reste, x: source.x + decalage, y: source.y + decalage, groupId: groupIdCible })
        const nouvelId = stackOrder(etat)[0].id
        correspondance.set(idSource, nouvelId)
        nouveaux.push(nouvelId)
      }
      // PASSE 2 · toute référence à un AUTRE calque (connecteur, chaînage de texte, habillage) vise
      // sa PROPRE copie si elle fait aussi partie du collage, sinon s'efface — jamais laissée viser
      // un original resté ailleurs, ce qui aurait pu relier deux pages différentes en silence.
      const CHAMPS_REFERENCE = ['connectFrom', 'connectTo', 'threadNextId', 'threadPrevId', 'wrapAroundId']
      for (const nouvelId of nouveaux) {
        const l = findLayer(etat, nouvelId)
        const patch = {}
        let touche = false
        for (const champ of CHAMPS_REFERENCE) {
          if (!l?.[champ]) continue
          patch[champ] = correspondance.get(l[champ]) || ''
          touche = true
        }
        if (touche) etat = patchLayer(etat, nouvelId, patch)
      }
      return etat
    })
    // Le collage devient la sélection : c'est ce qu'on veut manipuler tout de suite après.
    setSelection(nouveaux); setSelectedComponent(nouveaux[nouveaux.length - 1] || null)
  }, [patchComposition])

  const couperSelection = React.useCallback(() => {
    if (!copierSelection()) return
    // `surLaSelection` SANS deuxième argument ne retire RIEN si `selection` est vide, ce qui est
    // le cas courant : poser un calque ne remplit que `selectedComponent`, jamais le tableau de
    // sélection multiple. `selectedComponent` sert donc de repli explicite, exactement le rôle
    // que `idClique` joue déjà pour chaque bouton « Retirer » en ligne.
    surLaSelection((c, id) => removeLayer(c, id), selectedComponent)
    setSelection([]); setSelectedComponent(null)
  }, [copierSelection, surLaSelection, selectedComponent])

  // AUDIT P3-E3 : ces trois commandes vivaient dupliquées MOT POUR MOT entre le clavier (⌘A / ⌘⇧I /
  // ⌘G) et le menu Édition — identiques aujourd'hui, sans qu'aucune structure ne garantisse qu'elles
  // le restent demain. Extraites ici comme `copierSelection` l'est déjà, pour que les deux surfaces
  // invoquent la MÊME fonction plutôt que deux copies entretenues à la main en parallèle.
  const toutSelectionner = React.useCallback(() => {
    setSelection(ordreHierarchie); setSelectedComponent(ordreHierarchie[ordreHierarchie.length - 1] || null)
  }, [ordreHierarchie])

  const inverserSelection = React.useCallback(() => {
    const inverse = ordreHierarchie.filter((id) => !selection.includes(id))
    setSelection(inverse); setSelectedComponent(inverse[inverse.length - 1] || null)
  }, [ordreHierarchie, selection])

  const grouperSelection = React.useCallback(() => {
    if (selection.filter((id) => findLayer(composition, id)).length < 2) return
    const nom = `Groupe ${readGroups(composition).length + 1}`
    patchComposition((c) => groupLayers(c, selection, nom))
    setSelection([])
  }, [selection, composition, patchComposition])

  // Les calques de la sélection, quand elle en contient plusieurs. `null` si la sélection est
  // vide, ne contient qu'UN élément (le panneau simple suffit alors), ou mêle des calques et des
  // pièces : les pièces déclarent des propriétés propres au thème, hétérogènes d'une famille de
  // composants à l'autre, si bien qu'aucun champ commun ne serait sûr à imposer en groupe. Les
  // calques, eux, partagent TOUJOURS opacité, fusion, effets et typographie : c'est le terrain
  // commun réel, pas une supposition.
  const calquesSelectionnes = React.useMemo(() => {
    if (selection.length < 2) return null
    const calques = selection.map((id) => findLayer(composition, id)).filter(Boolean)
    return calques.length === selection.length ? calques : null
  }, [composition, selection])

  // Le verrou l'emporte TOUJOURS sur l'édition groupée : verrouiller sert justement à figer le
  // panneau pendant qu'on sélectionne autre chose ailleurs, multi-sélection comprise.
  const modeGroupe = !panelLockedId && calquesSelectionnes

  // La valeur d'un champ à travers plusieurs calques, et si elle diverge. C'est la même question
  // que pose le Details Panel d'Unreal sur une sélection hétérogène : « Multiple Values ».
  const valeurGroupee = React.useCallback((lire) => {
    if (!calquesSelectionnes?.length) return { valeur: '', mixte: false }
    const valeurs = calquesSelectionnes.map(lire)
    const mixte = valeurs.some((v) => v !== valeurs[0])
    return { valeur: mixte ? '' : valeurs[0], mixte }
  }, [calquesSelectionnes])

  const calqueSelectionne = React.useMemo(
    () => findLayer(composition, idPourPanneau),
    [composition, idPourPanneau])

  // FAMILLE INDESIGN D1 · l'objet hérité sélectionné, résolu (page parente + remplacements locaux)
  // pour LA diapositive active — jamais un vrai calque, une simple vue calculée à afficher.
  const objetHerite = React.useMemo(
    () => (selectedInheritedLayerId && composition.activeSlideId
      ? effectiveSlideLayers(composition, composition.activeSlideId).find((l) => l.id === selectedInheritedLayerId) || null
      : null),
    [composition, selectedInheritedLayerId])

  const noeudSelectionne = React.useMemo(
    () => (selectedNode ? findNode(arbreNoeuds, idPourPanneau, selectedNode) : null),
    [arbreNoeuds, idPourPanneau, selectedNode])

  // LES RÉGLAGES D'UN SOUS-COMPOSANT VIVENT DANS `props.__nodes`, indexés par chemin. Ils voyagent
  // donc avec la pièce, se sérialisent dans le document, et ne demandent AUCUNE ouverture du
  // contrat de `composition.js` : `props` est déjà un objet libre depuis la carte C1.
  // LES TEXTES DE CE QUI EST SÉLECTIONNÉ, du nœud choisi ou de la pièce entière à défaut. C'est ce
  // qui s'affiche EN PREMIER à droite, avant la géométrie et avant l'apparence, parce que c'est ce
  // qu'on vient changer neuf fois sur dix.
  const textesDeLaSelection = React.useMemo(() => {
    if (!idPourPanneau) return []
    const racine = selectedNode ? findNode(arbreNoeuds, idPourPanneau, selectedNode) : null
    return collectTexts(racine ? [racine] : (arbreNoeuds[idPourPanneau] || []))
  }, [arbreNoeuds, idPourPanneau, selectedNode])

  // FAMILLE FIGMA 8 · UN CALQUE COMPOSANT EST UNE INSTANCE, AU SENS DE FIGMA : la même pièce HTML
  // partagée du thème, réglée LOCALEMENT sans jamais toucher le thème d'origine. Ce mécanisme de
  // réglage par chemin (`props.__nodes`) existait déjà pour les pièces Lego classiques ; il ne
  // s'appliquait JAMAIS à un calque, qui n'a jamais qu'un identifiant introuvable dans
  // `rows[].items[]`. Bogue réel, pas hypothétique : le panneau Détails affiche déjà un champ
  // « Texte » dès qu'on clique un sous-composant d'un calque composant dans l'aperçu (le pont de
  // sélection est générique, voir `PONT_SELECTION`), mais y taper n'écrivait NULLE PART.
  const trouverPieceOuCalque = React.useCallback((current, id) => {
    const piece = (current.rows || []).flatMap((r) => r.items || []).find((it) => it.id === id)
    if (piece) return { props: piece.props, ecrire: (props) => patchItem(current, id, { props }) }
    const calque = findLayer(current, id)
    if (calque) return { props: calque.props, ecrire: (props) => patchLayer(current, id, { props }) }
    return null
  }, [])

  const reglerChemin = React.useCallback((chemin, patch) => {
    // Écrit sur ce que le PANNEAU affiche, `idPourPanneau`, et non sur la sélection courante : un
    // panneau verrouillé doit continuer de régler l'objet gelé même si la hiérarchie a bougé.
    const cible = idPourPanneau
    if (!cible || !chemin) return
    patchComposition((current) => {
      const trouve = trouverPieceOuCalque(current, cible)
      if (!trouve) return current
      const nodes = { ...(trouve.props?.__nodes || {}) }
      const avant = nodes[chemin] || {}
      nodes[chemin] = {
        ...avant,
        ...patch,
        // Le style se fusionne champ par champ : régler la couleur ne doit pas effacer le corps.
        style: patch.style ? { ...(avant.style || {}), ...patch.style } : avant.style,
      }
      return trouve.ecrire({ ...(trouve.props || {}), __nodes: nodes })
    })
  }, [idPourPanneau, trouverPieceOuCalque])

  const reglerNoeud = React.useCallback((patch) => reglerChemin(selectedNode, patch), [reglerChemin, selectedNode])

  const reglagePour = React.useCallback((chemin) => {
    const trouve = trouverPieceOuCalque(composition, idPourPanneau)
    return trouve?.props?.__nodes?.[chemin] || {}
  }, [composition, idPourPanneau, trouverPieceOuCalque])

  const reglageCourant = React.useMemo(() => {
    const trouve = trouverPieceOuCalque(composition, idPourPanneau)
    return trouve?.props?.__nodes?.[selectedNode] || {}
  }, [composition, idPourPanneau, selectedNode, trouverPieceOuCalque])

  const champsDeclares = React.useMemo(() => {
    if (!pieceSelectionnee?.componentId) return []
    const entree = (componentBundle?.components || []).find((c) => c.id === pieceSelectionnee.componentId)
    return Array.isArray(entree?.props) ? entree.props : []
  }, [componentBundle, pieceSelectionnee])

  // LE CLIC DANS L'APERCU DESIGNE, LE PARENT DECIDE. Le document ne remonte qu'un identifiant.
  React.useEffect(() => {
    const onMessage = (e) => {
      if (e.data?.zrm !== 'select') return
      // Cliquer dans l'aperçu sélectionne la PIÈCE et le SOUS-COMPOSANT exact sous le curseur.
      // C'est le geste de Photoshop et celui d'Unreal : on désigne à l'écran, on règle à droite.
      setSelectedComponent(e.data.id || null)
      setSelectedNode(e.data.path || null)
      setDeckTab('details')
    }
    window.addEventListener('message', onMessage)
    return () => window.removeEventListener('message', onMessage)
  }, [])

  // LA SELECTION DESCEND PAR MESSAGE, JAMAIS PAR RECOMPILATION. La faire passer par le HTML
  // rechargerait l'iframe a chaque clic, donc reinitialiserait le defilement de l'apercu, et le
  // debounce de 220 ms ajouterait un retard visible sur un geste qui doit etre instantane.
  React.useEffect(() => {
    frameRef.current?.contentWindow?.postMessage({ zrm: 'selected', id: selectedComponent }, '*')
  }, [selectedComponent, debouncedHtml])

  // Toute modification de l'entrée repart d'une échelle neuve : sinon un texte raccourci
  // resterait rétréci pour toujours, et l'ajustement ne saurait plus remonter.
  React.useEffect(() => { setContentScale(null) }, [formatId, themeId, renderDark, cut, project?.brief?.title, project?.brief?.message])

  // --- Le Critique ------------------------------------------------------------------------------
  const staticIssues = React.useMemo(() => {
    if (!project || !cut || !theme) return []
    return inspectStatic({ brief: project.brief, cut, theme, format, dark: renderDark, composed: compiled?.meta?.source === 'composition' })
  }, [project, cut, theme, format, renderDark])

  // L'ARBRE DE DÉCLINAISONS : toutes les sorties d'un coup, avec leur état réel. C'est la
  // thèse du produit rendue visible — jusqu'ici il fallait cliquer une pastille pour découvrir
  // qu'un texte ne tenait pas en 1:1.
  const tree = React.useMemo(() => {
    if (!project || !cut || !theme) return []
    return declensionTree({ brief: project.brief, cut, theme, dark: renderDark })
  }, [project, cut, theme, renderDark])
  const treeSummary = React.useMemo(() => declensionSummary(tree), [tree])

  const issues = React.useMemo(() => [...staticIssues, ...renderedIssues], [staticIssues, renderedIssues])
  const verdict = React.useMemo(() => summarize(issues), [issues])

  const onFrameLoad = React.useCallback(() => {
    const doc = frameRef.current?.contentDocument
    if (!doc) return
    // Mesure APRÈS pose des polices : mesurer avant donne des hauteurs fausses et le Critique
    // signalerait des débordements qui n'existent pas.
    const run = () => {
      let found = []
      try { found = inspectRendered(doc, format) } catch { found = [] }
      setRenderedIssues(found)

      // AJUSTEMENT MESURÉ (correctif 2026-07-25, « énormément de bugs sur tous les formats »).
      // Tant que la page déborde RÉELLEMENT, on descend d'un cran et on recompile. On mesure,
      // on ne devine pas : c'est exactement ce qui manquait. Borné par le dernier palier de
      // l'échelle, donc au pire 6 rendus, jamais une boucle infinie.
      const overflows = found.some((i) => i.code === 'overflow.vertical' || i.code === 'overflow.horizontal' || i.code === 'safe.top' || i.code === 'safe.bottom')
      if (overflows && format.canvas.h > 0) {
        setContentScale((current) => {
          const base = Number.isFinite(current) ? current : (compiled?.meta?.scale ?? 1)
          if (base <= MIN_SHRINK + 1e-6) return current // plancher atteint : on laisse le Critique parler
          return nextShrink(base)
        })
      }

      // FAMILLE INDESIGN D3 · LE TEXTE EN EXCÈS, calque par calque. Chaque bloc texte porte déjà
      // `overflow:hidden` (carte L1) : son `scrollHeight` reste celui du texte ENTIER même rogné à
      // l'écran, donc le comparer à `clientHeight` dit, réellement, s'il déborde — un point rouge
      // n'est jamais affiché sans qu'un débordement mesuré l'ait produit.
      const debordent = new Set()
      for (const noeud of doc.querySelectorAll('[data-zrm-layer]')) {
        if (noeud.scrollHeight - noeud.clientHeight > 1) debordent.add(noeud.getAttribute('data-zrm-layer'))
      }
      setOverflowingLayerIds((actuel) => {
        if (actuel.size === debordent.size && [...actuel].every((id) => debordent.has(id))) return actuel
        return debordent
      })

      // FAMILLE INDESIGN D8 · CONTRÔLE EN AMONT DES IMAGES. Un lien rompu se mesure sur le `<img>`
      // RÉELLEMENT chargé (`naturalWidth` à 0, jamais deviné depuis l'adresse) ; une résolution
      // basse compare ce que l'image porte VRAIMENT à ce que la densité d'export exigerait pour
      // cette taille affichée — en dessous, l'export montrerait une image floue, agrandie. (La
      // source manquante, elle, est une donnée PURE : calculée directement au rendu, plus bas,
      // jamais ici — elle n'a besoin d'aucune mesure du `<img>` réellement chargé.)
      const images = []
      for (const img of doc.querySelectorAll('[data-zrm-layer] img')) {
        const id = img.closest('[data-zrm-layer]')?.getAttribute('data-zrm-layer')
        if (!id) continue
        if (img.naturalWidth === 0) { images.push({ id, kind: 'lien-rompu' }); continue }
        const calque = readLayers(composition).find((l) => l.id === id)
        if (!calque) continue
        const requis = calque.w * (compiled?.meta?.scale || 1) * 0.9
        if (img.naturalWidth < requis) images.push({ id, kind: 'basse-resolution' })
      }
      setImageIssues(images)
    }
    if (doc.fonts?.ready) doc.fonts.ready.then(run).catch(run)
    else run()
  }, [format, compiled])

  // FAMILLE INDESIGN D8 · LA LISTE COMPLÈTE DES POINTS DE CONTRÔLE, une seule fois, réutilisée par
  // l'indicateur de la barre d'outils ET par le panneau détaillé — jamais recalculée deux fois avec
  // un risque de diverger. La source manquante est PURE (aucune mesure du DOM), donc à jour
  // IMMÉDIATEMENT à chaque frappe, contrairement au texte en excès et aux images qui attendent le
  // prochain rendu de l'aperçu (`onFrameLoad`).
  const preflightPoints = React.useMemo(() => ([
    ...[...overflowingLayerIds].map((id) => ({ id, kind: 'texte-en-exces' })),
    ...imageIssues,
    ...layersMissingImageSource(composition).map((id) => ({ id, kind: 'source-manquante' })),
  ]), [overflowingLayerIds, imageIssues, composition])

  const { scale: autoScale, availH } = useFitScale(stageRef, format.canvas.w, format.canvas.h)

  // ═══ LE PLAN DE TRAVAIL SE DÉPLACE ET SE ZOOME, COMME DANS PHOTOSHOP ═══════════════════════════
  //
  // Matthieu demande d'y reprendre « tout le code de ZenRay ref ». Je ne l'ai PAS fait, et je le
  // dis plutôt que de le laisser croire : ZenRayRef repose sur tldraw, une bibliothèque de canevas
  // à FORMES, qui apporte son propre modèle, son propre rendu et son propre système de sélection.
  // La greffer ici ferait cohabiter deux modèles de document dans une même vue, alors que le seul
  // emprunt réellement demandé, « pouvoir déplacer les trucs », tient en trente lignes. Le reste de
  // ZenRayRef, la sélection et le redimensionnement, existe déjà ici depuis la carte L6.
  //
  // Les gestes retenus sont ceux que tout le monde connaît sans les apprendre : molette pour
  // parcourir, molette avec ⌘ ou Ctrl pour zoomer, glisser avec la barre d'espace ou le bouton du
  // milieu pour déplacer. Un double-clic sur le vide replace la vue.
  const espaceRef = React.useRef(false)
  const [zoom, setZoom] = React.useState(1)
  const [pan, setPan] = React.useState({ x: 0, y: 0 })
  const panRef = React.useRef(null)
  const fitScale = autoScale * zoom

  const onStageWheel = (event) => {
    // La molette au-dessus du plan de travail lui appartient ENTIÈREMENT : sans ce refus, la page
    // qui contient l'éditeur défilerait derrière, et l'aperçu partirait hors de l'écran pendant
    // qu'on croit le déplacer. Les autres panneaux ne sont pas concernés, ils défilent chacun chez
    // eux, ce que `overscroll-behavior: contain` empêche de propager plus haut.
    event.preventDefault()
    if (event.ctrlKey || event.metaKey) {
      setZoom((z) => Math.min(8, Math.max(0.1, z * (event.deltaY < 0 ? 1.12 : 1 / 1.12))))
    } else {
      setPan((p) => ({ x: p.x - (event.shiftKey ? event.deltaY : event.deltaX), y: p.y - (event.shiftKey ? 0 : event.deltaY) }))
    }
  }

  const canvasRef = React.useRef(null)
  // ═══ FAMILLE PHOTOSHOP 1 · LA SÉLECTION RECTANGULAIRE (carte P1) ═══════════════════════════════
  // Chez Photoshop, le rectangle de sélection isole une région de PIXELS. ZenRayMedia n'a pas de
  // pixels à isoler, il a des calques : le même geste, glisser sur le vide, y devient une sélection
  // de calques — c'est très exactement le second sens que la documentation Adobe donne déjà au mot
  // « sélection ». `marqueeRef` porte le point de départ EN PIXELS DU CANEVAS, mesuré une seule
  // fois au clic, jamais recalculé pendant le glisser (même discipline que `panRef`).
  const marqueeRef = React.useRef(null)
  const [marqueeBox, setMarqueeBox] = React.useState(null)

  // ═══ FAMILLE FIGMA 5 · ÉDITER LE TEXTE À L'ENDROIT MÊME OÙ IL S'AFFICHE ═════════════════════
  // Le panneau Détails permettait déjà de changer le contenu d'un calque texte, mais Figma comme
  // Photoshop ouvrent l'édition PAR UN DOUBLE-CLIC SUR LE CALQUE LUI-MÊME : c'est le geste que la
  // doc nomme, pas un raccourci de confort. `editionTexteId` porte l'identifiant du calque en
  // cours d'édition, `null` sinon — un seul calque édité à la fois, jamais deux superposés.
  const [editionTexteId, setEditionTexteId] = React.useState(null)

  // ═══ FAMILLE ILLUSTRATOR I2 · L'OUTIL PLUME ═══════════════════════════════════════════════════
  // Un clic pose un point d'ANGLE ; un clic-GLISSÉ pose un point LISSE, la distance et la
  // direction du glisser devenant la poignée de sortie (et son miroir, la poignée d'entrée) — le
  // même geste que la vraie Plume d'Illustrator. `tracePlumeRef` accumule les points en
  // coordonnées ABSOLUES DU CANEVAS pendant tout le dessin ; ils ne deviennent des pourcentages
  // relatifs à la boîte du calque qu'à la toute fin (`createPathLayer`), jamais avant.
  const [outilPlumeActif, setOutilPlumeActif] = React.useState(false)
  const tracePlumeRef = React.useRef([])
  const [traceApercu, setTraceApercu] = React.useState(null)
  const plumeGesteRef = React.useRef(null)   // point en cours de pose : { sx, sy } au clic, avant le relâché

  const SEUIL_FERMETURE_TRACE = 10   // pixels du canevas : cliquer si près du premier point ferme le tracé

  const terminerTrace = React.useCallback((closed) => {
    const points = tracePlumeRef.current
    if (points.length >= 2) {
      // Le tracé qu'on vient de poser devient la sélection, comme tout autre calque neuf
      // (`poserCalque`) : sans quoi ses points d'ancrage, qui n'apparaissent QUE sur un calque
      // sélectionné, resteraient invisibles juste après l'avoir dessiné.
      const suivant = createPathLayer(composition, points, closed)
      const pose = stackOrder(suivant)[0]
      patchComposition(() => suivant)
      setSelectedComponent(pose?.id || null)
      setDeckTab('details')
      setActionCount((n) => n + 1)
    }
    tracePlumeRef.current = []
    setTraceApercu(null)
  }, [composition, patchComposition])

  // ═══ FAMILLE ILLUSTRATOR I2 (suite) · ÉDITER UN TRACÉ DÉJÀ POSÉ ═════════════════════════════════
  // Un tracé sélectionné expose directement ses points, sans second outil séparé — la Sélection
  // directe d'Illustrator, mais dans ce produit c'est simplement CE QUE MONTRE la sélection d'un
  // calque tracé, comme les poignées de coin le sont déjà pour tout calque. `pointSelectionne` ne
  // survit jamais à un changement de calque sélectionné : l'index n'a plus de sens sur un autre tracé.
  const [pointSelectionne, setPointSelectionne] = React.useState(null)
  const pointGesteRef = React.useRef(null)
  React.useEffect(() => { setPointSelectionne(null) }, [selectedComponent])
  // FAMILLE INDESIGN D1 · sélectionner un calque RÉEL désélectionne l'objet hérité, et changer de
  // diapositive aussi (un objet hérité d'une autre diapositive n'a plus aucun sens ici).
  React.useEffect(() => { setSelectedInheritedLayerId(null) }, [selectedComponent, composition.activeSlideId])

  // ═══ FAMILLE INDESIGN D2 · LE RÉCUPÉRATEUR DE CONTENU ═══════════════════════════════════════════
  // Un troisième point d'entrée sur une image, EN PLUS du bloc et de son contenu : un contrôle
  // circulaire fixe AU CENTRE du cadre (jamais au point focal actuel, qui peut être ailleurs) —
  // le glisser déplace directement le point focal, sans passer par les curseurs du panneau
  // Détails ni changer d'outil. Réutilise `focalX`/`focalY`, déjà là depuis la carte Photoshop 6 :
  // aucun champ neuf, seulement un second geste pour les écrire.
  const grabberGesteRef = React.useRef(null)
  const onGrabberDown = (event, layer) => {
    if (isEffectivelyLocked(composition, layer)) return
    event.preventDefault()
    event.stopPropagation()
    event.currentTarget.setPointerCapture?.(event.pointerId)
    commencerGeste()
    grabberGesteRef.current = { id: layer.id, sx: event.clientX, sy: event.clientY, w: layer.w, h: layer.h, focalX: layer.focalX, focalY: layer.focalY }
  }

  // ═══ FAMILLE INDESIGN D6 · REPÈRES PERSISTANTS ══════════════════════════════════════════════════
  // Un repère se glisse comme le récupérateur de contenu ci-dessus (delta depuis un instantané pris
  // au clic), mais c'est un geste de CANEVAS, jamais de calque : câblé sur `onStagePan`/`onStageUp`,
  // pas sur `onPoigneeMove`/`onPoigneeUp`, exactement comme le point en cours de l'outil Plume.
  const guideGesteRef = React.useRef(null)
  const onGuideDown = (event, guide) => {
    event.preventDefault()
    event.stopPropagation()
    commencerGeste()
    guideGesteRef.current = { id: guide.id, axis: guide.axis, sx: event.clientX, sy: event.clientY, depart: guide.position }
  }

  // ═══ FAMILLE INDESIGN D3 · CHAÎNAGE DE BLOCS DE TEXTE ═══════════════════════════════════════════
  // Cliquer le point de SORTIE charge le curseur (« curseur de texte chargé ») ; cliquer un AUTRE
  // bloc texte complète la chaîne ; Échap ou un clic sur le vide annule sans rien poser — le même
  // geste que charger le texte dans Illustrator/InDesign, jamais un second outil séparé à activer.
  const [chainageDepuisId, setChainageDepuisId] = React.useState(null)
  const [afficherLiaisons, setAfficherLiaisons] = React.useState(false)
  const onPortSortieDown = (event, layer) => {
    event.preventDefault()
    event.stopPropagation()
    setChainageDepuisId(layer.id)
  }
  const onCalqueTexteClicPourChainer = (event, layer) => {
    if (!chainageDepuisId || layer.kind !== 'text') return false
    event.stopPropagation()
    patchComposition((c) => threadTextLayers(c, chainageDepuisId, layer.id))
    setChainageDepuisId(null)
    setActionCount((n) => n + 1)
    return true
  }
  // FAMILLE INDESIGN D1 · changer de diapositive ACTIVE ou entrer/quitter l'édition d'une page
  // parente efface la sélection de calque en cours : un calque sélectionné dans un contexte
  // (une autre diapositive, une autre page parente) n'a plus de sens visible dans le nouveau, et le
  // laisser sélectionné y afficherait à tort son panneau au lieu du panneau du contexte courant.
  React.useEffect(() => { setSelectedComponent(null); setSelection([]); setSelectedNode(null) }, [composition.activeSlideId, composition.activePageParentId])
  // FAMILLE INDESIGN D4 · sélectionner un calque RÉEL ferme l'édition d'un style de texte en cours
  // (les deux panneaux Détails sont exclusifs, jamais superposés).
  React.useEffect(() => { if (selectedComponent) { setSelectedTextStyleId(null); setSelectedObjectStyleId(null); setPreflightOuvert(false) } }, [selectedComponent])

  const estUnTrace = (l) => !!l && Array.isArray(l.pathPoints) && l.pathPoints.length >= 2

  // Le style d'un DIV réduit à un trait fin d'une poignée à l'autre — un rectangle de hauteur nulle,
  // pivoté, plutôt qu'un second <svg> pour un simple segment.
  const ligneEntrePoints = (ax, ay, bx, by) => {
    const longueur = Math.hypot(bx - ax, by - ay)
    const angle = (Math.atan2(by - ay, bx - ax) * 180) / Math.PI
    return { left: ax, top: ay, width: longueur, transform: `rotate(${angle}deg)` }
  }

  const onPointAncreDown = (event, layer, index) => {
    if (isEffectivelyLocked(composition, layer)) return
    event.preventDefault()
    event.stopPropagation()
    event.currentTarget.setPointerCapture?.(event.pointerId)
    commencerGeste()
    setSelectedComponent(layer.id)
    setPointSelectionne(index)
    pointGesteRef.current = { layerId: layer.id, index, partie: 'ancre', sx: event.clientX, sy: event.clientY, w: layer.w, h: layer.h, point: layer.pathPoints[index] }
  }
  const onPointPoigneeDown = (event, layer, index, partie) => {
    if (isEffectivelyLocked(composition, layer)) return
    event.preventDefault()
    event.stopPropagation()
    event.currentTarget.setPointerCapture?.(event.pointerId)
    commencerGeste()
    pointGesteRef.current = { layerId: layer.id, index, partie, sx: event.clientX, sy: event.clientY, w: layer.w, h: layer.h, point: layer.pathPoints[index] }
  }
  // Double-clic sur une ANCRE : convertit angle ↔ lisse. Double-clic sur le TRACÉ lui-même (pas une
  // ancre) : insère un point exactement sur la courbe, à l'endroit le plus proche du clic.
  const onPointAncreDouble = (event, layer, index) => {
    event.stopPropagation()
    patchComposition((c) => patchLayer(c, layer.id, { pathPoints: toggleAnchorSmoothness(layer.pathPoints, index, layer.pathClosed) }))
    setActionCount((n) => n + 1)
  }
  const onTraceDouble = (event, layer) => {
    if (!canvasRef.current) return
    event.stopPropagation()
    const rect = canvasRef.current.getBoundingClientRect()
    const echelle = fitScale || 1
    const xPct = (((event.clientX - rect.left) / echelle - layer.x) / layer.w) * 100
    const yPct = (((event.clientY - rect.top) / echelle - layer.y) / layer.h) * 100
    const trouve = nearestPointOnTrace(layer.pathPoints, layer.pathClosed, xPct, yPct)
    if (!trouve) return
    patchComposition((c) => patchLayer(c, layer.id, { pathPoints: insertPathPoint(layer.pathPoints, trouve.afterIndex, trouve.x, trouve.y) }))
    setActionCount((n) => n + 1)
  }

  const onStageDown = (event) => {
    // Bouton du milieu, ou barre d'espace enfoncée : c'est la main de Photoshop, elle DÉPLACE le
    // plan de travail. Un clic gauche SEUL, lui, ouvre désormais une sélection rectangulaire — le
    // clic gauche n'était détourné vers RIEN jusqu'ici, précisément pour ne pas gêner la
    // manipulation des calques, laquelle reste intacte : une boîte de calque arrête déjà la
    // propagation de son propre clic, donc cette poignée ne voit jamais que le VIDE du canevas.
    if (event.button === 1 || espaceRef.current) {
      event.preventDefault()
      panRef.current = { sx: event.clientX, sy: event.clientY, px: pan.x, py: pan.y }
      return
    }
    // jsdom perd la propriete `button` sur un PointerEvent synthetise (limite deja rencontree
    // sur clientX en carte S3) : `undefined` est traite comme le bouton primaire, exactement le
    // comportement reel d'un navigateur ou `button` est TOUJOURS defini, jamais un affaiblissement.
    if ((event.button !== 0 && event.button !== undefined) || !canvasRef.current) return
    const rect = canvasRef.current.getBoundingClientRect()
    const echelle = fitScale || 1
    const point = { x: (event.clientX - rect.left) / echelle, y: (event.clientY - rect.top) / echelle }
    // FAMILLE ILLUSTRATOR I2 · en mode Plume, un clic pose un point au lieu d'ouvrir une sélection
    // rectangulaire — les deux gestes ne peuvent pas partager le même clic, la Plume prend la main
    // en premier. Cliquer PRÈS DU PREMIER POINT (au moins deux déjà posés) FERME le tracé plutôt
    // que d'en ajouter un troisième, exactement le geste qui termine un tracé dans Illustrator.
    if (outilPlumeActif) {
      event.preventDefault()
      const existants = tracePlumeRef.current
      if (existants.length >= 2) {
        const premier = existants[0]
        if (Math.hypot(point.x - premier.x, point.y - premier.y) <= SEUIL_FERMETURE_TRACE / echelle) { terminerTrace(true); return }
      }
      plumeGesteRef.current = { sx: point.x, sy: point.y }
      return
    }
    // FAMILLE INDESIGN D3 · un curseur de texte chargé, clic sur le VIDE : annule sans rien chaîner,
    // exactement comme changer d'outil annule le chargement dans InDesign.
    if (chainageDepuisId) { setChainageDepuisId(null); return }
    marqueeRef.current = { rectLeft: rect.left, rectTop: rect.top, x1: point.x, y1: point.y }
    setMarqueeBox({ x1: point.x, y1: point.y, x2: point.x, y2: point.y })
    // Un clic SANS modificateur sur le vide désélectionne tout, comme dans Photoshop et Figma. Un
    // clic AVEC Maj ou ⌘/Ctrl commence un glisser qui AJOUTE à la sélection déjà posée, sans
    // effacer ce qui l'était.
    if (!event.shiftKey && !event.metaKey && !event.ctrlKey) { setSelection([]); setSelectedComponent(null); setSelectedNode(null) }
  }
  const onStagePan = (event) => {
    // FAMILLE INDESIGN D6 · le delta part d'un instantané pris au clic (même discipline que le
    // récupérateur de contenu D2), jamais d'un recalcul cumulatif au fil du glisser.
    if (guideGesteRef.current) {
      const geste = guideGesteRef.current
      const echelle = fitScale || 1
      const delta = geste.axis === 'x' ? (event.clientX - geste.sx) / echelle : (event.clientY - geste.sy) / echelle
      patchComposicionEnDirect((c) => moveGuide(c, geste.id, geste.depart + delta))
      return
    }
    if (panRef.current) {
      setPan({ x: panRef.current.px + (event.clientX - panRef.current.sx), y: panRef.current.py + (event.clientY - panRef.current.sy) })
      return
    }
    // FAMILLE ILLUSTRATOR I2 · tant que le point en cours n'est pas relâché, le glissement en
    // cours sculpte sa poignée de sortie (et le miroir, en entrée) — l'aperçu montre ce point EN
    // PLUS des points déjà validés, sans jamais toucher `tracePlumeRef` avant le relâché.
    if (outilPlumeActif && plumeGesteRef.current && canvasRef.current) {
      const rect = canvasRef.current.getBoundingClientRect()
      const echelle = fitScale || 1
      const point = { x: (event.clientX - rect.left) / echelle, y: (event.clientY - rect.top) / echelle }
      const depart = plumeGesteRef.current
      const dx = point.x - depart.sx, dy = point.y - depart.sy
      // Le delta rejoint LA RÉFÉRENCE DU GESTE, pas seulement l'aperçu qui n'est que visuel : sans
      // ça, `onStageUp` n'aurait aucun moyen fiable de savoir si CE point a réellement glissé, une
      // fois l'aperçu retombé au dernier point déjà validé plutôt qu'au point en cours.
      plumeGesteRef.current = { ...depart, dx, dy }
      const apercu = { x: depart.sx, y: depart.sy, inX: depart.sx - dx, inY: depart.sy - dy, outX: depart.sx + dx, outY: depart.sy + dy }
      setTraceApercu([...tracePlumeRef.current, apercu])
      return
    }
    const marquee = marqueeRef.current
    if (!marquee) return
    const echelle = fitScale || 1
    const point = { x: (event.clientX - marquee.rectLeft) / echelle, y: (event.clientY - marquee.rectTop) / echelle }
    const boite = { x1: marquee.x1, y1: marquee.y1, x2: point.x, y2: point.y }
    setMarqueeBox(boite)
    // AUDIT P1-R4 : un calque d'une autre diapositive ou masqué par son groupe n'a aucune boîte à
    // l'écran, il ne doit donc jamais entrer dans le marquee — même ensemble que `compile.js` peint.
    const ids = layersInRect(readVisibleLayers(composition), boite)
    setSelection(ids)
    // L'objet ACTIF, celui que le panneau de droite affiche, est le plus au premier plan des
    // calques touchés — exactement celui qu'on verrait en premier en regardant l'écran.
    const actif = stackOrder(composition).find((l) => ids.includes(l.id))
    setSelectedComponent(actif ? actif.id : null)
  }
  const onStageUp = () => {
    if (guideGesteRef.current) { guideGesteRef.current = null; setActionCount((n) => n + 1); commiterGeste(); return }
    panRef.current = null
    // FAMILLE ILLUSTRATOR I2 · le relâché valide le point : un glissement significatif produit un
    // point LISSE (poignées en miroir, mesurées depuis l'aperçu déjà calculé par le glissement),
    // un simple clic sans glissement produit un point d'ANGLE (poignées confondues avec l'ancre).
    if (outilPlumeActif && plumeGesteRef.current) {
      const depart = plumeGesteRef.current
      // Le delta vient DU GESTE LUI-MÊME (écrit par `onStagePan` s'il y a eu glissement), jamais de
      // l'aperçu affiché : celui-ci retombe au dernier point déjà validé dès qu'aucun glissement ne
      // s'est produit pour CE point, ce qui ferait alors lire la distance au point PRÉCÉDENT.
      const dx = depart.dx || 0, dy = depart.dy || 0
      const point = Math.hypot(dx, dy) > 2
        ? { x: depart.sx, y: depart.sy, inX: depart.sx - dx, inY: depart.sy - dy, outX: depart.sx + dx, outY: depart.sy + dy }
        : { x: depart.sx, y: depart.sy, inX: depart.sx, inY: depart.sy, outX: depart.sx, outY: depart.sy }
      tracePlumeRef.current = [...tracePlumeRef.current, point]
      setTraceApercu(tracePlumeRef.current)
      plumeGesteRef.current = null
      return
    }
    marqueeRef.current = null; setMarqueeBox(null)
  }
  const replacerLaVue = () => { setZoom(1); setPan({ x: 0, y: 0 }) }

  // Un format article n'a PAS de hauteur : sa page coule. L'iframe prend donc toute la hauteur
  // disponible (divisée par l'échelle, pour que le résultat mis à l'échelle la remplisse
  // exactement) et défile à l'intérieur. Une hauteur fixe tronquait tout article un peu long.
  const stageHeight = format.canvas.h || Math.round(availH / Math.max(fitScale, 0.08))

  // --- Actions du Cut ----------------------------------------------------------------------------
  const withCut = (fn) => { if (cut) { patchProject({ cut: fn(cut) }); setActionCount((n) => n + 1) } }

  // Pose un calque neuf et le rattache à la diapositive active s'il y en a une (famille
  // PowerPoint 1) — sinon il deviendrait un masque visible sur toutes les diapositives, jamais ce
  // qu'on veut en travaillant sur une diapositive précise. Partagé par le bouton générique
  // « Poser un calque X » et par les préréglages comme le Post-it (famille Miro 5).
  const poserCalque = React.useCallback((kind, patch) => {
    let suivant = addLayer(composition, kind, patch)
    const pose = stackOrder(suivant)[0]
    // FAMILLE INDESIGN D1 · éditer une page parente est un contexte à part (`activePageParentId`),
    // prioritaire sur la diapositive active : les deux sont mutuellement exclusifs, donc jamais
    // ambigus quant à savoir où ranger le calque qu'on vient de poser.
    const parentActif = readParentPages(suivant).find((p) => p.id === suivant.activePageParentId)
    const slideActive = readSlides(suivant).find((s) => s.id === suivant.activeSlideId)
    if (parentActif && pose) suivant = patchLayer(suivant, pose.id, { groupId: parentActif.groupId })
    else if (slideActive && pose) suivant = patchLayer(suivant, pose.id, { groupId: slideActive.groupId })
    patchComposition(() => suivant)
    setSelectedComponent(pose?.id || null)
    setDeckTab('details')
    setActionCount((n) => n + 1)
  }, [composition, patchComposition])


  // FAMILLE INDESIGN D1 · sélectionner, remplacer localement, détacher ou rétablir un objet hérité
  // de la page parente — trois gestes distincts, jamais confondus : remplacer garde le lien
  // (seuls les attributs touchés cessent de suivre), détacher le rompt entièrement et sans retour,
  // rétablir efface un remplacement pour revenir à ce que porte la page parente.
  const onInheriteDown = React.useCallback((event, virtualLayer) => {
    event.stopPropagation()
    setSelectedComponent(null)
    setSelectedInheritedLayerId(virtualLayer.id)
    setDeckTab('details')
  }, [])
  const patchObjetHerite = React.useCallback((patch) => {
    if (!objetHerite || !composition.activeSlideId) return
    patchComposition((c) => overrideParentLayer(c, composition.activeSlideId, objetHerite.id, patch))
    setActionCount((n) => n + 1)
  }, [objetHerite, composition.activeSlideId, patchComposition])
  const detacherObjetHerite = React.useCallback(() => {
    if (!objetHerite || !composition.activeSlideId) return
    const idsAvant = new Set(readLayers(composition).map((l) => l.id))
    const suivant = detachParentLayer(composition, composition.activeSlideId, objetHerite.id)
    const nouveau = readLayers(suivant).find((l) => !idsAvant.has(l.id))
    patchComposition(() => suivant)
    setSelectedInheritedLayerId(null)
    setSelectedComponent(nouveau?.id || null)
    setActionCount((n) => n + 1)
  }, [objetHerite, composition, patchComposition])
  const retablirObjetHerite = React.useCallback(() => {
    if (!objetHerite || !composition.activeSlideId) return
    patchComposition((c) => restoreParentLayer(c, composition.activeSlideId, objetHerite.id))
    setActionCount((n) => n + 1)
  }, [objetHerite, composition.activeSlideId, patchComposition])

  // --- Exports ------------------------------------------------------------------------------------
  const record = React.useCallback((entry) => {
    const next = appendLog({ ...entry, at: new Date().toISOString() })
    setLog(next)
  }, [])

  const runExport = React.useCallback(async (kind) => {
    if (!compiled?.html || !project) return
    // ZM-L11-09 : un défaut bloquant bloque TOUT livrable, sans exception. Une version
    // antérieure exemptait l'export HTML -- c'est-à-dire précisément le livrable principal :
    // la règle était inversée et le Critique ne protégeait rien.
    if (!verdict.canPublish) {
      notify(`${verdict.blocking.length} défaut(s) bloquant(s) : le Critique refuse le livrable. Onglet Critique.`, 'error')
      return
    }
    setBusy(kind)
    try {
      const base = safeFileName(project.brief.title, '')
      if (kind === 'html') {
        const res = await exportHtml(compiled.html, `${base}html`)
        record({ kind: 'html', theme: theme.name, format: format.label, bytes: res.bytes, checksum: checksumOf(compiled.html), title: project.brief.title })
        notify(`Page HTML exportée (${formatBytes(res.bytes)}), polices incluses.`, 'ok')
      } else if (kind === 'png') {
        const res = await exportPng(compiled.html, format, `${base}png`)
        record({ kind: 'png', theme: theme.name, format: format.label, bytes: res.bytes, checksum: checksumOf(compiled.html), title: project.brief.title })
        notify(`Image ${res.width}×${res.height} exportée (${formatBytes(res.bytes)}).`, 'ok')
      } else if (kind === 'pdf') {
        await exportPdf(compiled.html)
        record({ kind: 'pdf', theme: theme.name, format: format.label, bytes: 0, checksum: checksumOf(compiled.html), title: project.brief.title })
        notify('Boîte d’impression ouverte : choisis « Enregistrer au format PDF ».', 'ok')
      } else if (kind === 'text') {
        const text = [project.brief.title, '', project.brief.message, '', ...cut.beats.map((b) => b.text)].join('\n\n')
        await copyText(text) ? notify('Texte du livrable copié.', 'ok') : notify('Copie refusée par le navigateur.', 'error')
      } else if (kind === 'png-toutes-diapositives') {
        // FAMILLE POWERPOINT 8 · DIFFUSION. La sauvegarde (.zmedia.json) et l'export HTML/PNG/PDF
        // d'UNE image existaient déjà ; ce qui manquait au regard de P1 (diapositives) était
        // d'exporter un CARROUSEL entier — la traduction directe d'un « diaporama » pour Instagram
        // et LinkedIn (VISION.md). Chaque diapositive se recompile avec ELLE SEULE active, jamais
        // les autres, exactement ce que montre déjà l'aperçu quand on clique dessus.
        const diapositives = readSlides(composition)
        if (!diapositives.length) { notify('Aucune diapositive à exporter : la Structure n’en porte aucune.', 'error'); return }
        for (let i = 0; i < diapositives.length; i++) {
          const page = compile({ brief: project.brief, cut, theme, format, dark: renderDark, seed: project.seed ?? 1, fitScale: contentScale, composition: setActiveSlide(composition, diapositives[i].id), componentBundle })
          const nomFichier = safeFileName(`${project.brief.title} ${i + 1}`, 'png')
          const res = await exportPng(page.html, format, nomFichier)
          record({ kind: 'png', theme: theme.name, format: format.label, bytes: res.bytes, checksum: checksumOf(page.html), title: `${project.brief.title} — diapositive ${i + 1}/${diapositives.length}` })
        }
        notify(`${diapositives.length} diapositives exportées, une image par fichier.`, 'ok')
      }
    } catch (err) {
      notify(err.message || 'Export impossible.', 'error')
    } finally {
      setBusy(null)
      setActionCount((n) => n + 1)
    }
  }, [compiled, project, verdict, theme, format, cut, notify, record, composition, componentBundle, renderDark, contentScale])

  const plan = React.useMemo(() => {
    if (!project || !cut || !theme || !isTemporal(format)) return null
    return forgePlan({ brief: project.brief, cut, theme, format, html: compiled?.html || '', seed: project.seed ?? 1 })
  }, [project, cut, theme, format, compiled])

  // --- Images dans les blocs (ZM-L1-04, ZM-L2-05, ZM-L3-06) ---------------------------------
  // Réutilise `fileToWebp` (src/api.js), déjà employé par l'éditeur d'articles : redimensionne et
  // encode en WebP côté navigateur. On stocke une dataURL, PAS une adresse distante — c'est ce qui
  // garde la page autonome ET ce qui permet à l'export PNG de fonctionner (une image distante
  // souillerait le canevas et ferait échouer l'encodage, message d'erreur déjà prévu).
  const attachImages = React.useCallback(async (beatIndex, files) => {
    const images = Array.from(files || []).filter((f) => f && f.type.startsWith('image/'))
    if (!images.length) return
    setBusy('image')
    try {
      let next = cut
      for (const file of images) {
        // 1400 px de côté long, qualité 0.82 : au-delà, on alourdit le document sans rien gagner
        // à l'écran ni sur une image sociale.
        const dataUrl = await fileToWebp(file, 0.82, 1400).catch(() => null)
        if (!dataUrl) { notify(`Image illisible : ${file.name}`, 'error'); continue }
        const before = next
        next = addSlot(next, beatIndex, { kind: 'image', dataUrl, label: file.name.replace(/\.[^.]+$/, '') })
        if (next === before) { notify(`${MAX_SLOTS} images au maximum par bloc.`, 'error'); break }
      }
      if (next !== cut) { patchProject({ cut: next }); setActionCount((n) => n + 1) }
    } finally { setBusy(null) }
  }, [cut, patchProject, notify])

  // AUDIT P0-T6 · UN SEUL point d'entrée pour changer de projet, jamais `setCurrentId` appelé nu.
  // `themeId`, `formatId`, `docPath`, `docSha` et `published` vivaient comme quatre états globaux
  // que changer de projet ne réinitialisait ni ne restaurait : le titre passait à B tandis que ces
  // valeurs restaient celles de A, et ⌘S pouvait alors réécrire le FICHIER de A avec le SHA de A
  // sous une composition qui était déjà celle de B. Cette fonction restaure atomiquement le
  // contexte du projet ciblé (ou des valeurs neutres s'il n'en a jamais eu) et vide toute sélection
  // qui n'aurait plus de sens dans le nouveau contexte — même geste que le changement de
  // diapositive (carte InDesign D1), généralisé au changement de PROJET entier.
  //
  // `list` optionnel : les appelants qui viennent de produire la liste fraîche dans un
  // `setProjects((list) => ...)` la passent directement, sans détour par un état de rendu qui
  // pourrait être périmé. Sans `list`, une lecture FONCTIONNELLE de `setProjects` (même patron que
  // `newProject`/`duplicateProject` plus bas) garantit la même fraîcheur — jamais la variable
  // `projects` capturée par une fermeture qui pourrait dater d'un rendu antérieur, en particulier
  // depuis la barre de commandes dont le `useMemo` ne liste pas cette fonction en dépendance.
  // Dépendances VOLONTAIREMENT VIDES : la fonction ne referme plus jamais sur un état de rendu.
  const switchToProject = React.useCallback((id, list) => {
    const appliquer = (source) => {
      const cible = source.find((p) => p.id === id)
      setCurrentId(id)
      setThemeId(cible?.themeId || DEFAULT_THEME_ID)
      setFormatId(cible?.formatId || 'F-web-article')
      setDocPath(cible?.docPath || null)
      setDocSha(cible?.docSha || null)
      setPublished(cible?.published || null)
      setSelectedComponent(null); setSelection([]); setSelectedNode(null)
      setSelectedInheritedLayerId(null); setSelectedTextStyleId(null); setSelectedObjectStyleId(null)
      setEditionTexteId(null); setPointSelectionne(null); setChainageDepuisId(null)
      setPreflightOuvert(false); setPanelLockedId(null); setSelectedBeat(0)
    }
    if (list) { appliquer(list); return }
    setProjects((actuel) => { appliquer(actuel); return actuel })
  }, [])

  // --- Enregistrer / ouvrir dans Create ------------------------------------------------------
  // ENREGISTRER n'est PAS PUBLIER (cf. l'en-tête de document.js). Ici on range la SOURCE dans
  // l'index de Matthieu, à l'endroit qu'il choisit, pour rouvrir et continuer. Publier produit
  // une page figée et partageable, c'est la barre de rendu.
  const persist = React.useCallback(async (path) => {
    if (!project) return
    setBusy('save')
    const res = await saveDocument(path, project, { themeId, formatId, sha: path === docPath ? docSha : undefined })
    setBusy(null)
    if (!res.ok) { notify(res.error, 'error'); return }
    setDocPath(path); setDocSha(res.sha); setBrowser(null)
    // AUDIT P0-T6 · le chemin et le SHA appartiennent au PROJET, pas seulement à l'état de vue
    // courant : sans cette ligne, revenir sur ce projet après en avoir visité un autre perdait
    // l'association, malgré un fichier réellement enregistré dans Create.
    patchProject({ docPath: path, docSha: res.sha })
    setActionCount((n) => n + 1)
    record({ kind: 'zmedia', theme: theme?.name || themeId, format: format.label, bytes: 0, checksum: path, title: project.brief.title })
    notify(`Enregistré dans Create : ${path}`, 'ok')
  }, [project, themeId, formatId, docPath, docSha, theme, format, notify, record, patchProject])

  const openDocument = React.useCallback(async (path) => {
    setBusy('open')
    const res = await loadDocument(path)
    setBusy(null)
    if (!res.ok) { notify(res.error, 'error'); return }
    // AUDIT R3 · une version future du format (que ce code ne comprend pas encore) reste lisible,
    // JAMAIS réécrite : `docPath` reste vide exprès, pour qu'un ⌘S ultérieur ouvre « Enregistrer
    // sous » plutôt que d'écraser silencieusement un fichier plus récent avec un format plus ancien.
    if (res.futureVersion) notify(`« ${path} » vient d’une version plus récente de ZenRayMedia : ouvert en lecture, ⌘S proposera un autre emplacement plutôt que d’écraser ce fichier.`, 'error')
    // AUDIT P0-T6 · le projet inséré porte DÉJÀ son thème, son format, son chemin et son SHA :
    // `switchToProject` restaure ensuite ce contexte de la MÊME façon qu'un changement entre deux
    // projets locaux, sélection vidée comprise, au lieu d'un chemin spécial qui oubliait ce nettoyage.
    const projetComplet = { ...res.project, themeId: res.themeId, formatId: res.formatId, docPath: res.futureVersion ? null : path, docSha: res.futureVersion ? null : res.sha, published: null }
    setProjects((list) => {
      const withoutSame = list.filter((p) => p.id !== res.project.id)
      const next = [...withoutSame, projetComplet]
      saveProjects(next)
      switchToProject(projetComplet.id, next)
      return next
    })
    setBrowser(null); setDeckTab('contenu')
    notify(`Ouvert : ${path}`, 'ok')
  }, [notify, switchToProject])

  // Ouverture depuis Create (double-clic sur un .zmedia.json) : App.jsx bascule sur la vue Media
  // et émet cet événement. Même patron que `zr:create-music`, déjà en place dans le projet.
  React.useEffect(() => {
    const onOpen = (event) => { const path = event?.detail?.path; if (path) openDocument(path) }
    window.addEventListener('zr:media-open', onOpen)
    return () => window.removeEventListener('zr:media-open', onOpen)
  }, [openDocument])

  // ⌘S : enregistrer. Si le document a déjà un chemin, on écrit directement ; sinon on ouvre le
  // fil d'Ariane pour choisir où le ranger.
  React.useEffect(() => {
    const onKey = (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 's') {
        event.preventDefault()
        if (docPath) persist(docPath); else setBrowser('save')
      }
    }
    window.addEventListener('keydown', onKey)
    return () => window.removeEventListener('keydown', onKey)
  }, [docPath, persist])

  // --- Publier (ZM-L8-01, -02, -09) ----------------------------------------------------------
  // Publier produit une PAGE dans Create, cherchable, et rend son ADRESSE. C'est la porte V0 :
  // tant qu'une URL n'existe pas, rien n'a été publié — un fichier sur un disque n'est pas
  // une publication.
  const [published, setPublished] = React.useState(null)

  const publishNow = React.useCallback(async () => {
    if (!project || !cut || !theme) return
    if (!verdict.canPublish) {
      notify(`${verdict.blocking.length} défaut(s) bloquant(s) : le Critique refuse la publication.`, 'error')
      setDeckTab('critic')
      return
    }
    setBusy('publish')
    const dir = docPath ? dirOf(docPath) : DEFAULT_MEDIA_DIR
    // Republier LE MÊME article doit écraser sa page, pas échouer en conflit : on renvoie le sha
    // de la dernière publication quand le chemin est inchangé (il ne dépend que du titre).
    const target = publishPathFor(dir, project.brief.title)
    const res = await publishArticle({ dir, brief: project.brief, cut, theme, format, sha: published?.path === target ? published.sha : undefined })
    setBusy(null)
    if (!res.ok) { notify(res.error, 'error'); return }
    setPublished(res)
    // AUDIT P0-T6 · le reçu de publication appartient au PROJET publié, jamais à un état de vue
    // qu'un autre projet pourrait ensuite afficher par erreur en le visitant à son tour.
    patchProject({ published: res })
    setDeckTab('create')
    setActionCount((n) => n + 1)
    record({ kind: 'page', theme: theme.name, format: format.label, bytes: res.bytes, checksum: res.path, title: project.brief.title })
    await copyText(res.url)
    notify(res.indexed
      ? `Publié : ${res.path} — adresse copiée.`
      : `Publié : ${res.path} — adresse copiée. L'indexation n'a pas répondu, la page sera reprise au prochain build d'index.`, 'ok')
  }, [project, cut, theme, format, verdict, docPath, published, notify, record, patchProject])


  // --- Projets --------------------------------------------------------------------------------------
  // TOUTES ces fonctions passent par une mise à jour FONCTIONNELLE de setProjects.
  // Bug réel évité (2026-07-25) : elles lisaient auparavant la variable `projects` de la portée
  // de rendu. Or la barre de commande les capture dans un useMemo qui ne dépend pas de
  // `projects` -> lancée depuis la palette après un ajout, « Nouveau brief » repartait d'une
  // liste PÉRIMÉE et écrasait les briefs créés entre-temps. Une perte de travail silencieuse.
  // AUDIT P0-T6 · UN SEUL point d'entrée pour changer de projet, jamais `setCurrentId` appelé nu.
  // `themeId`, `formatId`, `docPath`, `docSha` et `published` vivaient comme quatre états globaux
  // que changer de projet ne réinitialisait ni ne restaurait : le titre passait à B tandis que ces
  // valeurs restaient celles de A, et ⌘S pouvait alors réécrire le FICHIER de A avec le SHA de A
  // sous une composition qui était déjà celle de B. Cette fonction restaure atomiquement le
  // contexte du projet ciblé (ou des valeurs neutres s'il n'en a jamais eu) et vide toute sélection
  // qui n'aurait plus de sens dans le nouveau contexte — même geste que le changement de
  // diapositive (carte InDesign D1), généralisé au changement de PROJET entier.
  // AUDIT P0-T6 · choisir un thème ou un format est aussi une écriture sur le PROJET, jamais
  // seulement sur la vue courante — sinon revisiter ce projet plus tard, après en avoir ouvert un
  // autre, retombe sur le thème ou le format d'avant ce choix. Chaque bouton qui posait
  // `setThemeId`/`setFormatId` nu passe désormais par l'un de ces deux points uniques.
  const changeTheme = React.useCallback((id) => { setThemeId(id); patchProject({ themeId: id }) }, [patchProject])
  const changeFormat = React.useCallback((id) => { setFormatId(id); patchProject({ formatId: id }) }, [patchProject])

  // AUDIT P0-R8 · `nextProjectSerial()` remplace `list.length` comme compteur d'identifiant : un
  // compteur qui ne recule jamais, où qu'une suppression ait eu lieu, ne peut pas reproduire
  // l'identifiant d'un projet encore vivant (voir `store.js`).
  function newProject() {
    setProjects((list) => {
      const n = nextProjectSerial()
      const fresh = { id: makeId('project', `nouveau${n}`, n), brief: { ...emptyBrief(), id: makeId('brief', `nouveau${n}`, n), title: 'Nouveau brief', message: '', audience: '' }, notes: '', cut: null, themeId: null, formatId: null, docPath: null, docSha: null, published: null, seed: 1 }
      const next = [...list, fresh]
      saveProjects(next); switchToProject(fresh.id, next); setActionCount(0)
      return next
    })
    notify('Brief créé.', 'ok')
  }

  function duplicateProject() {
    setProjects((list) => {
      const source = list.find((p) => p.id === currentId) || list[0]
      if (!source) return list
      const n = nextProjectSerial()
      // Une copie garde le thème et le format de sa source, mais JAMAIS son chemin Create, son SHA
      // ni son reçu de publication : ce sont des identités du DOCUMENT source, pas de la nouvelle
      // idée qu'on explore. Dupliquer puis ⌘S doit ouvrir « Enregistrer sous », jamais réécrire A.
      const copy = { ...source, id: makeId('project', `${source.id}copie`, n), brief: { ...source.brief, id: makeId('brief', `${source.id}copie`, n), title: `${source.brief.title} (copie)` }, docPath: null, docSha: null, published: null }
      const next = [...list, copy]
      saveProjects(next); switchToProject(copy.id, next)
      return next
    })
    notify('Brief dupliqué : essaie un autre angle sans perdre l’original.', 'ok')
  }

  function deleteProject() {
    setProjects((list) => {
      if (list.length <= 1) { notify('Le dernier brief ne peut pas être supprimé.', 'error'); return list }
      const next = list.filter((p) => p.id !== currentId)
      saveProjects(next); switchToProject(next[0].id, next)
      notify('Brief supprimé.', 'ok')
      return next
    })
  }

  function resetSeed() {
    setProjects((list) => {
      const fresh = seedProject()
      const next = [...list.filter((p) => p.id !== fresh.id), fresh]
      saveProjects(next); switchToProject(fresh.id, next); setActionCount(0)
      return next
    })
    notify('Brief de démonstration rechargé.', 'ok')
  }

  // --- Correctifs proposés par le Critique --------------------------------------------------------
  const applyFix = (issue) => {
    if (issue.fix === 'refit') { withCut((c) => refitCut(c, theme)); notify('Partition réajustée au thème.', 'ok') }
    else if (issue.fix === 'shrink') {
      // Le débordement se corrige en retirant du texte, pas en rapetissant indéfiniment : on
      // fusionne le beat le plus court dans son voisin, ce qui réduit la hauteur sans perdre un mot.
      withCut((c) => {
        if (c.beats.length < 2) return c
        let shortest = 0
        c.beats.forEach((b, i) => { if (b.text.length < c.beats[shortest].text.length) shortest = i })
        return mergeBeats(c, Math.min(shortest, c.beats.length - 2))
      })
      notify('Deux beats fusionnés pour rentrer dans le format.', 'ok')
    }
  }

  // --- Atelier Lego -------------------------------------------------------------------------------
  const componentGroups = React.useMemo(() => {
    const needle = libraryQuery.trim().toLocaleLowerCase('fr')
    const source = (componentBundle?.components || []).filter((entry) => {
      const isIcon = /icon/i.test(`${entry.id} ${entry.name}`)
      if (libraryTab === 'icons' ? !isIcon : isIcon) return false
      return !needle || `${entry.name} ${entry.group} ${entry.id}`.toLocaleLowerCase('fr').includes(needle)
    })
    return groupComponents(source)
  }, [componentBundle, libraryQuery, libraryTab])

  const imageResults = React.useMemo(() => {
    if (!imageIndexReady || libraryTab !== 'images') return []
    const needle = libraryQuery.trim().toLocaleLowerCase('fr')
    const out = []
    for (const path of getIndexPaths()) {
      if (!path.endsWith('.img.json')) continue
      const name = path.split('/').pop().replace(/\.img\.json$/, '')
      if (needle && !`${name} ${path}`.toLocaleLowerCase('fr').includes(needle)) continue
      // ON GARDE L'ENTRÉE ENTIÈRE, et non son seul `.u` (2026-08-04).
      //
      // Une vignette publique CHIFFRÉE porte bien un `u`, mais celui-ci pointe sur du ciphertext :
      // le poser dans un <img> affiche une image cassée, ce qui était le symptôme. Et une image
      // PRIVÉE n'a pas de `u` du tout, seulement `{r,p}` : elle était donc écartée d'office, si
      // bien qu'aucune image privée du drive n'apparaissait jamais ici.
      const thumb = getNodeThumb(path)
      const url = thumbUrlOf(thumb)
      if (!url) continue
      out.push({ path, name, url, thumb })
      if (out.length >= 48) break
    }
    return out
  }, [imageIndexReady, libraryQuery, libraryTab])

  const addLibraryComponent = React.useCallback((entry, targetId = selectedComponent, placement = 'below') => {
    patchComposition((current) => addComponent(current, entry, targetId, placement))
    setSelectedComponent(null)
    notify(`${entry.name} ajouté.`, 'ok')
  }, [patchComposition, selectedComponent, notify])

  // --- Barre de commande ---------------------------------------------------------------------------
  const commands = React.useMemo(() => {
    const list = [
      { id: 'cmd-cut', label: 'Monter la partition depuis les notes', hint: 'Cut', run: buildCutNow },
      { id: 'cmd-refit', label: 'Réajuster le nombre de beats au thème', hint: 'Cut', run: () => withCut((c) => refitCut(c, theme)) },
      { id: 'cmd-lock', label: cut?.locked ? 'Déverrouiller la partition' : 'Verrouiller la partition', hint: 'Cut', run: () => withCut((c) => ({ ...c, locked: !c.locked })) },
      { id: 'cmd-dark', label: renderDark ? 'Rendu en clair' : 'Rendu en sombre', hint: 'Stage', run: () => setRenderDark((v) => !v) },
      { id: 'cmd-safe', label: showSafe ? 'Masquer les zones de sécurité' : 'Afficher les zones de sécurité', hint: 'Stage', run: () => setShowSafe((v) => !v) },
      { id: 'cmd-html', label: 'Exporter la page HTML autonome', hint: 'Export', run: () => runExport('html') },
      { id: 'cmd-png', label: 'Exporter en image PNG', hint: 'Export', run: () => runExport('png') },
      { id: 'cmd-pdf', label: 'Exporter en PDF (impression)', hint: 'Export', run: () => runExport('pdf') },
      { id: 'cmd-text', label: 'Copier le texte du livrable', hint: 'Export', run: () => runExport('text') },
      { id: 'cmd-png-all', label: 'Exporter toutes les diapositives en images', hint: 'Export', run: () => runExport('png-toutes-diapositives') },
      { id: 'cmd-save', label: docPath ? `Enregistrer dans Create (${docPath})` : 'Enregistrer dans Create…', hint: 'Create', run: () => { if (docPath) persist(docPath); else setBrowser('save') } },
      { id: 'cmd-saveas', label: 'Enregistrer sous…', hint: 'Create', run: () => setBrowser('save') },
      { id: 'cmd-open', label: 'Ouvrir un document depuis Create…', hint: 'Create', run: () => setBrowser('open') },
      { id: 'cmd-publish', label: 'Publier l’article dans Create et copier l’adresse', hint: 'Publier', run: () => publishNow() },
      { id: 'cmd-new', label: 'Nouveau brief', hint: 'Projet', run: () => newProject() },
      { id: 'cmd-dup', label: 'Dupliquer ce brief', hint: 'Projet', run: () => duplicateProject() },
      { id: 'cmd-seed', label: 'Recharger le brief de démonstration', hint: 'Projet', run: () => resetSeed() },
    ]
    for (const f of FORMATS) list.push({ id: `fmt-${f.id}`, label: `Format : ${f.label}`, hint: 'Format', run: () => { changeFormat(f.id); setActionCount((n) => n + 1) } })
    for (const t of themes) list.push({ id: `thm-${t.id}`, label: `Thème : ${t.name}`, hint: t.familyLabel, run: () => { changeTheme(t.id); setActionCount((n) => n + 1) } })
    // FAMILLE SLATE 5 · LA BARRE ⌘K DEVIENT UN VRAI SÉLECTEUR D'ASSETS, pas seulement de commandes.
    // La doc range ce geste sous « Ctrl+P, je connais approximativement le nom, recherche
    // immédiate dans l'ensemble des assets » (Global Asset Picker) : taper le nom d'un composant
    // ici doit le POSER, exactement comme le fait déjà un clic dans la Palette.
    for (const entry of componentBundle?.components || []) {
      list.push({ id: `cmp-${entry.id}`, label: `Composant : ${entry.name}`, hint: entry.group || 'Composant', run: () => addLibraryComponent(entry) })
    }
    return list
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [buildCutNow, cut, theme, renderDark, showSafe, runExport, themes, docPath, persist, publishNow, componentBundle, addLibraryComponent, changeTheme, changeFormat])

  const filteredCommands = React.useMemo(() => {
    const q = query.trim().toLowerCase()
    if (!q) return commands.slice(0, 9)
    return commands.filter((c) => `${c.label} ${c.hint}`.toLowerCase().includes(q)).slice(0, 12)
  }, [commands, query])

  React.useEffect(() => { setPaletteIndex(0) }, [query])

  React.useEffect(() => {
    const onKey = (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault()
        setPaletteOpen(true)
        setTimeout(() => queryRef.current?.focus(), 0)
      } else if (event.key === 'Escape' && paletteOpen) {
        setPaletteOpen(false); setQuery('')
      }
    }
    window.addEventListener('keydown', onKey)
    return () => window.removeEventListener('keydown', onKey)
  }, [paletteOpen])

  const runCommand = (command) => {
    setPaletteOpen(false); setQuery('')
    try { command.run() } catch (err) { notify(err.message || 'Commande impossible.', 'error') }
  }

  const addLibraryImage = React.useCallback(async (image, targetId = selectedComponent, placement = 'below') => {
    // On pose l'adresse RÉSOLUE, jamais l'adresse brute : le document doit porter quelque chose
    // qu'un <img> sait afficher, y compris dans l'aperçu et dans l'export, où le déchiffrement
    // n'aura plus lieu.
    // ON POSE L'IMAGE PLEINE, PAS SA VIGNETTE. Une vignette fait quelques centaines de pixels,
    // taillée pour une case de palette ; étirée sur huit cents pixels de large elle se pixellise,
    // et aucun réglage ne rattrape des pixels qui n'ont jamais été là. La vignette ne reste qu'en
    // repli, pour qu'une image irrésolue s'affiche approximativement plutôt que pas du tout.
    // Reconstituer une image découpée en morceaux puis la déchiffrer prend des secondes : sans
    // signal, on clique et il ne se passe rien de visible, donc on reclique. Le témoin d'activité
    // n'est pas un ornement, c'est ce qui évite quatre insertions pour une image voulue.
    setBusy('image')
    const url = (await resolveFullImageUrl(image.path))
      || (await resolveThumbUrl(image.thumb || image.url))
      || image.url
    setBusy(null)
    patchComposition((current) => addImage(current, { ...image, url }, targetId, placement))
    setSelectedComponent(null)
    notify(`Image « ${image.name} » ajoutée.`, 'ok')
  }, [patchComposition, selectedComponent, notify])

  const placementAt = (event) => {
    const box = event.currentTarget.getBoundingClientRect()
    const x = (event.clientX - box.left) / Math.max(1, box.width)
    const y = (event.clientY - box.top) / Math.max(1, box.height)
    if (y < 0.25) return 'above'
    if (y > 0.75) return 'below'
    return x < 0.5 ? 'left' : 'right'
  }

  const onStructureDragOver = (event, targetId) => {
    event.preventDefault()
    const placement = placementAt(event)
    event.dataTransfer.dropEffect = 'move'
    setDropTarget({ id: targetId, placement })
  }

  const onStructureDrop = (event, targetId) => {
    event.preventDefault()
    const placement = placementAt(event)
    const instanceId = event.dataTransfer.getData('application/x-zenray-instance')
    const componentId = event.dataTransfer.getData('application/x-zenray-component')
    const imagePath = event.dataTransfer.getData('application/x-zenray-image')
    if (instanceId) patchComposition((current) => moveItem(current, instanceId, targetId, placement))
    else if (componentId) {
      const entry = componentBundle?.components?.find((item) => item.id === componentId)
      if (entry) addLibraryComponent(entry, targetId, placement)
    } else if (imagePath) {
      const image = imageResults.find((item) => item.path === imagePath)
      if (image) addLibraryImage(image, targetId, placement)
    }
    setDropTarget(null)
  }

  const onEmptyStructureDrop = (event) => {
    if (composition.rows.length || event.currentTarget !== event.target.closest('.zrm-structure')) return
    event.preventDefault()
    const componentId = event.dataTransfer.getData('application/x-zenray-component')
    const imagePath = event.dataTransfer.getData('application/x-zenray-image')
    const entry = componentBundle?.components?.find((item) => item.id === componentId)
    const image = imageResults.find((item) => item.path === imagePath)
    if (entry) addLibraryComponent(entry, null, 'below')
    else if (image) addLibraryImage(image, null, 'below')
  }

  // ═══ CARTE L6 · GLISSER ET REDIMENSIONNER AU CANEVAS ═════════════════════════════════════════
  //
  // Les poignées vivent dans une couche superposée à l'aperçu, HORS de l'iframe. C'est délibéré :
  // injecter du script de manipulation dans le document reviendrait à le faire voyager jusqu'à
  // l'export, or l'export doit rester une page morte et autonome. Le précédent existe déjà, le pont
  // de sélection du 2026-08-01 n'entre dans le document qu'en mode aperçu.
  //
  // TOUTE LA GÉOMÉTRIE SE CALCULE EN PIXELS DU CANEVAS, jamais en pixels d'écran : on divise le
  // déplacement de la souris par `fitScale` avant de l'écrire. Sans cette division, déplacer un
  // calque de dix pixels à l'écran l'aurait déplacé de vingt-cinq dans un canevas 1080 affiché à
  // 40 %, et le modèle aurait menti sur ce que l'export produit.
  const gesteRef = React.useRef(null)
  // Les guides de magnétisme actifs À L'INSTANT du geste, pour les dessiner sur le canevas. `null`
  // quand rien n'accroche : pas de traits qui traînent une fois le clic relâché.
  const [guides, setGuides] = React.useState({ x: null, y: null })

  const onPoigneeDown = (event, layer, mode) => {
    // FAMILLE INDESIGN D3 · un curseur de texte CHARGÉ prend la main sur le clic : cliquer un autre
    // bloc texte COMPLÈTE la chaîne au lieu de le déplacer, exactement comme charger le texte
    // détourne le clic suivant dans InDesign, quel que soit l'outil actif.
    if (onCalqueTexteClicPourChainer(event, layer)) return
    if (isEffectivelyLocked(composition, layer)) return  // famille Photoshop 5 : verrouillé par soi ou par son groupe
    event.preventDefault()
    event.stopPropagation()
    event.currentTarget.setPointerCapture?.(event.pointerId)
    commencerGeste()
    setSelectedComponent(layer.id)
    gesteRef.current = { id: layer.id, mode, sx: event.clientX, sy: event.clientY, x: layer.x, y: layer.y, w: layer.w, h: layer.h, rotation: layer.rotation || 0 }
  }

  // LA POIGNÉE DE ROTATION est un geste À PART : elle ne déplace ni ne redimensionne, elle tourne
  // autour du CENTRE du calque. L'angle se calcule depuis le pointeur, pas depuis un delta, sans
  // quoi une rotation composée avec le déplacement de la souris dériverait à chaque frappe.
  const onPoigneeRotation = (event, layer) => {
    if (isEffectivelyLocked(composition, layer)) return  // famille Photoshop 5 : verrouillé par soi ou par son groupe
    event.preventDefault()
    event.stopPropagation()
    event.currentTarget.setPointerCapture?.(event.pointerId)
    commencerGeste()
    setSelectedComponent(layer.id)
    gesteRef.current = { id: layer.id, mode: 'rotate', rotationDepart: layer.rotation || 0, cx: layer.x + layer.w / 2, cy: layer.y + layer.h / 2 }
  }

  const onPoigneeMove = (event) => {
    const grabberGeste = grabberGesteRef.current
    if (grabberGeste) {
      // Même discipline que le glisser d'un point de tracé : le delta part d'un instantané pris au
      // clic, jamais d'un recalcul cumulatif, et se convertit en POURCENTAGE de la boîte du calque
      // puisque `focalX`/`focalY` s'écrivent déjà ainsi (carte Photoshop 6).
      const echelle = fitScale || 1
      const dxPct = ((event.clientX - grabberGeste.sx) / echelle / grabberGeste.w) * 100
      const dyPct = ((event.clientY - grabberGeste.sy) / echelle / grabberGeste.h) * 100
      patchComposicionEnDirect((c) => patchLayer(c, grabberGeste.id, {
        focalX: Math.min(100, Math.max(0, grabberGeste.focalX + dxPct)),
        focalY: Math.min(100, Math.max(0, grabberGeste.focalY + dyPct)),
      }))
      return
    }
    const pointGeste = pointGesteRef.current
    if (pointGeste) {
      const echelle = fitScale || 1
      // Delta en PIXELS DU CANEVAS converti en pourcentage DE LA BOÎTE DU CALQUE (pathPoints se lit
      // en 0-100 relatif à layer.w/h) — même discipline que `gesteRef` : tout part d'un instantané
      // pris au clic, jamais d'un recalcul cumulatif au fil du glisser.
      const dxPct = ((event.clientX - pointGeste.sx) / echelle / pointGeste.w) * 100
      const dyPct = ((event.clientY - pointGeste.sy) / echelle / pointGeste.h) * 100
      const origX = pointGeste.partie === 'ancre' ? pointGeste.point.x : pointGeste.point[`${pointGeste.partie}X`]
      const origY = pointGeste.partie === 'ancre' ? pointGeste.point.y : pointGeste.point[`${pointGeste.partie}Y`]
      const x = origX + dxPct, y = origY + dyPct
      patchComposicionEnDirect((c) => {
        const calque = findLayer(c, pointGeste.layerId)
        if (!calque) return c
        const points = pointGeste.partie === 'ancre'
          ? movePathAnchor(calque.pathPoints, pointGeste.index, x, y)
          : movePathHandle(calque.pathPoints, pointGeste.index, pointGeste.partie, x, y)
        return patchLayer(c, pointGeste.layerId, { pathPoints: points })
      })
      return
    }
    const geste = gesteRef.current
    if (!geste) return
    const echelle = fitScale || 1
    if (geste.mode === 'rotate') {
      // L'angle du pointeur par rapport au centre, en pixels D'ÉCRAN : le canevas peut être zoomé
      // ou déplacé, mais un angle ne dépend pas de l'échelle, contrairement à une distance.
      const rect = frameRef.current?.getBoundingClientRect()
      if (!rect) return
      const px = geste.cx * echelle + rect.left
      const py = geste.cy * echelle + rect.top
      const degres = Math.round((Math.atan2(event.clientY - py, event.clientX - px) * 180 / Math.PI) + 90)
      patchComposicionEnDirect((c) => patchLayer(c, geste.id, { rotation: degres }))
      return
    }
    const dx = (event.clientX - geste.sx) / echelle
    const dy = (event.clientY - geste.sy) / echelle
    // FAMILLE POWERPOINT 2 · Maj conserve les proportions au redimensionnement, dans un coin.
    let suivant = applyHandle(geste, geste.mode, dx, dy, event.shiftKey)
    // LE MAGNÉTISME NE JOUE QUE SUR LE DÉPLACEMENT, jamais sur le redimensionnement : accrocher un
    // bord qu'on est justement en train de tirer produirait des à-coups au lieu d'une aide.
    // Maintenir Alt le désactive ponctuellement, comme dans Figma, pour un positionnement libre.
    if (geste.mode === 'move' && !event.altKey) {
      // AUDIT P1-R4 : un calque invisible (autre diapositive, groupe masqué) ne doit jamais aimanter
      // un glisser, même ensemble que le marquee et le rendu.
      const autres = readVisibleLayers(composition).filter((l) => l.id !== geste.id)
      const r = snapMove(suivant, autres, { w: format.canvas.w, h: format.canvas.h }, 6, readGuides(composition))
      suivant = { ...suivant, x: r.x, y: r.y }
      setGuides(r.guides)
    } else if (guides.x !== null || guides.y !== null) {
      setGuides({ x: null, y: null })
    }
    patchComposicionEnDirect((c) => patchLayer(c, geste.id, suivant))
  }

  const onPoigneeUp = () => {
    if (grabberGesteRef.current) { grabberGesteRef.current = null; setActionCount((n) => n + 1) }
    if (pointGesteRef.current) { pointGesteRef.current = null; setActionCount((n) => n + 1) }
    if (gesteRef.current) { gesteRef.current = null; setActionCount((n) => n + 1) }
    setGuides({ x: null, y: null })
    commiterGeste()
  }

  // ÉCHAP ANNULE LE GESTE EN COURS (AUDIT P1-R1) : revient à l'état capturé par `commencerGeste`,
  // SANS empiler d'entrée — le geste n'a jamais été validé, Annuler n'a donc rien à défaire ici.
  // Rend `true` quand un geste était bien ouvert, pour que le clavier sache si Échap doit s'arrêter
  // là ou continuer vers ses autres usages (fermer un menu, quitter la Plume, désélectionner...).
  const annulerGeste = React.useCallback(() => {
    const transaction = gesteTransactionRef.current
    if (!transaction) return false
    gesteTransactionRef.current = null
    grabberGesteRef.current = null
    pointGesteRef.current = null
    gesteRef.current = null
    guideGesteRef.current = null
    setGuides({ x: null, y: null })
    patchProject((p) => ({ compositions: { ...(p.compositions || {}), [themeId]: transaction.avant } }))
    return true
  }, [patchProject, themeId])

  // LE CADRAGE DE LA SÉLECTION (« Frame Selected »), distinct du recadrage général sur F : celui-ci
  // centre et zoome le plan de travail sur le calque choisi plutôt que sur le canevas entier.
  const cadrerLaSelection = React.useCallback(() => {
    const c = calqueSelectionne
    if (!c || !stageRef.current) return
    const box = stageRef.current.getBoundingClientRect()
    const r = frameBox(c, box.width, box.height)
    setZoom(r.zoom / (autoScale || 1))
    setPan(r.pan)
  }, [calqueSelectionne, autoScale])

  React.useEffect(() => {
    // SUR UN SITE WEB, UNE TOUCHE NUE EST TOUJOURS UN RISQUE : l'utilisateur tape dans un champ la
    // plupart du temps, et « F » doit alors écrire un F. Toute touche sans modificateur est donc
    // ignorée dès que la cible est un champ, une liste, ou un élément rendu modifiable. C'est le
    // même garde-fou que celui d'un éditeur natif, à ceci près qu'il est ici obligatoire.
    const dansUnChamp = (cible) => {
      if (!cible) return false
      const tag = cible.tagName
      return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || cible.isContentEditable
    }
    const bas = (e) => {
      if (dansUnChamp(e.target)) return
      // ⌘A / Ctrl+A et ⌘⇧I / Ctrl+⇧I (famille Photoshop « Sélection ») sont les DEUX SEULS
      // raccourcis avec modificateur de cet éditeur : ils sortent donc du garde-fou général avant
      // qu'il ne les refuse, plutôt que de l'affaiblir pour tout le monde.
      if ((e.metaKey || e.ctrlKey) && e.code === 'KeyA' && !e.shiftKey) { e.preventDefault(); toutSelectionner(); return }
      // ⌘G / Ctrl+G (famille Photoshop 5) : un menu qui promet un raccourci et ne le tient pas
      // est pire qu'un menu sans raccourci du tout, l'utilisateur essaie et rien ne se passe.
      if ((e.metaKey || e.ctrlKey) && e.code === 'KeyG' && !e.shiftKey) { e.preventDefault(); grouperSelection(); return }
      // ⌘Z ANNULE, ⌘⇧Z RÉTABLIT (famille Photoshop 8). Testé AVANT le cas ⌘⇧I ci-dessous puisque
      // les deux partagent le modificateur Maj : l'ordre des `if` décide, comme pour ⌘G plus haut.
      if ((e.metaKey || e.ctrlKey) && e.code === 'KeyZ' && !e.shiftKey) { e.preventDefault(); annuler(); return }
      if ((e.metaKey || e.ctrlKey) && e.shiftKey && e.code === 'KeyZ') { e.preventDefault(); retablir(); return }
      // ⌘C / ⌘X / ⌘V (famille Photoshop 8). Refusés quand rien n'est sélectionné : copier le
      // vide collerait le vide, un geste sans effet qui ne mérite pas de vider le presse-papiers.
      if ((e.metaKey || e.ctrlKey) && e.code === 'KeyC') { e.preventDefault(); copierSelection(); return }
      if ((e.metaKey || e.ctrlKey) && e.code === 'KeyX') { e.preventDefault(); couperSelection(); return }
      if ((e.metaKey || e.ctrlKey) && e.code === 'KeyV') { e.preventDefault(); collerSelection(); return }
      if ((e.metaKey || e.ctrlKey) && e.shiftKey && e.code === 'KeyI') { e.preventDefault(); inverserSelection(); return }
      if (e.metaKey || e.ctrlKey || e.altKey) return
      if (e.code === 'Space') { e.preventDefault(); espaceRef.current = true }
      // « F » recadre le plan de travail, comme dans Photoshop et dans tous les logiciels 3D.
      else if (e.code === 'KeyF' && e.shiftKey) { e.preventDefault(); cadrerLaSelection() }
      else if (e.code === 'KeyF') { e.preventDefault(); setZoom(1); setPan({ x: 0, y: 0 }) }
      // Échap désélectionne, ce qui est le seul moyen de revenir à « rien de choisi ». En mode
      // Plume (famille Illustrator I2), Échap annule d'abord le tracé EN COURS sans quitter
      // l'outil (recommencer un tracé raté ne doit pas ressortir de la Plume) ; un second Échap,
      // tracé déjà vide, quitte l'outil et rend la main à la Sélection. UN GESTE DE POIGNÉE EN COURS
      // (AUDIT P1-R1) passe devant tout le reste : Échap y ramène la scène pile à l'état d'avant le
      // glisser, geste absorbé, rien d'autre ne doit réagir à la même frappe.
      else if (e.code === 'Escape') {
        if (annulerGeste()) { /* le geste absorbe cet Échap */ }
        else if (menuContextuel) setMenuContextuel(null)
        else if (outilPlumeActif) {
          if (tracePlumeRef.current.length) { tracePlumeRef.current = []; setTraceApercu(null) }
          else setOutilPlumeActif(false)
        }
        // FAMILLE INDESIGN D3 · Échap annule un curseur de texte chargé sans rien chaîner.
        else if (chainageDepuisId) { setChainageDepuisId(null) }
        else { setSelection([]); setSelectedComponent(null); setSelectedNode(null) }
      }
      // ENTRÉE termine un tracé OUVERT (famille Illustrator I2) : fermer par clic près du premier
      // point reste le seul moyen de produire un tracé FERMÉ, Entrée ne sert que l'autre cas.
      else if (e.code === 'Enter' && outilPlumeActif) { e.preventDefault(); terminerTrace(false) }
