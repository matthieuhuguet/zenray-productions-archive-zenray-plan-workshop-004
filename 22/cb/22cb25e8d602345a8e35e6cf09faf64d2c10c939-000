// push-policy-guard.test.mjs (12 October 2026): fails when an upload script runs `git push` outside the push batch policy and is not
// in the explicit allowlist with a reason. Both directions: green on the repository, red on every kind of broken tree.
// Run: node --test scripts/lib/push-policy-guard.test.mjs
// (node:test file, like the other .test.mjs files of this repository; scripts/lib/push-batch-policy.test.js runs the same scan
// under vitest so that `npm test` enforces it too.)
import test from 'node:test'
import assert from 'node:assert/strict'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { PUSH_ALLOWLIST, scanPushPaths, scanPinnedBatches } from './push-policy-guard.mjs'
import { loadPushPolicyConfig, partsPerRepo, repoCapBytes } from './push-batch-policy.mjs'

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', '..')
const MiB = 1024 * 1024

function fixture(files) {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'push-guard-'))
  for (const [relative, content] of Object.entries(files)) {
    const target = path.join(root, relative)
    fs.mkdirSync(path.dirname(target), { recursive: true })
    fs.writeFileSync(target, content)
  }
  return root
}

test('the repository has no script that pushes outside the policy without a reason', () => {
  const report = scanPushPaths({ root: ROOT })
  assert.deepEqual(report.unlisted, [], `scripts that run git push outside the policy and are not allowlisted: ${report.unlisted.join(', ')}`)
  assert.deepEqual(report.stale, [], `allowlist entries that no longer match: ${report.stale.join(', ')}`)
  assert.deepEqual(report.weak, [], `allowlist entries without a real reason: ${report.weak.join(', ')}`)
  assert.deepEqual(report.pinned, [], `files that pin a fixed push batch: ${report.pinned.join(', ')}`)
  for (const routed of ['scripts/video-raw-lib.mjs', 'scripts/lib/video-git-shard.mjs']) {
    assert.ok(report.routed.includes(routed), `${routed} must import the push batch policy`)
  }
})

test('every allowlist entry names an existing file and gives a reason of a real sentence', () => {
  for (const entry of PUSH_ALLOWLIST) {
    assert.ok(fs.existsSync(path.join(ROOT, entry.file)), `${entry.file} does not exist`)
    assert.ok(entry.reason.trim().length >= 20, `${entry.file} has no reason`)
    assert.ok(entry.kind, `${entry.file} has no kind`)
  }
  assert.equal(new Set(PUSH_ALLOWLIST.map((entry) => entry.file)).size, PUSH_ALLOWLIST.length, 'duplicate allowlist entry')
})

test('RED: an upload script that runs git push without the policy and without a reason fails the guard', () => {
  const root = fixture({
    'scripts/new-upload.mjs': "import { spawnSync } from 'node:child_process'\nspawnSync('git', ['-C', dir, 'push', 'origin', 'HEAD:main'])\n",
  })
  try {
    const report = scanPushPaths({ root, allowlist: [] })
    assert.deepEqual(report.unlisted, ['scripts/new-upload.mjs'])
  } finally { fs.rmSync(root, { recursive: true, force: true }) }
})

test('RED: a python and a shell upload script are covered as well', () => {
  const root = fixture({
    'scripts/Films/worker.py': "subprocess.run(['git', '-C', clone, 'push', '-q', 'origin', 'HEAD:main'])\n",
    'scripts/mirror.sh': 'git -C "$DIR" "push" origin HEAD:main\n',
    'scripts/unquoted.sh': 'set -e\ngit -C "$DIR" push origin HEAD:main\n',
  })
  try {
    const report = scanPushPaths({ root, allowlist: [] })
    assert.deepEqual(report.unlisted, ['scripts/Films/worker.py', 'scripts/mirror.sh', 'scripts/unquoted.sh'])
  } finally { fs.rmSync(root, { recursive: true, force: true }) }
})

test('GREEN: the same script passes when it imports the policy, or when it is allowlisted with a reason', () => {
  const root = fixture({
    'scripts/routed.mjs': "import { sharedPushController } from './lib/push-batch-policy.mjs'\nrun(['push', 'origin'])\n",
    'scripts/listed.mjs': "run(['push', 'origin'])\n",
  })
  try {
    const report = scanPushPaths({ root, allowlist: [{ file: 'scripts/listed.mjs', kind: 'manifest-text', reason: 'A few KiB of manifests, never a media payload.' }] })
    assert.deepEqual(report.unlisted, [])
    assert.deepEqual(report.stale, [])
    assert.deepEqual(report.routed, ['scripts/routed.mjs'])
  } finally { fs.rmSync(root, { recursive: true, force: true }) }
})

test('RED: a mention of the policy in a comment is not routing', () => {
  const root = fixture({
    'scripts/pretender.mjs': "// TODO use lib/push-batch-policy.mjs one day\nrun(['push', 'origin'])\n",
  })
  try {
    assert.deepEqual(scanPushPaths({ root, allowlist: [] }).unlisted, ['scripts/pretender.mjs'])
  } finally { fs.rmSync(root, { recursive: true, force: true }) }
})

