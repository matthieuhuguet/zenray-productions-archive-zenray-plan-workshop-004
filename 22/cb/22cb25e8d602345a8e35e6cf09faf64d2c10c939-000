test('RED: importing the policy for its numbers while running an own push loop is not routing', () => {
  const root = fixture({
    'scripts/own-loop.mjs': "import { loadPushPolicyConfig } from './lib/push-batch-policy.mjs'\nrun(['push', 'origin'])\n",
    'scripts/engine.mjs': "import { runPushBatch } from './lib/push-batch-policy.mjs'\nawait runPushBatch({})\nrun(['push', 'origin'])\n",
  })
  try {
    const report = scanPushPaths({ root, allowlist: [] })
    assert.deepEqual(report.unlisted, ['scripts/own-loop.mjs'])
    assert.deepEqual(report.routed, ['scripts/engine.mjs'])
  } finally { fs.rmSync(root, { recursive: true, force: true }) }
})

test('RED: a stale allowlist entry, an entry that became routed and an entry without a reason are reported', () => {
  const root = fixture({
    'scripts/now-routed.mjs': "import { runPushBatch } from './lib/push-batch-policy.mjs'\nrunPushBatch()\nrun(['push'])\n",
    'scripts/weak.mjs': "run(['push'])\n",
  })
  try {
    const report = scanPushPaths({
      root,
      allowlist: [
        { file: 'scripts/gone.mjs', kind: 'manifest-text', reason: 'This file was deleted long ago and the entry stayed.' },
        { file: 'scripts/now-routed.mjs', kind: 'manifest-text', reason: 'Used to push by hand before the policy existed.' },
        { file: 'scripts/weak.mjs', kind: 'manifest-text', reason: 'ok' },
      ],
    })
    assert.equal(report.stale.length, 2)
    assert.ok(report.stale.some((line) => line.startsWith('scripts/gone.mjs')))
    assert.ok(report.stale.some((line) => line.startsWith('scripts/now-routed.mjs')))
    assert.deepEqual(report.weak, ['scripts/weak.mjs'])
  } finally { fs.rmSync(root, { recursive: true, force: true }) }
})

test('RED: a fixed push batch written as a literal (the 190 MiB pin of the film worker) is reported', () => {
  const root = fixture({
    'scripts/Films/worker.py': "up_env['ZR_SHARD_PUSH_BATCH_MB'] = '190'\n",
    'scripts/launcher.mjs': "env.ZR_SHARD_PUSH_BATCH_MB = '190'\n",
    'scripts/reader.mjs': 'const mb = Number(process.env.ZR_SHARD_PUSH_BATCH_MB)\n',
  })
  try {
    const report = scanPushPaths({ root, allowlist: [] })
    assert.deepEqual(report.pinned, ['scripts/Films/worker.py', 'scripts/launcher.mjs'])
  } finally { fs.rmSync(root, { recursive: true, force: true }) }
})

test('the delivered numbers: 1 900 MiB in 20 parts, 7.2 % under 2 048 MiB, 43 parts in a 4 096 MiB repository', () => {
  const config = loadPushPolicyConfig({})
  assert.equal(config.topParts, 20)
  assert.equal(config.targetMiB, 1900)
  assert.equal(config.partBytes, 95 * MiB + 16)
  assert.ok(20 * config.partBytes <= 1900 * MiB + 400)
  assert.ok(Math.abs((2048 - 1900) / 2048 - 0.072) < 0.001)
  assert.equal(repoCapBytes(config, 'film'), 4096 * MiB)
  assert.equal(partsPerRepo(config, 'film'), 43)
  assert.equal(partsPerRepo(config, 'folder'), 21)
})

test('RED/GREEN: a deployed copy of worker scripts outside the repository is scanned for a pinned batch', () => {
  const dirty = fixture({ 'Scripts/ResumeMoviesUpload.py': "    env['ZR_SHARD_PUSH_BATCH_MB'] = '190'\n", 'Scripts/Other.py': "print('ok')\n" })
  const clean = fixture({ 'Scripts/ResumeMoviesUpload.py': "env.pop('ZR_SHARD_PUSH_BATCH_MB', None)\n" })
  try {
    assert.deepEqual(scanPinnedBatches(path.join(dirty, 'Scripts')), ['ResumeMoviesUpload.py'])
    assert.deepEqual(scanPinnedBatches(path.join(clean, 'Scripts')), [])
    assert.deepEqual(scanPinnedBatches(path.join(clean, 'missing')), [])
  } finally { fs.rmSync(dirty, { recursive: true, force: true }); fs.rmSync(clean, { recursive: true, force: true }) }
})

// Set ZR_DEPLOYED_SCRIPTS_DIR to the directory of the running worker to check the real deployed copy (skipped when unset).
test('the deployed worker scripts do not pin a fixed batch (only when ZR_DEPLOYED_SCRIPTS_DIR is set)', { skip: !process.env.ZR_DEPLOYED_SCRIPTS_DIR }, () => {
  assert.deepEqual(scanPinnedBatches(process.env.ZR_DEPLOYED_SCRIPTS_DIR), [])
})

// 14 October 2026: the CMAF segment push hands the WHOLE list to pushFiles; a fixed stage limit in the caller (350 MiB) once cut every
// push to 350 MiB whatever the line. This static check fails if a fixed batch constant comes back. FR : plus de limite fixe de lot.
import { readFileSync as readSource } from 'node:fs'
import { fileURLToPath as toPath } from 'node:url'
test('AttachVideoCmafDashHls hands the whole segment list to pushFiles, without a fixed batch limit', () => {
  const source = readSource(toPath(new URL('../AttachVideoCmafDashHls.mjs', import.meta.url)), 'utf8')
  const code = source.split('\n').filter((line) => !line.trim().startsWith('//')).join('\n')
  assert.doesNotMatch(code, /BATCH_STAGE_LIMIT|batchBytes\s*>=|\* 1024 \* 1024[^\n]*batch/i)
  assert.equal((code.match(/shard\.pushFiles\(/g) || []).length, 1)
})
