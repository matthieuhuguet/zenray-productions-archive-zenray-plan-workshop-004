import React from 'react'
import { afterEach, expect, it, vi } from 'vitest'
import { render, cleanup, screen, fireEvent } from '@testing-library/react'
import JapaneseNotebook from './JapaneseNotebook.jsx'
afterEach(()=>{cleanup();sessionStorage.clear()})
it('keeps an unsaved draft when another revision arrives',()=>{
  const notes={existing:{title:'Titre',text:'Ancien',topic:'japanese',archived:false,revision:1}}
  const result=render(<JapaneseNotebook notes={notes} onSave={vi.fn()} />)
  fireEvent.click(screen.getByRole('button',{name:'Titre Japonais'}))
  fireEvent.change(screen.getByLabelText('Texte de la note'),{target:{value:'Brouillon local'}})
  result.rerender(<JapaneseNotebook notes={{existing:{...notes.existing,text:'Distant',revision:2}}} onSave={vi.fn()} />)
  expect(screen.getByLabelText('Texte de la note')).toHaveValue('Brouillon local')
})
it('disables note inputs during saving and retains text if a save fails',async()=>{
  const onSave=vi.fn().mockResolvedValue(false)
  const result=render(<JapaneseNotebook notes={{}} busy={false} onSave={onSave} />)
  fireEvent.change(screen.getByLabelText('Titre de la note'),{target:{value:'Titre'}})
  fireEvent.change(screen.getByLabelText('Texte de la note'),{target:{value:'Conservé'}})
  result.rerender(<JapaneseNotebook notes={{}} busy onSave={onSave} />)
  expect(screen.getByLabelText('Texte de la note')).toBeDisabled()
  result.rerender(<JapaneseNotebook notes={{}} busy={false} onSave={onSave} />)
  fireEvent.click(screen.getByRole('button',{name:'Enregistrer la note'}))
  expect(screen.getByLabelText('Texte de la note')).toHaveValue('Conservé')
})

it('recovers a draft after the notebook is completely unmounted',()=>{
 const view=render(<JapaneseNotebook onSave={vi.fn()} />)
 fireEvent.change(screen.getByLabelText('Texte de la note'),{target:{value:'Brouillon récupérable'}})
 view.unmount()
 render(<JapaneseNotebook onSave={vi.fn()} />)
 expect(screen.getByLabelText('Texte de la note')).toHaveValue('Brouillon récupérable')
})
