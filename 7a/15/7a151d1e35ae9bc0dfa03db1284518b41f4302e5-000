// C210a — Modèle de nœud unifié (Phase 1 OS). Le TYPE est DÉRIVÉ du chemin : jamais stocké en double,
// donc jamais de désynchronisation. L'identité d'un nœud = son chemin de base (id === dir), comme dans un Finder.
// Suffixes du plus spécifique au moins spécifique.
const LEAF_EXT_RE = /\.(db|media|img|canvas|ref|embed|file|plan|zmedia|comment)\.json$/

export function typeOfPath(path) {
  if (typeof path !== 'string') return 'folder'
  if (path.endsWith('.db.json')) return 'db'
  if (path.endsWith('.media.json')) return 'media'
  if (path.endsWith('.img.json')) return 'image'
  if (path.endsWith('.canvas.json')) return 'canvas'
  // .ref.json (ZenRay Ref, 2026-07-19) : ALIAS du type 'canvas' — même schéma de board, même viewer
  // (CanvasNodeViewer/RefBoard). Les nouveaux boards se créent en .ref.json ; les .canvas.json restent lus.
  if (path.endsWith('.ref.json')) return 'canvas'
  if (path.endsWith('.embed.json')) return 'embed'
  if (path.endsWith('.file.json')) return 'file' // archive universelle (zenray-productions-archive) : fichier brut/chunké
  // .plan.json (ZenRay Plan, 2026-07-20) : un calendrier complet (titre + liste de tâches), au même
  // niveau qu'un board Ref ou une table -- son propre type, son propre viewer (PlanBoard.jsx).
  if (path.endsWith('.plan.json')) return 'plan'
  // .zmedia.json (ZenRayMedia, 2026-07-25) : un document de studio média (brief + article + thème
  // + format). Son propre type et sa propre vue -- exactement comme .ref.json a la sienne. Le
  // nom n'est PAS `.media.json` : cette extension est déjà prise par les manifestes vidéo/audio,
  // et deux schémas différents derrière une même extension est la garantie d'un bug plus tard.
  if (path.endsWith('.zmedia.json')) return 'zmedia'
  if (path.endsWith('.comment.json')) return 'comment'
  if (path.endsWith('.md')) return 'page'
  return 'folder'
}

// Retire l'extension feuille pour obtenir l'identité du nœud (le "dir"). pages/x.db.json -> pages/x ; pages/x.md -> pages/x
export function stripLeafExt(path) {
  // 2026-09-11 Strip ONE leaf extension, never two. `notes.md.file.json` is an archived Markdown FILE
  // whose name is `notes.md`; stripping `.md` too made it lose its extension (Quick Look showed
  // « aperçu indisponible ») and fused its identity with a page `notes.md`. Only a bare page drops `.md`.
  // FR : une seule extension feuille retirée ; seul un vrai `.md` de page perd son `.md`.
  const stripped = path.replace(LEAF_EXT_RE, '')
  return stripped !== path ? stripped : path.replace(/\.md$/, '')
}

// Extension canonique d'une feuille, dérivée de la même table que typeOfPath/stripLeafExt.
// Aucun appelant ne doit recopier sa propre regex : c'est ainsi que .file.json avait été oublié.
export function leafExtension(path) {
  if (typeof path !== 'string') return ''
  const base = stripLeafExt(path)
  return base === path ? '' : path.slice(base.length)
}

// Drapeaux legacy dérivés du type (sur-ensemble : le code existant qui lit isDb/isMedia continue de marcher).
// Ajout Ref : isCanvas/isEmbed permettent au routeur d'ouverture (lot B) d'aiguiller un .canvas.json vers
// CanvasNodeViewer et un .embed.json vers EmbedNodeViewer, JAMAIS vers l'éditeur Markdown (plan §13 P0).
export function legacyFlags(type) {
  return { isDb: type === 'db', isMedia: type === 'media', isImage: type === 'image', isCanvas: type === 'canvas', isEmbed: type === 'embed', isComment: type === 'comment' }
}

// Une entrée Finder typée à partir d'un chemin feuille + son dossier parent.
export function nodeOf(prefix, seg, contentPath) {
  const type = contentPath ? typeOfPath(contentPath) : 'folder'
  return { name: seg, contentPath: contentPath || null, hasKids: false, dir: prefix + seg, type, ...legacyFlags(type) }
}
