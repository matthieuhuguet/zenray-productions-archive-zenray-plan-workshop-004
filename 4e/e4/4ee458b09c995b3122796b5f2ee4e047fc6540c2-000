import importlib.util, os, subprocess, sys, tempfile
from pathlib import Path
spec = importlib.util.spec_from_file_location('worker', '/Users/zenray/.claude/tmp/tmp-movies-series-upload/Scripts/ProcessFilmsSequentially.py')
w = importlib.util.module_from_spec(spec); spec.loader.exec_module(w)
tmp = Path(tempfile.mkdtemp())
w.LOG_FILE = tmp / 'log.txt'

# canonical_dest: the case of an existing folder wins, unknown folders are kept
clone = tmp / 'clone'
(clone / 'pages' / 'Anime_Movies_Series_Documentaries' / 'Series' / 'House Of The Dragon').mkdir(parents=True)
w.CLONE = clone
assert w.canonical_dest('pages/Anime_Movies_Series_Documentaries/Series/House of the Dragon') == 'pages/Anime_Movies_Series_Documentaries/Series/House Of The Dragon'
assert w.canonical_dest('pages/Anime_Movies_Series_Documentaries/Series/House Of The Dragon') == 'pages/Anime_Movies_Series_Documentaries/Series/House Of The Dragon'
assert w.canonical_dest('pages/Anime_Movies_Series_Documentaries/Series/Brand New Show') == 'pages/Anime_Movies_Series_Documentaries/Series/Brand New Show'
assert w.canonical_dest('pages/Anime_Movies_Series_Documentaries') == 'pages/Anime_Movies_Series_Documentaries'

# restore_tracked_changes on a real git repo, with a path that needs quoting
repo = tmp / 'repo'; repo.mkdir()
def git(*a): return subprocess.run(['git', '-C', str(repo), '-c', 'user.name=t', '-c', 'user.email=t@t', *a], capture_output=True, text=True, check=True)
git('init', '-q')
gone = repo / 'pages' / 'House Of The Dragon' / 'house.s03e07.1080p[EZTVx.to].mkv.media.json'
edited = repo / 'pages' / 'edited.media.json'
gone.parent.mkdir(parents=True); gone.write_text('{"a":1}'); edited.write_text('{"b":1}')
git('add', '-A'); git('commit', '-q', '-m', 'init')
gone.unlink(); edited.write_text('{"b":2}')
(repo / 'pages' / 'untracked.txt').write_text('keep me')
restored = w.restore_tracked_changes(repo)
assert sorted(restored) == sorted(['pages/House Of The Dragon/house.s03e07.1080p[EZTVx.to].mkv.media.json', 'pages/edited.media.json']), restored
assert gone.read_text() == '{"a":1}' and edited.read_text() == '{"b":1}'
assert (repo / 'pages' / 'untracked.txt').read_text() == 'keep me'
assert w.restore_tracked_changes(repo) == []
print('dest and restore tests OK')
