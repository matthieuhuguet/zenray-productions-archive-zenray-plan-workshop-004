// ═══ LE BOARD SE DIAGNOSTIQUE LUI-MÊME, PARCE QUE JE NE VOIS PAS L'ÉCRAN DE MATTHIEU ═════════════
//
// CE QUE CETTE SESSION A COÛTÉ, ET POURQUOI CE FICHIER EXISTE (2026-08-30). Trois heures à corriger
// un « board gris » à l'aveugle : chaque correctif partait d'une hypothèse, et chaque hypothèse
// demandait un aller-retour avec Matthieu pour être infirmée. La cause n'était pas la difficulté du
// bug, c'était l'ABSENCE DE SIGNAL. Un board qui échoue ne dit rien : il est gris, et un gris ne
// distingue pas un board vide d'un board cassé, deux états qui demandent des correctifs opposés.
//
// La bannière « sortir du prototype » l'écrit déjà : ne jamais livrer un chemin qui peut échouer
// sans le dire, un échec muet étant le seul défaut qui disqualifie vraiment un produit. Ce module
// applique cette règle au board.
//
// CE QU'IL FAIT. Après le montage, il mesure ce qui est RÉELLEMENT à l'écran et rend un verdict.
// Les quatre causes qu'il sépare ne se devinent pas l'une de l'autre :
//   A. le conteneur a une hauteur nulle          -> tldraw n'a pas de place où dessiner
//   B. tldraw n'a jamais monté son DOM           -> l'éditeur a échoué en amont
//   C. la barre d'outils est là mais invisible   -> conflit de thème ou de CSS
//   D. tout est sain et le board est simplement vide -> il n'y a rien à afficher, et c'est normal
//
// CE QU'IL NE FAIT PAS. Il ne corrige rien, il ne masque rien, il n'a aucun effet sur le rendu. Il
// observe et il nomme. Un diagnostic qui répare est un diagnostic auquel on ne peut plus se fier.

// LES SEUILS SONT DES PARAMÈTRES, JAMAIS DES LITTÉRAUX ÉPARPILLÉS (loi HDA). Les changer se fait
// ici, à un seul endroit, et se propage aux deux appelants.
export const SEUILS = {
  hauteurMinimale: 40,     // px sous lesquels un conteneur ne peut rien montrer d'utile
  opaciteMinimale: 0.05,   // en deçà, un élément présent dans le DOM est invisible à l'œil
  delaiMesure: 1500,       // ms après le montage : tldraw a fini de poser son DOM
}

// Mesure l'état réel du board. `racine` est l'élément qui contient l'éditeur.
// Rend `{ cause, sain, details }` — jamais d'exception, jamais d'accès réseau.
export function diagnostiquerBoard(racine, editeur) {
  const details = {}
  try {
    if (!racine) return { cause: 'B', sain: false, details: { raison: 'aucune racine' } }

    const boite = racine.getBoundingClientRect()
    details.racine = { l: Math.round(boite.width), h: Math.round(boite.height) }
    if (boite.height < SEUILS.hauteurMinimale || boite.width < SEUILS.hauteurMinimale) {
      return { cause: 'A', sain: false, details }
    }

    const toile = racine.querySelector('.tl-container')
    details.tldrawMonte = !!toile
    if (!toile) return { cause: 'B', sain: false, details }

    const bt = toile.getBoundingClientRect()
    details.tldraw = { l: Math.round(bt.width), h: Math.round(bt.height) }
    if (bt.height < SEUILS.hauteurMinimale) return { cause: 'A', sain: false, details }

    const barre = racine.querySelector('.zr-ref-toolbar')
    details.barrePresente = !!barre
    if (barre) {
      const s = getComputedStyle(barre)
      const bb = barre.getBoundingClientRect()
      details.barre = { l: Math.round(bb.width), h: Math.round(bb.height), opacite: s.opacity, visibilite: s.visibility, affichage: s.display }
      const invisible = Number(s.opacity) < SEUILS.opaciteMinimale || s.visibility === 'hidden' || s.display === 'none' || bb.height < SEUILS.hauteurMinimale
      if (invisible) return { cause: 'C', sain: false, details }
    } else {
      // La barre est notre composant : absente alors que tldraw est monté, c'est notre CSS qui manque.
      return { cause: 'C', sain: false, details }
    }

    // Tout est sain. Reste à dire si le board a du contenu, ce qui n'est PAS un défaut mais explique
    // à lui seul un canevas vide, et c'est précisément la confusion qui a coûté cette session.
    try { details.formes = editeur ? editeur.getCurrentPageShapes().length : null } catch { details.formes = null }
    try { details.modeCouleur = editeur ? editeur.getColorMode() : null } catch { details.modeCouleur = null }
    return { cause: 'D', sain: true, details }
  } catch (err) {
    return { cause: 'B', sain: false, details: { ...details, exception: String((err && err.message) || err) } }
  }
}

// Phrase lisible pour chaque cause. Elle s'adresse à Matthieu, pas à un développeur : elle dit ce
// qui se passe et ce que ça implique, sans jargon non expliqué.
export const PHRASES = {
  A: 'Le board n’a pas de place pour s’afficher : son conteneur mesure zéro. Le canevas existe, il n’a nulle part où dessiner.',
  B: 'L’éditeur de canevas n’a pas démarré. Rien n’a été dessiné, et l’erreur est en amont du board.',
  C: 'Le board est là mais ses outils sont invisibles : sa feuille de style ne s’est pas appliquée, ou le thème du canevas et celui de l’app divergent.',
  D: 'Le board fonctionne. S’il paraît vide, c’est qu’il ne contient rien à cet endroit de la vue.',
}
