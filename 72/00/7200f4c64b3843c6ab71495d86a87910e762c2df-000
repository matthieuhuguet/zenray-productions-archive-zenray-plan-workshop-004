import { describe, it, expect } from 'vitest'
import { pgPretty } from './pgPretty.js'

describe('pgPretty — un nom affiché doit être le nom réel', () => {
  it('LES TIRETS RESTENT : c’est le nom du dossier sur le drive', () => {
    // Demande de Matthieu, 2026-08-31. Un nom affiché qui diffère du nom réel ne peut pas être
    // recopié pour être cherché, et laisse croire qu'on a créé autre chose.
    expect(pgPretty('tmp-img-selection1')).toBe('tmp-img-selection1')
    expect(pgPretty('tmp-img-selection12')).toBe('tmp-img-selection12')
    expect(pgPretty('ToDo-3D')).toBe('ToDo-3D')
  })

  it('retire le suffixe technique de quatre caractères, et lui seul', () => {
    expect(pgPretty('Moodboard-a1b2')).toBe('Moodboard')
    expect(pgPretty('selection1-2cuc')).toBe('selection1')
    expect(pgPretty('Le Vent se Leve-r1r7')).toBe('Le Vent se Leve')
  })

  it('ne coupe pas un suffixe qui n’a pas exactement quatre caractères', () => {
    expect(pgPretty('Plan-B')).toBe('Plan-B')            // 1 caractère
    expect(pgPretty('Etape-12')).toBe('Etape-12')        // 2 caractères
    expect(pgPretty('Version-12345')).toBe('Version-12345') // 5 caractères
  })

  it('LIMITE CONNUE, à ne pas prendre pour un bug : un mot de quatre caractères base36 après un\n      tiret EST coupé. « Doc 2024 » avec un espace est protégé, « Doc-2024 » avec un tiret ne l’est\n      pas. C’est le comportement d’origine, et le suffixe technique s’écrit toujours avec un tiret.', () => {
    expect(pgPretty('Doc 2024')).toBe('Doc 2024')
    expect(pgPretty('Doc-2024')).toBe('Doc')
  })

  it('retire l’extension markdown', () => {
    expect(pgPretty('Notes.md')).toBe('Notes')
    expect(pgPretty('Notes-a1b2.md')).toBe('Notes')
  })

  it('un nom sans rien à retirer ressort intact', () => {
    expect(pgPretty('Photos')).toBe('Photos')
    expect(pgPretty('29 Aout 2026')).toBe('29 Aout 2026')
    expect(pgPretty('日本語')).toBe('日本語')
  })
})
