import { PALETTE, FONTS } from '../theme.js'
import { card, SectionLabel } from './lifeosShared.jsx'

// Extrait de App.jsx (batch refactor structurel 2026-07-16).
export function Sequence({ t, seq }) {
  if (!seq.length) return null
  const sorted = [...seq].sort((a, b) => (a.rank || 99) - (b.rank || 99))
  return (
    <>
      <SectionLabel t={t} color={t.textSecondary}>Séquence des cartes</SectionLabel>
      <div style={{ ...card(t) }}>
        {sorted.map((it, i) => (
          <div key={i} style={{ display: 'flex', gap: 14, padding: '11px 0', borderBottom: i < sorted.length - 1 ? `1px solid ${t.border}` : 'none' }}>
            <div style={{ flex: '0 0 30px', height: 30, borderRadius: 99, background: t.bg, border: `1px solid ${t.border}`, display: 'grid', placeItems: 'center', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)', color: PALETTE.primary, fontWeight: 700 }}>{it.rank}</div>
            <div>
              <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: PALETTE.primaryDark, textTransform: 'uppercase', letterSpacing: 1 }}>{it.domain}</div>
              <div><b>{it.title}</b> — <span style={{ color: t.textSecondary }}>{it.rationale}</span></div>
              {it.depends_on && <div style={{ fontSize: 'var(--zr-ui-sm)', color: t.textSecondary, fontStyle: 'italic' }}>dépend de : {it.depends_on}</div>}
            </div>
          </div>
        ))}
      </div>
    </>
  )
}
export function TwoCol({ t, blindSpots, cadence }) {
  return (
    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit,minmax(300px,1fr))', gap: 16 }}>
      {blindSpots.length > 0 && <div><SectionLabel t={t} color={t.textSecondary}>Angles morts</SectionLabel><div style={{ ...card(t) }}>{blindSpots.map((b, i) => <Dot key={i} t={t} text={b} last={i === blindSpots.length - 1} />)}</div></div>}
      {cadence.length > 0 && <div><SectionLabel t={t} color={t.textSecondary}>Semaine type</SectionLabel><div style={{ ...card(t) }}>{cadence.map((c, i) => <Dot key={i} t={t} text={c} last={i === cadence.length - 1} />)}</div></div>}
    </div>
  )
}
export function Dot({ t, text, last }) {
  return <div style={{ display: 'flex', gap: 10, padding: '8px 0', borderBottom: last ? 'none' : `1px solid ${t.border}` }}><span style={{ flex: '0 0 6px', width: 6, height: 6, borderRadius: 99, background: PALETTE.primary, marginTop: 8 }} /><span style={{ lineHeight: 1.5 }}>{text}</span></div>
}
