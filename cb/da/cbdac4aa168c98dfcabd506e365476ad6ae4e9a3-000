// 4 October 2026: the bar asks the local service for a search, follows it, and says plainly when the service is not there.
import React from 'react'
import { afterEach, beforeEach, expect, it, vi } from 'vitest'
import { act, cleanup, fireEvent, render, screen } from '@testing-library/react'

vi.mock('../Notifications.jsx', () => ({ notify: vi.fn() }))
import { notify } from '../Notifications.jsx'
import FreelanceEngineBar from './FreelanceEngineBar.jsx'

const t = { border: 'gray', surface: 'transparent', textPrimary: 'black', textSecondary: 'gray', bg: 'white' }
const engine = { lastRun: { finishedAt: new Date(Date.now() - 4 * 3600 * 1000).toISOString(), added: 3 }, nextRunDue: new Date(Date.now() + 2 * 3600 * 1000).toISOString() }
beforeEach(() => vi.useFakeTimers({ shouldAdvanceTime: true }))
afterEach(() => { cleanup(); vi.useRealTimers() })

it('states the last search and the next one', async () => {
  const bridge = { status: vi.fn().mockResolvedValue({ running: null, lastOk: true }), run: vi.fn() }
  render(<FreelanceEngineBar t={t} engine={engine} bridge={bridge} onFinished={() => {}} />)
  expect(await screen.findByRole('status')).toHaveTextContent('dernière recherche il y a 4 h · 3 nouvelles annonces · prochaine dans 2 h')
  expect(screen.getByRole('button', { name: 'Rechercher maintenant' })).toBeEnabled()
})

it('starts a search, follows its stage, then reloads the data once it is over', async () => {
  const onFinished = vi.fn()
  const statuses = [
    { running: null, lastOk: true },
    { running: { stage: 'collecte', startedAt: 'x' }, lastOk: true },
    { running: null, lastOk: true, lastReport: { added: 2, letters: 1 } },
  ]
  const bridge = { status: vi.fn(async () => statuses.length > 1 ? statuses.shift() : statuses[0]), run: vi.fn().mockResolvedValue({ started: true, running: { stage: 'démarrage', startedAt: 'x' } }) }
  render(<FreelanceEngineBar t={t} engine={engine} bridge={bridge} onFinished={onFinished} />)
  await screen.findByRole('status')
  await act(async () => { fireEvent.click(screen.getByRole('button', { name: 'Rechercher maintenant' })) })
  expect(bridge.run).toHaveBeenCalledTimes(1)
  expect(screen.getByRole('button', { name: /Recherche en cours/ })).toBeDisabled()
  await act(async () => { await vi.advanceTimersByTimeAsync(2100) })
  await act(async () => { await vi.advanceTimersByTimeAsync(2100) })
  expect(onFinished).toHaveBeenCalledTimes(1)
  expect(notify).toHaveBeenCalledWith(expect.objectContaining({ title: 'Recherche terminée', body: '2 nouvelles annonces, 1 lettre préparée.' }))
  expect(screen.getByRole('button', { name: 'Rechercher maintenant' })).toBeEnabled()
})

it('says the service is missing instead of failing silently, and keeps the last known date', async () => {
  const bridge = { status: vi.fn().mockRejectedValue(new Error('down')), run: vi.fn() }
  render(<FreelanceEngineBar t={t} engine={engine} bridge={bridge} onFinished={() => {}} />)
  expect(await screen.findByRole('alert')).toHaveTextContent('ne tourne que Mac allumé')
  expect(screen.getByRole('alert')).toHaveTextContent('il y a 4 h')
  expect(screen.getByRole('button', { name: 'Rechercher maintenant' })).toBeDisabled()
})

it('shows a failed last run with its reason', async () => {
  const bridge = { status: vi.fn().mockResolvedValue({ running: null, lastOk: false, lastError: 'network down', nextRunDue: new Date(Date.now() + 30 * 60000).toISOString() }), run: vi.fn() }
  render(<FreelanceEngineBar t={t} engine={engine} bridge={bridge} onFinished={() => {}} />)
  expect(await screen.findByRole('alert')).toHaveTextContent('network down')
})
