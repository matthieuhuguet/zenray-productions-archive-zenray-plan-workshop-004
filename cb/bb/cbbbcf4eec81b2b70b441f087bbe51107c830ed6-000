import { describe, it, expect } from 'vitest'
import { mediaSourceSegments } from './mediaProvenance.js'

describe('un lien Eagle ne ment pas sur la provenance', () => {
  it('rend AUCUN segment plutôt qu’un faux « proxy privé »', () => {
    // Sans ce cas, le lien entrait dans le bloc image (son chemin finit par .img.json), n'y trouvait
    // pas `vis: 'public'` et virait à l'orange — donnant à croire à une régression de transport qui
    // n'existe pas : les octets passent toujours par jsDelivr.
    const lien = { v: 1, type: 'zenray-eagle-link/v1', resourceId: 'zr_abc', title: 'IMG_5522.jpeg' }
    expect(mediaSourceSegments(lien, 'image')).toEqual([])
  })

  it('le manifeste CANONIQUE, lui, garde sa vraie couleur', () => {
    const canon = { type: 'image', vis: 'public', iv: 'x', cdnChunks: ['a'] }
    const seg = mediaSourceSegments(canon, 'image')
    expect(seg).toHaveLength(1)
    expect(seg[0].label).toContain('jsDelivr')
  })
})
