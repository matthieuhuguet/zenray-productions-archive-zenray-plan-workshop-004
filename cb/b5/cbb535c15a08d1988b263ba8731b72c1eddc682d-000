// 3 October 2026, 13:08 : Campaigns: comment-to-DM automations, broadcasts and follow-up sequences, plus one-call playbooks. They run on
// PostKit's scheduler, so they keep going when this page is closed. The audience is previewed before any send. (3 October 2026)
import React, { useState } from 'react'
import { useAction, useQuery } from './usePostKit.js'
import { qs } from './postkitClient.js'
import { Badge, Btn, Card, Empty, ErrorLine, Field, PlatformDot, StatusBadge } from './ui.jsx'

const messagingAccounts = (accounts) => accounts.filter((a) => a.status === 'CONNECTED' && a.capabilities?.messaging)

function Automations({ client, accounts, reload }) {
  const list = useQuery(client, '/v1/comment-automations')
  const eligible = accounts.filter((a) => a.status === 'CONNECTED' && a.capabilities?.privateReply)
  const [f, setF] = useState({ accountId: eligible[0]?.id || '', name: '', keywords: '', dmText: '', btnLabel: '', btnUrl: '', publicReply: '' })
  const act = useAction(async () => { await list.reload(); await reload() })
  const set = (k) => (e) => setF({ ...f, [k]: e.target.value })
  return (
    <Card title="Comment to DM">
      <ErrorLine error={list.error} />
      {list.data?.automations?.length ? <ul className="zr-pk-list">{list.data.automations.map((a) => (
        <li key={a.id} className="zr-pk-li"><div className="zr-pk-row"><PlatformDot platform={a.platform} label={a.name} /><StatusBadge status={a.status} /><span className="zr-pk-meta">{a.keywords.join(', ') || 'any comment'} · sent {a.counters.sent} · skipped {a.counters.skipped} · failed {a.counters.failed}</span><span className="zr-pk-spacer" />
          <Btn busy={act.busy} onClick={() => act.run(() => client.patch(`/v1/comment-automations/${a.id}`, { status: a.status === 'active' ? 'paused' : 'active' }))}>{a.status === 'active' ? 'Pause' : 'Resume'}</Btn>
          <Btn tone="danger" busy={act.busy} onClick={() => act.run(() => client.del(`/v1/comment-automations/${a.id}`))}>Delete</Btn></div></li>))}</ul> : <Empty>No automation.</Empty>}
      {eligible.length > 0 && <details className="zr-pk-details"><summary>New automation</summary>
        <div className="zr-pk-grid3"><Field label="Account"><select value={f.accountId} onChange={set('accountId')}>{eligible.map((a) => <option key={a.id} value={a.id}>{a.platform} @{a.username}</option>)}</select></Field><Field label="Name"><input value={f.name} onChange={set('name')} /></Field><Field label="Keywords, comma separated"><input value={f.keywords} onChange={set('keywords')} /></Field></div>
        <Field label="Message sent privately" hint="Meta allows one private reply per comment, within 7 days."><textarea rows={2} value={f.dmText} onChange={set('dmText')} /></Field>
        <div className="zr-pk-grid3"><Field label="Button label"><input value={f.btnLabel} onChange={set('btnLabel')} /></Field><Field label="Button URL (https)"><input value={f.btnUrl} onChange={set('btnUrl')} /></Field><Field label="Public reply (optional)"><input value={f.publicReply} onChange={set('publicReply')} /></Field></div>
        <Btn tone="primary" busy={act.busy} onClick={() => act.run(() => client.post('/v1/comment-automations', { accountId: f.accountId, name: f.name, keywords: f.keywords.split(',').map((s) => s.trim()).filter(Boolean), dmText: f.dmText, dmButtonLabel: f.btnLabel || undefined, dmButtonUrl: f.btnUrl || undefined, publicReplyText: f.publicReply || undefined }))}>Create</Btn><ErrorLine error={act.error} /></details>}
    </Card>
  )
}

function Broadcasts({ client, accounts, reload }) {
  const list = useQuery(client, '/v1/broadcasts')
  const eligible = messagingAccounts(accounts).filter((a) => a.platform !== 'x')
  const [f, setF] = useState({ accountId: eligible[0]?.id || '', name: '', text: '', days: '1' })
  const [count, setCount] = useState(null)
  const act = useAction(async () => { await list.reload(); await reload() })
  const set = (k) => (e) => setF({ ...f, [k]: e.target.value })
  return (
    <Card title="Broadcasts">
      <ErrorLine error={list.error} />
      {list.data?.broadcasts?.length ? <ul className="zr-pk-list">{list.data.broadcasts.map((b) => (
        <li key={b.id} className="zr-pk-li"><div className="zr-pk-row"><PlatformDot platform={b.platform} label={b.name} /><StatusBadge status={b.status} /><span className="zr-pk-meta">{b.counts.sent}/{b.counts.total} sent · {b.counts.failed} failed</span><span className="zr-pk-spacer" />
          {['draft', 'scheduled'].includes(b.status) && <Btn tone="primary" busy={act.busy} onClick={() => confirm(`Send "${b.name}" now? Immediate and irreversible for every recipient.`) && act.run(() => client.post(`/v1/broadcasts/${b.id}/send`))}>Send</Btn>}
          {b.status === 'scheduled' && <Btn busy={act.busy} onClick={() => act.run(() => client.post(`/v1/broadcasts/${b.id}/cancel`))}>Back to draft</Btn>}
          <Btn tone="danger" busy={act.busy} disabled={b.status === 'sending'} onClick={() => act.run(() => client.del(`/v1/broadcasts/${b.id}`))}>Delete</Btn></div><p className="zr-pk-meta">{b.text}</p></li>))}</ul> : <Empty>No broadcast.</Empty>}
      {eligible.length > 0 && <details className="zr-pk-details"><summary>New broadcast</summary>
        <div className="zr-pk-grid3"><Field label="Account"><select value={f.accountId} onChange={set('accountId')}>{eligible.map((a) => <option key={a.id} value={a.id}>{a.platform} @{a.username}</option>)}</select></Field><Field label="Name"><input value={f.name} onChange={set('name')} /></Field><Field label="Active within (days)" hint="1 = the slice that can actually be delivered."><input inputMode="numeric" value={f.days} onChange={set('days')} /></Field></div>
        <Field label="Message"><textarea rows={3} value={f.text} onChange={set('text')} /></Field>
        <div className="zr-pk-inline"><Btn busy={act.busy} onClick={() => act.run(async () => setCount((await client.get(`/v1/broadcasts/audience${qs({ accountId: f.accountId, activeWithinDays: f.days })}`)).count))}>Preview audience</Btn>{count !== null && <Badge tone="info">{count} recipient(s)</Badge>}<Btn tone="primary" busy={act.busy} onClick={() => act.run(() => client.post('/v1/broadcasts', { accountId: f.accountId, name: f.name, text: f.text, audience: { activeWithinDays: Number(f.days) } }))}>Save as draft</Btn></div><ErrorLine error={act.error} /></details>}
    </Card>
  )
}

function Sequences({ client }) {
  const list = useQuery(client, '/v1/sequences')
  return (
    <Card title="Sequences">
      <ErrorLine error={list.error} />
      {list.data?.sequences?.length ? <ul className="zr-pk-list">{list.data.sequences.map((s) => <li key={s.id} className="zr-pk-li"><div className="zr-pk-row"><PlatformDot platform={s.platform} label={s.name} /><StatusBadge status={s.status} /><Badge tone="muted">{s.trigger.replace('_', ' ')}</Badge><span className="zr-pk-meta">{s.steps.length} step(s){s.stopOnReply ? ' · stops when they reply' : ''}</span></div></li>)}</ul> : <Empty>No sequence. Install a playbook to create one.</Empty>}
    </Card>
  )
}

function Playbooks({ client, accounts, reload }) {
  const list = useQuery(client, '/v1/playbooks')
  const installs = useQuery(client, '/v1/playbooks/installs')
  const [accountId, setAccountId] = useState('')
  const eligible = messagingAccounts(accounts)
  const act = useAction(async () => { await installs.reload(); await reload() })
  return (
    <Card title="Playbooks" aside={<select value={accountId || eligible[0]?.id || ''} onChange={(e) => setAccountId(e.target.value)} aria-label="Account for the playbook">{eligible.map((a) => <option key={a.id} value={a.id}>{a.platform} @{a.username}</option>)}</select>}>
      <ul className="zr-pk-list">{(list.data?.playbooks || []).map((p) => { const inst = installs.data?.installs?.find((i) => i.slug === p.slug); return (
        <li key={p.slug} className="zr-pk-li"><div className="zr-pk-row"><strong>{p.name}</strong>{inst && <Badge tone="ok">installed</Badge>}<span className="zr-pk-spacer" />
          {inst ? <Btn tone="danger" busy={act.busy} onClick={() => act.run(() => client.del(`/v1/playbooks/installs/${inst.id}`))}>Remove</Btn> : <Btn busy={act.busy} disabled={!eligible.length} onClick={() => confirm(`Install "${p.name}" now? It goes live at once: real people get real messages.`) && act.run(() => client.post(`/v1/playbooks/${p.slug}/install`, { accounts: { account: accountId || eligible[0]?.id } }))}>Install</Btn>}</div><p className="zr-pk-meta">{p.description}</p></li>) })}</ul>
      <ErrorLine error={act.error || list.error} />
    </Card>
  )
}

export default function CampaignsPanel({ client, overview, reload }) {
  const accounts = overview.data.accounts
  return (<><Playbooks client={client} accounts={accounts} reload={reload} /><Automations client={client} accounts={accounts} reload={reload} /><Broadcasts client={client} accounts={accounts} reload={reload} /><Sequences client={client} /></>)
}
