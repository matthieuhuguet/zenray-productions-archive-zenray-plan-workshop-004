import { describe, expect, it, vi } from 'vitest'
import { fetchGithubResilient, STATUTS_PASSAGERS } from './github-retry.js'

const rep = (status) => ({ ok: status >= 200 && status < 300, status })
const sansAttente = { attente: () => 0 }

describe('fetchGithubResilient', () => {
  it('rend la reponse du premier coup quand elle reussit', async () => {
    const appel = vi.fn(async () => rep(201))
    const r = await fetchGithubResilient(appel, sansAttente)
    expect(r.status).toBe(201)
    expect(appel).toHaveBeenCalledTimes(1)
  })

  it('reessaie un 409 et rend la reussite suivante', async () => {
    let n = 0
    const appel = vi.fn(async () => (++n < 3 ? rep(409) : rep(201)))
    const r = await fetchGithubResilient(appel, sansAttente)
    expect(r.status).toBe(201)
    expect(appel).toHaveBeenCalledTimes(3)
  })

  it('reessaie chaque statut declare passager', async () => {
    for (const s of STATUTS_PASSAGERS) {
      const appel = vi.fn(async () => (appel.mock.calls.length < 2 ? rep(s) : rep(201)))
      const r = await fetchGithubResilient(appel, sansAttente)
      expect(r.status, `statut ${s}`).toBe(201)
      expect(appel.mock.calls.length, `statut ${s}`).toBe(2)
    }
  })

  it('NE reessaie PAS une erreur definitive', async () => {
    for (const s of [401, 403, 404, 413, 422]) {
      const appel = vi.fn(async () => rep(s))
      const r = await fetchGithubResilient(appel, sansAttente)
      expect(r.status).toBe(s)
      expect(appel, `statut ${s}`).toHaveBeenCalledTimes(1)
    }
  })

  it('reessaie une coupure reseau, qui leve au lieu de rendre une reponse', async () => {
    let n = 0
    const appel = vi.fn(async () => { if (++n < 3) throw new Error('ECONNRESET'); return rep(201) })
    const r = await fetchGithubResilient(appel, sansAttente)
    expect(r.status).toBe(201)
    expect(appel).toHaveBeenCalledTimes(3)
  })

  it('rend la derniere reponse quand toutes les tentatives echouent', async () => {
    const appel = vi.fn(async () => rep(503))
    const r = await fetchGithubResilient(appel, { ...sansAttente, tentatives: 4 })
    expect(r.status).toBe(503)
    expect(appel).toHaveBeenCalledTimes(4)
  })

  it('leve quand toutes les tentatives ont coupe le reseau', async () => {
    const appel = vi.fn(async () => { throw new Error('ECONNRESET') })
    await expect(fetchGithubResilient(appel, { ...sansAttente, tentatives: 2 })).rejects.toThrow('ECONNRESET')
    expect(appel).toHaveBeenCalledTimes(2)
  })
})
