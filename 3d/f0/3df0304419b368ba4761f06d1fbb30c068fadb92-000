// VerifyStreamingCloud.mjs (14 October 2026): proof of a STREAMED film (policy: streaming only), writes a streaming-v1 receipt.
//   node scripts/VerifyStreamingCloud.mjs <manifest> <source> <receipt> [--manifest-clone <dir>]
// Exit code 1 and no receipt when any check is red. FR : preuve d'un film streame, ecrit un recu streaming-v1 ; code 1 si un controle est rouge.
import fs from 'node:fs'
import path from 'node:path'
import { execFileSync } from 'node:child_process'
import { verifyStreaming } from './lib/streaming-proof.mjs'
import { probeSource } from './lib/fmp4-single.mjs'

const argv = process.argv.slice(2)
const flagIndex = argv.indexOf('--manifest-clone')
const clone = path.resolve(flagIndex >= 0 ? argv[flagIndex + 1] : (process.env.ZR_ZDATA_CLONE || '/Users/zenray/.claude/tmp/tmp-movies-series-upload/ManifestClone'))
const positional = argv.filter((a, i) => !a.startsWith('--') && !(flagIndex >= 0 && i === flagIndex + 1))
const [manifestPath, source, receiptPath] = positional
if (!manifestPath || !source || !receiptPath) throw new Error('Usage: VerifyStreamingCloud.mjs <manifest> <source> <receipt> [--manifest-clone <dir>]')
const token = execFileSync('gh', ['auth', 'token'], { encoding: 'utf8' }).trim()
const result = await verifyStreaming({ manifestPath: path.resolve(manifestPath), manifestClone: clone, source: path.resolve(source), probe: probeSource(path.resolve(source)), token })
for (const c of result.checks) console.error(`${c.ok ? 'OK ' : 'RED'} ${c.name}${c.detail ? ` : ${c.detail}` : ''}`)
if (!result.ok) { console.log(JSON.stringify({ ok: false, failed: result.checks.filter((c) => !c.ok).map((c) => c.name) })); process.exit(1) }
fs.mkdirSync(path.dirname(path.resolve(receiptPath)), { recursive: true })
fs.writeFileSync(path.resolve(receiptPath), JSON.stringify(result.receipt, null, 2) + '\n')
console.log(JSON.stringify({ ok: true, verificationMode: result.receipt.verificationMode, files: result.receipt.files, bytes: result.receipt.cmafBytes }))
