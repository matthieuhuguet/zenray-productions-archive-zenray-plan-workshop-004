// ═══ DEUX IMAGES COTE A COTE, COMME DANS NOTION ══════════════════════════════════════════════
//
// Demande de Matthieu, le 2026-08-28 : « je veux pouvoir drag and drop deux images cote a cote
// comme sur notion, voir deux entites de texte, mais fait que les images pour l'instant ».
//
// POURQUOI UN BLOC MAISON PLUTOT QUE LES COLONNES DE BLOCKNOTE. Le paquet officiel qui apporte les
// colonnes multiples est `@blocknote/xl-multi-column`, et les paquets `xl-` de BlockNote sont sous
// licence AGPL ou licence commerciale. Ajouter une dependance AGPL a un produit engage la licence
// du produit entier : c'est une decision qui appartient a Matthieu, pas une dependance qu'on
// installe en passant pour livrer une fonctionnalite. Le bloc ci-dessous ne depend de rien, ne
// couvre que le cas demande (deux images), et laisse la porte ouverte le jour ou il tranchera.
//
// LA LARGEUR SE PARTAGE PAR UNE FRACTION, pas par deux tailles. `gauchePart` vaut 0,5 par defaut et
// la droite prend le reste : une seule valeur a bouger, et les deux colonnes restent toujours
// complementaires. C'est la loi HDA appliquee a une mise en page.
import React, { useCallback, useRef, useState } from 'react'

export const IMAGE_ROW_TYPE = 'zenrayImageRow'
export const PART_MIN = 0.2
export const PART_MAX = 0.8
export const PART_DEFAUT = 0.5

export const bornerPart = (v) => Math.min(PART_MAX, Math.max(PART_MIN, Number.isFinite(v) ? v : PART_DEFAUT))

export default function ImageRowBlock({ block, editor, theme }) {
  const p = (block && block.props) || {}
  const part = bornerPart(Number(p.gauchePart))
  const sombre = theme === 'dark'
  const cadre = useRef(null)
  const [glisse, setGlisse] = useState(false)
  const [cible, setCible] = useState(null) // 'gauche' | 'droite' pendant un survol de fichier

  const majPart = useCallback((v) => {
    if (!editor) return
    try { editor.updateBlock(block, { props: { ...p, gauchePart: String(bornerPart(v)) } }) } catch {}
  }, [editor, block, p])

  // La poignee centrale : on ne stocke pas deux largeurs, on deplace la frontiere.
  const prendrePoignee = (e) => {
    e.preventDefault(); e.stopPropagation()
    const boite = cadre.current && cadre.current.getBoundingClientRect()
    if (!boite || !boite.width) return
    setGlisse(true)
    const bouger = (ev) => majPart((ev.clientX - boite.left) / boite.width)
    const lacher = () => { setGlisse(false); window.removeEventListener('mousemove', bouger); window.removeEventListener('mouseup', lacher) }
    window.addEventListener('mousemove', bouger)
    window.addEventListener('mouseup', lacher)
  }

  const cellule = (cote) => {
    const url = cote === 'gauche' ? p.gauche : p.droite
    const legende = cote === 'gauche' ? p.legendeGauche : p.legendeDroite
    const survol = cible === cote
    return (
      <figure
        data-cote={cote}
        onDragOver={(e) => { e.preventDefault(); setCible(cote) }}
        onDragLeave={() => setCible((c) => (c === cote ? null : c))}
        style={{
          margin: 0, minWidth: 0, position: 'relative', borderRadius: 8, overflow: 'hidden',
          outline: survol ? '2px solid rgba(10,132,255,0.85)' : 'none', outlineOffset: 2,
          transition: 'outline-color .15s ease',
        }}
      >
        {url
          ? <img src={url} alt={legende || ''} draggable={false} style={{ width: '100%', height: 'auto', display: 'block', borderRadius: 8 }} />
          : <div style={{ aspectRatio: '4 / 3', display: 'grid', placeItems: 'center', borderRadius: 8, background: sombre ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.04)', color: sombre ? 'rgba(255,255,255,0.45)' : 'rgba(0,0,0,0.4)', fontSize: 13 }}>Dépose une image</div>}
        {legende ? <figcaption style={{ marginTop: 6, fontSize: 12, opacity: 0.6, textAlign: 'center' }}>{legende}</figcaption> : null}
      </figure>
    )
  }

  return (
    <div
      ref={cadre}
      className="zr-image-row"
      onDragLeave={() => setCible(null)}
      onDrop={() => setCible(null)}
      style={{
        display: 'grid',
        gridTemplateColumns: `${part}fr 10px ${1 - part}fr`,
        alignItems: 'start',
        width: '100%',
        margin: '6px 0',
      }}
    >
      {cellule('gauche')}
      {/* La poignee reste invisible tant qu'on ne la survole pas : une interface ne montre pas ses
          outils avant qu'on en ait besoin, mais elle les rend trouvables des que la main approche. */}
      <div
        onMouseDown={prendrePoignee}
        title="Glisser pour répartir"
        style={{
          alignSelf: 'stretch', cursor: 'col-resize', display: 'grid', placeItems: 'center',
          opacity: glisse ? 1 : 0, transition: 'opacity .18s ease',
        }}
        onMouseEnter={(e) => { e.currentTarget.style.opacity = 1 }}
        onMouseLeave={(e) => { if (!glisse) e.currentTarget.style.opacity = 0 }}
      >
        <span style={{ width: 3, height: 34, borderRadius: 99, background: sombre ? 'rgba(255,255,255,0.4)' : 'rgba(0,0,0,0.28)' }} />
      </div>
      {cellule('droite')}
    </div>
  )
}
