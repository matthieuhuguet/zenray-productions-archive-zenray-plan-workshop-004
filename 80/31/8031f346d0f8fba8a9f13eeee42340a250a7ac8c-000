// Backbone de vues PARTAGÉ (carte C1). Réutilisé par toutes les vues du site (App.jsx + Gallery.jsx + ...).
// Un seul switcher (List / Gallery / Page) + un seul rendu générique. items: { id, title, subtitle, image, color, href, external, badge, onOpen }
const FONTS = { serif: "var(--zr-police-serif)", sans: "var(--zr-police-sans)" }

// Icônes SF Symbols du sélecteur (même set que le reste).
export const VIEW_ICONS = {
  list: <Icon name="list.bullet" size={14} weight={1.6} />,
  icons: <Icon name="square.grid.2x2" size={14} weight={1.6} />,
  gallery: <Icon name="photo" size={14} weight={1.5} />,
  page: <Icon name="doc.text" size={14} weight={1.5} />,
}

export function ViewSwitch({ t, view, onChange, options = ['list', 'gallery'] }) {
  const labels = { list: 'List', icons: 'Icons', gallery: 'Gallery', page: 'Page' }
  return (
    <div style={{ display: 'inline-flex', gap: 2, border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: 2, background: t.surface }}>
      {options.map((o) => {
        const on = view === o
        return (
          <button key={o} onClick={() => onChange(o)} title={labels[o] || o}
            style={{ display: 'inline-flex', alignItems: 'center', gap: 4, padding: '3px 8px', borderRadius: 5, border: 'none', cursor: 'pointer',
              background: on ? PALETTE.primarySoft : 'transparent', color: on ? PALETTE.primary : t.textSecondary,
              fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', fontWeight: on ? 600 : 500, transition: TRANSITIONS.base }}>
            {VIEW_ICONS[o]}{labels[o] || o}
          </button>
        )
      })}
    </div>
  )
}

// DropMenu : menu déroulant générique (carte « Create immersif »). Un bouton déclencheur (trigger) ouvre un
// popover ancré dessous. Ferme au clic dehors, à Échap, ou après choix d'un item (sauf si keepOpen). Sert au
// sélecteur de vue (List/Icons/Gallery) et au filtre par type, en remplacement des barres segmentées.
export function DropMenu({ t, trigger, children, align = 'left', width = 200, title }) {
  const [anchor, setAnchor] = React.useState(null)
  const menuId = React.useId().replace(/:/g, '')
  const close = React.useCallback(() => setAnchor(null), [])
  return (
    <div style={{ position: 'relative', display: 'inline-flex' }}>
      <button data-zr-dropmenu-id={menuId} onClick={(event) => {
        if (anchor) { close(); return }
        const rect = event.currentTarget.getBoundingClientRect()
        const left = align === 'right' ? rect.right - width : rect.left
        setAnchor({ left, top: rect.bottom + 6, triggerTop: rect.top })
      }} title={title} className="zr-tap" aria-expanded={!!anchor}
        style={{ display: 'inline-flex', alignItems: 'center', gap: 5, padding: '5px 9px', borderRadius: RADII.sm, cursor: 'pointer',
          background: anchor ? PALETTE.primarySoft : 'transparent', color: anchor ? PALETTE.primary : t.textSecondary,
          border: `1px solid ${anchor ? PALETTE.primary + '55' : t.border}`, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', fontWeight: 500, transition: TRANSITIONS.base }}>
        {trigger}
        <Icon name="chevron.down" size={10} weight={2} />
      </button>
      {anchor && (
        <ColumnMenuShell
          t={t}
          anchor={anchor}
          onClose={close}
          ariaLabel={title || 'Actions'}
          columnWidth={width}
          maxHeight={360}
          triggerSelector={`[data-zr-dropmenu-id="${menuId}"]`}
          columns={(
            <ColumnMenuColumn t={t} width={width} index={0} label={title}>
              {typeof children === 'function' ? children(close) : children}
            </ColumnMenuColumn>
          )}
        />
      )}
    </div>
  )
}

// Une ligne d'item dans un DropMenu : icône + label + coche si actif.
export function DropItem({ t, icon, label, active, onClick, badge }) {
  return (
    <button onClick={onClick} className="zr-tap"
      style={{ display: 'flex', alignItems: 'center', gap: 9, width: '100%', textAlign: 'left', padding: '7px 9px', borderRadius: 7, cursor: 'pointer',
        background: active ? PALETTE.primarySoft : 'transparent', color: active ? PALETTE.primary : t.textPrimary,
        border: 'none', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-sm)', fontWeight: active ? 600 : 500, transition: TRANSITIONS.base }}
      onMouseEnter={(e) => { if (!active) e.currentTarget.style.background = t.cardBg || 'rgba(127,127,127,.12)' }}
      onMouseLeave={(e) => { if (!active) e.currentTarget.style.background = 'transparent' }}>
      {icon != null && <span style={{ display: 'inline-flex', width: 16, justifyContent: 'center', color: active ? PALETTE.primary : t.textSecondary }}>{icon}</span>}
      <span style={{ flex: 1 }}>{label}</span>
      {badge != null && <span style={{ fontSize: 'var(--zr-ui-xs)', color: t.textSecondary, fontVariantNumeric: 'tabular-nums' }}>{badge}</span>}
      {active && <Icon name="checkmark" size={12} weight={2.2} />}
    </button>
  )
}

// ViewMenu : sélecteur de vue (List/Icons/Gallery) en menu déroulant. Remplace ViewSwitch dans Create.
export function ViewMenu({ t, view, onChange, options = ['list', 'icons', 'gallery'] }) {
  const labels = { list: 'Liste', icons: 'Icônes', gallery: 'Galerie', page: 'Page' }
  return (
    <DropMenu t={t} title="Affichage" width={170} trigger={<>{VIEW_ICONS[view]}<span>{labels[view] || view}</span></>}>
      {(close) => options.map((o) => (
        <DropItem key={o} t={t} icon={VIEW_ICONS[o]} label={labels[o] || o} active={view === o} onClick={() => { onChange(o); close() }} />
      ))}
    </DropMenu>
  )
}

// Catégories du filtre par type (carte « trier par type »). Chaque entrée Create tombe dans UNE catégorie.
export const TYPE_CATS = [
  { key: 'folder', label: 'Dossiers', icon: <Icon name="folder" size={14} weight={1.6} /> },
  { key: 'page', label: 'Markdown', icon: <Icon name="doc.text" size={14} weight={1.5} /> },
  { key: 'image', label: 'Images', icon: <Icon name="photo" size={14} weight={1.5} /> },
  { key: 'media', label: 'Vidéos / médias', icon: <Icon name="film" size={14} weight={1.5} /> },
  { key: 'db', label: 'Tableaux', icon: <Icon name="tablecells" size={14} weight={1.5} /> },
]
// Classe une entrée Create dans sa catégorie de type (pour le filtre).
export function entryTypeCat(e) {
  if (!e) return 'page'
  if (!e.contentPath || e.hasKids) return 'folder'
  if (e.isDb || e.type === 'db') return 'db'
  if (e.isImage || e.type === 'image') return 'image'
  if (e.isMedia || e.type === 'media') return 'media'
  return 'page'
}
// TypeFilterMenu : multi-sélection des catégories à afficher. `value` = Set des clés actives (null/vide = tout).
export function TypeFilterMenu({ t, value, onChange, counts }) {
  const active = value && value.size > 0
  const toggle = (k) => { const next = new Set(value || []); next.has(k) ? next.delete(k) : next.add(k); onChange(next.size ? next : null) }
  return (
    <DropMenu t={t} title="Filtrer par type" width={210}
      trigger={<><Icon name="checklist" size={13} weight={1.8} /><span>{active ? `Type · ${value.size}` : 'Type'}</span></>}>
      {() => (
        <>
          <DropItem t={t} icon={<Icon name="square.grid.3x3" size={14} weight={1.6} />} label="Tout afficher" active={!active} onClick={() => onChange(null)} />
          <div style={{ height: 1, background: t.border, margin: '3px 4px' }} />
          {TYPE_CATS.map((c) => (
            <DropItem key={c.key} t={t} icon={c.icon} label={c.label} active={!!(value && value.has(c.key))} badge={counts ? (counts[c.key] || 0) : undefined} onClick={() => toggle(c.key)} />
          ))}
        </>
      )}
    </DropMenu>
  )
}

// Embed média : si l'url est une vidéo on rend <video>, sinon <img>. Inspiré du Finder (aperçu média dans la tuile).
export const isVideoUrl = (u) => typeof u === 'string' && /\.(mp4|webm|mov|m4v|ogv)(\?|$)/i.test(u)

// Vignette d'un nœud image .img.json : on lit le manifest (cache UNIQUE partagé avec le Finder via
// readImgManifestCached de ImageNodeViewer), puis on sert la dérivée .webp du shard privé. Une image
// déjà résolue par la grille du Finder n'est PAS re-fetchée ici (et vice-versa) : un seul cache, un seul trafic.
function ImgNodeThumbInline({ path, alt, style }) {
  const [m, setM] = React.useState(null)
  React.useEffect(() => {
    let live = true
    readImgManifestCached(path).then((x) => { if (live) setM(x) })
    return () => { live = false }
  }, [path])
  if (!m) return <div style={{ ...style, background: 'rgba(128,128,128,0.10)' }} />
  // Vignette OPTIMISÉE (LOT IMAGES) : SmartThumb = chargement paresseux priorisé (IntersectionObserver +
  // file de concurrence bornée) + cache LRU mémoire + apparition en fondu. Sur 1000-10000 images, le scroll
  // reste fluide et une image déjà vue réapparaît instantanément. B(1) : si la .webp manque, on affiche un
  // placeholder propre (noFullFallback), JAMAIS l'image pleine (zéro téléchargement du binaire en grille).
  return <SmartThumb url={shardThumbUrl(m)} fullUrl={shardImgUrl(m)} noFullFallback alt={alt || ''} width={(style && style.width) || '100%'} height={(style && style.height) || '100%'} radius={0} fit={(style && style.objectFit) || 'cover'} style={style} />
}

// url = URL directe (image/vidéo) ; imgPath = chemin d'un nœud .img.json à résoudre.
export function MediaThumb({ url, imgPath, alt, style }) {
  if (imgPath) return <ImgNodeThumbInline path={imgPath} alt={alt} style={style} />
  if (!url) return null
  // Branche vidéo : chemin latent (aucun call site ne passe d'URL vidéo directe aujourd'hui — les médias
  // passent par imgPath/nœuds). Durci par sécurité : preload="none" (aucun décodeur ni métadonnée chargés
  // tant que l'élément n'est pas joué) -> une grille de N items n'ouvre jamais N décodeurs.
  if (isVideoUrl(url)) return <video src={url} style={style} muted loop playsInline preload="none" />
  return <img src={url} alt={alt || ''} loading="lazy" style={style} />
}

export function DataView({ t, view, items, onOpen, selectedIds, onItemClick, onItemContext }) {
  const open = (p) => { if (p.href) return; if (p.onOpen) p.onOpen(p); else if (onOpen) onOpen(p) }
  // Sélection optionnelle (Finder) : si onItemClick est fourni, le clic SIMPLE sélectionne (ne pas ouvrir),
  // le double-clic ouvre. Sinon comportement historique (clic = ouvre). selectedIds = Set d'ids surlignés.
  const clickP = (p, ev) => { if (onItemClick) onItemClick(p, ev); else open(p) }
  const selOf = (p) => selectedIds && selectedIds.has && selectedIds.has(p.id)
  const selStyle = (p) => selOf(p) ? { background: 'rgba(10,132,255,0.18)', boxShadow: 'inset 0 0 0 2px rgba(10,132,255,0.7)' } : null
  if (view === 'list') {
    return (
      <div style={{ display: 'grid', gap: 2, marginTop: 14 }}>
        {items.map((p) => {
          const inner = (
            <>
              <div style={{ flex: '0 0 44px', width: 44, height: 30, borderRadius: RADII.sm, overflow: 'hidden', background: p.color || t.bg }}>
                <MediaThumb url={p.image} imgPath={p.imgPath} alt={p.title} style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block' }} />
              </div>
              <div style={{ minWidth: 0, flex: 1 }}>
                <div style={{ fontFamily: FONTS.serif, fontSize: 'var(--zr-ui-lg)', fontWeight: 500, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis', display: 'inline-flex', alignItems: 'center', gap: 5 }}>{p.title}{p.external && <Icon name="arrow.up.right" size={12} weight={1.7} color={t.textSecondary} />}</div>
                {p.subtitle && <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: t.textSecondary, textTransform: 'uppercase', letterSpacing: 0.5 }}>{p.subtitle}</div>}
              </div>
              {p.badge != null && <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: t.textSecondary }}>{p.badge}</span>}
            </>
          )
          const style = { display: 'flex', alignItems: 'center', gap: 12, width: '100%', textAlign: 'left', padding: '8px 10px', borderRadius: RADII.sm, textDecoration: 'none', color: 'inherit', background: 'transparent', border: 'none', cursor: 'pointer', ...selStyle(p) }
          return p.href
            ? <a key={p.id} href={p.href} target="_blank" rel="noreferrer" className="zr-treeitem" style={style}>{inner}</a>
            : <button key={p.id} data-zr-dir={p.id} onClick={(ev) => clickP(p, ev)} onDoubleClick={() => open(p)} onContextMenu={onItemContext ? (ev) => onItemContext(p, ev) : undefined} className="zr-treeitem" style={style}>{inner}</button>
        })}
      </div>
    )
  }
  if (view === 'page') {
    return (
      <div style={{ display: 'grid', gap: 20, marginTop: 14, maxWidth: 820, marginLeft: 'auto', marginRight: 'auto' }}>
        {items.map((p) => {
          const inner = (
            <>
              {(p.image || p.imgPath) && <div style={{ aspectRatio: '16/9', background: p.color || t.bg, overflow: 'hidden', borderTopLeftRadius: RADII.lg, borderTopRightRadius: RADII.lg }}>
                <MediaThumb url={p.image} imgPath={p.imgPath} alt={p.title} style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block' }} />
              </div>}
              <div style={{ padding: '18px 22px' }}>
                {p.subtitle && <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: PALETTE.primary, textTransform: 'uppercase', letterSpacing: 0.6, marginBottom: 6 }}>{p.subtitle}</div>}
                <div style={{ fontFamily: FONTS.serif, fontWeight: 700, fontSize: 22, lineHeight: 1.25, display: 'inline-flex', alignItems: 'center', gap: 7 }}>{p.title}{p.external && <Icon name="arrow.up.right" size={16} weight={1.7} color={t.textSecondary} />}</div>
                {p.badge != null && <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: t.textSecondary, marginTop: 6 }}>{p.badge}</div>}
              </div>
            </>
          )
          const style = { textAlign: 'left', textDecoration: 'none', color: 'inherit', background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: RADII.lg, overflow: 'hidden', boxShadow: SHADOWS.sm, display: 'block', cursor: 'pointer', padding: 0, transition: TRANSITIONS.base, width: '100%' }
          return p.href
            ? <a key={p.id} href={p.href} target="_blank" rel="noreferrer" style={style}>{inner}</a>
            : <button key={p.id} onClick={() => open(p)} style={style}>{inner}</button>
        })}
      </div>
    )
  }
  return (
    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill,minmax(240px,1fr))', gap: 14, marginTop: 14 }}>
      {items.map((p) => {
        const inner = (
          <>
            <div style={{ aspectRatio: '16/10', background: p.color || t.bg, overflow: 'hidden' }}>
              <MediaThumb url={p.image} imgPath={p.imgPath} alt={p.title} style={{ width: '100%', height: '100%', objectFit: 'cover', display: 'block' }} />
            </div>
            <div style={{ padding: '12px 14px' }}>
              {p.subtitle && <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: PALETTE.primary, textTransform: 'uppercase', letterSpacing: 0.5, marginBottom: 4 }}>{p.subtitle}</div>}
              <div style={{ fontFamily: FONTS.serif, fontWeight: 600, fontSize: 'var(--zr-ui-lg)', lineHeight: 1.3, display: 'inline-flex', alignItems: 'center', gap: 5 }}>{p.title}{p.external && <Icon name="arrow.up.right" size={12.5} weight={1.7} color={t.textSecondary} />}</div>
            </div>
          </>
        )
        const style = { textAlign: 'left', textDecoration: 'none', color: 'inherit', background: t.cardBg, border: `1px solid ${t.border}`, borderRadius: RADII.lg, overflow: 'hidden', boxShadow: SHADOWS.sm, display: 'block', cursor: 'pointer', padding: 0, transition: TRANSITIONS.base, ...selStyle(p) }
        return p.href
          ? <a key={p.id} href={p.href} target="_blank" rel="noreferrer" style={style}>{inner}</a>
          : <button key={p.id} data-zr-dir={p.id} onClick={(ev) => clickP(p, ev)} onDoubleClick={() => open(p)} onContextMenu={onItemContext ? (ev) => onItemContext(p, ev) : undefined} style={style}>{inner}</button>
      })}
    </div>
  )
}
