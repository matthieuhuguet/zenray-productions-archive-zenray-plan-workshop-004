export function matchesDatabaseFilter(row, filter) {
  const value = row?.cells?.[filter?.col]
  const text = (value == null ? '' : String(value)).toLowerCase()
  const expected = (filter?.val == null ? '' : String(filter.val)).toLowerCase()

  switch (filter?.op) {
    case 'contains': return text.includes(expected)
    case '=': return text === expected
    case '!=': return text !== expected
    case 'empty': return !text
    case '>': return parseFloat(value) > parseFloat(filter.val)
    case '<': return parseFloat(value) < parseFloat(filter.val)
    case 'true': return !!value
    case 'false': return !value
    default: return true
  }
}

export function filterOperationsForColumn(column, { categoricalContains = true } = {}) {
  const type = column?.type
  if (type === 'number') return [['>', '>'], ['<', '<'], ['=', '='], ['!=', '≠']]
  if (type === 'checkbox') return [['true', 'coché'], ['false', 'décoché']]
  if (type === 'select' || type === 'multi' || type === 'relation') {
    return categoricalContains
      ? [['contains', 'contient'], ['=', '='], ['!=', '≠'], ['empty', 'vide']]
      : [['=', '='], ['!=', '≠'], ['empty', 'vide']]
  }
  if (type === 'date') return [['=', '='], ['>', 'après'], ['<', 'avant'], ['empty', 'vide']]
  return [['contains', 'contient'], ['=', '='], ['!=', '≠'], ['empty', 'vide']]
}

export function selectDatabaseRows({ rows = [], columns = [], filters = [], sort = null } = {}) {
  let visible = filters.length
    ? rows.filter((row) => filters.every((filter) => matchesDatabaseFilter(row, filter)))
    : rows

  if (!sort) return visible
  const column = columns.find((candidate) => candidate.id === sort.col)
  if (!column) return visible

  visible = [...visible].sort((a, b) => {
    const left = a?.cells?.[sort.col] ?? ''
    const right = b?.cells?.[sort.col] ?? ''
    const comparison = column.type === 'number'
      ? (parseFloat(left) || 0) - (parseFloat(right) || 0)
      : String(left).localeCompare(String(right))
    return sort.dir === 'desc' ? -comparison : comparison
  })
  return visible
}

export function databaseColumnOptions(columns = [], columnId) {
  return columns.find((column) => column.id === columnId)?.options || []
}

export function parseDatabaseDate(value) {
  if (!value) return null
  const date = new Date(value)
  return Number.isNaN(date.getTime()) ? null : date
}

export function findDatabaseDateColumn(database, { infer = false } = {}) {
  const columns = database?.columns || []
  const rows = database?.rows || []
  const explicit = columns.find((column) => column.type === 'date')
  if (explicit) return explicit.id
  if (!infer) return null

  for (const column of columns) {
    const values = rows.map((row) => row?.cells?.[column.id]).filter(Boolean)
    if (values.length && values.filter((value) => parseDatabaseDate(value)).length >= values.length * 0.6) return column.id
  }
  return null
}
