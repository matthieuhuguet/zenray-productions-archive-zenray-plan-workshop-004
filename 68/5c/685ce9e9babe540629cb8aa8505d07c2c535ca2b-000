// 4 October 2026: AFJV, the French video game job board (vacancies published by the studios themselves).
// FR : l'AFJV, tableau d'annonces francais du jeu video, deposees par les studios.
import { ROLE_PATTERN, offerId } from '../lib/Offer.mjs'
import { mapLimited } from '../lib/Http.mjs'
import { clean, jobPosting } from '../lib/Text.mjs'

export const KEY = 'afjv'

/** Rows of the listing page: the page carries every active vacancy and hides the filtered ones with CSS. */
export function parseListing(html, baseUrl) {
  const rows = [...html.matchAll(/<section[^>]*data-ref=[^>]*>[\s\S]*?<\/section>/g)].map((match) => match[0])
  return rows.map((row) => {
    const field = (name) => clean((row.match(new RegExp(`class="${name}"[^>]*>([\\s\\S]*?)</`)) || [])[1] || '')
    const href = (row.match(/class="emp_pos" href="([^"]+)/) || [])[1]
    return { company: field('empt_soc'), companyUrl: (row.match(/class="empt_soc" href="([^"]+)/) || [])[1] || '', title: field('emp_pos'), contract: field('emp_cat'), location: field('emp_vil'), published: field('emp_dat'), trade: field('emp_met'), url: href ? baseUrl + href : '' }
  }).filter((row) => row.url && row.title)
}

export const isRelevant = (row) => row.trade === 'Conception' || ROLE_PATTERN.test(row.title)

export function parseDetail(row, body, baseUrl) {
  if (/offre.*(?:expirée|n.est plus disponible|pourvue)/i.test(clean(body))) return null
  const posting = jobPosting(body) || {}
  const start = body.indexOf('<h1')
  const stop = body.indexOf('id="nws_shr"', start)
  const text = stop > start ? body.slice(start, stop) : posting.description || body.slice(start)
  const address = posting.jobLocation?.address || {}
  const country = address.addressCountry || (row.location.includes('(BE)') ? 'BE' : /\(\d{2}\)/.test(row.location) && !row.location.includes('(00)') ? 'FR' : 'Non précisé')
  const slug = row.url.split('/').pop()
  return {
    sourceKey: KEY, sourceLabel: 'AFJV', evidence: 'AFJV, annonce déposée par le studio', name: row.company, title: row.title, url: row.url, applyUrl: `${baseUrl}/postuler/${slug}`,
    sourceId: row.url, location: row.location, country, contract: row.contract, workplace: row.location.includes('Télétravail') ? 'Télétravail' : 'Voir conditions de la fiche',
    published: posting.datePosted || row.published, text, careersUrl: row.companyUrl ? baseUrl + row.companyUrl : '', employerUrl: posting.hiringOrganization?.sameAs || posting.hiringOrganization?.url || '',
  }
}

export async function collect({ http, config }) {
  const settings = config.sources.afjv
  const html = await http.text(settings.listUrl)
  const rows = parseListing(html, settings.baseUrl)
  if (!rows.length) throw new Error('AFJV listing returned no vacancy row; refusing to treat the page as empty')
  const selected = rows.filter(isRelevant)
  const errors = []
  const results = await mapLimited(selected, config.http.workers, async (row) => parseDetail(row, await http.text(row.url), settings.baseUrl))
  const listings = []
  results.forEach((result, index) => {
    if (!result.ok) errors.push({ source: selected[index].url, error: result.error.message })
    else if (result.value) listings.push(result.value)
  })
  return [{ key: KEY, label: settings.label, listings, seenIds: selected.map((row) => offerId(row.url)), listed: rows.length, matched: listings.length, errors, complete: true }]
}
