// Prédicat "ce chemin est un noeud exposé au client" pour l'endpoint action=tree de server/page.js.
// Extrait dans un module dédié pour être testable directement (server/page.js n'exporte pas de fonctions
// unitaires — c'est un handler HTTP monolithique).
// Bug réel corrigé le 2026-07-20 : .plan.json (ZenRay Plan) manquait ici -- un nœud non reconnu par cette
// regex est INVISIBLE à action=tree, donc à tout ce qui en dérive (index de recherche, vue "Plan" de la
// sidebar, comptage de dossier). Le fichier existe bien sur GitHub (action=save ne filtre pas par
// extension) mais l'app entière ne le "voit" jamais -- exactement le piège que le commentaire de
// stripLeafExt (create/node.js) prévenait déjà pour .file.json.
// La liste FAIT FOI dans `server/extensionsNoeuds.js` : un test compare toutes les copies du dépôt
// à celle-ci et rougit dès qu'une diverge. Ajouter un type de nœud se fait là-bas, jamais ici.
import { MARQUEURS_DOSSIER, RE_NOEUD } from './extensionsNoeuds.js'

// 9 October 2026 08:05 CEST: Reuse the canonical matcher instead of keeping a second list.
export const NODE_RE = RE_NOEUD

// Marqueurs de dossier (fichiers cachés qui ne sont pas des noeuds mais dont l'existence prouve un dossier)
// qui doivent malgré tout apparaître dans `paths` :
// - .zrfolder.json (dossier vide, 2026-07-12)
// - .zrmusic.json (dossier "bibliothèque musicale", régression corrigée le 2026-07-16 : sans cette
//   exception, musicFolderFlag.js ne voyait jamais le marqueur qu'il venait pourtant d'écrire sur GitHub,
//   et le routage Music retombait silencieusement sur l'ancien chemin en dur pages/Music).
const FOLDER_MARKERS = MARQUEURS_DOSSIER

export function isExposedTreeNode(path) {
  if (path === 'pages/.zr-resources' || path.startsWith('pages/.zr-resources/')) return false
  return NODE_RE.test(path) || FOLDER_MARKERS.some((m) => path.endsWith('/' + m))
}
