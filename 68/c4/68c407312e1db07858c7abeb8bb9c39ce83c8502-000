# 14 October 2026: the category folder of a film is decided from the known-works table BEFORE the upload.
# FR : le dossier d'un film est decide depuis la table des oeuvres avant l'envoi.
import importlib.util, json, os, subprocess, sys, tempfile
from pathlib import Path
HERE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HERE))
import WorkCategories as wc

BASE = 'pages/Anime_Movies_Series_Documentaries'
cases = {
    'Bleach S17E41.mkv': f'{BASE}/Anime/Bleach/Saison 17',
    'Smoking Behind the Supermarket With You S01E01.mkv': f'{BASE}/Anime/Smoking Behind The Supermarket With You/Saison 01',
    'Peter Grill To Kenja No Jikan Season 02 - 04.mkv': f'{BASE}/Anime/Peter Grill To Kenja No Jikan/Saison 02',
    'House.of.the.Dragon.S03E08.2160p.HMAX.WEB-DL.mkv': f'{BASE}/Series/House Of The Dragon/Saison 03',
    'The Dark Knight (2008) 2160p HDR10.mkv': f'{BASE}/Movies',
    'The Dark Knight Rises (2012).mkv': f'{BASE}/Movies',
    'Black.Panther.Wakanda.Forever.mkv': f'{BASE}/Movies',
    'The.Revenant.PROPER.2015.Bluray.2160p.AV1.mkv': f'{BASE}/Movies',
    '1000 Men And Me The Bonnie Blue Story.mkv': f'{BASE}/Documentaries',
    'Le Sens De La Fête.mkv': f'{BASE}/Movies',
}
for name, expected in cases.items():
    got = wc.full_destination(name)
    assert got == expected, (name, got, expected)

# longest known work wins: "The Dark Knight Rises" is not "The Dark Knight", "Black Panther Wakanda Forever" is not "Black Panther"
assert wc.classify('The Dark Knight Rises (2012).mkv') == ('Movies', 'The Dark Knight Rises')
assert wc.classify('The Dark Knight (2008).mkv') == ('Movies', 'The Dark Knight')
assert wc.classify('Black Panther.mkv') == ('Movies', 'Black Panther')

# an unknown work is NOT guessed: the caller must ask (red case)
assert wc.classify('Some Brand New Anime S01E01.mkv') is None
assert wc.full_destination('Some Brand New Anime S01E01.mkv') is None
assert wc.classify('') is None

# the three works the table must not confuse with a longer title
assert wc.classify('The Dark Knight Rises Extra.mkv')[1] == 'The Dark Knight Rises'
print('categories tests OK')

# resolve_dest in the worker: table first, an explicit declaration inside <base>/<Category> is kept, legacy flat declarations are replaced
spec = importlib.util.spec_from_file_location('worker_categories', HERE / 'ProcessFilmsSequentially.py')
worker = importlib.util.module_from_spec(spec); spec.loader.exec_module(worker)
assert worker.resolve_dest('Bleach S17E41.mkv', 'pages/Anime_Movies_Series') == f'{BASE}/Anime/Bleach/Saison 17'
assert worker.resolve_dest('Bleach S17E41.mkv', 'pages/Anime_Movies_Series/Anime/Bleach/S17') == f'{BASE}/Anime/Bleach/Saison 17'
assert worker.resolve_dest('Bleach S17E41.mkv', f'{BASE}/Anime/Bleach/Saison 17') == f'{BASE}/Anime/Bleach/Saison 17'
assert worker.resolve_dest('Unknown Thing S01E01.mkv', 'pages/Anime_Movies_Series') is None
assert worker.resolve_dest('Unknown Thing S01E01.mkv') is None
print('worker resolve_dest tests OK')
