// 30 September 2026, 19:49 Europe/Paris: Verify source loading, visible failures and retry without caching errors.
import React from 'react'
import { afterEach, expect, it, vi } from 'vitest'
import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
import FreelanceOfferDetails from './FreelanceOfferDetails.jsx'

const theme = { border: 'gray', surface: 'transparent', textPrimary: 'black', textSecondary: 'gray' }
const source = { capturedAt: '30 September 2026', sourceUrl: 'https://example.org/job', sections: [{ heading: 'Missions', text: 'Créer des environnements procéduraux avec Houdini.' }] }
const success = () => ({ ok: true, json: async () => ({ markdown: JSON.stringify(source) }) })
afterEach(() => { cleanup(); vi.unstubAllGlobals() })

it('shows the archived description and source link using a read outside the GitHub quota', async () => {
  const fetch = vi.fn().mockResolvedValue(success())
  vi.stubGlobal('fetch', fetch)
  render(<FreelanceOfferDetails path="freelance/offers/test-source.json" t={theme} />)
  expect(await screen.findByText(source.sections[0].text)).toBeTruthy()
  expect(screen.getByRole('link', { name: /Voir la source/ }).href).toBe(source.sourceUrl)
  expect(fetch.mock.calls[0][0]).toContain('raw=1')
  cleanup()
  render(<FreelanceOfferDetails path="freelance/offers/test-source.json" t={theme} />)
  await screen.findByText('Missions')
  expect(fetch).toHaveBeenCalledTimes(1)
})

it('shows a transient failure and retries the request successfully', async () => {
  const fetch = vi.fn().mockResolvedValueOnce({ ok: false }).mockResolvedValueOnce(success())
  vi.stubGlobal('fetch', fetch)
  render(<FreelanceOfferDetails path="freelance/offers/retry-source.json" t={theme} />)
  expect(await screen.findByRole('alert')).toBeTruthy()
  fireEvent.click(screen.getByRole('button', { name: 'Réessayer' }))
  await screen.findByText('Missions')
  expect(fetch).toHaveBeenCalledTimes(2)
})

it('does not request a source for an old contact without an offer', async () => {
  const fetch = vi.fn()
  vi.stubGlobal('fetch', fetch)
  const view = render(<FreelanceOfferDetails path="" t={theme} />)
  await waitFor(() => expect(view.container.textContent).toBe(''))
  expect(fetch).not.toHaveBeenCalled()
})
