// posterFallback.js (15 October 2026): order of origins for a Shelf poster. Pure module, no React, no DOM.
//
// Measured on 15 October 2026: a cold jsDelivr commit sends the first byte after 14 to 88 s (or a 503), GitHub raw after
// 0.4 to 2 s, our own edge after under 0.1 s once warm. So a jsDelivr poster is asked to /api/shelf-poster FIRST (same
// bytes, read once on raw by the Worker, cached a year at the edge). If it stalls or fails the jsDelivr URL is the
// second origin. The browser never calls GitHub raw itself, so a shelf of 1000 works cannot spend a raw limit.
// FR : le poster jsDelivr passe d'abord par /api/shelf-poster (memes octets, cache d'edge) ; jsDelivr reste le secours.
import { parseShelfPosterUrl } from '../../server/shelf-poster-url.js'

export const POSTER_POLICY = Object.freeze({
  edgeFirstByteMs: 8000,   // a cold edge reads raw once (0.4 to 2 s measured, a 2 MB file included); beyond 8 s ask jsDelivr
  eagerCards: 16,          // the first cards load at once, without waiting for the visibility observer
})

export const edgePosterUrl = (url) => (parseShelfPosterUrl(url) ? `/api/shelf-poster?u=${encodeURIComponent(url)}` : null)

/** [first, second] origins; second is null when there is no alternative. / [premiere, seconde] origine. */
export function posterCandidates(url) {
  if (!url) return [null, null]
  const edge = edgePosterUrl(url)
  return edge ? [edge, url] : [url, null]
}
