import { useState } from 'react'
import { PALETTE, RADII, TRANSITIONS, FONTS } from '../theme.js'
import { fmtLong } from '../lib/dateHelpers.js'
import { btn, SectionLabel } from './lifeosShared.jsx'

// Panneau latéral façon Notion (détail d'une carte LifeOS). Extrait de App.jsx (batch refactor
// structurel 2026-07-16).
/* ───────── Notion-style right panel ───────── */
export default function CardPanel({ t, card, onClose, editCard, delCard, addImages, removeImage }) {
  const [over, setOver] = useState(false)
  const drop = (e) => { e.preventDefault(); setOver(false); if (e.dataTransfer.files && e.dataTransfer.files.length) addImages(card.id, e.dataTransfer.files) }
  return (
    <aside style={{ position: 'fixed', top: 0, right: 0, width: 'min(420px,92vw)', height: '100vh', background: t.cardBg, borderLeft: `1px solid ${t.border}`, boxShadow: '-12px 0 40px rgba(0,0,0,0.18)', padding: '22px 22px 40px', overflowY: 'auto', zIndex: 50, animation: 'none' }}>
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16 }}>
        <span style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: t.textSecondary, textTransform: 'uppercase', letterSpacing: 1 }}>Carte</span>
        <button onClick={onClose} style={{ ...btn(t), padding: '5px 12px' }}>fermer ✕</button>
      </div>
      <input value={card.title} onChange={(e) => editCard(card.id, { title: e.target.value })}
        style={{ width: '100%', background: 'transparent', color: t.textPrimary, border: 'none', borderBottom: `1px solid ${t.border}`, fontFamily: FONTS.serif, fontSize: 22, fontWeight: 600, padding: '4px 0 10px', outline: 'none' }} />
      <div style={{ display: 'flex', gap: 12, alignItems: 'center', margin: '14px 0' }}>
        <label style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-xs)', color: t.textSecondary }}>Date</label>
        <input type="date" value={card.date} onChange={(e) => editCard(card.id, { date: e.target.value })}
          style={{ background: t.bg, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: RADII.sm, padding: '5px 8px', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-md)' }} />
        <span style={{ fontFamily: FONTS.serif, fontStyle: 'italic', color: t.textSecondary, fontSize: 'var(--zr-ui-md)' }}>{fmtLong(card.date)}</span>
      </div>
      {card.domain && <div style={{ display: 'inline-block', fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', color: PALETTE.primary, border: `1px solid ${PALETTE.primary}`, borderRadius: 99, padding: '2px 9px', marginBottom: 14, textTransform: 'uppercase' }}>{card.domain}</div>}
      <textarea value={card.note} placeholder="Notes, détails, lien…" onChange={(e) => editCard(card.id, { note: e.target.value })}
        style={{ width: '100%', minHeight: 120, background: t.bg, color: t.textPrimary, border: `1px solid ${t.border}`, borderRadius: RADII.md, padding: 12, fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-lg)', lineHeight: 1.55, resize: 'vertical', outline: 'none' }} />
      <SectionLabel t={t} color={t.textSecondary}>Images</SectionLabel>
      <div onDragOver={(e) => { e.preventDefault(); setOver(true) }} onDragLeave={() => setOver(false)} onDrop={drop}
        style={{ border: `1.5px dashed ${over ? PALETTE.primary : t.border}`, borderRadius: RADII.md, padding: 16, textAlign: 'center', color: t.textSecondary, fontSize: 'var(--zr-ui-md)', background: over ? PALETTE.primarySoft : 'transparent', transition: TRANSITIONS.base }}>
        Glisse des images ici
        <label style={{ display: 'inline-block', marginLeft: 8, color: PALETTE.primary, cursor: 'pointer', textDecoration: 'underline' }}>
          parcourir
          <input type="file" accept="image/*" multiple style={{ display: 'none' }} onChange={(e) => addImages(card.id, e.target.files)} />
        </label>
        <div style={{ fontFamily: FONTS.sans, fontSize: 'var(--zr-ui-2xs)', marginTop: 4, opacity: 0.7 }}>compressées en webp 95%</div>
      </div>
      {card.images && card.images.length > 0 && (
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2,1fr)', gap: 8, marginTop: 12 }}>
          {card.images.map((src, i) => (
            <div key={i} style={{ position: 'relative' }}>
              <img src={src} alt="" style={{ width: '100%', borderRadius: RADII.sm, display: 'block', border: `1px solid ${t.border}` }} />
              <button onClick={() => removeImage(card.id, i)} style={{ position: 'absolute', top: 4, right: 4, background: 'rgba(0,0,0,0.6)', color: '#fff', border: 'none', borderRadius: 99, width: 22, height: 22, cursor: 'pointer' }}>×</button>
            </div>
          ))}
        </div>
      )}
      <button onClick={() => delCard(card.id)} style={{ ...btn(t), color: PALETTE.red, borderColor: PALETTE.red, marginTop: 22 }}>Supprimer la carte</button>
    </aside>
  )
}
