// SRT -> VTT : entête WEBVTT + virgule->point dans les timecodes. Décodage robuste (SRT souvent non-UTF8).
export function decodeSubBytes(bytes) {
  let txt = new TextDecoder('utf-8').decode(bytes)
  if (txt.includes('�')) { try { txt = new TextDecoder('windows-1252').decode(bytes) } catch {} }
  return txt
}
export function srtToVtt(srt) {
  const body = srt.replace(/\r+/g, '').replace(/^﻿/, '').replace(/(\d{2}:\d{2}:\d{2}),(\d{3})/g, '$1.$2')
  return 'WEBVTT\n\n' + body
}
export function vttUrlFromSrt(srtText) {
  return URL.createObjectURL(new Blob([srtToVtt(srtText)], { type: 'text/vtt' }))
}
