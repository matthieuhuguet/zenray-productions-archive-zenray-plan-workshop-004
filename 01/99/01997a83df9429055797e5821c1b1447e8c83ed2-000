import { MiB, RAW_THRESHOLD } from './chunkPolicy.js'

// Browser attachments stay on the existing CDN chunk path. Bulk imports use Git. (19 October 2026, 00:49 Paris)
export const ATTACHMENT_POLICY = Object.freeze({ maxFileBytes: RAW_THRESHOLD, bulkFileThreshold: 100 })
export const attachmentLimitLabel = () => `${ATTACHMENT_POLICY.maxFileBytes / MiB} MiB`

export function validateAttachment(file) {
  if (!Number.isSafeInteger(file?.size) || file.size <= 0) throw new Error('Choose a non-empty file.')
  if (file.size > ATTACHMENT_POLICY.maxFileBytes) throw new Error(`${file.name || 'File'} exceeds ${attachmentLimitLabel()}. Use the Create bulk transfer for larger files.`)
}

export function validateAttachmentBatch(files) {
  if (files.length >= ATTACHMENT_POLICY.bulkFileThreshold) throw new Error(`For ${ATTACHMENT_POLICY.bulkFileThreshold} files or more, use the existing Create bulk transfer.`)
  files.forEach(validateAttachment)
}
