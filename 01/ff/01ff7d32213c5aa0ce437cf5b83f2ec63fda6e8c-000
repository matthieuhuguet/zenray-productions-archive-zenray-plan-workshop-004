// Passe de NETTOYAGE : remplit les vignettes encore vides en essayant des VARIANTES de titre
// (sans sous-titre après ":", sans parenthèses, sans "S01/Season"). TMDB (films+anime) + RAWG (jeux).
// Clés en env TMDB_KEY / RAWG_KEY (jamais commitées). Idempotent (ne touche que image:null).
import { readFile, writeFile } from 'node:fs/promises'

const ROOT = new URL('../public/shelf/', import.meta.url)
const TMDB = process.env.TMDB_KEY, RAWG = process.env.RAWG_KEY
const IMG = (p) => (p ? `https://image.tmdb.org/t/p/w500${p}` : null)

const variants = (name) => {
  const base = String(name).trim()
  const out = [base]
  const noSub = base.split(/[:|–—]| - /)[0].trim(); if (noSub && noSub !== base) out.push(noSub)
  const noParen = base.replace(/\([^)]*\)/g, '').replace(/\s+/g, ' ').trim(); if (noParen) out.push(noParen)
  const noSeason = base.replace(/\s+(S\d+|Season\s*\d+|Saison\s*\d+|Part\s*\d+).*$/i, '').trim(); if (noSeason) out.push(noSeason)
  return [...new Set(out.filter(Boolean))]
}
async function jget(u) { try { const r = await fetch(u); return r.ok ? await r.json() : null } catch { return null } }
const firstPoster = (j) => { const h = j && j.results && j.results.find((r) => r.poster_path); return h ? IMG(h.poster_path) : null }

async function tmdbMovie(name) {
  for (const q of variants(name)) {
    const p = firstPoster(await jget(`https://api.themoviedb.org/3/search/multi?api_key=${TMDB}&query=${encodeURIComponent(q)}&include_adult=false`))
      || firstPoster(await jget(`https://api.themoviedb.org/3/search/movie?api_key=${TMDB}&query=${encodeURIComponent(q)}`))
      || firstPoster(await jget(`https://api.themoviedb.org/3/search/tv?api_key=${TMDB}&query=${encodeURIComponent(q)}`))
    if (p) return p
  }
  return null
}
async function tmdbTv(name) {
  for (const q of variants(name)) {
    const p = firstPoster(await jget(`https://api.themoviedb.org/3/search/tv?api_key=${TMDB}&query=${encodeURIComponent(q)}`))
      || firstPoster(await jget(`https://api.themoviedb.org/3/search/multi?api_key=${TMDB}&query=${encodeURIComponent(q)}&include_adult=false`))
    if (p) return p
  }
  return null
}
async function rawgGame(name) {
  for (const q of variants(name)) {
    const j = await jget(`https://api.rawg.io/api/games?key=${RAWG}&search=${encodeURIComponent(q)}&page_size=1`)
    const img = j && j.results && j.results[0] && j.results[0].background_image
    if (img) return img
  }
  return null
}
async function pool(items, limit, fn) { let i = 0; await Promise.all(Array.from({ length: Math.min(limit, items.length) }, async () => { while (i < items.length) { const idx = i++; await fn(items[idx]) } })) }

const PLAN = [
  { file: 'movies.json', fetch: tmdbMovie, conc: 12 },
  { file: 'anime-manga.json', fetch: tmdbTv, conc: 12 },
  { file: 'games.json', fetch: rawgGame, conc: 8 },
]
for (const { file, fetch: fetcher, conc } of PLAN) {
  const path = new URL(file, ROOT)
  const data = JSON.parse(await readFile(path, 'utf8'))
  const todo = data.items.filter((it) => !it.image)
  let filled = 0
  await pool(todo, conc, async (it) => { const url = await fetcher(it.name); if (url) { it.image = { kind: 'url', ref: url }; filled++ } })
  await writeFile(path, JSON.stringify(data, null, 2))
  console.log(`${file}: +${filled} (restait ${todo.length}) -> ${data.items.filter((i) => i.image).length}/${data.items.length}`)
}
console.log('CLEANUP DONE')
