import { GALLERY_COLORS } from './colors.js'
import { PALETTE } from '../theme.js'

// 23 October 2026: Theme-adaptive gallery presentation style with 3 and 4 column support.
export const GALLERY_PRESENTATION = Object.freeze({
  layout: { columns: 3, gap: 24, inset: 20, mobileInset: 14, maxWidth: 1600,
    imageRatio: '4 / 3', imageFit: 'contain', radius: 8 },
  typography: { titleSize: 22, headingSize: 42, bodySize: 15, bodyWeight: 400 },
  interaction: { captionMode: 'hover', motionMs: 180 },
})

export function galleryPresentationStyle(definition = GALLERY_PRESENTATION, theme = null) {
  const parameters = { ...GALLERY_PRESENTATION.layout, ...GALLERY_PRESENTATION.typography, ...GALLERY_PRESENTATION.interaction, ...(definition?.layout || {}), ...(definition?.typography || {}), ...(definition?.interaction || {}) }
  const isDark = Boolean(theme && (theme.bg === PALETTE.bgDark || theme.cardBg === PALETTE.surfaceDark || theme.textPrimary === PALETTE.textPrimaryDark))

  const bg = theme?.bg || (isDark ? PALETTE.bgDark : GALLERY_COLORS.background)
  const surface = theme?.surface || (isDark ? PALETTE.surfaceDark : GALLERY_COLORS.surface)
  const ink = theme?.textPrimary || (isDark ? PALETTE.textPrimaryDark : GALLERY_COLORS.ink)
  const muted = theme?.textSecondary || (isDark ? PALETTE.textSecondaryDark : GALLERY_COLORS.muted)
  const border = theme?.border || (isDark ? '#3A3A38' : GALLERY_COLORS.border)

  return {
    '--gallery-columns': parameters.columns,
    '--gallery-gap': `${parameters.gap}px`,
    '--gallery-inset': `${parameters.inset}px`,
    '--gallery-mobile-inset': `${parameters.mobileInset}px`,
    '--gallery-max-width': `${parameters.maxWidth}px`,
    '--gallery-image-ratio': parameters.imageRatio,
    '--gallery-image-fit': parameters.imageFit,
    '--gallery-radius': `${parameters.radius}px`,
    '--gallery-title-size': `${parameters.titleSize}px`,
    '--gallery-heading-size': `${parameters.headingSize}px`,
    '--gallery-body-size': `${parameters.bodySize}px`,
    '--gallery-body-weight': parameters.bodyWeight,
    '--gallery-motion': `${parameters.motionMs}ms`,
    '--gallery-background': bg,
    '--gallery-surface': surface,
    '--gallery-ink': ink,
    '--gallery-muted': muted,
    '--gallery-border': border,
    '--gallery-letterbox': isDark ? '#141416' : '#000000',
    '--gallery-overlay': 'rgba(0,0,0,.86)',
    '--gallery-overlayInk': '#ffffff',
  }
}

export function galleryTheme(theme) {
  if (theme && theme.bg) return theme
  return { ...theme, cardBg: GALLERY_COLORS.surface, surface: GALLERY_COLORS.surface,
    textPrimary: GALLERY_COLORS.ink, textSecondary: GALLERY_COLORS.muted, border: GALLERY_COLORS.border }
}
