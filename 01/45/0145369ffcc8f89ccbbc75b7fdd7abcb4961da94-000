# 3 October 2026, 04:00 CEST: real HOM tests distinguish node-context paths, outputs and unchanged scene bytes.
import hashlib
import sys
import tempfile
import unittest
from pathlib import Path
import hou
sys.dont_write_bytecode = True
from AuditHoudiniScene import inspect_scene


class SceneReferenceAuditTest(unittest.TestCase):
    def test_resolves_node_context_and_explicit_reference_roles_without_saving(self):
        with tempfile.TemporaryDirectory(prefix='assets-scene-audit-') as temporary:
            folder = Path(temporary).resolve()
            hou.hipFile.clear(suppress_save_prompt=True)
            hou.setUpdateMode(hou.updateMode.Manual)
            node = hou.node('/obj').createNode('geo', 'TextureNode', run_init_scripts=False)
            node.addSpareParmTuple(hou.StringParmTemplate('resource', 'Resource', 1,
                string_type=hou.stringParmType.FileReference, tags={'filechooser_mode': 'read'}))
            node.addSpareParmTuple(hou.StringParmTemplate('output', 'Output', 1,
                string_type=hou.stringParmType.FileReference, tags={'filechooser_mode': 'write'}))
            node.addSpareParmTuple(hou.StringParmTemplate('sequence', 'Sequence', 1,
                string_type=hou.stringParmType.FileReference, tags={'filechooser_mode': 'read'}))
            for name in ['runtime_uri', 'relative_resource', 'directory_resource']:
                node.addSpareParmTuple(hou.StringParmTemplate(name, name, 1,
                    string_type=hou.stringParmType.FileReference, tags={'filechooser_mode': 'read'}))
            (folder / 'TextureNode.dat').write_bytes(b'texture resource')
            node.parm('resource').set('$HIP/$OS.dat')
            node.parm('output').set('$HIP/generated.$F4.exr')
            node.parm('sequence').set('$HIP/cache.$F4.bgeo.sc')
            node.parm('runtime_uri').set('temp:lookdev_sun.rat')
            node.parm('relative_resource').set('IFD.py')
            # 3 October 2026, 04:21 CEST: directory references remain distinct from individual archive files.
            node.parm('directory_resource').set('$HIP')
            scene = folder / 'Fixture.hiplc'
            hou.hipFile.save(str(scene))
            before = hashlib.sha256(scene.read_bytes()).hexdigest()
            report = inspect_scene(scene)
            entries = {entry['parameterPath']: entry for entry in report['references']}
            resource = entries['/obj/TextureNode/resource']
            self.assertEqual(resource['resolvedPath'], str(folder / 'TextureNode.dat'))
            self.assertTrue(resource['existsAtCurrentFrame'])
            self.assertEqual(resource['mode'], 'input')
            self.assertEqual(resource['fileKind'], 'file')
            self.assertEqual(entries['/obj/TextureNode/directory_resource']['fileKind'], 'directory')
            self.assertNotIn('/obj/TextureNode/output', entries)
            sequence = entries['/obj/TextureNode/sequence']
            self.assertTrue(sequence['dynamic'])
            self.assertFalse(sequence['existsAtCurrentFrame'])
            for name, kind in [('runtime_uri', 'uri'), ('relative_resource', 'relative')]:
                reference = entries[f'/obj/TextureNode/{name}']
                self.assertEqual(reference['pathKind'], kind)
                self.assertIsNone(reference['canonicalPath'])
                self.assertIsNone(reference['existsAtCurrentFrame'])
            self.assertEqual(report['sceneSha256'], before)
            self.assertEqual(hashlib.sha256(scene.read_bytes()).hexdigest(), before)
            self.assertFalse(report['portabilityVerified'])

    def test_refuses_a_missing_scene(self):
        with tempfile.TemporaryDirectory(prefix='assets-scene-audit-') as temporary:
            with self.assertRaises(FileNotFoundError):
                inspect_scene(Path(temporary) / 'Missing.hiplc')


if __name__ == '__main__':
    unittest.main()
