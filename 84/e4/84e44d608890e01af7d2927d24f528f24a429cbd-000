// 3 October 2026, 12:40 : Accounts: every connected identity with its verification level and capabilities, plus the "add account" flows
// (OAuth link, bot token, manual, website, ArtStation, sandbox). Metered X switches require an explicit cost acknowledgement. (3 October 2026)
import React, { useMemo, useState } from 'react'
import { POSTKIT } from './postkitConfig.js'
import { useAction } from './usePostKit.js'
import { Badge, Btn, Card, Empty, ErrorLine, Field, PlatformDot, StatusBadge, Verification, daysUntil } from './ui.jsx'

function AddAccount({ client, overview, reload }) {
  const platforms = overview.data.platforms.filter((p) => p.platform !== 'meta_ads' || true)
  const profiles = overview.data.profiles
  const [platform, setPlatform] = useState('sandbox')
  const [profileId, setProfileId] = useState(profiles[0]?.id || '')
  const [f, setF] = useState({ username: '', externalId: '', accessToken: '', botToken: '', channelId: '', repoPath: '', publicUrl: '', deploy: false, newProfile: '' })
  const [link, setLink] = useState(null)
  const act = useAction(reload)
  const info = platforms.find((p) => p.platform === platform)
  const set = (k) => (e) => setF({ ...f, [k]: e.target.type === 'checkbox' ? e.target.checked : e.target.value })

  async function submit() {
    let pid = profileId
    if (!pid && f.newProfile) pid = (await client.post('/v1/profiles', { name: f.newProfile })).id
    if (!pid) throw new Error('Choose or name a profile first.')
    if (info.auth === 'oauth' || info.auth === 'embedded') {
      try { setLink((await client.get(`/v1/connect/${platform}?profileId=${pid}`)).authUrl) }
      catch (e) { if (e.code === 'platform_not_configured') throw new Error(`${info.label} is not configured on the PostKit server. Set ${e.details.missingEnv.join(' and ')} and restart it.`); throw e }
      return
    }
    if (platform === 'telegram') return client.post('/v1/connect/telegram', { profileId: pid, botToken: f.botToken, channelId: f.channelId || undefined })
    const metadata = platform === 'website' ? { repoPath: f.repoPath || undefined, publicUrl: f.publicUrl || undefined, deploy: f.deploy } : platform === 'artstation' ? { profileUrl: f.username ? `https://www.artstation.com/${f.username}` : undefined } : undefined
    return client.post('/v1/accounts/connect', { platform, profileId: pid, externalId: f.externalId || f.username || platform, username: f.username || platform, accessToken: f.accessToken || undefined, metadata })
  }

  return (
    <Card title="Add an account">
      <div className="zr-pk-grid3">
        <Field label="Platform"><select value={platform} onChange={(e) => { setPlatform(e.target.value); setLink(null) }}>{platforms.map((p) => <option key={p.platform} value={p.platform}>{p.label}</option>)}</select></Field>
        <Field label="Profile">{profiles.length ? <select value={profileId} onChange={(e) => setProfileId(e.target.value)}>{profiles.map((p) => <option key={p.id} value={p.id}>{p.name}</option>)}</select> : <input placeholder="Name your first profile" value={f.newProfile} onChange={set('newProfile')} />}</Field>
        <div className="zr-pk-fieldrow"><Verification level={info.verification} /><span className="zr-pk-meta">{info.note}</span></div>
      </div>
      {(info.auth === 'oauth' || info.auth === 'embedded') && <p className="zr-pk-meta">Opens the platform consent screen. Needs {info.requiredEnv.join(', ')} on the server.</p>}
      {platform === 'telegram' && <div className="zr-pk-grid2"><Field label="Bot token" hint="From @BotFather."><input type="password" value={f.botToken} onChange={set('botToken')} /></Field><Field label="Channel (@name or id)" hint="The bot must be an admin."><input value={f.channelId} onChange={set('channelId')} /></Field></div>}
      {platform === 'website' && <div className="zr-pk-grid3"><Field label="Repository path"><input value={f.repoPath} onChange={set('repoPath')} placeholder="default: ZenRayWebsite" /></Field><Field label="Public URL"><input value={f.publicUrl} onChange={set('publicUrl')} placeholder="https://matthieuhuguet.com" /></Field><label className="zr-pk-check"><input type="checkbox" checked={f.deploy} onChange={set('deploy')} /> Deploy with Wrangler (public). Off: stage a branch only.</label></div>}
      {platform === 'artstation' && <Field label="ArtStation username"><input value={f.username} onChange={set('username')} /></Field>}
      {['sandbox', 'instagram', 'facebook', 'threads', 'tiktok', 'youtube', 'x', 'whatsapp', 'linkedin', 'meta_ads'].includes(platform) && !(info.auth === 'oauth' || info.auth === 'embedded') && <div className="zr-pk-grid3"><Field label="Username"><input value={f.username} onChange={set('username')} /></Field><Field label="Platform id"><input value={f.externalId} onChange={set('externalId')} /></Field><Field label="Access token (optional)"><input type="password" value={f.accessToken} onChange={set('accessToken')} /></Field></div>}
      <div className="zr-pk-inline"><Btn tone="primary" busy={act.busy} onClick={() => act.run(submit)}>{info.auth === 'oauth' || info.auth === 'embedded' ? 'Get the connection link' : 'Add account'}</Btn>{link && <a className="zr-pk-link" href={link} target="_blank" rel="noreferrer">Open the consent screen</a>}</div>
      <ErrorLine error={act.error} />
    </Card>
  )
}

function AccountRow({ account, client, reload }) {
  const act = useAction(reload)
  const exp = daysUntil(account.tokenExpiresAt)
  const [ack, setAck] = useState(false)
  const caps = Object.entries(POSTKIT.capabilityLabels).filter(([k]) => account.capabilities?.[k])
  return (
    <li className="zr-pk-li">
      <div className="zr-pk-row">
        <PlatformDot platform={account.platform} label={account.displayName || account.username} />
        <span className="zr-pk-meta">@{account.username}</span><StatusBadge status={account.status} />
        <Verification level={account.verification} />
        {account.needsReconnection && <Badge tone="warn" title={account.disconnectedReason || ''}>reconnect</Badge>}
        {exp !== null && <Badge tone={exp <= POSTKIT.expiryWarnDays ? 'warn' : 'muted'}>token {exp <= 0 ? 'expired' : `${exp} d`}</Badge>}
        <span className="zr-pk-spacer" />
        {account.status === 'CONNECTED' && <Btn tone="danger" busy={act.busy} onClick={() => confirm(`Disconnect ${account.username}? Its token is wiped; posts and conversations are kept.`) && act.run(() => client.del(`/v1/accounts/${account.id}`))}>Disconnect</Btn>}
      </div>
      <div className="zr-pk-chips">{caps.map(([k, label]) => <Badge key={k} tone="muted">{label}</Badge>)}</div>
      {account.platform === 'x' && (
        <div className="zr-pk-inline">
          <span className="zr-pk-meta">Metered: analytics {account.billing?.analytics ? 'on' : 'off'}</span>
          {!account.billing?.analytics && <label className="zr-pk-check"><input type="checkbox" checked={ack} onChange={(e) => setAck(e.target.checked)} /> I accept the per-call cost</label>}
          <Btn busy={act.busy} disabled={!account.billing?.analytics && !ack} onClick={() => act.run(() => client.patch(`/v1/accounts/${account.id}/x-billing`, { analytics: !account.billing?.analytics, acknowledgeCost: ack }))}>{account.billing?.analytics ? 'Turn off' : 'Turn on'}</Btn>
        </div>
      )}
      <ErrorLine error={act.error} />
    </li>
  )
}

export default function AccountsPanel({ client, overview, reload }) {
  const { accounts, profiles } = overview.data
  const byProfile = useMemo(() => profiles.map((p) => ({ profile: p, rows: accounts.filter((a) => a.profileId === p.id) })), [accounts, profiles])
  return (
    <>
      {byProfile.length === 0 ? <Card><Empty>No profile yet. Add your first account below: a profile is created with it.</Empty></Card> : byProfile.map(({ profile, rows }) => (
        <Card key={profile.id} title={profile.name} aside={<Badge tone="muted">{rows.length} account(s)</Badge>}>
          {rows.length === 0 ? <Empty>No account in this profile.</Empty> : <ul className="zr-pk-list">{rows.map((a) => <AccountRow key={a.id} account={a} client={client} reload={reload} />)}</ul>}
        </Card>
      ))}
      <AddAccount client={client} overview={overview} reload={reload} />
    </>
  )
}
