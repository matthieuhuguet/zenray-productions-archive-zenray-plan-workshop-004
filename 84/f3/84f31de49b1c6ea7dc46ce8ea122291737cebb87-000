// 14 October 2026: the text filter only changes what is drawn; the saved order is untouched and a miss says so.
test('the filter hides non-matching references without touching the saved items', async () => {
  const key = POINTER_GALLERIES[0].key
  const many = Array.from({ length: 8 }, (_, index) => ({ id: `r${index}`, kind: 'image', path: `https://example.com/r${index}.png`, title: index % 2 ? `Forest ${index}` : `Castle ${index}`, note: index === 3 ? 'concept art' : '' }))
  store.data = { v: 1, items: many }
  localStorage.setItem(`zr:gallery:layout:${key}`, 'aligned')
  const view = render(<GalleryView galleryKey={key} t={{ accent: 'blue', border: '#ccc', textPrimary: '#000', textSecondary: '#666', surface: '#fff' }} />)
  await waitFor(() => expect(view.container.querySelectorAll('[draggable="true"]')).toHaveLength(8))
  const input = view.container.querySelector('input[type="search"]')
  expect(input).toBeTruthy()
  fireEvent.change(input, { target: { value: 'forest' } })
  await waitFor(() => expect(view.container.querySelectorAll('[draggable="true"]')).toHaveLength(4))
  fireEvent.change(input, { target: { value: 'forest concept' } })
  await waitFor(() => expect(view.container.querySelectorAll('[draggable="true"]')).toHaveLength(1))
  fireEvent.change(input, { target: { value: 'zzzz' } })
  await waitFor(() => expect(view.getByText(/Aucune référence ne correspond/)).toBeTruthy())
  expect(store.data.items.map((item) => item.id)).toEqual(many.map((item) => item.id))
  fireEvent.change(input, { target: { value: '' } })
  await waitFor(() => expect(view.container.querySelectorAll('[draggable="true"]')).toHaveLength(8))
})

