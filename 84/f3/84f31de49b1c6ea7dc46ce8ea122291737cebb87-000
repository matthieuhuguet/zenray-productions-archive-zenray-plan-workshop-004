// 08 October 2026: Navigation dans les sous-groupes enfants et fil dariane hierarchique
test('navigation dans un sous-groupe enfant et fil dariane hierarchique', async () => {
  const grandchild = { id: 'grandchild', kind: 'folder', name: 'Sous-groupe 2', items: [image('c')] }
  const child = { id: 'child', kind: 'folder', name: 'Nouveau groupe', items: [image('b'), grandchild] }
  const parent = { id: 'parent', kind: 'folder', name: 'Louisiana Bayou', items: [image('a'), child] }
  store.data = { v: 1, items: [parent] }

  const view = render(<GalleryView galleryKey="todo3d" t={{ accent: 'blue' }} />)
  await waitFor(() => expect(view.getAllByText('Louisiana Bayou')).toBeTruthy())

  // Verification que le fil d'ariane Tahoe V9 (.zr-ws-path) est bien present des la racine
  expect(view.container.querySelector('.zr-ws-path')).toBeTruthy()
  expect(view.container.querySelector('[data-zr-pathmenu-trigger="true"]')).toBeTruthy()

  // Clic sur la tuile Louisiana Bayou : ouvre le dossier parent
  fireEvent.click(view.container.querySelector('.zr-ws-rim'))
  await waitFor(() => expect(view.getAllByText('Nouveau groupe')).toBeTruthy())

  // Clic sur la tuile Nouveau groupe : ouvre le sous-groupe enfant sans revenir au root
  fireEvent.click(view.container.querySelector('.zr-ws-rim'))
  await waitFor(() => expect(view.getAllByText('Sous-groupe 2')).toBeTruthy())

  // Verification du fil dariane complet
  expect(view.getAllByText('ToDo-3D')).toBeTruthy()
  expect(view.getAllByText('Louisiana Bayou')).toBeTruthy()
  expect(view.getAllByText('Nouveau groupe')).toBeTruthy()

  // Clic sur la tuile Sous-groupe 2 : descend au 3e niveau enfant
  fireEvent.click(view.container.querySelector('.zr-ws-rim'))
  await waitFor(() => expect(view.getAllByText('Sous-groupe 2')).toBeTruthy())

  // Le fil dariane montre tous les ancetres
  expect(view.getAllByText('ToDo-3D')).toBeTruthy()
  expect(view.getAllByText('Louisiana Bayou')).toBeTruthy()
  expect(view.getAllByText('Nouveau groupe')).toBeTruthy()

  // Clic sur Louisiana Bayou dans le fil dariane : remonte directement a Louisiana Bayou
  fireEvent.click(view.getByText('Louisiana Bayou'))
  await waitFor(() => expect(view.getAllByText('Nouveau groupe')).toBeTruthy())

  // Clic sur ToDo-3D dans le fil dariane : remonte directement a la racine
  fireEvent.click(view.getByText('ToDo-3D'))
  await waitFor(() => expect(view.getAllByText('Louisiana Bayou')).toBeTruthy())
  // La barre .zr-ws-path reste presente et visible a la racine
  expect(view.container.querySelector('.zr-ws-path')).toBeTruthy()
})

