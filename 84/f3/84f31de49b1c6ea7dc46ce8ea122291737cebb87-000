const image = (id) => ({ id, kind: 'image', path: `https://example.com/${id}.png` })
async function drop(key, x, initial = [image('a'), image('b')], layout = 'aligned') {
  store.data = { v: 1, items: initial }
  localStorage.setItem(`zr:gallery:layout:${key}`, layout)
  const view = render(<GalleryView galleryKey={key} t={{ accent: 'blue' }} />)
  await waitFor(() => expect(view.container.querySelectorAll('[draggable="true"]')).toHaveLength(initial.length))
  const tile = view.container.querySelectorAll('[draggable="true"]')[1]
  tile.getBoundingClientRect = () => ({ left: 0, width: 100 })
  const event = createEvent.drop(tile)
  Object.defineProperties(event, { clientX: { value: x }, dataTransfer: { value: { types: ['application/zenray-gallery-item'], getData: () => 'a' } } })
  fireEvent(tile, event)
  await waitFor(() => expect(store.data.items).not.toEqual(initial))
  return store.data.items
}
for (const gallery of POINTER_GALLERIES) {
  test(`aligned center groups in ${gallery.key}`, async () => {
    const items = await drop(gallery.key, 50)
    expect(items).toHaveLength(1)
    expect(items[0].items.map(x => x.id)).toEqual(['b', 'a'])
  })
}
test('aligned right edge reorders without grouping', async () => {
  expect((await drop(POINTER_GALLERIES[0].key, 95)).map(x => x.id)).toEqual(['b', 'a'])
})
test('aligned center adds to an existing group', async () => {
  const items = await drop(POINTER_GALLERIES[0].key, 50, [image('a'), { id: 'folder', kind: 'folder', name: 'Group', items: [image('b')] }])
  expect(items[0].items.map(x => x.id)).toEqual(['b', 'a'])
})
test('grid still groups on tile edges', async () => {
  expect((await drop(POINTER_GALLERIES[0].key, 95, undefined, 'grid'))[0].kind).toBe('folder')
})

