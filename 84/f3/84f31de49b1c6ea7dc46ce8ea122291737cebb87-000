test('ToDo-3D persists Done and restores a completed group without losing references', async () => {
  const project = { id: 'project', kind: 'folder', name: 'Finished project', items: [image('a'), image('b')] }
  store.data = { v: 1, items: [project, image('c')] }
  let view = render(<GalleryView galleryKey="todo3d" t={{ accent: 'blue' }} />)
  await waitFor(() => expect(view.container.querySelectorAll('[draggable="true"]')).toHaveLength(2))
  fireEvent.contextMenu(view.container.querySelector('[draggable="true"]'))
  fireEvent.click(view.getByText('Ranger dans Done'))
  await waitFor(() => expect(store.data.items[0].status).toBe('done'))
  expect(store.data.items[0].items).toEqual(project.items)
  view.unmount()
  view = render(<GalleryView galleryKey="todo3d" t={{ accent: 'blue' }} />)
  await waitFor(() => expect(view.container.querySelectorAll('[draggable="true"]')).toHaveLength(1))
  expect(view.queryByText('Finished project')).toBeNull()
  fireEvent.click(view.getByRole('button', { name: 'Done' }))
  expect(view.getByText('Finished project')).toBeTruthy()
  fireEvent.contextMenu(view.container.querySelector('[draggable="true"]'))
  fireEvent.click(view.getByText('Remettre en cours'))
  await waitFor(() => expect(store.data.items[0].status).toBe('active'))
  fireEvent.click(view.getByRole('button', { name: 'En cours' }))
  expect(view.getByText('Finished project')).toBeTruthy()
  expect(store.data.items[0].items).toEqual(project.items)
})
