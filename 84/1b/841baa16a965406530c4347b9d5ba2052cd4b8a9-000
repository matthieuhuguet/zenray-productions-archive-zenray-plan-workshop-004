import { describe, it, expect } from 'vitest'
import { readdirSync, readFileSync, statSync } from 'node:fs'
import path from 'node:path'

// ═══ UN HOOK REACT UTILISÉ SANS ÊTRE IMPORTÉ CASSE L'APP, ET LE BUILD NE LE VOIT PAS ════════════
//
// L'INCIDENT, 2026-08-31 à 02h17. J'ai écrit `useCallback` dans App.jsx sans l'ajouter à la ligne
// d'import. `vite build` a réussi, les 1183 tests sont passés au vert, le déploiement est parti — et
// l'app a rendu « useCallback is not defined » à l'écran de Matthieu.
//
// POURQUOI RIEN NE L'A VU. Un identifiant libre est parfaitement valide en JavaScript : le moteur ne
// s'en plaint qu'à l'EXÉCUTION, quand il cherche la variable et ne la trouve pas. Un bundler n'a
// aucune raison de refuser, et un test qui ne monte pas ce composant ne l'exécute jamais. Le lint
// attraperait le cas, mais il est rouge sur 261 erreurs préexistantes sans rapport : une alarme qui
// sonne en permanence n'alarme plus personne.
//
// CE CONTRÔLE EST DONC LE VÉRIFICATEUR QUI MANQUAIT. Il lit les fichiers, compare ce qui est importé
// de `react` à ce qui est appelé nu, et rougit sur l'écart. Il ne remplace pas le lint : il tient la
// seule règle dont la violation se paie par un écran d'erreur en production.

const RACINE = 'src'
const HOOKS_REACT = new Set([
  'useState', 'useEffect', 'useRef', 'useMemo', 'useCallback', 'useLayoutEffect',
  'useContext', 'useReducer', 'useId', 'useTransition', 'useDeferredValue',
  'useSyncExternalStore', 'useImperativeHandle', 'useDebugValue', 'useInsertionEffect',
])

function fichiersJsx(dossier, acc = []) {
  for (const nom of readdirSync(dossier)) {
    const p = path.join(dossier, nom)
    if (nom === 'node_modules' || nom.startsWith('.')) continue
    if (statSync(p).isDirectory()) { fichiersJsx(p, acc); continue }
    if (/\.(jsx|js)$/.test(nom) && !/\.test\.jsx?$/.test(nom)) acc.push(p)
  }
  return acc
}

// Les hooks nommés dans un `import … from 'react'`, plus ceux atteints par `React.useX`.
function importesDeReact(source) {
  const nommes = new Set()
  for (const m of source.matchAll(/import\s+(?:React\s*,\s*)?\{([^}]*)\}\s*from\s*['"]react['"]/g)) {
    for (const part of m[1].split(',')) {
      const nom = part.trim().split(/\s+as\s+/)[0].trim()
      if (nom) nommes.add(nom)
    }
  }
  return nommes
}

// Les hooks appelés SANS préfixe. `React.useCallback(` et `x.useCallback(` sont exclus par le regard
// arrière : ceux-là sont toujours définis, quel que soit l'import.
function appelesNus(source) {
  const vus = new Set()
  for (const m of source.matchAll(/(?<![.\w$])(use[A-Z]\w*)\s*\(/g)) vus.add(m[1])
  return vus
}

// Un hook peut aussi être DÉFINI dans le fichier même (`function useTruc`, `const useTruc =`).
function definisSurPlace(source) {
  const vus = new Set()
  for (const m of source.matchAll(/(?:function|const|let|var)\s+(use[A-Z]\w*)\b/g)) vus.add(m[1])
  for (const m of source.matchAll(/export\s+(?:async\s+)?function\s+(use[A-Z]\w*)\b/g)) vus.add(m[1])
  return vus
}

describe('aucun hook React n’est utilisé sans être importé', () => {
  const fichiers = fichiersJsx(RACINE)

  it(`balaie réellement les fichiers du projet (${fichiers.length} trouvés)`, () => {
    // Sans ce contrôle, une erreur de parcours rendrait zéro fichier et le test suivant passerait
    // au vert en n'ayant rien regardé — le pire des faux positifs.
    expect(fichiers.length).toBeGreaterThan(100)
    expect(fichiers).toContain('src/App.jsx')
  })

  it('aucun fichier n’appelle un hook React absent de ses imports', () => {
    const fautes = []
    for (const f of fichiers) {
      const src = readFileSync(f, 'utf8')
      if (!/from\s*['"]react['"]/.test(src)) continue   // fichier sans React : hors sujet
      const dispo = new Set([...importesDeReact(src), ...definisSurPlace(src)])
      for (const h of appelesNus(src)) {
        if (HOOKS_REACT.has(h) && !dispo.has(h)) fautes.push(`${f} : ${h}`)
      }
    }
    expect(fautes, `hook(s) non importé(s) — l'app rendra « X is not defined » :\n  ${fautes.join('\n  ')}`).toEqual([])
  })

  it('le contrôle DÉTECTE vraiment une faute : il vire au rouge sur un cas fabriqué', () => {
    // Un vérificateur qui n'a jamais rougi n'a rien prouvé. On lui donne le fichier exact qui a
    // cassé l'app cette nuit, réduit à sa faute.
    const casse = `import React, { useState } from 'react'\nfunction A() { const x = useCallback(() => {}, []) }`
    const dispo = new Set([...importesDeReact(casse), ...definisSurPlace(casse)])
    const manquants = [...appelesNus(casse)].filter((h) => HOOKS_REACT.has(h) && !dispo.has(h))
    expect(manquants).toEqual(['useCallback'])
  })

  it('ne se trompe pas sur les cas légitimes', () => {
    const ok = [
      `import React from 'react'\nconst a = React.useCallback(() => {}, [])`,     // préfixé
      `import { useState } from 'react'\nfunction useMien() {}\nuseMien()`,        // hook maison
      `import { useEffect as useE } from 'react'\nuseE(() => {})`,                  // renommé
    ]
    for (const src of ok) {
      const dispo = new Set([...importesDeReact(src), ...definisSurPlace(src)])
      const manquants = [...appelesNus(src)].filter((h) => HOOKS_REACT.has(h) && !dispo.has(h))
      expect(manquants, `faux positif sur : ${src.split('\n')[0]}`).toEqual([])
    }
  })
})
