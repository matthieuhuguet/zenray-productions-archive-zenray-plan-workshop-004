import React from 'react'
import { RADII, TRANSITIONS } from '../theme.js'
import Icon from './Icon.jsx'
import { notify } from './Notifications.jsx'

// HlsDownloadPanel — panneau "Télécharger via script" sous le lecteur HLS (plan §4/§13).
//
// EN CLAIR (pour tout le monde) :
//   Une vidéo HLS n'est PAS un fichier unique : c'est une liste de petits morceaux (segments) + une
//   "carte" (le manifest .m3u8) + parfois une clé pour déchiffrer. Pour obtenir UN fichier lisible
//   dans VLC, il faut recoller les morceaux : c'est un "remux". On ne fait JAMAIS ce remux côté serveur
//   (trop lourd, et on ne reconstruit jamais la vidéo dans le navigateur non plus). À la place, le site
//   donne à l'utilisateur un petit script. L'utilisateur lance le script chez lui ; le script appelle
//   ffmpeg (un outil installé sur son ordi) qui télécharge les morceaux, déchiffre et recolle tout en
//   un .mkv déposé dans son dossier Téléchargements.
//
// Trois actions (plan §4) :
//   [Télécharger via script]  -> télécharge un ZIP (README + download.command/.sh/.ps1 + video.url.txt)
//   [Copier commande ffmpeg]  -> copie une commande ffmpeg prête à coller dans un terminal
//   [Copier URL VLC]          -> copie l'URL du manifest tokenisée, ouvrable directement dans VLC
//
// Le serveur fournit ces données via GET /api/hls-download-info?path=<...media.json> (renvoie name,
// ffmpegCommand, vlcUrl, scriptUrl, expiresAt) — JAMAIS la clé AES brute. Le ZIP vient de
// /api/hls-download-script?path=...&format=zip.

const ACCENT = '#d97757'                 // orange historique du pipeline HLS
const ACCENT_SOFT = 'rgba(217,119,87,.12)'

export default function HlsDownloadPanel({ t, mediaPath }) {
  const [info, setInfo] = React.useState(null)
  const [loading, setLoading] = React.useState(false)
  const [err, setErr] = React.useState(null)
  const [copied, setCopied] = React.useState(null) // 'ffmpeg' | 'vlc' | null
  const [more, setMore] = React.useState(false) // déplie les options secondaires (script ZIP / URL VLC)

  // Charge les infos de download (token + commande + URLs). Idempotent : ne recharge pas si déjà là.
  const loadInfo = React.useCallback(async () => {
    if (info || loading) return info
    setLoading(true); setErr(null)
    try {
      const r = await fetch(`/api/hls-download-info?path=${encodeURIComponent(mediaPath)}`)
      const j = await r.json().catch(() => ({}))
      if (!r.ok || !j.ok) throw new Error(j.error || `Erreur ${r.status}`)
      setInfo(j)
      return j
    } catch (e) {
      setErr(String((e && e.message) || e))
      return null
    } finally {
      setLoading(false)
    }
  }, [info, loading, mediaPath])

  const copy = async (text, which) => {
    try {
      // Plus de repli document.execCommand('copy') (API dépréciée, retirée des navigateurs) : si l'API
      // moderne est absente ou refuse, message d'échec explicite plutôt qu'une copie silencieuse fragile.
      if (!navigator.clipboard || !navigator.clipboard.writeText) throw new Error('clipboard API indisponible')
      await navigator.clipboard.writeText(text)
      setCopied(which); setTimeout(() => setCopied((c) => (c === which ? null : c)), 1800)
      // Notification macOS (haut-droite) : retour visuel clair "copié".
      notify({ icon: 'checkmark', tint: '#34C759', label: 'Presse-papiers', title: which === 'ffmpeg' ? 'Commande ffmpeg copiée' : 'URL VLC copiée', body: which === 'ffmpeg' ? 'Collez-la dans votre terminal' : 'Ouvrez-la dans VLC (Cmd+V)' })
    } catch { setErr('Copie impossible : copie la commande manuellement.') }
  }

  const onCopyFfmpeg = async () => { const j = await loadInfo(); if (j && j.ffmpegCommand) copy(j.ffmpegCommand, 'ffmpeg') }
  const onCopyVlc = async () => { const j = await loadInfo(); if (j && j.vlcUrl) copy(j.vlcUrl, 'vlc') }
  const onDownloadScript = async () => {
    const j = await loadInfo()
    if (!j) return
    // Téléchargement direct du ZIP : on pointe une ancre sur l'endpoint (Content-Disposition attachment).
    const url = j.scriptUrl || `/api/hls-download-script?path=${encodeURIComponent(mediaPath)}&format=zip`
    const a = document.createElement('a'); a.href = url; a.rel = 'noopener'; document.body.appendChild(a); a.click(); a.remove()
  }

  const btn = { display: 'inline-flex', alignItems: 'center', gap: 7, padding: '9px 16px', borderRadius: RADII.md, border: `1px solid ${ACCENT}`, cursor: 'pointer', fontSize: 'var(--zr-ui-md)', fontWeight: 600, transition: TRANSITIONS.base, fontFamily: "var(--zr-police-sans)" }
  const btnPrimary = { ...btn, background: ACCENT, color: '#fff' }
  const btnGhost = { ...btn, background: ACCENT_SOFT, color: ACCENT }

  return (
    <div style={{ maxWidth: 980, margin: '14px auto 0' }}>
      <div style={{ display: 'flex', flexWrap: 'wrap', gap: 10, alignItems: 'center' }}>
        {/* Action PRINCIPALE : copier la commande ffmpeg (le plus simple pour l'utilisateur). */}
        <button style={btnPrimary} onClick={onCopyFfmpeg} disabled={loading} title="Copie une commande ffmpeg prête à coller dans un terminal">
          <Icon name="doc.text" size={15} color="#fff" />
          {loading ? 'Préparation…' : (copied === 'ffmpeg' ? 'Commande copiée ✓' : 'Copier commande ffmpeg')}
        </button>
        {/* Toggle des options secondaires (script ZIP / URL VLC). */}
        <button style={{ ...btnGhost, fontWeight: 500 }} onClick={() => setMore((v) => !v)} title="Autres options de téléchargement">
          {more ? "Moins d'options ▴" : 'Autres options ▾'}
        </button>
      </div>

      {more && (
        <div style={{ display: 'flex', flexWrap: 'wrap', gap: 10, alignItems: 'center', marginTop: 10 }}>
          <button style={btnGhost} onClick={onDownloadScript} disabled={loading} title="Télécharge un petit script qui lance ffmpeg sur ton ordinateur">
            <Icon name="arrow.down.right" size={15} color={ACCENT} />
            {loading ? 'Préparation…' : 'Télécharger via script'}
          </button>
          <button style={btnGhost} onClick={onCopyVlc} disabled={loading} title="Copie l'URL du manifest, ouvrable dans VLC">
            <Icon name="play.rectangle" size={15} color={ACCENT} />
            {copied === 'vlc' ? 'URL copiée ✓' : 'Copier URL VLC'}
          </button>
        </div>
      )}

      <div style={{ marginTop: 10, fontSize: 'var(--zr-ui-sm)', color: t.textSecondary, lineHeight: 1.5, maxWidth: 720 }}>
        La vidéo est servie en streaming par morceaux fMP4 / CMAF (manifeste HLS, jsDelivr) — pas de
        réencodage. Le site ne reconstruit pas le fichier : ce script lance ffmpeg sur ton ordinateur pour
        télécharger les morceaux et recoller un fichier MKV local dans ton dossier Téléchargements.
      </div>

      {info && info.expiresAt && (
        <div style={{ marginTop: 6, fontSize: 'var(--zr-ui-xs)', color: t.textSecondary, opacity: .8 }}>
          Lien valide jusqu'à {new Date(info.expiresAt).toLocaleTimeString()} (token à durée limitée).
        </div>
      )}
      {err && <div style={{ marginTop: 8, fontSize: 'var(--zr-ui-sm)', color: '#FF3B30' }}>{err}</div>}
    </div>
  )
}
