/* LiveTransfersPanel.css (11 October 2026): upload card and 24 h media toggle, built only from the Assets tokens. */
.zr-live { display: grid; gap: 12px; padding: 16px 18px; border: 1px solid var(--assets-stroke); border-radius: var(--assets-radius); background: var(--assets-wash); font-family: var(--zr-police-sans); font-size: var(--assets-ui-size); color: var(--assets-ink); }
.zr-live-job { display: grid; gap: 12px; }
.zr-live-job-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; }
.zr-live-job-head h3 { margin: 6px 0 0; font-family: var(--zr-police-serif); font-weight: 350; font-size: calc(var(--assets-ui-size) * 1.5); line-height: 1.15; }
.zr-live-percent { font-size: calc(var(--assets-ui-size) * 2.2); line-height: 1; color: var(--assets-ink); }
.zr-live-pill { display: inline-block; padding: 2px 10px; border-radius: 999px; background: color-mix(in srgb, var(--assets-positive) 16%, transparent); color: var(--assets-positive); font-size: calc(var(--assets-ui-size) * .9); }
.zr-live-pill.is-paused { background: color-mix(in srgb, var(--assets-warning) 18%, transparent); color: var(--assets-warning); }
.zr-live-bar { height: 10px; border-radius: 999px; background: color-mix(in srgb, var(--assets-ink) 8%, transparent); overflow: hidden; }
.zr-live-bar span { display: block; height: 100%; border-radius: 999px; background: var(--assets-accent); transition: width var(--assets-motion-duration) ease; }
.zr-live-stats { display: flex; flex-wrap: wrap; gap: 8px 28px; margin: 0; }
.zr-live-stats div { display: grid; gap: 2px; }
.zr-live-stats dt { color: var(--assets-muted); font-size: calc(var(--assets-ui-size) * .9); }
.zr-live-stats dd { margin: 0; font-size: calc(var(--assets-ui-size) * 1.15); }
.zr-live-now { display: grid; gap: 2px; margin: 0; padding-top: 10px; border-top: 1px solid var(--assets-stroke); min-width: 0; }
.zr-live-now-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zr-live-now-step, .zr-live-pushes, .zr-live-idle { margin: 0; color: var(--assets-muted); }
.zr-live-recent { display: grid; gap: 8px; padding-top: 10px; border-top: 1px solid var(--assets-stroke); }
.zr-live-toggle { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px 12px; border: 1px solid var(--assets-stroke); border-radius: var(--assets-radius); background: var(--assets-surface); color: var(--assets-ink); font: inherit; cursor: pointer; text-align: left; }
.zr-live-toggle:hover { background: var(--assets-hover); }
.zr-live-count { margin-left: auto; color: var(--assets-muted); }
.zr-live-chevron { color: var(--assets-muted); }
.zr-live-recent-list { display: grid; gap: 4px; max-height: 320px; overflow: auto; margin: 0; padding: 0; list-style: none; }
.zr-live-recent-list li { display: flex; align-items: center; gap: 6px; min-width: 0; }
.zr-live-media { display: flex; align-items: baseline; gap: 10px; flex: 1; min-width: 0; padding: 6px 10px; border: 0; border-radius: var(--assets-radius); background: transparent; color: var(--assets-ink); font: inherit; text-align: left; cursor: pointer; }
.zr-live-media:hover, .zr-live-folder:hover { background: var(--assets-hover); }
.zr-live-media, .zr-live-folder { text-decoration: none; }
.zr-live-media-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zr-live-media-time { flex: none; color: var(--assets-muted); font-size: calc(var(--assets-ui-size) * .9); }
.zr-live-folder { flex: none; padding: 4px 10px; border: 1px solid var(--assets-stroke); border-radius: 999px; background: transparent; color: var(--assets-muted); font: inherit; font-size: calc(var(--assets-ui-size) * .9); cursor: pointer; }
