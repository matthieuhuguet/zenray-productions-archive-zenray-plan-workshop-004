// 3 October 2026, 13:40 : PostKit client: failures are classified (offline, unauthorized, http), the key travels as a Bearer, settings persist.
import { describe, it, expect, vi } from 'vitest'
import { createClient, PostKitError, loadConfig, saveConfig, qs } from './postkitClient.js'
import { POSTKIT } from './postkitConfig.js'

const res = (data, status = 200) => new Response(JSON.stringify(data), { status })

describe('createClient', () => {
  it('sends the key as a Bearer token and trims the trailing slash of the base URL', async () => {
    const f = vi.fn(async () => res({ ok: 1 }))
    const c = createClient({ baseUrl: 'http://x.test/', key: 'pk_abc', fetchImpl: f })
    expect(await c.get('/v1/health')).toEqual({ ok: 1 })
    expect(f.mock.calls[0][0]).toBe('http://x.test/v1/health')
    expect(f.mock.calls[0][1].headers.authorization).toBe('Bearer pk_abc')
  })
  it('reports offline when nothing answers, with the address', async () => {
    const c = createClient({ baseUrl: 'http://x.test', key: 'k', fetchImpl: async () => { throw new TypeError('fetch failed') } })
    await expect(c.get('/v1/x')).rejects.toMatchObject({ kind: 'offline', message: expect.stringContaining('http://x.test') })
  })
  it('classifies 401 as unauthorized and other failures as http carrying the API message', async () => {
    const un = createClient({ key: 'k', fetchImpl: async () => res({ error: { message: 'no' } }, 401) })
    await expect(un.get('/v1/x')).rejects.toMatchObject({ kind: 'unauthorized', status: 401 })
    const bad = createClient({ key: 'k', fetchImpl: async () => res({ error: { code: 'validation_error', message: 'name is required' } }, 400) })
    const err = await bad.post('/v1/profiles', {}).catch((e) => e)
    expect(err).toBeInstanceOf(PostKitError); expect(err).toMatchObject({ kind: 'http', status: 400, code: 'validation_error', message: 'name is required' })
  })
  it('sends JSON bodies with a content type and none on GET', async () => {
    const f = vi.fn(async () => res({}))
    const c = createClient({ key: 'k', fetchImpl: f })
    await c.post('/v1/profiles', { name: 'Brand' }); await c.get('/v1/profiles')
    expect(f.mock.calls[0][1]).toMatchObject({ method: 'POST', body: '{"name":"Brand"}' }); expect(f.mock.calls[0][1].headers['content-type']).toBe('application/json')
    expect(f.mock.calls[1][1].body).toBeUndefined()
  })
})

describe('settings and helpers', () => {
  it('loads defaults when storage is empty or corrupt and round-trips what is saved', () => {
    const mem = new Map(); const storage = { getItem: (k) => mem.get(k) ?? null, setItem: (k, v) => mem.set(k, v) }
    expect(loadConfig(storage)).toEqual({ baseUrl: POSTKIT.defaultBaseUrl, key: '' })
    mem.set(POSTKIT.storageKey, '{broken'); expect(loadConfig(storage).baseUrl).toBe(POSTKIT.defaultBaseUrl)
    saveConfig({ baseUrl: 'http://h:1', key: 'pk_z' }, storage); expect(loadConfig(storage)).toEqual({ baseUrl: 'http://h:1', key: 'pk_z' })
  })
  it('qs drops empty values and encodes the rest', () => {
    expect(qs({ a: 1, b: '', c: undefined, d: 'x y' })).toBe('?a=1&d=x+y'); expect(qs({})).toBe('')
  })
})
