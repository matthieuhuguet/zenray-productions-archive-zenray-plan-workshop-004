import React, { useCallback, useEffect, useRef, useState } from 'react'
import { Tldraw, getSnapshot, loadSnapshot, AssetRecordType, createShapeId } from 'tldraw'
import 'tldraw/tldraw.css'
import './ref.css'
import { useRefAutosave } from './useRefAutosave.js'
import { readJson } from './content.js'
import { normalizeCanvas, makeCanvas, makeRefItem, newId, nowIso } from './schema.js'
import { resolveRef, resolveRefFull } from './resolveRef.js'
import { RefUiContext } from './refUiContext.js'
import RefToolbar from './RefToolbar.jsx'
import RefTextPanel from './RefTextPanel.jsx'
import { diagnostiquerBoard, PHRASES, SEUILS } from './autoDiagnostic.js'
