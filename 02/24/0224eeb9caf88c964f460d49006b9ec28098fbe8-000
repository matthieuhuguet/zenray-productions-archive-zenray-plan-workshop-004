// 3 October 2026, 16:05 CEST: a conversation identity is derived from the actual host session, never from each prompt.
import { createHash } from 'node:crypto'

export function conversationStart({ agent, sessionId, projectId, name }, bindings = {}) {
  if (!['claude', 'codex', 'gemini', 'antigravity'].includes(agent)) throw new Error('Supported agent required')
  if (typeof sessionId !== 'string' || !/^[a-zA-Z0-9-]{8,128}$/.test(sessionId)) throw new Error('Actual host session id required')
  const bound = bindings[sessionId]
  if (bound && projectId && bound !== projectId) throw new Error('This conversation is already mapped to another project; preserve its history instead of rebinding it')
  const id = bound || projectId || `conversation-${agent}-${createHash('sha256').update(sessionId).digest('hex').slice(0, 24)}`
  const standalone = !bound && !projectId
  return { action: 'start', id, sessionId, agent, ...(standalone ? { name: name || `Conversation ${agent} ${sessionId.slice(0, 8)}`, category: 'Conversations' } : !bound && name ? { name } : {}) }
}
