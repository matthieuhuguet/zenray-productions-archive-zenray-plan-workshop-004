// 07 October 2026: Tests for Freelance email parser and studio response detector.
import { describe, it, expect } from 'vitest'
import {
  isAutoAckEmail,
  detectReplyIntent,
  matchStudioFromEmail,
  processIncomingEmail,
  processEmailsBatch,
  MATTHIEU_EMAIL,
} from './freelanceEmailParser.js'
import { normalizeStudio } from './freelanceStudios.js'

describe('freelanceEmailParser', () => {
  it('exposes Matthieu’s designated mailbox address', () => {
    expect(MATTHIEU_EMAIL).toBe('matth.huguet@gmail.com')
  })

  describe('isAutoAckEmail', () => {
    it('identifies standard automated receipt acknowledgment in English and French', () => {
      expect(isAutoAckEmail({ subject: 'We received your application for Technical Artist', from: 'no-reply@ubisoft.com' })).toBe(true)
      expect(isAutoAckEmail({ subject: 'Thank you for applying to Sloclap', from: 'jobs@sloclap.com' })).toBe(true)
      expect(isAutoAckEmail({ subject: 'Nous avons bien reçu votre candidature', from: 'contact@asobo.com' })).toBe(true)
      expect(isAutoAckEmail({ subject: 'Accusé de réception de votre candidature', from: 'recrutement@dontnod.com' })).toBe(true)
      expect(isAutoAckEmail({ subject: 'Your application has been submitted', from: 'notifications@greenhouse.io' })).toBe(true)
      expect(isAutoAckEmail({ subject: 'Confirmation de réception', from: 'recruiting-noreply@studio.com' })).toBe(true)
    })

    it('does not flag genuine human emails as automated acknowledgments', () => {
      expect(isAutoAckEmail({ subject: 'Échange au sujet de votre portfolio', from: 'recruteur@sloclap.com', body: 'Bonjour Matthieu, nous aimerions faire un premier call avec vous.' })).toBe(false)
      expect(isAutoAckEmail({ subject: 'Disponibilités pour un entretien Tech Art', from: 'lead@asobo-studio.com', body: 'Seriez-vous libre jeudi à 14h ?' })).toBe(false)
      expect(isAutoAckEmail({ subject: 'Suite à votre candidature chez Dontnod', from: 'rh@dontnod.com', body: 'Bonjour, seriez-vous ouvert à une mission freelance ?' })).toBe(false)
    })
  })

  describe('detectReplyIntent', () => {
    it('detects interview proposals', () => {
      expect(detectReplyIntent({ subject: 'Proposition d’entretien visio', body: 'Seriez-vous disponible pour un échange ?' })).toBe('interview')
      expect(detectReplyIntent({ subject: 'Interview schedule - Technical Artist', body: 'We would love to set up a call with our team.' })).toBe('interview')
    })

    it('detects rejection messages', () => {
      expect(detectReplyIntent({ subject: 'Votre candidature chez Studio', body: 'Malheureusement nous avons retenu un autre profil.' })).toBe('declined')
      expect(detectReplyIntent({ subject: 'Update on your application', body: 'Unfortunately we have decided not to move forward at this time.' })).toBe('declined')
    })

    it('defaults to replied for standard human answers', () => {
      expect(detectReplyIntent({ subject: 'Questions sur votre CV', body: 'Pourriez-vous nous envoyer un lien vers votre reel ?' })).toBe('replied')
    })
  })

  describe('matchStudioFromEmail', () => {
    const studios = [
      normalizeStudio({ id: 's1', name: 'Sloclap', link: 'https://sloclap.com/jobs', status: 'contacted' }),
      normalizeStudio({ id: 's2', name: 'Asobo Studio', link: 'https://asobostudio.com', status: 'contacted' }),
      normalizeStudio({ id: 's3', name: 'Dontnod Entertainment', link: 'https://dont-nod.com', status: 'contacted' }),
    ]

    it('matches by sender domain or studio link stem', () => {
      expect(matchStudioFromEmail({ from: 'pierre@sloclap.com', subject: 'Bonjour' }, studios)?.id).toBe('s1')
      expect(matchStudioFromEmail({ from: 'rh@asobostudio.com', subject: 'Candidature' }, studios)?.id).toBe('s2')
    })

    it('matches by studio name mentioned in the subject', () => {
      expect(matchStudioFromEmail({ from: 'recrutement@gmail.com', subject: 'Candidature chez Sloclap' }, studios)?.id).toBe('s1')
      expect(matchStudioFromEmail({ from: 'agency@headhunter.com', subject: 'Opportunité chez Dontnod Entertainment' }, studios)?.id).toBe('s3')
    })

    it('returns null when no studio matches', () => {
      expect(matchStudioFromEmail({ from: 'newsletter@medium.com', subject: 'Top Tech Art Tips' }, studios)).toBeNull()
    })
  })

  describe('processIncomingEmail and processEmailsBatch', () => {
    const sContacted = normalizeStudio({ id: 's1', name: 'Sloclap', link: 'https://sloclap.com', status: 'contacted' })
    const studios = [sContacted]

    it('ignores automated acknowledgment without modifying studio', () => {
      const email = { from: 'no-reply@sloclap.com', subject: 'We received your application for Tech Artist', date: '2026-10-07' }
      const res = processIncomingEmail(email, studios, '2026-10-07')
      expect(res.action).toBe('ignored')
      expect(res.reason).toBe('auto_acknowledgment')
    })

    it('advances studio status to interview when real interview invitation arrives', () => {
      const email = {
        from: 'recruiter@sloclap.com',
        subject: 'Entretien Tech Art Sloclap',
        body: 'Bonjour Matthieu, nous aimerions fixer un entretien visio cette semaine.',
        date: '2026-10-07',
      }
      const res = processIncomingEmail(email, studios, '2026-10-07')
      expect(res.action).toBe('updated')
      expect(res.targetStatus).toBe('interview')
      expect(res.updatedStudio.status).toBe('interview')
      expect(res.updatedStudio.messages).toHaveLength(1)
      expect(res.updatedStudio.messages[0].channel).toBe('mail')
      expect(res.updatedStudio.messages[0].text).toContain('Entretien Tech Art Sloclap')
    })

    it('batch processes multiple emails: ignores auto acks and updates matched studios', () => {
      const emails = [
        { from: 'no-reply@sloclap.com', subject: 'Thank you for your application', date: '2026-10-07' },
        { from: 'recruiter@sloclap.com', subject: 'Disponibilité pour un appel', body: 'Bonjour, êtes-vous disponible ?', date: '2026-10-07' },
        { from: 'inconnu@random.com', subject: 'Autre sujet', date: '2026-10-07' },
      ]
      const { studios: nextList, report } = processEmailsBatch(emails, studios, '2026-10-07')
      expect(report.ignoredAutoAcks).toBe(1)
      expect(report.unmatched).toBe(1)
      expect(report.updatedCount).toBe(1)
      expect(nextList[0].status).toBe('interview')
    })
  })
})
