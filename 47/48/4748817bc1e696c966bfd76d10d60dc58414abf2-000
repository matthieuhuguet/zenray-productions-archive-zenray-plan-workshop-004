// 18 October 2026 : Tests unitaires de ZenRay Books (Shelf C Registre Éditorial Minimaliste + Design C Double-Page Livre Ouvert)
import React from 'react'
import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest'
import { render, screen, fireEvent, cleanup } from '@testing-library/react'
import BooksView from './BooksView.jsx'

describe('ZenRay Books (Shelf C + Design C)', () => {
  beforeEach(() => {
    try { localStorage.clear() } catch {}
    global.fetch = vi.fn(() => Promise.resolve({ ok: false }))
  })
  afterEach(() => {
    cleanup()
  })

  it('renders Shelf C · Registre Éditorial Minimaliste with Create/Books files and opens Design C · Double-Page Livre Ouvert', () => {
    render(<BooksView />)
    expect(screen.getByText('Index des Livres')).toBeTruthy()
    expect(screen.getAllByText('The Win Without Pitching Manifesto').length).toBeGreaterThan(0)
    expect(screen.getAllByText('Convenience Store Woman').length).toBeGreaterThan(0)

    // Click on a book title in the register to open Design C · Double-Page Livre Ouvert
    fireEvent.click(screen.getAllByText('The Win Without Pitching Manifesto')[0])
    expect(screen.getByText(/Bibliothèque/i)).toBeTruthy()
    expect(screen.getByText(/Suivant/i)).toBeTruthy()
  })
})
