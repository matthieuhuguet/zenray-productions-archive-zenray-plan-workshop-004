const listFormat = {
  fr: (items) => items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} et ${items.at(-1)}`,
  en: (items) => items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items.at(-1)}`,
}

/** The studio as a greeting wants it: "d3t (Keywords Studios)" greets "d3t". */
export const greetingName = (name) => String(name || '').replace(/\s*\([^)]*\)\s*$/, '').trim() || String(name || '').trim()
export const studioKey = (name) => greetingName(name).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/\b(studios?|games?|interactive|entertainment)\b/g, '').replace(/[^a-z0-9]+/g, '')

function fill(text, values, where) {
  return text.replace(/\{([a-zA-Z]+)\}/g, (match, name) => {
    if (!(name in values)) throw new Error(`Letter template parameter {${name}} has no value (${where})`)
    return values[name]
  })
}

/** A role as a sentence wants it: no studio tag in brackets, no contract hint in trailing parentheses. */
export function cleanRole(role) {
  return String(role || '').replace(/^\s*\[[^\]]*\]\s*/, '').replace(/\s*\((?=[^)]*(?:contract|cdd|cdi|stage|intern|fixed term|h\/f|f\/h|m\/f|w\/m|full[- ]time|part[- ]time|\d+[- ]month))[^)]*\)\s*$/i, '').replace(/\s+/g, ' ').trim()
}

/** What the letter calls this opportunity. */
export function letterKind(studio) {
  const engine = studio.engine || {}
  if (engine.source === 'prospect') return 'spontaneous'
  if (/^Vivier de candidatures/i.test(studio.role || '')) return 'pool'
  if (!engine.source && !String(studio.id || '').startsWith('job_')) return 'spontaneous'
  if (engine.freelance) return 'freelance'
  if (engine.kind === 'internship') return 'internship'
  if (engine.kind === 'spontaneous') return 'pool'
  return 'offer'
}

/**
 * Composes one letter. Pure: same inputs, same text.
 * `template` is the cloud template (or SEED_TEMPLATE); `cv` comes from loadCv().
 */
export function composeLetter({ template, studio, cv, config, lang, hookOverride = null }) {
  const engine = studio.engine || {}
  const language = lang || engine.language || 'fr'
  const part = template[language] || template.fr
  const kind = letterKind(studio)
  const layoutName = kind === 'pool' || kind === 'spontaneous' ? 'spontaneous' : 'offer'
  const layout = template.layouts[layoutName]
  const role = cleanRole(String(studio.role || '').replace(/^Vivier de candidatures\s*:\s*/i, ''))
  const saved = template.hooks?.[studioKey(studio.name)]
  const name = saved?.greeting || greetingName(studio.name)
  const overlap = overlappingSkills(cv, engine.skills || [])
  let hook = ''
  let hookSource = 'none'
  const savedLanguage = saved && saved[language]
  if (savedLanguage) { hook = savedLanguage.text; hookSource = 'saved' }
  else if (saved && language !== 'fr' && saved.fr) { hook = ''; hookSource = 'saved-other-language' }
  else if (hookOverride && hookOverride.text) { hook = hookOverride.text; hookSource = hookOverride.source || 'claude' }
  else if (overlap.length && role && (kind === 'offer' || kind === 'freelance' || kind === 'internship')) {
    hook = fill(part.hookFromOffer, { role, skills: listFormat[language](overlap) }, 'hookFromOffer'); hookSource = 'offer'
  }

  const published = latestPublished(cv, config.latestWork.publishedCount, language)
  const latestWork = published.length ? fill(part.latestWork, { titles: listFormat[language](published.map((item) => item.title)) }, 'latestWork') : ''
  const values = { ...template.variables, studio: name, role, hook, latestWork, age: template.variables.age, portfolio: template.variables.portfolio }

  const blocks = { ...part.blocks, seeking: part.seekingVariants?.[kind] || part.blocks.seeking, reason: savedLanguage?.reason || part.reasons[kind] || part.reasons.offer }
  const paragraphs = []
  for (const id of layout) {
    if (!(id in blocks)) throw new Error(`Letter layout names a block that does not exist: ${id}`)
    if (id === 'hook' && !hook) continue
    const text = fill(blocks[id], values, id).trim()
    if (text) paragraphs.push(text)
  }
  const subject = fill(part.subjects[kind] || part.subjects.offer, values, 'subject')
  const body = noLongDash(paragraphs.join('\n\n'))
  const demandsSubject = /objet\s*:|subject line|in the subject|dans l[’']objet|mention.{0,30}(objet|subject)/i.test(`${studio.notes || ''}`)
  return {
    lang: language, kind, subject: noLongDash(subject), text: body, hookSource, hookText: hook, translated: Boolean(part.translated), subjectMayBeImposed: demandsSubject,
    latestWork: published.map((item) => ({ title: item.title, url: item.url })), cvFingerprint: cv.fingerprint, cvPdf: cv.pdf[language] || cv.pdf.en || '',
  }
}

/** A stable fingerprint of the letter's inputs, so an unchanged letter is never re-archived. */
export function letterFingerprint(letter) {
  return `${letter.lang}|${letter.kind}|${letter.cvFingerprint}|${letter.text}`
}

/**
 * The archive file of one vacancy: versions only ever grow, and an automatic draft never overwrites Matthieu's edit.
 * `explicit` is a request from the page ("regenerate"): it always appends a new version.
 */
export function updateArchive(archive, letter, { at, studioId, templateStatus, explicit = false }) {
  const current = archive && Array.isArray(archive.versions) ? archive : { v: 1, studioId, versions: [] }
  const last = current.versions.at(-1)
  const fingerprint = letterFingerprint(letter)
  if (!explicit && last && last.fingerprint === fingerprint) return { archive: current, changed: false }
  const entry = { at, by: 'engine', subject: letter.subject, text: letter.text, lang: letter.lang, kind: letter.kind, hookSource: letter.hookSource, hookText: letter.hookText, translated: letter.translated, subjectMayBeImposed: letter.subjectMayBeImposed, cvFingerprint: letter.cvFingerprint, latestWork: letter.latestWork, templateStatus, fingerprint, reason: explicit ? 'regenerate' : last ? 'refresh' : 'initial' }
  if (!explicit && last && last.by === 'matthieu') {
    // He edited the letter: his text stays current and the new automatic draft waits as a suggestion.
    if (current.suggested && current.suggested.fingerprint === fingerprint) return { archive: current, changed: false }
    return { archive: { ...current, suggested: entry }, changed: true }
  }
  const { suggested, ...rest } = current
  return { archive: { ...rest, studioId, versions: [...current.versions, entry] }, changed: true }
}
