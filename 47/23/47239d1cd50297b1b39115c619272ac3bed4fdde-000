// 9 October 2026, 01:41 CEST: Verify project scoping and Gallery filters without cloud writes.
import { describe, expect, it } from 'vitest'
import { browseLinkedProjectImages, filterLinkedProjectImages, linkedProjectImageFiles } from './linkedGalleryAssets.js'

const project = { id: 'louisiana-bayou', name: 'Louisiana Bayou' }

describe('linked gallery assets', () => {
  it('shows only backed-up image manifests belonging to the linked project', () => {
    const paths = [
      'pages/ZenRayAssets/louisiana-bayou/sources/houdini/production/Concept/Swamp.png.file.json',
      'pages/ZenRayAssets/louisiana-bayou/sources/unreal/game-assets/House.uasset.file.json',
      'pages/ZenRayAssets/another-project/sources/tmp/Concept/Other.png.file.json',
      'pages/ToDo-3D/Swamp.png.img.json',
      'pages/ZenRayAssets/louisiana-bayou/sources/memory/concepts/Board.img.json',
    ]
    const files = linkedProjectImageFiles(project, paths)

    expect(files.map((file) => file.name)).toEqual(['Board', 'Swamp.png'])
    expect(files[0]).toMatchObject({ source: 'memory', directory: 'sources/memory/concepts', type: 'image' })
    expect(files[1]).toMatchObject({ source: 'houdini', directory: 'sources/houdini/production/Concept', type: 'file' })
  })

  it('filters by source, folder, and accented search text', () => {
    const files = linkedProjectImageFiles(project, [
      'pages/ZenRayAssets/louisiana-bayou/sources/tmp/workshop/concepts/Érable.png.file.json',
      'pages/ZenRayAssets/louisiana-bayou/sources/houdini/production/textures/wood.png.file.json',
    ])

    expect(filterLinkedProjectImages(files, { source: 'tmp', search: 'erable' })).toHaveLength(1)
    expect(filterLinkedProjectImages(files, { directory: 'sources/houdini/production/textures' }).map((file) => file.name)).toEqual(['wood.png'])
  })

  it('browses cloud folders by source and parent path without mixing sibling folders', () => {
    const files = linkedProjectImageFiles(project, [
      'pages/ZenRayAssets/louisiana-bayou/sources/tmp/workshop/concepts/swamp.png.file.json',
      'pages/ZenRayAssets/louisiana-bayou/sources/tmp/workshop/references/bayou.png.file.json',
      'pages/ZenRayAssets/louisiana-bayou/sources/houdini/materials/wood.png.file.json',
    ])

    expect(browseLinkedProjectImages(files).folders).toEqual([
      { name: 'houdini', count: 1 },
      { name: 'tmp', count: 2 },
    ])
    expect(browseLinkedProjectImages(files, { path: ['tmp'] }).folders).toEqual([
      { name: 'workshop', count: 2 },
    ])
    expect(browseLinkedProjectImages(files, { path: ['tmp', 'workshop'] }).folders).toEqual([
      { name: 'concepts', count: 1 },
      { name: 'references', count: 1 },
    ])
    expect(browseLinkedProjectImages(files, { path: ['tmp', 'workshop', 'concepts'] }).files.map((file) => file.name)).toEqual(['swamp.png'])
    expect(browseLinkedProjectImages(files, { path: ['tmp'], search: 'wood' })).toMatchObject({ folders: [], files: [] })
  })
})
