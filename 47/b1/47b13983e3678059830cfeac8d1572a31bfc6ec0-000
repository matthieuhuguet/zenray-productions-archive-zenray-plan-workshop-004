// Carte F6 — famille Figma « Formes vectorielles » (polygone et étoile, formes paramétriques).
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { shapeClipPath } from './layers.js'

describe('F6 — polygone et étoile', () => {
  it('un calque forme accepte désormais polygone et étoile, avec des réglages par défaut sensés', () => {
    const l = readLayers(addLayer(vide(), 'shape', { shapeType: 'polygon' }))[0]
    expect(l.shapeSides).toBe(6)
    expect(l.shapeStarRatio).toBe(0.5)
  })

  it('le nombre de côtés est borné 3-12, jamais un polygone dégénéré ni une fausse ellipse', () => {
    expect(readLayers(addLayer(vide(), 'shape', { shapeSides: 1 }))[0].shapeSides).toBe(3)
    expect(readLayers(addLayer(vide(), 'shape', { shapeSides: 40 }))[0].shapeSides).toBe(12)
  })

  it('le ratio de l’étoile est borné 0.1-0.9, jamais un rayon interne nul ou confondu avec le bord', () => {
    expect(readLayers(addLayer(vide(), 'shape', { shapeStarRatio: 0 }))[0].shapeStarRatio).toBe(0.1)
    expect(readLayers(addLayer(vide(), 'shape', { shapeStarRatio: 1 }))[0].shapeStarRatio).toBe(0.9)
  })

  it('un rectangle, une ellipse, une ligne, un texte ou une image n’ont AUCUN clip-path', () => {
    expect(shapeClipPath({ shapeType: 'rectangle' })).toBe('')
    expect(shapeClipPath({ shapeType: 'ellipse' })).toBe('')
    expect(shapeClipPath({ shapeType: 'line' })).toBe('')
  })

  it('un polygone à 4 côtés dessine un losange, sommet en haut, sens horaire', () => {
    const cp = shapeClipPath({ shapeType: 'polygon', shapeSides: 4 })
    expect(cp).toBe('polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%)')
  })

  it('une étoile alterne un point EXTÉRIEUR (bord) et un point INTÉRIEUR (au ratio réglé)', () => {
    const cp = shapeClipPath({ shapeType: 'star', shapeSides: 4, shapeStarRatio: 0.5 })
    // Premier sommet : le bord, comme un polygone. Second sommet, à 45° : le rayon interne à 50%
    // du rayon externe, donc à 25% du cadre depuis le centre — mesuré, pas arrondi à l'œil.
    expect(cp.startsWith('polygon(50% 0%, 67.68% 32.32%,')).toBe(true)
  })

  it('la forme suit le CADRE, pas des pixels fixes : le clip-path reste en pourcentages', () => {
    const petite = shapeClipPath({ shapeType: 'polygon', shapeSides: 5 })
    const grande = shapeClipPath({ shapeType: 'polygon', shapeSides: 5 })
    expect(petite).toBe(grande)   // la géométrie ne dépend que des côtés, jamais de w/h
  })

  it('la forme (polygone/étoile) part réellement dans le clip-path de la page compilée', () => {
    let c = addLayer(vide(), 'shape', { shapeType: 'polygon', shapeSides: 5 })
    const { html } = compiler(c)
    expect(html).toContain('clip-path:polygon(')
  })

  it('un rectangle ne porte aucun clip-path dans la page compilée', () => {
    let c = addLayer(vide(), 'shape', { shapeType: 'rectangle' })
    const { html } = compiler(c)
    expect(html).not.toContain('clip-path')
  })
})

