// Carte P6 (PowerPoint) — famille « Transitions et animations » (entrée animée d'un calque).
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { animationOf, ANIMATION_STYLES } from './layers.js'

describe('PowerPoint P6 — entrée animée', () => {
  it('un calque neuf n’a aucune animation', () => {
    const l = readLayers(addLayer(vide(), 'text'))[0]
    expect(l.animationStyle).toBe('none')
    expect(l.animationDelay).toBe(0)
    expect(animationOf(l)).toBe('')
  })

  it('un style d’animation inconnu retombe sur "none"', () => {
    expect(readLayers(addLayer(vide(), 'text', { animationStyle: 'roll' }))[0].animationStyle).toBe('none')
  })

  it('le délai est borné 0-3000 ms', () => {
    expect(readLayers(addLayer(vide(), 'text', { animationDelay: -50 }))[0].animationDelay).toBe(0)
    expect(readLayers(addLayer(vide(), 'text', { animationDelay: 9999 }))[0].animationDelay).toBe(3000)
  })

  it('animationOf pose le nom du style ET le délai réel dans la propriété animation', () => {
    expect(animationOf({ animationStyle: 'rise', animationDelay: 300 })).toBe('animation:zrm-anim-rise 520ms var(--zrm-ease,ease) 300ms both')
  })

  it('la liste des styles reste fermée et complète', () => {
    expect(ANIMATION_STYLES).toEqual(['none', 'fade', 'rise', 'zoom'])
  })

  it('l’entrée animée ne part QUE dans l’aperçu interactif, jamais dans un export figé', () => {
    // Les @keyframes restent définies dans les deux voies (quelques octets de CSS non utilisé,
    // déjà le cas de zrm-in/zrm-lego-in) ; ce qui compte est que la propriété `animation:` ne
    // s'applique à AUCUN calque hors de l'aperçu interactif.
    let c = addLayer(vide(), 'text', { animationStyle: 'fade' })
    const { html: interactif } = compiler(c, { interactive: true })
    const { html: fige } = compiler(c)
    expect(interactif).toContain('animation:zrm-anim-fade')
    expect(fige).not.toContain('animation:zrm-anim-fade')
  })

  it('un calque SANS rotation anime directement sa boîte (pas de wrapper superflu)', () => {
    let c = addLayer(vide(), 'text', { animationStyle: 'zoom', rotation: 0 })
    const { html } = compiler(c, { interactive: true })
    expect(html).toContain('animation:zrm-anim-zoom')
  })

  it('un calque AVEC rotation garde sa rotation intacte même une fois l’entrée animée terminée', () => {
    // La rotation vit dans le style de la boîte externe (transformOf), l'animation sur un wrapper
    // interne : le `to{transform:none}` du keyframe ne doit JAMAIS effacer la rotation du calque.
    let c = addLayer(vide(), 'shape', { rotation: 45, animationStyle: 'rise' })
    const { html } = compiler(c, { interactive: true })
    expect(html).toContain('transform:rotate(45deg)')
    expect(html).toContain('zrm-anim-rise')
    // La rotation doit se trouver sur la boîte EXTÉRIEURE, pas sur le wrapper qui porte l'animation.
    const boiteExterne = html.match(/<div class="zrm-layer[^>]*style="([^"]*)"/)[1]
    expect(boiteExterne).toContain('transform:rotate(45deg)')
    expect(boiteExterne).not.toContain('animation:')
  })
})

