// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Carte M6 (Miro) — famille « Connecteurs, lignes et flèches ».
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { connectorGeometry, createConnector, applyConnectors } from './layers.js'

describe('Miro M6 — connecteurs', () => {
  it('un calque neuf n’est pas un connecteur', () => {
    const l = readLayers(addLayer(vide(), 'shape'))[0]
    expect(l.connectFrom).toBe('')
    expect(l.connectTo).toBe('')
  })

  it('connectorGeometry relie les CENTRES de deux calques, en boîte englobante', () => {
    // A : centre (50,50). B : centre (250,150). Boîte : x=50,y=50,w=200,h=100.
    const a = { x: 0, y: 0, w: 100, h: 100 }
    const b = { x: 200, y: 100, w: 100, h: 100 }
    const geo = connectorGeometry(a, b)
    expect(geo).toEqual({ x: 50, y: 50, w: 200, h: 100, connectorX1: 0, connectorY1: 0, connectorX2: 200, connectorY2: 100 })
  })

  it('deux calques au même centre donnent une boîte de 1×1, jamais 0×0 (invisible)', () => {
    const a = { x: 0, y: 0, w: 100, h: 100 }
    const geo = connectorGeometry(a, a)
    expect(geo.w).toBe(1)
    expect(geo.h).toBe(1)
  })

  it('createConnector pose un calque connecteur entre deux calques EXISTANTS', () => {
    let c = addLayer(vide(), 'shape', { name: 'A', x: 0, y: 0, w: 100, h: 100 })
    c = addLayer(c, 'shape', { name: 'B', x: 200, y: 100, w: 100, h: 100 })
    const [a, b] = readLayers(c)
    c = createConnector(c, a.id, b.id)
    const connecteur = readLayers(c).find((l) => l.name === 'Connecteur')
    expect(connecteur).toBeTruthy()
    expect(connecteur.connectFrom).toBe(a.id)
    expect(connecteur.connectTo).toBe(b.id)
    expect(connecteur.w).toBe(200)
  })

  it('createConnector refuse un calque introuvable, ou relier un calque à lui-même', () => {
    let c = addLayer(vide(), 'shape', { name: 'A' })
    const a = readLayers(c)[0]
    expect(createConnector(c, a.id, 'inconnu')).toBe(c)
    expect(createConnector(c, a.id, a.id)).toBe(c)
  })

  it('applyConnectors RECALCULE la géométrie quand un calque relié se déplace', () => {
    let c = addLayer(vide(), 'shape', { name: 'A', x: 0, y: 0, w: 100, h: 100 })
    c = addLayer(c, 'shape', { name: 'B', x: 200, y: 100, w: 100, h: 100 })
    const [a, b] = readLayers(c)
    c = createConnector(c, a.id, b.id)
    // B se déplace loin : le connecteur, lui, n'a pas été retouché directement.
    c = patchLayer(c, b.id, { x: 1000, y: 1000 })
    c = applyConnectors(c)
    const connecteur = readLayers(c).find((l) => l.name === 'Connecteur')
    // Nouveau centre de B : (1050,1050). Centre de A inchangé : (50,50).
    expect(connecteur.w).toBe(1000)
    expect(connecteur.h).toBe(1000)
  })

  it('un connecteur dont UN bout a été supprimé fige la référence morte, sans toucher au bout resté valide', () => {
    let c = addLayer(vide(), 'shape', { name: 'A' })
    c = addLayer(c, 'shape', { name: 'B' })
    const [a, b] = readLayers(c)
    c = createConnector(c, a.id, b.id)
    c = removeLayer(c, b.id)   // seul B disparaît, A existe toujours
    const connecteur = readLayers(c).find((l) => l.name === 'Connecteur')
    expect(connecteur.connectFrom).toBe(a.id)   // A existe encore : la référence reste valide
    expect(connecteur.connectTo).toBe('')       // B n'existe plus : la relecture invalide la référence morte
  })

  it('applyConnectors ne touche à rien si aucun calque n’est un connecteur (même référence)', () => {
    const c = addLayer(vide(), 'shape')
    expect(applyConnectors(c)).toBe(c)
  })

  it('le connecteur compile en <svg><line> réel, positionné par ses points relatifs', () => {
    let c = addLayer(vide(), 'shape', { name: 'A', x: 0, y: 0, w: 100, h: 100 })
    c = addLayer(c, 'shape', { name: 'B', x: 200, y: 100, w: 100, h: 100 })
    const [a, b] = readLayers(c)
    c = createConnector(c, a.id, b.id)
    const { html } = compiler(c)
    expect(html).toContain('<svg class="zrm-layer-connector" viewBox="0 0 200 100"')
    expect(html).toContain('<line x1="0" y1="0" x2="200" y2="100"')
  })

  it('un connecteur ne porte JAMAIS l’attribut data-shape, contrairement aux formes qu’il relie', () => {
    // A et B sont des rectangles ORDINAIRES : ils gardent légitimement data-shape="rectangle".
    // Seul l'élément du CONNECTEUR lui-même doit en être dépourvu.
    let c = addLayer(vide(), 'shape', { name: 'A' })
    c = addLayer(c, 'shape', { name: 'B', x: 300 })
    const [a, b] = readLayers(c)
    c = createConnector(c, a.id, b.id)
    const connecteur = readLayers(c).find((l) => l.name === 'Connecteur')
    const { html } = compiler(c)
    const doc = new DOMParser().parseFromString(html, 'text/html')
    const el = doc.querySelector(`[data-zrm-layer="${connecteur.id}"]`)
    expect(el).toBeTruthy()
    expect(el.hasAttribute('data-shape')).toBe(false)
  })
})

// AUDIT P1-R10 · le connecteur créé par `createConnector` contournait `poserCalque` et gardait
// `groupId:null`, devenant un masque global rendu sur TOUTES les diapositives même quand ses deux
// extrémités appartenaient à une seule. Rien n'empêchait non plus de relier deux pages différentes.
// Son rendu gardait en outre un fond plein hérité de `.zrm-layer-shape`, capable de peindre tout le
// rectangle englobant derrière le trait — une diagonale entre deux coins opposés pouvait alors
// masquer le contenu entre les deux, bien plus grand que les deux pixels réellement visibles.
describe('Miro M6 / InDesign D1 — le connecteur appartient à une page (AUDIT P1-R10)', () => {
  it('un connecteur entre deux calques SANS page hérite `groupId:null`, comme avant', () => {
    let c = addLayer(vide(), 'shape', { name: 'A' })
    c = addLayer(c, 'shape', { name: 'B' })
    const [a, b] = readLayers(c)
    c = createConnector(c, a.id, b.id)
    const connecteur = readLayers(c).find((l) => l.name === 'Connecteur')
    expect(connecteur.groupId).toBe(null)
  })

  it('un connecteur entre deux calques de la MÊME diapositive hérite SON groupId, jamais null', () => {
    let c = addSlide(vide(), 'Diapo')
    const [diapo] = readSlides(c)
    c = addLayer(c, 'shape', { name: 'A', groupId: diapo.groupId })
    c = addLayer(c, 'shape', { name: 'B', groupId: diapo.groupId })
    const [a, b] = readLayers(c)
    c = createConnector(c, a.id, b.id)
    const connecteur = readLayers(c).find((l) => l.name === 'Connecteur')
    expect(connecteur.groupId).toBe(diapo.groupId)
  })

  it('REFUSE de relier deux calques de DEUX diapositives différentes', () => {
    let c = addSlide(vide(), 'Diapo A')
    c = addSlide(c, 'Diapo B')
    const [diapoA, diapoB] = readSlides(c)
    c = addLayer(c, 'shape', { name: 'A', groupId: diapoA.groupId })
    c = addLayer(c, 'shape', { name: 'B', groupId: diapoB.groupId })
    const [a, b] = readLayers(c)
    const avant = c
    c = createConnector(c, a.id, b.id)
    expect(c).toBe(avant)   // refus pur : aucun connecteur créé
    expect(readLayers(c).some((l) => l.name === 'Connecteur')).toBe(false)
  })

  it('REFUSE de relier un calque de page à un calque global (masque)', () => {
    let c = addSlide(vide(), 'Diapo')
    const [diapo] = readSlides(c)
    c = addLayer(c, 'shape', { name: 'A', groupId: diapo.groupId })
    c = addLayer(c, 'shape', { name: 'B' })   // global, groupId null
    const [a, b] = readLayers(c)
    expect(createConnector(c, a.id, b.id)).toBe(c)
  })

  it('la page compilée ne porte JAMAIS de fond sur un connecteur, uni ou dégradé', () => {
    let c = addLayer(vide(), 'shape', { name: 'A', x: 0, y: 0, w: 100, h: 100, style: { backgroundColor: '#ff0000' }, fillType: 'gradient', gradientFrom: '#ff0000', gradientTo: '#00ff00' })
    c = addLayer(c, 'shape', { name: 'B', x: 300, y: 0, w: 100, h: 100 })
    const [a, b] = readLayers(c)
    // Le connecteur lui-même reçoit aussi un fond et un dégradé, pour prouver que ni l'un ni
    // l'autre ne fuit dans le HTML compilé malgré leur présence dans le modèle.
    c = createConnector(c, a.id, b.id)
    const connecteur = readLayers(c).find((l) => l.name === 'Connecteur')
    c = patchLayer(c, connecteur.id, { style: { backgroundColor: '#0000ff' }, fillType: 'gradient', gradientFrom: '#0000ff', gradientTo: '#ffff00' })
    const { html } = compiler(c)
    const doc = new DOMParser().parseFromString(html, 'text/html')
    const el = doc.querySelector(`[data-zrm-layer="${connecteur.id}"]`)
    // Chaîne brute de l'attribut plutôt que `.style.backgroundColor` : la lecture CSSOM d'un
    // raccourci comme `background:linear-gradient(...)` dépend d'un support d'abréviation que
    // jsdom n'implémente pas forcément fidèlement — la CHAÎNE, elle, ne ment jamais.
    const styleAttr = el.getAttribute('style') || ''
    expect(styleAttr).not.toContain('background-color')
    expect(styleAttr).not.toContain('background:')
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Carte I2 (Illustrator) — famille « Création et modification de tracés vectoriels » (l'outil Plume).
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { pathD, createPathLayer, movePathAnchor, movePathHandle, removePathPoint, insertPathPoint } from './layers.js'

describe('Illustrator I2 — tracé vectoriel (Plume)', () => {
  it('un calque neuf n’a aucun point : ce n’est pas un tracé', () => {
    const l = readLayers(addLayer(vide(), 'shape'))[0]
    expect(l.pathPoints).toEqual([])
    expect(l.pathClosed).toBe(false)
  })

  it('pathD relie deux points d’ANGLE par une courbe plate (poignées confondues avec l’ancre)', () => {
    const points = [
      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },
      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },
    ]
    expect(pathD(points, false)).toBe('M 0 0 C 0 0 100 0 100 0')
  })

  it('pathD ferme le tracé (Z) et relie le dernier point au premier quand closed=true', () => {
    const points = [
      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },
      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },
      { x: 50, y: 100, inX: 50, inY: 100, outX: 50, outY: 100 },
    ]
    expect(pathD(points, true)).toBe('M 0 0 C 0 0 100 0 100 0 C 100 0 50 100 50 100 C 50 100 0 0 0 0 Z')
  })

  it('pathD ne ferme jamais un tracé de seulement deux points (rien « entre » à boucler)', () => {
    const points = [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 }]
    expect(pathD(points, true)).not.toContain('Z')
  })

  it('pathD rend une chaîne vide sous deux points : rien à tracer', () => {
    expect(pathD([{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }], false)).toBe('')
    expect(pathD([], false)).toBe('')
  })

  it('createPathLayer calcule la boîte englobante EN INCLUANT les poignées, jamais seulement les ancres', () => {
    // Ancres à (0,0) et (100,0), mais une poignée déborde jusqu'à y=-50 : la boîte doit la contenir.
    const points = [
      { x: 0, y: 0, inX: 0, inY: 0, outX: 20, outY: -50 },
      { x: 100, y: 0, inX: 80, inY: -50, outX: 100, outY: 0 },
    ]
    let c = createPathLayer(vide(), points, false)
    const l = readLayers(c).find((x) => x.name === 'Tracé')
    expect(l.y).toBe(-50)
    expect(l.h).toBe(50)
  })

  it('createPathLayer normalise les points en POURCENTAGE 0-100 de la boîte calculée', () => {
    const points = [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 200, y: 100, inX: 200, inY: 100, outX: 200, outY: 100 }]
    let c = createPathLayer(vide(), points, false)
    const l = readLayers(c).find((x) => x.name === 'Tracé')
    expect(l.pathPoints[0]).toEqual({ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 })
    expect(l.pathPoints[1]).toEqual({ x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 })
  })

  it('createPathLayer refuse un tracé de moins de deux points', () => {
    const c = vide()
    expect(createPathLayer(c, [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }], false)).toBe(c)
    expect(createPathLayer(c, [], false)).toBe(c)
  })

  it('movePathAnchor déplace l’ancre ET ses deux poignées PAR LA MÊME TRANSLATION', () => {
    const points = [{ x: 10, y: 10, inX: 0, inY: 0, outX: 20, outY: 20 }]
    const suivant = movePathAnchor(points, 0, 15, 25)
    // Delta : +5 en x, +15 en y. Les poignées suivent exactement ce même déplacement.
    expect(suivant[0]).toEqual({ x: 15, y: 25, inX: 5, inY: 15, outX: 25, outY: 35 })
  })

  it('movePathHandle déplace UNE SEULE poignée, sans toucher à l’autre ni à l’ancre', () => {
    const points = [{ x: 10, y: 10, inX: 0, inY: 0, outX: 20, outY: 20 }]
    const suivant = movePathHandle(points, 0, 'out', 50, 60)
    expect(suivant[0]).toEqual({ x: 10, y: 10, inX: 0, inY: 0, outX: 50, outY: 60 })
  })

  it('removePathPoint retire un point, mais jamais sous deux points restants', () => {
    const points = [
      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },
      { x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 },
      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },
    ]
    const deuxPoints = removePathPoint(points, 1)
    expect(deuxPoints).toHaveLength(2)
    const plancher = removePathPoint(deuxPoints, 0)
    expect(plancher).toBe(deuxPoints)   // refuse de descendre sous deux points
  })

  it('insertPathPoint ajoute un point d’ANGLE (poignées confondues) juste après l’index donné', () => {
    const points = [{ x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 }]
    const suivant = insertPathPoint(points, 0, 50, 30)
    expect(suivant).toHaveLength(3)
    expect(suivant[1]).toEqual({ x: 50, y: 30, inX: 50, inY: 30, outX: 50, outY: 30 })
  })

  it('un point hors 0-100 est ramené dans les bornes à la relecture, jamais laissé libre', () => {
    let c = addLayer(vide(), 'shape', { pathPoints: [{ x: -10, y: 150, inX: 0, inY: 0, outX: 0, outY: 0 }, { x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 }] })
    const l = readLayers(c)[0]
    expect(l.pathPoints[0].x).toBe(0)
    expect(l.pathPoints[0].y).toBe(100)
  })

  it('le tracé compile en <svg><path> réel, avec le fond et le contour du calque', () => {
    let c = createPathLayer(vide(), [
      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },
      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },
    ], false)
    const tracé = readLayers(c).find((l) => l.name === 'Tracé')
    c = patchLayer(c, tracé.id, { style: { backgroundColor: '#ffcc00' } })
    const { html } = compiler(c)
    expect(html).toContain('<svg')
    expect(html).toContain('fill="#ffcc00"')
    expect(html).toContain('stroke="#151515"')
  })

  it('un tracé SANS fond réglé ne peint aucune surface (fill="none"), seulement son contour', () => {
    let c = createPathLayer(vide(), [
      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },
      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },
    ], false)
    const { html } = compiler(c)
    expect(html).toContain('fill="none"')
  })

  it('un tracé ne porte JAMAIS l’attribut data-shape : sa géométrie n’est pas une forme paramétrique', () => {
    let c = createPathLayer(vide(), [
      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },
      { x: 100, y: 100, inX: 100, inY: 100, outX: 100, outY: 100 },
    ], false)
    const tracé = readLayers(c).find((l) => l.name === 'Tracé')
    const { html } = compiler(c)
    const doc = new DOMParser().parseFromString(html, 'text/html')
    const el = doc.querySelector(`[data-zrm-layer="${tracé.id}"]`)
    expect(el.hasAttribute('data-shape')).toBe(false)
  })
})

// Carte I2 (suite) — édition d'un tracé DÉJÀ posé : convertir un point, ajouter un point sur un
// segment existant. La Sélection directe d'Illustrator, plutôt qu'un second outil séparé — ici un
// seul et même calque de tracé, sélectionné, expose ses points à l'édition.
import { toggleAnchorSmoothness, nearestPointOnTrace, pathPointsInPixels } from './layers.js'

describe('Illustrator I2 — convertir et insérer un point sur un tracé existant', () => {
  it('pathPointsInPixels convertit chaque coordonnée de pourcentage (0-100) en pixels réels du calque', () => {
    const layer = { w: 200, h: 50, pathPoints: [{ x: 0, y: 0, inX: 0, inY: 0, outX: 50, outY: 100 }] }
    expect(pathPointsInPixels(layer)).toEqual([{ x: 0, y: 0, inX: 0, inY: 0, outX: 100, outY: 50 }])
  })

  it('convertit un point d’ANGLE en point LISSE : les poignées sortent le long de la tangente aux voisins', () => {
    const points = [
      { x: 0, y: 50, inX: 0, inY: 50, outX: 0, outY: 50 },
      { x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 },   // point d'angle, au milieu
      { x: 100, y: 50, inX: 100, inY: 50, outX: 100, outY: 50 },
    ]
    const suivant = toggleAnchorSmoothness(points, 1, false)
    // Voisins alignés sur l'axe x : la tangente est horizontale, les poignées s'écartent en x, pas en y.
    expect(suivant[1].outX).toBeGreaterThan(50)
    expect(suivant[1].inX).toBeLessThan(50)
    expect(suivant[1].outY).toBe(50)
    expect(suivant[1].inY).toBe(50)
  })

  it('convertit un point LISSE en point d’ANGLE : les deux poignées reviennent exactement sur l’ancre', () => {
    const points = [{ x: 50, y: 50, inX: 30, inY: 40, outX: 70, outY: 60 }]
    const suivant = toggleAnchorSmoothness(points, 0, false)
    expect(suivant[0]).toEqual({ x: 50, y: 50, inX: 50, inY: 50, outX: 50, outY: 50 })
  })

  it('convertir le SEUL point d’un bout de tracé ouvert utilise son unique voisin, sans jamais planter', () => {
    const points = [
      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },
      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },
    ]
    const suivant = toggleAnchorSmoothness(points, 0, false)
    expect(suivant[0].outX).toBeGreaterThan(0)   // tiré vers l'unique voisin, à droite
  })

  it('nearestPointOnTrace trouve un point EXACTEMENT sur la courbe, près d’un clic à côté d’elle', () => {
    const points = [
      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },
      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },
    ]
    // Segment plat sur y=0 : cliquer à (50, 6) doit accrocher un échantillon proche de (50, 0).
    const trouve = nearestPointOnTrace(points, false, 50, 6)
    expect(trouve.afterIndex).toBe(0)
    expect(trouve.x).toBeCloseTo(50, 0)
    expect(trouve.y).toBeCloseTo(0, 0)
  })

  it('nearestPointOnTrace identifie le bon SEGMENT parmi plusieurs, jamais le premier par défaut', () => {
    const points = [
      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },
      { x: 50, y: 0, inX: 50, inY: 0, outX: 50, outY: 0 },
      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },
    ]
    const trouve = nearestPointOnTrace(points, false, 80, 0)
    expect(trouve.afterIndex).toBe(1)   // le second segment, entre les points 1 et 2
  })

  it('insérer via nearestPointOnTrace place le nouveau point SUR la courbe, réellement au milieu', () => {
    const points = [
      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },
      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },
    ]
    const trouve = nearestPointOnTrace(points, false, 50, 0)
    const suivant = insertPathPoint(points, trouve.afterIndex, trouve.x, trouve.y)
    expect(suivant).toHaveLength(3)
    expect(suivant[1].x).toBeCloseTo(50, 0)
  })

  it('nearestPointOnTrace couvre aussi le segment de FERMETURE d’un tracé fermé', () => {
    const points = [
      { x: 0, y: 0, inX: 0, inY: 0, outX: 0, outY: 0 },
      { x: 100, y: 0, inX: 100, inY: 0, outX: 100, outY: 0 },
      { x: 50, y: 100, inX: 50, inY: 100, outX: 50, outY: 100 },
    ]
    // (25, 50) est sur le segment de retour du dernier point (50,100) vers le premier (0,0).
    const trouve = nearestPointOnTrace(points, true, 25, 50)
    expect(trouve.afterIndex).toBe(2)
  })
})

// Carte D1 (InDesign) — pages parentes : un gabarit nommé et réutilisable, que chaque diapositive
// applique ou non, avec remplacement local par attribut et détachement complet.
import {
  readParentPages, addParentPage, patchParentPage, removeParentPage, parentPageChain,
  setSlideParent, setSlideParentHidden, readParentOverrides, overrideParentLayer, restoreParentLayer,
  detachParentLayer, effectiveSlideLayers, setActivePageParent,
} from './layers.js'

describe('InDesign D1 — pages parentes', () => {
  it('addParentPage crée un groupe dédié et une entrée dans parentPages', () => {
    const c = addParentPage(vide(), 'Gabarit')
    const pages = readParentPages(c)
    expect(pages).toHaveLength(1)
    expect(pages[0].name).toBe('Gabarit')
    expect(readGroups(c).some((g) => g.id === pages[0].groupId)).toBe(true)
  })

  it('une page parente ne peut pas être fondée sur elle-même, ni sur un identifiant inexistant', () => {
    let c = addParentPage(vide(), 'A')
    const a = readParentPages(c)[0]
    c = addParentPage(c, 'B', a.id)
    const b = readParentPages(c).find((p) => p.name === 'B')
    expect(b.basedOnId).toBe(a.id)
    c = patchParentPage(c, a.id, { basedOnId: a.id })
    // La lecture ne filtre le cycle direct qu'à la relecture normalisée : on le vérifie via
    // `readParentPages`, jamais sur l'écriture brute.
    expect(readParentPages(c).find((p) => p.id === a.id).basedOnId).toBe(null)
    c = patchParentPage(c, a.id, { basedOnId: 'inexistant' })
    expect(readParentPages(c).find((p) => p.id === a.id).basedOnId).toBe(null)
  })

  it('parentPageChain remonte toute la chaîne, de la plus proche à la plus lointaine', () => {
    let c = addParentPage(vide(), 'Racine')
    const racine = readParentPages(c)[0]
    c = addParentPage(c, 'Milieu', racine.id)
    const milieu = readParentPages(c).find((p) => p.name === 'Milieu')
    c = addParentPage(c, 'Proche', milieu.id)
    const proche = readParentPages(c).find((p) => p.name === 'Proche')
    const chaine = parentPageChain(c, proche.id)
    expect(chaine.map((p) => p.name)).toEqual(['Proche', 'Milieu', 'Racine'])
  })

  it('parentPageChain ne boucle jamais, même si deux pages se fondent l’une sur l’autre', () => {
    let c = addParentPage(vide(), 'A')
    const a = readParentPages(c)[0]
    c = addParentPage(c, 'B', a.id)
    const b = readParentPages(c).find((p) => p.name === 'B')
    // On force un cycle directement dans les données brutes (contournant le garde-fou de patch),
    // pour vérifier que la LECTURE de la chaîne s'arrête tout de même.
    c = { ...c, parentPages: c.parentPages.map((p) => (p.id === a.id ? { ...p, basedOnId: b.id } : p)) }
    const chaine = parentPageChain(c, a.id)
    expect(chaine).toHaveLength(2)   // s'arrête dès qu'un id déjà vu revient, jamais une boucle infinie
  })

  it('removeParentPage retire le groupe et ses calques, et ramène les diapositives à [Sans]', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = addLayer(c, 'text', { groupId: parent.groupId, name: 'En-tête' })
    c = addSlide(c, 'Page 1')
    const slide = readSlides(c)[0]
    c = setSlideParent(c, slide.id, parent.id)
    expect(readSlides(c)[0].parentPageId).toBe(parent.id)

    c = removeParentPage(c, parent.id)
    expect(readParentPages(c)).toHaveLength(0)
    expect(readLayers(c).some((l) => l.name === 'En-tête')).toBe(false)
    expect(readSlides(c)[0].parentPageId).toBe(null)
  })

  it('removeParentPage répare les pages parentes FONDÉES SUR celle qui disparaît, sans les supprimer', () => {
    let c = addParentPage(vide(), 'Racine')
    const racine = readParentPages(c)[0]
    c = addParentPage(c, 'Enfant', racine.id)
    c = removeParentPage(c, racine.id)
    const enfant = readParentPages(c).find((p) => p.name === 'Enfant')
    expect(enfant).toBeTruthy()
    expect(enfant.basedOnId).toBe(null)
  })

  it('setSlideParent refuse un identifiant de page parente qui n’existe pas', () => {
    let c = addSlide(vide(), 'Page 1')
    const slide = readSlides(c)[0]
    const suivant = setSlideParent(c, slide.id, 'inexistant')
    expect(readSlides(suivant)[0].parentPageId).toBe(null)
  })

  it('effectiveSlideLayers est vide sans page parente assignée, ou si elle est masquée sur cette diapositive', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = addLayer(c, 'text', { groupId: parent.groupId })
    c = addSlide(c, 'Page 1')
    const slide = readSlides(c)[0]
    expect(effectiveSlideLayers(c, slide.id)).toHaveLength(0)   // aucune page parente assignée

    c = setSlideParent(c, slide.id, parent.id)
    expect(effectiveSlideLayers(c, slide.id)).toHaveLength(1)

    c = setSlideParentHidden(c, slide.id, true)
    expect(effectiveSlideLayers(c, slide.id)).toHaveLength(0)   // masqué temporairement
    c = setSlideParentHidden(c, slide.id, false)
    expect(effectiveSlideLayers(c, slide.id)).toHaveLength(1)   // réapparaît intact
  })

  it('effectiveSlideLayers peint TOUJOURS derrière : son z synthétique reste sous tout calque réel', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = addLayer(c, 'text', { groupId: parent.groupId })
    c = addSlide(c, 'Page 1')
    const slide = readSlides(c)[0]
    c = setSlideParent(c, slide.id, parent.id)
    c = addLayer(c, 'shape', { groupId: slide.groupId })
    const [herite] = effectiveSlideLayers(c, slide.id)
    const local = readLayers(c).find((l) => l.groupId === slide.groupId)
    expect(herite.z).toBeLessThan(local.z)
  })

  it('effectiveSlideLayers remonte TOUTE la chaîne d’héritage, pas seulement le parent direct', () => {
    let c = addParentPage(vide(), 'Racine')
    const racine = readParentPages(c)[0]
    c = addLayer(c, 'text', { groupId: racine.groupId, name: 'Logo racine' })
    c = addParentPage(c, 'Enfant', racine.id)
    const enfant = readParentPages(c).find((p) => p.name === 'Enfant')
    c = addLayer(c, 'text', { groupId: enfant.groupId, name: 'Titre enfant' })
    c = addSlide(c, 'Page 1')
    const slide = readSlides(c)[0]
    c = setSlideParent(c, slide.id, enfant.id)
    const noms = effectiveSlideLayers(c, slide.id).map((l) => l.name)
    expect(noms).toEqual(expect.arrayContaining(['Logo racine', 'Titre enfant']))
  })

  it('overrideParentLayer remplace SEULEMENT cette diapositive, jamais la page parente ni les autres', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = addLayer(c, 'text', { groupId: parent.groupId, x: 10, opacity: 1 })
    const [calque] = readLayers(c)
    c = addSlide(c, 'Page A')
    c = addSlide(c, 'Page B')
    const [pageA, pageB] = readSlides(c)
    c = setSlideParent(c, pageA.id, parent.id)
    c = setSlideParent(c, pageB.id, parent.id)

    c = overrideParentLayer(c, pageA.id, calque.id, { x: 500 })
    expect(effectiveSlideLayers(c, pageA.id)[0].x).toBe(500)
    expect(effectiveSlideLayers(c, pageB.id)[0].x).toBe(10)   // page B n'a jamais été touchée
    expect(readLayers(c).find((l) => l.id === calque.id).x).toBe(10)   // la page parente non plus
  })

  it('un second remplacement local FUSIONNE avec le premier, il ne l’écrase pas', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = addLayer(c, 'text', { groupId: parent.groupId, x: 10, y: 20 })
    const [calque] = readLayers(c)
    c = addSlide(c, 'Page 1')
    const slide = readSlides(c)[0]
    c = setSlideParent(c, slide.id, parent.id)
    c = overrideParentLayer(c, slide.id, calque.id, { x: 500 })
    c = overrideParentLayer(c, slide.id, calque.id, { opacity: 0.5 })
    const resolu = effectiveSlideLayers(c, slide.id)[0]
    expect(resolu.x).toBe(500)   // le premier remplacement survit
    expect(resolu.opacity).toBe(0.5)
    expect(resolu.y).toBe(20)   // jamais touché, reste hérité
  })

  it('restoreParentLayer efface le remplacement : l’objet revient EXACTEMENT à la page parente', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = addLayer(c, 'text', { groupId: parent.groupId, x: 10 })
    const [calque] = readLayers(c)
    c = addSlide(c, 'Page 1')
    const slide = readSlides(c)[0]
    c = setSlideParent(c, slide.id, parent.id)
    c = overrideParentLayer(c, slide.id, calque.id, { x: 500 })
    expect(effectiveSlideLayers(c, slide.id)[0].overridden).toBe(true)
    c = restoreParentLayer(c, slide.id, calque.id)
    expect(effectiveSlideLayers(c, slide.id)[0].x).toBe(10)
    expect(effectiveSlideLayers(c, slide.id)[0].overridden).toBe(false)
    expect(readParentOverrides(c)).toHaveLength(0)
  })

  it('detachParentLayer matérialise un calque RÉEL et INDÉPENDANT, remplacements compris, sans toucher au parent', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = addLayer(c, 'text', { groupId: parent.groupId, x: 10, source: 'Modèle' })
    const [calque] = readLayers(c)
    c = addSlide(c, 'Page 1')
    const slide = readSlides(c)[0]
    c = setSlideParent(c, slide.id, parent.id)
    c = overrideParentLayer(c, slide.id, calque.id, { x: 500 })

    c = detachParentLayer(c, slide.id, calque.id)
    expect(effectiveSlideLayers(c, slide.id)).toHaveLength(0)   // plus rien d'hérité : c'est réel maintenant
    const detache = readLayers(c).find((l) => l.groupId === slide.groupId)
    expect(detache).toBeTruthy()
    expect(detache.x).toBe(500)          // la valeur ACTUELLE (remplacement compris), figée
    expect(detache.source).toBe('Modèle')
    expect(readParentOverrides(c)).toHaveLength(0)   // le remplacement n'a plus de sens, il est effacé
    expect(readLayers(c).find((l) => l.id === calque.id).x).toBe(10)   // le modèle original, intact
  })

  it('un calque hérité mais MASQUÉ SUR SA PAGE PARENTE elle-même n’apparaît sur aucune diapositive', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = addLayer(c, 'text', { groupId: parent.groupId, hidden: true })
    c = addSlide(c, 'Page 1')
    const slide = readSlides(c)[0]
    c = setSlideParent(c, slide.id, parent.id)
    expect(effectiveSlideLayers(c, slide.id)).toHaveLength(0)
  })

  it('masquer LE GROUPE d’une page parente (geste générique déjà offert à tout groupe) masque aussi ses éléments hérités', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = addLayer(c, 'text', { groupId: parent.groupId })
    c = addSlide(c, 'Page 1')
    const slide = readSlides(c)[0]
    c = setSlideParent(c, slide.id, parent.id)
    expect(effectiveSlideLayers(c, slide.id)).toHaveLength(1)
    c = patchGroup(c, parent.groupId, { hidden: true })
    expect(effectiveSlideLayers(c, slide.id)).toHaveLength(0)
  })

  it('un calque posé SUR une page parente ne se peint JAMAIS comme un calque universel ordinaire, même sur une diapositive qui n’applique pas cette page', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = addLayer(c, 'text', { groupId: parent.groupId, name: 'En-tête' })
    c = addSlide(c, 'Page sans parent')
    const slide = readSlides(c)[0]
    c = { ...c, activeSlideId: slide.id }
    // Sans le correctif, un calque de page parente n'a de diapositive assortie nulle part et
    // `isEffectivelyHidden` le traiterait comme un masque universel, visible partout.
    const calque = readLayers(c).find((l) => l.name === 'En-tête')
    expect(isEffectivelyHidden(c, calque)).toBe(true)
    expect(effectiveSlideLayers(c, slide.id)).toHaveLength(0)
  })

  it('la page compilée montre RÉELLEMENT le contenu hérité sur la diapositive qui applique la page parente', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = addLayer(c, 'text', { groupId: parent.groupId, source: 'En-tête récurrent' })
    c = addSlide(c, 'Page 1')
    const slide = readSlides(c)[0]
    c = setSlideParent(c, slide.id, parent.id)
    c = { ...c, activeSlideId: slide.id }
    const { html } = compiler(c)
    expect(html).toContain('En-tête récurrent')
  })

  it('la même page compilée ne montre RIEN de la page parente sur une diapositive qui ne l’applique pas', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = addLayer(c, 'text', { groupId: parent.groupId, source: 'En-tête récurrent' })
    c = addSlide(c, 'Page sans parent')
    const slide = readSlides(c)[0]
    c = { ...c, activeSlideId: slide.id }
    const { html } = compiler(c)
    expect(html).not.toContain('En-tête récurrent')
  })

  it('l’hérité compile bien DERRIÈRE (z-index plus petit) que le contenu propre de la diapositive', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = addLayer(c, 'text', { groupId: parent.groupId, source: 'Hérité' })
    const heriteId = readLayers(c)[0].id
    c = addSlide(c, 'Page 1')
    const slide = readSlides(c)[0]
    c = setSlideParent(c, slide.id, parent.id)
    c = addLayer(c, 'text', { groupId: slide.groupId, source: 'Local' })
    const localId = readLayers(c).find((l) => l.source === 'Local').id
    c = { ...c, activeSlideId: slide.id }
    const { html } = compiler(c)
    const doc = new DOMParser().parseFromString(html, 'text/html')
    const zDe = (id) => Number(doc.querySelector(`[data-zrm-layer="${id}"]`).style.zIndex)
    expect(zDe(heriteId)).toBeLessThan(zDe(localId))
  })

  it('éditer une diapositive et éditer une page parente sont MUTUELLEMENT EXCLUSIFS', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = addSlide(c, 'Page 1')
    const slide = readSlides(c)[0]
    c = setActiveSlide(c, slide.id)
    expect(c.activeSlideId).toBe(slide.id)
    c = setActivePageParent(c, parent.id)
    expect(c.activePageParentId).toBe(parent.id)
    expect(c.activeSlideId).toBe(null)   // entrer dans la page parente a refermé la diapositive
    c = setActiveSlide(c, slide.id)
    expect(c.activePageParentId).toBe(null)   // et revenir à la diapositive referme la page parente
  })

  it('un calque posé PENDANT l’édition d’une page parente devient visible dans CE contexte, invisible ailleurs', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const parent = readParentPages(c)[0]
    c = setActivePageParent(c, parent.id)
    c = addLayer(c, 'text', { groupId: parent.groupId, name: 'Logo' })
    const calque = readLayers(c).find((l) => l.name === 'Logo')
    expect(isEffectivelyHidden(c, calque)).toBe(false)   // visible : on édite CETTE page parente

    c = addSlide(c, 'Page 1')
    const slide = readSlides(c)[0]
    c = setActiveSlide(c, slide.id)   // quitte le contexte de la page parente
    expect(isEffectivelyHidden(c, calque)).toBe(true)   // invisible hors édition, hors application
  })
})

// Carte D3 (InDesign) — chaînage de blocs de texte : chaque bloc garde son propre contenu, seule la
// relation structurelle (et sa visite, `readTextChain`) traverse plusieurs calques.
import { threadTextLayers, unthreadTextLayer, readTextChain } from './layers.js'

describe('InDesign D3 — chaînage de blocs de texte', () => {
  function texte(c, source) { return addLayer(c, 'text', { source }) }

  it('chaîne deux blocs texte : threadNextId d’un côté, threadPrevId de l’autre', () => {
    let c = texte(vide(), 'A')
    c = texte(c, 'B')
    const [a, b] = readLayers(c)
    c = threadTextLayers(c, a.id, b.id)
    const [a2, b2] = readLayers(c)
    expect(a2.threadNextId).toBe(b.id)
    expect(b2.threadPrevId).toBe(a.id)
  })

  it('refuse de chaîner un bloc à lui-même, ou vers un calque qui n’est pas du texte', () => {
    let c = texte(vide(), 'A')
    const [a] = readLayers(c)
    expect(threadTextLayers(c, a.id, a.id)).toBe(c)
    c = addLayer(c, 'shape', {})
    const forme = readLayers(c).find((l) => l.kind === 'shape')
    expect(threadTextLayers(c, a.id, forme.id)).toBe(c)
  })

  it('refuse un CYCLE : chaîner en retour vers un bloc déjà en amont ne fait rien', () => {
    let c = texte(vide(), 'A')
    c = texte(c, 'B')
    c = texte(c, 'C')
    const [a, b, cc] = readLayers(c)
    c = threadTextLayers(c, a.id, b.id)
    c = threadTextLayers(c, b.id, cc.id)
    const avant = c
    c = threadTextLayers(c, cc.id, a.id)   // C -> A boucherait la chaîne A -> B -> C -> A
    expect(c).toBe(avant)
  })

  it('chaîner REROUTE : un bloc déjà lié perd son ancien lien, jamais un lien partagé à trois', () => {
    let c = texte(vide(), 'A')
    c = texte(c, 'B')
    c = texte(c, 'C')
    const [a, b, cc] = readLayers(c)
    c = threadTextLayers(c, a.id, b.id)   // A -> B
    c = threadTextLayers(c, a.id, cc.id)  // A -> C : B doit perdre son threadPrevId
    const [a2, b2, c2] = readLayers(c)
    expect(a2.threadNextId).toBe(cc.id)
    expect(b2.threadPrevId).toBe('')
    expect(c2.threadPrevId).toBe(a.id)
  })

  it('unthreadTextLayer casse le lien SANS toucher au contenu d’aucun des deux blocs', () => {
    let c = texte(vide(), 'A')
    c = texte(c, 'B')
    const [a, b] = readLayers(c)
    c = threadTextLayers(c, a.id, b.id)
    c = unthreadTextLayer(c, a.id)
    const [a2, b2] = readLayers(c)
    expect(a2.threadNextId).toBe('')
    expect(b2.threadPrevId).toBe('')
    expect(a2.source).toBe('A')
    expect(b2.source).toBe('B')
  })

  it('readTextChain retrouve la chaîne COMPLÈTE depuis n’importe lequel de ses maillons', () => {
    let c = texte(vide(), 'A')
    c = texte(c, 'B')
    c = texte(c, 'C')
    const [a, b, cc] = readLayers(c)
    c = threadTextLayers(c, a.id, b.id)
    c = threadTextLayers(c, b.id, cc.id)
    expect(readTextChain(c, b.id).map((l) => l.source)).toEqual(['A', 'B', 'C'])
    expect(readTextChain(c, cc.id).map((l) => l.source)).toEqual(['A', 'B', 'C'])
  })

  it('un calque non chaîné forme sa propre chaîne à un seul maillon', () => {
    const c = texte(vide(), 'Seul')
    const [seul] = readLayers(c)
    expect(readTextChain(c, seul.id)).toHaveLength(1)
  })
})

// Carte D4 (InDesign) — styles de texte nommés : une définition partagée, un remplacement local
// champ par champ qui l'emporte toujours, une suppression qui ne change rien à l'écran.
import {
  readTextStyles, addTextStyle, patchTextStyle, removeTextStyle, setLayerTextStyle,
  clearTextStyleOverrides, resolvedTextStyle, hasTextStyleOverride,
} from './layers.js'

describe('InDesign D4 — styles de texte nommés', () => {
  it('addTextStyle crée un style nommé, vide par défaut', () => {
    const c = addTextStyle(vide(), 'Titre')
    const styles = readTextStyles(c)
    expect(styles).toHaveLength(1)
    expect(styles[0].name).toBe('Titre')
    expect(styles[0].style.fontSize).toBe('')
  })

  it('addTextStyle peut être AMORCÉ depuis le style résolu d’un calque existant', () => {
    let c = addLayer(vide(), 'text', { style: { fontSize: '32px', fontWeight: '700' } })
    const [calque] = readLayers(c)
    c = addTextStyle(c, 'Titre', calque.id)
    const [style] = readTextStyles(c)
    expect(style.style.fontSize).toBe('32px')
    expect(style.style.fontWeight).toBe('700')
  })

  it('appliquer un style RÉSOUT ses champs sur le calque qui n’a rien réglé localement', () => {
    let c = addTextStyle(vide(), 'Titre')
    const [style] = readTextStyles(c)
    c = patchTextStyle(c, style.id, { style: { fontSize: '40px', color: '#ff0000' } })
    c = addLayer(c, 'text', {})
    const [calque] = readLayers(c)
    c = setLayerTextStyle(c, calque.id, style.id)
    const resolu = resolvedTextStyle(c, readLayers(c)[0])
    expect(resolu.fontSize).toBe('40px')
    expect(resolu.color).toBe('#ff0000')
  })

  it('un remplacement LOCAL l’emporte toujours, champ par champ, même partiel', () => {
    let c = addTextStyle(vide(), 'Titre')
    const [style] = readTextStyles(c)
    c = patchTextStyle(c, style.id, { style: { fontSize: '40px', color: '#ff0000' } })
    c = addLayer(c, 'text', { style: { fontSize: '96px' } })   // seul le corps est réglé localement
    const [calque] = readLayers(c)
    c = setLayerTextStyle(c, calque.id, style.id)
    const resolu = resolvedTextStyle(c, readLayers(c)[0])
    expect(resolu.fontSize).toBe('96px')   // le remplacement local gagne
    expect(resolu.color).toBe('#ff0000')   // hérité du style, jamais réglé localement
  })

  it('modifier la DÉFINITION du style change tous les calques qui l’appliquent, sans les toucher', () => {
    let c = addTextStyle(vide(), 'Titre')
    const [style] = readTextStyles(c)
    c = addLayer(c, 'text', {})
    c = addLayer(c, 'text', {})
    const [a, b] = readLayers(c)
    c = setLayerTextStyle(c, a.id, style.id)
    c = setLayerTextStyle(c, b.id, style.id)
    c = patchTextStyle(c, style.id, { style: { fontFamily: 'AnthropicSerif' } })
    const layers = readLayers(c)
    expect(resolvedTextStyle(c, layers.find((l) => l.id === a.id)).fontFamily).toBe('AnthropicSerif')
    expect(resolvedTextStyle(c, layers.find((l) => l.id === b.id)).fontFamily).toBe('AnthropicSerif')
  })

  it('supprimer un style ramène les calques à [Aucun] SANS changer leur apparence à l’écran', () => {
    let c = addTextStyle(vide(), 'Titre')
    const [style] = readTextStyles(c)
    c = patchTextStyle(c, style.id, { style: { fontSize: '40px' } })
    c = addLayer(c, 'text', { style: { color: '#00ff00' } })
    const [calque] = readLayers(c)
    c = setLayerTextStyle(c, calque.id, style.id)
    const avant = resolvedTextStyle(c, readLayers(c)[0])
    c = removeTextStyle(c, style.id)
    expect(readLayers(c)[0].textStyleId).toBe('')
    // L'apparence effective ne portait QUE ce que le calque réglait lui-même (`color`) : elle
    // survit intacte, seul le fontSize hérité du style disparaît (il n'a jamais été local).
    expect(readLayers(c)[0].style.color).toBe(avant.color)
  })

  it('hasTextStyleOverride détecte un remplacement local, jamais un style non appliqué', () => {
    let c = addTextStyle(vide(), 'Titre')
    const [style] = readTextStyles(c)
    c = addLayer(c, 'text', { style: { fontSize: '96px' } })
    const [calque] = readLayers(c)
    expect(hasTextStyleOverride(readLayers(c)[0])).toBe(false)   // pas encore de style appliqué
    c = setLayerTextStyle(c, calque.id, style.id)
    expect(hasTextStyleOverride(readLayers(c)[0])).toBe(true)   // fontSize réglé localement
  })

  it('clearTextStyleOverrides efface les remplacements : le calque revient EXACTEMENT au style', () => {
    let c = addTextStyle(vide(), 'Titre')
    const [style] = readTextStyles(c)
    c = patchTextStyle(c, style.id, { style: { fontSize: '40px' } })
    c = addLayer(c, 'text', { style: { fontSize: '96px', color: '#00ff00' } })
    const [calque] = readLayers(c)
    c = setLayerTextStyle(c, calque.id, style.id)
    c = clearTextStyleOverrides(c, calque.id)
    expect(hasTextStyleOverride(readLayers(c)[0])).toBe(false)
    expect(resolvedTextStyle(c, readLayers(c)[0]).fontSize).toBe('40px')
  })

  it('la page compilée porte RÉELLEMENT le style résolu, remplacement local compris', () => {
    let c = addTextStyle(vide(), 'Titre')
    const [style] = readTextStyles(c)
    c = patchTextStyle(c, style.id, { style: { fontSize: '40px', color: '#ff0000' } })
    c = addLayer(c, 'text', { source: 'Bonjour', style: { fontSize: '96px' } })
    const [calque] = readLayers(c)
    c = setLayerTextStyle(c, calque.id, style.id)
    const { html } = compiler(c)
    expect(html).toContain('font-size:96px')   // remplacement local, gagne
    expect(html).toContain('color:#ff0000')    // hérité du style nommé
  })
})

// Carte D5 (InDesign) — habillage de texte : mode boîte englobante uniquement, un flottant
// invisible calculé PUREMENT depuis la géométrie, jamais une estimation du contenu du texte.
import { computeTextWrap, textWrapFloat } from './layers.js'

describe('InDesign D5 — habillage de texte', () => {
  it('aucun croisement vertical entre l’obstacle et la boîte de texte : pas d’habillage', () => {
    const texte = { x: 0, y: 0, w: 400, h: 200 }
    expect(computeTextWrap(texte, { x: 0, y: -100, w: 100, h: 50 })).toBeNull()   // entièrement AU-DESSUS
    expect(computeTextWrap(texte, { x: 0, y: 250, w: 100, h: 50 })).toBeNull()    // entièrement EN-DESSOUS
  })

  it('un obstacle à GAUCHE de la boîte de texte pousse un flottant `left`', () => {
    const texte = { x: 0, y: 0, w: 400, h: 300 }
    const obstacle = { x: 0, y: 20, w: 120, h: 100 }
    const h = computeTextWrap(texte, obstacle, 10)
    expect(h.side).toBe('left')
    expect(h.width).toBe(130)      // bord droit de l'obstacle (120) - origine texte (0) + marge (10)
    expect(h.marginTop).toBe(20)   // l'obstacle commence 20px sous le haut du texte
    expect(h.height).toBe(110)     // 100 de hauteur d'obstacle + 10 de marge
  })

  it('un obstacle à DROITE de la boîte de texte pousse un flottant `right`', () => {
    const texte = { x: 0, y: 0, w: 400, h: 300 }
    const obstacle = { x: 320, y: 0, w: 80, h: 60 }   // centre à 360, largement au-delà du centre du texte (200)
    const h = computeTextWrap(texte, obstacle, 10)
    expect(h.side).toBe('right')
    expect(h.width).toBe(90)   // largeur texte (400) - x obstacle (320) + marge (10)
  })

  it('la géométrie reste bornée à la boîte de texte, jamais un flottant plus grand que son cadre', () => {
    const texte = { x: 100, y: 100, w: 200, h: 150 }
    // Obstacle qui déborde LARGEMENT à gauche et par le haut du cadre de texte.
    const obstacle = { x: -500, y: -500, w: 700, h: 700 }
    const h = computeTextWrap(texte, obstacle, 16)
    expect(h.width).toBeLessThanOrEqual(200)
    expect(h.height).toBeLessThanOrEqual(150)
    expect(h.marginTop).toBe(0)   // l'obstacle commence avant le haut du texte, borné à 0
  })

  it('textWrapFloat suit `wrapAroundId`, rend `null` sans obstacle réglé ou obstacle introuvable', () => {
    let c = addLayer(vide(), 'text', { x: 0, y: 0, w: 300, h: 200 })
    const [texte] = readLayers(c)
    expect(textWrapFloat(c, texte)).toBeNull()   // aucun wrapAroundId réglé
    c = patchLayer(c, texte.id, { wrapAroundId: 'lay-inexistant' })
    // readLayers a déjà REJETÉ un identifiant qui ne pointe vers rien : le champ reste vide.
    expect(readLayers(c).find((l) => l.id === texte.id).wrapAroundId).toBe('')
  })

  it('textWrapFloat calcule bien la géométrie une fois un obstacle RÉEL réglé', () => {
    let c = addLayer(vide(), 'text', { x: 0, y: 0, w: 300, h: 200 })
    c = addLayer(c, 'image', { x: 0, y: 20, w: 100, h: 80 })
    const [texte, image] = readLayers(c)
    c = patchLayer(c, texte.id, { wrapAroundId: image.id })
    const h = textWrapFloat(c, readLayers(c).find((l) => l.id === texte.id))
    expect(h).not.toBeNull()
    expect(h.side).toBe('left')
  })

  it('un obstacle MASQUÉ ne fait plus habiller le texte, comme un cadre masqué dans InDesign', () => {
    let c = addLayer(vide(), 'text', { x: 0, y: 0, w: 300, h: 200 })
    c = addLayer(c, 'image', { x: 0, y: 20, w: 100, h: 80, hidden: true })
    const [texte, image] = readLayers(c)
    c = patchLayer(c, texte.id, { wrapAroundId: image.id })
    expect(textWrapFloat(c, readLayers(c).find((l) => l.id === texte.id))).toBeNull()
  })

  it('la page compilée porte RÉELLEMENT le flottant invisible en tout premier enfant du texte', () => {
    let c = addLayer(vide(), 'text', { x: 0, y: 0, w: 300, h: 200, source: 'Bonjour le monde' })
    c = addLayer(c, 'image', { x: 0, y: 20, w: 100, h: 80 })
    const [texte, image] = readLayers(c)
    c = patchLayer(c, texte.id, { wrapAroundId: image.id })
    const { html } = compiler(c)
    expect(html).toContain('zrm-wrap-float')
    expect(html).toContain('float:left')
    // Le flottant précède le contenu réel dans le marquage : c'est ce qui le rend PREMIER enfant.
    expect(html.indexOf('zrm-wrap-float')).toBeLessThan(html.indexOf('Bonjour le monde'))
  })

  it('sans obstacle réglé, aucun flottant n’apparaît dans la page compilée', () => {
    const c = addLayer(vide(), 'text', { x: 0, y: 0, w: 300, h: 200, source: 'Sans habillage' })
    const { html } = compiler(c)
    expect(html).not.toContain('zrm-wrap-float')
  })
})

// Carte D6 (InDesign) — marges, colonnes, repères, grilles : l'alignement était déjà couvert
// (alignPatch/distributePatch), le vrai manque était un repère PERSISTANT, jamais transitoire.
import {
  readGuides, addGuide, moveGuide, removeGuide, clearGuides,
  readMarginSettings, patchMarginSettings, generateMarginGuides, readGridSettings, setGridSettings,
} from './layers.js'

describe('InDesign D6 — marges, colonnes, repères, grilles', () => {
  it('addGuide pose un repère, jamais sur un axe inconnu', () => {
    let c = addGuide(vide(), 'x', 100)
    expect(readGuides(c)).toEqual([{ id: expect.any(String), axis: 'x', position: 100 }])
    c = addGuide(c, 'diagonale', 50)   // axe invalide, ignoré
    expect(readGuides(c)).toHaveLength(1)
  })

  it('moveGuide repositionne EXACTEMENT le repère visé, jamais les autres', () => {
    let c = addGuide(vide(), 'x', 100)
    c = addGuide(c, 'y', 200)
    const [gx, gy] = readGuides(c)
    c = moveGuide(c, gx.id, 250)
    const guides = readGuides(c)
    expect(guides.find((g) => g.id === gx.id).position).toBe(250)
    expect(guides.find((g) => g.id === gy.id).position).toBe(200)   // intact
  })

  it('removeGuide retire un seul repère ; clearGuides les retire tous', () => {
    let c = addGuide(vide(), 'x', 10)
    c = addGuide(c, 'x', 20)
    const [g1] = readGuides(c)
    c = removeGuide(c, g1.id)
    expect(readGuides(c)).toHaveLength(1)
    c = clearGuides(c)
    expect(readGuides(c)).toEqual([])
  })

  it('readMarginSettings rend des défauts raisonnables, bornés (colonnes 1 à 12)', () => {
    expect(readMarginSettings(vide())).toEqual({ top: 40, right: 40, bottom: 40, left: 40, columns: 1, gutter: 20 })
    const c = patchMarginSettings(vide(), { columns: 99 })
    expect(readMarginSettings(c).columns).toBe(12)   // borné
  })

  it('generateMarginGuides pose une ligne par marge réglée à plus de zéro', () => {
    let c = patchMarginSettings(vide(), { top: 40, right: 40, bottom: 40, left: 40, columns: 1 })
    c = generateMarginGuides(c, { w: 1080, h: 1080 })
    const guides = readGuides(c)
    expect(guides).toHaveLength(4)   // haut/bas/gauche/droite, aucune colonne interne (columns=1)
    expect(guides.find((g) => g.axis === 'x' && g.position === 40)).toBeTruthy()      // gauche
    expect(guides.find((g) => g.axis === 'x' && g.position === 1040)).toBeTruthy()    // droite = 1080-40
    expect(guides.find((g) => g.axis === 'y' && g.position === 40)).toBeTruthy()      // haut
    expect(guides.find((g) => g.axis === 'y' && g.position === 1040)).toBeTruthy()    // bas = 1080-40
  })

  it('generateMarginGuides ajoute une ligne par gouttière interne, au CENTRE de chacune', () => {
    let c = patchMarginSettings(vide(), { top: 0, right: 0, bottom: 0, left: 0, columns: 3, gutter: 20 })
    c = generateMarginGuides(c, { w: 560, h: 100 })
    const colonnes = readGuides(c).filter((g) => g.axis === 'x')
    expect(colonnes).toHaveLength(2)   // 3 colonnes = 2 gouttières internes
    // colW = (560 - 20*2) / 3 = 173.33 ; 1re gouttière centrée à 0 + 173.33 + 0.5*20 = 183.33
    expect(colonnes[0].position).toBeCloseTo(183.33, 1)
    expect(colonnes[1].position).toBeCloseTo(376.67, 1)
  })

  it('generateMarginGuides REMPLACE le jeu de repères, jamais ne l’accumule', () => {
    let c = addGuide(vide(), 'x', 999)   // un repère manuel, sans rapport avec les marges
    c = patchMarginSettings(c, { top: 40, right: 0, bottom: 0, left: 0, columns: 1 })
    c = generateMarginGuides(c, { w: 1080, h: 1080 })
    expect(readGuides(c)).toHaveLength(1)   // le repère à 999 a disparu, remplacé
    expect(readGuides(c)[0].position).toBe(40)
  })

  it('readGridSettings/setGridSettings : taille bornée 4 à 200, désactivée par défaut', () => {
    expect(readGridSettings(vide())).toEqual({ show: false, size: 40 })
    const c = setGridSettings(vide(), { show: true, size: 500 })
    expect(readGridSettings(c)).toEqual({ show: true, size: 200 })   // bornée
  })

  it('snapMove accroche AUSSI sur un repère manuel, comme sur le bord d’un autre calque', () => {
    const box = { x: 96, y: 50, w: 100, h: 100 }   // à 4px d'un repère vertical posé à x=100
    const r = snapMove(box, [], { w: 1080, h: 1080 }, 6, [{ axis: 'x', position: 100 }])
    expect(r.x).toBe(100)   // le bord gauche s'est collé au repère
    expect(r.guides.x).toBe(100)
  })

  it('snapMove IGNORE un repère hors du seuil de magnétisme', () => {
    const box = { x: 50, y: 50, w: 100, h: 100 }   // à 50px d'un repère à x=100, largement hors seuil
    const r = snapMove(box, [], { w: 1080, h: 1080 }, 6, [{ axis: 'x', position: 100 }])
    expect(r.x).toBe(50)   // aucune accroche
  })
})

