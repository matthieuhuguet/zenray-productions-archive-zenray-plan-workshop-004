// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Carte F3 — famille Figma « Frames, groupes, sections et contraintes ».
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { applyConstraints, applyConstraintsToAll, CONSTRAINTS_H, CONSTRAINTS_V } from './layers.js'

describe('F3 — contraintes', () => {
  it('un calque neuf a la contrainte par défaut left/top, celle de Figma aussi', () => {
    const l = readLayers(addLayer(vide(), 'shape'))[0]
    expect(l.constrainH).toBe('left')
    expect(l.constrainV).toBe('top')
  })

  it('left/top : la distance au bord GAUCHE et au bord HAUT reste fixe, rien ne bouge', () => {
    const l = { x: 40, y: 20, w: 100, h: 50, constrainH: 'left', constrainV: 'top' }
    const r = applyConstraints(l, { w: 1000, h: 1000 }, { w: 2000, h: 500 })
    expect(r).toEqual({ x: 40, y: 20, w: 100, h: 50 })
  })

  it('right/bottom : la distance a l’AUTRE bord reste fixe, le calque SUIT l’agrandissement', () => {
    const l = { x: 900, y: 900, w: 100, h: 100, constrainH: 'right', constrainV: 'bottom' }
    // Le canevas passe de 1000 à 2000 : la marge de 900 après le calque (1000-100=900 depuis la
    // droite) doit se retrouver à 1900 (2000-100) après agrandissement.
    const r = applyConstraints(l, { w: 1000, h: 1000 }, { w: 2000, h: 2000 })
    expect(r.x).toBe(1900)
    expect(r.y).toBe(1900)
    expect(r.w).toBe(100)   // right/bottom ne redimensionne jamais, seule la position bouge
  })

  it('center : reste à équidistance des deux bords, dans la moitié de l’agrandissement', () => {
    const l = { x: 450, y: 450, w: 100, h: 100, constrainH: 'center', constrainV: 'center' }
    const r = applyConstraints(l, { w: 1000, h: 1000 }, { w: 1200, h: 1000 })
    expect(r.x).toBe(550)   // +200 de largeur en tout, +100 de chaque côté
    expect(r.y).toBe(450)   // hauteur inchangée
  })

  it('scale : grandit dans la MÊME proportion que le canevas, position ET taille', () => {
    const l = { x: 100, y: 100, w: 200, h: 200, constrainH: 'scale', constrainV: 'scale' }
    const r = applyConstraints(l, { w: 1000, h: 1000 }, { w: 2000, h: 2000 })
    expect(r).toEqual({ x: 200, y: 200, w: 400, h: 400 })
  })

  it('un canevas à hauteur LIBRE (format web) n’applique aucune contrainte verticale', () => {
    const l = { x: 10, y: 500, w: 50, h: 50, constrainH: 'left', constrainV: 'bottom' }
    const r = applyConstraints(l, { w: 800, h: 0 }, { w: 1200, h: 0 })
    expect(r.y).toBe(500)   // rien à mesurer sans hauteur de canevas, la valeur reste intacte
  })

  it('applyConstraintsToAll ne touche à rien si le canevas n’a pas changé', () => {
    let c = addLayer(vide(), 'shape', { x: 10 })
    const meme = applyConstraintsToAll(c, { w: 1000, h: 1000 }, { w: 1000, h: 1000 })
    expect(meme).toBe(c)   // même référence : aucun calcul inutile
  })

  it('applyConstraintsToAll transforme TOUS les calques d’un coup', () => {
    let c = addLayer(vide(), 'shape', { x: 900, constrainH: 'right' })
    c = addLayer(c, 'shape', { x: 40, constrainH: 'left' })
    const r = applyConstraintsToAll(c, { w: 1000, h: 1000 }, { w: 2000, h: 1000 })
    const layers = readLayers(r)
    expect(layers.find((l) => l.constrainH === 'right').x).toBe(1900)
    expect(layers.find((l) => l.constrainH === 'left').x).toBe(40)
  })

  it('les listes de contraintes restent fermées et complètes', () => {
    expect(CONSTRAINTS_H).toEqual(['left', 'center', 'right', 'scale'])
    expect(CONSTRAINTS_V).toEqual(['top', 'center', 'bottom', 'scale'])
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Carte F4 — famille Figma « Auto Layout ».
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { toggleAutoLayout, setAutoLayoutProp, applyAutoLayout } from './layers.js'

describe('F4 — Auto Layout', () => {
  function groupeDeDeux(w1 = 100, h1 = 40, w2 = 100, h2 = 40) {
    let c = addLayer(vide(), 'text', { name: 'A', x: 10, y: 10, w: w1, h: h1 })
    c = addLayer(c, 'text', { name: 'B', x: 10, y: 60, w: w2, h: h2 })
    const [a, b] = readLayers(c)
    c = groupLayers(c, [a.id, b.id], 'Pile')
    return { c, groupId: readGroups(c)[0].id, aId: a.id, bId: b.id }
  }

  it('activer Auto Layout ancre le groupe à son coin actuel, en colonne par défaut', () => {
    const { c, groupId } = groupeDeDeux()
    const r = toggleAutoLayout(c, groupId)
    const g = readGroups(r).find((x) => x.id === groupId)
    expect(g.autoLayout).toEqual({ direction: 'column', gap: 8, padding: 0 })
    expect(g.autoX).toBe(10)
    expect(g.autoY).toBe(10)
  })

  it('en colonne, le second membre se range SOUS le premier, écart de 8px respecté', () => {
    let { c, groupId } = groupeDeDeux(100, 40, 100, 60)
    c = toggleAutoLayout(c, groupId)
    c = applyAutoLayout(c)
    const layers = readLayers(c)
    const a = layers.find((l) => l.name === 'A')
    const b = layers.find((l) => l.name === 'B')
    expect(a.x).toBe(10); expect(a.y).toBe(10)
    expect(b.x).toBe(10); expect(b.y).toBe(10 + 40 + 8)   // y du premier + sa hauteur + l'écart
  })

  it('en ligne, le flux se lit horizontalement au lieu de verticalement', () => {
    let { c, groupId } = groupeDeDeux(120, 40, 80, 40)
    c = toggleAutoLayout(c, groupId, 'row')
    c = applyAutoLayout(c)
    const layers = readLayers(c)
    const a = layers.find((l) => l.name === 'A')
    const b = layers.find((l) => l.name === 'B')
    expect(a.x).toBe(10); expect(b.x).toBe(10 + 120 + 8)
    expect(a.y).toBe(10); expect(b.y).toBe(10)   // l'axe croisé ne bouge jamais
  })

  it('« le parent réagit immédiatement » : agrandir un membre repousse le suivant, sans geste manuel', () => {
    let { c, groupId, aId } = groupeDeDeux(100, 40, 100, 40)
    c = toggleAutoLayout(c, groupId)
    c = patchLayer(c, aId, { h: 90 })   // le membre A grandit, comme un texte qui reçoit une ligne de plus
    c = applyAutoLayout(c)
    const b = readLayers(c).find((l) => l.name === 'B')
    expect(b.y).toBe(10 + 90 + 8)   // B suit la nouvelle hauteur de A, personne ne l'a déplacé à la main
  })

  it('désactiver Auto Layout GÈLE la disposition telle quelle, ne réinitialise rien', () => {
    let { c, groupId } = groupeDeDeux()
    c = toggleAutoLayout(c, groupId)
    c = applyAutoLayout(c)
    c = toggleAutoLayout(c, groupId)   // off
    const g = readGroups(c).find((x) => x.id === groupId)
    expect(g.autoLayout).toBe(null)
    const b = readLayers(c).find((l) => l.name === 'B')
    expect(b.y).toBe(10 + 40 + 8)   // la position figée reste celle du dernier calcul, pas un retour arrière
  })

  it('setAutoLayoutProp change le gap sans toucher à la direction', () => {
    let { c, groupId } = groupeDeDeux()
    c = toggleAutoLayout(c, groupId)
    c = setAutoLayoutProp(c, groupId, { gap: 24 })
    const g = readGroups(c).find((x) => x.id === groupId)
    expect(g.autoLayout).toEqual({ direction: 'column', gap: 24, padding: 0 })
  })

  it('setAutoLayoutProp sur un groupe SANS Auto Layout actif ne fait rien', () => {
    let c = addLayer(vide(), 'text')
    const id = readLayers(c)[0].id
    c = groupLayers(c, [id], 'Solo')
    const groupId = readGroups(c)[0].id
    const avant = c
    c = setAutoLayoutProp(c, groupId, { gap: 24 })
    expect(readGroups(c)[0].autoLayout).toBe(null)
  })

  it('applyAutoLayout sans aucun groupe en Auto Layout ne fait rien (même référence)', () => {
    const { c } = groupeDeDeux()   // groupé mais Auto Layout jamais activé
    const meme = applyAutoLayout(c)
    expect(meme).toBe(c)
  })

  it('deux groupes en Auto Layout se recalculent chacun indépendamment', () => {
    let c = addLayer(vide(), 'text', { name: 'A1', x: 0, y: 0, w: 50, h: 50 })
    c = addLayer(c, 'text', { name: 'A2', x: 0, y: 60, w: 50, h: 50 })
    c = addLayer(c, 'text', { name: 'B1', x: 200, y: 0, w: 50, h: 50 })
    c = addLayer(c, 'text', { name: 'B2', x: 200, y: 60, w: 50, h: 50 })
    const layers = readLayers(c)
    c = groupLayers(c, [layers[0].id, layers[1].id], 'GroupeA')
    c = groupLayers(c, [layers[2].id, layers[3].id], 'GroupeB')
    const [ga, gb] = readGroups(c)
    c = toggleAutoLayout(c, ga.id)
    c = toggleAutoLayout(c, gb.id)
    c = applyAutoLayout(c)
    const finaux = readLayers(c)
    expect(finaux.find((l) => l.name === 'A2').y).toBe(0 + 50 + 8)
    expect(finaux.find((l) => l.name === 'B2').y).toBe(0 + 50 + 8)
  })
})

