// Carte F7 — famille Figma « Apparence » (remplissage dégradé, le seul ajout réel de cette carte).
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { fillOf, FILL_TYPES } from './layers.js'

describe('F7 — remplissage dégradé', () => {
  it('un calque neuf est en remplissage UNI, jamais en dégradé par défaut', () => {
    const l = readLayers(addLayer(vide(), 'shape'))[0]
    expect(l.fillType).toBe('solid')
    expect(fillOf(l)).toBe('')
  })

  it('un remplissage uni ne produit AUCUN CSS de dégradé : le fond uni existant n’est pas touché', () => {
    expect(fillOf({ fillType: 'solid', gradientFrom: '#000000', gradientTo: '#ffffff' })).toBe('')
  })

  it('un dégradé produit un linear-gradient CSS réel, avec les deux couleurs et l’angle réglés', () => {
    const cp = fillOf({ fillType: 'gradient', gradientFrom: '#111111', gradientTo: '#eeeeee', gradientAngle: 45 })
    expect(cp).toBe('background:linear-gradient(45deg, #111111, #eeeeee)')
  })

  it('des couleurs invalides retombent sur les teintes bleues par défaut, jamais un CSS cassé', () => {
    const cp = fillOf({ fillType: 'gradient', gradientFrom: 'pasunhex', gradientTo: '', gradientAngle: 0 })
    expect(cp).toBe('background:linear-gradient(0deg, #6fb6ed, #4371ee)')
  })

  it('l’angle est toujours ramené dans 0-359, jamais négatif ni au-delà d’un tour', () => {
    expect(readLayers(addLayer(vide(), 'shape', { gradientAngle: -10 }))[0].gradientAngle).toBe(350)
    expect(readLayers(addLayer(vide(), 'shape', { gradientAngle: 720 + 30 }))[0].gradientAngle).toBe(30)
  })

  it('un type de remplissage inconnu retombe sur uni, et la liste reste fermée', () => {
    expect(readLayers(addLayer(vide(), 'shape', { fillType: 'image' }))[0].fillType).toBe('solid')
    expect(FILL_TYPES).toEqual(['solid', 'gradient'])
  })

  it('le dégradé part réellement dans la page compilée, APRÈS un éventuel fond uni pour le primer', () => {
    let c = addLayer(vide(), 'shape', { fillType: 'gradient', gradientFrom: '#010101', gradientTo: '#020202', style: { backgroundColor: '#ff0000' } })
    const { html } = compiler(c)
    const style = html.match(/style="([^"]*)"/)[1]
    expect(style.indexOf('linear-gradient')).toBeGreaterThan(style.indexOf('background-color'))
  })

  it('un remplissage uni ne laisse AUCUNE trace de linear-gradient dans la page compilée', () => {
    let c = addLayer(vide(), 'shape', { fillType: 'solid' })
    const { html } = compiler(c)
    expect(html).not.toContain('linear-gradient')
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Carte P1 (PowerPoint) — famille « Structure, diapositives et système de conception ».
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { readSlides, addSlide, removeSlide, duplicateSlide, reorderSlide, setActiveSlide } from './layers.js'

describe('PowerPoint P1 — diapositives', () => {
  it('un document sans diapositives rend une liste vide, jamais une erreur', () => {
    expect(readSlides(vide())).toEqual([])
  })

  it('ajouter une diapositive crée un groupe dédié vide et l’active immédiatement', () => {
    let c = addSlide(vide())
    const slides = readSlides(c)
    expect(slides).toHaveLength(1)
    expect(slides[0].name).toBe('Diapositive 1')
    expect(c.activeSlideId).toBe(slides[0].id)
    expect(readGroups(c).find((g) => g.id === slides[0].groupId)).toBeTruthy()
  })

  it('un calque posé DANS le groupe d’une diapositive non active se masque effectivement', () => {
    let c = addSlide(vide(), 'Une')
    const groupeUne = readSlides(c)[0].groupId
    c = addLayer(c, 'text', { name: 'Contenu 1', groupId: groupeUne })
    c = addSlide(c, 'Deux')   // devient la diapositive active : « Une » ne l'est plus
    const calque = readLayers(c).find((l) => l.name === 'Contenu 1')
    expect(isEffectivelyHidden(c, calque)).toBe(true)
  })

  it('un calque SANS diapositive reste visible quelle que soit la diapositive active : c’est le masque', () => {
    let c = addLayer(vide(), 'text', { name: 'Fond partagé' })
    c = addSlide(c, 'Une')
    const calque = readLayers(c).find((l) => l.name === 'Fond partagé')
    expect(isEffectivelyHidden(c, calque)).toBe(false)
  })

  it('changer de diapositive active bascule quel groupe se montre, jamais les deux à la fois', () => {
    let c = addSlide(vide(), 'Une')
    const groupeUne = readSlides(c)[0].groupId
    c = addLayer(c, 'text', { name: 'A', groupId: groupeUne })
    c = addSlide(c, 'Deux')
    const groupeDeux = readSlides(c)[1].groupId
    c = addLayer(c, 'text', { name: 'B', groupId: groupeDeux })
    // « Deux » est active : A masqué, B visible.
    let [a, b] = [readLayers(c).find((l) => l.name === 'A'), readLayers(c).find((l) => l.name === 'B')]
    expect(isEffectivelyHidden(c, a)).toBe(true)
    expect(isEffectivelyHidden(c, b)).toBe(false)
    // On revient sur « Une » : l'inverse exact, jamais les deux visibles ensemble.
    c = setActiveSlide(c, readSlides(c)[0].id)
    ;[a, b] = [readLayers(c).find((l) => l.name === 'A'), readLayers(c).find((l) => l.name === 'B')]
    expect(isEffectivelyHidden(c, a)).toBe(false)
    expect(isEffectivelyHidden(c, b)).toBe(true)
  })

  it('dupliquer une diapositive copie tout son contenu dans un groupe NEUF, et l’active', () => {
    let c = addSlide(vide(), 'Source')
    const groupeSource = readSlides(c)[0].groupId
    c = addLayer(c, 'text', { name: 'Titre', groupId: groupeSource, x: 5 })
    const slideId = readSlides(c)[0].id
    c = duplicateSlide(c, slideId)
    const slides = readSlides(c)
    expect(slides).toHaveLength(2)
    expect(slides[1].name).toBe('Source copie')
    expect(c.activeSlideId).toBe(slides[1].id)
    const copies = readLayers(c).filter((l) => l.name === 'Titre')
    expect(copies).toHaveLength(2)
    expect(new Set(copies.map((l) => l.id)).size).toBe(2)   // deux identifiants distincts, pas un alias
    expect(new Set(copies.map((l) => l.groupId)).size).toBe(2)   // deux groupes distincts
  })

  it('dupliquer une diapositive INTROUVABLE ne fait rien', () => {
    const c = addSlide(vide())
    expect(duplicateSlide(c, 'inconnue')).toBe(c)
  })

  it('retirer une diapositive retire aussi son contenu, et active une voisine s’il en reste', () => {
    let c = addSlide(vide(), 'Une')
    c = addSlide(c, 'Deux')
    c = addSlide(c, 'Trois')
    const [una, , trois] = readSlides(c)
    c = setActiveSlide(c, trois.id)
    c = removeSlide(c, trois.id)
    expect(readSlides(c)).toHaveLength(2)
    expect(c.activeSlideId).toBe(readSlides(c)[1].id)   // la voisine qui reste après la dernière
  })

  it('retirer la DERNIÈRE diapositive laisse activeSlideId à null, sans erreur', () => {
    let c = addSlide(vide())
    const id = readSlides(c)[0].id
    c = removeSlide(c, id)
    expect(readSlides(c)).toEqual([])
    expect(c.activeSlideId).toBe(null)
  })

  it('réordonner une diapositive change son rang dans la Trieuse, jamais hors bornes', () => {
    let c = addSlide(vide(), 'Une')
    c = addSlide(c, 'Deux')
    c = addSlide(c, 'Trois')
    const [, deux] = readSlides(c)
    c = reorderSlide(c, deux.id, 'up')
    expect(readSlides(c).map((s) => s.name)).toEqual(['Deux', 'Une', 'Trois'])
    // La première diapositive ne peut pas monter plus haut : rien ne bouge.
    const memeSuite = reorderSlide(c, readSlides(c)[0].id, 'up')
    expect(readSlides(memeSuite).map((s) => s.name)).toEqual(['Deux', 'Une', 'Trois'])
  })

  it('activer une diapositive INTROUVABLE ne fait rien', () => {
    const c = addSlide(vide())
    expect(setActiveSlide(c, 'inconnue')).toBe(c)
  })

  it('un groupe ORDINAIRE (sans diapositive) n’est jamais affecté par activeSlideId', () => {
    let c = addLayer(vide(), 'text', { name: 'X' })
    const id = readLayers(c)[0].id
    c = groupLayers(c, [id], 'Décor')   // groupe P5 classique, pas une diapositive
    c = addSlide(c, 'Une')   // une diapositive existe et est active ailleurs
    const calque = readLayers(c).find((l) => l.name === 'X')
    expect(isEffectivelyHidden(c, calque)).toBe(false)   // le groupe ordinaire reste son propre maître
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Carte P3 (PowerPoint) — famille « Texte et typographie » (listes, liens).
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { safeHref, LIST_STYLES } from './layers.js'

describe('PowerPoint P3 — listes et liens', () => {
  it('un calque neuf n’a ni liste ni lien', () => {
    const l = readLayers(addLayer(vide(), 'text'))[0]
    expect(l.listStyle).toBe('none')
    expect(l.href).toBe('')
  })

  it('un type de liste inconnu retombe sur "none"', () => {
    expect(readLayers(addLayer(vide(), 'text', { listStyle: 'roman' }))[0].listStyle).toBe('none')
  })

  it('sans liste, le texte compile en <span>, une ligne par retour à la ligne devient <br>', () => {
    let c = addLayer(vide(), 'text', { source: 'Un\nDeux' })
    const { html } = compiler(c)
    expect(html).toContain('<span>Un<br>Deux</span>')
    expect(html).not.toContain('<ul')
    expect(html).not.toContain('<ol')
  })

  it('une liste à puces compile en <ul>, une ligne = un <li>', () => {
    let c = addLayer(vide(), 'text', { source: 'Un\nDeux\nTrois', listStyle: 'bullet' })
    const { html } = compiler(c)
    expect(html).toContain('<ul class="zrm-layer-list"><li>Un</li><li>Deux</li><li>Trois</li></ul>')
  })

  it('une liste numérotée compile en <ol>, pas en <ul>', () => {
    let c = addLayer(vide(), 'text', { source: 'Un\nDeux', listStyle: 'number' })
    const { html } = compiler(c)
    expect(html).toContain('<ol class="zrm-layer-list">')
    expect(html).not.toContain('<ul')
  })

  it('une ligne vide n’ouvre pas un <li> vide, la liste ne recense que le texte réel', () => {
    let c = addLayer(vide(), 'text', { source: 'Un\n\nDeux', listStyle: 'bullet' })
    const { html } = compiler(c)
    expect(html).toContain('<li>Un</li><li>Deux</li>')
  })

  it('un lien http/https/mailto/relatif/ancre est accepté tel quel', () => {
    expect(safeHref('https://exemple.fr')).toBe('https://exemple.fr')
    expect(safeHref('http://exemple.fr')).toBe('http://exemple.fr')
    expect(safeHref('mailto:x@exemple.fr')).toBe('mailto:x@exemple.fr')
    expect(safeHref('/page')).toBe('/page')
    expect(safeHref('#ancre')).toBe('#ancre')
  })

  it('un lien javascript: (ou tout protocole non listé) est REFUSÉ, jamais assaini', () => {
    expect(safeHref('javascript:alert(1)')).toBe('')
    expect(safeHref('data:text/html,x')).toBe('')
    expect(safeHref('  javascript:alert(1)')).toBe('')
    expect(safeHref('')).toBe('')
    expect(safeHref(null)).toBe('')
  })

  it('un lien valide enveloppe le texte compilé dans <a href>, sans changer sa mise en forme', () => {
    let c = addLayer(vide(), 'text', { source: 'Clique ici', href: 'https://exemple.fr' })
    const { html } = compiler(c)
    expect(html).toContain('<a href="https://exemple.fr"><span>Clique ici</span></a>')
  })

  it('un lien refusé ne laisse aucune trace de balise <a>', () => {
    let c = addLayer(vide(), 'text', { source: 'x', href: 'javascript:alert(1)' })
    const { html } = compiler(c)
    expect(html).not.toContain('<a ')
  })

  it('la liste des styles de liste reste fermée et complète', () => {
    expect(LIST_STYLES).toEqual(['none', 'bullet', 'number'])
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Carte P5 (PowerPoint) — famille « Tableaux, graphiques, SmartArt » (le tableau, seul retenu).
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { resizeTableCells } from './layers.js'

describe('PowerPoint P5 — tableau', () => {
  it('un calque tableau neuf est 2×2, quatre cellules vides', () => {
    const l = readLayers(addLayer(vide(), 'table'))[0]
    expect(l.tableRows).toBe(2)
    expect(l.tableCols).toBe(2)
    expect(l.tableCells).toEqual(['', '', '', ''])
  })

  it('lignes et colonnes sont bornées 1-8, jamais 0 ni au-delà', () => {
    expect(readLayers(addLayer(vide(), 'table', { tableRows: 0 }))[0].tableRows).toBe(1)
    expect(readLayers(addLayer(vide(), 'table', { tableRows: 40 }))[0].tableRows).toBe(8)
  })

  it('le nombre de cellules suit TOUJOURS lignes × colonnes, jamais un tableau désaccordé', () => {
    const l = readLayers(addLayer(vide(), 'table', { tableRows: 3, tableCols: 4, tableCells: ['x'] }))[0]
    expect(l.tableCells).toHaveLength(12)
    expect(l.tableCells[0]).toBe('x')
    expect(l.tableCells[1]).toBe('')
  })

  it('agrandir une grille conserve le contenu déjà saisi à ses coordonnées d’origine', () => {
    // Départ 2×2 : A B / C D. Passage à 3×3 : A B _ / C D _ / _ _ _.
    const cellules = resizeTableCells(['A', 'B', 'C', 'D'], 2, 2, 3, 3)
    expect(cellules).toEqual(['A', 'B', '', 'C', 'D', '', '', '', ''])
  })

  it('rétrécir une grille ne garde que ce qui reste dans les nouvelles bornes', () => {
    // Départ 2×3 : A B C / D E F. Passage à 2×2 : ne garde que la colonne 1 et 2 de chaque ligne.
    const cellules = resizeTableCells(['A', 'B', 'C', 'D', 'E', 'F'], 2, 3, 2, 2)
    expect(cellules).toEqual(['A', 'B', 'D', 'E'])
  })

  it('le tableau compile en <table> réel, une <tr> par ligne et un <td> par cellule', () => {
    let c = addLayer(vide(), 'table', { tableRows: 2, tableCols: 2, tableCells: ['A', 'B', 'C', 'D'] })
    const { html } = compiler(c)
    expect(html).toContain('<table class="zrm-layer-table"><tr><td>A</td><td>B</td></tr><tr><td>C</td><td>D</td></tr></table>')
  })

  it('le texte d’une cellule est échappé, comme celui de tout calque texte', () => {
    let c = addLayer(vide(), 'table', { tableCells: ['<script>x</script>', '', '', ''] })
    const { html } = compiler(c)
    expect(html).not.toContain('<script>x</script>')
    expect(html).toContain('&lt;script&gt;')
  })
})

