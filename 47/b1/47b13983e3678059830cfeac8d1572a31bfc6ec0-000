describe('PowerPoint P8 — export de toutes les diapositives', () => {
  // L'export PNG lui-même passe par canvas/Image, absents de jsdom (déjà le cas pour TOUT export
  // de ce fichier, aucun test antérieur n'y touche). Ce qui EST vérifiable, et ce qui compte
