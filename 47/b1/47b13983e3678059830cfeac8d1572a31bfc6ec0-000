// Carte P2 (PowerPoint) — « Bring to Front / Send to Back », en un seul saut.
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { bringToFront, sendToBack } from './layers.js'

describe('PowerPoint P2 — premier plan / arrière-plan en un saut', () => {
  it('bringToFront place le calque devant TOUS les autres, en un seul geste', () => {
    let c = addLayer(vide(), 'text', { name: 'A' })
    c = addLayer(c, 'text', { name: 'B' })
    c = addLayer(c, 'text', { name: 'C' })
    const a = readLayers(c).find((l) => l.name === 'A').id
    c = bringToFront(c, a)
    expect(paintOrder(c).map((l) => l.name)).toEqual(['B', 'C', 'A'])
  })

  it('sendToBack place le calque derrière TOUS les autres, en un seul geste', () => {
    let c = addLayer(vide(), 'text', { name: 'A' })
    c = addLayer(c, 'text', { name: 'B' })
    c = addLayer(c, 'text', { name: 'C' })
    const c3 = readLayers(c).find((l) => l.name === 'C').id
    c = sendToBack(c, c3)
    expect(paintOrder(c).map((l) => l.name)).toEqual(['C', 'A', 'B'])
  })

  it('un calque déjà devant reste devant : bringToFront est stable, pas juste un aller-retour', () => {
    let c = addLayer(vide(), 'text', { name: 'A' })
    c = addLayer(c, 'text', { name: 'B' })
    const b = readLayers(c).find((l) => l.name === 'B').id
    expect(paintOrder(bringToFront(c, b)).map((l) => l.name)).toEqual(['A', 'B'])
  })

  it('un identifiant introuvable ne fait rien', () => {
    const c = addLayer(vide(), 'text', { name: 'A' })
    expect(bringToFront(c, 'inconnu')).toBe(c)
    expect(sendToBack(c, 'inconnu')).toBe(c)
  })
})

describe('P2 — distribution', () => {
  it('sous trois calques, distribuer ne fait rien : il n’y a rien "entre" deux objets', () => {
    expect(distributePatch([{ id: 'a', x: 0, w: 10 }, { id: 'b', x: 100, w: 10 }], 'x')).toEqual([])
  })

  it('égalise les VIDES entre les calques, pas leurs origines', () => {
    // a: 0-10, b: largeur 10 quelque part au milieu, c: 90-100. Vide total = 100-10-10-10=70, /2=35.
    const r = distributePatch([
      { id: 'a', x: 0, w: 10 },
      { id: 'c', x: 90, w: 10 },
      { id: 'b', x: 45, w: 10 },   // désordonné exprès : la fonction doit trier elle-même
    ], 'x')
    expect(r.find((p) => p.id === 'a').x).toBe(0)
    expect(r.find((p) => p.id === 'c').x).toBe(90)
    expect(r.find((p) => p.id === 'b').x).toBe(45)   // 0+10+35 = 45, déjà à sa place ici
  })

  it('fonctionne aussi verticalement, indépendamment de x', () => {
    const r = distributePatch([
      { id: 'a', y: 0, h: 10 }, { id: 'b', y: 50, h: 10 }, { id: 'c', y: 100, h: 10 },
    ], 'y')
    expect(r.map((p) => p.y)).toEqual([0, 50, 100])
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Carte P4 — famille Photoshop « Formes vectorielles et tracés ». Trois types de forme.
// ═══════════════════════════════════════════════════════════════════════════════════════════════
describe('P4 — le type de forme', () => {
  it('un calque forme est un rectangle par défaut', () => {
    expect(readLayers(addLayer(vide(), 'shape'))[0].shapeType).toBe('rectangle')
  })

  it('un type inconnu retombe sur rectangle plutôt que de casser le rendu', () => {
    const c = { ...vide(), layers: [{ kind: 'shape', shapeType: 'triangle' }] }
    expect(readLayers(c)[0].shapeType).toBe('rectangle')
  })

  it('le type de forme part dans la page compilée en attribut data-shape', () => {
    let c = addLayer(vide(), 'shape', { shapeType: 'ellipse' })
    const { html } = compiler(c)
    expect(html).toContain('data-shape="ellipse"')
  })

  // BOGUE RÉEL CORRIGÉ (trouvé en carte PowerPoint P1) : `data-shape` se posait DANS la valeur de
  // `class`, avant son propre guillemet fermant. La sous-chaîne `data-shape="ellipse"` restait
  // présente (le test ci-dessus passait), mais AUCUN attribut réel n'existait dans le DOM — donc le
  // sélecteur CSS `[data-shape="ellipse"]` (bordure ronde, ligne fine, clip-path polygone/étoile)
  // ne matchait jamais rien pour de vrai. Ce test analyse le HTML avec un vrai parseur, comme un
  // navigateur, plutôt que de chercher une sous-chaîne qui pardonne n'importe quelle malformation.
  it('data-shape est un ATTRIBUT RÉEL et séparé de `class`, analysable par un vrai parseur HTML', () => {
    let c = addLayer(vide(), 'shape', { shapeType: 'ellipse' })
    const { html } = compiler(c)
    const doc = new DOMParser().parseFromString(html, 'text/html')
    const el = doc.querySelector('[data-shape="ellipse"]')
    expect(el).toBeTruthy()
    expect(el.getAttribute('data-shape')).toBe('ellipse')
    expect(el.className.split(/\s+/)).toEqual(['zrm-layer', 'zrm-layer-shape'])
  })

  it('un calque texte ou image ne porte JAMAIS l’ATTRIBUT data-shape sur son élément', () => {
    // Le CSS statique mentionne `[data-shape="ellipse"]` en permanence, feuille de style comprise :
    // on isole donc le BALISAGE en retirant le <style>, sans quoi la sous-chaîne s'y trouve toujours.
    const c = addLayer(vide(), 'text', { source: 'x' })
    const { html } = compiler(c)
    const balisage = html.replace(/<style>[\s\S]*?<\/style>/, '')
    expect(balisage).not.toContain('data-shape')
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Carte P5 — famille Photoshop « Calques, groupes et ordre d'empilement ».
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { readGroups, groupLayers, ungroupLayers, patchGroup, removeGroup, isEffectivelyHidden, isEffectivelyLocked } from './layers.js'

describe('P5 — groupes', () => {
  it('un document sans groupes rend une liste vide', () => {
    expect(readGroups(vide())).toEqual([])
  })

  it('grouper rattache les calques désignés et crée un enregistrement de groupe', () => {
    let c = addLayer(vide(), 'text', { name: 'A' })
    c = addLayer(c, 'text', { name: 'B' })
    const [a, b] = readLayers(c)
    c = groupLayers(c, [a.id, b.id], 'Titre')
    const groupes = readGroups(c)
    expect(groupes).toHaveLength(1)
    expect(groupes[0].name).toBe('Titre')
    expect(readLayers(c).every((l) => l.groupId === groupes[0].id)).toBe(true)
  })

  it('un calque HORS de la liste demandée reste sans groupe', () => {
    let c = addLayer(vide(), 'text', { name: 'A' })
    c = addLayer(c, 'text', { name: 'B' })
    const [a] = readLayers(c)
    c = groupLayers(c, [a.id], 'Solo')
    expect(readLayers(c).find((l) => l.name === 'B').groupId).toBe(null)
  })

  it('grouper un identifiant introuvable ne fait rien, plutôt que de créer un groupe fantôme', () => {
    let c = addLayer(vide(), 'text')
    const avant = c
    c = groupLayers(c, ['inconnu'], 'X')
    expect(readGroups(c)).toEqual([])
  })

  it('dissoudre un groupe libère ses calques sans les toucher autrement', () => {
    let c = addLayer(vide(), 'text', { name: 'A', x: 42 })
    const id = readLayers(c)[0].id
    c = groupLayers(c, [id], 'G')
    const groupeId = readGroups(c)[0].id
    c = ungroupLayers(c, groupeId)
    expect(readGroups(c)).toEqual([])
    const l = readLayers(c)[0]
    expect(l.groupId).toBe(null)
    expect(l.x).toBe(42)
  })

  it('retirer un groupe retire aussi ses calques, contrairement à dissoudre', () => {
    let c = addLayer(vide(), 'text')
    const id = readLayers(c)[0].id
    c = groupLayers(c, [id], 'G')
    c = removeGroup(c, readGroups(c)[0].id)
    expect(readLayers(c)).toEqual([])
    expect(readGroups(c)).toEqual([])
  })

  it('masquer ou verrouiller un groupe masque ou verrouille EFFECTIVEMENT ses membres', () => {
    let c = addLayer(vide(), 'text')
    const id = readLayers(c)[0].id
    c = groupLayers(c, [id], 'G')
    const groupeId = readGroups(c)[0].id
    const l = readLayers(c)[0]
    expect(isEffectivelyHidden(c, l)).toBe(false)
    c = patchGroup(c, groupeId, { hidden: true })
    expect(isEffectivelyHidden(c, readLayers(c)[0])).toBe(true)
    // Le calque LUI-MÊME n'est pas modifié : seul l'effectif change, l'état propre reste lisible.
    expect(readLayers(c)[0].hidden).toBe(false)

    c = patchGroup(c, groupeId, { hidden: false, locked: true })
    expect(isEffectivelyLocked(c, readLayers(c)[0])).toBe(true)
  })

  it('un groupId orphelin (aucun groupe ne le declare) est nettoye a la lecture', () => {
    const c = { ...vide(), groups: [], layers: [{ kind: 'text', groupId: 'grp-fantome' }] }
    const l = readLayers(c)[0]
    expect(l.groupId).toBe(null)
    expect(isEffectivelyHidden(c, l)).toBe(false)
    expect(isEffectivelyLocked(c, l)).toBe(false)
  })
})

describe('P5 — la contiguïté du groupe dans la pile', () => {
  it('grouper deux calques ENTRELACÉS avec un troisième les rend CONTIGUS, sans perdre le troisième', () => {
    let c = addLayer(vide(), 'text', { name: 'A' })   // z0
    c = addLayer(c, 'text', { name: 'X' })             // z1, restera dehors
