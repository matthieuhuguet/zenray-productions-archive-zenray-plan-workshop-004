// Carte L1 — la porte du modèle de calques.
//
// Ce fichier EST le critère de fini de la carte : tant qu'il ne rend pas vert, la carte n'est pas
// finie, et tant que Matthieu ne l'a pas vue à l'écran, elle n'est pas validée. C'est la règle qui
// manquait pendant cinq jours, où aucune carte n'était jamais déclarée close.

import { describe, it, expect } from 'vitest'
import { emptyComposition, normalizeComposition, addComponent, patchItem } from './composition.js'
import {
  addLayer, patchLayer, removeLayer, duplicateLayer, reorderLayer, moveLayerTo, resizeLayerTo,
  readLayers, paintOrder, stackOrder, countLayers, findLayer, filterOf, makeLayer,
  LAYER_KINDS, BLEND_MODES, applyHandle,
} from './layers.js'

const THEME = 'T-01-3-2'
const vide = () => emptyComposition(THEME)

describe('L1 — le modèle de calques', () => {
  it('un document sans calques rend une pile vide, jamais une erreur', () => {
    expect(readLayers(vide())).toEqual([])
    expect(readLayers(null)).toEqual([])
    expect(readLayers({ layers: 'pas un tableau' })).toEqual([])
    expect(countLayers(vide())).toBe(0)
  })

  it('pose chaque type de calque connu et leur donne un identifiant distinct', () => {
    // Le compte suit LAYER_KINDS, pas un chiffre écrit en dur : la carte P5 (PowerPoint) lui a
    // ajouté le tableau après les quatre premiers, un chiffre figé aurait rendu ce test faux.
    let c = vide()
    for (const kind of LAYER_KINDS) c = addLayer(c, kind)
    const ids = readLayers(c).map((l) => l.id)
    expect(ids).toHaveLength(LAYER_KINDS.length)
    expect(new Set(ids).size).toBe(LAYER_KINDS.length)
    expect(readLayers(c).map((l) => l.kind)).toEqual(LAYER_KINDS)
  })

  it('refuse un type de calque inconnu au lieu d’en fabriquer un bancal', () => {
    expect(() => makeLayer(vide(), 'nuage')).toThrow(/inconnu/)
  })

  it('un calque neuf se pose DEVANT, comme dans Photoshop', () => {
    let c = addLayer(vide(), 'text', { name: 'Fond' })
    c = addLayer(c, 'text', { name: 'Milieu' })
    c = addLayer(c, 'text', { name: 'Devant' })
    // L'ordre de peinture va du fond vers l'œil, la pile affichée est son inverse.
    expect(paintOrder(c).map((l) => l.name)).toEqual(['Fond', 'Milieu', 'Devant'])
    expect(stackOrder(c).map((l) => l.name)).toEqual(['Devant', 'Milieu', 'Fond'])
  })

  it('un calque neuf a une taille NON NULLE, sans quoi on le croit perdu', () => {
    const c = addLayer(vide(), 'image')
    const [l] = readLayers(c)
    expect(l.w).toBeGreaterThan(0)
    expect(l.h).toBeGreaterThan(0)
  })

  it('déplace et redimensionne en pixels du canevas, arrondis', () => {
    let c = addLayer(vide(), 'shape')
    const id = readLayers(c)[0].id
    c = moveLayerTo(c, id, 120.4, 55.6)
    c = resizeLayerTo(c, id, 300.2, 0)
    const l = findLayer(c, id)
    expect(l.x).toBe(120)
    expect(l.y).toBe(56)
    expect(l.w).toBe(300)
    expect(l.h).toBe(1)   // jamais zéro : un calque de hauteur nulle est un calque invisible
  })

  it('RÉGLER UN EFFET N’EFFACE PAS LES AUTRES — la faute exacte payée sur item.props', () => {
    let c = addLayer(vide(), 'image')
    const id = readLayers(c)[0].id
    c = patchLayer(c, id, { effects: { blur: 4 } })
    c = patchLayer(c, id, { effects: { saturate: 1.5 } })
    const l = findLayer(c, id)
    expect(l.effects.blur).toBe(4)
    expect(l.effects.saturate).toBe(1.5)
    expect(l.effects.brightness).toBe(1)
  })

  it('la chaîne filter est vide quand rien n’est réglé, et cumulative sinon', () => {
    let c = addLayer(vide(), 'image')
    const id = readLayers(c)[0].id
    expect(filterOf(findLayer(c, id))).toBe('')
    c = patchLayer(c, id, { effects: { blur: 3, saturate: 2 } })
    expect(filterOf(findLayer(c, id))).toBe('blur(3px) saturate(2)')
  })

  it('monte et descend dans la pile, et ne sort jamais des bornes', () => {
    let c = addLayer(vide(), 'text', { name: 'A' })
    c = addLayer(c, 'text', { name: 'B' })
    c = addLayer(c, 'text', { name: 'C' })
    const b = readLayers(c).find((l) => l.name === 'B').id

    c = reorderLayer(c, b, 'up')
    expect(paintOrder(c).map((l) => l.name)).toEqual(['A', 'C', 'B'])
    c = reorderLayer(c, b, 'down')
    expect(paintOrder(c).map((l) => l.name)).toEqual(['A', 'B', 'C'])

    const a = readLayers(c).find((l) => l.name === 'A').id
    const avant = paintOrder(c).map((l) => l.name)
    expect(paintOrder(reorderLayer(c, a, 'down')).map((l) => l.name)).toEqual(avant)
  })

  it('duplique en décalant, sinon on croit que rien ne s’est produit', () => {
    let c = addLayer(vide(), 'shape', { x: 40, y: 40 })
    const id = readLayers(c)[0].id
    c = duplicateLayer(c, id)
    const [source, copie] = paintOrder(c)
    expect(countLayers(c)).toBe(2)
    expect(copie.id).not.toBe(source.id)
    expect(copie.x).toBe(50)
    expect(copie.y).toBe(50)
    expect(copie.name).toMatch(/copie/)
  })

  it('retire un calque sans toucher aux autres', () => {
    let c = addLayer(vide(), 'text', { name: 'A' })
    c = addLayer(c, 'text', { name: 'B' })
    const a = readLayers(c).find((l) => l.name === 'A').id
    c = removeLayer(c, a)
    expect(readLayers(c).map((l) => l.name)).toEqual(['B'])
  })

  it('répare un document abîmé au lieu de le jeter', () => {
    const abime = {
      ...vide(),
      layers: [
        null,
        { kind: 'nuage' },                                  // type inconnu : écarté
        { kind: 'text', opacity: 9, blend: 'plasma', w: -5 }, // valeurs hors bornes : ramenées
      ],
    }
    const [l] = readLayers(abime)
    expect(readLayers(abime)).toHaveLength(1)
    expect(l.opacity).toBe(1)
    expect(l.blend).toBe('normal')
    expect(l.w).toBeGreaterThan(0)
    expect(BLEND_MODES).toContain(l.blend)
  })

  // ─────────────────────────────────────────────────────────────────────────────────────────────
  // LE POINT QUI DÉCIDE DE TOUTE LA CARTE : les calques cohabitent avec le modèle existant sans
  // que le contrat de `composition.js` soit rouvert. C'est le cadeau de la carte C1 du 2026-08-01,
  // et si ce test tombe, la carte L1 est fausse quelles que soient les autres.
  // ─────────────────────────────────────────────────────────────────────────────────────────────
  it('les calques SURVIVENT à normalizeComposition et aux gestes du modèle Lego', () => {
    let c = addLayer(vide(), 'image', { name: 'Fond PNG', x: 12, y: 34 })
    c = addComponent(c, { id: 'C-titre', name: 'Titre', group: 'Éditorial' })
    c = normalizeComposition(c, THEME)

    const item = c.rows[0].items[0]
    c = patchItem(c, item.id, { props: { title: 'Bonjour' } })
    c = normalizeComposition(c, THEME)

    const l = readLayers(c)[0]
    expect(l.name).toBe('Fond PNG')
    expect(l.x).toBe(12)
    expect(l.y).toBe(34)
    expect(c.rows[0].items[0].props.title).toBe('Bonjour')
  })

  it('survit à un aller-retour par JSON, puisque le document vit sur disque', () => {
    let c = addLayer(vide(), 'text', { source: 'Un titre', x: 7 })
    c = patchLayer(c, readLayers(c)[0].id, { effects: { blur: 2 } })
    const relu = normalizeComposition(JSON.parse(JSON.stringify(c)), THEME)
    const l = readLayers(relu)[0]
    expect(l.source).toBe('Un titre')
    expect(l.x).toBe(7)
    expect(l.effects.blur).toBe(2)
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Carte L2 — la porte de la compilation. Un calque posé à x=120 doit produire `left:120px` dans
// la page réellement compilée, et non dans une approximation.
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { compile } from './compile.js'
import { getFormat } from './formats.js'
import { buildCut } from './cut.js'

const BRIEF = { title: 'Essai', message: 'Une seule phrase suffit.', audience: 'Toi', register: 'créateur', intent: 'informer', evidence: [], constraints: { languages: ['fr'], mentions: [] }, sources: [] }
const THEME_MIN = {
  id: THEME, name: 'Essai', family: '01', description: '', html: '',
  fonts: [], typography: { measure: 68, scale: { base: 17, ratio: 1.25 } },
  beatCount: { min: 1, max: 8 }, motion: { enabled: false, enter: 0 }, palette: {},
}

function compiler(composition, extra = {}) {
  const format = getFormat('F-still-1080-square')
  const cut = buildCut('Un titre.\n\nUn corps de texte.', THEME_MIN, 1)
  return compile({ brief: BRIEF, cut, theme: THEME_MIN, format, composition, componentBundle: { components: [] }, ...extra })
}

describe('L2 — la compilation des calques', () => {
  it('écrit la position au pixel dans la page compilée', () => {
    let c = addLayer(vide(), 'text', { x: 120, y: 64, w: 400, h: 90, source: 'Bonjour' })
    const { html } = compiler(c)
    expect(html).toContain('left:120px')
    expect(html).toContain('top:64px')
    expect(html).toContain('width:400px')
    expect(html).toContain('Bonjour')
  })

  it('un document SANS rangée mais AVEC un calque ouvre bien la voie composée', () => {
    const c = addLayer(vide(), 'shape', { x: 10 })
    const { html, meta } = compiler(c)
    expect(html).toContain('data-zrm-composed="1"')
    expect(meta.source).toBe('composition')
  })

  it('l’ordre du DOM suit le rang : le plus élevé s’écrit en dernier, donc devant', () => {
    let c = addLayer(vide(), 'text', { source: 'FOND' })
    c = addLayer(c, 'text', { source: 'DEVANT' })
    const { html } = compiler(c)
    expect(html.indexOf('FOND')).toBeLessThan(html.indexOf('DEVANT'))
  })

  it('un calque masqué ne sort pas dans la page', () => {
    let c = addLayer(vide(), 'text', { source: 'VISIBLE' })
    c = addLayer(c, 'text', { source: 'CACHE', hidden: true })
    const { html } = compiler(c)
    expect(html).toContain('VISIBLE')
    expect(html).not.toContain('CACHE')
  })

  it('opacité, fusion et effets partent dans le style, et rien quand ils valent le défaut', () => {
    let c = addLayer(vide(), 'image', { source: 'https://exemple/x.png' })
    const neutre = compiler(c).html
    expect(neutre).not.toContain('mix-blend-mode')
    expect(neutre).not.toContain('filter:')

    c = patchLayer(c, readLayers(c)[0].id, { opacity: 0.4, blend: 'multiply', effects: { blur: 6 } })
    const regle = compiler(c).html
    expect(regle).toContain('opacity:0.4')
    expect(regle).toContain('mix-blend-mode:multiply')
    expect(regle).toContain('filter:blur(6px)')
  })

  it('le texte d’un calque est ÉCHAPPÉ : c’est la seule entrée libre du modèle', () => {
    const c = addLayer(vide(), 'text', { source: '<script>alert(1)</script>' })
    const { html } = compiler(c)
    expect(html).not.toContain('<script>alert(1)')
    expect(html).toContain('&lt;script&gt;')
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Carte L6 — la porte du geste. Huit poignées, et le piège de l'échelle.
// ═══════════════════════════════════════════════════════════════════════════════════════════════
describe('L6 — la géométrie du geste', () => {
  const depart = { x: 100, y: 100, w: 200, h: 100 }

  it('déplace sans changer la taille', () => {
    expect(applyHandle(depart, 'move', 30, -20)).toEqual({ x: 130, y: 80, w: 200, h: 100 })
  })

  it('tirer le côté est allonge, l’origine ne bouge pas', () => {
    expect(applyHandle(depart, 'e', 50, 0)).toEqual({ x: 100, y: 100, w: 250, h: 100 })
  })

  it('tirer le côté OUEST déplace l’origine ET réduit la largeur d’autant', () => {
    expect(applyHandle(depart, 'w', 40, 0)).toEqual({ x: 140, y: 100, w: 160, h: 100 })
  })

  it('le coin nord-ouest agit sur les deux axes à la fois', () => {
    expect(applyHandle(depart, 'nw', 20, 10)).toEqual({ x: 120, y: 110, w: 180, h: 90 })
  })

  it('ne se replie jamais sous un pixel, même tiré très au-delà', () => {
    const r = applyHandle(depart, 'se', -9999, -9999)
    expect(r.w).toBe(1)
    expect(r.h).toBe(1)
  })

  it('arrondit toujours : le modèle ne porte pas de demi-pixel', () => {
    expect(applyHandle(depart, 'move', 0.4, 0.6)).toEqual({ x: 100, y: 101, w: 200, h: 100 })
  })

  // FAMILLE POWERPOINT 2 · « Maj conserve les proportions », dans un coin. `depart` est en 2:1
  // (200×100) ; `dy` fourni vaut délibérément 999, une valeur absurde, pour prouver que le
  // résultat ne lui doit RIEN — seul le ratio de départ pilote le second axe.
  it('« conserver les proportions » recalcule le second axe au ratio de départ, coin SE', () => {
    expect(applyHandle(depart, 'se', 50, 999, true)).toEqual({ x: 100, y: 100, w: 250, h: 125 })
  })

  it('« conserver les proportions » fonctionne aussi au coin NW, signes opposés', () => {
    expect(applyHandle(depart, 'nw', 20, 999, true)).toEqual({ x: 120, y: 110, w: 180, h: 90 })
  })

  it('« conserver les proportions » fonctionne au coin SW, la combinaison de signes la plus piégeuse', () => {
    expect(applyHandle(depart, 'sw', -20, 999, true)).toEqual({ x: 80, y: 100, w: 220, h: 110 })
  })

  it('sans le drapeau (par défaut), le comportement reste EXACTEMENT celui d’avant', () => {
    expect(applyHandle(depart, 'se', 50, 30)).toEqual({ x: 100, y: 100, w: 250, h: 130 })
  })

  it('un CÔTÉ simple (une seule lettre) ignore le drapeau : un ratio n’a de sens que dans un coin', () => {
    expect(applyHandle(depart, 'e', 50, 999, true)).toEqual({ x: 100, y: 100, w: 250, h: 100 })
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Le style propre d'un calque — « la fonction texte, je veux qu'elle soit parfaite ».
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { styleOf, LAYER_STYLES } from './layers.js'

describe('le style d’un calque', () => {
  it('un calque neuf n’impose aucun style', () => {
    expect(styleOf(readLayers(addLayer(vide(), 'text'))[0])).toBe('')
  })

  it('écrit en tiret, et cumule sans écraser', () => {
    let c = addLayer(vide(), 'text')
    const id = readLayers(c)[0].id
    c = patchLayer(c, id, { style: { fontSize: '48px' } })
    c = patchLayer(c, id, { style: { color: '#112233' } })
    const rendu = styleOf(findLayer(c, id))
    expect(rendu).toContain('font-size:48px')
    expect(rendu).toContain('color:#112233')
  })

  it('refuse une propriété hors liste et neutralise une valeur qui sort de l’attribut', () => {
    let c = addLayer(vide(), 'text')
    const id = readLayers(c)[0].id
    c = patchLayer(c, id, { style: { position: 'fixed', color: 'red;"><script>' } })
    const rendu = styleOf(findLayer(c, id))
    expect(rendu).not.toContain('position')
    expect(rendu).not.toContain('<script>')
  })

  it('le style part dans la page compilée, et le retour à la ligne devient un saut', () => {
    let c = addLayer(vide(), 'text', { source: 'Une ligne\nune autre' })
    c = patchLayer(c, readLayers(c)[0].id, { style: { fontSize: '64px', textAlign: 'center' } })
    const { html } = compiler(c)
    expect(html).toContain('font-size:64px')
    expect(html).toContain('text-align:center')
    expect(html).toContain('Une ligne<br>une autre')
  })

  it('la liste des réglages reste fermée et complète', () => {
    expect(LAYER_STYLES).toHaveLength(14)
    expect(LAYER_STYLES.every((c) => c.key && c.label && c.type)).toBe(true)
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Carte S2 — famille « Viewports et manipulation directe ». Rotation, magnétisme, cadrage.
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { snapMove, frameBox, transformOf } from './layers.js'

describe('S2 — rotation', () => {
  it('un calque neuf n’a aucune rotation, donc aucune transformation dans la page', () => {
    const l = readLayers(addLayer(vide(), 'shape'))[0]
    expect(l.rotation).toBe(0)
    expect(transformOf(l)).toBe('')
  })

  it('la rotation reste dans 0-359, jamais négative ni au-delà d’un tour', () => {
    let c = addLayer(vide(), 'shape')
    const id = readLayers(c)[0].id
    c = patchLayer(c, id, { rotation: -30 })
    expect(findLayer(c, id).rotation).toBe(330)
    c = patchLayer(c, id, { rotation: 730 })
    expect(findLayer(c, id).rotation).toBe(10)
  })

  it('la transformation part dans la page compilée, avec un pivot au centre', () => {
    let c = addLayer(vide(), 'text', { source: 'X' })
    c = patchLayer(c, readLayers(c)[0].id, { rotation: 45 })
    const { html } = compiler(c)
    expect(html).toContain('transform:rotate(45deg)')
    expect(html).toContain('transform-origin:center')
  })
})

describe('S2 — magnétisme', () => {
  const canvas = { w: 1000, h: 1000 }

  it('accroche au bord gauche et au centre du canevas, sous le seuil', () => {
    const r1 = snapMove({ x: 3, y: 200, w: 100, h: 50 }, [], canvas)
    expect(r1.x).toBe(0)
    expect(r1.guides.x).toBe(0)

    const r2 = snapMove({ x: 448, y: 200, w: 100, h: 50 }, [], canvas)   // centre à 498, cible 500
    expect(r2.x).toBe(450)
    expect(r2.guides.x).toBe(500)
  })

  it('n’accroche à RIEN au-delà du seuil : le magnétisme doit pouvoir se relâcher', () => {
    const r = snapMove({ x: 40, y: 40, w: 100, h: 50 }, [], canvas)
    expect(r.x).toBe(40)
    expect(r.guides.x).toBe(null)
  })

  it('accroche sur le bord d’un AUTRE calque, pas seulement sur le canevas', () => {
    const autre = { x: 300, y: 300, w: 100, h: 100 }
    const r = snapMove({ x: 402, y: 300, w: 50, h: 50 }, [autre], canvas)   // bord droit de l'autre = 400
    expect(r.x).toBe(400)
    expect(r.guides.x).toBe(400)
  })

  it('choisit l’accroche la plus proche quand plusieurs sont dans la fenêtre', () => {
    // Le centre du canevas (500) et un calque à 503 sont tous deux à portée depuis x=498(centre) :
    // le plus proche doit gagner, pas le premier de la liste.
    const proche = { x: 480, y: 200, w: 46, h: 20 }   // centre à 503
    const r = snapMove({ x: 448, y: 200, w: 100, h: 50 }, [proche], canvas) // centre candidat 498
    expect(r.guides.x).toBe(500)   // plus proche de 498 que 503
  })
})

describe('S2 — cadrage de la sélection', () => {
  it('centre le calque et calcule un zoom qui le fait tenir avec sa marge', () => {
    const r = frameBox({ x: 100, y: 100, w: 200, h: 100 }, 800, 600)
    // Boîte marge comprise : 200*1.24=248, 100*1.24=124. Zoom = min(800/248, 600/124) borné par la largeur.
    expect(r.zoom).toBeCloseTo(800 / 248, 2)
    // Le centre de la boîte (200,150) doit se retrouver au centre du viewport après pan+zoom.
    expect(Math.round(200 * r.zoom + r.pan.x)).toBe(400)
    expect(Math.round(150 * r.zoom + r.pan.y)).toBe(300)
  })

  it('ne dépasse jamais les bornes de zoom, même sur un calque minuscule', () => {
    const r = frameBox({ x: 0, y: 0, w: 1, h: 1 }, 800, 600)
    expect(r.zoom).toBeLessThanOrEqual(8)
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Carte S3 — famille « Docking ». La géométrie du glisser d'une poignée, jsdom simulant mal
// PointerEvent.clientX, exactement le motif déjà retenu pour applyHandle (L6) et snapMove (S2).
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { resizedColumn } from './layers.js'

describe('S3 — redimensionnement des colonnes', () => {
  it('la poignée gauche grandit sa colonne en s’éloignant du centre, vers la droite', () => {
    expect(resizedColumn('left', 212, 80)).toBe(292)
  })

  it('la poignée droite grandit sa colonne en s’éloignant du centre, vers la GAUCHE', () => {
    // Le signe est inversé par rapport à la gauche : tirer vers la gauche (delta négatif) doit
    // AGRANDIR la colonne droite, exactement l'inverse d'une colonne gauche.
    expect(resizedColumn('right', 244, -80)).toBe(324)
  })

  it('ne descend jamais sous son plancher, propre à chaque côté', () => {
    expect(resizedColumn('left', 212, -9999)).toBe(140)
    expect(resizedColumn('right', 244, 9999)).toBe(160)
  })

  it('ne dépasse jamais son plafond, propre à chaque côté', () => {
    expect(resizedColumn('left', 212, 9999)).toBe(460)
    expect(resizedColumn('right', 244, -9999)).toBe(520)
  })
})

// ═══════════════════════════════════════════════════════════════════════════════════════════════
// Carte P1 — famille Photoshop « Sélection et ciblage ». La sélection rectangulaire réinterprétée
// pour un modèle en calques : elle isole des CALQUES, pas des pixels.
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { layersInRect } from './layers.js'

describe('P1 — sélection rectangulaire de calques', () => {
  const A = { id: 'a', x: 0, y: 0, w: 100, h: 100 }
  const B = { id: 'b', x: 200, y: 200, w: 50, h: 50 }
  const C = { id: 'c', x: 90, y: 90, w: 30, h: 30 }   // chevauche A d'un coin

  it('un rectangle qui contient entièrement un calque le sélectionne', () => {
    expect(layersInRect([A, B], { x1: -10, y1: -10, x2: 150, y2: 150 })).toEqual(['a'])
  })

  it('un simple CHEVAUCHEMENT suffit, comme dans Photoshop : pas besoin d’envelopper entièrement', () => {
    expect(layersInRect([A, C], { x1: 80, y1: 80, x2: 120, y2: 120 })).toEqual(['a', 'c'])
  })

  it('ne sélectionne rien hors de portée', () => {
    expect(layersInRect([A, B], { x1: 500, y1: 500, x2: 600, y2: 600 })).toEqual([])
  })

  it('fonctionne quelle que soit la direction du glisser (coins inversés)', () => {
    // Glisser de bas-droite vers haut-gauche donne x1>x2 et y1>y2 : le rectangle reste le même.
    expect(layersInRect([A], { x1: 150, y1: 150, x2: -10, y2: -10 })).toEqual(['a'])
  })

  it('un calque tangent au bord, sans recouvrement réel, n’est pas sélectionné', () => {
    expect(layersInRect([A], { x1: 100, y1: 0, x2: 200, y2: 100 })).toEqual([])
  })
})

