    let c = addLayer(vide(), 'image', { source: '' })
    c = addLayer(c, 'image', { source: 'https://exemple.test/photo.jpg' })
    c = addLayer(c, 'text', { source: '' })   // un texte vide n'est pas une image sans source
    const [sansSource, avecSource] = readLayers(c)
    expect(layersMissingImageSource(c)).toEqual([sansSource.id])
    expect(layersMissingImageSource(c)).not.toContain(avecSource.id)
  })

  it('layersMissingImageSource rend un tableau vide sans aucune image', () => {
    expect(layersMissingImageSource(vide())).toEqual([])
  })
})

// AUDIT P0-T8 · un champ CSS libre (bordure, ombre portée) ne doit jamais pouvoir fermer
// l'attribut `style` qui le porte, y ajouter une déclaration, ni charger une ressource distante.
import { safeCssValue } from './layers.js'

describe('safeCssValue (AUDIT P0-T8)', () => {
  it('laisse passer une valeur CSS ordinaire intacte', () => {
    expect(safeCssValue('0 10px 30px rgba(0,0,0,.4)')).toBe('0 10px 30px rgba(0,0,0,.4)')
    expect(safeCssValue('1px solid #000')).toBe('1px solid #000')
  })

  it('retire les caractères qui casseraient l’attribut style ou ajouteraient une déclaration', () => {
    expect(safeCssValue('0 0 0 red; background:red')).toBe('0 0 0 red background:red')
    expect(safeCssValue('0 0 0 red"><script>alert(1)</script>')).toBe('0 0 0 redscriptalert(1)/script')
  })

  it('refuse ENTIÈREMENT une valeur qui charge une ressource distante via url()', () => {
    expect(safeCssValue('url(https://exemple.test/pixel.gif)')).toBe('')
    expect(safeCssValue('  URL( //exemple.test/x.png )')).toBe('')   // insensible à la casse et aux espaces
  })

  it('rend une chaîne vide pour toute valeur non textuelle', () => {
    expect(safeCssValue(null)).toBe('')
    expect(safeCssValue(undefined)).toBe('')
    expect(safeCssValue(42)).toBe('')
  })

  it('la page compilée ne porte JAMAIS une ombre qui injecte une déclaration ou une ressource distante', () => {
    let c = addLayer(vide(), 'shape', {})
    const [calque] = readLayers(c)
    c = patchLayer(c, calque.id, { effects: { shadow: '0 0 0 red; background:url(https://exemple.test/pixel.gif)' } })
    const { html } = compiler(c)
    expect(html).not.toContain('url(https://exemple.test/pixel.gif)')
    expect(html).not.toMatch(/box-shadow:[^"]*;\s*background/)   // aucune seconde déclaration après box-shadow
  })
})

// AUDIT P1-R9 · le conteneur SYSTÈME d'une diapositive ou d'une page parente réemploie un groupe
// ordinaire ; sans garde-fou, Dissoudre ou Supprimer sur ce groupe précis peut faire disparaître la
// page entière de `readSlides`/`readParentPages`, silencieusement.
import { isSystemGroupId } from './layers.js'

describe('isSystemGroupId / garde-fous de groupe (AUDIT P1-R9)', () => {
  it('identifie le groupe conteneur d’une diapositive, jamais un groupe ordinaire', () => {
    let c = addSlide(vide(), 'Diapo')
    const [diapo] = readSlides(c)
    c = addLayer(c, 'shape', {})
    c = addLayer(c, 'shape', {})
    const [a, b] = readLayers(c)
    c = groupLayers(c, [a.id, b.id])
    // Deux groupes coexistent maintenant : celui de la diapositive (déjà là) et celui que
    // `groupLayers` vient de créer — les distinguer par exclusion, jamais par position.
    const groupeOrdinaire = readGroups(c).find((g) => g.id !== diapo.groupId)
    expect(isSystemGroupId(c, diapo.groupId)).toBe(true)
    expect(isSystemGroupId(c, groupeOrdinaire.id)).toBe(false)
    expect(isSystemGroupId(c, 'grp-inexistant')).toBe(false)
    expect(isSystemGroupId(c, null)).toBe(false)
  })

  it('identifie AUSSI le groupe conteneur d’une page parente', () => {
    const c = addParentPage(vide(), 'Gabarit')
    const [page] = readParentPages(c)
    expect(isSystemGroupId(c, page.groupId)).toBe(true)
  })

  it('ungroupLayers REFUSE le conteneur d’une diapositive : la diapositive reste lisible', () => {
    let c = addSlide(vide(), 'Diapo')
    const [diapo] = readSlides(c)
    const avant = c
    c = ungroupLayers(c, diapo.groupId)
    expect(c).toBe(avant)   // aucun changement : la fonction refuse purement et simplement
    expect(readSlides(c)).toHaveLength(1)
    expect(readGroups(c).some((g) => g.id === diapo.groupId)).toBe(true)
  })

  it('removeGroup REFUSE le conteneur d’une diapositive : son contenu n’est jamais effacé', () => {
    let c = addSlide(vide(), 'Diapo')
    const [diapo] = readSlides(c)
    c = addLayer(c, 'text', { groupId: diapo.groupId })
    const layerId = readLayers(c).find((l) => l.groupId === diapo.groupId)?.id
    expect(layerId).toBeTruthy()
    const avant = c
    c = removeGroup(c, diapo.groupId)
    expect(c).toBe(avant)
    expect(readLayers(c).some((l) => l.id === layerId)).toBe(true)   // le calque de la diapositive survit
    expect(readSlides(c)).toHaveLength(1)
  })

  it('removeGroup REFUSE de même le conteneur d’une page parente', () => {
    let c = addParentPage(vide(), 'Gabarit')
    const [page] = readParentPages(c)
    const avant = c
    c = removeGroup(c, page.groupId)
    expect(c).toBe(avant)
    expect(readParentPages(c)).toHaveLength(1)
  })

  it('un groupe ORDINAIRE, lui, se dissout et se supprime normalement — le garde-fou est ciblé', () => {
    let c = addLayer(vide(), 'shape', {})
    c = addLayer(c, 'shape', {})
    const [a, b] = readLayers(c)
    c = groupLayers(c, [a.id, b.id])
    const [groupe] = readGroups(c)
    c = ungroupLayers(c, groupe.id)
    expect(readGroups(c)).toHaveLength(0)
    expect(readLayers(c).every((l) => l.groupId === null)).toBe(true)
  })
})

import { readVisibleLayers } from './layers.js'

describe('readVisibleLayers — le même ensemble pour marquee, magnétisme et clavier (AUDIT P1-R4)', () => {
  it('exclut un calque d’une diapositive qui n’est pas l’active', () => {
    let c = addSlide(vide(), 'Diapo 1')
    const [diapo1] = readSlides(c)
    c = addSlide(c, 'Diapo 2')
    const diapo2 = readSlides(c).find((s) => s.id !== diapo1.id)
    c = addLayer(c, 'shape', { groupId: diapo1.groupId })
    c = addLayer(c, 'shape', { groupId: diapo2.groupId })
    c = setActiveSlide(c, diapo2.id)
    const visibles = readVisibleLayers(c)
    expect(visibles).toHaveLength(1)
    expect(visibles[0].groupId).toBe(diapo2.groupId)
  })

  it('exclut un calque dont le GROUPE est masqué, même si le calque lui-même ne l’est pas', () => {
    let c = addLayer(vide(), 'shape', {})
    c = addLayer(c, 'shape', {})
    const [a, b] = readLayers(c)
    c = groupLayers(c, [a.id, b.id])
    const [groupe] = readGroups(c)
    c = patchGroup(c, groupe.id, { hidden: true })
    expect(readVisibleLayers(c)).toHaveLength(0)
    expect(readLayers(c).every((l) => !l.hidden)).toBe(true)   // les calques eux-mêmes restent intacts
  })

  it('inclut un calque global (sans diapositive) quelle que soit la diapositive active', () => {
    let c = addSlide(vide(), 'Diapo 1')
    const [diapo1] = readSlides(c)
    c = addLayer(c, 'shape', {})   // groupId: null, un masque global classique
    c = setActiveSlide(c, diapo1.id)
    expect(readVisibleLayers(c).some((l) => l.groupId === null)).toBe(true)
  })
})
