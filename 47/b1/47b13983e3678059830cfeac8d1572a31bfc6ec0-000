// Carte P2 — famille Photoshop « Déplacement, alignement et transformation ».
// ═══════════════════════════════════════════════════════════════════════════════════════════════
import { alignPatch, distributePatch } from './layers.js'

describe('P2 — retournement', () => {
  it('un calque neuf n’a aucun retournement', () => {
    const l = readLayers(addLayer(vide(), 'shape'))[0]
    expect(l.flipX).toBe(false)
    expect(l.flipY).toBe(false)
    expect(transformOf(l)).toBe('')
  })

  it('le retournement part dans la transformation, le flip AVANT la rotation dans la chaîne', () => {
    let c = addLayer(vide(), 'image', { source: 'x.png' })
    c = patchLayer(c, readLayers(c)[0].id, { flipX: true, rotation: 30 })
    const l = findLayer(c, readLayers(c)[0].id)
    expect(transformOf(l)).toBe('rotate(30deg) scale(-1, 1)')
  })

  it('les deux retournements combinés donnent une rotation de 180°, pas un no-op', () => {
    const l = readLayers(patchLayer(addLayer(vide(), 'shape'), readLayers(addLayer(vide(), 'shape'))[0]?.id || '', {}))[0]
    // Vérifie juste la formule, indépendamment du modèle : deux scale négatifs équivalent à
    // scale(-1,-1), jamais annulés l'un par l'autre.
    expect(transformOf({ rotation: 0, flipX: true, flipY: true })).toBe('scale(-1, -1)')
  })
})

describe('P2 — alignement', () => {
  const A = { id: 'a', x: 0, y: 0, w: 100, h: 40 }
  const B = { id: 'b', x: 300, y: 200, w: 40, h: 100 }

  it('aligne à gauche sur le bord le plus à gauche de la sélection', () => {
    expect(alignPatch([A, B], 'left')).toEqual([{ id: 'a', x: 0 }, { id: 'b', x: 0 }])
  })

  it('aligne à droite sur le bord le plus à droite', () => {
    // Boîte englobante : de x=0 à x=340. B (déjà à 300, largeur 40) touche déjà le bord droit.
    expect(alignPatch([A, B], 'right')).toEqual([{ id: 'a', x: 240 }, { id: 'b', x: 300 }])
  })

  it('centre horizontalement sans jamais toucher à l’axe vertical', () => {
    const patches = alignPatch([A, B], 'hcenter')
    expect(patches.every((p) => !('y' in p))).toBe(true)
  })

  it('aligne en haut, en bas, et au centre vertical', () => {
    expect(alignPatch([A, B], 'top')).toEqual([{ id: 'a', y: 0 }, { id: 'b', y: 0 }])
    // La boîte va de y=0 à y=300 (bas de B). Aligner en bas place le BAS de chaque calque sur 300 :
    // A (hauteur 40) descend à 260, B (hauteur 100) reste à 200, il touchait déjà ce bord.
    expect(alignPatch([A, B], 'bottom')).toEqual([{ id: 'a', y: 260 }, { id: 'b', y: 200 }])
  })

  it('un seul calque n’a rien à aligner : rien à faire, jamais une erreur', () => {
    expect(alignPatch([A], 'left')).toEqual([])
  })

  // FAMILLE POWERPOINT 2 · un calque UNIQUE s'aligne sur le CANEVAS, pas sur lui-même — c'est ce
  // que font PowerPoint, Figma et Miro tous les trois, et c'est l'usage le plus courant de la
  // commande (centrer un logo sur la diapositive).
  it('un seul calque s’aligne sur le CANEVAS dès qu’on lui en donne un', () => {
    const solo = { id: 'a', x: 999, y: 999, w: 100, h: 40 }
    expect(alignPatch([solo], 'left', { w: 1000, h: 1000 })).toEqual([{ id: 'a', x: 0 }])
    expect(alignPatch([solo], 'hcenter', { w: 1000, h: 1000 })).toEqual([{ id: 'a', x: 450 }])
    expect(alignPatch([solo], 'right', { w: 1000, h: 1000 })).toEqual([{ id: 'a', x: 900 }])
    expect(alignPatch([solo], 'top', { w: 1000, h: 1000 })).toEqual([{ id: 'a', y: 0 }])
    expect(alignPatch([solo], 'bottom', { w: 1000, h: 1000 })).toEqual([{ id: 'a', y: 960 }])
  })

  it('deux calques ou plus ignorent le canevas : l’alignement mutuel reste inchangé', () => {
    expect(alignPatch([A, B], 'left', { w: 1000, h: 1000 })).toEqual([{ id: 'a', x: 0 }, { id: 'b', x: 0 }])
  })
})

