// 10 October 2026: Hyper-simple live transfer progress bar, throughput, active pushes and 24h recent files in ZenRay Assets.
it('shows one upload card and a 24 h media toggle that opens the media in Create (11 October 2026)', async () => {
  const originalFetch = globalThis.fetch
  const nowIso = new Date().toISOString()
  globalThis.fetch = vi.fn().mockResolvedValue({
    ok: true,
    json: async () => ({
      active: [
        { id: 'sequential-42', title: 'Films et séries', updatedAt: nowIso, completedUnits: 12, totalUnits: 230,
          completedBytes: 3_221_225_472, totalBytes: 270_582_939_648, bytesPerSecond: 14_500_000,
          currentItem: 'Initial-D-S01E02.mkv', currentStep: '[13/208] Empaquetage HLS + DASH (64 Mio)' },
        { id: 'git-push-7', kind: 'push', updatedAt: nowIso },
      ],
      recentFiles: [
        { name: 'Initial-D-S01E01.mkv', updatedAt: nowIso, path: 'pages/Movies/Initial-D-S01E01.mkv.media.json', folder: 'pages/Movies' },
      ],
    }),
  })
  const opened = []
  const onOpen = (e) => opened.push(['page', e.detail.path])
  const onFolder = (e) => opened.push(['folder', e.detail.path])
  window.addEventListener('zr:open-page', onOpen)
  window.addEventListener('zr:open-folder', onFolder)
  try {
    render(<ProjectWorkspace projects={[{ id: 'tiles', name: 'Tiles', files: [] }]} activeProjectId="tiles" />)
    const panel = await screen.findByRole('region', { name: 'Uploads en cours et nouveaux médias' })
    expect(within(panel).getByText('Films et séries')).toBeDefined()
    expect(within(panel).getByText('5 %')).toBeDefined()
    expect(within(panel).getByText('12 / 230')).toBeDefined()
    expect(within(panel).getByText(/13,8 Mo\/s/)).toBeDefined()
    expect(within(panel).getByText('Initial-D-S01E02')).toBeDefined()
    expect(within(panel).getByText('Empaquetage HLS + DASH (64 Mio)')).toBeDefined()
    expect(within(panel).getByText(/envoi Git en arrière-plan/)).toBeDefined()
    expect(within(panel).queryByText('Initial-D-S01E01')).toBeNull()
    fireEvent.click(within(panel).getByRole('button', { name: /Nouveaux médias/ }))
    expect(within(panel).getByText('Initial-D-S01E01').closest('a').getAttribute('href')).toBe('/?page=pages%2FMovies%2FInitial-D-S01E01.mkv.media.json')
    expect(within(panel).getByRole('link', { name: 'Dossier' }).getAttribute('href')).toBe('/?folder=pages%2FMovies')
  } finally {
    window.removeEventListener('zr:open-page', onOpen)
    window.removeEventListener('zr:open-folder', onFolder)
    globalThis.fetch = originalFetch
  }
})


