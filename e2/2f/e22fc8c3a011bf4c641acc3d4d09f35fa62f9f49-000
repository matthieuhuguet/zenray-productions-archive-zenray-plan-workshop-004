// 4 October 2026: the GitHub CLI as the only credential holder; the engine never reads or prints a token.
// FR : la CLI GitHub detient seule le jeton ; le moteur ne le lit ni ne l'affiche jamais.
import { execFile } from 'node:child_process'
import { promisify } from 'node:util'

const run = promisify(execFile)

export function createGh({ exec = run, bin = 'gh' } = {}) {
  async function call(args, { input } = {}) {
    try {
      const child = exec(bin, args, { maxBuffer: 64 * 1024 * 1024, timeout: 120000 })
      if (input !== undefined) child.child?.stdin?.end(input)
      return (await child).stdout
    } catch (error) {
      const message = String(error.stderr || error.message || error).trim().split('\n')[0]
      throw new Error(`gh ${args.slice(0, 3).join(' ')} failed: ${message}`)
    }
  }
  return {
    /** A file's exact bytes at a ref, as text. */
    raw: (repo, path, ref) => call(['api', '-H', 'Accept: application/vnd.github.raw', `repos/${repo}/contents/${path}?ref=${encodeURIComponent(ref)}`]),
    /** The head commit sha of a branch. */
    head: async (repo, ref) => JSON.parse(await call(['api', `repos/${repo}/commits/${encodeURIComponent(ref)}`, '--jq', '{sha: .sha}'])).sha,
    call,
  }
}
