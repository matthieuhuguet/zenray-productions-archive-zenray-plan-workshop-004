// playerPrefs.js (14 October 2026): the player choices that follow Matthieu from one video to the next.
// EN: subtitle language, subtitles on/off, playback speed, audio language and quality are saved in localStorage the moment they are
// picked and read again when the next video opens, whatever the player (VideoPlayer2, VideoPlayer, StreamVideo, StreamVideoMSE).
// The subtitle size, the opaque background and the family already live in subtitleSettings.js and are shared the same way.
// A language is saved as a short code (ja, en, fr), never as a track id: "track-0" is not the same language in every film.
// FR : langue des sous-titres, sous-titres actifs, vitesse, langue audio et qualite suivent d'une video a l'autre, quel que soit le lecteur.
// Une langue se sauvegarde par son code court, jamais par l'identifiant de piste.
export const PLAYER_PREF_KEYS = {
  subLang: 'zr-player-sub-lang',
  subsOn: 'zr-player-subs-on',
  speed: 'zr-player-speed',
  audioLang: 'zr-player-audio-lang',
  qualityHeight: 'zr-player-quality-height',
}
// Any rate a player menu can offer (the menus go from 0.5x to 3x); outside this range the saved value is ignored.
export const SPEED_RANGE = { min: 0.25, max: 4 }

const LANGUAGE_CODES = {
  fr: 'fr', fre: 'fr', fra: 'fr', french: 'fr', francais: 'fr', francaise: 'fr',
  en: 'en', eng: 'en', english: 'en', anglais: 'en',
  ja: 'ja', jp: 'ja', jpn: 'ja', japanese: 'ja', japonais: 'ja', nihongo: 'ja', '日本語': 'ja',
}

/** Short language code of a code or a label ("fre", "Français", "English (ASS)", "日本語"), '' when unknown. */
export function normalizeLang(value) {
  if (value == null) return ''
  const text = String(value).normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim()
  if (!text || text === 'und' || text === 'unknown') return ''
  if (LANGUAGE_CODES[text]) return LANGUAGE_CODES[text]
  const primary = text.split(/[-_]/)[0]
  if (LANGUAGE_CODES[primary]) return LANGUAGE_CODES[primary]
  const word = text.match(/[a-z぀-ヿ一-鿿]+/g) || []
  for (const piece of word) if (LANGUAGE_CODES[piece]) return LANGUAGE_CODES[piece]
  return /^[a-z]{2,3}$/.test(primary) ? primary : ''
}

/** Language of a track object: its lang first, then its label or title. */
export function trackLang(track) {
  if (!track) return ''
  return normalizeLang(track.lang) || normalizeLang(track.language) || normalizeLang(track.label) || normalizeLang(track.title) || normalizeLang(track.name)
}

/** The track in the wanted language, or null (the caller decides the fallback). */
export function findByLang(tracks, wanted, langOf = trackLang) {
  const code = normalizeLang(wanted)
  if (!code || !Array.isArray(tracks)) return null
  return tracks.find((track) => langOf(track) === code) || null
}

/** Quality: the highest level that does not exceed the saved height, else the lowest one. */
export function pickLevelByHeight(levels, wantedHeight) {
  const wanted = Number(wantedHeight)
  if (!Array.isArray(levels) || !levels.length || !Number.isFinite(wanted) || wanted <= 0) return null
  const known = levels.filter((level) => Number.isFinite(Number(level.h)) && Number(level.h) > 0)
  if (!known.length) return null
  const fitting = known.filter((level) => Number(level.h) <= wanted).sort((a, b) => Number(b.h) - Number(a.h))
  if (fitting.length) return fitting[0]
  return known.slice().sort((a, b) => Number(a.h) - Number(b.h))[0]
}

export function readPlayerPrefs(storage) {
  const get = (key) => { try { return storage?.getItem(key) ?? null } catch { return null } }
  const speed = Number(get(PLAYER_PREF_KEYS.speed))
  const height = Number(get(PLAYER_PREF_KEYS.qualityHeight))
  return {
    subLang: normalizeLang(get(PLAYER_PREF_KEYS.subLang)),
    subsOn: get(PLAYER_PREF_KEYS.subsOn) !== '0',
    speed: Number.isFinite(speed) && speed >= SPEED_RANGE.min && speed <= SPEED_RANGE.max ? speed : 1,
    audioLang: normalizeLang(get(PLAYER_PREF_KEYS.audioLang)),
    qualityHeight: Number.isFinite(height) && height > 0 ? height : 0,
  }
}

export function writePlayerPref(storage, key, value) {
  try { storage?.setItem(key, String(value)) } catch { /* private window: the choice lasts for the page only */ }
}

/** The browser storage, or null outside a browser. One place, so tests can pass their own. */
export function playerStorage() {
  try { return typeof localStorage !== 'undefined' ? localStorage : null } catch { return null }
}
