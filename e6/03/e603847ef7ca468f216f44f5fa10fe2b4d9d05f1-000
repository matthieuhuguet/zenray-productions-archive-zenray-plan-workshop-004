# 4 October 2026, 09:55 CEST: native decoding preserves literal text and rejects unsupported formats and malformed fields.
import importlib.util
import pathlib
import unittest
spec = importlib.util.spec_from_file_location('reader', pathlib.Path(__file__).with_name('ReadGeminiConversation.py'))
reader = importlib.util.module_from_spec(spec); spec.loader.exec_module(reader)

def integer(value):
    result = bytearray()
    while value > 127:
        result.append((value & 127) | 128); value >>= 7
    return bytes(result + bytes([value]))

def field(number, value):
    if isinstance(value, int):
        return integer(number << 3) + integer(value)
    return integer((number << 3) | 2) + integer(len(value)) + value

class NativeMessages(unittest.TestCase):
    def test_literal_prompt_and_timestamp(self):
        body = 'Vrai prompt avec\nune seconde ligne.'
        payload = field(1, 14) + field(19, field(1, body.encode()))
        metadata = field(1, field(1, 1791060000))
        result = reader.decode_step(0, 14, payload, metadata, 0, 'real-session')
        self.assertEqual(result['text'], body)
        self.assertEqual(result['kind'], 'prompt')
        self.assertTrue(result['timestamp'])
    def test_visible_response_and_notify(self):
        result = reader.decode_step(1, 15, field(1, 15) + field(20, field(1, b'Original') + field(8, b'Visible')), b'', 0, 'real-session')
        self.assertEqual(result['text'], 'Visible')
        self.assertEqual(reader.decode_step(2, 82, field(1, 82) + field(94, field(2, b'Final response')), b'', 0, 'real-session')['text'], 'Final response')
    def test_items_text(self):
        result = reader.decode_step(0, 14, field(1, 14) + field(19, field(3, field(1, b'Item text'))), b'', 0, 'real-session')
        self.assertEqual(result['text'], 'Item text')
    def test_cleared_message_keeps_its_absence_explicit(self):
        self.assertIsNone(reader.decode_step(0, 14, field(1, 14) + field(4, 5), b'', 0, 'real-session'))
    def test_red_cases(self):
        with self.assertRaises(ValueError): reader.decode_step(0, 14, field(1, 14), b'', 1, 'real-session')
        with self.assertRaises(ValueError): reader.decode_step(0, 14, field(1, 15), b'', 0, 'real-session')
        with self.assertRaises(ValueError): reader.fields(b'\x0a\x7fbroken')

if __name__ == '__main__': unittest.main()
