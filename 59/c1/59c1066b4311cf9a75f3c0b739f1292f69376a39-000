// 3 October 2026, 16:05 CEST: verify stable session routing and reject history reassignment.
import { it, expect } from 'vitest'
import { conversationStart } from './ConversationIdentity.mjs'
const sessionId = '01a0fc34-0a94-7f11-a21d-325072a6edb2'
it('reuses a linked project without renaming it or changing its category', () => {
  expect(conversationStart({ agent: 'codex', sessionId }, { [sessionId]: 'ceramic-tiles' })).toEqual({ action: 'start', id: 'ceramic-tiles', sessionId, agent: 'codex' })
})
it('keeps the same standalone conversation across repeated starts', () => {
  const first = conversationStart({ agent: 'claude', sessionId, name: 'Research' })
  expect(first.category).toBe('Conversations')
  expect(conversationStart({ agent: 'claude', sessionId }).id).toBe(first.id)
  expect(conversationStart({ agent: 'claude', sessionId: 'another-real-session' }).id).not.toBe(first.id)
})
it('rejects missing host identities and implicit reassignment', () => {
  expect(() => conversationStart({ agent: 'codex' })).toThrow('Actual host')
  expect(() => conversationStart({ agent: 'unknown', sessionId })).toThrow('Supported agent')
  expect(() => conversationStart({ agent: 'codex', sessionId, projectId: 'other' }, { [sessionId]: 'original' })).toThrow('already mapped')
})
