// repo-create-failure.test.mjs (12 October 2026)
import test from 'node:test'
import assert from 'node:assert/strict'
import { repoCreateFailure } from '../video-raw-lib.mjs'

test('a secondary rate limit names its cause and its delay', () => {
  const out = 'HTTP/2 403 \r\ncontent-type: application/json\r\nretry-after: 60\r\nx-ratelimit-remaining: 4999\r\n\r\n'
    + '{"message":"You have exceeded a secondary rate limit. Please wait a few minutes.","documentation_url":"https://docs.github.com"}\n403'
  const { code, detail } = repoCreateFailure(out)
  assert.equal(code, '403')
  assert.match(detail, /retry-after=60s/)
  assert.match(detail, /ratelimit-remaining=4999/)
  assert.match(detail, /secondary rate limit/)
})

test('a created repository is code 201 with no detail needed', () => {
  assert.equal(repoCreateFailure('HTTP/2 201 \r\n\r\n{"id":1}\n201').code, '201')
})

test('an empty answer gives an empty code, not an exception', () => {
  assert.deepEqual(repoCreateFailure(''), { code: '', detail: '' })
})

test('the output never carries a credential', () => {
  const { detail } = repoCreateFailure('HTTP/2 403\r\nauthorization: Bearer abc\r\n\r\n{"message":"blocked"}\n403')
  assert.doesNotMatch(detail, /Bearer|abc/)
})
