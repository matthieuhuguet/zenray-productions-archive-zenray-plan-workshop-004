// ═══ CAPSULE SEGMENTÉE — UNE SEULE DÉFINITION, AUTANT D'INSTANCES QU'ON VEUT ══════════════════════
//
// Modèle : le sélecteur « Today | 27 August 2026 » d'Apple, dont Matthieu a fourni la capture le
// 2026-08-27. Un seul contenant à bord 999, un filet fin entre les segments, et un survol qui n'allume
// QUE la portion de fond adossée au texte.
//
// POURQUOI UN COMPOSANT ET PAS DEUX BLOCS DE CSS. Le minuteur et l'apprentissage japonais en veulent
// tous les deux une. Recopier la règle aurait donné deux capsules qui se ressemblent aujourd'hui et
// divergent au premier réglage, exactement la faute que la loi HDA nomme : une définition, des
// instances, jamais un copier-coller pour changer une valeur.
import React from 'react'
import './Segmente.css'

// Une option est soit une chaîne (le libellé fait office de clé), soit un objet
// { cle, libelle, compte } — le compte s'affiche en second plan, plus petit, comme une pastille.
// `statique` rend des cellules d'AFFICHAGE plutôt que des boutons : même capsule, mêmes filets, même
// survol qui n'allume que la portion adossée au texte, mais rien à cliquer. Un bouton qui ne fait rien
// est promis au clavier puis ne répond pas, ce qui est pire qu'un texte.
export default function Segmente({ options, valeur, onChange, onSurvol, ariaLabel, className = '', statique = false }) {
  const norm = options.map((o) => (typeof o === 'string' ? { cle: o, libelle: o } : o))
  return (
    <div className={`zr-segmente ${className}`.trim()} role="group" aria-label={ariaLabel}>
      {norm.map((o, i) => {
        const contenu = (<>{o.libelle}{o.compte != null && <em className="zr-seg-compte">{o.compte}</em>}</>)
        return (
          <React.Fragment key={o.cle}>
            {i > 0 && <span className="zr-seg-trait" aria-hidden="true" />}
            {statique
              ? <span className={`zr-seg zr-seg-statique${valeur === o.cle ? ' zr-seg-actif' : ''}`}>{contenu}</span>
              : (
                <button type="button" className={`zr-seg${valeur === o.cle ? ' zr-seg-actif' : ''}`}
                  aria-pressed={valeur === o.cle}
                  onMouseEnter={onSurvol}
                  onClick={() => onChange(o.cle)}>{contenu}</button>
              )}
          </React.Fragment>
        )
      })}
    </div>
  )
}
