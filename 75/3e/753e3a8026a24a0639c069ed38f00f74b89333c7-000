// 3 October 2026, 21:40 CEST: disjoint groups explain indexed bytes without double counting parent folders.
import { extOf } from './fileKinds.js'

export const STORAGE_VIEWS = [{ id: 'folders', label: 'Dossiers' }, { id: 'types', label: 'Types' }, { id: 'files', label: 'Fichiers' }]
export const STORAGE_PAGE_SIZE = 12
export const STORAGE_CHART_LIMIT = 5
export function storageChartGroups(groups) {
  if (groups.length <= STORAGE_CHART_LIMIT + 1) return groups
  const remainder = groups.slice(STORAGE_CHART_LIMIT)
  return [...groups.slice(0, STORAGE_CHART_LIMIT), { key: 'remaining', label: 'Autres fichiers', files: remainder.flatMap(group => group.files), bytes: remainder.reduce((sum, group) => sum + group.bytes, 0), percent: remainder.reduce((sum, group) => sum + group.percent, 0) }]
}
export function storageBreakdown(files, mode = 'folders') {
  const groups = new Map()
  for (const file of files) {
    const relative = file.relativePath || file.name || ''
    const directory = relative.includes('/') ? relative.slice(0, relative.lastIndexOf('/')) : ''
    const source = file.sourceId || file.namespace || 'cloud'
    const type = extOf(file.name || relative).toLowerCase() || 'none'
    const key = mode === 'files' ? file.id : mode === 'types' ? type : JSON.stringify([file.namespace, source, directory])
    if (!groups.has(key)) groups.set(key, { key, label: mode === 'files' ? file.name || relative : mode === 'types' ? type === 'none' ? 'Sans extension' : `.${type}` : directory || 'Racine', source, namespace: file.namespace, files: [], bytes: 0, unknown: 0 })
    const group = groups.get(key)
    group.files.push(file)
    if (Number.isFinite(file.size) && file.size >= 0) group.bytes += file.size
    else group.unknown++
  }
  const ordered = [...groups.values()].sort((a, b) => b.bytes - a.bytes || a.label.localeCompare(b.label, 'fr', { numeric: true }) || String(a.key).localeCompare(String(b.key)))
  const bytes = ordered.reduce((sum, group) => sum + group.bytes, 0)
  return { groups: ordered.map((group) => ({ ...group, percent: bytes ? group.bytes / bytes * 100 : 0 })), bytes, unknown: ordered.reduce((sum, group) => sum + group.unknown, 0) }
}
