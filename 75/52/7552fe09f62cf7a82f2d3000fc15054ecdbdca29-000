// Remappe les refs image des 11 jeux vers les VRAIS fichiers présents dans zenray-shelf-img (suffixes incohérents
// laissés par un script précédent). Trouve par préfixe de slug, pointe jsDelivr au HEAD du repo image.
const TOKEN = process.env.GITHUB_TOKEN
const DATA = 'matthieuhuguet/zenray-data', IMG = 'matthieuhuguet/zenray-shelf-img', BRANCH = 'main', PATH = 'shelf/games.json'
const NAMES = ['Resident Evil Veronica','Fable','Final Fantasy VII Rebellion','God of War Laufey','Resonant','Stellar Blade Blood Rain','Persona 6 Resonance','A Plague Tale Legacy','Stranger Than Heaven','Persona 4 Revival','No Rest for the Wicked']
const slug = (s) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'')
const gh = (repo, p, init = {}) => fetch(`https://api.github.com/repos/${repo}/${p}`, { ...init, headers: { Authorization: `Bearer ${TOKEN}`, Accept: 'application/vnd.github+json', 'User-Agent': 'zr-fix', ...(init.headers||{}) } })

// HEAD sha du repo image + liste des fichiers
const ref = await gh(IMG, `git/ref/heads/${BRANCH}`).then(r=>r.json())
const headSha = ref.object.sha
const tree = await gh(IMG, `git/trees/${headSha}?recursive=1`).then(r=>r.json())
const files = (tree.tree||[]).filter(x=>x.type==='blob' && /\.(jpg|jpeg|png|webp|avif)$/i.test(x.path)).map(x=>x.path)
console.log(`repo image: ${files.length} fichiers @ ${headSha.slice(0,8)}`)

// manifest LIVE + sha
const meta = await gh(DATA, `contents/${encodeURI(PATH)}?ref=${BRANCH}`).then(r=>r.json())
const live = JSON.parse(Buffer.from(meta.content,'base64').toString('utf8'))
let fixed = 0, miss = []
for (const n of NAMES) {
  const sg = slug(n)
  const file = files.find(f => f.toLowerCase().startsWith(sg + '-') || f.toLowerCase() === sg + '.jpg')
  const it = live.items.find(i => i.name === n)
  if (!it) { miss.push(n+' (absent manifest)'); continue }
  if (!file) { miss.push(n+' (aucun fichier '+sg+'-*)'); continue }
  it.image = { kind: 'url', ref: `https://cdn.jsdelivr.net/gh/${IMG}@${headSha}/${file}` }
  fixed++
}
console.log(`remappés: ${fixed}`, miss.length?('manquants: '+miss.join(', ')):'')
if (fixed) {
  const body = { message: `shelf: fix ${fixed} refs image (remap vers vrais fichiers)`, content: Buffer.from(JSON.stringify(live)).toString('base64'), branch: BRANCH, sha: meta.sha }
  const put = await gh(DATA, `contents/${encodeURI(PATH)}`, { method:'PUT', body: JSON.stringify(body) }).then(r=>r.json())
  console.log(put.commit ? `OK commit ${put.commit.sha.slice(0,8)}` : 'ÉCHEC '+JSON.stringify(put).slice(0,150))
}
