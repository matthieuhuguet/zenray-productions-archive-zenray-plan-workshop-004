import { describe, expect, it } from 'vitest'
import { EXTENSIONS_NOEUDS } from '../../server/extensionsNoeuds.js'
import { buildTree, entriesOf } from './buildNodes.js'

const NODE_TYPES_BY_EXTENSION = {
  md: 'page',
  'db.json': 'db',
  'media.json': 'media',
  'img.json': 'image',
  'canvas.json': 'canvas',
  'ref.json': 'canvas',
  'embed.json': 'embed',
  'file.json': 'file',
  'plan.json': 'plan',
  'zmedia.json': 'zmedia',
  'comment.json': 'comment',
}

// 9 October 2026 08:06 CEST: Assert every registered suffix survives both Create tree builders.
it('builds every registered node suffix with its canonical type', () => {
  for (const extension of EXTENSIONS_NOEUDS) {
    const contentPath = `pages/Project/node.${extension}`
    const type = NODE_TYPES_BY_EXTENSION[extension]
    expect(type, `${extension} needs a visible type`).toBeTruthy()
    expect(entriesOf([contentPath], 'pages/Project')).toEqual([
      expect.objectContaining({ name: 'node', contentPath, type }),
    ])
    expect(buildTree([contentPath]).children.Project.children.node)
      .toMatchObject({ name: 'node', contentPath, type })
  }
})

describe('Eagle folder placements in the Create tree', () => {
  it('materialise le placement comme dossier et masque le marqueur', () => {
    const paths = ['pages/Projet/Character/.zreagle-folder.json']
    const entries = entriesOf(paths, 'pages/Projet')
    expect(entries).toEqual([expect.objectContaining({ name: 'Character', dir: 'pages/Projet/Character', contentPath: null, type: 'folder' })])
    expect(entries.some((entry) => entry.name === '.zreagle-folder.json')).toBe(false)
  })

  it('fusionne les enfants logiques renvoyés par le serveur sous le placement', () => {
    const tree = buildTree([
      'pages/Projet/Character/.zreagle-folder.json',
      'pages/Projet/Character/model.fbx.file.json',
      'pages/Projet/Character/textures/albedo.img.json',
    ])
    const character = tree.children.Projet.children.Character
    expect(character.contentPath).toBeNull()
    expect(character.children['model.fbx'].contentPath).toBe('pages/Projet/Character/model.fbx.file.json')
    expect(character.children.textures.children.albedo.contentPath).toBe('pages/Projet/Character/textures/albedo.img.json')
  })
})
