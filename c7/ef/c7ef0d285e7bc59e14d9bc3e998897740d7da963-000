import { describe, expect, it } from 'vitest'
import { sameStringArray } from './sameStringArray.js'

describe('sameStringArray', () => {
  it('reconnaît la même référence sans comparer les éléments', () => {
    const a = ['pages/A.md']
    expect(sameStringArray(a, a)).toBe(true)
  })

  it('reconnaît deux tableaux au contenu identique mais de références différentes', () => {
    expect(sameStringArray(['pages/A.md', 'pages/B.md'], ['pages/A.md', 'pages/B.md'])).toBe(true)
  })

  it('rejette sur une simple différence de longueur (sans comparer les éléments en commun)', () => {
    expect(sameStringArray(['pages/A.md'], ['pages/A.md', 'pages/B.md'])).toBe(false)
  })

  it('rejette dès le premier élément différent', () => {
    expect(sameStringArray(['pages/A.md', 'pages/B.md'], ['pages/A.md', 'pages/C.md'])).toBe(false)
  })

  it("détecte un renommage/ajout en fin de liste (25 s de poll -> arbre qui a réellement bougé)", () => {
    expect(sameStringArray(['pages/A.md'], ['pages/A.md', 'pages/Nouveau.md'])).toBe(false)
  })

  it('traite null/undefined comme non identiques à un tableau (sauf même référence)', () => {
    expect(sameStringArray(null, null)).toBe(true)
    expect(sameStringArray(null, [])).toBe(false)
    expect(sameStringArray(undefined, undefined)).toBe(true)
  })
})
