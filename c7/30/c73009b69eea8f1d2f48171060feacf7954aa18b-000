import React, { useEffect, useRef, useState } from 'react'
import { SHADOWS } from '../theme.js'

// Popover "Paste as" style Notion : 3 options empilées Mention / Embed / Bookmark.
// Ancré près du caret (position:fixed). Clavier (haut/bas, Enter, Escape), click-outside, viewport-safe.
// Aucun appel réseau, aucune mutation editor : juste un choix renvoyé via onPick.
const SANS = "var(--zr-police-sans)"
const OPTIONS = [
  { key: 'mention', label: 'Mention', hint: 'Lien inline compact' },
  { key: 'embed', label: 'Embed', hint: 'Aperçu intégré (vidéo, image)' },
  { key: 'bookmark', label: 'Bookmark', hint: 'Carte de lien riche' },
]
const MENU_W = 320
const MENU_H = 168

export default function NotionPasteMenu({ url, anchor, theme = 'light', onPick, onClose }) {
  const [active, setActive] = useState(0)
  const ref = useRef(null)
  const dark = theme === 'dark'

  useEffect(() => { setActive(0) }, [url])

  useEffect(() => {
    const onKey = (e) => {
      if (e.key === 'Escape') { e.preventDefault(); onClose() }
      else if (e.key === 'ArrowDown') { e.preventDefault(); setActive((i) => (i + 1) % OPTIONS.length) }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive((i) => (i - 1 + OPTIONS.length) % OPTIONS.length) }
      else if (e.key === 'Enter') { e.preventDefault(); onPick(OPTIONS[active].key) }
    }
    const onDown = (e) => { if (ref.current && !ref.current.contains(e.target)) onClose() }
    document.addEventListener('keydown', onKey, true)
    document.addEventListener('mousedown', onDown, true)
    return () => { document.removeEventListener('keydown', onKey, true); document.removeEventListener('mousedown', onDown, true) }
  }, [active, onPick, onClose])

  // Positionnement viewport-safe : sous le caret si possible, sinon au-dessus ; x clampé.
  const vw = typeof window !== 'undefined' ? window.innerWidth : 1200
  const vh = typeof window !== 'undefined' ? window.innerHeight : 800
  const ax = anchor ? anchor.x : vw / 2
  const ay = anchor ? anchor.y : vh / 2
  let left = Math.min(Math.max(8, ax), vw - MENU_W - 8)
  let top = ay + 6
  if (top + MENU_H > vh - 8) top = Math.max(8, ay - MENU_H - 6)

  return (
    <div ref={ref} role="menu"
      style={{
        position: 'fixed', left, top, width: MENU_W, zIndex: 1000,
        background: dark ? '#252525' : '#fff',
        border: `1px solid ${dark ? 'rgba(255,255,255,0.10)' : 'rgba(0,0,0,0.08)'}`,
        borderRadius: 12, boxShadow: SHADOWS.apple, padding: 6, fontFamily: SANS,
      }}>
      <div style={{ fontSize: 'var(--zr-ui-md)', color: dark ? 'rgba(236,236,234,0.55)' : '#8E8E93', padding: '8px 12px 6px' }}>Paste as</div>
      {OPTIONS.map((o, i) => (
        <button key={o.key} role="menuitem"
          onMouseEnter={() => setActive(i)}
          onClick={() => onPick(o.key)}
          style={{
            display: 'block', width: '100%', textAlign: 'left', border: 'none', cursor: 'pointer',
            background: i === active ? (dark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.05)') : 'transparent',
            borderRadius: 8, padding: '8px 12px', color: dark ? '#ECECEA' : '#1F1F1E',
          }}>
          <div style={{ fontSize: 'var(--zr-ui-xl)', fontWeight: 500 }}>{o.label}</div>
          <div style={{ fontSize: 'var(--zr-ui-sm)', color: dark ? 'rgba(236,236,234,0.5)' : '#8E8E93', marginTop: 1 }}>{o.hint}</div>
        </button>
      ))}
    </div>
  )
}
