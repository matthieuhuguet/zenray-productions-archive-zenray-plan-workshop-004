// 4 October 2026: the engine's door to the private data repository, by git, never by one API call per file.
// One private sparse clone, one commit per run, and every change recomputed from the freshest remote state when a push is refused.
// FR : la porte du moteur vers le depot de donnees prive, par git, jamais un appel d'API par fichier. Un clone prive,
// un commit par passage, et tout est recalcule depuis l'etat distant le plus frais quand un push est refuse.
import { execFile } from 'node:child_process'
import { promisify } from 'node:util'
import { mkdir, readFile, writeFile, rm, stat } from 'node:fs/promises'
import path from 'node:path'

const run = promisify(execFile)

// A service has nobody to answer a password prompt: fail at once instead of hanging forever.
// FR : un service n'a personne pour repondre a une demande de mot de passe : echouer tout de suite plutot que bloquer.
const noPrompt = { ...process.env, GIT_TERMINAL_PROMPT: '0', GIT_ASKPASS: '/usr/bin/false' }

export function createCloudStore({ config, directory, exec = run, now = () => new Date(), sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms)) }) {
  const { repo, branch, folder, pushAttempts } = config.cloud
  const git = async (args, options = {}) => {
    try { return (await exec('git', ['-C', directory, ...args], { maxBuffer: 256 * 1024 * 1024, timeout: 180000, env: noPrompt, ...options })).stdout }
    catch (error) { throw new Error(`git ${args[0]} failed: ${String(error.stderr || error.message).trim().split('\n').slice(0, 2).join(' ')}`) }
  }

  async function ensureClone() {
    try { await stat(path.join(directory, '.git')); return } catch {}
    await mkdir(path.dirname(directory), { recursive: true })
    await exec('git', ['clone', '--quiet', '--filter=blob:none', '--sparse', '--branch', branch, `https://github.com/${repo}.git`, directory], { timeout: 300000, maxBuffer: 64 * 1024 * 1024, env: noPrompt })
    await git(['sparse-checkout', 'set', folder])
  }

  /** Make the private clone identical to the remote tip. The clone is the engine's own: nobody edits it by hand. */
  async function sync() {
    await ensureClone()
    await git(['fetch', '--quiet', 'origin', branch])
    await git(['reset', '--quiet', '--hard', `origin/${branch}`])
    return (await git(['rev-parse', 'HEAD'])).trim()
  }

  const tree = {
    read: async (file) => { try { return await readFile(path.join(directory, file), 'utf8') } catch (error) { if (error.code === 'ENOENT') return null; throw error } },
    json: async (file) => { const text = await tree.read(file); return text === null ? null : JSON.parse(text) },
  }

  /**
   * `plan(tree)` reads the freshest state and returns { files: { path: string }, report }.
   * It is called again from scratch after every refused push, so a concurrent edit by the page is never overwritten.
   */
  async function commit(message, plan, { dryRun = false } = {}) {
    let failure
    for (let attempt = 1; attempt <= pushAttempts; attempt++) {
      await sync()
      const { files, report } = await plan(tree)
      const paths = Object.keys(files)
      if (dryRun) return { committed: false, report, files }
      if (!paths.length) return { committed: false, report }
      for (const file of paths) {
        const target = path.join(directory, file)
        if (!path.resolve(target).startsWith(path.resolve(directory) + path.sep)) throw new Error(`Refusing to write outside the clone: ${file}`)
        await mkdir(path.dirname(target), { recursive: true })
        await writeFile(target, files[file])
      }
      await git(['add', '--', ...paths])
      if (!(await git(['status', '--porcelain', '--', ...paths])).trim()) return { committed: false, report }
      // 12 October 2026: the author is a parameter (ZenRay Motion reuses this store); the default stays Freelance.
      const author = config.cloud.author || { name: 'ZenRay Freelance', email: 'freelance@zenray.local' }
      await git(['-c', `user.name=${author.name}`, '-c', `user.email=${author.email}`, 'commit', '--quiet', '-m', message])
      try {
        await git(['push', '--quiet', 'origin', `HEAD:${branch}`])
        return { committed: true, report, commit: (await git(['rev-parse', 'HEAD'])).trim() }
      } catch (error) {
        failure = error
        await git(['reset', '--quiet', '--hard', `origin/${branch}`]).catch(() => {})
        // A busy remote: wait a little longer each time, with a spread, so two writers stop colliding in lockstep.
        // FR : un depot tres sollicite : attendre un peu plus a chaque fois, avec un etalement, pour que deux ecrivains cessent de se heurter.
        await sleep(attempt * 1500 + Math.floor(Math.random() * 1000))
      }
    }
    throw new Error(`Push refused ${pushAttempts} times, nothing was published: ${failure?.message || 'unknown'}`)
  }

  async function discard() { await rm(directory, { recursive: true, force: true }) }

  return { sync, commit, tree, discard, directory, now }
}
