import { describe, it, expect } from 'vitest'
import { urlLectureAffichage, urlLectureEdition } from './urlLecture.js'
import { readFileSync } from 'node:fs'

describe('lire pour afficher ne consomme pas le quota', () => {
  it('la lecture d’affichage porte raw=1', () => {
    expect(urlLectureAffichage('pages/A/x.img.json')).toContain('raw=1')
  })

  it('la lecture d’édition ne le porte PAS — elle a besoin du sha', () => {
    // Sans sha, l'écriture suivante est refusée par GitHub ou écrase le travail d'un autre.
    expect(urlLectureEdition('pages/A/x.md')).not.toContain('raw=1')
  })

  it('le chemin est encodé — un espace ou un accent casserait l’URL', () => {
    expect(urlLectureAffichage('pages/29 Aout/a b.img.json')).toContain(encodeURIComponent('pages/29 Aout/a b.img.json'))
  })

  it('le jeton de partage suit, sinon un visiteur anonyme reçoit un 403', () => {
    expect(urlLectureAffichage('pages/A.md', { share: 'tok en' })).toContain('share=tok%20en')
  })

  it('fresh=1 n’est ajouté que s’il est demandé', () => {
    expect(urlLectureAffichage('a')).not.toContain('fresh')
    expect(urlLectureAffichage('a', { fresh: true })).toContain('fresh=1')
  })
})

describe('le serveur honore vraiment raw=1 — sinon cette brique ne sert à rien', () => {
  it('server/page.js branche bien sur raw.githubusercontent quand raw est présent', () => {
    // Contrôle de bout en bout : la brique cliente ne vaut que si le serveur en tient compte. Si
    // quelqu'un retire ce branchement, ce test le dit avant que le quota ne le dise.
    const src = readFileSync('server/page.js', 'utf8')
    expect(src).toContain('if (req.query.raw)')
    expect(src).toMatch(/raw\.githubusercontent\.com/)
  })
})
