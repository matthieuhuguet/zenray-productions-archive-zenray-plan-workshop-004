// clean-media-name.mjs (12 October 2026): turns a release-style file name into a clean one, the SAME name locally and in the cloud.
// FR : transforme un nom de release en nom propre. Le meme nom sert en local et dans le cloud (consigne de Matthieu, 12 October 2026).
//   Under.the.Open.Sky.2020.FR.mkv                                   -> Under The Open Sky.mkv
//   Akane-banashi S01E12 VOSTFR 1080p WEB x264 AAC -Tsundere-Raws (ADN).mkv -> Akane Banashi S01E12.mkv
import path from 'node:path'

// 12 October 2026: every tunable value of the cleaning in one place (the rules are data, the code below only applies them).
export const CLEAN = {
  videoExtensions: ['.mkv', '.mp4', '.m4v', '.mov', '.webm', '.avi'],
  sidecarExtensions: ['.srt', '.ass', '.ssa', '.vtt', '.sub', '.idx'],
  // A token that starts the "release noise": everything from the first one to the end of the name is dropped.
  noiseTokens: new Set([
    'vostfr', 'vostf', 'vost', 'vostvf', 'vf', 'vff', 'vfq', 'vfi', 'multi', 'multi-subs', 'subs', 'sub', 'dual', 'audio', 'dualaudio',
    'fr', 'en', 'eng', 'fre', 'fra', 'jpn', 'ja', 'french', 'english', 'truefrench', 'german', 'ger', 'ita', 'spa',
    'web', 'webrip', 'webdl', 'dl', 'bluray', 'blu', 'bdrip', 'brrip', 'bd', 'hdtv', 'dvdrip', 'amzn', 'dsnp', 'nf', 'cr', 'adn', 'hmax', 'atvp',
    'hdr', 'hdr10', 'dv', 'uhd', 'remux', 'proper', 'repack', 'extended', 'imax', 'uncut', 'ad',
    'aac', 'ac3', 'eac3', 'ddp', 'dd', 'flac', 'opus', 'dts', 'truehd', 'atmos',
    'x264', 'x265', 'h264', 'h265', 'hevc', 'avc', 'av1', 'xvid', 'hi10p', '4k',
  ]),
  noisePatterns: [/^\d{3,4}[pi]$/i, /^\d+bits?$/i, /^[xh]\.?26[45]$/i, /^aac\d*$/i, /^ddp?\d*$/i, /^\d\.\d$/],
  episodePattern: /^s(\d{1,3})e(\d{1,4})$/i,
  bareEpisodePattern: /\s-\s(\d{1,3})(?=\s|$)/,
  yearPattern: /^(19|20)\d{2}$/,
  separators: /[\s._\-]+/,
  keepYear: false, // the examples of Matthieu drop the year; a collision adds it back (see disambiguate)
  seasonFolderLabel: 'Saison',
  seasonDigits: 2,
  // a parenthesis that says WHAT the file is (an excerpt, a trailer) is part of the name, not release noise
  // a bare small number is the "(2)" the collision step adds: keeping it makes a second pass change nothing (idempotence)
  keepParenthetical: /^(?:\d{1,2}|(?:extrait|sample|trailer|teaser|bande[- ]annonce|making[- ]of).*)$/i,
  collisionLanguageTokens: ['fr', 'vostfr', 'vf', 'multi', 'en', 'eng', 'ja', 'jpn'],
}

const isNoise = (token) => {
  const low = token.toLowerCase()
  return CLEAN.noiseTokens.has(low) || CLEAN.noisePatterns.some((re) => re.test(low))
}

// First letter of every word capital, the rest lower, unless the word already mixes cases (McDonald, iPhone) or is a short acronym.
export function titleCaseWord(word) {
  if (/^[A-Z]{1,3}$/.test(word) || /[a-z][A-Z]/.test(word)) return word
  return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()
}

// Returns the parts of a clean name; `name` is the file name WITH or WITHOUT its extension.
export function parseMediaName(fileName) {
  const ext = path.extname(fileName).toLowerCase()
  const known = CLEAN.videoExtensions.includes(ext) || CLEAN.sidecarExtensions.includes(ext)
  let stem = known ? fileName.slice(0, -ext.length) : fileName
  const reasons = []

  // year in parentheses or brackets, taken before the groups are removed
  let year = null
  let yearInParens = false // "Title (2019)" is the clean form and stays; a dotted ".2020." is release noise and goes
  const yearMatch = /[(\[]((?:19|20)\d{2})[)\]]/.exec(stem)
  if (yearMatch) { year = yearMatch[1]; yearInParens = yearMatch[0].startsWith('('); stem = stem.replace(yearMatch[0], ' ') }
  // release groups and any other bracketed block
  const kept = []
  stem = stem.replace(/\[[^\]]*\]/g, ' ').replace(/\(([^)]*)\)/g, (_, inner) => { if (CLEAN.keepParenthetical.test(inner.trim())) { kept.push(inner.trim()); return ' ' } return ' ' })
  // " - 13 " style episode number (no season given)
  let bareEpisode = null
  const bare = CLEAN.bareEpisodePattern.exec(stem)
  if (bare) { bareEpisode = bare[1]; stem = stem.slice(0, bare.index) + ' ' + stem.slice(bare.index + bare[0].length) }

  const tokens = stem.split(CLEAN.separators).filter(Boolean)
  const title = []
  let episode = null
  let season = null
  let language = null
  for (let i = 0; i < tokens.length; i += 1) {
    const token = tokens[i]
    const ep = CLEAN.episodePattern.exec(token)
    if (ep) { season = ep[1].padStart(2, '0'); episode = `S${season}E${ep[2].padStart(2, '0')}`; break }
    if (CLEAN.yearPattern.test(token) && title.length > 0) { year = year || token; break }
    if (isNoise(token) && title.length > 0) {
      language = CLEAN.collisionLanguageTokens.includes(token.toLowerCase()) ? token.toLowerCase() : null
      break
    }
    title.push(token)
  }
  if (!episode && bareEpisode) { episode = `- ${bareEpisode}`; reasons.push('episode_without_season') }
  if (!title.length) reasons.push('empty_title')
  return { title: title.map(titleCaseWord).join(' ').trim(), year, yearInParens, season, episode, bareEpisode, language, ext, reasons, isEpisode: Boolean(episode), kept }
}

export function composeCleanName(parts, { withYear = CLEAN.keepYear, withLanguage = false } = {}) {
  const pieces = [parts.title]
  // a film keeps its "(2019)"; an episode does not (the series folder and SxxEyy already say which one it is)
  if ((withYear || (parts.yearInParens && !parts.episode)) && parts.year) pieces.push(`(${parts.year})`)
  if (withLanguage && parts.language) pieces.push(`(${parts.language.toUpperCase()})`)
  if (parts.episode) pieces.push(parts.episode)
  for (const note of parts.kept || []) pieces.push(`(${note})`)
  return `${pieces.join(' ')}${parts.ext}`.replace(/\s+/g, ' ').trim()
}

export const cleanMediaName = (fileName, options) => composeCleanName(parseMediaName(fileName), options)

// Series go to "<Title>/Saison NN/", films stay flat.
export function proposedFolder(parts) {
  if (!parts.isEpisode || !parts.title) return ''
  const season = parts.season ? `${CLEAN.seasonFolderLabel} ${parts.season.padStart(CLEAN.seasonDigits, '0')}` : ''
  return season ? path.posix.join(parts.title, season) : parts.title
}

// A name is clean when cleaning it again changes nothing.
export const isCleanMediaName = (fileName) => cleanMediaName(fileName) === fileName

// A bare " - 13" episode takes its season from the folder it already sits in ("Saison 2" -> S02E13). Returns true when applied.
export function applySeasonFromFolder(parts, folderName) {
  if (!parts.bareEpisode || parts.season) return false
  const match = new RegExp(`${CLEAN.seasonFolderLabel}\\s*(\\d{1,3})`, 'i').exec(folderName || '')
  if (!match) return false
  parts.season = match[1].padStart(2, '0')
  parts.episode = `S${parts.season}E${parts.bareEpisode.padStart(2, '0')}`
  parts.reasons = parts.reasons.filter((r) => r !== 'episode_without_season')
  parts.isEpisode = true
  return true
}
