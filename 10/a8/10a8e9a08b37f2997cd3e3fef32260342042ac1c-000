import { describe, expect, it } from 'vitest'
import { canReuseFingerprint, canUseInventoryFingerprint, fileChangeToken, fingerprintCacheEntry } from './fingerprint-cache.mjs'

const file = { size: 42, mtime: 1_000, ctime: 2_000 }
const sha256 = 'a'.repeat(64)

describe("cache d'empreintes", () => {
  it('réutilise une empreinte seulement quand les trois preuves correspondent', () => {
    const cached = fingerprintCacheEntry(file, sha256)
    expect(canReuseFingerprint(file, cached)).toBe(true)
  })

  it("rehache un fichier dont le contenu change sans modifier sa taille ni sa date", () => {
    const cached = fingerprintCacheEntry(file, sha256)
    expect(canReuseFingerprint({ ...file, ctime: 3_000 }, cached)).toBe(false)
  })

  it("rehache une ancienne entrée qui ne connaît pas encore l'heure de changement", () => {
    expect(canReuseFingerprint(file, { t: file.size, m: file.mtime, s: sha256 })).toBe(false)
  })

  it("construit une preuve complète et refuse toute valeur manquante", () => {
    expect(fileChangeToken(file)).toBe('42:1000:2000')
    expect(() => fileChangeToken({ size: 42, mtime: 1_000 })).toThrow(/ctime/)
  })

  it("refuse une empreinte calculée avant que le fichier courant ne change", () => {
    expect(canUseInventoryFingerprint(file, { ...file }, sha256)).toBe(true)
    expect(canUseInventoryFingerprint(file, { ...file, mtime: 1_001, ctime: 2_001 }, sha256)).toBe(false)
  })
})
