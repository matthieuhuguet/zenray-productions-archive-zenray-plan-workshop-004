// 7 October 2026, 12:00 CEST: distinguish preparation, transfer and failed verification.
import { test } from 'node:test'
import assert from 'node:assert/strict'
import { dashboardSnapshot, dashboardTotals, formatRate, progressLabel } from './Model.mjs'
test('actual progress units and invalid values', () => {
 assert.match(progressLabel({ev:'chunk',done:2,total:3}), /Preparing/)
 assert.match(progressLabel({ev:'transfer',envoyes:20}), /confirmed/)
 assert.equal(progressLabel({ev:'verify',ko:1}), 'Verification failed')
 assert.equal(progressLabel(null), '')
 assert.equal(progressLabel({ev:'chunk',done:4,total:3}), 'chunk')
})
test('stable project identity and active jobs', () => {
 const value = dashboardSnapshot({checkedAt:'now',projects:[{id:'a',name:'Same',jobs:[{state:'done'}]},{id:'b',name:'Same',workspace:{state:'loaded'},jobs:[{state:'queued',id:'j'}]}]})
 assert.equal(value.projects[0].id,'b'); assert.equal(value.projects[0].workspace,'loaded'); assert.equal(value.projects[0].jobs[0].state,'queued')
 assert.throws(() => dashboardSnapshot({projects:[]}), /Invalid/)
})
// 9 October 2026, 00:41 CEST: running work remains above queued work, then larger bricks come first.
test('sorts current work, queued work, then project size', () => {
 const value = dashboardSnapshot({checkedAt:'now',projects:[
  {id:'done',name:'Done',stats:{fileCount:100,macFileCount:0,cloudFileCount:0,pendingUploadCount:0,loadedFileCount:0,localBytes:0,cloudBytes:0},jobs:[]},
  {id:'queued',name:'Queued',stats:{fileCount:1,macFileCount:0,cloudFileCount:0,pendingUploadCount:0,loadedFileCount:0,localBytes:0,cloudBytes:0},jobs:[{state:'queued'}]},
  {id:'running',name:'Running',stats:{fileCount:2,macFileCount:0,cloudFileCount:0,pendingUploadCount:0,loadedFileCount:0,localBytes:0,cloudBytes:0},jobs:[{state:'running'}]},
 ]})
 assert.deepEqual(value.projects.map(project => project.id),['running','queued','done'])
})
// 8 October 2026, 16:55 CEST: accept the compact service response without inventory snapshots.
test('compact service errors reach the native dashboard', () => {
 const value = dashboardSnapshot({checkedAt:'now',projects:[{id:'p',name:'P',workspace:{state:'unloaded'},errors:['Cloud issue'],jobs:[]}]})
 assert.deepEqual(value.projects[0].errors,['Cloud issue'])
 assert.equal(value.projects[0].workspace,'unloaded')
})
// 9 October 2026, 00:38 CEST: count Mac/cloud bricks and round measured transfer rates once.
test('compact project inventory and transfer rates stay truthful and readable', () => {
 const value = dashboardSnapshot({ checkedAt:'now', transferRates:{uploadBytesPerSecond:1499,downloadBytesPerSecond:2100000}, projects:[
  {id:'p',name:'P',workspace:{state:'loaded'},stats:{fileCount:8,macFileCount:5,cloudFileCount:6,pendingUploadCount:1,loadedFileCount:2,localBytes:5000,cloudBytes:6000},jobs:[{id:'d',type:'restore',state:'running',progress:{ev:'download',recus:1200,privatePath:'/private/file'}}]},
  {id:'q',name:'Q',jobs:[]},
 ]})
 assert.deepEqual(dashboardTotals(value.projects),{projectCount:2,countedProjectCount:1,fileCount:8,macFileCount:5,cloudFileCount:6,complete:false})
 assert.deepEqual(value.transferRates,{uploadBytesPerSecond:1499,downloadBytesPerSecond:2100000})
 assert.equal(formatRate(value.transferRates.uploadBytesPerSecond),'1 KB/s')
 assert.equal(formatRate(value.transferRates.downloadBytesPerSecond),'2 MB/s')
 assert.deepEqual(value.projects[0].jobs[0].progress,{ev:'download',recus:1200})
 assert.match(value.projects[0].jobs[0].detail,/Downloaded: 1200 bytes/)
})
test('terminal failures and absent progress remain explicit', () => {
 for (const state of ['error','interrupted','running','queued','done']) {
  const result = dashboardSnapshot({checkedAt:'now',projects:[{id:'p',name:'P',jobs:[{id:'j',state,error:state==='error'?'Failure':null}]}]})
  assert.equal(result.projects[0].jobs[0].state,state)
  assert.equal(result.projects[0].jobs[0].detail,'')
 }
 assert.match(progressLabel({ev:'done'}),/awaiting operation/)
 assert.equal(progressLabel({ev:'transfer',envoyes:NaN}),'transfer')
})
