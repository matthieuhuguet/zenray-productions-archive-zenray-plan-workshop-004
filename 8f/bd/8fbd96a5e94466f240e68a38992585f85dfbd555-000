// @vitest-environment node
// 4 October 2026, 10:20 CEST: staged copies retain originals, incremental passes preserve identity, and no cloud proof is invented.
import { it, expect, vi } from 'vitest'
import { mkdtemp, mkdir, writeFile, readFile, stat, rm, realpath } from 'node:fs/promises'
import { tmpdir } from 'node:os'
import path from 'node:path'
import { createConversationMirror, CONVERSATION_LIBRARY_ID } from './ConversationMirror.mjs'
import { atomicJson, snapshotSourceFile } from '../AssetsService.mjs'
import { fileChangeToken } from '../lib/fingerprint-cache.mjs'

it('copies progressively into one library without rebinding or overwriting original discussions', async () => {
  const root = await realpath(await mkdtemp(path.join(tmpdir(), 'conversation-mirror-')))
  try {
    const workshop = path.join(root, 'workshop'); await mkdir(workshop)
    const filenames = [path.join(root, 'one.jsonl'), path.join(root, 'two.jsonl')]
    await writeFile(filenames[0], 'original one\n'); await writeFile(filenames[1], 'original two\n')
    const conversations = filenames.map((filename, index) => ({ id: `codex:session-${index}`, provider: 'codex', sessionId: `session-${index}`, title: 'Original discussion', originalPaths: [filename], transcriptPaths: [filename], projectId: 'bound-project' }))
    const library = { id: CONVERSATION_LIBRARY_ID, sources: [{ id: 'workshop', namespace: 'tmp', localPath: workshop }] }
    const backup = vi.fn(), inventory = vi.fn()
    const watching = { watched: true }
    const service = { projects: new Map([[library.id, library]]), snapshot: () => library, inventory, state: () => watching, scheduleBackup: backup }
    const mirror = createConversationMirror({ catalog: { list: async () => ({ conversations }) }, service, atomicJson, snapshotFile: snapshotSourceFile, fileToken: entry => `${entry.dev}:${entry.ino}:${fileChangeToken({ size: entry.size, mtime: entry.mtimeMs, ctime: entry.ctimeMs })}`, stateDir: root })
    await mirror.drain()
    expect(Object.keys(mirror.state().entries)).toHaveLength(1)
    expect(await readFile(filenames[0], 'utf8')).toBe('original one\n')
    const copy = mirror.state().entries[conversations[0].id].copies[0]
    expect(await readFile(path.join(workshop, copy.relativePath), 'utf8')).toBe('original one\n')
    await writeFile(filenames[0], 'original one\nnew actual message\n')
    await mirror.drain()
    expect(Object.keys(mirror.state().entries)).toHaveLength(2)
    expect(await readFile(path.join(workshop, copy.relativePath), 'utf8')).toContain('new actual message')
    expect(backup).toHaveBeenCalledWith(CONVERSATION_LIBRARY_ID)
    expect(mirror.state().entries[conversations[0].id].cloudPath).toBeUndefined()
    watching.watched = false
    await writeFile(filenames[1], 'paused update')
    const beforeCalls = backup.mock.calls.length
    await mirror.drain()
    expect(backup.mock.calls.length).toBe(beforeCalls)
    await mirror.close()
  } finally { await rm(root, { recursive: true, force: true }) }
})
