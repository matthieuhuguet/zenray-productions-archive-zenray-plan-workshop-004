import { describe, expect, it } from 'vitest'
import { reserveEagleFolderTarget, reserveEagleLeafTarget } from './eagleBatch.js'

describe.each([1, 20, 99, 101])('Eagle batch allocator (%i éléments)', (count) => {
  it('réserve chaque placement sans collision, y compris 100+', () => {
    const files = new Set(['pages/Dest/dragon.file.json'])
    const bases = new Set(['pages/Dest/dragon'])
    const paths = Array.from({ length: count }, () => reserveEagleLeafTarget('pages/Dest/dragon.file.json', '.file.json', files, bases))
    expect(new Set(paths).size).toBe(count)
    expect(paths[0]).toBe('pages/Dest/dragon 2.file.json')
    expect(paths.at(-1)).toBe(`pages/Dest/dragon ${count + 1}.file.json`)
  })
})

describe('Eagle folder allocator', () => {
  it('évite une feuille fusionnée et les dossiers déjà présents', () => {
    const files = new Set(['pages/Dest/Asset.file.json', 'pages/Dest/Bundle/a.img.json'])
    const bases = new Set(['pages/Dest/Asset', 'pages/Dest/Bundle'])
    expect(reserveEagleFolderTarget('pages/Dest/Asset', files, bases)).toBe('pages/Dest/Asset 2')
    expect(reserveEagleFolderTarget('pages/Dest/Bundle', files, bases)).toBe('pages/Dest/Bundle 2')
  })
})
