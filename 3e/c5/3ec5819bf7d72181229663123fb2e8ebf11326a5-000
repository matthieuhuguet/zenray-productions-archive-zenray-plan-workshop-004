// 12 October 2026: the feedback-request mail after a refusal is deterministic, honest and never half filled.
import { describe, expect, it } from 'vitest'
import {
  FEEDBACK_REQUEST, buildFeedbackRequest, canRequestFeedback, cleanRole, feedbackLanguage, greetingName, refusalDate,
} from './freelanceFeedbackRequest.js'

const voodoo = {
  id: 'job_f1ad9a5f06dd8e8aefef', name: 'Voodoo', role: 'Technical Artist (AI), Portfolio Games Team, Freelance', status: 'declined',
  messages: [{ at: '2026-10-06', channel: 'mail', text: 'sent' }],
  history: [{ at: '2026-10-06', from: 'to_contact', to: 'contacted', note: 'premier message' }, { at: '2026-10-12', from: 'contacted', to: 'declined', note: 'refus reçu' }],
  engine: { language: 'en' },
}

describe('freelanceFeedbackRequest', () => {
  it('is offered for a refusal and nowhere else', () => {
    expect(canRequestFeedback(voodoo)).toBe(true)
    expect(canRequestFeedback({ ...voodoo, status: 'contacted' })).toBe(false)
    expect(canRequestFeedback(null)).toBe(false)
  })

  it('follows the language of the listing and falls back to French', () => {
    expect(feedbackLanguage(voodoo)).toBe('en')
    expect(feedbackLanguage({ name: 'Asobo', engine: { language: 'fr' } })).toBe('fr')
    expect(feedbackLanguage({ name: 'Asobo' })).toBe('fr')
  })

  it('writes the English mail for Voodoo with the studio, the role and two short questions', () => {
    const mail = buildFeedbackRequest({ studio: voodoo })
    expect(mail.lang).toBe('en')
    expect(mail.subject).toBe('Feedback request: Technical Artist (AI), Portfolio Games Team')
    expect(mail.text.startsWith('Hello Voodoo team,')).toBe(true)
    expect(mail.text).toContain('about the Technical Artist (AI), Portfolio Games Team position')
    expect(mail.text).toContain('1. Which part of my profile')
    expect(mail.text).toContain('2. Is there one thing')
    expect(mail.text.endsWith('Matthieu Huguet\nmatthieuhuguet.com')).toBe(true)
  })

  it('writes the French mail on request and keeps the same two questions', () => {
    const mail = buildFeedbackRequest({ studio: voodoo, lang: 'fr', role: 'Tech Artist, Portfolio team' })
    expect(mail.lang).toBe('fr')
    expect(mail.text.startsWith('Bonjour l’équipe Voodoo,')).toBe(true)
    expect(mail.text).toContain('le poste « Tech Artist, Portfolio team »')
    expect(mail.text).toContain('1. Quelle partie de mon profil')
    expect(mail.text).toContain('2. Y a-t-il un élément précis')
  })

  it('has a role-free variant instead of printing an empty position', () => {
    const mail = buildFeedbackRequest({ studio: { ...voodoo, role: '' } })
    expect(mail.subject).toBe('Feedback request about my application')
    expect(mail.text).not.toContain('position')
    expect(mail.text).not.toMatch(/\{|\}/)
  })

  it('never contains a long dash and never claims anything about experience', () => {
    for (const lang of ['en', 'fr']) {
      const mail = buildFeedbackRequest({ studio: voodoo, lang })
      expect(`${mail.subject}\n${mail.text}`).not.toMatch(/[–—]/)
      expect(mail.text).not.toMatch(/\b(years?|ans|played|joué|admire)\b/i)
    }
  })

  it('throws on a parameter without a value or a layout block that does not exist', () => {
    const noValue = { ...FEEDBACK_REQUEST, en: { ...FEEDBACK_REQUEST.en, blocks: { ...FEEDBACK_REQUEST.en.blocks, easy: 'Hello {nobody}' } } }
    expect(() => buildFeedbackRequest({ studio: voodoo, config: noValue })).toThrow(/\{nobody\}/)
    expect(() => buildFeedbackRequest({ studio: voodoo, config: { ...FEEDBACK_REQUEST, layout: ['missing'] } })).toThrow(/does not exist: missing/)
  })

  it('cleans the role and the greeting the way the application letter does', () => {
    expect(cleanRole('[Studio] Technical Artist (12-month contract)')).toBe('Technical Artist')
    expect(cleanRole('Technical Artist - Freelance')).toBe('Technical Artist')
    expect(greetingName('d3t (Keywords Studios)')).toBe('d3t')
  })

  it('finds the day of the refusal from the history, then from the last message', () => {
    expect(refusalDate(voodoo)).toBe('2026-10-12')
    expect(refusalDate({ ...voodoo, history: [] })).toBe('2026-10-06')
    expect(refusalDate(null)).toBe('')
  })
})
