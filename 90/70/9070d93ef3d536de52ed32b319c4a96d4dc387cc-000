import { describe, expect, it } from 'vitest'
import { dossierExistant } from './dossierExistant.js'

describe('dossierExistant', () => {
  it('retrouve un dossier par son nom affiché, suffixe technique compris', () => {
    const paths = ['pages/Calendar-76ct/Aout 2026-1lhw/1 Aout 2026.md']
    expect(dossierExistant(paths, 'pages', 'Calendar')).toBe('pages/Calendar-76ct')
    expect(dossierExistant(paths, 'pages/Calendar-76ct', 'Aout 2026')).toBe('pages/Calendar-76ct/Aout 2026-1lhw')
  })

  it('ignore les accents et la casse (« Aout 2026 » retrouve « Août 2026 »)', () => {
    const paths = ['pages/Calendar-76ct/Août 2026/3 Aout 2026.md']
    expect(dossierExistant(paths, 'pages/Calendar-76ct', 'aout 2026')).toBe('pages/Calendar-76ct/Août 2026')
  })

  it('rend null quand rien ne correspond, pour que l’appelant crée', () => {
    expect(dossierExistant(['pages/Autre/x.md'], 'pages', 'Calendar')).toBeNull()
    expect(dossierExistant([], 'pages', 'Calendar')).toBeNull()
    expect(dossierExistant(null, 'pages', 'Calendar')).toBeNull()
  })

  // LE BUG DU 2026-08-12, en test : deux dossiers portent le nom affiché « Calendar ». Le premier
  // trouvé dépendait de l'ordre de l'index -> la note du jour changeait de dossier d'un chargement à
  // l'autre, et les deux se remplissaient. On exige désormais le dossier le PLUS rempli, quel que
  // soit l'ordre dans lequel les chemins arrivent.
  describe('deux dossiers de même nom affiché', () => {
    const riche = [
      'pages/Calendar-76ct/Aout 2026-1lhw/1 Aout 2026.md',
      'pages/Calendar-76ct/Aout 2026-1lhw/3 Aout 2026.md',
      'pages/Calendar-76ct/Juin 2026-xe27/2 juin 2026.md',
    ]
    const pauvre = ['pages/Calendar/Aout 2026/6 Aout 2026.md']

    it('choisit le plus rempli, la coquille arrivant en premier', () => {
      expect(dossierExistant([...pauvre, ...riche], 'pages', 'Calendar')).toBe('pages/Calendar-76ct')
    })

    it('choisit le même, quel que soit l’ordre des chemins', () => {
      expect(dossierExistant([...riche, ...pauvre], 'pages', 'Calendar')).toBe('pages/Calendar-76ct')
    })

    it('départage à égalité stricte, sans jamais osciller', () => {
      const a = ['pages/Calendar/Aout 2026/1.md']
      const b = ['pages/Calendar-76ct/Aout 2026/1.md']
      const attendu = dossierExistant([...a, ...b], 'pages', 'Calendar')
      expect(dossierExistant([...b, ...a], 'pages', 'Calendar')).toBe(attendu)
      expect(attendu).toBe('pages/Calendar')
    })
  })

  it('ne confond pas un préfixe avec un dossier frère', () => {
    const paths = ['pages/CalendarArchive-9xyz/vieux.md', 'pages/Calendar-76ct/Aout 2026/1.md']
    expect(dossierExistant(paths, 'pages', 'Calendar')).toBe('pages/Calendar-76ct')
  })
})
