import React from 'react'
import { fireEvent, render, screen } from '@testing-library/react'
import { describe, expect, it, vi } from 'vitest'
import { DatabaseBoardView, DatabaseFilterBar, DatabaseGalleryView } from './DatabaseViews.jsx'

const theme = {
  bg: '#eee',
  surface: '#fff',
  cardBg: '#fff',
  border: '#ccc',
  textPrimary: '#111',
  textSecondary: '#666',
  btnSecondaryBg: '#fff',
  btnSecondaryText: '#111',
}
const columns = [
  { id: 'name', name: 'Nom', type: 'text' },
  { id: 'status', name: 'Statut', type: 'select', options: ['Todo', 'Done'] },
  { id: 'score', name: 'Score', type: 'number' },
]
const rows = [{ id: 'row-1', cells: { name: 'Alpha', status: 'Todo', score: 8 } }]

describe('shared database views', () => {
  it('renders Board and Gallery from the same row contract', () => {
    const setCell = vi.fn()
    const { rerender } = render(<DatabaseBoardView t={theme} columns={columns} rows={rows} groupBy="status" onSetCell={setCell} />)
    expect(screen.getByText('Alpha')).toBeInTheDocument()
    expect(screen.queryByText(/Statut:/)).not.toBeInTheDocument()

    const doneColumn = screen.getByText('Done · 0').parentElement
    fireEvent.drop(doneColumn, { dataTransfer: { getData: () => 'row-1' } })
    expect(setCell).toHaveBeenCalledWith('row-1', 'status', 'Done')

    rerender(<DatabaseGalleryView t={theme} columns={columns} rows={rows} />)
    expect(screen.getByText('Statut: Todo')).toBeInTheDocument()
    expect(screen.getByText('Score: 8')).toBeInTheDocument()
  })

  it('creates a filter with the caller-specific operation contract', () => {
    const onChange = vi.fn()
    render(<DatabaseFilterBar t={theme} columns={[columns[1]]} filters={[]} onChange={onChange} categoricalContains={false} />)
    fireEvent.click(screen.getByText('+ Filtre'))
    expect(onChange).toHaveBeenCalledTimes(1)
    expect(onChange.mock.calls[0][0][0]).toMatchObject({ col: 'status', op: '=', val: '' })
  })
})
