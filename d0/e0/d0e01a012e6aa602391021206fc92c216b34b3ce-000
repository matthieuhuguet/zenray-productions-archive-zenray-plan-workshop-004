// 15 October 2026: an « open in Create » event emitted while Create is not mounted is posted to its mailbox, not lost.
import React from 'react'
import { afterEach, describe, expect, it, vi } from 'vitest'
import { cleanup, render, waitFor } from '@testing-library/react'

describe('cross-view links to Create', () => {
  afterEach(() => { cleanup(); vi.resetModules() })
  it('keeps the request when Create is not on screen and replays it when Create mounts', async () => {
    const pages = await import('./Pages.jsx')
    const seen = []
    window.addEventListener('zr:create-folder', (e) => seen.push(e.detail.path))
    expect(pages.pagesMonte).toBe(0)
    pages.poserDemandePages('zr:create-folder', { path: 'pages/Photos/DJI' })
    expect(seen).toEqual([]) // posted, not dispatched: nobody is listening yet
  })
})
