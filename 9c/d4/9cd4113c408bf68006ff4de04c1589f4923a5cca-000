// LOT TABLES — moteur de FORMULES façon Excel / Google Sheets.
// Une formule commence par "=" : =A1+B2, =SUM(A1:A10), =IF(A1>5,"ok","ko").
// Le moteur lit la formule, la découpe (tokenize), la transforme en arbre (parse),
// puis calcule la valeur (eval) en allant chercher les autres cellules.
// Il détecte les cycles (A1 qui dépend de A1) pour ne pas tourner en boucle.

import { parseA1, parseRange, toA1 } from './grid.js'

// ── 1. TOKENIZER : découpe "=A1+SUM(B1:B3)" en morceaux ──
const TOKEN_RE = /\s*(\$?[A-Za-z]+\$?\d+(?::\$?[A-Za-z]+\$?\d+)?|[A-Za-z_][A-Za-z0-9_]*|"(?:[^"\\]|\\.)*"|\d*\.?\d+(?:[eE][+-]?\d+)?|<=|>=|<>|!=|&&|\|\||[-+*/^%()<>=&,])/g

function tokenize(src) {
  const toks = []; let m; TOKEN_RE.lastIndex = 0
  while ((m = TOKEN_RE.exec(src)) !== null) {
    if (m[0].trim() === '') continue
    const v = m[1]
    if (v[0] === '"') toks.push({ t: 'str', v: v.slice(1, -1).replace(/\\(.)/g, '$1') })
    else if (/^\$?[A-Za-z]+\$?\d+/.test(v) && /\d/.test(v)) toks.push({ t: 'ref', v })
    else if (/^[A-Za-z_]/.test(v)) {
      const up = v.toUpperCase()
      if (up === 'TRUE' || up === 'FALSE') toks.push({ t: 'num', v: up === 'TRUE' ? true : false })
      else toks.push({ t: 'fn', v: up })
    }
    else if (/^[\d.]/.test(v)) toks.push({ t: 'num', v: parseFloat(v) })
    else toks.push({ t: 'op', v })
  }
  return toks
}

// ── 2. PARSER : descente récursive avec priorités d'opérateurs ──
// Priorités : || && < comparaisons < & (concat) < +- < */% < ^ < unaire < atome
function parse(toks) {
  let i = 0
  const peek = () => toks[i]
  const next = () => toks[i++]
  const eat = (v) => { if (peek() && peek().v === v) { i++; return true } return false }

  function parseExpr() { return parseOr() }
  function bin(sub, ops) {
    let left = sub()
    while (peek() && peek().t === 'op' && ops.includes(peek().v)) { const op = next().v; left = { k: 'bin', op, l: left, r: sub() } }
    return left
  }
  const parseOr = () => bin(parseAnd, ['||'])
  const parseAnd = () => bin(parseCmp, ['&&'])
  const parseCmp = () => bin(parseConcat, ['=', '==', '<', '>', '<=', '>=', '<>', '!='])
  const parseConcat = () => bin(parseAdd, ['&'])
  const parseAdd = () => bin(parseMul, ['+', '-'])
  const parseMul = () => bin(parsePow, ['*', '/', '%'])
  const parsePow = () => {
    const base = parseUnary()
    if (peek() && peek().v === '^') { next(); return { k: 'bin', op: '^', l: base, r: parsePow() } }
    return base
  }
  function parseUnary() {
    if (peek() && peek().t === 'op' && (peek().v === '-' || peek().v === '+')) { const op = next().v; return { k: 'un', op, e: parseUnary() } }
    return parseAtom()
  }
  function parseAtom() {
    const tk = peek()
    if (!tk) throw new Error('fin inattendue')
    if (tk.t === 'num') { next(); return { k: 'num', v: tk.v } }
    if (tk.t === 'str') { next(); return { k: 'str', v: tk.v } }
    if (tk.t === 'ref') { next(); return { k: 'ref', v: tk.v } }
    if (tk.t === 'fn') {
      next()
      if (eat('(')) {
        const args = []
        if (!eat(')')) { do { args.push(parseExpr()) } while (eat(',')); if (!eat(')')) throw new Error(') manquante') }
        return { k: 'call', name: tk.v, args }
      }
      return { k: 'name', v: tk.v } // nom nu (peu probable) traité comme texte
    }
    if (tk.v === '(') { next(); const e = parseExpr(); if (!eat(')')) throw new Error(') manquante'); return e }
    throw new Error('jeton inattendu: ' + tk.v)
  }
  const ast = parseExpr()
  if (i < toks.length) throw new Error('reste: ' + toks[i].v)
  return ast
}

// ── 3. FONCTIONS intégrées ──
const num = (x) => { const n = typeof x === 'number' ? x : parseFloat(x); return isNaN(n) ? 0 : n }
const flat = (args) => args.flat(Infinity)
const nums = (args) => flat(args).filter((x) => x !== '' && x != null && !(typeof x === 'string' && isNaN(parseFloat(x)))).map(num)

const FUNCS = {
  SUM: (a) => nums(a).reduce((s, x) => s + x, 0),
  AVERAGE: (a) => { const n = nums(a); return n.length ? n.reduce((s, x) => s + x, 0) / n.length : 0 },
  AVG: (a) => FUNCS.AVERAGE(a),
  COUNT: (a) => nums(a).length,
  COUNTA: (a) => flat(a).filter((x) => x !== '' && x != null).length,
  MIN: (a) => { const n = nums(a); return n.length ? Math.min(...n) : 0 },
  MAX: (a) => { const n = nums(a); return n.length ? Math.max(...n) : 0 },
  PRODUCT: (a) => nums(a).reduce((s, x) => s * x, 1),
  ROUND: (a) => { const f = a[1] == null ? 0 : num(a[1]); const k = Math.pow(10, f); return Math.round(num(a[0]) * k) / k },
  FLOOR: (a) => Math.floor(num(a[0])),
  CEILING: (a) => Math.ceil(num(a[0])),
  CEIL: (a) => Math.ceil(num(a[0])),
  ABS: (a) => Math.abs(num(a[0])),
  SQRT: (a) => Math.sqrt(num(a[0])),
  POWER: (a) => Math.pow(num(a[0]), num(a[1])),
  MOD: (a) => num(a[0]) % num(a[1]),
  INT: (a) => Math.trunc(num(a[0])),
  IF: (a) => truthy(a[0]) ? a[1] : (a.length > 2 ? a[2] : false),
  IFS: (a) => { for (let i = 0; i + 1 < a.length; i += 2) if (truthy(a[i])) return a[i + 1]; return '#N/A' },
  AND: (a) => flat(a).every(truthy),
  OR: (a) => flat(a).some(truthy),
  NOT: (a) => !truthy(a[0]),
  CONCAT: (a) => flat(a).map((x) => x == null ? '' : String(x)).join(''),
  CONCATENATE: (a) => FUNCS.CONCAT(a),
  TEXTJOIN: (a) => { const sep = String(a[0] ?? ''); return flat(a.slice(2)).filter((x) => x !== '' && x != null).map(String).join(sep) },
  UPPER: (a) => String(a[0] ?? '').toUpperCase(),
  LOWER: (a) => String(a[0] ?? '').toLowerCase(),
  TRIM: (a) => String(a[0] ?? '').trim(),
  LEN: (a) => String(a[0] ?? '').length,
  LEFT: (a) => String(a[0] ?? '').slice(0, a[1] == null ? 1 : num(a[1])),
  RIGHT: (a) => { const s = String(a[0] ?? ''); const n = a[1] == null ? 1 : num(a[1]); return s.slice(s.length - n) },
  MID: (a) => String(a[0] ?? '').substr(num(a[1]) - 1, num(a[2])),
  ROUNDUP: (a) => { const f = a[1] == null ? 0 : num(a[1]); const k = Math.pow(10, f); return Math.ceil(num(a[0]) * k) / k },
  ROUNDDOWN: (a) => { const f = a[1] == null ? 0 : num(a[1]); const k = Math.pow(10, f); return Math.floor(num(a[0]) * k) / k },
  COUNTIF: (a, raw) => { const rng = raw[0]; const crit = a[1]; return flat([rng]).filter((x) => matchCrit(x, crit)).length },
  SUMIF: (a, raw) => { const rng = flat([raw[0]]); const crit = a[1]; const sumRng = raw[2] != null ? flat([raw[2]]) : rng; return rng.reduce((s, x, idx) => matchCrit(x, crit) ? s + num(sumRng[idx]) : s, 0) },
  VLOOKUP: (a, raw) => {
    const key = a[0]; const table = raw[1]; const colIdx = num(a[2]); const grid = Array.isArray(table) && Array.isArray(table[0]) ? table : [flat([table])]
    for (const row of grid) { if (row[0] != null && String(row[0]) === String(key)) return row[colIdx - 1] ?? '#N/A' }
    return '#N/A'
  },
  TODAY: () => new Date().toISOString().slice(0, 10),
  NOW: () => new Date().toISOString(),
  PI: () => Math.PI,
  TRUE: () => true, FALSE: () => false,
  // ── Ajouts parité Excel/Sheets ──
  MEDIAN: (a) => { const n = nums(a).sort((x, y) => x - y); if (!n.length) return 0; const m = Math.floor(n.length / 2); return n.length % 2 ? n[m] : (n[m - 1] + n[m]) / 2 },
  MODE: (a) => { const n = nums(a); const m = {}; let best = null, bc = 0; for (const x of n) { m[x] = (m[x] || 0) + 1; if (m[x] > bc) { bc = m[x]; best = x } } return best ?? '#N/A' },
  STDEV: (a) => { const n = nums(a); if (n.length < 2) return 0; const mu = n.reduce((s, x) => s + x, 0) / n.length; return Math.sqrt(n.reduce((s, x) => s + (x - mu) ** 2, 0) / (n.length - 1)) },
  VAR: (a) => { const n = nums(a); if (n.length < 2) return 0; const mu = n.reduce((s, x) => s + x, 0) / n.length; return n.reduce((s, x) => s + (x - mu) ** 2, 0) / (n.length - 1) },
  COUNTIFS: (a, raw) => { const rng = flat([raw[0]]); let c = 0; for (let i = 0; i < rng.length; i++) { let ok = true; for (let p = 0; p + 1 < raw.length; p += 2) { if (!matchCrit(flat([raw[p]])[i], a[p + 1])) { ok = false; break } } if (ok) c++ } return c },
  SUMIFS: (a, raw) => { const sumR = flat([raw[0]]); const crR = flat([raw[1]]); let s = 0; for (let i = 0; i < crR.length; i++) { let ok = true; for (let p = 1; p + 1 < raw.length; p += 2) { if (!matchCrit(flat([raw[p]])[i], a[p + 1])) { ok = false; break } } if (ok) s += num(sumR[i]) } return s },
  AVERAGEIF: (a, raw) => { const rng = flat([raw[0]]); const crit = a[1]; const avgR = raw[2] != null ? flat([raw[2]]) : rng; let s = 0, c = 0; rng.forEach((x, i) => { if (matchCrit(x, crit)) { s += num(avgR[i]); c++ } }); return c ? s / c : 0 },
  IFERROR: (a) => { const v = a[0]; return (typeof v === 'string' && v[0] === '#') ? (a[1] ?? '') : v },
  ISBLANK: (a) => a[0] == null || a[0] === '',
  ISNUMBER: (a) => typeof a[0] === 'number' || (a[0] !== '' && a[0] != null && !isNaN(parseFloat(a[0])) && isFinite(a[0])),
  ISTEXT: (a) => typeof a[0] === 'string' && isNaN(parseFloat(a[0])),
  SUBSTITUTE: (a) => String(a[0] ?? '').split(String(a[1] ?? '')).join(String(a[2] ?? '')),
  REPLACE: (a) => { const s = String(a[0] ?? ''); const start = num(a[1]) - 1; const len = num(a[2]); return s.slice(0, start) + String(a[3] ?? '') + s.slice(start + len) },
  FIND: (a) => { const i = String(a[1] ?? '').indexOf(String(a[0] ?? '')); return i < 0 ? '#VALUE!' : i + 1 },
  SEARCH: (a) => { const i = String(a[1] ?? '').toLowerCase().indexOf(String(a[0] ?? '').toLowerCase()); return i < 0 ? '#VALUE!' : i + 1 },
  PROPER: (a) => String(a[0] ?? '').replace(/\w\S*/g, (w) => w[0].toUpperCase() + w.slice(1).toLowerCase()),
  REPT: (a) => String(a[0] ?? '').repeat(Math.max(0, num(a[1]))),
  EXACT: (a) => String(a[0] ?? '') === String(a[1] ?? ''),
  HLOOKUP: (a, raw) => { const key = a[0]; const table = raw[1]; const rowIdx = num(a[2]); const grid = Array.isArray(table) && Array.isArray(table[0]) ? table : [flat([table])]; const head = grid[0] || []; for (let c = 0; c < head.length; c++) { if (String(head[c]) === String(key)) return (grid[rowIdx - 1] || [])[c] ?? '#N/A' } return '#N/A' },
  MATCH: (a, raw) => { const key = a[0]; const arr = flat([raw[1]]); for (let i = 0; i < arr.length; i++) if (String(arr[i]) === String(key)) return i + 1; return '#N/A' },
  INDEX: (a, raw) => { const arr = raw[0]; const r = num(a[1]); const c = a[2] == null ? 1 : num(a[2]); const grid = Array.isArray(arr) && Array.isArray(arr[0]) ? arr : [flat([arr])]; return (grid[r - 1] || [])[c - 1] ?? '#REF!' },
  DATE: (a) => { const d = new Date(num(a[0]), num(a[1]) - 1, num(a[2])); return isNaN(d) ? '#VALUE!' : d.toISOString().slice(0, 10) },
  YEAR: (a) => { const d = new Date(a[0]); return isNaN(d) ? '#VALUE!' : d.getFullYear() },
  MONTH: (a) => { const d = new Date(a[0]); return isNaN(d) ? '#VALUE!' : d.getMonth() + 1 },
  DAY: (a) => { const d = new Date(a[0]); return isNaN(d) ? '#VALUE!' : d.getDate() },
  SIGN: (a) => Math.sign(num(a[0])),
  EXP: (a) => Math.exp(num(a[0])),
  LN: (a) => Math.log(num(a[0])),
  LOG: (a) => a[1] == null ? Math.log10(num(a[0])) : Math.log(num(a[0])) / Math.log(num(a[1])),
  LOG10: (a) => Math.log10(num(a[0])),
}

function matchCrit(x, crit) {
  const c = String(crit)
  const m = /^(<=|>=|<>|<|>|=)?\s*(.*)$/.exec(c)
  const op = m[1] || '='; const rhs = m[2]
  if (op === '=' || op === '<>') { const eq = String(x) === rhs; return op === '=' ? eq : !eq }
  const a = num(x), b = num(rhs)
  return op === '<' ? a < b : op === '<=' ? a <= b : op === '>' ? a > b : a >= b
}

function truthy(v) {
  if (v === true || v === false) return v
  if (typeof v === 'number') return v !== 0
  if (v == null || v === '') return false
  const s = String(v).toLowerCase()
  if (s === 'false' || s === '0') return false
  return true
}

// ── 4. ÉVALUATEUR ──
// getCell(row,col) renvoie la valeur DÉJÀ calculée d'une cellule (le solveur s'occupe de l'ordre).
function evalNode(node, ctx) {
  switch (node.k) {
    case 'num': return node.v
    case 'str': return node.v
    case 'name': return node.v
    case 'ref': {
      if (node.v.includes(':')) return collectRange(node.v, ctx)
      const p = parseA1(node.v); if (!p) return '#REF!'
      return ctx.getCell(p.row, p.col)
    }
    case 'un': { const e = evalNode(node.e, ctx); return node.op === '-' ? -num(e) : +num(e) }
    case 'bin': return evalBin(node, ctx)
    case 'call': {
      const fn = FUNCS[node.name]
      if (!fn) return '#NAME?'
      // args évalués ; pour les fonctions qui ont besoin des plages brutes (VLOOKUP, SUMIF…), on passe aussi raw 2D
      const raw = node.args.map((a) => a.k === 'ref' && a.v.includes(':') ? collect2D(a.v, ctx) : evalNode(a, ctx))
      const vals = node.args.map((a, idx) => a.k === 'ref' && a.v.includes(':') ? collectRange(a.v, ctx) : raw[idx])
      return fn(vals, raw)
    }
    default: return '#ERR'
  }
}

function evalBin(node, ctx) {
  const l = evalNode(node.l, ctx), r = evalNode(node.r, ctx)
  switch (node.op) {
    case '+': return num(l) + num(r)
    case '-': return num(l) - num(r)
    case '*': return num(l) * num(r)
    case '/': { const d = num(r); return d === 0 ? '#DIV/0!' : num(l) / d }
    case '%': return num(l) % num(r)
    case '^': return Math.pow(num(l), num(r))
    case '&': return (l == null ? '' : String(l)) + (r == null ? '' : String(r))
    case '=': case '==': return looseEq(l, r)
    case '<>': case '!=': return !looseEq(l, r)
    case '<': return num(l) < num(r)
    case '>': return num(l) > num(r)
    case '<=': return num(l) <= num(r)
    case '>=': return num(l) >= num(r)
    case '&&': return truthy(l) && truthy(r)
    case '||': return truthy(l) || truthy(r)
    default: return '#ERR'
  }
}
function looseEq(a, b) {
  if (typeof a === 'number' || typeof b === 'number') { const na = parseFloat(a), nb = parseFloat(b); if (!isNaN(na) && !isNaN(nb)) return na === nb }
  return String(a) === String(b)
}

function collectRange(ref, ctx) {
  const rg = parseRange(ref); if (!rg) return []
  const out = []
  for (let r = rg.r0; r <= rg.r1; r++) for (let c = rg.c0; c <= rg.c1; c++) out.push(ctx.getCell(r, c))
  return out
}
function collect2D(ref, ctx) {
  const rg = parseRange(ref); if (!rg) return []
  const out = []
  for (let r = rg.r0; r <= rg.r1; r++) { const row = []; for (let c = rg.c0; c <= rg.c1; c++) row.push(ctx.getCell(r, c)); out.push(row) }
  return out
}

// ── 5. DÉPENDANCES : quelles cellules une formule lit-elle ? (pour ordonner le recalcul) ──
export function refsOf(formula) {
  const set = new Set()
  let toks; try { toks = tokenize(formula.slice(1)) } catch { return [] }
  for (const tk of toks) {
    if (tk.t !== 'ref') continue
    if (tk.v.includes(':')) { const rg = parseRange(tk.v); if (rg) for (let r = rg.r0; r <= rg.r1; r++) for (let c = rg.c0; c <= rg.c1; c++) set.add(r + ',' + c) }
    else { const p = parseA1(tk.v); if (p) set.add(p.row + ',' + p.col) }
  }
  return [...set]
}

// Compile une formule "=…" en fonction (ctx)->valeur. Renvoie null si syntaxe invalide.
export function compile(formula) {
  let ast
  try { ast = parse(tokenize(formula.slice(1))) } catch { return () => '#SYNTAX!' }
  return (ctx) => { try { return evalNode(ast, ctx) } catch { return '#ERR' } }
}

export function isFormula(v) { return typeof v === 'string' && v.length > 1 && v[0] === '=' }

// ── DÉCALAGE DE FORMULE (autofill + coller façon Excel/Sheets) ──
// Quand on tire =A1+B1 vers le bas d'une ligne, ça doit devenir =A2+B2 : les références
// RELATIVES suivent le déplacement. Les références ABSOLUES ($A$1) restent figées.
// On peut figer juste la colonne ($A1) ou juste la ligne (A$1) : chaque moitié est traitée à part.
// dRow / dCol = de combien de lignes / colonnes la cellule a bougé par rapport à l'original.
// Renvoie une nouvelle chaîne "=…". Hors formule -> renvoie la valeur telle quelle.
import { colToLetter as _colToLetter, letterToCol as _letterToCol } from './grid.js'
// (?<![A-Za-z0-9_$.]) : pas collé à un identifiant (évite de mordre dans LOG10, A1B2…).
// (?![A-Za-z0-9_(]) : pas suivi d'une lettre/chiffre ni d'une parenthèse (évite les noms de fonction type LOG10()).
const REF_RE = /(?<![A-Za-z0-9_$.])(\$?)([A-Za-z]+)(\$?)(\d+)(?![A-Za-z0-9_(])/g
function shiftOneRef(absC, letters, absR, digits, dRow, dCol) {
  let col = _letterToCol(letters), row = parseInt(digits, 10) - 1
  if (!absC) col += dCol
  if (!absR) row += dRow
  if (col < 0 || row < 0) return '#REF!'
  return (absC ? '$' : '') + _colToLetter(col) + (absR ? '$' : '') + (row + 1)
}
export function offsetFormula(formula, dRow, dCol) {
  if (!isFormula(formula)) return formula
  if (dRow === 0 && dCol === 0) return formula
  // on ne touche qu'aux références hors des chaînes de texte "…" : on découpe sur les guillemets.
  const parts = formula.split(/("(?:[^"\\]|\\.)*")/)
  const out = parts.map((seg, i) => {
    if (i % 2 === 1) return seg // segment entre guillemets : intact
    return seg.replace(REF_RE, (_, ac, letters, ar, digits) => shiftOneRef(ac === '$', letters, ar === '$', digits, dRow, dCol))
  })
  return out.join('')
}

// ── 6. SOLVEUR de toute la grille : calcule chaque cellule formule dans le bon ordre, détecte les cycles. ──
// rawGet(row,col) -> valeur brute stockée (texte/nombre/formule "=…").
// Renvoie une Map "row,col" -> valeur calculée pour les cellules qui sont des formules.
export function solve(rawGet, nRows, nCols) {
  const computed = new Map()   // clés "r,c" déjà résolues
  const visiting = new Set()   // pile de récursion -> détection cycle

  function getCell(r, c) {
    if (r < 0 || c < 0 || r >= nRows || c >= nCols) return ''
    const key = r + ',' + c
    if (computed.has(key)) return computed.get(key)
    const raw = rawGet(r, c)
    if (!isFormula(raw)) {
      const v = raw === '' || raw == null ? '' : (typeof raw === 'number' ? raw : (isNaN(parseFloat(raw)) || String(raw).trim() === '' ? raw : (/^-?\d*\.?\d+(?:[eE][+-]?\d+)?$/.test(String(raw).trim()) ? parseFloat(raw) : raw)))
      return v
    }
    if (visiting.has(key)) { computed.set(key, '#CYCLE!'); return '#CYCLE!' }
    visiting.add(key)
    const fn = compile(raw)
    const val = fn({ getCell })
    visiting.delete(key)
    computed.set(key, val)
    return val
  }
  return { getCell, computeAll() { for (let r = 0; r < nRows; r++) for (let c = 0; c < nCols; c++) if (isFormula(rawGet(r, c))) getCell(r, c); return computed } }
}

export { toA1 }
