export function canReuseFingerprint(file, cached) {
  return Boolean(cached?.s
    && cached.t === file.size
    && cached.m === file.mtime
    && cached.c === file.ctime)
}

export function fingerprintCacheEntry(file, sha256) {
  return { t: file.size, m: file.mtime, c: file.ctime, s: sha256 }
}

export function fileChangeToken(file) {
  const valeurs = [file.size, file.mtime, file.ctime]
  if (!valeurs.every(Number.isFinite)) throw new TypeError("preuve de fichier incomplète : size, mtime et ctime sont requis")
  return valeurs.join(':')
}

export function canUseInventoryFingerprint(inventoryFile, currentFile, sha256) {
  return Boolean(sha256 && fileChangeToken(inventoryFile) === fileChangeToken(currentFile))
}
