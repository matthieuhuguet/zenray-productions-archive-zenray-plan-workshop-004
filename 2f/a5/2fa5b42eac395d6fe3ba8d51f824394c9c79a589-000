/* SPORT : feuille de style de la vue. Espacement = échelle --e0..--e4 (Gestalt) posée par SportView depuis config/sport.js.
   Aucune couleur écrite ici : jetons du thème (--bg, --fg, --muted, --border) et teintes passées en variables par le composant. */
.zrs { --zrs-r: 14px; --zrs-ctl: 38px; --zr-accent: var(--zr-accent-color, #4295f7); --zr-accent-soft: rgba(66, 149, 247, 0.16); --bg: var(--g9-bg, #fff); --fg: var(--g9-fg, #191b1f); --muted: var(--g9-muted, rgba(25, 27, 31, 0.56)); --border: var(--g9-rail, rgba(128, 128, 128, 0.2)); position: relative; display: flex; flex-direction: column; height: 100%; min-height: 0; padding: 0 var(--e3) var(--e2); gap: var(--e3); color: var(--fg); font-family: var(--zr-police-sans); font-size: var(--zr-ui-md); box-sizing: border-box; }
.zr-dark .zrs { --bg: var(--g9-bg, #1c1c1e); --fg: var(--g9-fg, #fff); --muted: var(--g9-muted, rgba(255, 255, 255, 0.62)); --border: var(--g9-rail, rgba(255, 255, 255, 0.18)); }
.zrs *, .zrs *::before, .zrs *::after { box-sizing: border-box; }
.zrs button, .zrs input { font: inherit; color: inherit; }
.zrs button { cursor: pointer; }
.zrs-state { align-items: center; justify-content: center; color: var(--muted); text-align: center; }
.zrs-retry { margin-top: var(--e2); height: var(--zrs-ctl); padding: 0 var(--e3); border: 0; border-radius: 999px; background: var(--zr-accent); color: #fff; font-weight: 500; }
.zrs-head { display: flex; align-items: flex-end; gap: var(--e2); padding-top: var(--e2); flex-wrap: wrap; }
.zrs-head > div:first-child { flex: 1; min-width: 0; }
.zrs-head h1 { margin: 0; font: 350 calc(var(--zr-ui-base) * 2)/1 var(--zr-police-serif); letter-spacing: -0.01em; }
.zrs-date { position: relative; display: inline-flex; align-items: center; gap: var(--e1); margin-top: var(--e0); color: var(--muted); cursor: pointer; white-space: nowrap; }
.zrs-date:hover, .zrs-date.is-past { color: var(--fg); }
.zrs-chev { font-size: .9em; opacity: .7; }
.zrs-date input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
.zrs-pastb { padding: 0 var(--e1); border-radius: 999px; background: var(--zr-accent-soft); color: var(--zr-accent); font-size: .8em; }
.zrs-segctl { display: inline-flex; padding: 3px; border-radius: 999px; background: rgba(128,128,128,.12); }
.zrs-segctl button { border: 0; background: transparent; padding: var(--e0) var(--e2); border-radius: 999px; white-space: nowrap; transition: background .12s ease, color .12s ease; }
.zrs-segctl button.is-on { background: var(--zr-accent); color: #fff; font-weight: 500; box-shadow: 0 1px 3px rgba(0,0,0,.18); }
.zrs-only-narrow { display: none; }
.zrs-body { flex: 1; min-height: 0; display: flex; gap: var(--e3); }
.zrs-main { flex: 1.6; min-width: 0; display: flex; flex-direction: column; gap: var(--e3); min-height: 0; }
.zrs-find { display: flex; flex-direction: column; gap: var(--e1); }
.zrs-search { height: 36px; padding: 0 var(--e2); border-radius: calc(var(--zrs-r) - 3px); border: .5px solid var(--border); background: rgba(128,128,128,.1); outline: 0; }
.zrs-search:focus { border-color: var(--zr-accent); }
.zrs-chips { display: flex; gap: var(--e1); overflow-x: auto; scrollbar-width: none; }
.zrs-chips::-webkit-scrollbar { display: none; }
.zrs-chips button { flex: none; padding: var(--e0) var(--e2); border-radius: 999px; border: .5px solid var(--border); background: transparent; }
.zrs-chips button.is-on { background: var(--zr-accent); border-color: transparent; color: #fff; }
.zrs-grid { flex: 1; min-height: 0; overflow: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); grid-auto-rows: max-content; gap: var(--e2); align-content: start; padding: var(--e0) var(--e0) var(--e4); }
.zrs-tile { position: relative; aspect-ratio: 1 / 1.08; border: 0; padding: 0; border-radius: var(--zrs-r); overflow: hidden; background: color-mix(in srgb, var(--zrs-tint) 70%, black); text-align: left; }
.zrs-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
.zrs-tile img.is-stack { object-fit: contain; background: #0c0c0c; }
.zrs-tile.is-sel { box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--zr-accent); }
.zrs-ph { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; font: 350 2rem/1 var(--zr-police-serif); background: linear-gradient(145deg, var(--zrs-tint), color-mix(in srgb, var(--zrs-tint) 55%, white)); }
.zrs-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: var(--e3) var(--e2) var(--e1); color: #fff; font-weight: 500; line-height: 1.25; background: linear-gradient(transparent, rgba(0,0,0,.62)); }
.zrs-badge { position: absolute; top: var(--e1); right: var(--e1); padding: var(--e0) var(--e1); border-radius: 999px; background: color-mix(in srgb, var(--zrs-green) 55%, black); color: #fff; font: 400 .82em var(--zr-police-serif); }
/* the day card (what Plan holds) */
.zrs-plan { flex: .8; min-width: 240px; display: flex; flex-direction: column; gap: var(--e2); padding: var(--e3) var(--e2); border-left: .5px solid var(--border); overflow: auto; }
.zrs-ph-head { display: flex; align-items: baseline; gap: var(--e1); }
.zrs-ph-head h3 { margin: 0; font-weight: 500; }
.zrs-ph-head small { color: var(--muted); flex: 1; }
.zrs-count { min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px; background: var(--zr-accent); color: #fff; font-size: 11px; display: inline-grid; place-items: center; }
.zrs-card { display: flex; gap: var(--e2); padding: var(--e2); border-radius: calc(var(--zrs-r) - 2px); background: color-mix(in srgb, var(--zrs-green) 16%, transparent); border: .5px solid color-mix(in srgb, var(--zrs-green) 40%, transparent); }
.zrs-time { font: 500 .8em var(--zr-police-serif); color: var(--muted); min-width: 40px; padding-top: 2px; }
.zrs-card-body { flex: 1; min-width: 0; }
.zrs-card-body b { font-weight: 500; display: block; }
.zrs-card-body small { color: var(--muted); }
.zrs-card ul { list-style: none; margin: var(--e2) 0 0; padding: 0; display: flex; flex-direction: column; gap: var(--e1); }
.zrs-card li { display: flex; justify-content: space-between; gap: var(--e2); }
.zrs-card li small { white-space: nowrap; }
.zrs-check { color: color-mix(in srgb, var(--zrs-green) 60%, black); }
.zrs-hint { color: var(--muted); text-align: center; margin: auto; padding: var(--e3); }
/* Portal wrapper rendered on document.body */
.zrs.zrs-portal { position: fixed !important; inset: 0 !important; height: 100dvh !important; min-height: 100dvh !important; width: 100vw !important; padding: 0 !important; margin: 0 !important; gap: 0 !important; border: 0 !important; background: transparent !important; pointer-events: none !important; z-index: 1000 !important; display: flex !important; flex-direction: column !important; align-items: center !important; justify-content: flex-end !important; }
.zrs.zrs-portal > * { pointer-events: auto; }
/* the one sheet where every control lives */
.zrs-shade { position: fixed; inset: 0; z-index: 1; background: rgba(0,0,0,.45); backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px); }
.zrs-sheet { position: relative; z-index: 2; width: calc(100% - 32px); max-width: 640px; margin: 0 auto var(--e3); padding: var(--e2) var(--e3); border-radius: calc(var(--zrs-r) + 6px); background: var(--bg); box-shadow: 0 18px 60px rgba(0,0,0,.28), 0 0 0 .5px var(--border); display: flex; flex-direction: column; gap: var(--e2); box-sizing: border-box; }
.zrs-sheet-top { display: flex; align-items: center; gap: var(--e2); }
.zrs-thumb { position: relative; width: 56px; height: 56px; border-radius: 10px; overflow: hidden; flex: none; background: color-mix(in srgb, var(--zrs-tint) 70%, black); }
.zrs-thumb img { width: 100%; height: 100%; object-fit: cover; }
.zrs-tt { flex: 1; min-width: 0; }
.zrs-tt h2 { margin: 0; font: 350 calc(var(--zr-ui-base) * 1.5)/1.15 var(--zr-police-serif); }
.zrs-tt small { color: var(--muted); }
.zrs-tt small.is-done { color: color-mix(in srgb, var(--zrs-green) 60%, var(--fg)); font-weight: 500; }
.zrs-ib { border: 0; background: transparent; color: var(--muted); font-size: 1.15em; width: var(--zrs-ctl); height: var(--zrs-ctl); border-radius: 50%; display: grid; place-items: center; cursor: pointer; transition: background .12s ease, color .12s ease; }
.zrs-ib:hover { background: rgba(128,128,128,.14); color: var(--fg); }
.zrs-ib.is-on { color: var(--zr-accent); background: var(--zr-accent-soft); }
.zrs-form { display: flex; flex-direction: column; gap: var(--e2); }
.zrs-seg { display: grid; grid-template-columns: 72px repeat(3, 1fr); height: 46px; border-radius: calc(var(--zrs-r) - 2px); border: .5px solid var(--border); overflow: hidden; }
.zrs-seg > * { border: 0; border-left: .5px solid var(--border); border-radius: 0; height: 100%; width: 100%; min-width: 0; background: transparent; padding: 0; text-align: center; font: 400 1.15em var(--zr-police-serif); display: flex; align-items: center; justify-content: center; }
.zrs-seg > label { border-left: 0; justify-content: flex-start; padding-left: var(--e2); color: var(--muted); font: 400 .88em var(--zr-police-sans); background: rgba(128,128,128,.07); }
.zrs-seg > button:hover { background: rgba(128,128,128,.12); }
.zrs-seg > button:active { background: rgba(128,128,128,.2); }
.zrs-seg .is-on { background: var(--zr-accent); color: #fff; }
.zrs-seg input { outline: 0; -moz-appearance: textfield; }
.zrs-seg input::-webkit-inner-spin-button { display: none; }
.zrs-seg input::placeholder { color: var(--muted); }
.zrs-seg input.is-on::placeholder { color: rgba(255,255,255,.7); }
.zrs-info { display: flex; flex-direction: column; gap: var(--e1); color: var(--muted); font-size: .92em; }
.zrs-info b { color: var(--fg); font-weight: 500; }
.zrs-act { display: grid; grid-template-columns: 1fr 2fr; gap: var(--e1); }
.zrs-act.is-solo { grid-template-columns: 1fr; }
.zrs-act button { height: 42px; border: 0; border-radius: calc(var(--zrs-r) - 3px); background: var(--zr-accent); color: #fff; font-weight: 500; cursor: pointer; transition: opacity .15s ease; }
.zrs-act button:hover { opacity: .92; }
.zrs-act button.is-ghost { background: rgba(128,128,128,.14); color: var(--fg); }
.zrs-act button.is-ghost:hover { background: rgba(128,128,128,.2); }
.zrs-saving { position: fixed; right: var(--e3); bottom: var(--e2); padding: var(--e1) var(--e2); border-radius: 999px; background: var(--bg); box-shadow: 0 6px 24px rgba(0,0,0,.18), 0 0 0 .5px var(--border); color: var(--muted); z-index: 1002; pointer-events: none; }
/* objective photos */
.zrs-goal { flex: 1; min-height: 0; overflow: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); grid-auto-rows: max-content; gap: var(--e2); align-content: start; padding-bottom: var(--e4); }
.zrs-gt { position: relative; aspect-ratio: 3 / 4; border: 0; padding: 0; border-radius: var(--zrs-r); overflow: hidden; background: #222; cursor: zoom-in; text-align: left; }
.zrs-gt img { width: 100%; height: 100%; object-fit: cover; display: block; }
.zrs-gt span { position: absolute; left: 0; right: 0; bottom: 0; padding: var(--e3) var(--e2) var(--e1); color: #fff; font-size: .85em; background: linear-gradient(transparent, rgba(0,0,0,.62)); }
.zrs-lb { position: fixed; inset: 0; z-index: 1001; background: rgba(0,0,0,.88); display: grid; place-items: center; padding: var(--e2); cursor: zoom-out; }
.zrs-lb img { max-width: 100%; max-height: 90dvh; border-radius: 10px; object-fit: contain; }
/* narrow screens: the day card becomes a tab, one column, the sheet is a bottom sheet */
@media (max-width: 860px) {
  .zrs { padding: 0 var(--e2) var(--e1); gap: var(--e2); }
  .zrs-head { flex-direction: column; align-items: stretch; gap: var(--e2); }
  .zrs-head > div:first-child { display: flex; flex-direction: column; gap: 4px; width: 100%; }
  .zrs-date { white-space: normal; flex-wrap: wrap; font-size: 0.88em; }
  .zrs-segctl { width: 100%; display: flex; justify-content: stretch; }
  .zrs-segctl button { flex: 1; text-align: center; padding: 6px 8px; font-size: 13px; }
  .zrs-only-narrow { display: inline-block; }
  .zrs-body { flex-direction: column; gap: 0; }
  .zrs-plan { display: none; border: 0; padding: var(--e2) 0; }
  .zrs-tab-plan .zrs-plan { display: flex; }
  .zrs-tab-plan .zrs-main { display: none; }
  .zrs-grid, .zrs-goal { grid-template-columns: 1fr 1fr; gap: var(--e1); }
  .zrs-tile { aspect-ratio: 1 / 1.15; }
  .zrs-cap { font-size: 12px; padding: var(--e2) var(--e1) var(--e0); }
  .zrs-badge { font-size: 10px; padding: 2px 6px; z-index: 2; max-width: calc(100% - 12px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .zrs-sheet { width: 100%; max-width: none; margin: 0; border-radius: 20px 20px 0 0; padding: var(--e2) var(--e2) max(var(--e3), env(safe-area-inset-bottom, 16px)); max-height: 85dvh; overflow-y: auto; -webkit-overflow-scrolling: touch; }
  .zrs-head h1 { font-size: calc(var(--zr-ui-base) * 1.6); }
}
