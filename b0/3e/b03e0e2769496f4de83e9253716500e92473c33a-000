// @vitest-environment node
// The light GRID thumbnail (`kind=thumb-s`) is served when the manifest has one; otherwise the standard thumbnail answers (2 October 2026).
import { createCipheriv, randomBytes } from 'node:crypto'
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'

const KEY = randomBytes(32)
vi.mock('./media-key.js', () => ({ loadMediaKey: () => KEY.toString('base64') }))
vi.mock('./share-token.js', () => ({ authorizeShareAccess: async () => true }))
vi.mock('./shareReach.js', () => ({ authorizeShareReach: async () => true }))
vi.mock('./githubGraphql.js', () => ({ readFreshText: async () => null }))

const { default: handler } = await import('./shared-media.js')

const encrypt = (plain, iv) => { const c = createCipheriv('aes-256-gcm', KEY, iv); return Buffer.concat([c.update(plain), c.final(), c.getAuthTag()]) }
const IV_A = randomBytes(12), IV_B = randomBytes(12)
const STANDARD = Buffer.from('standard-thumbnail-bytes'), GRID = Buffer.from('grid')
const PATH = 'pages/G/Marie/IMG_1.JPG.img.json'
const URL_A = 'https://cdn.jsdelivr.net/gh/matthieuhuguet/zenrayshards-img-aaaaaaaaaaaa@' + 'a'.repeat(40) + '/00/aa/a.webp'
const URL_B = 'https://cdn.jsdelivr.net/gh/matthieuhuguet/zenrayshards-img-aaaaaaaaaaaa@' + 'a'.repeat(40) + '/00/bb/b.webp'
const manifest = (withGrid) => ({ type: 'image', vis: 'public', cdnRepo: 'zenrayshards-img-aaaaaaaaaaaa', cdnCommit: 'a'.repeat(40), cdnChunks: ['00/cc/c.bin'], iv: IV_A.toString('base64'), thumb: URL_A, thumbIv: IV_A.toString('base64'), ...(withGrid ? { thumbS: URL_B, thumbSIv: IV_B.toString('base64') } : {}) })

function call(kind, m) {
  vi.stubGlobal('fetch', vi.fn(async (url) => {
    const u = String(url)
    if (u.startsWith('https://raw.githubusercontent.com/')) return new Response(JSON.stringify(m), { status: 200 })
    if (u === URL_A) return new Response(encrypt(STANDARD, IV_A), { status: 200 })
    if (u === URL_B) return new Response(encrypt(GRID, IV_B), { status: 200 })
    return new Response('?', { status: 404 })
  }))
  const res = { code: 0, headers: {}, body: null, setHeader(k, v) { this.headers[k] = v }, status(c) { this.code = c; return this }, end(b) { this.body = b; return this } }
  return handler({ method: 'GET', query: { path: PATH, kind, share: 'tok' }, headers: {} }, res).then(() => res)
}
beforeEach(() => vi.stubEnv('GITHUB_TOKEN', 'faux'))
afterEach(() => { vi.unstubAllGlobals(); vi.unstubAllEnvs() })

describe('la vignette légère de grille', () => {
  it('kind=thumb-s rend la vignette de grille, déchiffrée, en WebP', async () => {
    const r = await call('thumb-s', manifest(true))
    expect(r.code).toBe(200); expect(r.headers['Content-Type']).toBe('image/webp'); expect(Buffer.from(r.body).toString()).toBe('grid')
  })
  it('kind=thumb reste la vignette standard, même si une vignette de grille existe', async () => {
    const r = await call('thumb', manifest(true))
    expect(Buffer.from(r.body).toString()).toBe('standard-thumbnail-bytes')
  })
  it('une image sans vignette de grille retombe sur la vignette standard (jamais de case vide)', async () => {
    const r = await call('thumb-s', manifest(false))
    expect(r.code).toBe(200); expect(Buffer.from(r.body).toString()).toBe('standard-thumbnail-bytes'); expect(r.headers['Content-Type']).toBe('image/webp')
  })
})
