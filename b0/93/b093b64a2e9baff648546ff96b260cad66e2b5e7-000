/** Hex d'une étiquette, ou `undefined` si la clé est inconnue. */
export const tagHex = (k) => UI[k]

/**
 * Variante translucide, pour un fond derrière du texte de cette couleur. Dérivée par suffixe alpha
 * plutôt que recopiée en `rgba(…)`, sans quoi le fond survit au changement de la couleur qu'il
 * accompagne, ce qui est arrivé et ne se voyait presque pas. `alpha` est un octet : `24` ≈ 14 %.
 */
export const soft = (hex, alpha = '24') => `${hex}${alpha}`

// ── LA PASTILLE ─────────────────────────────────────────────────────────────────────────────────
//
// TOUT EST EN RAPPORTS, JAMAIS EN PIXELS, et c'est une correction de méthode payée le 2026-07-31.
// J'avais mesuré des pixels sur deux captures d'échelles différentes, puis converti en `em` en
// SUPPOSANT qu'une capitale vaut 0,72 cadratin. La supposition était le maillon faible : mesurée dans
// le navigateur sur la police réelle du site, elle vaut **0,7045**. Une valeur en `em` déduite d'un
// rapport supposé est fausse d'emblée et rien ne le signale.
//
// L'unité CSS `cap` supprime le problème : elle VAUT la hauteur de capitale de la police courante, si
// bien que le rapport mesuré s'écrit tel quel. Support vérifié en direct dans le navigateur du poste
// (`CSS.supports('width','1cap')` répond vrai). Le repli en `em` n'existe que pour un moteur ancien.
//
// LES MESURES, sur deux références macOS à des tailles d'icône différentes — deux échelles valent
// mieux qu'une, car elles distinguent un RAPPORT d'une coïncidence :
//
//                       réf. 1 « Japanese »      réf. 2 « Memory » (sélectionnée)
//   hauteur de capitale  18 px (y 206 → 223)      49 px (y 510 → 558)
//   pastille             20 px (y 204 → 223)      44 px (y 509 → 552)
//   RAPPORT pastille/cap  1,11                     0,90            -> moyenne 1,00
//   écart au texte       12 px, soit 0,67 cap      —
//   anneau               aucun                     6 px, soit 0,14 pastille
//
// L'écart entre 1,11 et 0,90 vient des seuils de détection de bord, l'anticrénelage étant compté
// comme pastille au premier relevé et non au second. La moyenne, elle, tombe sur un nombre rond, et
// c'est le signe qu'on tient la vraie règle : **la pastille vaut une hauteur de capitale.**
//
// DEUX CONSÉQUENCES qui ne se devinent pas :
//
// 1. Elle occupe la bande capitale-ligne de base, pas la hauteur de ligne ni l'étendue avec
//    descendantes : sur la seconde référence le « y » de Memory descend jusqu'à 570 et la pastille
//    s'arrête à 552. En CSS, un `inline-block` s'aligne sur la ligne de base tout seul, donc lui
//    donner `1cap` de haut le place exactement dans cette bande, sans le moindre calcul.
// 2. **L'anneau n'existe QU'EN SÉLECTION.** Hors sélection il mange la couleur, ce qui a été payé le
//    même jour : un anneau de 1,5 px sur une pastille de 7 px la faisait lire blanche quelle que soit
//    sa teinte. Sur le bleu de sélection en revanche, une pastille bleue sans anneau disparaîtrait.
//    La règle est conditionnelle, jamais constante.
export const DOT = {
  /** Diamètre = une hauteur de capitale. Le repli `em` emploie le rapport MESURÉ, pas un rapport supposé. */
  size: '0.70em',
  sizeCap: '1cap',
  /** Écart au texte : 12 px pour 18 px de capitale sur la référence 1. */
  gap: '0.67cap',
  /** Épaisseur de l'anneau de sélection : 0,14 diamètre. */
  ringRatio: 0.14,
}

