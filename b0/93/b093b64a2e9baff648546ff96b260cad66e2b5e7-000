/**
 * FOLDER CUSTOMISATION (2 October 2026). Geometry and shading of the glyph drawn on a coloured folder,
 * plus the thesvg.org source. One place for every number, so the tile, the list row and the dialog
 * preview render the same folder. Ratios are fractions of the folder drawing (582 x 471 viewBox of
 * `public/icons/folder-full.svg`), never pixels.
 * FR : geometrie et teinte du glyphe pose sur un dossier colore, et source thesvg.org. Un seul endroit.
 */
export const FOLDER_ART = Object.freeze({
  /** Aspect ratio of /icons/folder-full.svg and folder-empty.svg (582 / 471). */
  aspect: 582 / 471,
  /** Glyph box, as a fraction of the folder width; centred on the front panel (y 87..458 of 471). */
  glyphSize: 0.36,
  glyphCenterX: 0.5,
  glyphCenterY: 0.62,
  /** Glyph colour = the chosen colour mixed with black, like the embossed glyph of Finder. */
  glyphDarkenPct: 42,
  /** Light edge under the glyph (the "emboss" look). */
  glyphHighlight: 'rgba(255,255,255,0.38)',
  /** Folder body tint: a `color` blend keeps the lightness of the drawing, takes hue and saturation. */
  tintBlend: 'color',
})

export const FOLDER_ICON_SOURCE = Object.freeze({
  /** Static site: no search endpoint, the manifest is fetched once and filtered client side. */
  registryUrl: 'https://thesvg.org/api/registry.json',
  iconUrl: (slug, variant) => `https://thesvg.org/icons/${encodeURIComponent(slug)}/${variant}.svg`,
  /** Variant preferred for a single-colour glyph; falls back to `default` when absent. */
  preferredVariant: 'mono',
  /** Search typing debounce, results bound, and the biggest SVG we accept to persist (bytes). */
  debounceMs: 220,
  maxResults: 60,
  maxSvgBytes: 24 * 1024,
})

